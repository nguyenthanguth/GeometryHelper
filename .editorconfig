root = true

# Every file: four spaces, LF line ends (as .gitattributes and .csharpierrc.json).
[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true

# YAML and JSON keep the two spaces they are written with; CSharpier does not format them.
[*.{yml,yaml,json}]
indent_size = 2

# Markdown: trailing spaces can mean a line break.
[*.md]
trim_trailing_whitespace = false
