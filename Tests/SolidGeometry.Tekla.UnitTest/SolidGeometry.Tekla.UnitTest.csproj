<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\SolidGeometry.Tekla\SolidGeometry.Tekla.csproj" />
    <ProjectReference Include="..\..\Libraries\SolidGeometry\SolidGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The geometry types of the Tekla API are plain data and need no running Tekla, so the conversions
         over them can be tested here. Reading a Tekla Solid does need one, and is covered by the model
         test program instead. Private is true here, unlike in the library, because the test host has no
         Tekla installation to load them from. -->
    <Reference Include="Tekla.Structures">
      <HintPath>..\..\Libraries\SolidGeometry.Tekla\Lib2020\Tekla.Structures.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>..\..\Libraries\SolidGeometry.Tekla\Lib2020\Tekla.Structures.Model.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
