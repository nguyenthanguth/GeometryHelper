<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\GeometryHelper.TeklaConvert\GeometryHelper.TeklaConvert.csproj" />
    <ProjectReference Include="..\..\Libraries\GeometryHelper.SolidGeometry\GeometryHelper.SolidGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The geometry types of the Tekla API are plain data and need no running Tekla, so the conversions
         over them can be tested here. Reading a Tekla Solid does need one, and is covered by the model
         test program instead. Private is true here, unlike in the library, because the test host has no
         Tekla installation to load them from.

         Tekla.Structures carries Tekla.Structures.Geometry3d and Tekla.Structures.Solid, which is all the
         tests touch. Tekla.Structures.Datatype is needed at run time only: in 2025 and 2026, unlike 2020,
         Matrix loads it. A test that reaches into RectangleBoundingBoxConvert would also need
         Tekla.Structures.Drawing added here, because the library keeps that one Private=False and so does
         not copy it out.

         The assemblies come from the Lib folder of the Tekla version under test (TeklaVersion in
         Directory.Build.props), the same one the library is built against. -->
    <Reference Include="Tekla.Structures">
      <HintPath>..\..\Libraries\GeometryHelper.TeklaConvert\Lib$(TeklaVersion)\Tekla.Structures.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Datatype">
      <HintPath>..\..\Libraries\GeometryHelper.TeklaConvert\Lib$(TeklaVersion)\Tekla.Structures.Datatype.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
