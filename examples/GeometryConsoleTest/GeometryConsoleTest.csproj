<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GeometryConsoleTest</RootNamespace>
    <AssemblyName>GeometryConsoleTest</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
    <ProjectReference Include="..\..\src\GeometryHelper.IfcConvert\GeometryHelper.IfcConvert.csproj" />
  </ItemGroup>

  <!-- Sample IFC models, copied next to the executable where Program.cs looks for them. -->
  <ItemGroup>
    <None Include="TestFiles\**\*.ifc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>