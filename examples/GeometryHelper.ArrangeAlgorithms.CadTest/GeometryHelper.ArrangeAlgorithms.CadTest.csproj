<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>GeometryHelper.ArrangeAlgorithms.CadTest</RootNamespace>
    <AssemblyName>GeometryHelper.ArrangeAlgorithms.CadTest</AssemblyName>

    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false is mandatory: these DLLs must NOT be copied to the output directory.
         AutoCAD already loads its own version; copying another version will cause the plugin to load
         two assemblies with the same name but different paths, throwing hard-to-debug type casting errors. -->
    <Reference Include="accoremgd">
      <HintPath>..\..\src\GeometryHelper.CadConvert\Lib\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>..\..\src\GeometryHelper.CadConvert\Lib\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>..\..\src\GeometryHelper.CadConvert\Lib\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
    <ProjectReference Include="..\..\src\GeometryHelper.CadConvert\GeometryHelper.CadConvert.csproj" />
  </ItemGroup>

</Project>
