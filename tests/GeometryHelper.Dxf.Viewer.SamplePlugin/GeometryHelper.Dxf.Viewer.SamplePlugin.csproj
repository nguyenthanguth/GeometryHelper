<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The sample command plugin, NUMCIRCLES, built for the plugin tests: they load its .dll as a user's plugin would be
    loaded. It references GeometryHelper.Dxf.Viewer only, as a plugin does (D16), and does not copy it: the presenter gives
    a plugin its own.
  -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>GeometryHelper.Dxf.Viewer.SamplePlugin</RootNamespace>
        <AssemblyName>GeometryHelper.Dxf.Viewer.SamplePlugin</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\..\src\GeometryHelper.Dxf.Viewer\GeometryHelper.Dxf.Viewer.csproj"
            Private="false"
        />
    </ItemGroup>
</Project>
