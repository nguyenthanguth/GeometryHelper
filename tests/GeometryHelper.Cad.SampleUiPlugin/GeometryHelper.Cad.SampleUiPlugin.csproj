<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The sample plugin that adds to the window (ribbon tab, Properties rows, DRAWINGS button, canvas menu, object snap),
    built for the plugin tests: they load its .dll as a user's plugin would be loaded. It references GeometryHelper.Cad
    only, as a plugin does, and does not copy it: the presenter gives a plugin its own.
  -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>GeometryHelper.Cad.SampleUiPlugin</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.SampleUiPlugin</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GeometryHelper.Cad\GeometryHelper.Cad.csproj" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The 16 by 16 icon of the standard buttons, embedded as GeometryHelper.Cad.SampleUiPlugin.circle16.png. -->
        <EmbeddedResource Include="circle16.png" />
    </ItemGroup>
</Project>
