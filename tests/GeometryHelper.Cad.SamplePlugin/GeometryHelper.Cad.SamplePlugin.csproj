<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The sample command plugin, NUMCIRCLES, built for the plugin tests: they load its .dll as a user's plugin would be
    loaded. It references GeometryHelper.Cad only, as a plugin does (D16), and does not copy it: the presenter gives
    a plugin its own.
  -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>GeometryHelper.Cad.SamplePlugin</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.SamplePlugin</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GeometryHelper.Cad\GeometryHelper.Cad.csproj" Private="false" />
    </ItemGroup>
</Project>
