<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Coverage, on demand rather than on every run. Passing the collector "XPlat Code Coverage" to
       dotnet test writes a Cobertura file under TestResults; see the README for the command. The library
       is the only thing worth measuring, so nothing else is counted. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <Include>[GeometryHelper]*</Include>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
  </PropertyGroup>

  <!-- Clipper2's clipping engine is what the library resolves regions in the plane with, compiled into it from
       src/GeometryHelper/Internal/Clipper; tests reach that copy through InternalsVisibleTo. The copy has no
       offset, so the tests that compare the library's own offsets with Clipper2's, as an independent second
       opinion, take the Clipper2 package instead, under the extern alias Clipper2Package so that the two never
       mix, and call its static front ClipperPackage: in GeometryHelper's namespaces a bare Clipper is the
       namespace of the copy. -->
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" Aliases="Clipper2Package" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
  </ItemGroup>

  <!-- Clipper2's own tests, under Clipper\, read their cases from these files of the Clipper2 repository. -->
  <ItemGroup>
    <None Update="Clipper\Data\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
