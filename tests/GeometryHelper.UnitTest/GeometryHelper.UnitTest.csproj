<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Coverage, on demand rather than on every run. Passing the collector "XPlat Code Coverage" to
       dotnet test writes a Cobertura file under TestResults; see the README for the command. The library
       is the only thing worth measuring, so nothing else is counted. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <Include>[GeometryHelper]*</Include>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
  </PropertyGroup>

  <!-- Clipper2 is what the library resolves regions in the plane with, compiled into it from
       src/GeometryHelper/Clipper2Lib. The tests also call that copy directly, through InternalsVisibleTo, as
       a second opinion: shapes it inflates and measures are what the library's own answers, and the solid
       half's winding-number solver, are compared against. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
  </ItemGroup>

  <!-- Clipper2's own tests, under Clipper2Lib\, read their cases from these files of the Clipper2 repository. -->
  <ItemGroup>
    <None Update="Clipper2Lib\Data\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
