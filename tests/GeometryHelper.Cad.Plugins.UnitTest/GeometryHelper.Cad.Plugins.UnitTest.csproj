<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
        <ProjectReference Include="..\..\src\GeometryHelper.Cad\GeometryHelper.Cad.csproj" />
        <ProjectReference Include="..\..\src\GeometryHelper.Cad.Wpf\GeometryHelper.Cad.Wpf.csproj" />
        <!-- Built first, never referenced: the tests load its .dll as a plugin, from SamplePlugin\ beside them. -->
        <ProjectReference
            Include="..\GeometryHelper.Cad.SamplePlugin\GeometryHelper.Cad.SamplePlugin.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- Built first, never referenced: the tests load its .dll as a plugin that adds to the window, from SampleUiPlugin\ beside them. -->
        <ProjectReference
            Include="..\GeometryHelper.Cad.SampleUiPlugin\GeometryHelper.Cad.SampleUiPlugin.csproj"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="..\GeometryHelper.Cad.SamplePlugin\bin\$(Configuration)\netstandard2.0\GeometryHelper.Cad.SamplePlugin.dll"
            Link="SamplePlugin\GeometryHelper.Cad.SamplePlugin.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\GeometryHelper.Cad.SampleUiPlugin\bin\$(Configuration)\netstandard2.0\GeometryHelper.Cad.SampleUiPlugin.dll"
            Link="SampleUiPlugin\GeometryHelper.Cad.SampleUiPlugin.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>
</Project>
