<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
    <ProjectReference Include="..\..\src\GeometryHelper.IfcConvert\GeometryHelper.IfcConvert.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xbim.Common">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.Ifc">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Ifc.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.Ifc4">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Ifc4.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.Ifc2x3">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Ifc2x3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.Geometry.Engine.Interop">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Geometry.Engine.Interop.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.IO.MemoryModel">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.IO.MemoryModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.IO.Esent">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.IO.Esent.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Xbim.Tessellator">
      <HintPath>..\..\src\GeometryHelper.IfcConvert\Lib\Xbim.Tessellator.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="TestFiles\**\*.ifc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\GeometryHelper.IfcConvert\Lib\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(FileName)%(Extension)</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
