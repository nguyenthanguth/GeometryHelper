<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GeometryHelper\GeometryHelper.csproj" />
        <ProjectReference Include="..\..\src\GeometryHelper.Dxf.Viewer\GeometryHelper.Dxf.Viewer.csproj" />
        <ProjectReference Include="..\..\src\GeometryHelper.Dxf.Viewer.Wpf\GeometryHelper.Dxf.Viewer.Wpf.csproj" />
        <!-- Built first, never referenced: the tests load its .dll as a plugin, from SamplePlugin\ beside them. -->
        <ProjectReference
            Include="..\GeometryHelper.Dxf.Viewer.SamplePlugin\GeometryHelper.Dxf.Viewer.SamplePlugin.csproj"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="..\GeometryHelper.Dxf.Viewer.SamplePlugin\bin\$(Configuration)\netstandard2.0\GeometryHelper.Dxf.Viewer.SamplePlugin.dll"
            Link="SamplePlugin\GeometryHelper.Dxf.Viewer.SamplePlugin.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>
</Project>
