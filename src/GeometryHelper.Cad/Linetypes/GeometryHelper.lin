;; GeometryHelper.lin - the 39 built-in linetypes of GeometryHelper CAD, in millimetres.
;; A copy for reference and to start your own file from: the name GeometryHelper.lin always means the built-in set,
;; so changing this file changes nothing. Written from the built-in definitions; a test keeps the two equal.
*DASHED,Dashed __ __ __ __ __ __ __
A,6,-1.5
*DASHED2,Dashed, half size
A,3,-0.75
*DASHEDX2,Dashed, double size
A,12,-3
*HIDDEN,Hidden _ _ _ _ _ _ _ _ _ _ _
A,3,-1.5
*HIDDEN2,Hidden, half size
A,1.5,-0.75
*HIDDENX2,Hidden, double size
A,6,-3
*CENTER,Center ____ _ ____ _ ____ _
A,12,-1.5,3,-1.5
*CENTER2,Center, half size
A,6,-0.75,1.5,-0.75
*CENTERX2,Center, double size
A,24,-3,6,-3
*PHANTOM,Phantom ____ _ _ ____ _ _ ____
A,12,-1.5,3,-1.5,3,-1.5
*PHANTOM2,Phantom, half size
A,6,-0.75,1.5,-0.75,1.5,-0.75
*PHANTOMX2,Phantom, double size
A,24,-3,6,-3,6,-3
*DOT,Dot . . . . . . . . . . . . .
A,0,-1.5
*DOT2,Dot, half size
A,0,-0.75
*DOTX2,Dot, double size
A,0,-3
