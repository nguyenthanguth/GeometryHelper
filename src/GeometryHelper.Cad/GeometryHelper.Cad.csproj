<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>GeometryHelper.Cad</RootNamespace>
        <AssemblyName>GeometryHelper.Cad</AssemblyName>
        <Description>The 2D presenter of GeometryHelper: opens a DXF as a document, turns its entities into 2D display lists, picks and selects them. No UI.</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeometryHelper\GeometryHelper.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Text\english-words.txt.gz" LogicalName="GeometryHelper.Cad.english-words.txt.gz" />
    </ItemGroup>

    <!-- The default support folders, beside GeometryHelper.Cad.dll in the output of every project that uses it. -->
    <ItemGroup>
        <None Update="Fonts\**;Hatches\**;Linetypes\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GeometryHelper.Cad.UnitTest" />
        <InternalsVisibleTo Include="GeometryHelper.Cad.Wpf" />
        <InternalsVisibleTo Include="GeometryHelper.Cad.Wpf.UnitTest" />
    </ItemGroup>
</Project>
