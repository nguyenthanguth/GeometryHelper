<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>GeometryHelper.Cad.App</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.App</AssemblyName>
        <StartupObject>GeometryHelper.Cad.App.Program</StartupObject>
        <Description>GeometryHelper CAD: the standalone app that opens, edits and plots DXF and DWG drawings, laid out as AutoCAD 2D.</Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <ApplicationIcon>Icons\app.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- The icons Icons\make-icons.ps1 writes: the window's, and a drawing file's, which the register switch names beside the exe. -->
    <ItemGroup>
        <EmbeddedResource Include="Icons\app.ico" LogicalName="GeometryHelper.Cad.App.app.ico" />
        <None Include="Icons\drawing-file.ico" Link="drawing-file.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeometryHelper.Cad.Wpf\GeometryHelper.Cad.Wpf.csproj" />
        <ProjectReference Include="..\GeometryHelper.Cad\GeometryHelper.Cad.csproj" />
        <ProjectReference Include="..\GeometryHelper\GeometryHelper.csproj" />
        <!-- Built first, never referenced: its .dll is copied below into Plugins\DrawingInfo, where the app loads it at start. -->
        <ProjectReference
            Include="..\..\examples\GeometryHelper.Cad.Plugins.DrawingInfo\GeometryHelper.Cad.Plugins.DrawingInfo.csproj"
            ReferenceOutputAssembly="false"
            OutputItemType="DrawingInfoPlugin"
        />
    </ItemGroup>

    <!--
    The sample plugin, Plugins\DrawingInfo, beside the exe: its .dll and nothing else. Not GeometryHelper.Cad.dll: the
    app gives a plugin its own. The item is a None item with a link, so that publish copies it as the build does.
  -->
    <Target Name="LinkDrawingInfoPlugin" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <None
                Include="@(DrawingInfoPlugin)"
                Link="Plugins\DrawingInfo\%(Filename)%(Extension)"
                CopyToOutputDirectory="PreserveNewest"
            />
        </ItemGroup>
    </Target>
</Project>
