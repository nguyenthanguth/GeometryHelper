<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>GeometryHelper.Cad.Python</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.Python</AssemblyName>
        <Description>Runs Python inside GeometryHelper CAD: finds a CPython 3.11 to 3.15, runs scripts on the thread that owns the drawings, asks their prompts as a command does, and makes their decorated functions commands.</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="pythonnet" Version="3.2.1" />
        <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeometryHelper\GeometryHelper.csproj" />
        <ProjectReference Include="..\GeometryHelper.Cad.Remote\GeometryHelper.Cad.Remote.csproj" />
        <ProjectReference Include="..\GeometryHelper.Cad\GeometryHelper.Cad.csproj" />
    </ItemGroup>

    <!-- The app's copy of the Python package, beside the DLLs of every project that uses this one (D702). -->
    <ItemGroup>
        <Content
            Include="..\python\geometryhelper\__init__.py"
            Link="python\geometryhelper\__init__.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\python\geometryhelper\arrays.py"
            Link="python\geometryhelper\arrays.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\python\geometryhelper\cad\*.py"
            Link="python\geometryhelper\cad\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\python\geometryhelper\_app.py"
            Link="python\geometryhelper\_app.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\python\geometryhelper\py.typed"
            Link="python\geometryhelper\py.typed"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GeometryHelper.Cad.Python.UnitTest" />
    </ItemGroup>
</Project>
