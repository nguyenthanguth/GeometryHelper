<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- The controls of the DCL dialogs (DclDialogWindow), on top of Dark.xaml: the shapes of the Design artifact's DCL boards,
         drawn inside the rectangles the layout gives them (a button 22 high, an edit box 19, a popup 21, a toggle 15, a radio
         button 19, a slider 17, list rows 13). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="DclDisabledText" Color="#6B7480" />
    <SolidColorBrush x:Key="DclListGround" Color="#14181D" />
    <SolidColorBrush x:Key="DclPrimaryHover" Color="#5AABFF" />

    <!-- The ring of the keyboard focus on a button, a toggle, a radio button, a slider or an image button: 2 px, 1 px outside. -->
    <Style x:Key="DclFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{StaticResource GhAccent}"
                        BorderThickness="2"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                    />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button: outlined on the input colour, corners of 4; under the mouse lighter, pressed the chosen colour. -->
    <Style x:Key="DclButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DclFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                    >
                        <ContentPresenter
                            x:Name="Words"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                        />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Words" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default button (is_default): the accent colour, its words dark and semibold, no border. -->
    <Style x:Key="DclPrimaryButton" TargetType="Button" BasedOn="{StaticResource DclButton}">
        <Setter Property="Foreground" Value="{StaticResource GhAccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{StaticResource GhAccent}" CornerRadius="4">
                        <ContentPresenter
                            x:Name="Words"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                        />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="Chrome"
                                Property="Background"
                                Value="{StaticResource DclPrimaryHover}"
                            />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An image button: only its picture, which draws its own frame. -->
    <Style x:Key="DclImageButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DclFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Picture" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Picture" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The frame of an edit box: 1 px, the accent while the box inside has the focus, faded when switched off. -->
    <Style x:Key="DclEditFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GhInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A check box: 13 by 13, the accent and a tick when on, then 7 and its words. -->
    <Style x:Key="DclCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DclFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border
                            x:Name="Box"
                            Width="13"
                            Height="13"
                            CornerRadius="2"
                            Background="{StaticResource GhInput}"
                            BorderBrush="{StaticResource GhTextMuted}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                        >
                            <Path
                                x:Name="Tick"
                                Data="M2.5 6.5 5 9 10 3.5"
                                Stroke="White"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Visibility="Collapsed"
                            />
                        </Border>
                        <ContentPresenter
                            x:Name="Words"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                        />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DclDisabledText}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A radio button: a ring of 13, the accent dot of 7 inside when chosen, then 7 and its words. -->
    <Style x:Key="DclRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DclFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="Ring"
                                Stroke="{StaticResource GhTextMuted}"
                                StrokeThickness="1"
                                Fill="{StaticResource GhInput}"
                            />
                            <Ellipse
                                x:Name="Dot"
                                Width="7"
                                Height="7"
                                Fill="{StaticResource GhAccent}"
                                Visibility="Collapsed"
                            />
                        </Grid>
                        <ContentPresenter
                            x:Name="Words"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                        />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DclDisabledText}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Dot" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list: on the list colour, the frame the accent while it has the focus; its rows are 13 high, the chosen one blue. -->
    <Style x:Key="DclList" TargetType="ListBox" BasedOn="{StaticResource GhListBox}">
        <Setter Property="Background" Value="{StaticResource DclListGround}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Row"
                                    Height="13"
                                    Background="Transparent"
                                    Padding="6,0"
                                    SnapsToDevicePixels="True"
                                >
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter
                                            TargetName="Row"
                                            Property="Background"
                                            Value="{StaticResource GhSelected}"
                                        />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A popup list: the box on the input colour with its arrow, the drop-down on the list colour with rows of 20. -->
    <Style x:Key="DclCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            x:Name="Box"
                            Background="{StaticResource GhInput}"
                            BorderBrush="{StaticResource GhBorder}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="5,0,0,0"
                        >
                            <DockPanel>
                                <Path
                                    x:Name="Chevron"
                                    DockPanel.Dock="Right"
                                    Width="20"
                                    Height="19"
                                    Data="M6 8l4 4 4-4"
                                    Stroke="{StaticResource GhTextMuted}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    Stretch="None"
                                />
                                <ContentPresenter
                                    x:Name="Shown"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                />
                            </DockPanel>
                        </Border>
                        <ToggleButton
                            x:Name="Drop"
                            Style="{StaticResource GhComboBoxToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        />
                        <Popup
                            x:Name="PART_Popup"
                            Placement="Bottom"
                            VerticalOffset="2"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            PopupAnimation="None"
                        >
                            <Border
                                Margin="0,0,16,16"
                                Background="{StaticResource DclListGround}"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="0,1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="164"
                            >
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.45" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Chevron" Property="Data" Value="M6 11l4-4 4 4" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DclDisabledText}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Row" Height="20" Background="Transparent" Padding="6,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter
                                            TargetName="Row"
                                            Property="Background"
                                            Value="{StaticResource GhSelected}"
                                        />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter
                                            TargetName="Row"
                                            Property="Background"
                                            Value="{StaticResource GhSelected}"
                                        />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The thumb of a slider: 8 by 15 (15 by 8 upright), light, a frame of the border colour, corners of 2. -->
    <Style x:Key="DclSliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Background="{StaticResource GhText}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="2"
                    />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two sides of the track: the one below the thumb is the accent, the other nothing; both take a click. -->
    <Style x:Key="DclSliderPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DclSliderFill" TargetType="RepeatButton" BasedOn="{StaticResource DclSliderPage}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Fill"
                            Height="4"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource GhAccent}"
                            CornerRadius="2"
                        />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger
                            Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Slider}}"
                            Value="Vertical"
                        >
                            <Setter TargetName="Fill" Property="Height" Value="NaN" />
                            <Setter TargetName="Fill" Property="Width" Value="4" />
                            <Setter TargetName="Fill" Property="Margin" Value="0,0,0,4" />
                            <Setter TargetName="Fill" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Fill" Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slider, across (17 high) or upright (17 wide, its minimum at the bottom): a track of 4 inset by 4 from each end. -->
    <Style x:Key="DclSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DclFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Rail"
                            Height="4"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource GhBorder}"
                            CornerRadius="2"
                        />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DclSliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource DclSliderThumb}" Width="8" Height="15" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DclSliderPage}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Rail" Property="Height" Value="NaN" />
                            <Setter TargetName="Rail" Property="Width" Value="4" />
                            <Setter TargetName="Rail" Property="Margin" Value="0,4" />
                            <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Thumb" Property="Width" Value="15" />
                            <Setter TargetName="Thumb" Property="Height" Value="8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
