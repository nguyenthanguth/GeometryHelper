<Window
    x:Class="GeometryHelper.Cad.Wpf.AppLoadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Load/Unload Applications"
    Width="900"
    Height="700"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource GhAccentButton}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Margin" Value="0,0,6,0" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Head" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="8,6" />
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <SolidColorBrush x:Key="KindLisp" Color="#3FB950" />
            <SolidColorBrush x:Key="KindPython" Color="#E3B341" />
            <SolidColorBrush x:Key="KindPlugin" Color="#6CB6FF" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Load/Unload Applications"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- The actions: Load, then those of the rows chosen. -->
            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
            >
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="LoadButton"
                        Style="{StaticResource Primary}"
                        Content="Load… (.lsp, .dll)"
                        Command="{Binding LoadCommand}"
                    />
                    <Rectangle Width="1" Fill="{StaticResource GhBorder}" Margin="4,0,10,0" />
                    <Button
                        x:Name="ReloadButton"
                        Style="{StaticResource Secondary}"
                        Content="Reload"
                        Command="{Binding ReloadCommand}"
                    />
                    <Button
                        x:Name="UnloadButton"
                        Style="{StaticResource Secondary}"
                        Content="Unload"
                        Command="{Binding UnloadCommand}"
                    />
                    <Button
                        x:Name="RemoveButton"
                        Style="{StaticResource Secondary}"
                        Content="Remove"
                        Foreground="{StaticResource GhError}"
                        Command="{Binding RemoveCommand}"
                        ToolTip="{Binding RemoveToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                    />
                </StackPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhCloseButton}"
                        Content="Close"
                        Margin="0"
                        Click="OnClose"
                    />
                    <TextBlock
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        Text="Each plugin run is one undo step. Loading a .dll runs its code with your rights."
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton
                        x:Name="AllChip"
                        Style="{StaticResource GhChip}"
                        Content="{Binding AllChipText}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="All"
                        IsChecked="True"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        x:Name="LispChip"
                        Style="{StaticResource GhChip}"
                        Content="{Binding LispChipText}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Lisp"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        x:Name="PythonChip"
                        Style="{StaticResource GhChip}"
                        Content="{Binding PythonChipText}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Python"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        x:Name="PluginChip"
                        Style="{StaticResource GhChip}"
                        Content="{Binding PluginChipText}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Plugin"
                    />
                </StackPanel>

                <!-- The AutoLISP files and the plugins, one table. -->
                <Border Grid.Row="1" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Head}" Text="On" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Name" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="Kind" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="Commands" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="File" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="At start" />
                        </Grid>
                        <ListBox
                            x:Name="RowList"
                            ItemsSource="{Binding Rows}"
                            SelectionMode="Extended"
                            SelectionChanged="OnRowsChosen"
                            PreviewKeyDown="OnRowKeyDown"
                            AllowDrop="True"
                            DragOver="OnRowsDragOver"
                            Drop="OnRowsDrop"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource GhText}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                        >
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="Row"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter
                                                            TargetName="Row"
                                                            Property="Background"
                                                            Value="{StaticResource GhSelected}"
                                                        />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppLoadRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Style="{StaticResource GhCheckBox}"
                                            IsChecked="{Binding IsOn, Mode=TwoWay}"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding OnToolTip}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            ToolTip="{Binding Name}"
                                        />
                                        <TextBlock
                                            x:Name="Kind"
                                            Grid.Column="2"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Kind}"
                                            Foreground="{StaticResource KindLisp}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Commands}"
                                            FontFamily="{StaticResource GhMonoFont}"
                                            ToolTip="{Binding Commands}"
                                        />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding File}"
                                            FontFamily="{StaticResource GhMonoFont}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            ToolTip="{Binding File}"
                                        />
                                        <CheckBox
                                            Grid.Column="5"
                                            Style="{StaticResource GhCheckBox}"
                                            IsChecked="{Binding AtStart, Mode=TwoWay}"
                                            IsEnabled="{Binding CanChangeAtStart}"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Load at every start"
                                        />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPython}" Value="True">
                                            <Setter
                                                TargetName="Kind"
                                                Property="Foreground"
                                                Value="{StaticResource KindPython}"
                                            />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlugin}" Value="True">
                                            <Setter
                                                TargetName="Kind"
                                                Property="Foreground"
                                                Value="{StaticResource KindPlugin}"
                                            />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <!-- The last load that failed: the file in bold, then what came of it; hidden until one does. -->
                    <Border
                        x:Name="LoadErrorBox"
                        Margin="0,8,0,0"
                        Padding="10,6"
                        CornerRadius="4"
                        Background="#3A1D1D"
                        BorderBrush="{StaticResource GhError}"
                        BorderThickness="1"
                        AutomationProperties.LiveSetting="Polite"
                    >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Grid
                                DockPanel.Dock="Left"
                                Width="14"
                                Height="14"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                            >
                                <Ellipse Stroke="{StaticResource GhError}" StrokeThickness="1.2" />
                                <Path
                                    Data="M7,4.2 L7,7.8 M7,9.9 L7,10.2"
                                    Stroke="{StaticResource GhError}"
                                    StrokeThickness="1.2"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                />
                            </Grid>
                            <TextBlock
                                x:Name="LoadErrorHint"
                                DockPanel.Dock="Right"
                                Foreground="{StaticResource GhTextMuted}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="Shown until the next load"
                            />
                            <TextBlock
                                x:Name="LoadErrorLine"
                                Foreground="#FFB4AE"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                ToolTip="{Binding LoadError}"
                            >
                                <Run
                                    Text="{Binding LoadErrorName, Mode=OneWay}"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                /><Run Text="{Binding LoadErrorText, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <TextBlock
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        Text="Files in the Lisps and Plugins folders beside the app load at every start; their At start box is greyed. Hover a Commands cell for the full list."
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
