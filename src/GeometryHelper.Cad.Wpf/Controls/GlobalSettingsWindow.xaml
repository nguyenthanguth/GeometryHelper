<Window
    x:Class="GeometryHelper.Cad.Wpf.GlobalSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Global settings"
    Width="840"
    Height="600"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <local:RgbBrushConverter x:Key="RgbBrush" />

            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource GhAccentButton}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <!-- A switch: a track 32 by 18, the accent when on. -->
            <Style x:Key="Switch" TargetType="ToggleButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" Background="{StaticResource GhBorder}" CornerRadius="9" Padding="2">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Track"
                                        Property="Background"
                                        Value="{StaticResource GhAccent}"
                                    />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Box" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="6,3" />
            </Style>

            <!-- A round button with its words, which wrap: a ring, the accent dot inside when chosen. -->
            <Style x:Key="SecurityRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="13" Height="13" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Ellipse
                                        x:Name="Ring"
                                        Stroke="{StaticResource GhTextMuted}"
                                        StrokeThickness="1"
                                        Fill="{StaticResource GhInput}"
                                    />
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="7"
                                        Height="7"
                                        Fill="{StaticResource GhAccent}"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of the trusted folders: its entry in mono, the program's muted with a lock, the selected one on the selection colour. -->
            <Style x:Key="TrustedRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                Background="Transparent"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Padding="8,5"
                            >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="Entry"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding Entry}"
                                    >
                                        <Run
                                            FontFamily="{StaticResource GhMonoFont}"
                                            Text="{Binding Entry, Mode=OneWay}"
                                        />
                                        <Run
                                            FontStyle="Italic"
                                            Foreground="{StaticResource GhTextMuted}"
                                            Text="{Binding ProgramMark, Mode=OneWay}"
                                        />
                                        <Run
                                            FontStyle="Italic"
                                            Foreground="#FF8A7A"
                                            Text="{Binding MissingMark, Mode=OneWay}"
                                        />
                                    </TextBlock>
                                    <local:IconView
                                        x:Name="Lock"
                                        Grid.Column="1"
                                        Size="12"
                                        StrokeThickness="2"
                                        Stroke="{StaticResource GhTextMuted}"
                                        Data="{StaticResource GhIconLock}"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding IsProgramFolder, Converter={StaticResource Shown}}"
                                        ToolTip="Always trusted"
                                    />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsProgramFolder}" Value="True">
                                    <Setter
                                        TargetName="Entry"
                                        Property="Foreground"
                                        Value="{StaticResource GhTextMuted}"
                                    />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Head" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="8,6" />
            </Style>

            <!-- A default support folder beside the dll, read-only: its kind and full path, "(default)" (and "not found"), and Open folder. -->
            <DataTemplate x:Key="DefaultFolderRow" DataType="{x:Type local:DefaultFolderRow}">
                <Border BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Text="{Binding Kind}"
                        />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{StaticResource GhTextMuted}"
                            FontFamily="{StaticResource GhMonoFont}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,0,8,0"
                            ToolTip="{Binding Folder}"
                        >
                            <Run Text="{Binding Folder, Mode=OneWay}" />
                            <Run Text="{Binding Mark, Mode=OneWay}" FontStyle="Italic" />
                        </TextBlock>
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource Secondary}"
                            Margin="0,0,8,0"
                            Padding="10,2"
                            Content="Open folder"
                            Command="{Binding DataContext.OpenDefaultFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                        />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A row of a category: its label, then its value as its kind draws it. -->
            <DataTemplate x:Key="SettingRow" DataType="{x:Type local:GlobalSettingRow}">
                <StackPanel Margin="18,3,0,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Label}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,0,8,0"
                        />
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource Box}"
                            Visibility="{Binding IsTyped, Converter={StaticResource Shown}}"
                        >
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding Unit}"
                                    Foreground="{StaticResource GhTextMuted}"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                />
                                <TextBox
                                    Style="{StaticResource GhTextBox}"
                                    Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                />
                            </DockPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource Box}"
                            Visibility="{Binding IsInfo, Converter={StaticResource Shown}}"
                        >
                            <TextBlock
                                Text="{Binding Value}"
                                Foreground="{StaticResource GhTextMuted}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsToggle, Converter={StaticResource Shown}}"
                        >
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{StaticResource GhTextMuted}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                            >
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Off" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Text" Value="On" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding Value, Mode=TwoWay}"
                            Visibility="{Binding IsChoice, Converter={StaticResource Shown}}"
                        />
                        <!-- A font: typed, the first family it starts found as typed, or chosen, each family in its own face. -->
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding Options}"
                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Visibility="{Binding IsFont, Converter={StaticResource Shown}}"
                            VirtualizingPanel.IsVirtualizing="True"
                            DropDownOpened="OnFontDropDownOpened"
                            AutomationProperties.Name="{Binding Label}"
                        >
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel Grid.Column="1" Visibility="{Binding IsColour, Converter={StaticResource Shown}}">
                            <ComboBox
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhComboBox}"
                                Width="128"
                                Margin="6,0,0,0"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding NamedColour, Mode=TwoWay}"
                                ToolTip="A named colour"
                            />
                            <Border Style="{StaticResource Box}">
                                <DockPanel>
                                    <Border
                                        DockPanel.Dock="Left"
                                        Width="14"
                                        Height="14"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        Margin="0,0,8,0"
                                        Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        Style="{StaticResource GhTextBox}"
                                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                    />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding Checks}"
                            Focusable="False"
                            Visibility="{Binding IsChecks, Converter={StaticResource Shown}}"
                        >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:GlobalSettingCheck}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                                        <CheckBox
                                            Style="{StaticResource GhCheckBox}"
                                            IsChecked="{Binding IsOn, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock
                        Text="{Binding Error}"
                        Foreground="{StaticResource GhError}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasError, Converter={StaticResource Shown}}"
                    />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Global settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource Secondary}"
                        Margin="0"
                        Content="Reset to defaults"
                        Command="{Binding ResetCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource Secondary}"
                        Content="OK"
                        Command="{Binding OkCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource Primary}"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource Secondary}"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Notice}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Margin="12,0,0,0"
                    />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The categories. -->
                <ListBox
                    Background="{StaticResource GhBg}"
                    BorderThickness="0"
                    Padding="0,8"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    Foreground="{StaticResource GhTextMuted}"
                >
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    x:Name="Name"
                                                    Text="{Binding Name}"
                                                    Foreground="{StaticResource GhTextMuted}"
                                                />
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="5,0"
                                                    CornerRadius="3"
                                                    Background="{StaticResource GhSelected}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsNew, Converter={StaticResource Shown}}"
                                                >
                                                    <TextBlock
                                                        Text="NEW"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource GhText}"
                                                    />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter
                                                    TargetName="Row"
                                                    Property="Background"
                                                    Value="{StaticResource GhSelected}"
                                                />
                                                <Setter
                                                    TargetName="Name"
                                                    Property="Foreground"
                                                    Value="{StaticResource GhText}"
                                                />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="16,12">
                        <TextBlock
                            Text="{Binding Intro}"
                            Foreground="{StaticResource GhTextMuted}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,4"
                        />

                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:GlobalSettingSection}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                            <local:IconView
                                                Size="12"
                                                StrokeThickness="2.5"
                                                Stroke="{StaticResource GhTextMuted}"
                                                Data="{StaticResource GhIconChevron}"
                                                VerticalAlignment="Center"
                                            />
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Margin="6,0,0,0"
                                            />
                                        </StackPanel>
                                        <ItemsControl
                                            ItemsSource="{Binding Rows}"
                                            ItemTemplate="{StaticResource SettingRow}"
                                            Focusable="False"
                                        />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Text and fonts: under its rows, the fonts drawn in others (the substitutions). -->
                        <StackPanel
                            Visibility="{Binding IsTextAndFontsPage, Converter={StaticResource Shown}}"
                            Margin="18,4,0,0"
                        >
                            <Border
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0"
                            >
                                <StackPanel>
                                    <Grid Background="{StaticResource GhHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Head}" Text="Font" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Drawn in" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FontSubstitutions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:FontSubstitutionRow}">
                                                <Border
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            Style="{StaticResource GhTextBox}"
                                                            Text="{Binding Font, UpdateSourceTrigger=LostFocus}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            Margin="8,0"
                                                        />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Style="{StaticResource GhTextBox}"
                                                            Text="{Binding DrawnIn, UpdateSourceTrigger=LostFocus}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            Margin="8,0"
                                                        />
                                                        <Button
                                                            Grid.Column="2"
                                                            Style="{StaticResource GhFlatButton}"
                                                            Width="20"
                                                            Height="20"
                                                            ToolTip="Take the substitution out"
                                                            Command="{Binding DataContext.RemoveFontSubstitutionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                        >
                                                            <local:IconView
                                                                Size="12"
                                                                StrokeThickness="2"
                                                                Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconClose}"
                                                            />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button
                                    Style="{StaticResource Secondary}"
                                    Margin="0"
                                    Content="Add substitution"
                                    Command="{Binding AddFontSubstitutionCommand}"
                                />
                            </StackPanel>
                        </StackPanel>

                        <!-- Folder preference: the font search folders and the support file search folders, each in order. -->
                        <StackPanel
                            Visibility="{Binding IsFolderPreferencePage, Converter={StaticResource Shown}}"
                            Margin="0,8,0,0"
                        >
                            <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <Grid Background="{StaticResource GhHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Head}" Text="Font search folders, in order" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FontFolders}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:FontFolderRow}">
                                                <Border
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            Style="{StaticResource GhTextBox}"
                                                            Text="{Binding Folder, UpdateSourceTrigger=LostFocus}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            Margin="8,0"
                                                        />
                                                        <Button
                                                            Grid.Column="1"
                                                            Style="{StaticResource GhFlatButton}"
                                                            Width="20"
                                                            Height="20"
                                                            ToolTip="Take the folder out"
                                                            Command="{Binding DataContext.RemoveFontFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                        >
                                                            <local:IconView
                                                                Size="12"
                                                                StrokeThickness="2"
                                                                Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconClose}"
                                                            />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl
                                        ItemsSource="{Binding DefaultFontFolders}"
                                        ItemTemplate="{StaticResource DefaultFolderRow}"
                                        Focusable="False"
                                    />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button
                                    Style="{StaticResource Secondary}"
                                    Margin="0"
                                    Content="Add folder"
                                    Command="{Binding AddFontFolderCommand}"
                                />
                            </StackPanel>
                            <TextBlock
                                Foreground="{StaticResource GhTextMuted}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Margin="0,6,0,0"
                                Text="{Binding FontOrderText}"
                            />
                            <!-- The support file search folders: where .lin and .pat files are looked for, after the drawing's folder. -->
                            <Border
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,12,0,0"
                            >
                                <StackPanel>
                                    <Grid Background="{StaticResource GhHeader}">
                                        <TextBlock
                                            Style="{StaticResource Head}"
                                            Text="Hatch pattern (.pat) and linetype (.lin) search folders, in order"
                                        />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SupportFolders}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:FontFolderRow}">
                                                <Border
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            Style="{StaticResource GhTextBox}"
                                                            Text="{Binding Folder, UpdateSourceTrigger=LostFocus}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            Margin="8,0"
                                                        />
                                                        <Button
                                                            Grid.Column="1"
                                                            Style="{StaticResource GhFlatButton}"
                                                            Width="20"
                                                            Height="20"
                                                            ToolTip="Take the folder out"
                                                            Command="{Binding DataContext.RemoveSupportFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                        >
                                                            <local:IconView
                                                                Size="12"
                                                                StrokeThickness="2"
                                                                Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconClose}"
                                                            />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl
                                        ItemsSource="{Binding DefaultSupportFolders}"
                                        ItemTemplate="{StaticResource DefaultFolderRow}"
                                        Focusable="False"
                                    />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button
                                    Style="{StaticResource Secondary}"
                                    Margin="0"
                                    Content="Add folder"
                                    Command="{Binding AddSupportFolderCommand}"
                                />
                            </StackPanel>
                            <TextBlock
                                Foreground="{StaticResource GhTextMuted}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Margin="0,6,0,0"
                                Text="{Binding HatchOrderText}"
                            />
                            <TextBlock
                                Foreground="{StaticResource GhTextMuted}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Margin="0,2,0,0"
                                Text="{Binding LinetypeOrderText}"
                            />

                            <!-- Python: the CPython the PYTHON palette, PYRUN and PYLOAD use, shown where the app uses Python. -->
                            <StackPanel Visibility="{Binding IsPythonUsed, Converter={StaticResource Shown}}">
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,2">
                                    <local:IconView
                                        Size="12"
                                        StrokeThickness="1.5"
                                        Stroke="{StaticResource GhTextMuted}"
                                        Data="{StaticResource GhIconChevron}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                    />
                                    <TextBlock
                                        Text="Python"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                    />
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="5,0"
                                        CornerRadius="3"
                                        Background="#1F4E79"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock Text="NEW" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Margin="18,0,0,4"
                                    Foreground="{StaticResource GhTextMuted}"
                                    TextWrapping="Wrap"
                                    Text="The CPython 3.11 to 3.15 (64-bit) the PYTHON palette, PYRUN and PYLOAD use. Empty: found automatically (PYTHONNET_PYDLL, then the Python launcher’s registry, newest first). A venv’s python.exe brings its packages."
                                />
                                <Grid Margin="18,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource GhTextMuted}"
                                        VerticalAlignment="Center"
                                        Text="Python (python.exe or its folder)"
                                    />
                                    <DockPanel Grid.Column="1">
                                        <Button
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource Secondary}"
                                            Margin="6,0,0,0"
                                            Content="Browse..."
                                            Command="{Binding BrowsePythonCommand}"
                                        />
                                        <Border
                                            Background="{StaticResource GhInput}"
                                            BorderBrush="{StaticResource GhBorder}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="6,2"
                                        >
                                            <TextBox
                                                Style="{StaticResource GhTextBox}"
                                                Tag="Automatic"
                                                FontFamily="{StaticResource GhMonoFont}"
                                                Text="{Binding PythonPath, UpdateSourceTrigger=LostFocus}"
                                                AutomationProperties.Name="Python"
                                            />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Text="Found"
                                    />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <Ellipse
                                            DockPanel.Dock="Left"
                                            Width="8"
                                            Height="8"
                                            Margin="0,5,8,0"
                                            VerticalAlignment="Top"
                                        >
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource GhError}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPythonUsable}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource GhOk}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding PythonFound}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF8A7A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPythonUsable}" Value="True">
                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{StaticResource GhText}"
                                                            />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Text="Source"
                                    />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        Text="{Binding PythonSource}"
                                    />
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Text="Passed over"
                                        Visibility="{Binding HasPythonPassedOver, Converter={StaticResource Shown}}"
                                    />
                                    <ItemsControl
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        Focusable="False"
                                        ItemsSource="{Binding PythonPassedOver}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Visibility="{Binding HasPythonPassedOver, Converter={StaticResource Shown}}"
                                    >
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border
                                    Margin="18,6,0,0"
                                    Padding="12,6"
                                    Background="{StaticResource GhInput}"
                                    BorderBrush="{StaticResource GhAccent}"
                                    BorderThickness="3,0,0,0"
                                    Visibility="{Binding HasPythonStarted, Converter={StaticResource Shown}}"
                                >
                                    <TextBlock
                                        Foreground="{StaticResource GhIcon}"
                                        TextWrapping="Wrap"
                                        Text="Python has started in this session: a change takes effect at the next start."
                                    />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Security: SECURELOAD, the trusted folders, LEGACYCODESEARCH and the files always loaded. -->
                        <StackPanel
                            Visibility="{Binding IsSecurityPage, Converter={StaticResource Shown}}"
                            Margin="0,0,0,0"
                        >
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <local:IconView
                                    Size="12"
                                    StrokeThickness="2.5"
                                    Stroke="{StaticResource GhTextMuted}"
                                    Data="{StaticResource GhIconChevron}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="Security Options"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="6,0,0,0"
                                />
                                <TextBlock
                                    Text="SECURELOAD"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <TextBlock
                                    Foreground="{StaticResource GhTextMuted}"
                                    TextWrapping="Wrap"
                                    Margin="0,2,0,6"
                                    Text="These settings restrict the locations from where executable files are loaded.  This helps protect against malicious code in executable files."
                                />
                                <RadioButton
                                    GroupName="SecureLoad"
                                    Style="{StaticResource SecurityRadio}"
                                    IsChecked="{Binding IsSecureLoadLeast, Mode=TwoWay}"
                                    Content="Least secure setting- Load executable files from all locations without displaying a warning."
                                >
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>
                                <RadioButton
                                    GroupName="SecureLoad"
                                    Style="{StaticResource SecurityRadio}"
                                    IsChecked="{Binding IsSecureLoadWarn, Mode=TwoWay}"
                                    Content="Load executable files from Trusted locations, and display a warning for other locations."
                                >
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>
                                <RadioButton
                                    GroupName="SecureLoad"
                                    Style="{StaticResource SecurityRadio}"
                                    IsChecked="{Binding IsSecureLoadMost, Mode=TwoWay}"
                                    Content="Most secure setting-- Load executable files from Trusted locations only.  All other executable files will be ignored."
                                >
                                    <RadioButton.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </RadioButton.ContentTemplate>
                                </RadioButton>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <local:IconView
                                    Size="12"
                                    StrokeThickness="2.5"
                                    Stroke="{StaticResource GhTextMuted}"
                                    Data="{StaticResource GhIconChevron}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="Trusted folders for executable files:"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="6,0,0,0"
                                />
                                <TextBlock
                                    Text="TRUSTEDPATHS"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                />
                            </StackPanel>
                            <StackPanel Margin="18,0,0,0">
                                <Border
                                    BorderBrush="{StaticResource GhBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ToolTip="Specifies which folders have permission to load and execute files that contain code. The program files folders and their subfolders are always trusted."
                                >
                                    <StackPanel>
                                        <Grid Background="{StaticResource GhHeader}">
                                            <TextBlock
                                                Style="{StaticResource Head}"
                                                Text="Folder, in order (\... at the end: its subfolders too)"
                                            />
                                        </Grid>
                                        <ListBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            ItemsSource="{Binding TrustedFolders}"
                                            SelectedItem="{Binding SelectedTrustedFolder, Mode=TwoWay}"
                                            ItemContainerStyle="{StaticResource TrustedRow}"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        />
                                    </StackPanel>
                                </Border>
                                <DockPanel Margin="0,8,0,0">
                                    <CheckBox
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource GhCheckBox}"
                                        Content="Include subfolders"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                                        IsEnabled="{Binding CanChangeTrustedFolder}"
                                    />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Style="{StaticResource Secondary}"
                                            Margin="0"
                                            Padding="12,3"
                                            Content="Add folder..."
                                            Command="{Binding AddTrustedFolderCommand}"
                                        />
                                        <Button
                                            Style="{StaticResource Secondary}"
                                            Padding="12,3"
                                            Content="Remove"
                                            Command="{Binding RemoveTrustedFolderCommand}"
                                        />
                                        <Button
                                            Style="{StaticResource Secondary}"
                                            Padding="12,3"
                                            Content="Move up"
                                            Command="{Binding MoveTrustedFolderUpCommand}"
                                        />
                                        <Button
                                            Style="{StaticResource Secondary}"
                                            Padding="12,3"
                                            Content="Move down"
                                            Command="{Binding MoveTrustedFolderDownCommand}"
                                        />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <local:IconView
                                    Size="12"
                                    StrokeThickness="2.5"
                                    Stroke="{StaticResource GhTextMuted}"
                                    Data="{StaticResource GhIconChevron}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="When searching for executable files:"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="6,0,0,0"
                                />
                                <TextBlock
                                    Text="LEGACYCODESEARCH"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                />
                            </StackPanel>
                            <StackPanel Margin="18,2,0,0">
                                <RadioButton
                                    GroupName="LegacyCodeSearch"
                                    Style="{StaticResource SecurityRadio}"
                                    IsChecked="{Binding LegacyCodeSearchExcluded, Mode=TwoWay}"
                                    Content="Exclude the Start In or drawing folders (recommended)"
                                />
                                <RadioButton
                                    GroupName="LegacyCodeSearch"
                                    Style="{StaticResource SecurityRadio}"
                                    IsChecked="{Binding LegacyCodeSearch, Mode=TwoWay}"
                                    Content="Include the Start In and drawing folders"
                                />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <local:IconView
                                    Size="12"
                                    StrokeThickness="2.5"
                                    Stroke="{StaticResource GhTextMuted}"
                                    Data="{StaticResource GhIconChevron}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="Files always loaded"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="6,0,0,0"
                                />
                            </StackPanel>
                            <Grid Margin="18,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AlwaysLoadedText}" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource Secondary}"
                                    Margin="12,0,0,0"
                                    Padding="12,3"
                                    Content="Forget"
                                    Command="{Binding ForgetAlwaysLoadedCommand}"
                                />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{StaticResource GhTextMuted}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Text="Answered Always Load: each loads with no question until it is edited."
                                />
                            </Grid>
                        </StackPanel>

                        <!-- Shortcuts: a search, then the commands with their aliases and keys. -->
                        <StackPanel
                            Visibility="{Binding IsShortcutsPage, Converter={StaticResource Shown}}"
                            Margin="0,8,0,0"
                        >
                            <DockPanel Margin="0,0,0,8">
                                <Button
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Secondary}"
                                    Content="Reset to AutoCAD defaults"
                                    Command="{Binding ResetShortcutsCommand}"
                                />
                                <Button
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Secondary}"
                                    Content="Import acad.pgp…"
                                    Command="{Binding ImportPgpCommand}"
                                    ToolTip="Take the command aliases of an acad.pgp file; its aliases win"
                                />
                                <Border Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5">
                                    <DockPanel>
                                        <local:IconView
                                            Size="14"
                                            StrokeThickness="2"
                                            Stroke="{StaticResource GhTextMuted}"
                                            Data="{StaticResource GhIconSearch}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBox
                                            Style="{StaticResource GhTextBox}"
                                            Tag="Search command, alias or key"
                                            Text="{Binding ShortcutSearch, UpdateSourceTrigger=PropertyChanged}"
                                        />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                            <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <Grid Background="{StaticResource GhHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Head}" Text="Command" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Alias" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="Keys" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="Description" />
                                    </Grid>
                                    <ItemsControl
                                        ItemsSource="{Binding Shortcuts}"
                                        Focusable="False"
                                        TextElement.FontFamily="{StaticResource GhMonoFont}"
                                    >
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ShortcutRowViewModel}">
                                                <Border
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="84" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Text="{Binding Command}"
                                                            Margin="8,0"
                                                            VerticalAlignment="Center"
                                                        />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Style="{StaticResource GhTextBox}"
                                                            Text="{Binding Aliases, UpdateSourceTrigger=LostFocus}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            Margin="8,0"
                                                        />
                                                        <Border
                                                            x:Name="KeyBox"
                                                            Grid.Column="2"
                                                            Background="{StaticResource GhInput}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="8,0"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                        >
                                                            <!-- The keys are pressed, not typed: Backspace or Delete clears, Esc gives the old ones back. -->
                                                            <TextBox
                                                                x:Name="KeysCell"
                                                                Style="{StaticResource GhTextBox}"
                                                                Text="{Binding Keys, Mode=OneWay}"
                                                                IsReadOnly="True"
                                                                IsReadOnlyCaretVisible="False"
                                                                InputMethod.IsInputMethodEnabled="False"
                                                                FontFamily="{StaticResource GhMonoFont}"
                                                                GotKeyboardFocus="OnKeysFocus"
                                                                LostKeyboardFocus="OnKeysLeft"
                                                                PreviewKeyDown="OnKeysPressed"
                                                                ToolTip="Press the keys; Backspace or Delete clears them, Esc gives the old ones back"
                                                                AutomationProperties.Name="Keys"
                                                            />
                                                        </Border>
                                                        <StackPanel
                                                            Grid.Column="3"
                                                            Margin="8,0"
                                                            TextElement.FontFamily="{StaticResource GhFont}"
                                                        >
                                                            <TextBlock
                                                                Text="{Binding Description}"
                                                                Foreground="{StaticResource GhTextMuted}"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                            <TextBlock
                                                                Text="{Binding Conflict}"
                                                                Foreground="{StaticResource GhError}"
                                                                Visibility="{Binding HasConflict, Converter={StaticResource Shown}}"
                                                            />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                        <Setter
                                                            TargetName="KeyBox"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCapturingKeys}" Value="True">
                                                        <Setter
                                                            TargetName="KeyBox"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhAccent}"
                                                        />
                                                        <Setter
                                                            TargetName="KeysCell"
                                                            Property="Tag"
                                                            Value="Press keys…"
                                                        />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
