<Window
    x:Class="GeometryHelper.Cad.Wpf.DesignCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="DesignCenter"
    Width="840"
    Height="620"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A button of the tool row: dark, outlined. -->
            <Style x:Key="DcTool" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <Style x:Key="DcToggle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="Box"
                                Background="Transparent"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                            >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#1F4E79" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The arrow of a node of the tree. -->
            <Style x:Key="DcArrow" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <TextBlock
                                x:Name="Arrow"
                                Text="▸"
                                FontSize="10"
                                Foreground="{StaticResource GhTextMuted}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                            />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="Text" Value="▾" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DcTreeItem" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="Node" Background="Transparent" Padding="2,3">
                                    <DockPanel>
                                        <ToggleButton
                                            x:Name="Arrow"
                                            DockPanel.Dock="Left"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,2,0"
                                            Style="{StaticResource DcArrow}"
                                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                            ClickMode="Press"
                                        />
                                        <ContentPresenter ContentSource="Header" />
                                    </DockPanel>
                                </Border>
                                <ItemsPresenter x:Name="Items" Margin="16,0,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Node"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DcRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                                Padding="6,4"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <local:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close (ADCCLOSE)"
                    />
                    <TextBlock
                        Text="DESIGNCENTER"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,8"
            >
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton
                            Style="{StaticResource DcToggle}"
                            Content="Tree"
                            IsChecked="{Binding ShowTree, Mode=TwoWay}"
                            ToolTip="Tree View Toggle: show or hide the tree"
                        />
                        <ToggleButton
                            Style="{StaticResource DcToggle}"
                            Content="Preview"
                            IsChecked="{Binding ShowPreview, Mode=TwoWay}"
                            ToolTip="Preview: show or hide the picture of the row selected"
                        />
                        <ToggleButton
                            Style="{StaticResource DcToggle}"
                            Content="Description"
                            IsChecked="{Binding ShowDescription, Mode=TwoWay}"
                            ToolTip="Description: show or hide the description of the row selected"
                            Margin="0"
                        />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="Load…"
                            Command="{Binding LoadCommand}"
                            ToolTip="Load: show a drawing file's content"
                        />
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="◀ Back"
                            Command="{Binding BackCommand}"
                            ToolTip="Back"
                        />
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="Forward ▶"
                            Command="{Binding ForwardCommand}"
                            ToolTip="Forward"
                        />
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="▲ Up"
                            Command="{Binding UpCommand}"
                            ToolTip="Up: the folder above"
                        />
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="Search"
                            IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Search: not offered"
                        />
                        <Button
                            Style="{StaticResource DcTool}"
                            Content="Favorites"
                            IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Favorites: not offered"
                        />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,0"
            >
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="FoldersTab"
                        Style="{StaticResource StyleTab}"
                        GroupName="Source"
                        Content="Folders"
                        IsChecked="True"
                        Checked="OnTab"
                    />
                    <RadioButton
                        x:Name="OpenTab"
                        Style="{StaticResource StyleTab}"
                        GroupName="Source"
                        Content="Open Drawings"
                        Checked="OnTab"
                    />
                    <RadioButton
                        x:Name="HistoryTab"
                        Style="{StaticResource StyleTab}"
                        GroupName="Source"
                        Content="History"
                        Checked="OnTab"
                    />
                </StackPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
            >
                <TextBlock
                    TextTrimming="CharacterEllipsis"
                    Foreground="{StaticResource GhTextMuted}"
                    Text="{Binding Message}"
                    ToolTip="{Binding Message}"
                />
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Height="200"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{Binding ShowPreview, Converter={StaticResource Shown}}"
            >
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="260" Background="Black" CornerRadius="2" Margin="0,0,12,0">
                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                    </Border>
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowDescription, Converter={StaticResource Shown}}"
                    >
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{StaticResource GhTextMuted}"
                            Text="{Binding Description}"
                        />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Height="64"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{Binding ShowPreview, Converter={StaticResource HiddenWhen}}"
            >
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhTextMuted}"
                    Visibility="{Binding ShowDescription, Converter={StaticResource Shown}}"
                    Text="{Binding Description}"
                />
            </Border>

            <DockPanel Margin="12,8,12,8">
                <Border
                    DockPanel.Dock="Top"
                    Background="{StaticResource GhCommandInput}"
                    CornerRadius="4"
                    Padding="8,4"
                    Margin="0,0,0,8"
                >
                    <TextBlock
                        Text="{Binding Location}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Location}"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                </Border>

                <Border
                    DockPanel.Dock="Left"
                    Width="250"
                    Margin="0,0,8,0"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding ShowTree, Converter={StaticResource Shown}}"
                >
                    <TreeView
                        x:Name="Tree"
                        ItemsSource="{Binding Roots}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,4"
                        Foreground="{StaticResource GhText}"
                        ItemContainerStyle="{StaticResource DcTreeItem}"
                        AutomationProperties.Name="DesignCenter tree"
                    >
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate
                                DataType="{x:Type local:DesignCenterNode}"
                                ItemsSource="{Binding Children}"
                                ItemContainerStyle="{StaticResource DcTreeItem}"
                            >
                                <TextBlock
                                    Text="{Binding Text}"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding Path}"
                                />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <ListBox
                        x:Name="ItemList"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Extended"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource DcRow}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch"
                        SelectionChanged="OnItemsSelected"
                        MouseDoubleClick="OnItemDoubleClick"
                        PreviewMouseMove="OnItemMouseMove"
                        PreviewMouseLeftButtonDown="OnItemMouseDown"
                        ContextMenuOpening="OnItemMenuOpening"
                        AutomationProperties.Name="DesignCenter content"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DesignCenterItemViewModel}">
                                <DockPanel>
                                    <Border
                                        DockPanel.Dock="Left"
                                        Width="72"
                                        Height="54"
                                        Background="Black"
                                        CornerRadius="2"
                                        Margin="0,0,10,0"
                                    >
                                        <Image Source="{Binding Picture}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource GhText}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Text="{Binding Description}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
