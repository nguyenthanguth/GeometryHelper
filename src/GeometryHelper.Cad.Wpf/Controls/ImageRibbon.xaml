<UserControl
    x:Class="GeometryHelper.Cad.Wpf.ImageRibbon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
>
    <!--
    The contextual Image tab, as AutoCAD 2021 draws it for images: Adjust (Brightness, Contrast and Fade, each a slider and a
    box from 0 to 100, greyed for a bitonal picture), Clipping (Create Clipping Boundary, Remove Clipping), Options (Show Image,
    Transparency and the Frame box of the drawing) and Close. Its logic is ImageTabViewModel; each value changed is one undo
    step named after the command that changes the same thing. The ribbon's styles are the workspace's, found at run time
    (DynamicResource).
    -->
    <UserControl.Resources>
        <Geometry x:Key="IconClipCreate">M6 6h12v12H6zM3 9V3h6M21 15v6h-6</Geometry>
        <Geometry x:Key="IconClipRemove">M6 6h12v12H6zM3 3l18 18</Geometry>
        <Geometry x:Key="IconCloseImage">M5 5l14 14M19 5L5 19</Geometry>
        <Style x:Key="ImageLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
        <Style x:Key="ImageLevel" TargetType="Slider">
            <Setter Property="Width" Value="130" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,2" />
        </Style>
        <Style x:Key="ImageField" TargetType="TextBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="local:CommitOnEnter.Enabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- Adjust: the three levels of IMAGEADJUST. -->
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Adjust" />
                <Grid
                    IsEnabled="{Binding CanAdjust}"
                    ToolTip="A bitonal picture has no brightness, contrast or fade to adjust"
                >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource ImageLabel}" Text="Brightness" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ImageLevel}"
                        AutomationProperties.Name="Brightness"
                        Value="{Binding Brightness, Mode=TwoWay, Delay=300}"
                    />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource ImageField}"
                        AutomationProperties.Name="Brightness value"
                        Text="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    />
                    <TextBlock Grid.Row="1" Style="{StaticResource ImageLabel}" Text="Contrast" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ImageLevel}"
                        AutomationProperties.Name="Contrast"
                        Value="{Binding Contrast, Mode=TwoWay, Delay=300}"
                    />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource ImageField}"
                        AutomationProperties.Name="Contrast value"
                        Text="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    />
                    <TextBlock Grid.Row="2" Style="{StaticResource ImageLabel}" Text="Fade" />
                    <Slider
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource ImageLevel}"
                        AutomationProperties.Name="Fade"
                        Value="{Binding Fade, Mode=TwoWay, Delay=300}"
                    />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource ImageField}"
                        AutomationProperties.Name="Fade value"
                        Text="{Binding Fade, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Clipping: IMAGECLIP's New boundary and Delete. -->
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Clipping" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconClipCreate}"
                        Content="Create Clipping Boundary"
                        IsEnabled="True"
                        Command="{Binding CreateClipCommand}"
                        ToolTip="IMAGECLIP, New boundary: pick a rectangle or a polygon on the image (one image at a time)"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconClipRemove}"
                        Content="Remove Clipping"
                        IsEnabled="True"
                        Command="{Binding RemoveClipCommand}"
                        ToolTip="IMAGECLIP, Delete: the image shows its whole picture again"
                    />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Options: Show Image, Transparency and the drawing's image frames (IMAGEFRAME). -->
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Options" />
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                    <CheckBox
                        Content="Show Image"
                        Margin="0,0,0,4"
                        IsChecked="{Binding ShowImage}"
                        ToolTip="Off, the image is shown as its frame alone"
                    />
                    <CheckBox
                        Content="Transparency"
                        Margin="0,0,0,4"
                        IsChecked="{Binding Transparency}"
                        ToolTip="TRANSPARENCY: the background of a bitonal picture lets what is under the image show"
                    />
                    <ComboBox
                        Style="{DynamicResource GhComboBox}"
                        Width="170"
                        ItemsSource="{Binding FrameNames}"
                        SelectedItem="{Binding Frame, Mode=TwoWay}"
                        ToolTip="Frame: IMAGEFRAME, whether the frames of the images are shown and plotted"
                    />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Close. -->
        <Border Style="{DynamicResource GroupBorder}" BorderThickness="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Close" />
                <Button
                    Style="{DynamicResource BigButton}"
                    Tag="{StaticResource IconCloseImage}"
                    Content="Close Image"
                    IsEnabled="True"
                    Command="{Binding CloseCommand}"
                    Margin="0"
                    ToolTip="Close the tab: the images are let go"
                />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
