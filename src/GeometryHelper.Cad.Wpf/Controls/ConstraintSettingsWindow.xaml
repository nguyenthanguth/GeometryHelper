<Window
    x:Class="GeometryHelper.Cad.Wpf.ConstraintSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Constraint Settings"
    Width="560"
    Height="520"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />

            <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource StyleCheck}">
                <Setter Property="Margin" Value="0,3,0,3" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- One type of the Geometric tab: its box and its glyph's name. -->
            <DataTemplate x:Key="BarType" DataType="{x:Type local:BarTypeViewModel}">
                <CheckBox
                    Style="{StaticResource Check}"
                    Content="{Binding Name}"
                    IsChecked="{Binding Shown, Mode=TwoWay}"
                />
            </DataTemplate>

            <!-- One line of the AutoConstrain list: the box that applies the type, and its name. -->
            <DataTemplate x:Key="RuleRow" DataType="{x:Type local:AutoConstrainRuleViewModel}">
                <CheckBox
                    Style="{StaticResource Check}"
                    Content="{Binding Name}"
                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Constraint Settings"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: what is wrong, then Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhWarn}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>

            <!-- The tabs, in AutoCAD's order. -->
            <Border DockPanel.Dock="Top" Padding="16,10,16,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Geometric"
                        IsChecked="{Binding IsGeometricTab, Mode=TwoWay}"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Dimensional"
                        IsChecked="{Binding IsDimensionalTab, Mode=TwoWay}"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="AutoConstrain"
                        IsChecked="{Binding IsAutoConstrainTab, Mode=TwoWay}"
                    />
                </StackPanel>
            </Border>

            <Grid Margin="16,12">
                <!-- Geometric: infer, the bars after applying and for the selection, their transparency, the types they show. -->
                <StackPanel Visibility="{Binding IsGeometricTab, Converter={StaticResource Shown}}">
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Infer geometric constraints">
                        <CheckBox
                            Style="{StaticResource Check}"
                            Content="Infer geometric constraints"
                            IsChecked="{Binding InferConstraints, Mode=TwoWay}"
                        />
                    </HeaderedContentControl>
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Constraint bar display settings"
                        Margin="0,12,0,0"
                    >
                        <StackPanel>
                            <TextBlock
                                Text="Select the geometric constraints to show on constraint bars"
                                Style="{StaticResource Label}"
                                Margin="0,0,0,6"
                            />
                            <ItemsControl
                                ItemsSource="{Binding BarTypes}"
                                ItemTemplate="{StaticResource BarType}"
                                Focusable="False"
                            >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="Select All"
                                    Padding="12,4"
                                    Margin="0,0,8,0"
                                    Command="{Binding SelectAllCommand}"
                                />
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="Clear All"
                                    Padding="12,4"
                                    Command="{Binding ClearAllCommand}"
                                />
                            </StackPanel>
                            <CheckBox
                                Style="{StaticResource Check}"
                                Content="Show constraint bars after applying constraints to selected objects"
                                IsChecked="{Binding ShowBarsAfterApplying, Mode=TwoWay}"
                                Margin="0,12,0,3"
                            />
                            <CheckBox
                                Style="{StaticResource Check}"
                                Content="Show constraint bars of the objects selected"
                                IsChecked="{Binding ShowBarsOfSelection, Mode=TwoWay}"
                            />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock
                                    Text="Constraint bar transparency"
                                    Style="{StaticResource Label}"
                                    Width="180"
                                />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding Transparency, StringFormat={}{0:0}%}"
                                    Width="40"
                                    TextAlignment="Right"
                                    VerticalAlignment="Center"
                                />
                                <Slider
                                    Minimum="0"
                                    Maximum="90"
                                    Value="{Binding Transparency, Mode=TwoWay}"
                                    AutomationProperties.Name="Constraint bar transparency"
                                />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- Dimensional: the words, the form, the dynamic ones shown. -->
                <StackPanel Visibility="{Binding IsDimensionalTab, Converter={StaticResource Shown}}">
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Dimensional constraint format">
                        <DockPanel>
                            <TextBlock Text="Dimension name format:" Style="{StaticResource Label}" Width="150" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                ItemsSource="{Binding NameFormats}"
                                SelectedIndex="{Binding NameFormat, Mode=TwoWay}"
                                Width="200"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Dimension name format"
                            />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Form of new dimensional constraints"
                        Margin="0,12,0,0"
                    >
                        <StackPanel>
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="Dynamic (shown on the hidden layer, not plotted)"
                                IsChecked="{Binding Dynamic, Mode=TwoWay}"
                                GroupName="Form"
                                Margin="0,3,0,3"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="Annotational (an ordinary dimension on the current layer)"
                                IsChecked="{Binding Annotational, Mode=TwoWay}"
                                GroupName="Form"
                                Margin="0,3,0,3"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Dynamic dimensional constraints"
                        Margin="0,12,0,0"
                    >
                        <CheckBox
                            Style="{StaticResource Check}"
                            Content="Show dynamic dimensional constraints"
                            IsChecked="{Binding ShowDynamicConstraints, Mode=TwoWay}"
                        />
                    </HeaderedContentControl>
                </StackPanel>

                <!-- AutoConstrain: the order and the types, the tolerances, the two boxes. -->
                <StackPanel Visibility="{Binding IsAutoConstrainTab, Converter={StaticResource Shown}}">
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Priority and constraints to apply"
                    >
                        <DockPanel Height="190">
                            <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="Move Up"
                                    Padding="12,4"
                                    Margin="0,0,0,8"
                                    Command="{Binding MoveUpCommand}"
                                />
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="Move Down"
                                    Padding="12,4"
                                    Command="{Binding MoveDownCommand}"
                                />
                            </StackPanel>
                            <ListBox
                                ItemsSource="{Binding Rules}"
                                SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                ItemTemplate="{StaticResource RuleRow}"
                                Background="{StaticResource GhInput}"
                                BorderBrush="{StaticResource GhBorder}"
                                AutomationProperties.Name="Constraints to apply"
                            />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Tolerances" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Distance:" Style="{StaticResource Label}" Width="80" />
                                <TextBox
                                    Style="{StaticResource StyleBox}"
                                    Width="110"
                                    HorizontalAlignment="Left"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    Text="{Binding DistanceText, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Distance tolerance"
                                />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Angle:" Style="{StaticResource Label}" Width="80" />
                                <TextBox
                                    Style="{StaticResource StyleBox}"
                                    Width="110"
                                    HorizontalAlignment="Left"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    Text="{Binding AngleText, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Angle tolerance"
                                />
                            </DockPanel>
                            <CheckBox
                                Style="{StaticResource Check}"
                                Content="Tangent objects must share an intersection point"
                                IsChecked="{Binding TangentAtIntersection, Mode=TwoWay}"
                                Margin="0,12,0,3"
                            />
                            <CheckBox
                                Style="{StaticResource Check}"
                                Content="Perpendicular objects must share an intersection point"
                                IsChecked="{Binding PerpendicularAtIntersection, Mode=TwoWay}"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
