<Window
    x:Class="GeometryHelper.Cad.Wpf.PublishImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Import Page Setups for Publishing"
    Width="440"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- Import Page Setups for Publishing, from Import… in a sheet's Page Setup list of Publish: the page setups of the drawing chosen, one picked for the sheet. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                        IsDefault="True"
                        IsEnabled="{Binding CanOk}"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Source drawing:" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,3" />
                    <TextBlock
                        Text="{Binding FileName}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FileName}"
                        AutomationProperties.Name="Source drawing name"
                    />
                </StackPanel>
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <ListBox
                        ItemsSource="{Binding Names}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SetupRow}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Page setups to import"
                        MouseDoubleClick="OnOk"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    Padding="8,5"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
