<Window
    x:Class="GeometryHelper.Cad.Wpf.OverkillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Delete Duplicate Objects"
    Width="520"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One property of the Ignore group: its box and its name. -->
            <DataTemplate x:Key="IgnoreBox" DataType="{x:Type local:OverkillIgnoreViewModel}">
                <CheckBox
                    Style="{StaticResource StyleCheck}"
                    Content="{Binding Name}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    Margin="0,3,0,3"
                />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Delete Duplicate Objects"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: what is wrong, or how many objects are selected, then Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        x:Name="Notice"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{Binding SelectedText}"
                        Foreground="{StaticResource GhTextMuted}"
                        FontFamily="{StaticResource GhMonoFont}"
                        FontSize="11"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <DockPanel>
                    <TextBlock Text="Tolerance:" VerticalAlignment="Center" Width="80" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Width="140"
                        HorizontalAlignment="Left"
                        FontFamily="{StaticResource GhMonoFont}"
                        Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Tolerance"
                    />
                </DockPanel>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Ignore object property"
                    Margin="0,12,0,0"
                >
                    <ItemsControl
                        ItemsSource="{Binding Ignored}"
                        ItemTemplate="{StaticResource IgnoreBox}"
                        Focusable="False"
                    >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Options" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Optimize segments within polylines"
                            IsChecked="{Binding OptimizePolylines, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <StackPanel Margin="20,0,0,0" IsEnabled="{Binding CanEditPolylineOptions}">
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Ignore polyline segment widths"
                                IsChecked="{Binding IgnorePolylineWidths, Mode=TwoWay}"
                                Margin="0,0,0,6"
                            />
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Do not break polylines"
                                IsChecked="{Binding DoNotBreakPolylines, Mode=TwoWay}"
                                Margin="0,0,0,6"
                            />
                        </StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Combine co-linear objects that partially overlap"
                            IsChecked="{Binding CombinePartialOverlaps, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Combine co-linear objects when aligned end to end"
                            IsChecked="{Binding CombineEndToEnd, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Maintain associative objects"
                            IsChecked="{Binding MaintainAssociativity, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <TextBlock
                    Text="{Binding Message}"
                    Foreground="{StaticResource GhWarn}"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
