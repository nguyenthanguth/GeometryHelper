<Window
    x:Class="GeometryHelper.Cad.Wpf.MTextFindReplaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find and Replace"
    Width="470"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Side" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The MTEXT editor's own Find and Replace, which stays open beside the words: Find what and Replace with, the five options, Find Next, Replace, Replace All. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Find and Replace" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,8">
                <TextBlock
                    Text="{Binding FindMessage}"
                    MinHeight="16"
                    Foreground="{StaticResource GhTextMuted}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                />
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource StyleLabel}" Text="Find what:" Margin="0,0,0,4" />
                    <TextBox
                        x:Name="FindBox"
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        Margin="0,0,0,10"
                        AutomationProperties.Name="Find what"
                        Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBlock Style="{StaticResource StyleLabel}" Text="Replace with:" Margin="0,0,0,4" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        Margin="0,0,0,2"
                        AutomationProperties.Name="Replace with"
                        Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Options" Margin="0">
                        <StackPanel>
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Match case"
                                IsChecked="{Binding MatchCase, Mode=TwoWay}"
                                AutomationProperties.Name="Match case"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Whole words only"
                                IsChecked="{Binding WholeWords, Mode=TwoWay}"
                                AutomationProperties.Name="Whole words only"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Use wildcards"
                                IsChecked="{Binding UseWildcards, Mode=TwoWay}"
                                AutomationProperties.Name="Use wildcards"
                                ToolTip="* any run of characters, ? one character, # a digit, @ a letter, [AB] one of those"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Match diacritics"
                                IsChecked="{Binding MatchDiacritics, Mode=TwoWay}"
                                AutomationProperties.Name="Match diacritics"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Match half/full width forms"
                                IsChecked="{Binding MatchHalfFullWidth, Mode=TwoWay}"
                                AutomationProperties.Name="Match half/full width forms"
                                Margin="0"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,18,0,0">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Padding="8,5"
                        Margin="0,0,0,6"
                        Content="Find Next"
                        Command="{Binding FindNextCommand}"
                        IsDefault="True"
                    />
                    <Button Style="{StaticResource Side}" Content="Replace" Command="{Binding ReplaceCommand}" />
                    <Button Style="{StaticResource Side}" Content="Replace All" Command="{Binding ReplaceAllCommand}" />
                    <Button
                        Style="{StaticResource Side}"
                        Margin="0,10,0,0"
                        Content="Close"
                        Click="OnClose"
                        IsCancel="True"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
