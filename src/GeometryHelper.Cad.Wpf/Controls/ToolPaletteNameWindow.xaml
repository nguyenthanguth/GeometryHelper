<Window
    x:Class="GeometryHelper.Cad.Wpf.ToolPaletteNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tool palette name"
    Width="380"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- New Palette, Rename Palette, Rename Tool and Add Text of the tool palettes: one line of text asked. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                        IsDefault="True"
                        IsEnabled="{Binding CanOk}"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,12">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,6" />
                <TextBox
                    x:Name="NameBox"
                    Style="{StaticResource BlockBox}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Name"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
