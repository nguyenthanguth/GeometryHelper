<Window
    x:Class="GeometryHelper.Cad.Wpf.VisibilityStatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="520"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="14,5"
                        Click="OnClose"
                        IsDefault="True"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhWarn}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        AutomationProperties.Name="Message"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Visibility states"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,0,0,3"
                    />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="Name" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,3" />
                        <TextBox
                            Style="{StaticResource BlockBox}"
                            Margin="0,0,0,8"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Name of the state"
                        />
                        <TextBlock
                            Text="Visibility options for new states"
                            Foreground="{StaticResource GhTextMuted}"
                            Margin="0,0,0,3"
                        />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding How, Mode=TwoWay}"
                            AutomationProperties.Name="Visibility options for new states"
                        />
                    </StackPanel>
                    <ListBox
                        ItemsSource="{Binding States}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        Background="{StaticResource GhInput}"
                        Foreground="{StaticResource GhText}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        Padding="0,2"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="Visibility states of the block"
                    />
                </DockPanel>

                <StackPanel Grid.Column="2" Margin="0,20,0,0">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="New"
                        Command="{Binding NewCommand}"
                        Margin="0,0,0,6"
                        Padding="10,5"
                        ToolTip="A state of the name typed, showing what the option says"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Rename"
                        Command="{Binding RenameCommand}"
                        Margin="0,0,0,6"
                        Padding="10,5"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Delete"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,0,6"
                        Padding="10,5"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Move Up"
                        Command="{Binding MoveUpCommand}"
                        Margin="0,0,0,6"
                        Padding="10,5"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Move Down"
                        Command="{Binding MoveDownCommand}"
                        Margin="0,0,0,6"
                        Padding="10,5"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Set Current"
                        Command="{Binding SetCurrentCommand}"
                        Padding="10,5"
                        ToolTip="Show the state in the Block Editor"
                    />
                    <TextBlock
                        Text="{Binding Current, StringFormat=Current: {0}}"
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
