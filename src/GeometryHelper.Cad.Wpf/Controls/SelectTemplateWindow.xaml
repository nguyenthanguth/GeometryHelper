<Window
    x:Class="GeometryHelper.Cad.Wpf.SelectTemplateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select Template"
    Width="520"
    Height="440"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design SelectTemplate: the templates of the template folder, Browse, Open with no Template - Metric or Imperial. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Select Template" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Open"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        IsEnabled="{Binding CanOpen}"
                        AutomationProperties.Name="Open"
                        Click="OnOpen"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        IsCancel="True"
                        Click="OnCancel"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Content="Browse…"
                        Padding="14,4"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Browse"
                        Command="{Binding BrowseCommand}"
                        ToolTip="Choose a .dwt, .dwg or .dxf file in another folder"
                    />
                    <TextBlock Text="Look in:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock
                        Text="{Binding Folder}"
                        ToolTip="{Binding Folder}"
                        FontFamily="{StaticResource GhMonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                    />
                </DockPanel>

                <Border
                    DockPanel.Dock="Bottom"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="0,1,0,0"
                    Margin="0,10,0,0"
                    Padding="0,10,0,0"
                >
                    <StackPanel>
                        <TextBlock Text="Or start without a template" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Open with no Template - Metric"
                                Padding="12,4"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Open with no Template - Metric"
                                Click="OnOpenMetric"
                                ToolTip="Millimetres, ISO-25 dimensions, an A3 sheet of limits"
                            />
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Open with no Template - Imperial"
                                Padding="12,4"
                                AutomationProperties.Name="Open with no Template - Imperial"
                                Click="OnOpenImperial"
                                ToolTip="Inches, Standard dimensions, limits of 12 by 9"
                            />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    DockPanel.Dock="Bottom"
                    Text="{Binding SelectedDescription}"
                    Foreground="{StaticResource GhTextMuted}"
                    TextWrapping="Wrap"
                    MinHeight="32"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Description"
                />

                <Grid>
                    <ListBox
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        Foreground="{StaticResource GhText}"
                        SelectionMode="Single"
                        AutomationProperties.Name="Templates"
                        ItemsSource="{Binding Templates}"
                        SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                        MouseDoubleClick="OnOpen"
                    >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource StyleListItem}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Text="{Binding Kind}"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Margin="12,0,0,0"
                                    />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Text="No template in this folder. Browse for one, or open with no template."
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        IsHitTestVisible="False"
                    >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
