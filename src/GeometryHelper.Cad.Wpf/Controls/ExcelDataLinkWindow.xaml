<Window
    x:Class="GeometryHelper.Cad.Wpf.ExcelDataLinkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Excel Data Link"
    Width="560"
    Height="640"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design ExcelDataLink: New Excel Data Link / Modify Excel Link: name, file and path type, link options, preview, More Options. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            Command="{Binding OkCommand}"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Text="Name:"
                        Width="48"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Data link name"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </DockPanel>

                <TextBlock
                    Text="Choose an Excel file (.xlsx) or a comma delimited file (.csv):"
                    Foreground="{StaticResource GhTextMuted}"
                    Margin="0,0,0,4"
                />
                <DockPanel Margin="0,0,0,6">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource SideButton}"
                        Margin="8,0,0,0"
                        Content="Browse…"
                        Click="OnBrowse"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Excel file"
                        Text="{Binding File, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Path type:" Foreground="{StaticResource GhTextMuted}" Margin="0,0,12,0" />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Path"
                        Content="Full path"
                        Margin="0,0,14,0"
                        IsChecked="{Binding IsFullPath, Mode=TwoWay}"
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Path"
                        Content="Relative path"
                        Margin="0,0,14,0"
                        IsEnabled="{Binding CanBeRelative}"
                        IsChecked="{Binding IsRelativePath, Mode=TwoWay}"
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Path"
                        Content="No path"
                        IsChecked="{Binding IsNoPath, Mode=TwoWay}"
                    />
                </StackPanel>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Link options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Link"
                            Content="Link entire sheet"
                            Margin="0,0,0,8"
                            IsChecked="{Binding IsEntireSheet, Mode=TwoWay}"
                        />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsEntireSheet}"
                            ItemsSource="{Binding Sheets}"
                            SelectedItem="{Binding Sheet, Mode=TwoWay}"
                            AutomationProperties.Name="Sheet"
                        />
                        <RadioButton
                            Grid.Row="1"
                            Style="{StaticResource BlockRadio}"
                            GroupName="Link"
                            Content="Link to a named range"
                            Margin="0,0,0,8"
                            IsChecked="{Binding IsNamedRange, Mode=TwoWay}"
                        />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IsNamedRange}"
                            ItemsSource="{Binding NamedRanges}"
                            SelectedItem="{Binding NamedRange, Mode=TwoWay}"
                            AutomationProperties.Name="Named range"
                        />
                        <RadioButton
                            Grid.Row="2"
                            Style="{StaticResource BlockRadio}"
                            GroupName="Link"
                            Content="Link to a range"
                            IsChecked="{Binding IsCellRange, Mode=TwoWay}"
                        />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Vertical"
                            IsEnabled="{Binding IsCellRange}"
                        >
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Margin="0,0,0,6"
                                ItemsSource="{Binding Sheets}"
                                SelectedItem="{Binding Sheet, Mode=TwoWay}"
                                AutomationProperties.Name="Sheet of the range"
                            />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                AutomationProperties.Name="Range"
                                ToolTip="A1:D10 for a rectangular region, A:A for one whole column, A:D for a set of columns"
                                Text="{Binding Range, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <TextBlock
                                Text="&lt;Example: A1:M9&gt;"
                                FontSize="11"
                                Foreground="{StaticResource GhTextMuted}"
                                Margin="0,2,0,0"
                            />
                        </StackPanel>
                    </Grid>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Preview">
                    <Border
                        Height="130"
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                    >
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Text="{Binding Preview}"
                                FontFamily="{StaticResource GhMonoFont}"
                                FontSize="11"
                                Padding="8,6"
                                AutomationProperties.Name="Preview"
                            />
                        </ScrollViewer>
                    </Border>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="More options">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Use Excel formatting"
                            Margin="0,0,0,6"
                            IsChecked="{Binding UseExcelFormatting, Mode=TwoWay}"
                        />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Allow writing to the source file"
                            IsChecked="{Binding AllowWritingToSource, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
