<Window
    x:Class="GeometryHelper.Cad.Wpf.LayerFilterPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Layer Filter Properties"
    Width="1080"
    Height="640"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RgbBrushConverter x:Key="RgbBrush" />
            <Style x:Key="HeadCell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="RuleBox" TargetType="TextBox" BasedOn="{StaticResource StyleBox}">
                <Setter Property="Margin" Value="3,2" />
            </Style>
            <Style x:Key="RuleCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                <Setter Property="Margin" Value="3,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: why OK is greyed, then OK and Cancel. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                            IsEnabled="{Binding CanOk}"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>

            <DockPanel Margin="16,12">
                <!-- The name of the filter. -->
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource StyleLabel}"
                        Text="Filter name:"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                    />
                    <TextBox
                        x:Name="NameBox"
                        Style="{StaticResource StyleBox}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filter name"
                    />
                </DockPanel>

                <!-- The definition: a row of cells for each way a layer can pass; the cells scroll sideways. -->
                <HeaderedContentControl
                    DockPanel.Dock="Top"
                    Style="{StaticResource BlockGroup}"
                    Header="Filter definition"
                    Margin="0,8,0,0"
                >
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Add row"
                                Command="{Binding AddRowCommand}"
                                ToolTip="Another way for a layer to pass: the layers that pass any row are shown"
                            />
                            <TextBlock
                                Foreground="{StaticResource GhTextMuted}"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Text="A cell takes * ? [AB] and a leading ~ for not; a row is passed by a layer that passes all its cells."
                            />
                        </StackPanel>
                        <TextBox
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource StyleBox}"
                            Margin="0,8,0,0"
                            Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding ExpressionIsReadOnly}"
                            FontFamily="{StaticResource GhMonoFont}"
                            ToolTip="The definition as the drawing keeps it"
                            AutomationProperties.Name="Filter definition as text"
                        />
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Height="148"
                        >
                            <StackPanel>
                                <Grid Background="{StaticResource GhHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource HeadCell}" Text="Name" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="On" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="Freeze" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Lock" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="Colour" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Linetype" />
                                    <TextBlock Grid.Column="6" Style="{StaticResource HeadCell}" Text="Lineweight" />
                                    <TextBlock Grid.Column="7" Style="{StaticResource HeadCell}" Text="Transparency" />
                                    <TextBlock Grid.Column="8" Style="{StaticResource HeadCell}" Text="Plot Style" />
                                    <TextBlock Grid.Column="9" Style="{StaticResource HeadCell}" Text="Plot" />
                                    <TextBlock
                                        Grid.Column="10"
                                        Style="{StaticResource HeadCell}"
                                        Text="New VP Freeze"
                                    />
                                    <TextBlock Grid.Column="11" Style="{StaticResource HeadCell}" Text="Description" />
                                    <TextBlock Grid.Column="12" Style="{StaticResource HeadCell}" Text="VP Freeze" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:LayerFilterRuleRowViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="116" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="156" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Style="{StaticResource RuleBox}"
                                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Name pattern"
                                                />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.OnChoices}"
                                                    SelectedItem="{Binding On, Mode=TwoWay}"
                                                    ToolTip="On or off"
                                                />
                                                <ComboBox
                                                    Grid.Column="2"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.FreezeChoices}"
                                                    SelectedItem="{Binding Freeze, Mode=TwoWay}"
                                                    ToolTip="Frozen or thawed"
                                                />
                                                <ComboBox
                                                    Grid.Column="3"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.LockChoices}"
                                                    SelectedItem="{Binding Lock, Mode=TwoWay}"
                                                    ToolTip="Locked or unlocked"
                                                />
                                                <ComboBox
                                                    Grid.Column="4"
                                                    Style="{StaticResource RuleCombo}"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Static local:LayerManagerViewModel.ColorNames}"
                                                    Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="Colour: a name, an index as 30, a true colour as 10,20,30"
                                                />
                                                <TextBox
                                                    Grid.Column="5"
                                                    Style="{StaticResource RuleBox}"
                                                    Text="{Binding Linetype, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Linetype pattern"
                                                />
                                                <ComboBox
                                                    Grid.Column="6"
                                                    Style="{StaticResource RuleCombo}"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Static local:LayerManagerViewModel.WeightNames}"
                                                    Text="{Binding Lineweight, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="Lineweight: Default or a width as 0.35"
                                                />
                                                <ComboBox
                                                    Grid.Column="7"
                                                    Style="{StaticResource RuleCombo}"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Static local:LayerManagerViewModel.TransparencyNames}"
                                                    Text="{Binding Transparency, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="Transparency in per cent"
                                                />
                                                <TextBox
                                                    Grid.Column="8"
                                                    Style="{StaticResource RuleBox}"
                                                    Text="{Binding PlotStyle, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Plot style pattern"
                                                />
                                                <ComboBox
                                                    Grid.Column="9"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.PlotChoices}"
                                                    SelectedItem="{Binding Plot, Mode=TwoWay}"
                                                    ToolTip="Plotted or not"
                                                />
                                                <ComboBox
                                                    Grid.Column="10"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.VpChoices}"
                                                    SelectedItem="{Binding NewVpFreeze, Mode=TwoWay}"
                                                    ToolTip="Frozen in new viewports"
                                                />
                                                <TextBox
                                                    Grid.Column="11"
                                                    Style="{StaticResource RuleBox}"
                                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Description pattern"
                                                />
                                                <ComboBox
                                                    Grid.Column="12"
                                                    Style="{StaticResource RuleCombo}"
                                                    ItemsSource="{x:Static local:LayerFilterEditViewModel.VpChoices}"
                                                    SelectedItem="{Binding VpFreeze, Mode=TwoWay}"
                                                    ToolTip="Frozen in the current viewport"
                                                />
                                                <Button
                                                    Grid.Column="13"
                                                    Style="{StaticResource GhFlatButton}"
                                                    Content="✕"
                                                    Margin="2,2"
                                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove this row"
                                                />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </HeaderedContentControl>

                <!-- The preview: the layers the filter lets through, with the filters it is nested in. -->
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Filter preview" Margin="0,8,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource HeadCell}" Text="Name" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="On" />
                            <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="Freeze" />
                            <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Lock" />
                            <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="Colour" />
                            <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Linetype" />
                            <TextBlock Grid.Column="6" Style="{StaticResource HeadCell}" Text="Plot" />
                            <TextBlock Grid.Column="7" Style="{StaticResource HeadCell}" Text="Description" />
                        </Grid>
                        <ListBox
                            ItemsSource="{Binding Preview}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            IsHitTestVisible="False"
                            Foreground="{StaticResource GhText}"
                            AutomationProperties.Name="Layers the filter lets through"
                        >
                            <!-- No inset of the system's row, so that a row's columns start where the header's do. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LayerFilterPreviewRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Name}"
                                            ToolTip="{Binding Name}"
                                            FontWeight="SemiBold"
                                        />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding On}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Freeze}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Lock}"
                                        />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0">
                                            <Border
                                                Width="12"
                                                Height="12"
                                                BorderBrush="{StaticResource GhBorder}"
                                                BorderThickness="1"
                                                Margin="0,0,6,0"
                                                Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                                                VerticalAlignment="Center"
                                            />
                                            <TextBlock Text="{Binding Color}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="5"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Linetype}"
                                            FontFamily="{StaticResource GhMonoFont}"
                                        />
                                        <TextBlock
                                            Grid.Column="6"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Plot}"
                                        />
                                        <TextBlock
                                            Grid.Column="7"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Description}"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </HeaderedContentControl>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
