<Window
    x:Class="GeometryHelper.Cad.Wpf.ToolPaletteViewOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="View Options"
    Width="360"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- View Options of the tool palettes: how the tools are listed, the size of the icons, and for which palettes. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="View Options" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                        IsDefault="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,12">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Icon size" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Slider
                            Width="190"
                            Minimum="16"
                            Maximum="96"
                            SmallChange="4"
                            LargeChange="16"
                            TickFrequency="4"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Icon size"
                            Value="{Binding IconSize, Mode=TwoWay}"
                        />
                        <TextBlock
                            Text="{Binding IconSizeText}"
                            Width="52"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GhTextMuted}"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="View style" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Style"
                            Content="Icon only"
                            IsChecked="{Binding IsIconOnly, Mode=TwoWay}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Style"
                            Content="Icon with text"
                            IsChecked="{Binding IsIconWithText, Mode=TwoWay}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Style"
                            Content="List view"
                            IsChecked="{Binding IsList, Mode=TwoWay}"
                            Margin="0"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Apply to">
                    <StackPanel>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Apply"
                            Content="Current palette"
                            IsChecked="True"
                        />
                        <RadioButton
                            x:Name="AllPalettes"
                            Style="{StaticResource BlockRadio}"
                            GroupName="Apply"
                            Content="All palettes"
                            Margin="0"
                        />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
