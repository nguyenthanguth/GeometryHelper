<Window
    x:Class="GeometryHelper.Cad.Wpf.LoadSecurityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Security - Unsigned Executable File"
    Width="616"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The link of the footnote: blue, underlined, lighter under the mouse; a button, so that Tab reaches it. -->
            <Style x:Key="FootnoteLink" TargetType="Button">
                <Setter Property="Foreground" Value="#6CB6FF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock
                                Text="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                TextDecorations="Underline"
                            />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#9CCBFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Foreground" Value="#9CCBFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The label of a row: muted, 76 wide. -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="Width" Value="76" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- A button of the band: 103 wide at least, 26 high. -->
            <Style x:Key="AnswerButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="MinWidth" Value="103" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DefaultAnswerButton" TargetType="Button" BasedOn="{StaticResource StylePrimaryButton}">
                <Setter Property="MinWidth" Value="103" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <StackPanel>
            <!-- The title band, as the other tasks dialogs of AutoCAD have it; its cross is Do Not Load. -->
            <Border
                Background="{StaticResource GhHeader}"
                Height="38"
                Padding="16,0,8,0"
                CornerRadius="5,5,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        VerticalAlignment="Center"
                        Click="OnDoNotLoad"
                        ToolTip="Close, same as Do Not Load"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <DockPanel Margin="16,12,16,8">
                <Path
                    DockPanel.Dock="Left"
                    Data="M12 3 2 21h20zM12 10v5M12 18h.01"
                    Stroke="{StaticResource GhWarn}"
                    StrokeThickness="1.8"
                    Width="32"
                    Height="32"
                    Stretch="Uniform"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top"
                />
                <StackPanel>
                    <TextBlock
                        Text="{Binding Instruction}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GhAccent}"
                        TextWrapping="Wrap"
                    />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Key}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Text="{Binding Advice}"
                        Foreground="{StaticResource GhIcon}"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"
                    />
                </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource GhHeader}" Padding="16,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="AlwaysButton"
                        Style="{StaticResource AnswerButton}"
                        Content="{Binding AlwaysLoadText}"
                        Click="OnAlwaysLoad"
                    />
                    <Button
                        x:Name="OnceButton"
                        Style="{StaticResource AnswerButton}"
                        Content="{Binding LoadOnceText}"
                        Click="OnLoadOnce"
                    />
                    <Button
                        x:Name="NotButton"
                        Style="{StaticResource DefaultAnswerButton}"
                        Content="{Binding DoNotLoadText}"
                        Click="OnDoNotLoad"
                        IsDefault="True"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <!-- The footnote: the link to the guide; it neither closes the window nor answers. -->
            <Border
                Background="{StaticResource GhHeader}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,5,16,6"
                CornerRadius="0,0,5,5"
            >
                <Button
                    x:Name="HelpButton"
                    Style="{StaticResource FootnoteLink}"
                    Content="{Binding FootnoteLink}"
                    HorizontalAlignment="Left"
                    Click="OnHelp"
                />
            </Border>
        </StackPanel>
    </Border>
</Window>
