<Window
    x:Class="GeometryHelper.Cad.Wpf.CreateCellStyleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Create New Cell Style"
    Width="380"
    Height="250"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Create New Cell Style"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource StyleGroup}" Text="New cell style name:" />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,12"
                />
                <TextBlock Style="{StaticResource StyleGroup}" Text="Start with:" />
                <ComboBox
                    Style="{StaticResource GhComboBox}"
                    ItemsSource="{Binding StartChoices}"
                    SelectedItem="{Binding StartWith, Mode=TwoWay}"
                    Margin="0,0,0,10"
                />
                <TextBlock Text="{Binding Message}" Foreground="#E5A04B" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
