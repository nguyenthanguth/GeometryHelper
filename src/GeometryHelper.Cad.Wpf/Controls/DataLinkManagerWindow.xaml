<Window
    x:Class="GeometryHelper.Cad.Wpf.DataLinkManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Data Link Manager"
    Width="680"
    Height="500"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LinkRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design DataLinkManager: Data Link Manager / Select a Data Link: the links, what each links, New, Edit, Rename, Delete, Update. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            Command="{Binding OkCommand}"
                            IsDefault="True"
                            Visibility="{Binding IsPicking, Converter={StaticResource Shown}}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="{Binding CloseText}"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Create a new Excel Data Link…"
                        Command="{Binding CreateCommand}"
                        ToolTip="Create a new data link to an Excel workbook or a comma delimited file"
                    />
                    <Button Style="{StaticResource SideButton}" Content="Edit…" Command="{Binding EditCommand}" />
                    <Button Style="{StaticResource SideButton}" Content="Rename" Command="{Binding RenameCommand}" />
                    <Button Style="{StaticResource SideButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Update"
                        Command="{Binding UpdateCommand}"
                        ToolTip="Update the tables of the data link from its source"
                    />
                </StackPanel>

                <Border
                    Height="230"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,0,10"
                >
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Data Link Name"
                                Padding="10,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock
                                Grid.Column="1"
                                Text="Type"
                                Padding="10,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock
                                Grid.Column="2"
                                Text="Details"
                                Padding="10,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock
                                Grid.Column="3"
                                Text="Tables"
                                Padding="10,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock
                                Grid.Column="4"
                                Text="Updated"
                                Padding="10,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                        </Grid>
                        <ListBox
                            AutomationProperties.Name="Data links"
                            ItemsSource="{Binding Links}"
                            SelectedItem="{Binding Selected, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource LinkRow}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            MouseDoubleClick="OnDoubleClick"
                        >
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DataLinkRowViewModel}">
                                    <Grid Width="626">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Padding="10,4"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Kind}"
                                            Padding="10,4"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Details}"
                                            Padding="10,4"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Tables}"
                                            Padding="10,4"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding Updated}"
                                            Padding="10,4"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Link details">
                    <TextBlock
                        Height="64"
                        Text="{Binding Details}"
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        AutomationProperties.Name="Link details"
                    />
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
