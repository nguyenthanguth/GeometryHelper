<Window
    x:Class="GeometryHelper.Cad.Wpf.CharacterMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Character Map"
    Width="560"
    Height="500"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A character of the grid: a 28 pixel cell, lit under the mouse and in the selection's blue when picked. -->
            <Style x:Key="CharacterCell" TargetType="ListBoxItem">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Cell"
                                Background="Transparent"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="0,0,1,1"
                            >
                                <TextBlock
                                    Text="{Binding Text}"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource GhHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Cell"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The Symbol menu's Other...: a font and its characters by set, Select to gather them in the Characters to copy box, Copy to put them on the clipboard. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Character Map" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="18,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhTextMuted}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource StyleLabel}" Text="Font:" Margin="0,0,0,4" />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Font"
                        ItemsSource="{Binding Fonts}"
                        SelectedItem="{Binding Font, Mode=TwoWay}"
                    />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StyleLabel}" Text="Character set:" Margin="0,0,0,4" />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Character set"
                        ItemsSource="{Binding CharacterSets}"
                        SelectedItem="{Binding CharacterSet, Mode=TwoWay}"
                    />
                </StackPanel>

                <ListBox
                    x:Name="Grid16"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    Foreground="{StaticResource GhText}"
                    FontFamily="{Binding Font}"
                    ItemContainerStyle="{StaticResource CharacterCell}"
                    ItemsSource="{Binding Cells}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="Characters"
                    MouseDoubleClick="OnCellDoubleClick"
                >
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="16" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <TextBlock
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource StyleLabel}"
                    Text="Characters to copy:"
                    Margin="0,0,0,4"
                />
                <DockPanel Grid.Row="5" Grid.ColumnSpan="3">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Padding="14,5"
                        Margin="6,0,0,0"
                        Content="Copy"
                        Command="{Binding CopyCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Padding="14,5"
                        Margin="6,0,0,0"
                        Content="Select"
                        Command="{Binding SelectCommand}"
                    />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding Info}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        MinWidth="64"
                        Margin="10,0,0,0"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        FontFamily="{Binding Font}"
                        FontSize="14"
                        AutomationProperties.Name="Characters to copy"
                        Text="{Binding CharactersToCopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
