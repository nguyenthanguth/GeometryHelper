<Window
    x:Class="GeometryHelper.Cad.Wpf.InsertTableBlockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Insert a Block in a Table Cell"
    Width="440"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Insert a Block in a Table Cell"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource StyleGroup}" Text="Block" />
                <ComboBox
                    Style="{StaticResource GhComboBox}"
                    ItemsSource="{Binding Blocks}"
                    SelectedItem="{Binding Name, Mode=TwoWay}"
                    Margin="0,0,0,14"
                />

                <TextBlock Style="{StaticResource StyleGroup}" Text="Properties" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StyleLabel}" Text="Scale:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource StyleBox}"
                        Width="90"
                        HorizontalAlignment="Left"
                        Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding ScaleEnabled}"
                    />
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource StyleCheck}"
                        Content="AutoFit"
                        IsChecked="{Binding AutoFit, Mode=TwoWay}"
                    />
                    <TextBlock Grid.Row="4" Style="{StaticResource StyleLabel}" Text="Rotation angle:" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource StyleBox}"
                        Width="90"
                        HorizontalAlignment="Left"
                        Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBlock Grid.Row="6" Style="{StaticResource StyleLabel}" Text="Overall cell alignment:" />
                    <ComboBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding Alignments}"
                        SelectedItem="{Binding Alignment, Mode=TwoWay}"
                    />
                </Grid>
                <TextBlock
                    Text="The block is put in the cell as a block cell. A block with attributes asks them in the cell's own properties."
                    Foreground="{StaticResource GhTextMuted}"
                    FontSize="11"
                    TextWrapping="Wrap"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
