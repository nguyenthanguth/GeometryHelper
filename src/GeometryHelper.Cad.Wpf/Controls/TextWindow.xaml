<Window
    x:Class="GeometryHelper.Cad.Wpf.TextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Text Window"
    Width="720"
    Height="420"
    MinWidth="320"
    MinHeight="160"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
    PreviewKeyDown="OnKey"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- No frame of the system: with WindowStyle None and a resizable window, Windows 10 and 11 draw a light line along the top edge. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"
        />
    </shell:WindowChrome.WindowChrome>

    <!-- The text window: the title, dragged to move it, with Copy and the close button; then the history, newest line last. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close  F2"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Content="Copy"
                        Padding="12,3"
                        Margin="0,0,8,0"
                        Click="OnCopy"
                        ToolTip="Copy the lines chosen, or all of them  Ctrl+C"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ListBox
                x:Name="History"
                Background="{StaticResource GhInput}"
                BorderThickness="0"
                Foreground="{StaticResource GhText}"
                FontFamily="{StaticResource GhMonoFont}"
                ItemContainerStyle="{StaticResource StyleListItem}"
                SelectionMode="Extended"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                AutomationProperties.Name="Command history"
                ItemsSource="{Binding Lines}"
            />
        </DockPanel>
    </Border>
</Window>
