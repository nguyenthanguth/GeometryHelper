<Window
    x:Class="GeometryHelper.Cad.Wpf.CellBordersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Cell Border Properties"
    Width="440"
    Height="470"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title with the cells, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Cell Border Properties - " />
                        <Run Text="{Binding CellName, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Footer: Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource StyleGroup}" Text="Border properties" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource StyleLabel}" Text="Lineweight:" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding LineWeightChoices}"
                        SelectedItem="{Binding LineWeight, Mode=TwoWay}"
                    />
                    <TextBlock Grid.Row="2" Style="{StaticResource StyleLabel}" Text="Linetype:" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding Linetypes}"
                        SelectedItem="{Binding Linetype, Mode=TwoWay}"
                        IsEnabled="False"
                        ToolTip="The linetype, double lines and their spacing are kept in the TABLECONTENT of AutoCAD 2021's tables, which the library does not write for a cell's borders: greyed"
                        ToolTipService.ShowOnDisabled="True"
                    />
                    <TextBlock Grid.Row="4" Style="{StaticResource StyleLabel}" Text="Color:" />
                    <ComboBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding ColorChoices}"
                        SelectedItem="{Binding Color, Mode=TwoWay}"
                    />
                    <CheckBox
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource StyleCheck}"
                        Content="Double line"
                        IsChecked="{Binding DoubleLine, Mode=TwoWay}"
                        IsEnabled="False"
                        ToolTip="The linetype, double lines and their spacing are kept in the TABLECONTENT of AutoCAD 2021's tables, which the library does not write for a cell's borders: greyed"
                        ToolTipService.ShowOnDisabled="True"
                    />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource StyleLabel}" Text="Spacing:" />
                    <TextBox
                        Grid.Row="6"
                        Grid.Column="3"
                        Style="{StaticResource StyleBox}"
                        Text="{Binding Spacing, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="False"
                        ToolTip="The linetype, double lines and their spacing are kept in the TABLECONTENT of AutoCAD 2021's tables, which the library does not write for a cell's borders: greyed"
                        ToolTipService.ShowOnDisabled="True"
                    />
                </Grid>

                <TextBlock Style="{StaticResource StyleGroup}" Text="Border" />
                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="All"
                        IsChecked="{Binding All, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Outside"
                        IsChecked="{Binding Outside, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Inside"
                        IsChecked="{Binding Inside, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Bottom"
                        IsChecked="{Binding Bottom, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Left"
                        IsChecked="{Binding Left, Mode=TwoWay}"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Top"
                        IsChecked="{Binding Top, Mode=TwoWay}"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Right"
                        IsChecked="{Binding Right, Mode=TwoWay}"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="No Border"
                        IsChecked="{Binding NoBorder, Mode=TwoWay}"
                    />
                </UniformGrid>
                <CheckBox
                    Style="{StaticResource StyleCheck}"
                    Content="Visible (the lines chosen are drawn)"
                    IsChecked="{Binding Visible, Mode=TwoWay}"
                    Margin="0,0,0,8"
                />
                <TextBlock
                    Text="The lines chosen are given the lineweight, linetype and colour above in every cell selected. No Border hides every line of the cells."
                    Foreground="{StaticResource GhTextMuted}"
                    FontSize="11"
                    TextWrapping="Wrap"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
