                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Three: Above"
                                                    Tag="{StaticResource GhIconVpThreeAbove}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="-VPORTS 3 Above"
                                                    ToolTip="Three: Above (-VPORTS 3, Above)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Three: Below"
                                                    Tag="{StaticResource GhIconVpThreeBelow}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="-VPORTS 3 Below"
                                                    ToolTip="Three: Below (-VPORTS 3, Below)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Three: Vertical"
                                                    Tag="{StaticResource GhIconVpThreeVertical}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="-VPORTS 3 Vertical"
                                                    ToolTip="Three: Vertical (-VPORTS 3, Vertical)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Three: Horizontal"
                                                    Tag="{StaticResource GhIconVpThreeHorizontal}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="-VPORTS 3 Horizontal"
                                                    ToolTip="Three: Horizontal (-VPORTS 3, Horizontal)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Four: Equal"
                                                    Tag="{StaticResource GhIconVpFourEqual}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="-VPORTS 4"
                                                    ToolTip="Four: Equal (-VPORTS 4)"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconVpNamed}"
                                    Content="Named"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.NamedViewportsCommand}"
                                    CommandParameter="VPORTS Named"
                                    ToolTip="Named (VPORTS, Named Viewports): the saved configurations"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconVpJoin}"
                                    Content="Join"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="-VPORTS Join"
                                    ToolTip="Join (-VPORTS, Join): two viewports made one"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconVpRestore}"
                                    Content="Restore"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="-VPORTS Restore"
                                    ToolTip="Restore (-VPORTS, Restore): a saved configuration brought back"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Palettes" Icon="{StaticResource GhIconToolPalette}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconToolPalette}"
                                Content="Tool Palettes"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="TOOLPALETTES"
                                ToolTip="Tool Palettes (TOOLPALETTES): the palettes of tools to draw, hatch and insert blocks with"
                            />
                            <ToggleButton
                                Style="{StaticResource BigToggle}"
                                Tag="{StaticResource GhIconPropertiesPalette}"
                                Content="Properties"
                                IsEnabled="{Binding Model.HasDocument}"
                                IsChecked="{Binding Model.IsPropertiesPanelShown, Mode=TwoWay}"
                                ToolTip="Properties (PROPERTIES, PROPERTIESCLOSE): lit while the Properties panel is shown"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <ToggleButton
                                    Style="{StaticResource TileToggle}"
                                    Tag="{StaticResource GhIconCommandLine}"
                                    Content="Command Line"
                                    IsChecked="{Binding Model.IsCommandLineShown, Mode=TwoWay}"
                                    ToolTip="Command Line (COMMANDLINE, COMMANDLINEHIDE): lit while the command line is shown"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconLayers}"
                                    Content="Layer Properties"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="LAYER"
                                    ToolTip="Layer Properties (LAYER)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDesignCenter}"
                                    Content="Design Center"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="ADCENTER"
                                    ToolTip="Design Center (ADCENTER)"
                                />
                                <Border Width="24" Height="22" Margin="0,0,0,2" />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconQuickCalc}"
                                    Content="Quick Calculator"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="QUICKCALC"
                                    ToolTip="Quick Calculator (QUICKCALC)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconExternalReferences}"
                                    Content="External References"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="EXTERNALREFERENCES"
                                    ToolTip="External References (EXTERNALREFERENCES)"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <!-- A floor (D1317): the title and its launcher need 79, as the board draws it, where the one toggle is 60. -->
                    <local:RibbonPanel
                        Title="Interface"
                        MinFullWidth="79"
                        Icon="{StaticResource GhIconPanelLeft}"
                        Launcher="{Binding Model.AppearanceSettingsCommand}"
                        LauncherToolTip="Global settings: Appearance"
                    >
                        <ToggleButton
                            Style="{StaticResource BigToggle}"
                            Tag="{StaticResource GhIconPanelLeft}"
                            Content="Drawings"
                            IsChecked="{Binding Model.IsFileListShown, Mode=TwoWay}"
                            Margin="0"
                            ToolTip="Drawings: the list of open drawings, shown or hidden"
                        />
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Navigate" Icon="{StaticResource GhIconExtents}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconExtents}"
                                Content="Extents"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding RunCommand}"
                                CommandParameter="ZOOM E"
                                ToolTip="ZOOM Extents"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconZoomWindow}"
                                    Content="Window"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="ZOOM W"
                                    ToolTip="ZOOM Window"
                                />
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconZoomPrevious}"
                                    Content="Previous"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="ZOOM P"
                                    ToolTip="ZOOM Previous"
                                />
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconPan}"
                                    Content="Pan"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="PAN"
                                    ToolTip="PAN"
                                />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconZoomIn}"
                                    Content="Zoom In"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="ZOOM 2X"
                                    ToolTip="ZOOM 2X"
                                />
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconZoomOut}"
                                    Content="Zoom Out"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="ZOOM 0.5X"
                                    ToolTip="ZOOM 0.5X"
                                />
                                <Button
                                    Style="{StaticResource NarrowSmallButton}"
                                    Tag="{StaticResource GhIconRefresh}"
                                    Content="Regen"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="REGEN"
                                    ToolTip="REGEN"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Views" Icon="{StaticResource GhIconModel}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconModel}"
                                Content="Model"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding ModelSpaceCommand}"
                                ToolTip="Show model space"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconLayout}"
                                Content="Layout"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding LayoutCommand}"
                                Margin="0"
                                ToolTip="Show the first layout"
                            />
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Drafting" Icon="{StaticResource GhIconGrid}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <ToggleButton
                                Style="{StaticResource SmallToggle}"
                                Tag="{StaticResource GhIconGrid}"
                                Content="Grid"
                                IsChecked="{Binding Grid.IsOn, Mode=TwoWay}"
                                ToolTip="GRID (F7)"
                            />
                            <ToggleButton
                                Style="{StaticResource SmallToggle}"
                                Tag="{StaticResource GhIconSnap}"
                                Content="Snap"
                                IsChecked="{Binding Snap.IsOn, Mode=TwoWay}"
                                ToolTip="SNAP (F9)"
                            />
                            <ToggleButton
                                Style="{StaticResource SmallToggle}"
                                Tag="{StaticResource GhIconOrtho}"
                                Content="Ortho"
                                IsChecked="{Binding Ortho.IsOn, Mode=TwoWay}"
                                ToolTip="ORTHO (F8)"
                            />
                            <ToggleButton
                                Style="{StaticResource SmallToggle}"
                                Tag="{StaticResource GhIconPolar}"
                                Content="Polar"
                                IsChecked="{Binding Polar.IsOn, Mode=TwoWay}"
                                ToolTip="POLAR (F10)"
                            />
                            <ToggleButton
                                Style="{StaticResource SmallToggle}"
                                Tag="{StaticResource GhIconOsnap}"
                                Content="Osnap"
                                IsChecked="{Binding Osnap.IsOn, Mode=TwoWay}"
                                ToolTip="OSNAP (F3)"
                            />
                        </WrapPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            Parametric, as AutoCAD 2021's: Geometric (Auto Constrain; the twelve constraints as three rows of four tiles; a separator;
            Show/Hide, Show All and Hide All of the constraint bars; the launcher opens Constraint Settings on its Geometric tab), Dimensional
            (Linear, a split of Linear, Horizontal and Vertical; Aligned; Radius, Diameter, Angular and Convert as tiles; Show/Hide, Show All
            and Hide All of the dynamic constraints; the slide-out holds the two constraint modes; the launcher opens Constraint Settings on its
            Dimensional tab) and Manage (Delete Constraints, Parameters Manager). About 630 wide, so no panel shrinks: the strip has no steps.
            -->
            <DataTemplate DataType="{x:Type local:ParametricRibbonViewModel}">
                <local:RibbonStrip>
                    <local:RibbonStrip.Resources>
                        <!--
                        The line between the tiles of a panel and the buttons with text after them: 1 wide, 68 high.
                        -->
                        <Style x:Key="BodySeparator" TargetType="Border">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Height" Value="68" />
                            <Setter Property="Margin" Value="3,2,3,0" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Background" Value="{StaticResource GhBorder}" />
                        </Style>
                    </local:RibbonStrip.Resources>
                    <local:RibbonPanel
                        Title="Geometric"
                        Icon="{StaticResource GhIconAutoConstrain}"
                        Launcher="{Binding SettingsCommand}"
                        LauncherToolTip="Constraint Settings, Geometric (CONSTRAINTSETTINGS)"
                    >
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconAutoConstrain}"
                                Content="Auto Constrain"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="AUTOCONSTRAIN"
                                ToolTip="Auto Constrain (AUTOCONSTRAIN): applies the constraints the selected objects nearly meet, within the tolerances of Constraint Settings"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcCoincident}"
                                    Content="Coincident"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCCOINCIDENT"
                                    ToolTip="Coincident (GCCOINCIDENT): two points on one place, or a point on an object"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcParallel}"
                                    Content="Parallel"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCPARALLEL"
                                    ToolTip="Parallel (GCPARALLEL): lines with one direction"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcTangent}"
                                    Content="Tangent"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCTANGENT"
                                    ToolTip="Tangent (GCTANGENT): a line and a circle, or two circles, touching"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcCollinear}"
                                    Content="Collinear"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCCOLLINEAR"
                                    ToolTip="Collinear (GCCOLLINEAR): lines on one line"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcPerpendicular}"
                                    Content="Perpendicular"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCPERPENDICULAR"
                                    ToolTip="Perpendicular (GCPERPENDICULAR): lines at a right angle"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcSmooth}"
                                    Content="Smooth"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCSMOOTH"
                                    ToolTip="Smooth (GCSMOOTH): a spline joined smoothly to a line; the presenter does not solve splines yet"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcConcentric}"
                                    Content="Concentric"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCCONCENTRIC"
                                    ToolTip="Concentric (GCCONCENTRIC): circles or arcs about one centre"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcHorizontal}"
                                    Content="Horizontal"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCHORIZONTAL"
                                    ToolTip="Horizontal (GCHORIZONTAL): a line, or two points, level with the x axis"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcSymmetric}"
                                    Content="Symmetric"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCSYMMETRIC"
                                    ToolTip="Symmetric (GCSYMMETRIC): two points or objects mirror images about a line"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcFix}"
                                    Content="Fix"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCFIX"
                                    ToolTip="Fix (GCFIX): points held where they are"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcVertical}"
                                    Content="Vertical"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCVERTICAL"
                                    ToolTip="Vertical (GCVERTICAL): a line, or two points, level with the y axis"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconGcEqual}"
                                    Content="Equal"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="GCEQUAL"
                                    ToolTip="Equal (GCEQUAL): lines of one length, circles or arcs of one radius"
                                />
                            </WrapPanel>
                            <Border Style="{StaticResource BodySeparator}" />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconBarToggle}"
                                    Content="Show/Hide"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="CONSTRAINTBAR"
                                    ToolTip="Show/Hide (CONSTRAINTBAR): the bars of the objects selected shown, hidden or put back"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconBarShowAll}"
                                    Content="Show All"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding ShowAllCommand}"
                                    ToolTip="Show All (CONSTRAINTBAR, Showall): the constraint bars of every constrained object"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconBarHideAll}"
                                    Content="Hide All"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding HideAllCommand}"
                                    ToolTip="Hide All (CONSTRAINTBAR, Hideall): the constraint bars of every constrained object"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel
                        Title="Dimensional"
                        Icon="{StaticResource GhIconDcLinear}"
                        Launcher="{Binding DimensionalSettingsCommand}"
                        LauncherToolTip="Constraint Settings, Dimensional (CONSTRAINTSETTINGS)"
                    >
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Dimensional ▾"
                                ToolTip="More of Dimensional: Dynamic Constraint Mode and Annotational Constraint Mode, the form new dimensional constraints take (CCONSTRAINTFORM)"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel>
                                <ToggleButton
                                    Style="{StaticResource SmallToggle}"
                                    Tag="{StaticResource GhIconDcModeDynamic}"
                                    Content="Dynamic Constraint Mode"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    IsChecked="{Binding IsDynamicMode, Mode=TwoWay}"
                                    ToolTip="Dynamic Constraint Mode (CCONSTRAINTFORM 0): new dimensional constraints are dynamic, shown only while their objects are selected"
                                />
                                <ToggleButton
                                    Style="{StaticResource SmallToggle}"
                                    Tag="{StaticResource GhIconDcModeAnnotational}"
                                    Content="Annotational Constraint Mode"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    IsChecked="{Binding IsAnnotationalMode, Mode=TwoWay}"
                                    ToolTip="Annotational Constraint Mode (CCONSTRAINTFORM 1): new dimensional constraints are annotational, always shown"
                                />
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconDcLinear}"
                                        Content="Linear"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DCLINEAR"
                                        ToolTip="Linear (DCLINEAR): a horizontal or vertical distance between two points, named d1, d2 ..."
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        ContentTemplate="{StaticResource BigSplitLabel}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Linear: Linear, Horizontal, Vertical"
                                    >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Linear"
                                                    Tag="{StaticResource GhIconDcLinear}"
                                                    Click="OnSplitChoice"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="DCLINEAR"
                                                    ToolTip="Linear (DCLINEAR): a horizontal or vertical distance between two points, named d1, d2 ..."
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Horizontal"
                                                    Tag="{StaticResource GhIconDcHorizontal}"
                                                    Click="OnSplitChoice"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="DCHORIZONTAL"
                                                    ToolTip="Horizontal (DCHORIZONTAL): the distance between two points along the x axis"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Vertical"
                                                    Tag="{StaticResource GhIconDcVertical}"
                                                    Click="OnSplitChoice"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="DCVERTICAL"
                                                    ToolTip="Vertical (DCVERTICAL): the distance between two points along the y axis"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconDcAligned}"
                                Content="Aligned"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="DCALIGNED"
                                ToolTip="Aligned (DCALIGNED): the distance between two points"
                            />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDcRadius}"
                                        Content="Radius"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DCRADIUS"
                                        ToolTip="Radius (DCRADIUS): the radius of a circle or arc, named rad1 ..."
                                    />
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDcAngular}"
                                        Content="Angular"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DCANGULAR"
                                        ToolTip="Angular (DCANGULAR): the angle from one line to another, named ang1 ..."
                                    />
                                </StackPanel>
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDcDiameter}"
                                        Content="Diameter"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DCDIAMETER"
                                        ToolTip="Diameter (DCDIAMETER): the diameter of a circle or arc, named dia1 ..."
                                    />
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDcConvert}"
                                        Content="Convert"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DCCONVERT"
                                        ToolTip="Convert (DCCONVERT): associative dimensions made dimensional constraints"
                                    />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource BodySeparator}" />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconDcShow}"
                                    Content="Show/Hide"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="DCDISPLAY"
                                    ToolTip="Show/Hide (DCDISPLAY): the dynamic dimensional constraints of the objects selected shown or hidden"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconBarShowAll}"
                                    Content="Show All"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding DisplayAllCommand}"
                                    CommandParameter="DCDISPLAY Showall"
                                    ToolTip="Show All (DCDISPLAY, Showall): the dynamic dimensional constraints of every object shown"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconBarHideAll}"
                                    Content="Hide All"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding DisplayAllCommand}"
                                    CommandParameter="DCDISPLAY Hideall"
                                    ToolTip="Hide All (DCDISPLAY, Hideall): the dynamic dimensional constraints of every object hidden"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Manage" Icon="{StaticResource GhIconParameters}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconDelConstraint}"
                                Content="Delete Constraints"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="DELCONSTRAINT"
                                ToolTip="Delete Constraints (DELCONSTRAINT): every constraint of the objects selected"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconParameters}"
                                Content="Parameters Manager"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="PARAMETERS"
                                Margin="0"
                                ToolTip="Parameters Manager (PARAMETERS): the named values the dimensional constraints use"
                            />
                        </StackPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            Manage, as AutoCAD 2021's for what the presenter has: Customization (User Interface and Tool Palettes, Edit Aliases), Applications
            (Load Application, Run Script), CAD Standards (Layer Translator; Check and Configure greyed with a tooltip saying they are not built
            yet) and Cleanup (Purge, Find Non-Purgeable Items, Overkill, Audit, Recover). About 660 wide, so no panel shrinks: the strip has no steps.
            -->
            <DataTemplate DataType="{x:Type local:ManageRibbonViewModel}">
                <local:RibbonStrip>
                    <local:RibbonStrip.Resources>
                        <!--
                        A big button whose label may be as wide as Find Non-Purgeable (about 100 pixels), so that the label is two lines and no word is
                        broken: the label of BigButton is 66 at most.
                        -->
                        <Style x:Key="WideLabelButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel>
                                            <local:IconView
                                                Size="28"
                                                StrokeThickness="1.5"
                                                Margin="0,2,0,2"
                                                HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                            />
                                            <TextBlock
                                                Text="{Binding}"
                                                HorizontalAlignment="Center"
                                                MaxWidth="110"
                                                TextWrapping="Wrap"
                                                TextAlignment="Center"
                                            />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </local:RibbonStrip.Resources>
                    <local:RibbonPanel Title="Customization" Icon="{StaticResource GhIconUserInterface}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconUserInterface}"
                                Content="User Interface"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="CUI"
                                ToolTip="User Interface (CUI): Global settings, Shortcuts: the keys and the aliases"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconToolPalette}"
                                Content="Tool Palettes"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="TOOLPALETTES"
                                ToolTip="Tool Palettes (TOOLPALETTES): the palettes of tools to draw, hatch and insert blocks with"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconKeyboard}"
                                    Content="Edit Aliases"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="ALIASEDIT"
                                    ToolTip="Edit Aliases (ALIASEDIT): Global settings, Shortcuts"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Applications" Icon="{StaticResource GhIconPluginLoad}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconPluginLoad}"
                                Content="Load Application"
                                IsEnabled="{Binding CanLoadApplication}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="APPLOAD"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Load Application (APPLOAD): load an AutoLISP file or a plugin; the Plugin manager is on the Plugins tab"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconScript}"
                                Content="Run Script"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="SCRIPT"
                                Margin="0"
                                ToolTip="Run Script (SCRIPT): commands read from a .scr file"
                            />
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="CAD Standards" Icon="{StaticResource GhIconStandards}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <Button
                                Style="{StaticResource SmallButton}"
                                Tag="{StaticResource GhIconLayerTranslator}"
                                Content="Layer Translator"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="LAYTRANS"
                                ToolTip="Layer Translator (LAYTRANS): map the layers of the drawing to those of a standards file and translate them"
                            />
                            <Button
                                Style="{StaticResource SmallButton}"
                                Tag="{StaticResource GhIconStandardsCheck}"
                                Content="Check"
                                IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Check (CHECKSTANDARDS): CAD standards are not built yet"
                            />
                            <Button
                                Style="{StaticResource SmallButton}"
                                Tag="{StaticResource GhIconStandardsConfigure}"
                                Content="Configure"
                                IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Configure (STANDARDS): CAD standards are not built yet"
                            />
                        </WrapPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Cleanup" Icon="{StaticResource GhIconPurge}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconPurge}"
                                Content="Purge"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="PURGE"
                                ToolTip="Purge (PURGE): remove unused blocks, layers, styles and other named objects"
                            />
                            <Button
                                Style="{StaticResource WideLabelButton}"
                                Tag="{StaticResource GhIconFindNonPurgeable}"
                                Content="Find Non-Purgeable Items"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding FindNonPurgeableCommand}"
                                ToolTip="Find Non-Purgeable Items (PURGE): the Purge window on the named items in use, and why each cannot be purged"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconOverkill}"
                                    Content="Overkill"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="OVERKILL"
                                    ToolTip="Overkill (OVERKILL): delete duplicate and overlapping objects"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconAudit}"
                                    Content="Audit"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="AUDIT"
                                    ToolTip="Audit (AUDIT): check the drawing and fix errors"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconRefresh}"
                                    Content="Recover"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="RECOVER"
                                    ToolTip="Recover (RECOVER): open a damaged drawing and repair it"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            Output, as AutoCAD 2021's for what the presenter has: Plot (Plot, Batch Plot and Preview; Page Setup Manager and Plot Stamp) and
            Export to DWF/PDF (the Export split of Export PDF, Export DWF and Export). Import is on the Insert tab. About 390 wide, so no panel
            shrinks: the strip has no steps, and no launcher stands on Plot: there is no Plot and Publish page to open.
            -->
            <DataTemplate DataType="{x:Type local:OutputRibbonViewModel}">
                <local:RibbonStrip>
                    <local:RibbonPanel Title="Plot" Icon="{StaticResource GhIconPlot}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconPlot}"
                                Content="Plot"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="PLOT"
                                ToolTip="Plot (PLOT)"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconBatchPlot}"
                                Content="Batch Plot"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="PUBLISH"
                                ToolTip="Batch Plot (PUBLISH): several drawings and layouts at once"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconPlotPreview}"
                                Content="Preview"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="PREVIEW"
                                ToolTip="Preview (PREVIEW)"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconPageSetup}"
                                    Content="Page Setup Manager"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="PAGESETUP"
                                    ToolTip="Page Setup Manager (PAGESETUP)"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconPlotStamp}"
                                    Content="Plot Stamp"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="PLOTSTAMP"
                                    ToolTip="Plot Stamp (PLOTSTAMP)"
                                />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Export to DWF/PDF" Icon="{StaticResource GhIconExportPdf}">
                        <Border Style="{StaticResource BigSplitFrame}">
                            <StackPanel>
                                <Button
                                    Style="{StaticResource BigSplitTop}"
                                    Tag="{StaticResource GhIconExportPdf}"
                                    Content="Export"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="EXPORTPDF"
                                    ToolTip="Export PDF (EXPORTPDF)"
                                />
                                <Button
                                    Style="{StaticResource BigSplitArrow}"
                                    Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                    ContentTemplate="{StaticResource BigSplitLabel}"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Click="OnRibbonMenu"
                                    ToolTip="Export: Export PDF, Export DWF, Export"
                                >
                                    <Button.ContextMenu>
                                        <ContextMenu
                                            Style="{StaticResource GhContextMenu}"
                                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                        >
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Export PDF"
                                                Tag="{StaticResource GhIconExportPdf}"
                                                Click="OnSplitChoice"
                                                AutomationProperties.Name="Export"
                                                Command="{Binding Model.StartCommandCommand}"
                                                CommandParameter="EXPORTPDF"
                                                ToolTip="Export PDF (EXPORTPDF)"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Export DWF"
                                                Tag="{StaticResource GhIconExportDwf}"
                                                Click="OnSplitChoice"
                                                AutomationProperties.Name="Export"
                                                Command="{Binding Model.StartCommandCommand}"
                                                CommandParameter="EXPORTDWF"
                                                ToolTip="Export DWF (EXPORTDWF)"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Export"
                                                Tag="{StaticResource GhIconExport}"
                                                Click="OnSplitChoice"
                                                AutomationProperties.Name="Export"
                                                Command="{Binding Model.StartCommandCommand}"
                                                CommandParameter="EXPORT"
                                                ToolTip="Export (EXPORT)"
                                            />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!-- Recent Documents of the start screen: the headings, a chromeless button to open a file, a row of the list and a large picture. -->
            <Style x:Key="RecentHeading" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,8,0,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Style>

            <Style x:Key="RecentOpen" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RecentPicture" DataType="{x:Type local:RecentDocumentViewModel}">
                <Border Background="Black" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <Image
                            Source="{Binding Thumbnail}"
                            Stretch="Uniform"
                            Margin="1"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Visibility="{Binding HasThumbnail, Converter={StaticResource Shown}}"
                        />
                        <local:IconView
                            Size="20"
                            StrokeThickness="1.6"
                            Stroke="#5B6573"
                            Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasThumbnail, Converter={StaticResource Hidden}}"
                        />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="RecentRow" DataType="{x:Type local:RecentDocumentViewModel}">
                <Border
                    x:Name="Row"
                    BorderBrush="{StaticResource GhHeader}"
                    BorderThickness="0,1,0,0"
                    Padding="4"
                    Background="Transparent"
                >
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource RecentPinButton}"
                            Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            Content="{Binding}"
                            Command="{Binding PinCommand}"
                            ToolTip="{Binding PinText}"
                            AutomationProperties.Name="{Binding PinText}"
                        />
                        <Button
                            Style="{StaticResource RecentOpen}"
                            Command="{Binding OpenCommand}"
                            ToolTip="{StaticResource RecentDocumentToolTip}"
                            AutomationProperties.Name="{Binding Name}"
                        >
                            <DockPanel>
                                <ContentPresenter
                                    Width="56"
                                    Height="40"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource RecentPicture}"
                                />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding OpenedText}"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <TextBlock
                                        Text="{Binding Path}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource GhTextMuted}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHeader}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="RecentTile" DataType="{x:Type local:RecentDocumentViewModel}">
                <Border
                    x:Name="Tile"
                    Width="174"
                    Margin="0,0,8,8"
                    Padding="6"
                    CornerRadius="4"
                    Background="Transparent"
                >
                    <Grid>
                        <Button
                            Style="{StaticResource RecentOpen}"
                            Command="{Binding OpenCommand}"
                            ToolTip="{StaticResource RecentDocumentToolTip}"
                            AutomationProperties.Name="{Binding Name}"
                        >
                            <StackPanel>
                                <ContentPresenter
                                    Height="110"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource RecentPicture}"
                                />
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    Margin="0,6,0,0"
                                    TextTrimming="CharacterEllipsis"
                                />
                                <TextBlock Text="{Binding OpenedText}" Foreground="{StaticResource GhTextMuted}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource RecentPinButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,2,2,0"
                            Content="{Binding}"
                            Command="{Binding PinCommand}"
                            ToolTip="{Binding PinText}"
                            AutomationProperties.Name="{Binding PinText}"
                        />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource GhHeader}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--
            The three state glyphs of a layer in the layer box, as AutoCAD 2021's: on or off, thawed or frozen, unlocked or locked,
            each a small button that toggles that state of that layer through the model's commands (the same edit path as the Layer
            manager's), the list left open. Each button is named for the glyph it shows (BulbOn, BulbOff, Sun, Snowflake, LockOpen,
            LockClosed), which screen readers read and the tests find it by.
            -->
            <Style x:Key="LayerGlyph" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Content" Value="{Binding}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>

            <DataTemplate x:Key="BulbGlyph">
                <local:IconView
                    x:Name="Glyph"
                    Size="16"
                    StrokeThickness="2"
                    Stroke="#F2C744"
                    Fill="#73F2C744"
                    Data="{StaticResource GhGlyphBulbOn}"
                />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="False">
                        <Setter TargetName="Glyph" Property="Data" Value="{StaticResource GhGlyphBulbOff}" />
                        <Setter TargetName="Glyph" Property="Stroke" Value="#6B7480" />
                        <Setter TargetName="Glyph" Property="Fill" Value="{x:Null}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="FreezeGlyph">
                <local:IconView
                    x:Name="Glyph"
                    Size="16"
                    StrokeThickness="2"
                    Stroke="#F0A030"
                    Fill="#73F0A030"
                    Data="{StaticResource GhGlyphSun}"
                />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                        <Setter TargetName="Glyph" Property="Data" Value="{StaticResource GhGlyphSnowflake}" />
                        <Setter TargetName="Glyph" Property="Stroke" Value="#7CC4F2" />
                        <Setter TargetName="Glyph" Property="Fill" Value="{x:Null}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="LockGlyph">
                <local:IconView
                    x:Name="Glyph"
                    Size="16"
                    StrokeThickness="2"
                    Stroke="#D9B451"
                    Data="{StaticResource GhGlyphLockOpen}"
                />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter TargetName="Glyph" Property="Data" Value="{StaticResource GhGlyphLockClosed}" />
                        <Setter TargetName="Glyph" Property="Fill" Value="#73D9B451" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="BulbGlyphButton" TargetType="Button" BasedOn="{StaticResource LayerGlyph}">
                <Setter Property="ContentTemplate" Value="{StaticResource BulbGlyph}" />
                <Setter Property="AutomationProperties.Name" Value="BulbOn" />
                <Setter Property="ToolTip" Value="Turn a layer On or Off" />
                <Setter
                    Property="Command"
                    Value="{Binding DataContext.ToggleLayerOnCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="False">
                        <Setter Property="AutomationProperties.Name" Value="BulbOff" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FreezeGlyphButton" TargetType="Button" BasedOn="{StaticResource LayerGlyph}">
                <Setter Property="ContentTemplate" Value="{StaticResource FreezeGlyph}" />
                <Setter Property="AutomationProperties.Name" Value="Sun" />
                <Setter Property="ToolTip" Value="Freeze or thaw in ALL viewports" />
                <Setter
                    Property="Command"
                    Value="{Binding DataContext.ToggleLayerFreezeCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                        <Setter Property="AutomationProperties.Name" Value="Snowflake" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LockGlyphButton" TargetType="Button" BasedOn="{StaticResource LayerGlyph}">
                <Setter Property="ContentTemplate" Value="{StaticResource LockGlyph}" />
                <Setter Property="AutomationProperties.Name" Value="LockOpen" />
                <Setter Property="ToolTip" Value="Lock or Unlock a layer" />
                <Setter
                    Property="Command"
                    Value="{Binding DataContext.ToggleLayerLockCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="AutomationProperties.Name" Value="LockClosed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A layer of the box: the row of the current layer in the open list is drawn selected, as the design board has it (D1312). -->
            <DataTemplate x:Key="LayerItem">
                <Border x:Name="Row" Padding="6,3" Margin="-6,-3">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BulbGlyphButton}" />
                        <Button Style="{StaticResource FreezeGlyphButton}" />
                        <Button Style="{StaticResource LockGlyphButton}" Margin="0,0,4,0" />
                        <Border
                            Width="10"
                            Height="10"
                            BorderBrush="{StaticResource GhBorder}"
                            BorderThickness="1"
                            Margin="0,0,6,0"
                            Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger
                        Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                        Value="True"
                    >
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A layer state of the Layer State box: its icon in front of the name in the closed box (D1312), the open list's rows plain. -->
            <DataTemplate x:Key="LayerStateItem">
                <StackPanel Orientation="Horizontal">
                    <local:IconView
                        x:Name="StateIcon"
                        Size="16"
                        StrokeThickness="1.8"
                        Margin="0,0,5,0"
                        Visibility="Collapsed"
                        Data="{StaticResource GhIconLayerState}"
                    />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger
                        Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBoxItem}}"
                        Value="{x:Null}"
                    >
                        <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar: the mark, quick access, the app and its file, the command search. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The G button: the application menu dropped under it (design AppMenu). -->
                <Button
                    x:Name="AppMenuButton"
                    Width="22"
                    Height="22"
                    Click="OnAppMenuButton"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Application menu"
                    AutomationProperties.Name="Application menu"
                    Focusable="False"
                >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Mark" CornerRadius="4" Background="{StaticResource GhAccent}">
                                <TextBlock
                                    Text="G"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    Foreground="{StaticResource GhAccentInk}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Mark" Property="Background" Value="#6CB6FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Popup
                    x:Name="AppMenuPopup"
                    PlacementTarget="{Binding ElementName=AppMenuButton}"
                    Placement="Bottom"
                    VerticalOffset="2"
                    HorizontalOffset="-4"
                    StaysOpen="False"
                    AllowsTransparency="True"
                    Focusable="False"
                    Closed="OnAppMenuClosed"
                >
                    <local:AppMenuView x:Name="AppMenu" Margin="0,0,8,8">
                        <local:AppMenuView.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.6" Color="Black" />
                        </local:AppMenuView.Effect>
                    </local:AppMenuView>
                </Popup>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        Command="{Binding NewCommand}"
                        ToolTip="New: an empty drawing (NEW)"
                        Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconNew}" />
                    </Button>
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        Command="{Binding OpenCommand}"
                        ToolTip="Open (Ctrl+O)"
                        Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconOpen}" />
                    </Button>
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        IsEnabled="{Binding HasDocument}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save (Ctrl+S)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Margin="0,0,10,0"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconSave}" />
                    </Button>
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        IsEnabled="{Binding HasDocument}"
                        Command="{Binding SaveAsCommand}"
                        ToolTip="Save As (SAVEAS, Ctrl+Shift+S)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Margin="0,0,10,0"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconSaveAs}" />
                    </Button>
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        IsEnabled="{Binding HasDocument}"
                        Command="{Binding UndoCommand}"
                        ToolTip="Undo (Ctrl+Z)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Margin="0,0,10,0"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconUndo}" />
                    </Button>
                    <Button
                        Style="{StaticResource GhFlatButton}"
                        IsEnabled="{Binding HasDocument}"
                        Command="{Binding RedoCommand}"
                        ToolTip="Redo (Ctrl+Y)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                        <local:IconView Size="16" Data="{StaticResource GhIconRedo}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="14,0"
                TextTrimming="CharacterEllipsis"
            >
                <Run
                    Text="{Binding AppName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=local:CadWorkspace}}"
                    Foreground="{StaticResource GhTextMuted}"
                /><Run Text="    " /><Run Text="{Binding Title, Mode=OneWay}" />
            </TextBlock>
            <Border
                Grid.Column="2"
                Width="220"
                Background="{StaticResource GhInput}"
                CornerRadius="4"
                Padding="8,3"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
            >
                <DockPanel>
                    <local:IconView
                        Size="13"
                        StrokeThickness="2"
                        Stroke="{StaticResource GhTextMuted}"
                        Data="{StaticResource GhIconSearch}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                    />
                    <TextBox
                        x:Name="TitleSearchBox"
                        Style="{StaticResource GhTextBox}"
                        Tag="Type a keyword or phrase"
                        AutomationProperties.Name="Search commands"
                        ToolTip="Search the commands by name or description; Enter starts the first one"
                        Text="{Binding TitleSearchText, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnTitleSearchKey"
                        LostKeyboardFocus="OnTitleSearchLostFocus"
                    />
                    <!-- The commands the search found, under the box; a row runs its command and empties the box. -->
                    <Popup
                        IsOpen="{Binding IsTitleSearching, Mode=OneWay}"
                        PlacementTarget="{Binding ElementName=TitleSearchBox}"
                        Placement="Bottom"
                        StaysOpen="True"
                        Focusable="False"
                        AllowsTransparency="True"
                    >
                        <Border
                            Width="360"
                            Background="{StaticResource GhHeader}"
                            BorderBrush="{StaticResource GhBorder}"
                            BorderThickness="1"
                            Padding="0,4"
                        >
                            <StackPanel>
                                <TextBlock
                                    Margin="12,4"
                                    Foreground="{StaticResource GhTextMuted}"
                                    Text="No command has these words in its name or description, or no drawing is open."
                                    TextWrapping="Wrap"
                                >
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TitleSearchResults.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="420">
                                    <ItemsControl ItemsSource="{Binding TitleSearchResults}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:CommandSuggestionViewModel}">
                                                <Button
                                                    Style="{StaticResource GhFlatButton}"
                                                    Focusable="False"
                                                    Padding="12,4"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="OnTitleResultClick"
                                                    AutomationProperties.Name="{Binding Name}"
                                                >
                                                    <DockPanel>
                                                        <TextBlock
                                                            DockPanel.Dock="Right"
                                                            Text="{Binding Note}"
                                                            Foreground="{StaticResource GhTextMuted}"
                                                            FontSize="11"
                                                            FontWeight="Medium"
                                                        />
                                                        <TextBlock FontFamily="{StaticResource GhMonoFont}">
                                                            <Run Text="{Binding Before, Mode=OneWay}" /><Run
                                                                Text="{Binding Hit, Mode=OneWay}"
                                                                Foreground="#6CB6FF"
                                                                FontWeight="Bold"
                                                            /><Run Text="{Binding After, Mode=OneWay}" /><Run
                                                                Text="{Binding Synonym, Mode=OneWay}"
                                                                Foreground="{StaticResource GhTextMuted}"
                                                            />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </DockPanel>
            </Border>
            <ContentPresenter
                Grid.Column="3"
                Content="{Binding TitleBarContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
            />
        </Grid>

        <!-- Ribbon: the tabs, then the panels of Home; Ctrl+3 and RIBBONCLOSE hide it, RIBBON shows it. -->
        <Border
            Grid.Row="1"
            Visibility="{Binding IsRibbonShown, Converter={StaticResource Shown}}"
            Background="{StaticResource GhPanel}"
            BorderBrush="{StaticResource GhBorder}"
            BorderThickness="0,1"
        >
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,4,12,0">
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Home"
                        IsChecked="{Binding IsHomeTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        Margin="0,0,4,0"
                    />
                    <!-- The tabs extensions add after Home, as a tab for one kind of document, in the light accent of a contextual tab. -->
                    <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CadWorkspaceExtension}">
                                <ToggleButton
                                    x:Name="Tab"
                                    Style="{StaticResource GhRibbonTab}"
                                    Content="{Binding TabHeader}"
                                    Foreground="#6CB6FF"
                                    IsChecked="{Binding IsTabSelected, Mode=OneWay}"
                                    Margin="0,0,4,0"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsTabVisible, Converter={StaticResource Shown}}"
                                />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                        <Setter
                                            TargetName="Tab"
                                            Property="Foreground"
                                            Value="{StaticResource GhText}"
                                        />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Insert"
                        IsChecked="{Binding InsertTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding InsertTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Annotate"
                        IsChecked="{Binding AnnotateTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding AnnotateTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Parametric"
                        IsChecked="{Binding ParametricTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding ParametricTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="View"
                        IsChecked="{Binding ViewTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding ViewTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Manage"
                        IsChecked="{Binding ManageTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding ManageTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Output"
                        IsChecked="{Binding OutputTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding OutputTab}"
                        Margin="0,0,4,0"
                    />
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
                        Content="Plugins"
                        IsChecked="{Binding PluginsTab.IsTabSelected, Mode=OneWay}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding PluginsTab}"
                        Margin="0,0,4,0"
                    />
                    <!-- The tabs plugins add (CadPluginHost.AddRibbonTab), in the colours of the other tabs. -->
                    <ContentControl Content="{Binding PluginTabs}" Focusable="False">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CadWorkspaceExtension}">
                                            <ToggleButton
                                                Style="{StaticResource GhRibbonTab}"
                                                Content="{Binding TabHeader}"
                                                IsChecked="{Binding IsTabSelected, Mode=OneWay}"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=local:CadWorkspace}}"
                                                CommandParameter="{Binding}"
                                            />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ToggleButton
                        Style="{StaticResource GhRibbonTab}"
