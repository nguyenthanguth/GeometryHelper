<UserControl
    x:Class="GeometryHelper.Cad.Wpf.CadWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    FontFamily="{DynamicResource GhFont}"
    FontSize="12"
    Foreground="{DynamicResource GhText}"
    Background="{DynamicResource GhBg}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/Recent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <local:RgbBrushConverter x:Key="RgbBrush" />
            <local:FontLocalNamesConverter x:Key="FontLocalNames" />

            <!--
            A big button of the ribbon, as AutoCAD 2021's at 100 %: 72 high (a panel's body is 4 + 72 + 4), at least 38 wide, its Tag
            the icon drawn at 28 in a slot of 32, its Content the label under it in at most two lines, broken between words only.
            -->
            <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Padding" Value="3,3" />
                <Setter Property="Margin" Value="0,0,1,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView
                                    Size="28"
                                    StrokeThickness="1.5"
                                    Margin="0,2,0,2"
                                    HorizontalAlignment="Center"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                />
                                <TextBlock
                                    Text="{Binding}"
                                    HorizontalAlignment="Center"
                                    MaxWidth="66"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button of the ribbon: 22 high, a 16 pixel icon, 4, then its label; in a medium panel the icon alone, 24 wide. -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="4,0,5,0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView
                                    Size="16"
                                    StrokeThickness="1.8"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                />
                                <TextBlock Text="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <!-- In a medium panel the label goes, as AutoCAD's: the icon alone, the tooltip still naming the command. -->
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Padding" Value="0" />
                        <Setter
                            Property="AutomationProperties.Name"
                            Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                        />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:IconView
                                        Size="16"
                                        StrokeThickness="1.8"
                                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                    />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
            A tile of the ribbon, as AutoCAD's icon-only small button: 24 by 22 with its 16 pixel icon (the Tag) centred, no text; the
            command's name is the Content, which screen readers read, and the ToolTip. Rows of tiles stand 24 apart.
            -->
            <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="{Binding HasDocument}" />
                <Setter
                    Property="AutomationProperties.Name"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="16"
                                StrokeThickness="1.8"
                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button of a row of tiles that has its text (AutoCAD's Make Current, Match Layer): 22 high, a tile in a medium panel. -->
            <Style x:Key="TileTextButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="{Binding HasDocument}" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Padding" Value="0" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- An icon-only toggle, as a tile: 24 by 22, lit while on, its Content the name its tooltip and screen readers give (Group Selection On/Off). -->
            <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter
                    Property="AutomationProperties.Name"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="16"
                                StrokeThickness="1.8"
                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small toggle of the ribbon, as the drafting toggles of View: lit while on, as the status bar's are. -->
            <Style x:Key="SmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="4,0,5,0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView
                                    Size="16"
                                    StrokeThickness="1.8"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                />
                                <TextBlock Text="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <!-- In a medium panel the icon alone, as View › Drafting's: a toggle on still lit, the tooltip naming it. -->
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Padding" Value="0" />
                        <Setter
                            Property="AutomationProperties.Name"
                            Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                        />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:IconView
                                        Size="16"
                                        StrokeThickness="1.8"
                                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A big toggle of the ribbon, as the panels of View › Interface: the metrics of the big button. -->
            <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Padding" Value="3,3" />
                <Setter Property="Margin" Value="0,0,1,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView
                                    Size="28"
                                    StrokeThickness="1.5"
                                    Margin="0,2,0,2"
                                    HorizontalAlignment="Center"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                />
                                <TextBlock
                                    Text="{Binding}"
                                    HorizontalAlignment="Center"
                                    MaxWidth="66"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The arrow of a split button of the ribbon: a click drops its menu (OnRibbonMenu), as AutoCAD's does. -->
            <Style x:Key="SplitArrow" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="22" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <!-- In a medium panel the small buttons are tiles, and a tile with its arrow is 35 wide (D1315): 24 and 11. -->
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="11" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The arrow of the split of a tile, 11 wide whatever the size of its panel: with its 24 tile 35 (D1315). -->
            <Style x:Key="TileArrow" TargetType="Button" BasedOn="{StaticResource SplitArrow}">
                <Setter Property="Width" Value="11" />
            </Style>

            <!-- A small button of the ribbon shown by its icon alone, a tile of 24 by 22, its Content the name its tooltip and screen readers give. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter
                    Property="AutomationProperties.Name"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="16"
                                StrokeThickness="1.8"
                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button whose icon in a medium panel keeps no margin on its right, so that the icons of a column sit close, as Insert's and View's. -->
            <Style x:Key="NarrowSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A button of the row under a group's columns: a 14 pixel icon and its label. -->
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Margin" Value="0,2,8,0" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView
                                    Size="14"
                                    StrokeThickness="1.8"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                />
                                <TextBlock Text="{Binding}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The column of small buttons of a group, three to a column. -->
            <Style x:Key="SmallColumn" TargetType="WrapPanel">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="GroupBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <!-- The big button of a collapsed panel: the panel's icon, its name and ▾, lit while its drop-down is open. -->
            <Style x:Key="CollapsedPanelButton" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Padding" Value="0,3" />
                <Setter Property="Width" Value="60" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <local:IconView
                                    Size="28"
                                    StrokeThickness="1.5"
                                    HorizontalAlignment="Center"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                />
                                <!-- A title of two words wider than the button, as Block Definition, on two lines. The label is 10 and the button 60 wide, so that a word as long as Dimensions is never broken in two. -->
                                <TextBlock
                                    Text="{Binding}"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    MaxWidth="60"
                                    FontSize="10"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                />
                                <TextBlock
                                    Text="▾"
                                    Foreground="{StaticResource GhTextMuted}"
                                    HorizontalAlignment="Center"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The pin of a drop-down's title bar: pressed, the drop-down stays open. -->
            <Style x:Key="PinToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="13"
                                StrokeThickness="2"
                                Stroke="{StaticResource GhTextMuted}"
                                Data="{StaticResource GhIconPin}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The launcher of a panel (RibbonPanel.Launcher): the small arrow at the right of its title that opens its dialog. -->
            <Style x:Key="PanelLauncher" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="9"
                                StrokeThickness="2.4"
                                Stroke="{StaticResource GhTextMuted}"
                                Data="{StaticResource GhGlyphLauncher}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            A panel of the ribbon (RibbonPanel), as AutoCAD 2021's: 98 high, its body (80, its controls from 4 below the top) over
            its title (18), a line on its right; collapsed, one big button 61 wide with its line; its drop-down under it with the
            title bar, the pin and the launcher.
            -->
            <Style TargetType="local:RibbonPanel">
                <Setter Property="Height" Value="98" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:RibbonPanel">
                            <Grid>
                                <Border
                                    x:Name="Host"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                >
                                    <DockPanel>
                                        <Grid
                                            DockPanel.Dock="Bottom"
                                            Height="18"
                                            Background="{StaticResource GhHeader}"
                                        >
                                            <StackPanel
                                                x:Name="TitleText"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed"
                                            >
                                                <TextBlock
                                                    Style="{StaticResource GroupTitle}"
                                                    Margin="0"
                                                    VerticalAlignment="Center"
                                                    Text="{TemplateBinding Title}"
                                                />
                                            </StackPanel>
                                            <ContentPresenter
                                                x:Name="TitleHeader"
                                                Content="{TemplateBinding Header}"
                                                HorizontalAlignment="Stretch"
                                            />
                                            <Button
                                                x:Name="InlineLauncher"
                                                Style="{StaticResource PanelLauncher}"
                                                HorizontalAlignment="Right"
                                                Content="{TemplateBinding Title}"
                                                Command="{TemplateBinding Launcher}"
                                                ToolTip="{TemplateBinding LauncherToolTip}"
                                                AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} settings}"
                                            />
                                        </Grid>
                                        <Decorator x:Name="PART_Inline" Margin="0,4,0,0" />
                                    </DockPanel>
                                </Border>
                                <Border
                                    x:Name="CollapsedHost"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="0"
                                    Visibility="Collapsed"
                                >
                                    <ToggleButton
                                        Style="{StaticResource CollapsedPanelButton}"
                                        Content="{TemplateBinding Title}"
                                        Tag="{TemplateBinding Icon}"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        AutomationProperties.Name="{TemplateBinding Title}"
                                        ToolTip="{TemplateBinding Title}"
                                    />
                                </Border>
                                <Popup
                                    x:Name="PART_Popup"
                                    Placement="Custom"
                                    AllowsTransparency="True"
                                    StaysOpen="True"
                                    Focusable="False"
                                    PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                >
                                    <Border
                                        Background="{StaticResource GhPanel}"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,4,4"
                                        Margin="0,0,8,8"
                                    >
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="16"
                                                ShadowDepth="6"
                                                Direction="270"
                                                Opacity="0.5"
                                                Color="Black"
                                            />
                                        </Border.Effect>
                                        <DockPanel>
                                            <Border
                                                DockPanel.Dock="Bottom"
                                                Background="{StaticResource GhSelected}"
                                                Height="18"
                                                Padding="4,0"
                                            >
                                                <DockPanel>
                                                    <ToggleButton
                                                        DockPanel.Dock="Left"
                                                        Style="{StaticResource PinToggle}"
                                                        ToolTip="Pin the panel open"
                                                        IsChecked="{Binding IsPinned, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                    />
                                                    <Border DockPanel.Dock="Right" Width="12">
                                                        <Button
                                                            x:Name="DroppedLauncher"
                                                            Style="{StaticResource PanelLauncher}"
                                                            HorizontalAlignment="Right"
                                                            Content="{TemplateBinding Title}"
                                                            Command="{TemplateBinding Launcher}"
                                                            ToolTip="{TemplateBinding LauncherToolTip}"
                                                            AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} settings}"
                                                        />
                                                    </Border>
                                                    <TextBlock
                                                        Style="{StaticResource GroupTitle}"
                                                        Margin="0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} ▴}"
                                                        Foreground="{StaticResource GhText}"
                                                    />
                                                </DockPanel>
                                            </Border>
                                            <Decorator x:Name="PART_Dropped" Margin="4,4,4,2" />
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Header" Value="{x:Null}">
                                    <Setter TargetName="TitleText" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TitleHeader" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Size" Value="Collapsed">
                                    <Setter TargetName="Host" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CollapsedHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="Launcher" Value="{x:Null}">
                                    <Setter TargetName="InlineLauncher" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="DroppedLauncher" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The top of a big split button: the icon of the command picked last, which it runs. -->
            <Style x:Key="BigSplitTop" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="35" />
                <Setter Property="Padding" Value="3,3,3,0" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter
                    Property="AutomationProperties.Name"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}}"
                />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView
                                Size="28"
                                StrokeThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"
                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                            />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The bottom of a big split button: the name of the command picked last and ▾, which drops the others (OnRibbonMenu). -->
            <Style x:Key="BigSplitArrow" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="Height" Value="37" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!-- The content of a big split's arrow, its Content the label: the label, then ▾ on a line of its own. -->
            <DataTemplate x:Key="BigSplitLabel">
                <StackPanel>
                    <TextBlock
                        Text="{Binding}"
                        HorizontalAlignment="Center"
                        MaxWidth="66"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                    />
                    <TextBlock Text="▾" Foreground="{StaticResource GhTextMuted}" HorizontalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- A line of the gallery under its tiles: the name, the command it starts on the right. -->
            <Style x:Key="GalleryLine" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock Text="{Binding}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A combo of the Properties panel: 22 high, 180 wide after its 20-wide icon, 160 in a medium panel. -->
            <Style x:Key="PropertyCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                <Setter Property="Width" Value="180" />
                <Setter Property="Height" Value="22" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="160" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A big split button: its top and its arrow in one frame. -->
            <Style x:Key="BigSplitFrame" TargetType="Border">
                <Setter Property="Height" Value="72" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Margin" Value="0,0,1,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- A box of the ribbon that shows a value: ByLayer, with or without a swatch. -->
            <Style x:Key="ValueBox" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter
                    Property="ToolTip"
                    Value="Not built yet: the lineweight of new objects; set an object's in Properties"
                />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
            An item of a panel's slide-out (design RibbonPgpButtons): the icon in Tag, the words as Content, the command it runs
            on the right as typed.
            -->
            <Style x:Key="SlideOutItem" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <DockPanel>
                                <local:IconView
                                    DockPanel.Dock="Left"
                                    Size="16"
                                    StrokeThickness="1.8"
                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontWeight="Normal"
                                    Foreground="{StaticResource GhTextMuted}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock Text="{Binding}" Margin="8,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The title of a panel with a slide-out: its name and a down arrow, pressed while the slide-out is open. -->
            <Style x:Key="SlideOutTitle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Height" Value="18" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontSize" Value="11" />
                <Setter
                    Property="IsChecked"
                    Value="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=local:RibbonPanel}, Mode=TwoWay}"
                />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhAccentButton}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
            </Style>

            <!--
            What plugins add to the ribbon (design A2RibbonTab, A2PluginsTab): the tooltip of a button, the icon in its room (a path
            drawn at 26 in a large item's 32, a picture fitted into the room), a standard and a large button, a split button, the
            columns of a panel, its panels and the tab that holds them.
            -->
            <Style x:Key="PluginToolTip" TargetType="ToolTip">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border
                                Background="{StaticResource GhHeader}"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                MaxWidth="300"
                            >
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type local:PluginToolTipInfo}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding Body}"
                                    Foreground="{StaticResource GhIcon}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding HasBody, Converter={StaticResource Shown}}"
                                />
                                <Border
                                    BorderBrush="{StaticResource GhBorder}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0"
                                    Padding="0,6,0,0"
                                >
                                    <StackPanel Orientation="Horizontal">
                                        <local:IconView
                                            Size="12"
                                            StrokeThickness="2"
                                            Stroke="{StaticResource GhTextMuted}"
                                            Data="M9 3v5M15 3v5M6 8h12v4a6 6 0 0 1-12 0zM12 18v3"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock
                                            Text="{Binding Plugin}"
                                            FontSize="11"
                                            Foreground="{StaticResource GhTextMuted}"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The tooltip of a plugin's button of the DRAWINGS header: its text and under it the plugin's name. -->
            <Style x:Key="PluginButtonToolTip" TargetType="ToolTip" BasedOn="{StaticResource PluginToolTip}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type local:CadExtensionButton}">
                            <StackPanel>
                                <TextBlock Text="{Binding ToolTip}" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding PluginName}"
                                    FontSize="11"
                                    Foreground="{StaticResource GhTextMuted}"
                                    Margin="0,4,0,0"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The icon of a plugin's item in its room: the path drawn as the presenter's own icons, or the picture fitted into the room. -->
            <DataTemplate x:Key="PluginIcon">
                <Grid Width="{Binding IconSlot}" Height="{Binding IconSlot}">
                    <local:IconView
                        Size="{Binding PathSize}"
                        StrokeThickness="{Binding PathStroke}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{Binding IconGeometry}"
                    />
                    <Image
                        Source="{Binding IconImage}"
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="{Binding ImageScaling}"
                    />
                </Grid>
            </DataTemplate>

            <!-- A standard item's content: the icon, and the text beside it unless the plugin left it out. -->
            <DataTemplate x:Key="PluginStandardContent">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PluginIcon}" />
                    <TextBlock
                        Text="{Binding Text}"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowText, Converter={StaticResource Shown}}"
                    />
                </StackPanel>
            </DataTemplate>

            <!-- A large item's content: the icon over the text. -->
            <DataTemplate x:Key="PluginLargeContent">
                <StackPanel>
                    <ContentPresenter
                        Content="{Binding}"
                        ContentTemplate="{StaticResource PluginIcon}"
                        HorizontalAlignment="Center"
                    />
                    <TextBlock
                        Text="{Binding Text}"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        MaxWidth="66"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Visibility="{Binding ShowText, Converter={StaticResource Shown}}"
                    />
                </StackPanel>
            </DataTemplate>

            <!-- A row of a split button's list: the icon at 18 and the button's text. -->
            <DataTemplate x:Key="PluginSplitRow">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="18" Height="18" Margin="0,0,8,0">
                        <local:IconView
                            Size="18"
                            StrokeThickness="1.8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding IconGeometry}"
                        />
                        <Image Source="{Binding IconImage}" Stretch="Uniform" />
                    </Grid>
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="PluginSplitItem" TargetType="MenuItem" BasedOn="{StaticResource GhMenuItem}">
                <Setter Property="Command" Value="{Binding RunCommand}" />
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="ToolTip" Value="{Binding ToolTipInfo.Title}" />
            </Style>

            <!-- A standard button: the small button of the ribbon (D1311); with no text a tile, 24 by 22. -->
            <DataTemplate x:Key="PluginStandardButton">
                <Button
                    x:Name="Standard"
                    Style="{StaticResource SmallButton}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource PluginStandardContent}"
                    IsEnabled="{Binding IsEnabled}"
                    Command="{Binding RunCommand}"
                    AutomationProperties.Name="{Binding Text}"
                >
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                    </Button.ToolTip>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ShowText}" Value="False">
                        <Setter TargetName="Standard" Property="Width" Value="24" />
                        <Setter TargetName="Standard" Property="Padding" Value="0" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="PluginLargeButton">
                <Button
                    Style="{StaticResource BigButton}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource PluginLargeContent}"
                    IsEnabled="{Binding IsEnabled}"
                    Command="{Binding RunCommand}"
                    AutomationProperties.Name="{Binding Text}"
                >
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                    </Button.ToolTip>
                </Button>
            </DataTemplate>

            <!-- A standard split button: the top runs the button used last, the arrow drops the list; lit while the list is open. -->
            <DataTemplate x:Key="PluginStandardSplit">
                <Border CornerRadius="2" Margin="0,0,0,2" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GhSelected}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Style="{StaticResource SmallButton}"
                            Margin="0"
                            DataContext="{Binding Top}"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource PluginStandardContent}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding RunCommand}"
                            AutomationProperties.Name="{Binding Text}"
                        >
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Style="{StaticResource SplitArrow}"
                            Margin="0"
                            Content="▾"
                            FontSize="10"
                            Foreground="{StaticResource GhTextMuted}"
                            Click="OnRibbonMenu"
                            AutomationProperties.Name="{Binding Text, StringFormat={}More of {0}}"
                        >
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                            </Button.ToolTip>
                            <Button.ContextMenu>
                                <ContextMenu
                                    Style="{StaticResource GhContextMenu}"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                    ItemsSource="{Binding Buttons}"
                                    ItemContainerStyle="{StaticResource PluginSplitItem}"
                                    ItemTemplate="{StaticResource PluginSplitRow}"
                                    IsOpen="{Binding IsOpen, Mode=OneWayToSource}"
                                />
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- A large split button: the icon of the button used last on top, its name and ▾ under it, in one frame. -->
            <DataTemplate x:Key="PluginLargeSplit">
                <Border Style="{StaticResource BigSplitFrame}">
                    <StackPanel>
                        <Button
                            Style="{StaticResource BigSplitTop}"
                            DataContext="{Binding Top}"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource PluginIcon}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding RunCommand}"
                            AutomationProperties.Name="{Binding Text}"
                        >
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Style="{StaticResource BigSplitArrow}"
                            Content="{Binding Top.Text}"
                            ContentStringFormat="{}{0} ▾"
                            Click="OnRibbonMenu"
                        >
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource PluginToolTip}" Content="{Binding ToolTipInfo}" />
                            </Button.ToolTip>
                            <Button.ContextMenu>
                                <ContextMenu
                                    Style="{StaticResource GhContextMenu}"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                    ItemsSource="{Binding Buttons}"
                                    ItemContainerStyle="{StaticResource PluginSplitItem}"
                                    ItemTemplate="{StaticResource PluginSplitRow}"
                                    IsOpen="{Binding IsOpen, Mode=OneWayToSource}"
                                />
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:PluginButtonViewModel}">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource PluginStandardButton}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PluginLargeButton}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:PluginSplitViewModel}">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource PluginStandardSplit}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PluginLargeSplit}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>

            <!-- A column of a panel: a large item alone, or up to three standard ones one under the other. -->
            <DataTemplate DataType="{x:Type local:PluginColumnViewModel}">
                <ItemsControl
                    ItemsSource="{Binding Items}"
                    Focusable="False"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                />
            </DataTemplate>

            <!-- A panel of a plugin: its columns, its title under them. -->
            <DataTemplate DataType="{x:Type local:PluginPanelViewModel}">
                <Border Style="{StaticResource GroupBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Columns}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- The panels of a ribbon tab a plugin added. -->
            <DataTemplate DataType="{x:Type local:PluginTabViewModel}">
                <ItemsControl ItemsSource="{Binding Panels}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DataTemplate>

            <!-- A button of the DRAWINGS header an extension added: 20 square, its icon at 16. -->
            <DataTemplate x:Key="ExtensionFileListButton">
                <Button
                    Style="{StaticResource GhFlatButton}"
                    Width="20"
                    Height="20"
                    Margin="8,0,0,0"
                    Command="{Binding Command}"
                    ToolTip="{Binding ToolTip}"
                >
                    <local:IconView
                        Size="16"
                        StrokeThickness="2"
                        Stroke="{StaticResource GhTextMuted}"
                        Data="{Binding Icon}"
                    />
                </Button>
            </DataTemplate>

            <!-- A button of the DRAWINGS header a plugin added: the same, its icon a path or a picture, its tooltip with the plugin's name. -->
            <DataTemplate x:Key="PluginFileListButton">
                <Button
                    Style="{StaticResource GhFlatButton}"
                    Width="20"
                    Height="20"
                    Margin="8,0,0,0"
                    Command="{Binding Command}"
                    AutomationProperties.Name="{Binding ToolTip}"
                >
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource PluginButtonToolTip}" Content="{Binding}" />
                    </Button.ToolTip>
                    <Grid Width="16" Height="16">
                        <local:IconView
                            Size="16"
                            StrokeThickness="2"
                            Stroke="{StaticResource GhTextMuted}"
                            Data="{Binding Icon}"
                        />
                        <Image Source="{Binding IconImage}" Stretch="Uniform" />
                    </Grid>
                </Button>
            </DataTemplate>

            <!-- The groups of the Plugins tab: a button per command of each plugin loaded, the panels plugins add, then Manage. -->
            <DataTemplate DataType="{x:Type local:PluginRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource GroupTitle}"
                                Text="Command plugins"
                            />
                            <Grid>
                                <TextBlock
                                    Text="No command plugin is loaded.&#x0a;Load .dll adds one."
                                    Foreground="{StaticResource GhTextMuted}"
                                    Margin="4,8,8,0"
                                    Visibility="{Binding HasCommands, Converter={StaticResource Hidden}}"
                                />
                                <ItemsControl ItemsSource="{Binding Commands}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PluginCommandButton}">
                                            <Button
                                                Style="{StaticResource BigButton}"
                                                Tag="{StaticResource GhIconPluginCommand}"
                                                Content="{Binding Label}"
                                                ToolTip="{Binding ToolTip}"
                                                IsEnabled="True"
                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                            >
                                                <!-- A command's name is one long word: kept on one line, cut with an ellipsis past 96 pixels. -->
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <local:IconView
                                                                Size="26"
                                                                StrokeThickness="1.6"
                                                                HorizontalAlignment="Center"
                                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                            />
                                                            <TextBlock
                                                                Text="{Binding}"
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Center"
                                                                MaxWidth="96"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <!-- The panels plugins add to this tab, between Command plugins and Manage (CadPluginHost.AddRibbonPanel). -->
                    <ItemsControl ItemsSource="{Binding Panels}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Manage" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconPluginLoad}"
                                    Content="Load .dll"
                                    IsEnabled="True"
                                    Command="{Binding LoadCommand}"
                                    ToolTip="Load a plugin (PLUGINLOAD, NETLOAD)"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconRefresh}"
                                    Content="Reload"
                                    IsEnabled="True"
                                    Command="{Binding ReloadCommand}"
                                    ToolTip="Load the plugin again from its file (PLUGINRELOAD)"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconPluginUnload}"
                                    Content="Unload"
                                    IsEnabled="True"
                                    Command="{Binding UnloadCommand}"
                                    ToolTip="Unload the plugin (PLUGINUNLOAD)"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconPluginManager}"
                                    Content="Plugin manager"
                                    IsEnabled="True"
                                    Command="{Binding ManagerCommand}"
                                    Margin="0"
                                    ToolTip="Load, unload and trust plugins"
                                />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The groups of the Settings tab: Global settings, opened on a category. -->
            <DataTemplate DataType="{x:Type local:SettingsRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource GroupTitle}"
                                Text="Global settings"
                            />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconGear}"
                                    Content="Options"
                                    IsEnabled="True"
                                    Command="{Binding OpenCommand}"
                                    ToolTip="Global settings (OPTIONS)"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconPalette}"
                                    Content="Appearance"
                                    IsEnabled="True"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="Appearance"
                                    ToolTip="Global settings › Appearance"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconExtents}"
                                    Content="Canvas"
                                    IsEnabled="True"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="Canvas and cursor"
                                    ToolTip="Global settings › Canvas and cursor"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconKeyboard}"
                                    Content="Shortcuts"
                                    IsEnabled="True"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="Shortcuts"
                                    ToolTip="Global settings › Shortcuts"
                                />
                                <Button
                                    Style="{StaticResource BigButton}"
                                    Tag="{StaticResource GhIconSave}"
                                    Content="Save and export"
                                    IsEnabled="True"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="Save and export"
                                    Margin="0"
                                    ToolTip="Global settings › Save and export"
                                />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The contextual Table Cell tab while cells of a table are selected: its own control (TableCellRibbon). -->
            <DataTemplate DataType="{x:Type local:TableCellViewModel}">
                <local:TableCellRibbon />
            </DataTemplate>

            <!-- The contextual Array tab while one associative array is selected: its own control (ArrayRibbon). -->
            <DataTemplate DataType="{x:Type local:ArrayTabViewModel}">
                <local:ArrayRibbon />
            </DataTemplate>

            <!-- The contextual Hatch Creation tab while HATCH runs and Hatch Editor tab while hatches are selected: one control (HatchRibbon). -->
            <DataTemplate DataType="{x:Type local:HatchTabViewModel}">
                <local:HatchRibbon />
            </DataTemplate>

            <!-- The contextual Image tab while images are selected: its own control (ImageRibbon). -->
            <DataTemplate DataType="{x:Type local:ImageTabViewModel}">
                <local:ImageRibbon />
            </DataTemplate>

            <!-- The contextual PDF Underlay tab while PDF underlays are selected: its own control (PdfRibbon). -->
            <DataTemplate DataType="{x:Type local:PdfTabViewModel}">
                <local:PdfRibbon />
            </DataTemplate>

            <!-- The contextual Block Editor tab while a block is open in the Block Editor (BEDIT): its own control (BlockEditorRibbon). -->
            <DataTemplate DataType="{x:Type local:BlockEditorRibbonViewModel}">
                <local:BlockEditorRibbon />
            </DataTemplate>

            <!--
            A style box: the combo box's look, opened by a click on it (StyleBox), with no button of its own; its list on the
            header's colour, the current style ticked, the dialog's item last under a line. In
            a medium panel the box narrows 118 to 84 and its caption goes, the tooltip still naming what it sets.
            -->
            <Style x:Key="StyleBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border
                                x:Name="Row"
                                Background="Transparent"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="0"
                                Padding="10,4"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDialog}" Value="True">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,4,0,0" />
                                    <Setter TargetName="Row" Property="Padding" Value="10,6,10,4" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="StyleBoxItemTemplate" DataType="{x:Type local:StyleBoxItemViewModel}">
                <DockPanel>
                    <TextBlock
                        x:Name="Tick"
                        DockPanel.Dock="Left"
                        Width="14"
                        Margin="0,0,6,0"
                        Text="✓"
                        Foreground="{StaticResource GhOk}"
                        Visibility="Hidden"
                    />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Text="{Binding Hint}"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                    <TextBlock Text="{Binding Name}" />
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="StyleBoxChosenTemplate">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <Style x:Key="StyleBoxCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                <Setter Property="local:StyleBox.OpensOnClick" Value="True" />
                <Setter Property="Width" Value="118" />
                <Setter Property="SelectedValuePath" Value="Name" />
                <Setter Property="ItemTemplate" Value="{StaticResource StyleBoxItemTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource StyleBoxItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border
                                    Background="{StaticResource GhInput}"
                                    BorderBrush="{StaticResource GhBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="4,2"
                                >
                                    <DockPanel>
                                        <local:IconView
                                            DockPanel.Dock="Right"
                                            Size="10"
                                            StrokeThickness="3"
                                            Stroke="{StaticResource GhTextMuted}"
                                            Data="{StaticResource GhIconChevron}"
                                            VerticalAlignment="Center"
                                        />
                                        <ContentPresenter
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{StaticResource StyleBoxChosenTemplate}"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                        />
                                    </DockPanel>
                                </Border>
                                <Popup
                                    Placement="Bottom"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    StaysOpen="False"
                                >
                                    <Border
                                        Background="{StaticResource GhHeader}"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="0,4"
                                        Margin="0,0,8,8"
                                        MinWidth="190"
                                        MaxHeight="320"
                                    >
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="16"
                                                ShadowDepth="6"
                                                Direction="270"
                                                Opacity="0.5"
                                                Color="Black"
                                            />
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="84" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StyleBoxLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="36" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- The frame of the text height box of Annotate › Text, as wide as a style box. -->
            <Style x:Key="StyleBoxFrame" TargetType="Border">
                <Setter Property="Width" Value="118" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="4,1" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="84" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
            The contextual Text Editor tab of the MTEXT editor, as the design draws it: Style, Formatting, Paragraph, Insert,
            Spell Check (the underline toggle and Edit Dictionaries), Tools, Options and Close. What is not built is greyed with its reason. To fit
            1 600 pixels Spell Check and Tools collapse and Insert becomes a small column; narrower, Options goes small and
            Paragraph collapses. Style, Formatting and Close never shrink, and Close stays the last panel.
            -->
            <DataTemplate DataType="{x:Type local:TextEditorViewModel}">
                <local:RibbonStrip Steps="Spell Check:Collapsed; Tools:Collapsed; Insert:Medium; Options:Medium; Paragraph:Collapsed">
                    <local:RibbonStrip.Resources>
                        <Geometry x:Key="IconStyle">M5 20 12 4l7 16M8 14h8</Geometry>
                        <Geometry x:Key="IconHeight">M4 6V4h10v2M9 4v16M18 6v12M16 8l2-2 2 2M16 16l2 2 2-2</Geometry>
                        <Geometry x:Key="IconMatch">M5 3h10v6H5zM9 9v4M9 13h8v8H9z</Geometry>
                        <Geometry x:Key="IconJustify">M4 4h16v16H4zM7 7h2v2H7z</Geometry>
                        <Geometry x:Key="IconBullets">M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01</Geometry>
                        <Geometry x:Key="IconSpacing">
                            M10 6h10M10 12h10M10 18h10M5 4v16M3 6l2-2 2 2M3 18l2 2 2-2
                        </Geometry>
                        <Geometry x:Key="IconColumns">M4 4h7v16H4zM13 4h7v16h-7z</Geometry>
                        <Geometry x:Key="IconSymbol">
                            M16 12a4 4 0 1 0-1.2 2.9M16 8v5a2 2 0 0 0 4 0v-1a8 8 0 1 0-3 6.2
                        </Geometry>
                        <Geometry x:Key="IconField">M4 6h16v12H4zM8 10h3M8 14h8M14 10h2</Geometry>
                        <Geometry x:Key="IconSpell">M4 17l4-10 4 10M5.5 13h5M14 14l3 3 5-6</Geometry>
                        <Geometry x:Key="IconDictionary">
                            M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11
                        </Geometry>
                        <Geometry x:Key="IconFind">
                            M10 10m-6 0a6 6 0 1 0 12 0a6 6 0 1 0-12 0M14.5 14.5 20 20M7 10h6
                        </Geometry>
                        <Geometry x:Key="IconImport">M12 3v12M7 10l5 5 5-5M4 21h16</Geometry>
                        <Geometry x:Key="IconCaps">M4 18 8 6l4 12M5.5 14h5M14 18l3-12 3 12M15 14h4</Geometry>
                        <Geometry x:Key="IconMore">M5 12h.01M12 12h.01M19 12h.01</Geometry>
                        <Geometry x:Key="IconRuler">M3 8h18v8H3zM7 8v3M11 8v4M15 8v3M19 8v4</Geometry>
                        <Geometry x:Key="IconCloseEditor">M6 6l12 12M18 6 6 18</Geometry>
                        <Geometry x:Key="AlignLeft">M4 6h16M4 10h10M4 14h16M4 18h10</Geometry>
                        <Geometry x:Key="AlignCentre">M4 6h16M7 10h10M4 14h16M7 18h10</Geometry>
                        <Geometry x:Key="AlignRight">M4 6h16M10 10h10M4 14h16M10 18h10</Geometry>
                        <Geometry x:Key="AlignJustify">M4 6h16M4 10h16M4 14h16M4 18h16</Geometry>
                        <Geometry x:Key="AlignDistribute">M4 6h16M4 10h16M4 14h16M4 18h2M11 18h2M18 18h2</Geometry>
                        <!-- B, I, S, U, O: a small framed square, the accent when on. -->
                        <Style x:Key="FormatToggle" TargetType="ToggleButton">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="Chrome"
                                            Background="{StaticResource GhInput}"
                                            BorderBrush="{StaticResource GhBorder}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                        >
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter
                                                    TargetName="Chrome"
                                                    Property="Background"
                                                    Value="{StaticResource GhSelected}"
                                                />
                                                <Setter
                                                    TargetName="Chrome"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource GhAccent}"
                                                />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- An alignment: its icon, on the selection's ground when it is the paragraph's. -->
                        <Style x:Key="AlignToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <local:IconView
                                            Size="14"
                                            StrokeThickness="1.8"
                                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                        />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="EditorBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Margin" Value="3,0,6,0" />
                            <Setter Property="local:CommitOnEnter.Enabled" Value="True" />
                            <EventSetter Event="local:CommitOnEnter.Finished" Handler="OnEditorBoxFinished" />
                        </Style>
                        <!-- The tab is wide: its big buttons and groups are drawn a little closer than Home's, as the design draws them. -->
                        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="Padding" Value="3,4" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                        </Style>
                        <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource BigToggle}">
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="Padding" Value="3,4" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                        </Style>
                        <!-- A big button that a medium panel draws small, its label kept: Insert's and Options' as the design shrinks them. -->
                        <Style x:Key="AdaptiveButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,0,8,2" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:IconView
                                                        Size="16"
                                                        StrokeThickness="1.8"
                                                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                    />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="AdaptiveToggle" TargetType="ToggleButton" BasedOn="{StaticResource BigToggle}">
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,0,8,2" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:IconView
                                                        Size="16"
                                                        StrokeThickness="1.8"
                                                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                    />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="EditorMenuButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="{StaticResource GhInput}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </local:RibbonStrip.Resources>

                    <!-- Style: the style, Annotative (live for an MTEXT being made), the height, Mask (Background Mask). -->
                    <local:RibbonPanel Title="Style" MinFullWidth="200" Icon="{StaticResource IconStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource IconStyle}"
                                Content="{Binding StyleName}"
                                IsEnabled="True"
                                Focusable="False"
                                ToolTip="The text style of the MTEXT: STYLE changes it"
                            />
                            <StackPanel>
                                <ToggleButton
                                    Style="{StaticResource SmallToggle}"
                                    Tag="{StaticResource IconStyle}"
                                    Content="Annotative"
                                    Focusable="False"
                                    IsChecked="{Binding IsAnnotative, Mode=OneWay}"
                                    Command="{Binding AnnotativeCommand}"
                                    ToolTip="{Binding AnnotativeToolTip}"
                                    ToolTipService.ShowOnDisabled="True"
                                />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                    <local:IconView
                                        Size="14"
                                        StrokeThickness="1.8"
                                        Data="{StaticResource IconHeight}"
                                    />
                                    <TextBox
                                        Style="{StaticResource EditorBox}"
                                        Width="64"
                                        Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="Text height"
                                    />
                                </StackPanel>
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource IconField}"
                                    Content="Mask"
                                    Command="{Binding MaskCommand}"
                                    ToolTip="Background Mask: a filled box behind the words"
                                />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Formatting: B I S U O, Match (greyed), case, clear, oblique, tracking, width; the font and the colour. -->
                    <local:RibbonPanel Title="Formatting" MinFullWidth="440" Icon="{StaticResource IconMatch}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ToggleButton
                                        Style="{StaticResource FormatToggle}"
                                        Content="B"
                                        FontWeight="Bold"
                                        IsChecked="{Binding IsBold, Mode=OneWay}"
                                        IsEnabled="{Binding CanBold}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="Bold"
                                        ToolTip="Bold  Ctrl+B"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource FormatToggle}"
                                        Content="I"
                                        FontStyle="Italic"
                                        IsChecked="{Binding IsItalic, Mode=OneWay}"
                                        IsEnabled="{Binding CanBold}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="Italic"
                                        ToolTip="Italic  Ctrl+I"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource FormatToggle}"
                                        IsChecked="{Binding IsStrikethrough, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="Strikethrough"
                                        ToolTip="Strikethrough"
                                    >
                                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                                    </ToggleButton>
                                    <ToggleButton
                                        Style="{StaticResource FormatToggle}"
                                        IsChecked="{Binding IsUnderline, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="Underline"
                                        ToolTip="Underline  Ctrl+U"
                                    >
                                        <TextBlock Text="U" TextDecorations="Underline" />
                                    </ToggleButton>
                                    <ToggleButton
                                        Style="{StaticResource FormatToggle}"
                                        IsChecked="{Binding IsOverline, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="Overline"
                                        ToolTip="Overline"
                                    >
                                        <TextBlock Text="O" TextDecorations="OverLine" />
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ToggleButton
                                        Style="{StaticResource SmallToggle}"
                                        Tag="{StaticResource IconMatch}"
                                        Content="Match"
                                        Margin="0,0,6,0"
                                        Focusable="False"
                                        IsChecked="{Binding IsMatching, Mode=OneWay}"
                                        Command="{Binding MatchCommand}"
                                        ToolTip="Match Text Formatting: take the look of the letters selected, then select the letters to give it to"
                                    />
                                    <Button
                                        Style="{StaticResource EditorMenuButton}"
                                        Content="aA ▾"
                                        FontWeight="SemiBold"
                                        Tag="Case"
                                        Click="OnEditorMenu"
                                        ToolTip="Change Case"
                                    />
                                    <Button
                                        Style="{StaticResource EditorMenuButton}"
                                        Content="Clear ▾"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Tag="Clear"
                                        Click="OnEditorMenu"
                                        ToolTip="Remove Character Formatting"
                                    />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="Oblique"
                                        Foreground="{StaticResource GhTextMuted}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        Style="{StaticResource EditorBox}"
                                        Text="{Binding ObliqueText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="Oblique angle"
                                    />
                                    <TextBlock
                                        Text="Tracking"
                                        Foreground="{StaticResource GhTextMuted}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        Style="{StaticResource EditorBox}"
                                        Text="{Binding TrackingText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="Tracking"
                                    />
                                    <TextBlock
                                        Text="Width"
                                        Foreground="{StaticResource GhTextMuted}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        Style="{StaticResource EditorBox}"
                                        Text="{Binding WidthFactorText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="Width factor"
                                    />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Width="128" Margin="4,0,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <Border
                                        DockPanel.Dock="Left"
                                        Background="#1F4E79"
                                        CornerRadius="3"
                                        Padding="4,0"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsShxFont, Converter={StaticResource Shown}}"
                                    >
                                        <TextBlock Text="SHX" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <ComboBox
                                        Style="{StaticResource GhComboBox}"
                                        ItemsSource="{Binding Fonts}"
                                        SelectedItem="{Binding Font, Mode=TwoWay}"
                                        Focusable="False"
                                        ToolTip="Font"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        FontSize="11"
                                    >
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Converter={StaticResource FontLocalNames}, ConverterParameter=all}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Converter={StaticResource FontLocalNames}}"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource GhTextMuted}"
                                                        TextTrimming="CharacterEllipsis"
                                                    />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <ComboBox
                                    Style="{StaticResource GhComboBox}"
                                    ItemsSource="{Binding Colors}"
                                    SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                    Focusable="False"
                                    ToolTip="Color"
                                    Margin="0,0,0,4"
                                >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TextEditorChoice}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="10"
                                                    Height="10"
                                                    BorderBrush="#5B6573"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                                                />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Style="{StaticResource EditorMenuButton}"
                                    Content="Background mask…"
                                    Margin="0"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding MaskCommand}"
                                    ToolTip="Background Mask: a filled box behind the words"
                                />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!--
                    Paragraph: justification and line spacing menus, bullets greyed, the five alignments; the launcher at the
                    right of the title opens the Paragraph dialog.
                    -->
                    <local:RibbonPanel
                        Title="Paragraph"
                        MinFullWidth="250"
                        MinCollapsedWidth="80"
                        Icon="{StaticResource IconJustify}"
                        Launcher="{Binding ParagraphCommand}"
                        LauncherToolTip="Paragraph: tab stops, indents, alignment, paragraph spacing and line spacing."
                    >
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource IconJustify}"
                                Content="Justification ▾"
                                IsEnabled="True"
                                Focusable="False"
                                Click="OnEditorMenu"
                                CommandParameter="Justification"
                                ToolTip="Justification of the MTEXT: TL to BR"
                            />
                            <StackPanel>
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource IconBullets}"
                                    Content="Bullets and Numbering ▾"
                                    IsEnabled="True"
                                    Focusable="False"
                                    Click="OnEditorMenu"
                                    CommandParameter="Bullets"
                                    ToolTip="Numbers, letters or bullets for the selected paragraphs"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource IconSpacing}"
                                    Content="Line Spacing ▾"
                                    IsEnabled="True"
                                    Focusable="False"
                                    Click="OnEditorMenu"
                                    CommandParameter="LineSpacing"
                                    ToolTip="Line spacing of the selected paragraphs; More… opens the Paragraph dialog"
                                />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton
                                        Style="{StaticResource AlignToggle}"
                                        Tag="{StaticResource AlignLeft}"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="l"
                                        ToolTip="Left"
                                        IsChecked="{Binding IsAlignedLeft, Mode=OneWay}"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource AlignToggle}"
                                        Tag="{StaticResource AlignCentre}"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="c"
                                        ToolTip="Centre"
                                        IsChecked="{Binding IsAlignedCentre, Mode=OneWay}"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource AlignToggle}"
                                        Tag="{StaticResource AlignRight}"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="r"
                                        ToolTip="Right"
                                        IsChecked="{Binding IsAlignedRight, Mode=OneWay}"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource AlignToggle}"
                                        Tag="{StaticResource AlignJustify}"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="j"
                                        ToolTip="Justify"
                                        IsChecked="{Binding IsJustified, Mode=OneWay}"
                                    />
                                    <ToggleButton
                                        Style="{StaticResource AlignToggle}"
                                        Tag="{StaticResource AlignDistribute}"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="d"
                                        ToolTip="Distribute"
                                        IsChecked="{Binding IsDistributed, Mode=OneWay}"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Insert: the Columns and Symbol menus, Field greyed; medium, a column of small buttons. -->
                    <local:RibbonPanel
                        Title="Insert"
                        MinFullWidth="222"
                        MinMediumWidth="104"
                        Icon="{StaticResource IconSymbol}"
                    >
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource IconColumns}"
                                Content="Columns ▾"
                                IsEnabled="True"
                                Focusable="False"
                                Click="OnEditorMenu"
                                CommandParameter="Columns"
                                ToolTip="Columns of the MTEXT: none, dynamic, static; column break, Column Settings"
                            />
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource IconSymbol}"
                                Content="Symbol ▾"
                                IsEnabled="True"
                                Focusable="False"
                                Click="OnEditorMenu"
                                CommandParameter="Symbol"
                                ToolTip="Insert a symbol"
                            />
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource IconField}"
                                Content="Field"
                                Focusable="False"
                                Command="{Binding FieldCommand}"
                                ToolTip="Insert Field (Ctrl+F): the date, a property of an object, a document property or a system variable that updates"
                            />
                        </WrapPanel>
                    </local:RibbonPanel>

                    <!-- Spell Check: the toggle of the red underline under words not in the dictionary, and Edit Dictionaries; it collapses first. -->
                    <local:RibbonPanel
                        Title="Spell Check"
                        MinFullWidth="132"
                        MinCollapsedWidth="76"
                        Icon="{StaticResource IconSpell}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton
                                Style="{StaticResource BigToggle}"
                                Tag="{StaticResource IconSpell}"
                                Content="Spell Check"
                                Focusable="False"
                                IsChecked="{Binding IsSpellCheckOn, Mode=TwoWay}"
                                ToolTip="Underline the words not in the dictionary in red; right-click one for the words nearest it, Add Word and Ignore All"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource IconDictionary}"
                                Content="Edit Dictionaries"
                                Margin="0"
                                Command="{Binding EditDictionariesCommand}"
                                Focusable="False"
                                ToolTip="The custom dictionary: add words and delete them"
                            />
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Tools: Find and Replace (its own dialog, Ctrl+H), Import Text from a .txt or .rtf file, and AutoCAPS. -->
                    <local:RibbonPanel
                        Title="Tools"
                        MinFullWidth="216"
                        MinCollapsedWidth="60"
                        Icon="{StaticResource IconFind}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource IconFind}"
                                Content="Find &amp; Replace"
                                Command="{Binding FindReplaceCommand}"
                                Focusable="False"
                                ToolTip="Find and replace in the words  Ctrl+H"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource IconImport}"
                                Content="Import Text"
                                Command="{Binding ImportTextCommand}"
                                Focusable="False"
                                ToolTip="Put the words of a .txt or .rtf file in at the caret (32 KB at most)"
                            />
                            <ToggleButton
                                Style="{StaticResource BigToggle}"
                                Tag="{StaticResource IconCaps}"
                                Content="AutoCAPS"
                                Margin="0"
                                Focusable="False"
                                IsChecked="{Binding IsAutoCaps, Mode=TwoWay}"
                                ToolTip="Letters typed, pasted or imported go in as capitals; the words already there are not changed"
                            />
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Options: More greyed, the ruler, the editor's undo and redo; medium, small buttons. -->
                    <local:RibbonPanel
                        Title="Options"
                        MinFullWidth="250"
                        MinMediumWidth="150"
                        Icon="{StaticResource IconMore}"
                    >
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource IconMore}"
                                Content="More ▾"
                                ToolTip="Character set, editor settings: not built yet"
                            />
                            <ToggleButton
                                Style="{StaticResource AdaptiveToggle}"
                                Tag="{StaticResource IconRuler}"
                                Content="Ruler"
                                IsChecked="{Binding IsRulerShown, Mode=TwoWay}"
                                Focusable="False"
                                ToolTip="Show or hide the ruler"
                            />
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource GhIconUndo}"
                                Content="Undo"
                                IsEnabled="{Binding CanUndo}"
                                Command="{Binding UndoCommand}"
                                Focusable="False"
                                ToolTip="Undo  Ctrl+Z"
                            />
                            <Button
                                Style="{StaticResource AdaptiveButton}"
                                Tag="{StaticResource GhIconRedo}"
                                Content="Redo"
                                IsEnabled="{Binding CanRedo}"
                                Command="{Binding RedoCommand}"
                                Focusable="False"
                                ToolTip="Redo  Ctrl+Y"
                            />
                        </WrapPanel>
                    </local:RibbonPanel>

                    <!-- Close: the words kept; it never shrinks and stays the last panel. -->
                    <local:RibbonPanel
                        Title="Close"
                        MinFullWidth="84"
                        Icon="{StaticResource IconCloseEditor}"
                        BorderThickness="0"
                    >
                        <Button
                            Style="{StaticResource BigButton}"
                            Content="Close Text Editor"
                            IsEnabled="True"
                            Command="{Binding CloseCommand}"
                            Focusable="False"
                            Margin="0"
                            ToolTip="Close the editor, keeping the words  Ctrl+Enter"
                        >
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <local:IconView
                                            Size="26"
                                            StrokeThickness="1.6"
                                            HorizontalAlignment="Center"
                                            Stroke="#F26B3A"
                                            Data="{StaticResource IconCloseEditor}"
                                        />
                                        <TextBlock
                                            Text="{Binding}"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            MaxWidth="66"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center"
                                        />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
Insert, as AutoCAD 2021's: Block (Insert with its gallery, Edit Attribute), Block Definition (Create Block, Define Attributes,
Manage Attributes, Block Editor), Reference (Attach, Clip, Adjust, Underlay Layers, the frames and the snap of underlays),
Import (Import, Combine Text), Data (Field, Update Fields, OLE Object, Hyperlink) and Linking and Extraction (Data Link,
Download from Source, Upload to Source, Extract Data); Location is left out. Block, Block Definition and Reference carry
"Name ▾" and a slide-out. As the window narrows the panels shrink in AutoCAD's order (RibbonStrip): Linking and Extraction,
Data and Reference go medium, then Import, Data and Linking and Extraction collapse; Block and Block Definition never
shrink. The widths are those of the content: no panel has a floor of its own.
-->
            <DataTemplate DataType="{x:Type local:InsertRibbonViewModel}">
                <local:RibbonStrip Steps="Linking &amp; Extraction:Medium; Data:Medium; Reference:Medium; Import:Collapsed; Data:Collapsed; Linking &amp; Extraction:Collapsed">
                    <local:RibbonStrip.Resources>
                        <!-- The label of a big split whose name stands on two lines, the arrow after the second: "Attribute ▾" under "Edit". -->
                        <DataTemplate x:Key="BigSplitLabelInline">
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="66"
                            >
                                <Run Text="{Binding Mode=OneWay}" /><Run
                                    Text=" ▾"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                            </TextBlock>
                        </DataTemplate>
                    </local:RibbonStrip.Resources>
                    <local:RibbonPanel Title="Block" Icon="{StaticResource GhIconInsertBlock}">
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Block ▾"
                                ToolTip="More of Block: Attribute Display"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Style="{StaticResource SmallButton}"
                                        Tag="{StaticResource GhIconAttDisplay}"
                                        Content="Retain Attribute Display"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandWithOptionCommand}"
                                        CommandParameter="ATTDISP"
                                        ToolTip="Attribute Display (ATTDISP): Normal, On, Off"
                                    />
                                    <Button
                                        Style="{StaticResource SplitArrow}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Attribute Display: Normal, On, Off"
                                    >
                                        <Path
                                            Data="M1 1 4 4 7 1"
                                            Stroke="{StaticResource GhTextMuted}"
                                            StrokeThickness="1.4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                        />
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Normal"
                                                    Tag="{StaticResource GhIconAttDisplay}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Retain Attribute Display"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="ATTDISP Normal"
                                                    ToolTip="Attribute Display, Normal (ATTDISP)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="On"
                                                    Tag="{StaticResource GhIconAttDisplay}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Retain Attribute Display"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="ATTDISP ON"
                                                    ToolTip="Attribute Display, On (ATTDISP)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Off"
                                                    Tag="{StaticResource GhIconAttDisplay}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Retain Attribute Display"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="ATTDISP OFF"
                                                    ToolTip="Attribute Display, Off (ATTDISP)"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="InsertSplit" Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconInsertBlock}"
                                        Content="Insert"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="INSERT"
                                        ToolTip="Insert: the Blocks palette (INSERT)"
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding OpenGalleryCommand}"
                                        AutomationProperties.Name="Insert gallery"
                                        ToolTip="The blocks of the drawing; Recent Blocks, Blocks from Other Drawings"
                                    >
                                        <Button.Content>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Insert" HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        Text="▾"
                                                        Foreground="{StaticResource GhTextMuted}"
                                                        HorizontalAlignment="Center"
                                                    />
                                                </StackPanel>
                                                <!-- The gallery: a tile per block of the drawing, a click inserting it; then the palette's other tabs. -->
                                                <Popup
                                                    IsOpen="{Binding IsGalleryOpen, Mode=TwoWay}"
                                                    StaysOpen="False"
                                                    Placement="Bottom"
                                                    AllowsTransparency="True"
                                                    Focusable="False"
                                                    PlacementTarget="{Binding ElementName=InsertSplit}"
                                                >
                                                    <Border
                                                        Background="{StaticResource GhHeader}"
                                                        BorderBrush="{StaticResource GhBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="0,6,0,4"
                                                        Margin="0,0,8,8"
                                                        Width="320"
                                                    >
                                                        <Border.Effect>
                                                            <DropShadowEffect
                                                                BlurRadius="16"
                                                                ShadowDepth="6"
                                                                Direction="270"
                                                                Opacity="0.5"
                                                                Color="Black"
                                                            />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <TextBlock
                                                                Text="{Binding GalleryTitle}"
                                                                Margin="10,0,10,6"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Foreground="{StaticResource GhTextMuted}"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                            <TextBlock
                                                                Text="No blocks in this drawing"
                                                                Margin="10,4,10,10"
                                                                Foreground="{StaticResource GhTextMuted}"
                                                                Visibility="{Binding HasGallery, Converter={StaticResource Hidden}}"
                                                            />
                                                            <ScrollViewer
                                                                MaxHeight="300"
                                                                VerticalScrollBarVisibility="Auto"
                                                                Margin="10,0,10,8"
                                                                Visibility="{Binding HasGallery, Converter={StaticResource Shown}}"
                                                            >
                                                                <ItemsControl
                                                                    ItemsSource="{Binding Gallery}"
                                                                    Focusable="False"
                                                                >
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="3" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type local:BlockTileViewModel}">
                                                                            <Button
                                                                                Style="{StaticResource GhFlatButton}"
                                                                                Margin="0,0,6,6"
                                                                                Padding="2,4"
                                                                                BorderBrush="{StaticResource GhBorder}"
                                                                                BorderThickness="1"
                                                                                Background="{StaticResource GhInput}"
                                                                                Command="{Binding DataContext.InsertBlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding Name}"
                                                                                AutomationProperties.Name="{Binding Name}"
                                                                                ToolTip="{Binding Name}"
                                                                            >
                                                                                <StackPanel>
                                                                                    <Border
                                                                                        Width="72"
                                                                                        Height="48"
                                                                                        Background="Black"
                                                                                        CornerRadius="2"
                                                                                        HorizontalAlignment="Center"
                                                                                    >
                                                                                        <Image
                                                                                            Source="{Binding Picture}"
                                                                                            Stretch="Uniform"
                                                                                        />
                                                                                    </Border>
                                                                                    <TextBlock
                                                                                        Text="{Binding DisplayName}"
                                                                                        Margin="0,3,0,0"
                                                                                        FontSize="10"
                                                                                        FontWeight="Medium"
                                                                                        HorizontalAlignment="Center"
                                                                                        MaxWidth="80"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                    />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                            <Border
                                                                BorderBrush="{StaticResource GhBorder}"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="0,3,0,0"
                                                            >
                                                                <StackPanel>
                                                                    <Button
                                                                        Style="{StaticResource GalleryLine}"
                                                                        Content="Recent Blocks…"
                                                                        Tag="INSERT"
                                                                        Command="{Binding OpenPaletteCommand}"
                                                                        CommandParameter="Recent"
                                                                        ToolTip="The Blocks palette on its Recent tab (INSERT)"
                                                                    />
                                                                    <Button
                                                                        Style="{StaticResource GalleryLine}"
                                                                        Content="Favorite Blocks…"
                                                                        Tag="not offered"
                                                                        IsEnabled="False"
                                                                        ToolTip="Favorite Blocks: not offered, the palette has no Favorites tab"
                                                                    />
                                                                    <Button
                                                                        Style="{StaticResource GalleryLine}"
                                                                        Content="Blocks from Other Drawings…"
                                                                        Tag="INSERT"
                                                                        Command="{Binding OpenPaletteCommand}"
                                                                        CommandParameter="Other drawing"
                                                                        ToolTip="The Blocks palette on its Other drawing tab (INSERT)"
                                                                    />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconEditAttribute}"
                                        Content="Edit&#10;Attribute"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="EATTEDIT"
                                        ToolTip="Edit Attribute, Single (EATTEDIT)"
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        ContentTemplate="{StaticResource BigSplitLabelInline}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Edit Attribute: Single, Multiple"
                                    >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Single"
                                                    Tag="{StaticResource GhIconEditAttribute}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Edit&#10;Attribute"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="EATTEDIT"
                                                    ToolTip="Edit Attribute, Single (EATTEDIT)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Multiple"
                                                    Tag="{StaticResource GhIconAttEditMultiple}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Edit&#10;Attribute"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="-ATTEDIT"
                                                    ToolTip="Edit Attribute, Multiple (-ATTEDIT)"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Block Definition" Icon="{StaticResource GhIconCreateBlock}">
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Block Definition ▾"
                                ToolTip="More of Block Definition: Set Base Point, Synchronize"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Style="{StaticResource SmallButton}"
                                        Tag="{StaticResource GhIconBasePoint}"
                                        Content="Set Base Point"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="BASE"
                                        ToolTip="Set Base Point (BASE)"
                                    />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Style="{StaticResource SmallButton}"
                                        Tag="{StaticResource GhIconAttSync}"
                                        Content="Synchronize"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="ATTSYNC"
                                        ToolTip="Synchronize (ATTSYNC)"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconCreateBlock}"
                                        Content="Create&#10;Block"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="BLOCK"
                                        ToolTip="Create Block (BLOCK)"
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        ContentTemplate="{StaticResource BigSplitLabelInline}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Create Block, Write Block"
                                    >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Create Block"
                                                    Tag="{StaticResource GhIconCreateBlock}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Create&#10;Block"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="BLOCK"
                                                    ToolTip="Create Block (BLOCK)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Write Block"
                                                    Tag="{StaticResource GhIconWriteBlock}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Create&#10;Block"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="WBLOCK"
                                                    ToolTip="Write Block (WBLOCK)"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconDefineAttributes}"
                                Content="Define&#10;Attributes"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="ATTDEF"
                                ToolTip="Define Attributes (ATTDEF)"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconManageAttributes}"
                                Content="Manage&#10;Attributes"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="BATTMAN"
                                ToolTip="Manage Attributes (BATTMAN)"
                            />
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconBlockEditor}"
                                Content="Block&#10;Editor"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="BEDIT"
                                ToolTip="Block Editor (BEDIT)"
                            />
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel
                        Title="Reference"
                        Icon="{StaticResource GhIconAttach}"
                        Launcher="{Binding ExternalReferencesLauncherCommand}"
                        LauncherToolTip="External References (EXTERNALREFERENCES)"
                    >
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Reference ▾"
                                ToolTip="More of Reference: Edit Reference"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Style="{StaticResource SmallButton}"
                                        Tag="{StaticResource GhIconEditReference}"
                                        Content="Edit Reference"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="REFEDIT"
                                        ToolTip="Edit Reference (REFEDIT)"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconAttach}"
                                        Content="Attach"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="XATTACH"
                                        ToolTip="Attach DXF (XATTACH)"
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        ContentTemplate="{StaticResource BigSplitLabel}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Attach DXF, Image, PDF"
                                    >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Attach DXF"
                                                    Tag="{StaticResource GhIconAttach}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Attach"
                                                    Command="{Binding Model.StartCommandCommand}"
