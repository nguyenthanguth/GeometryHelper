                    <!-- The contextual Text Editor tab, green, while an MTEXT is written or edited. -->
                    <ToggleButton
                        Content="Text Editor"
                        IsChecked="{Binding TextEditorTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding TextEditorTab}"
                        Visibility="{Binding TextEditorTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                x:Name="Chrome"
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Table Cell tab, green as the Text Editor's, while cells of a table are selected. -->
                    <ToggleButton
                        Content="Table Cell"
                        IsChecked="{Binding TableCellTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding TableCellTab}"
                        Visibility="{Binding TableCellTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Array tab, green as the others, while one associative array is selected. -->
                    <ToggleButton
                        Content="Array"
                        IsChecked="{Binding ArrayTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding ArrayTab}"
                        Visibility="{Binding ArrayTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Hatch Creation tab, green as the others, while HATCH runs (HPDLGMODE 2). -->
                    <ToggleButton
                        Content="Hatch Creation"
                        IsChecked="{Binding HatchCreationTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding HatchCreationTab}"
                        Visibility="{Binding HatchCreationTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Hatch Editor tab, green as the others, while hatches are selected. -->
                    <ToggleButton
                        Content="Hatch Editor"
                        IsChecked="{Binding HatchEditorTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding HatchEditorTab}"
                        Visibility="{Binding HatchEditorTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Image tab, green as the others, while images are selected. -->
                    <ToggleButton
                        Content="Image"
                        IsChecked="{Binding ImageTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding ImageTab}"
                        Visibility="{Binding ImageTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual PDF Underlay tab, green as the others, while PDF underlays are selected. -->
                    <ToggleButton
                        Content="PDF Underlay"
                        IsChecked="{Binding PdfTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding PdfTab}"
                        Visibility="{Binding PdfTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Block Editor tab, green as the others, while a block is open in the Block Editor. -->
                    <ToggleButton
                        Content="Block Editor"
                        IsChecked="{Binding BlockEditorTab.IsTabSelected, Mode=OneWay}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="{Binding BlockEditorTab}"
                        Visibility="{Binding BlockEditorTab.IsTabVisible, Converter={StaticResource Shown}}"
                    >
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                Background="#2F8F4E"
                                                CornerRadius="2,2,0,0"
                                                Padding="{TemplateBinding Padding}"
                                            >
                                                <ContentPresenter
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual tabs plugins add (a ShowWhen), green as the built-in ones, shown while their predicate is true. -->
                    <ContentControl Content="{Binding PluginContextTabs}" Focusable="False">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CadWorkspaceExtension}">
                                            <ToggleButton
                                                Content="{Binding TabHeader}"
                                                IsChecked="{Binding IsTabSelected, Mode=OneWay}"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=local:CadWorkspace}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsTabVisible, Converter={StaticResource Shown}}"
                                            >
                                                <ToggleButton.Style>
                                                    <Style
                                                        TargetType="ToggleButton"
                                                        BasedOn="{StaticResource GhRibbonTab}"
                                                    >
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border
                                                                        Background="#2F8F4E"
                                                                        CornerRadius="2,2,0,0"
                                                                        Padding="{TemplateBinding Padding}"
                                                                    >
                                                                        <ContentPresenter
                                                                            TextElement.Foreground="White"
                                                                            TextElement.FontWeight="SemiBold"
                                                                        />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
                <Border Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TextEditorTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TableCellTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ArrayTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HatchCreationTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HatchEditorTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ImageTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PdfTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BlockEditorTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPluginContextTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <ContentPresenter
                            Content="{Binding SelectedTab.TabContent}"
                            Visibility="{Binding IsHomeTabSelected, Converter={StaticResource Hidden}}"
                        />
                        <!--
Home, as AutoCAD 2021's: Draw, Modify, Annotation, Layers, Block, Properties, Groups, Utilities, Clipboard, View (ours). The
panels with a slide-out show "Name ▾" and open it from their title; as the window narrows they shrink in the order of the
steps (RibbonStrip), as AutoCAD's do: Block, Properties, Modify, Annotation and Layers go medium, View, Clipboard, Utilities
and Groups collapse, then Properties, Block, Layers and Annotation; Draw never shrinks and Modify never collapses. The
widths are those of the content: no panel has a floor of its own.
-->
                        <local:RibbonStrip Steps="Block:Medium; Properties:Medium; Modify:Medium; Annotation:Medium; Layers:Medium; View:Collapsed; Clipboard:Collapsed; Utilities:Collapsed; Groups:Collapsed; Properties:Collapsed; Block:Collapsed; Layers:Collapsed; Annotation:Collapsed">
                            <local:RibbonStrip.Style>
                                <Style TargetType="local:RibbonStrip">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeTabSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:RibbonStrip.Style>
                            <!--
                            Floors (D1317, budget 5): Draw, Modify, Utilities and Clipboard are drawn no narrower than AutoCAD's own widths of them (224, 250,
                            97 and 80), where their content is narrower, so that Home is 1 695 wide and its first step (Block medium, 80) still leaves it wider than 1 584, as AutoCAD,
                            which takes two steps there. The other panels take the width of their content.
                            -->
                            <local:RibbonPanel Title="Draw" MinFullWidth="224" Icon="{StaticResource GhIconLine}">
                                <local:RibbonPanel.Header>
                                    <ToggleButton
                                        Style="{StaticResource SlideOutTitle}"
                                        IsEnabled="{Binding HasDocument}"
                                        Content="Draw ▾"
                                        ToolTip="More of Draw: Spline, Construction Line, Ray, Points, Divide, Measure, Region, Wipeout, Donut, Revision Cloud"
                                    />
                                </local:RibbonPanel.Header>
                                <local:RibbonPanel.SlideOut>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconSplineFit}"
