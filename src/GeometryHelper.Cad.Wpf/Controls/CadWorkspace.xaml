                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="INSERTOBJ"
                                    ToolTip="OLE Object (INSERTOBJ)"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconHyperlink}"
                                    Content="Hyperlink"
