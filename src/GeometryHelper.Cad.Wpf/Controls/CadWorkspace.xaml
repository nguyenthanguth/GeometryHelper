                                        Command="{Binding Model.StartCommandWithOptionCommand}"
                                        CommandParameter="{Binding Model.SnapToUnderlaysOption}"
                                        ToolTip="Object snaps on the geometry of PDF underlays (PDFOSNAP): the setting of the drawing"
                                    />
                                    <Button
                                        Style="{StaticResource SplitArrow}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
