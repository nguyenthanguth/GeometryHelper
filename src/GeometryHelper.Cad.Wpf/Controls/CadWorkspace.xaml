                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
The Annotate tab, as AutoCAD 2021's: Text (Multiline Text, Check Spelling, Text Align, Justify, the text style box, the Find
Text box and the text height box; the slide-out Scale and the Text Layer box), Dimensions (Dimension, the style box, Break,
Adjust Space, Jog Line, the dimension layer box, Inspect, Update, Reassociate, Linear, Quick, Continue; the slide-out
Tolerance, Oblique, Text Angle, the three Justifies and Override), Centerlines, Leaders, Tables, Markup and Annotation
Scaling. Text and Dimensions carry "Name ▾"; Text, Dimensions, Leaders and Tables a launcher to their style dialog. As the
window narrows the panels shrink in AutoCAD's order (RibbonStrip): Annotation Scaling goes medium, then Tables, Markup,
Annotation Scaling, Leaders and Dimensions collapse; Text and Centerlines never shrink. The widths are those of the content.
-->
            <DataTemplate DataType="{x:Type local:AnnotateRibbonViewModel}">
                <local:RibbonStrip Steps="Annotation Scaling:Medium; Tables:Collapsed; Markup:Collapsed; Annotation Scaling:Collapsed; Leaders:Collapsed; Dimensions:Collapsed">
                    <local:RibbonStrip.Resources>
                        <!-- A box of the ribbon that takes typed words, as a combo's look: 22 high, the field's colour, a line, the accent while typed in. -->
                        <Style x:Key="RibbonBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="5,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border
                                            x:Name="Frame"
                                            Background="{StaticResource GhInput}"
                                            BorderBrush="{StaticResource GhBorder}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="{TemplateBinding Padding}"
                                        >
                                            <ScrollViewer
                                                x:Name="PART_ContentHost"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Hidden"
                                            />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter
                                                    TargetName="Frame"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource GhAccent}"
                                                />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- The label of a big split whose name stands on two lines, the arrow after the second: "Text ▾" under "Multiline". -->
                        <DataTemplate x:Key="BigSplitLabelInline">
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="66"
                            >
                                <Run Text="{Binding Mode=OneWay}" /><Run
                                    Text=" ▾"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                            </TextBlock>
                        </DataTemplate>
                    </local:RibbonStrip.Resources>
                    <local:RibbonPanel
                        Title="Text"
                        Icon="{StaticResource GhIconMText}"
                        Launcher="{Binding TextLauncherCommand}"
                        LauncherToolTip="Text Style... (STYLE)"
                    >
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Text ▾"
                                ToolTip="More of Text: Scale, Text Layer"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Style="{StaticResource SmallButton}"
                                        Tag="{StaticResource GhIconScaleText}"
                                        Content="Scale"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="SCALETEXT"
                                        ToolTip="Scale (SCALETEXT)"
                                    />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="22" VerticalAlignment="Top">
                                        <local:IconView
                                            Size="16"
                                            StrokeThickness="1.8"
                                            Data="{StaticResource GhIconLayers}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                        />
                                    </Border>
                                    <ComboBox
                                        Style="{StaticResource PropertyCombo}"
                                        Width="180"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        ItemsSource="{Binding Model.TextLayerOptions}"
                                        SelectedItem="{Binding Model.CurrentTextLayer, Mode=TwoWay}"
                                        AutomationProperties.Name="Text Layer"
                                        ToolTip="Text Layer: the layer new text goes on (TEXTLAYER)"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button
                                        Style="{StaticResource BigSplitTop}"
                                        Tag="{StaticResource GhIconMText}"
                                        Content="Multiline&#10;Text"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="MTEXT"
                                        ToolTip="Multiline Text (MTEXT)"
                                    />
                                    <Button
                                        Style="{StaticResource BigSplitArrow}"
                                        Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        ContentTemplate="{StaticResource BigSplitLabelInline}"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Click="OnRibbonMenu"
                                        ToolTip="Multiline Text, Single Line"
                                    >
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Style="{StaticResource GhContextMenu}"
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Multiline Text"
                                                    Tag="{StaticResource GhIconMText}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Multiline&#10;Text"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="MTEXT"
                                                    ToolTip="Multiline Text (MTEXT)"
                                                />
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Single Line"
                                                    Tag="{StaticResource GhIconText}"
                                                    Click="OnSplitChoice"
                                                    AutomationProperties.Name="Multiline&#10;Text"
                                                    Command="{Binding Model.StartCommandCommand}"
                                                    CommandParameter="TEXT"
                                                    ToolTip="Single Line Text (TEXT)"
                                                />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconCheckSpelling}"
                                    Content="Check Spelling"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="SPELL"
                                    ToolTip="Check Spelling (SPELL)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconTextAlign}"
                                    Content="Text Align"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="TEXTALIGN"
                                    ToolTip="Text Align (TEXTALIGN)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconJustify}"
                                    Content="Justify"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="JUSTIFYTEXT"
                                    ToolTip="Justify (JUSTIFYTEXT)"
                                />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="22" VerticalAlignment="Top">
                                        <local:IconView
                                            Size="16"
                                            StrokeThickness="1.8"
                                            Data="{StaticResource GhIconTextStyle}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                        />
                                    </Border>
                                    <ComboBox
                                        Style="{StaticResource StyleBoxCombo}"
                                        Width="180"
                                        Height="22"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        ItemsSource="{Binding Model.TextStyleItems}"
                                        SelectedValue="{Binding Model.CurrentTextStyle, Mode=TwoWay}"
                                        AutomationProperties.Name="Text Style"
                                        ToolTip="Text style (STYLE)"
                                    />
                                </StackPanel>
                                <Grid>
                                    <TextBox
                                        Style="{StaticResource RibbonBox}"
                                        Width="200"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Top"
                                        Padding="5,0,22,0"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Text="{Binding Model.FindText, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Find Text"
                                        ToolTip="Find Text: type the words and press Enter (FIND)"
                                    >
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding Model.FindTextCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <local:IconView
                                        Size="12"
                                        StrokeThickness="2"
                                        Data="{StaticResource GhIconSearch}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,5,6,0"
                                        IsHitTestVisible="False"
                                    />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="22" VerticalAlignment="Top">
                                        <local:IconView
                                            Size="16"
                                            StrokeThickness="1.8"
                                            Data="{StaticResource GhIconText}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                        />
                                    </Border>
                                    <TextBox
                                        Style="{StaticResource RibbonBox}"
                                        Width="180"
                                        Margin="0,0,0,2"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        local:CommitOnEnter.Enabled="True"
                                        Text="{Binding Model.TextHeight, UpdateSourceTrigger=LostFocus}"
                                        AutomationProperties.Name="Text Height"
                                        ToolTip="Text height of the next Single Line text (TEXT, MTEXT)"
                                    />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel
                        Title="Dimensions"
                        Icon="{StaticResource GhIconDimSmart}"
                        Launcher="{Binding DimensionsLauncherCommand}"
                        LauncherToolTip="Dimension Style... (DIMSTYLE)"
                    >
                        <local:RibbonPanel.Header>
                            <ToggleButton
                                Style="{StaticResource SlideOutTitle}"
                                IsEnabled="{Binding Model.HasDocument}"
                                Content="Dimensions ▾"
                                ToolTip="More of Dimensions: Tolerance, Oblique, Text Angle, Left, Center and Right Justify, Override"
                            />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconTolerance}"
                                    Content="Tolerance"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="TOLERANCE"
                                    ToolTip="Tolerance (TOLERANCE)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimOblique}"
                                    Content="Oblique"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DIMEDIT O"
                                    ToolTip="Oblique (DIMEDIT, Oblique)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimTextAngle}"
                                    Content="Text Angle"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DIMEDIT R"
                                    ToolTip="Text Angle (DIMEDIT, Rotate)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimJustifyLeft}"
                                    Content="Left Justify"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DIMTEDIT \ L"
                                    ToolTip="Left Justify (DIMTEDIT, Left)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimJustifyCenter}"
                                    Content="Center Justify"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DIMTEDIT \ C"
                                    ToolTip="Center Justify (DIMTEDIT, Center)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimJustifyRight}"
                                    Content="Right Justify"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DIMTEDIT \ R"
                                    ToolTip="Right Justify (DIMTEDIT, Right)"
                                />
                                <Button
                                    Style="{StaticResource TileButton}"
                                    Tag="{StaticResource GhIconDimOverride}"
                                    Content="Override"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}"
                                    CommandParameter="DIMOVERRIDE"
                                    ToolTip="Override (DIMOVERRIDE)"
                                />
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconDimSmart}"
                                Content="Dimension"
                                IsEnabled="{Binding Model.HasDocument}"
                                Command="{Binding Model.StartCommandCommand}"
                                CommandParameter="DIM"
                                ToolTip="Dimension (DIM)"
                            />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="22" VerticalAlignment="Top">
                                            <local:IconView
                                                Size="16"
                                                StrokeThickness="1.8"
                                                Data="{StaticResource GhIconDimStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                            />
                                        </Border>
                                        <ComboBox
                                            Style="{StaticResource StyleBoxCombo}"
                                            Width="180"
                                            Height="22"
                                            Margin="0,0,0,2"
                                            VerticalAlignment="Top"
                                            IsEnabled="{Binding Model.HasDocument}"
                                            ItemsSource="{Binding Model.DimStyleItems}"
                                            SelectedValue="{Binding Model.CurrentDimStyle, Mode=TwoWay}"
                                            AutomationProperties.Name="Dimension Style"
                                            ToolTip="Dimension style (DIMSTYLE)"
                                        />
                                    </StackPanel>
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDimBreak}"
                                        Content="Break"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DIMBREAK"
                                        ToolTip="Break (DIMBREAK)"
                                    />
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconDimSpace}"
                                        Content="Adjust Space"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DIMSPACE"
                                        ToolTip="Adjust Space (DIMSPACE)"
                                    />
                                    <Button
                                        Style="{StaticResource TileButton}"
                                        Tag="{StaticResource GhIconJogLine}"
                                        Content="Jog Line"
                                        IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}"
                                        CommandParameter="DIMJOGLINE"
                                        ToolTip="Jog Line (DIMJOGLINE)"
                                    />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="22" VerticalAlignment="Top">
                                            <local:IconView
                                                Size="16"
                                                StrokeThickness="1.8"
                                                Data="{StaticResource GhIconLayers}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                            />
                                        </Border>
                                        <ComboBox
                                            Style="{StaticResource PropertyCombo}"
                                            Width="180"
                                            Margin="0,0,0,2"
                                            VerticalAlignment="Top"
                                            IsEnabled="{Binding Model.HasDocument}"
                                            ItemsSource="{Binding Model.DimLayerOptions}"
                                            SelectedItem="{Binding Model.CurrentDimLayer, Mode=TwoWay}"
                                            AutomationProperties.Name="Dim Layer"
                                            ToolTip="Dim Layer: the layer new dimensions go on (DIMLAYER)"
                                        />
                                    </StackPanel>
                                    <Button
