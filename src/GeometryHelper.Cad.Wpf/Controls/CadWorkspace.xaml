                                            >
                                                <MenuItem
                                                    Style="{StaticResource GhMenuItem}"
                                                    Header="Snap to Underlays ON"
                                                    Tag="{StaticResource GhIconSnapUnderlay}"
                                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                                    CommandParameter="PDFOSNAP 1"
                                                    ToolTip="Snap to Underlays ON (PDFOSNAP 1)"
