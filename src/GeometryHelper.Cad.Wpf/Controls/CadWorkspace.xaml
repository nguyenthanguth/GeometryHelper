                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconUploadSource}"
                                    Content="Upload to Source"
                                    IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandWithOptionCommand}"
                                    CommandParameter="DATALINKUPDATE W"
                                    ToolTip="Upload to Source (DATALINKUPDATE, Write)"
                                />
                                <Button
                                    Style="{StaticResource SmallButton}"
                                    Tag="{StaticResource GhIconExtractData}"
                                    Content="Extract Data"
