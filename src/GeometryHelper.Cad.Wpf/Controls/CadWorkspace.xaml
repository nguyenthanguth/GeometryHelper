                    <local:RibbonPanel Title="Import" Icon="{StaticResource GhIconImport}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource BigButton}"
                                Tag="{StaticResource GhIconImport}"
                                Content="Import"
