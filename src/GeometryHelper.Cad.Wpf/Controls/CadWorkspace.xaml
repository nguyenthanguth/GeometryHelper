                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYOFF"
                                                ToolTip="Off (LAYOFF)"
                                            />
                                            <Button
                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconLayerIsolate}"
                                                Content="Isolate"
                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYISO"
                                                ToolTip="Isolate (LAYISO)"
                                            />
                                            <Button
                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconLayerFreeze}"
