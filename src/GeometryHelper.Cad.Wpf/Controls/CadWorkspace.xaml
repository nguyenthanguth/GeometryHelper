                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconLayerUnisolate}"
                                                Content="Unisolate"
                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYUNISO"
                                                ToolTip="Unisolate (LAYUNISO)"
                                            />
                                            <Button
                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconLayerThaw}"
                                                Content="Thaw All Layers"
                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYTHW"
                                                ToolTip="Thaw All Layers (LAYTHW)"
                                            />
                                            <Button
                                                Style="{StaticResource TileButton}"
                                                Tag="{StaticResource GhIconLayerUnlock}"
                                                Content="Unlock"
                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYULK"
                                                ToolTip="Unlock (LAYULK)"
                                            />
                                            <Button
                                                Style="{StaticResource TileTextButton}"
                                                Tag="{StaticResource GhIconMatch}"
                                                Content="Match Layer"
                                                Command="{Binding StartCommandCommand}"
                                                CommandParameter="LAYMCH"
                                                ToolTip="Match Layer (LAYMCH)"
                                            />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </local:RibbonPanel>
                            <local:RibbonPanel Title="Block" Icon="{StaticResource GhIconInsertBlock}">
                                <local:RibbonPanel.Header>
                                    <ToggleButton
                                        Style="{StaticResource SlideOutTitle}"
                                        IsEnabled="{Binding HasDocument}"
