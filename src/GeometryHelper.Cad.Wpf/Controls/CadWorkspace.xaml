            <!--
            The View tab, as AutoCAD 2021's: Viewport Tools (UCS Icon), Named Views (the named view box, New View, View Manager), Model
            Viewports (Viewport Configuration, Named, Join, Restore), Palettes (Tool Palettes, Properties and the tiles), Interface (Drawings,
            the launcher of Global settings), then ours: Navigate, Views and the drafting toggles of the status bar. Ours shrink first, then
            AutoCAD's panels below 1 100: Drafting and Navigate draw their small buttons by their icons, Views collapses, then Drafting and
            Navigate collapse, Named Views and Model Viewports go medium and Interface collapses. Viewport Tools and Palettes never shrink.
            The widths are those of the content: no panel has a floor of its own.
            -->
            <DataTemplate DataType="{x:Type local:ViewRibbonViewModel}">
                <local:RibbonStrip Steps="Drafting:Medium; Navigate:Medium; Views:Collapsed; Drafting:Collapsed; Navigate:Collapsed; Named Views:Medium; Model Viewports:Medium; Interface:Collapsed">
                    <local:RibbonStrip.Resources>
                        <!--
                        The box of Named Views: 22 high, 200 wide as AutoCAD's, 160 in a medium panel.
                        -->
                        <Style x:Key="NamedViewBox" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                            <Setter Property="Width" Value="200" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="Width" Value="160" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!--
                        The label of the Viewport Configuration split: wide enough for Configuration (69 pixels), which the 66 of a big split's label
                        broke inside the word; two lines, the word whole.
                        -->
                        <DataTemplate x:Key="ViewportConfigurationLabel">
                            <StackPanel>
                                <TextBlock
                                    Text="{Binding}"
                                    HorizontalAlignment="Center"
                                    MaxWidth="80"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                />
                                <TextBlock
                                    Text="▾"
                                    Foreground="{StaticResource GhTextMuted}"
                                    HorizontalAlignment="Center"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </local:RibbonStrip.Resources>
                    <local:RibbonPanel Title="Viewport Tools" Icon="{StaticResource GhIconUcsIcon}">
                        <ToggleButton
                            Style="{StaticResource BigToggle}"
                            Tag="{StaticResource GhIconUcsIcon}"
                            Content="UCS Icon"
                            IsEnabled="{Binding Model.HasDocument}"
                            IsChecked="{Binding Model.IsUcsIconOn, Mode=TwoWay}"
                            Margin="0"
                            ToolTip="UCS Icon (UCSICON): lit while the icon is shown; a click turns it on or off"
                        />
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Named Views" Icon="{StaticResource GhIconViewManager}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <ComboBox
                                Style="{StaticResource NamedViewBox}"
                                IsEnabled="{Binding Model.HasDocument}"
