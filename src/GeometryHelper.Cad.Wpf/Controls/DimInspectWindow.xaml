<Window
    x:Class="GeometryHelper.Cad.Wpf.DimInspectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
    Title="Inspection Dimension"
    Width="460"
    Height="330"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Cad.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />

            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="{Binding WindowTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: Remove Inspection (where a dimension has one) on the left, OK and Cancel on the right. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Remove Inspection"
                        Padding="14,5"
                        Margin="0,0,12,0"
                        Click="OnRemove"
                        Visibility="{Binding CanRemove, Converter={StaticResource Shown}}"
                    />
                    <TextBlock />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Selected}" />

                <!-- Shape: the frame about the words, its ends round or pointed, or none. -->
                <TextBlock Style="{StaticResource RowLabel}" Text="Shape:" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Round"
                        IsChecked="{Binding IsRound, Mode=TwoWay}"
                        Margin="0,0,8,0"
                        GroupName="InspectionShape"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Angular"
                        IsChecked="{Binding IsAngular, Mode=TwoWay}"
                        Margin="0,0,8,0"
                        GroupName="InspectionShape"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="None"
                        IsChecked="{Binding IsNone, Mode=TwoWay}"
                        GroupName="InspectionShape"
                    />
                </StackPanel>

                <!-- Label and inspection rate: the words either side of the dimension's own. -->
                <TextBlock Style="{StaticResource RowLabel}" Text="Label (left empty: none):" Margin="0,14,0,4" />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Label"
                />
                <TextBlock
                    Style="{StaticResource RowLabel}"
                    Text="Inspection rate (left empty: 100%):"
                    Margin="0,12,0,4"
                />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Inspection rate"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
