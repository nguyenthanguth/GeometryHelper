<UserControl
    x:Class="GeometryHelper.Cad.Wpf.ArrayRibbon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Cad.Wpf"
>
    <!--
    The contextual Array tab, as AutoCAD 2021 draws it for an associative array: Type, the Columns (Items) with Count, Between
    and Total, Rows, Levels, and Properties (Base Point, Edit Source, Replace Item, Reset Array, Rotate Items or Align Items,
    Direction, Method). Its logic is ArrayTabViewModel; each value changed is one undo step named ARRAYEDIT. The ribbon's
    styles are the workspace's, found at run time (DynamicResource); what is not built is greyed with its reason.
    -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="Shown" />
        <Geometry x:Key="IconBasePoint">M12 3v6M12 15v6M3 12h6M15 12h6M10 10h4v4h-4z</Geometry>
        <Geometry x:Key="IconEditSource">M4 20l1-4 11-11 3 3L8 19zM14 7l3 3</Geometry>
        <Geometry x:Key="IconReplace">M4 7h10M4 7l3-3M4 7l3 3M20 17H10M20 17l-3-3M20 17l-3 3</Geometry>
        <Geometry x:Key="IconReset">M5 12a7 7 0 1 0 2-5M5 4v4h4</Geometry>
        <Style x:Key="ArrayField" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="ArrayLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Type" />
                <StackPanel VerticalAlignment="Top" MinWidth="76">
                    <TextBlock Text="{Binding TypeName}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock Text="Associative array" Opacity="0.7" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="{Binding ItemsTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource ArrayLabel}" Text="{Binding ItemsTitle}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding Items, UpdateSourceTrigger=LostFocus}"
                        ToolTip="The number of columns, or of items round the centre or along the path"
                    />
                    <TextBlock Grid.Row="1" Style="{StaticResource ArrayLabel}" Text="Between" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding Between, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                        ToolTip="The distance between them; for a polar array the angle between the items, in degrees"
                    />
                    <TextBlock Grid.Row="2" Style="{StaticResource ArrayLabel}" Text="Total" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding Total, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                        ToolTip="The distance from the first to the last; for a polar array the angle it fills, in degrees"
                    />
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Rows" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource ArrayLabel}" Text="Rows" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding Rows, UpdateSourceTrigger=LostFocus}"
                    />
                    <TextBlock Grid.Row="1" Style="{StaticResource ArrayLabel}" Text="Between" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding RowBetween, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                    />
                    <TextBlock Grid.Row="2" Style="{StaticResource ArrayLabel}" Text="Total" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding RowTotal, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                    />
                    <TextBlock Grid.Row="3" Style="{StaticResource ArrayLabel}" Text="Elevation" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding RowElevation, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                        ToolTip="How much higher each row is than the one before"
                    />
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Levels" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource ArrayLabel}" Text="Levels" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding Levels, UpdateSourceTrigger=LostFocus}"
                    />
                    <TextBlock Grid.Row="1" Style="{StaticResource ArrayLabel}" Text="Between" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding LevelBetween, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                    />
                    <TextBlock Grid.Row="2" Style="{StaticResource ArrayLabel}" Text="Total" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource ArrayField}"
                        Text="{Binding LevelTotal, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                    />
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Properties" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconBasePoint}"
                        Content="Base Point"
                        IsEnabled="True"
                        Command="{Binding BasePointCommand}"
                        ToolTip="ARRAYEDIT: pick the array, then Base point"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconEditSource}"
                        Content="Edit Source"
                        ToolTip="Not built: replace the source objects with ARRAYEDIT, REPlace, Source objects"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconReplace}"
                        Content="Replace Item"
                        ToolTip="Not built: replace the source objects with ARRAYEDIT, REPlace, Source objects"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{StaticResource IconReset}"
                        Content="Reset Array"
                        IsEnabled="True"
                        Command="{Binding ResetCommand}"
                        ToolTip="Make the items again from the parameters"
                    />
                    <StackPanel VerticalAlignment="Top" Margin="4,2,0,0">
                        <CheckBox
                            Content="Rotate Items"
                            Margin="0,0,0,4"
                            IsChecked="{Binding RotateItems}"
                            Visibility="{Binding IsPolar, Converter={StaticResource Shown}}"
                        />
                        <CheckBox
                            Content="Clockwise"
                            Margin="0,0,0,4"
                            IsChecked="{Binding Clockwise}"
                            Visibility="{Binding IsPolar, Converter={StaticResource Shown}}"
                        />
                        <CheckBox
                            Content="Align Items"
                            Margin="0,0,0,4"
                            IsChecked="{Binding AlignItems}"
                            Visibility="{Binding IsPath, Converter={StaticResource Shown}}"
                        />
                        <CheckBox
                            Content="Divide"
                            Margin="0,0,0,4"
                            IsChecked="{Binding Divide}"
                            ToolTip="Share the path among the items (Divide) instead of setting them a distance apart (Measure)"
                            Visibility="{Binding IsPath, Converter={StaticResource Shown}}"
                        />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
