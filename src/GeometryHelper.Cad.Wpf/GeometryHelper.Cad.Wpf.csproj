<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>GeometryHelper.Cad.Wpf</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.Wpf</AssemblyName>
        <Description>The controls of the GeometryHelper 2D presenter: the canvas drawn with SkiaSharp, the file list, Properties, the layer box, the command line and the status bar.</Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeometryHelper.Cad\GeometryHelper.Cad.csproj" />
        <ProjectReference Include="..\GeometryHelper\GeometryHelper.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GeometryHelper.Cad.UnitTest" />
        <InternalsVisibleTo Include="GeometryHelper.Cad.Wpf.UnitTest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.155.0" />
    </ItemGroup>

    <!-- The printers of Windows the Plot dialog lists and prints to; .NET 8's WPF brings System.Printing and ReachFramework itself. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <Reference Include="System.Printing" />
        <Reference Include="ReachFramework" />
    </ItemGroup>
</Project>
