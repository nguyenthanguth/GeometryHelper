<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LayerTranslatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Layer Translator"
    Width="920"
    Height="680"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TranslateRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ColumnHead" TargetType="TextBlock">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Style>

            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <DataTemplate x:Key="FromTemplate" DataType="{x:Type local:TranslateLayerRowViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Use}"
                        Style="{StaticResource Cell}"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                    <Border
                        Grid.Column="2"
                        Width="14"
                        Height="14"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ToTemplate" DataType="{x:Type local:TranslateLayerRowViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                    <Border
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                    />
                    <TextBlock Grid.Column="2" Text="{Binding Linetype}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding LineWeight}" Style="{StaticResource Cell}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Layer Translator" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Settings…"
                        Padding="12,5"
                        Click="OnSettings"
                    />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Translate"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnTranslate"
                            IsEnabled="{Binding CanTranslate}"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Background="{StaticResource GhClose}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource GhError}"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding Message}"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Translate From" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <Button
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhDialogButton}"
                                Content="Select"
                                Padding="10,3"
                                Margin="6,0,0,0"
                                Click="OnSelectByFilter"
                            />
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Selection Filter:"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                Tag="*"
                                Text="{Binding SelectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Selection filter"
                            />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Map"
                                Padding="16,4"
                                Margin="0,0,8,0"
                                Click="OnMap"
                                ToolTip="Map the layers selected on the left to the layer selected on the right"
                            />
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Map same"
                                Padding="12,4"
                                Click="OnMapSame"
                                ToolTip="Map every layer to the layer of the same name"
                            />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="1" Text="Use" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="2" Text="Color" Style="{StaticResource ColumnHead}" />
                            </Grid>
                            <ListBox
                                x:Name="FromList"
                                ItemsSource="{Binding FromRows}"
                                SelectionMode="Extended"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource TranslateRow}"
                                ItemTemplate="{StaticResource FromTemplate}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch"
                                SelectionChanged="OnFromSelectionChanged"
                                AutomationProperties.Name="Translate From"
                            />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Translate To" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Load…"
                            Padding="14,4"
                            Margin="0,0,8,0"
                            Click="OnLoad"
                            ToolTip="Load the layers of a standards file: .dwg, .dws, .dwt or .dxf"
                        />
                        <Button Style="{StaticResource GhDialogButton}" Content="New…" Padding="14,4" Click="OnNew" />
                    </StackPanel>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="1" Text="Color" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="2" Text="Linetype" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="3" Text="Lineweight" Style="{StaticResource ColumnHead}" />
                            </Grid>
                            <ListBox
                                x:Name="ToList"
                                ItemsSource="{Binding ToRows}"
                                SelectionMode="Single"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource TranslateRow}"
                                ItemTemplate="{StaticResource ToTemplate}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Translate To"
                            />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Row="2" Grid.ColumnSpan="3">
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Layer Translation Mappings"
                        FontWeight="SemiBold"
                        Margin="0,0,0,6"
                    />
                    <StackPanel DockPanel.Dock="Right" Margin="14,0,0,0" Width="100">
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Edit…"
                            Click="OnEdit"
                            ToolTip="Change the colour, linetype, lineweight, transparency and plot style the mappings selected give"
                        />
                        <Button Style="{StaticResource SideButton}" Content="Remove" Click="OnRemove" />
                        <Button Style="{StaticResource SideButton}" Content="Save…" Click="OnSave" />
                    </StackPanel>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Old" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="1" Text="New" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="2" Text="Linetype" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="3" Text="Color" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="4" Text="Lineweight" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="5" Text="Transparency" Style="{StaticResource ColumnHead}" />
                                <TextBlock Grid.Column="6" Text="Plot Style" Style="{StaticResource ColumnHead}" />
                            </Grid>
                            <ListBox
                                x:Name="MappingList"
                                ItemsSource="{Binding MappingRows}"
                                SelectionMode="Extended"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource TranslateRow}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Layer Translation Mappings"
                            >
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TranslateMappingRowViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OldName}" Style="{StaticResource Cell}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding NewName}"
                                                Style="{StaticResource Cell}"
                                                FontWeight="SemiBold"
                                            />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding Linetype}"
                                                Style="{StaticResource Cell}"
                                            />
                                            <Border
                                                Grid.Column="3"
                                                Width="14"
                                                Height="14"
                                                BorderBrush="{StaticResource GhBorder}"
                                                BorderThickness="1"
                                                Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                                            />
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding LineWeight}"
                                                Style="{StaticResource Cell}"
                                            />
                                            <TextBlock
                                                Grid.Column="5"
                                                Text="{Binding Transparency}"
                                                Style="{StaticResource Cell}"
                                            />
                                            <TextBlock
                                                Grid.Column="6"
                                                Text="{Binding PlotStyle}"
                                                Style="{StaticResource Cell}"
                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
