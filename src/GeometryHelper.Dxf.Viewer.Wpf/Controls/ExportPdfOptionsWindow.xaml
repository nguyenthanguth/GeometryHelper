<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ExportPdfOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export to PDF Options"
    Width="440"
    Height="440"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design ExportPdfOptions: Quality and Data, the rows the writer does always or never greyed. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Export to PDF Options"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnOk"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        IsCancel="True"
                        Click="OnCancel"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,12">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Quality" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Vector quality"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            IsEnabled="False"
                            SelectedIndex="0"
                            AutomationProperties.Name="Vector quality"
                            ToolTip="Lines are written as exact vectors"
                        >
                            <ComboBoxItem Content="Exact vectors" />
                        </ComboBox>
                        <TextBlock
                            Grid.Row="2"
                            Text="Raster image quality"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            IsEnabled="False"
                            SelectedIndex="0"
                            AutomationProperties.Name="Raster image quality"
                            ToolTip="Raster images are kept at their own resolution"
                        >
                            <ComboBoxItem Content="As embedded" />
                        </ComboBox>
                        <TextBlock
                            Grid.Row="4"
                            Text="Merge control"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            IsEnabled="False"
                            SelectedIndex="0"
                            AutomationProperties.Name="Merge control"
                        >
                            <ComboBoxItem Content="Lines overwrite" />
                        </ComboBox>
                    </Grid>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Data" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Include layer information"
                            IsEnabled="False"
                            ToolTip="The PDF writer keeps no layers"
                        />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Include hyperlinks"
                            IsChecked="{Binding IncludeHyperlinks, Mode=TwoWay}"
                        />
                        <CheckBox Style="{StaticResource BlockCheck}" Content="Create bookmarks" IsEnabled="False" />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Capture fonts used in the drawing"
                            IsChecked="True"
                            IsEnabled="False"
                            ToolTip="TrueType fonts are always embedded"
                        />
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Convert all text to geometry"
                            IsEnabled="False"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <TextBlock Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap">
                    Include hyperlinks makes each hyperlink of an object plotted a link over its box. The greyed rows show what the presenter's PDF writer does always or never.
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
