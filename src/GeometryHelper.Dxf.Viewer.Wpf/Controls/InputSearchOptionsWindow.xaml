<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.InputSearchOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Input Search Options"
    Width="500"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TypeRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                                Padding="8,3"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Input Search Options"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource GhWarn}"
                        Text="{Binding Message}"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="AutoComplete" Margin="0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Enable AutoComplete"
                            IsChecked="{Binding AutoComplete, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <StackPanel Margin="20,0,0,0" IsEnabled="{Binding AutoComplete}">
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Enable mid-string search"
                                IsChecked="{Binding MidString, Mode=TwoWay}"
                                Margin="0,0,0,6"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="According to frequency of usage"
                                GroupName="Sort"
                                IsChecked="{Binding ByFrequency, Mode=TwoWay}"
                                Margin="0,0,0,6"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="Alphabetically"
                                GroupName="Sort"
                                IsChecked="{Binding Alphabetically, Mode=TwoWay}"
                            />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="AutoCorrect" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Enable AutoCorrect"
                            IsChecked="{Binding AutoCorrect, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" IsEnabled="{Binding AutoCorrect}">
                            <TextBlock Text="Remember corrections after" VerticalAlignment="Center" />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                Width="48"
                                Margin="6,0"
                                FontFamily="{StaticResource GhMonoFont}"
                                Text="{Binding RememberAfter, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Remember corrections after"
                            />
                            <TextBlock Text="mistypes" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="System variables" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Search system variables"
                            IsChecked="{Binding SystemVariables, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Separate commands and system variables"
                            IsChecked="{Binding Separate, Mode=TwoWay}"
                            IsEnabled="{Binding SystemVariables}"
                            Margin="20,0,0,0"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Delay time" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Suggestion list delay time:" VerticalAlignment="Center" />
                        <TextBox
                            Style="{StaticResource StyleBox}"
                            Width="64"
                            Margin="6,0"
                            FontFamily="{StaticResource GhMonoFont}"
                            Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Suggestion list delay time"
                        />
                        <TextBlock Text="milliseconds" VerticalAlignment="Center" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Search content" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Search content at command line"
                            IsChecked="{Binding SearchContent, Mode=TwoWay}"
                            Margin="0,0,0,6"
                        />
                        <DockPanel Margin="20,0,0,0" IsEnabled="{Binding SearchContent}">
                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="▲"
                                    Padding="8,3"
                                    Margin="0,0,0,4"
                                    Click="OnMoveUp"
                                    IsEnabled="{Binding CanMoveUp}"
                                    ToolTip="Move up"
                                    AutomationProperties.Name="Move up"
                                />
                                <Button
                                    Style="{StaticResource GhDialogButton}"
                                    Content="▼"
                                    Padding="8,3"
                                    Click="OnMoveDown"
                                    IsEnabled="{Binding CanMoveDown}"
                                    ToolTip="Move down"
                                    AutomationProperties.Name="Move down"
                                />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="Content type"
                                            Padding="8,5"
                                            FontSize="11"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Search"
                                            Padding="8,5"
                                            FontSize="11"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                    </Grid>
                                    <ListBox
                                        ItemsSource="{Binding ContentTypes}"
                                        SelectedItem="{Binding SelectedContentType, Mode=TwoWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource TypeRow}"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="Content type list"
                                    >
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ContentTypeRowViewModel}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Foreground="{StaticResource GhText}"
                                                    />
                                                    <CheckBox
                                                        Grid.Column="1"
                                                        Style="{StaticResource StyleCheck}"
                                                        IsChecked="{Binding IsSearched, Mode=TwoWay}"
                                                        AutomationProperties.Name="{Binding Name}"
                                                    />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
