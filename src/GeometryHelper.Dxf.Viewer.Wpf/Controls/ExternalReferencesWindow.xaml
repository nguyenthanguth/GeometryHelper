<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ExternalReferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="External References"
    Width="460"
    Height="760"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />

            <!-- A button of the palette's tool row: dark, outlined, an icon and its words. -->
            <Style x:Key="XrefTool" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <!-- A pair of view buttons: the one on filled with the selection's blue. -->
            <Style x:Key="XrefViewToggle" TargetType="RadioButton">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Box" Background="Transparent" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="#1F4E79" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ContextMenu x:Key="AttachMenu" Style="{StaticResource GhContextMenu}">
                <MenuItem Style="{StaticResource GhMenuItem}" Command="{Binding AttachDxfCommand}">
                    <MenuItem.Header>
                        <DockPanel Width="220">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="XATTACH"
                                FontFamily="{StaticResource GhMonoFont}"
                                FontSize="10"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock Text="Attach DXF…" />
                        </DockPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource GhMenuItem}" Command="{Binding AttachImageCommand}">
                    <MenuItem.Header>
                        <DockPanel Width="220">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="IMAGEATTACH"
                                FontFamily="{StaticResource GhMonoFont}"
                                FontSize="10"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock Text="Attach Image…" />
                        </DockPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator Style="{StaticResource GhMenuSeparator}" />
                <MenuItem Style="{StaticResource GhMenuItem}" IsEnabled="False" Header="Attach DWG…   not offered" />
                <MenuItem Style="{StaticResource GhMenuItem}" IsEnabled="False" Header="Attach DWF…   not offered" />
                <MenuItem Style="{StaticResource GhMenuItem}" IsEnabled="False" Header="Attach DGN…   not offered" />
                <MenuItem Style="{StaticResource GhMenuItem}" IsEnabled="False" Header="Attach PDF…   not offered" />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    IsEnabled="False"
                    Header="Attach Point Cloud…   not offered"
                />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    IsEnabled="False"
                    Header="Attach Coordination Model…   not offered"
                />
            </ContextMenu>

            <ContextMenu x:Key="RefreshMenu" Style="{StaticResource GhContextMenu}">
                <MenuItem Style="{StaticResource GhMenuItem}" Header="Refresh" Command="{Binding RefreshCommand}" />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    Header="Reload All References"
                    Command="{Binding ReloadAllCommand}"
                />
            </ContextMenu>

            <ContextMenu x:Key="PathMenu" Style="{StaticResource GhContextMenu}">
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    Header="Make Absolute"
                    Command="{Binding MakeAbsoluteCommand}"
                />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    Header="Make Relative"
                    Command="{Binding MakeRelativeCommand}"
                />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    Header="Remove Path"
                    Command="{Binding RemovePathCommand}"
                />
                <MenuItem
                    Style="{StaticResource GhMenuItem}"
                    Header="Select New Path…"
                    Click="OnSelectNewPath"
                    IsEnabled="{Binding IsReference}"
                />
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="EXTERNAL REFERENCES"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
            >
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="AttachButton"
                        Style="{StaticResource XrefTool}"
                        Click="OnMenuButton"
                        Tag="AttachMenu"
                        AutomationProperties.Name="Attach"
                    >
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 14h6M12 11v6"
                                Stroke="#C9D1DB"
                                StrokeThickness="1.8"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Margin="0,0,4,0"
                            />
                            <TextBlock Text="Attach ▾" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource XrefTool}"
                        Click="OnMenuButton"
                        Tag="RefreshMenu"
                        AutomationProperties.Name="Refresh"
                    >
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Data="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6"
                                Stroke="#C9D1DB"
                                StrokeThickness="1.8"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Margin="0,0,4,0"
                            />
                            <TextBlock Text="Refresh ▾" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource XrefTool}"
                        Click="OnMenuButton"
                        Tag="PathMenu"
                        AutomationProperties.Name="Change Path"
                    >
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 13h6M13 11l2 2-2 2"
                                Stroke="#C9D1DB"
                                StrokeThickness="1.8"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Margin="0,0,4,0"
                            />
                            <TextBlock Text="Change Path ▾" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="12,6,12,4">
                <RadioButton
                    DockPanel.Dock="Right"
                    Style="{StaticResource XrefViewToggle}"
                    GroupName="View"
                    IsChecked="{Binding IsTreeView, Mode=TwoWay}"
                    ToolTip="Tree view"
                    AutomationProperties.Name="Tree view"
                >
                    <Path
                        Data="M4 4v16M4 8h6M4 16h6M14 8h6M14 16h6"
                        Stroke="#9AA4B1"
                        StrokeThickness="2"
                        Width="13"
                        Height="13"
                        Stretch="Uniform"
                    />
                </RadioButton>
                <RadioButton
                    x:Name="ListToggle"
                    DockPanel.Dock="Right"
                    Style="{StaticResource XrefViewToggle}"
                    GroupName="View"
                    IsChecked="True"
                    ToolTip="List view"
                    AutomationProperties.Name="List view"
                >
                    <Path
                        Data="M4 6h16M4 12h16M4 18h16"
                        Stroke="#C9D1DB"
                        StrokeThickness="2"
                        Width="13"
                        Height="13"
                        Stretch="Uniform"
                    />
                </RadioButton>
                <TextBlock Text="File References" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border
                DockPanel.Dock="Top"
                Margin="12,0"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Background="#1A1E24"
                Height="230"
            >
                <DockPanel>
                    <Grid
                        DockPanel.Dock="Top"
                        Background="{StaticResource GhHeader}"
                        TextElement.FontSize="11"
                        TextElement.Foreground="{StaticResource GhTextMuted}"
                    >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Reference Name" Margin="8,4" />
                        <TextBlock Grid.Column="1" Text="Status" Margin="8,4" />
                        <TextBlock Grid.Column="2" Text="Size" Margin="8,4" />
                        <TextBlock Grid.Column="3" Text="Type" Margin="8,4" />
                    </Grid>
                    <ListBox
                        x:Name="References"
                        ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        SelectionMode="Extended"
                        SelectionChanged="OnRowsSelected"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="File References"
                        MouseDoubleClick="OnRowDoubleClick"
                    >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter
                                    Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource GhHeader}"
                                                BorderThickness="0,1,0,0"
                                            >
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1F4E79" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu
                                            Style="{StaticResource GhContextMenu}"
                                            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                        >
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Open"
                                                Command="{Binding OpenCommand}"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Attach…"
                                                Command="{Binding AttachDxfCommand}"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Unload"
                                                Command="{Binding UnloadCommand}"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Reload"
                                                Command="{Binding ReloadCommand}"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Detach"
                                                Command="{Binding DetachCommand}"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Bind…"
                                                Command="{Binding BindCommand}"
                                            />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReferenceRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                        <Border x:Name="Indent" Width="{Binding Indent}" />
                                        <Path
                                            Data="{Binding Icon}"
                                            Stroke="{Binding IconBrush}"
                                            StrokeThickness="1.8"
                                            Width="14"
                                            Height="14"
                                            Stretch="Uniform"
                                            Margin="0,0,6,0"
                                        />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Foreground="{StaticResource GhText}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding StatusText}"
                                        Foreground="{Binding StatusBrush}"
                                        Margin="8,4"
                                    />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SizeText}"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Margin="8,4"
                                    />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding TypeName}"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Margin="8,4"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                <RadioButton
                    DockPanel.Dock="Right"
                    Style="{StaticResource XrefViewToggle}"
                    GroupName="Lower"
                    IsChecked="{Binding IsPreview, Mode=TwoWay}"
                    ToolTip="Preview"
                    AutomationProperties.Name="Preview"
                >
                    <Path
                        Data="M3 5h18v14H3zM7 15l3-4 3 3 2-2 3 3"
                        Stroke="#9AA4B1"
                        StrokeThickness="2"
                        Width="13"
                        Height="13"
                        Stretch="Uniform"
                    />
                </RadioButton>
                <RadioButton
                    DockPanel.Dock="Right"
                    Style="{StaticResource XrefViewToggle}"
                    GroupName="Lower"
                    IsChecked="True"
                    ToolTip="Details"
                    AutomationProperties.Name="Details"
                >
                    <Path
                        Data="M4 6h16M4 12h10M4 18h12"
                        Stroke="#C9D1DB"
                        StrokeThickness="2"
                        Width="13"
                        Height="13"
                        Stretch="Uniform"
                    />
                </RadioButton>
                <TextBlock Text="Details" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border
                DockPanel.Dock="Top"
                Margin="12,0"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Background="#1A1E24"
                MinHeight="200"
            >
                <Grid>
                    <ItemsControl
                        ItemsSource="{Binding Details}"
                        Focusable="False"
                        Visibility="{Binding IsPreview, Converter={StaticResource HiddenWhen}}"
                    >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReferenceDetailViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.ColumnSpan="2"
                                        BorderBrush="{StaticResource GhHeader}"
                                        BorderThickness="0,1,0,0"
                                    />
                                    <TextBlock
                                        Text="{Binding Key}"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Margin="8,4"
                                    />
                                    <TextBlock
                                        x:Name="Value"
                                        Grid.Column="1"
                                        Text="{Binding Value}"
                                        Margin="8,4"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Value}"
                                    />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPath}" Value="True">
                                        <Setter
                                            TargetName="Value"
                                            Property="FontFamily"
                                            Value="{StaticResource GhMonoFont}"
                                        />
                                        <Setter TargetName="Value" Property="FontSize" Value="11" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Image
                        Source="{Binding Preview}"
                        Stretch="Uniform"
                        Margin="6"
                        Visibility="{Binding IsPreview, Converter={StaticResource Shown}}"
                    />
                </Grid>
            </Border>

            <StackPanel Margin="12,10" TextElement.Foreground="{StaticResource GhTextMuted}">
                <TextBlock
                    TextWrapping="Wrap"
                    Margin="0,0,0,4"
                    Text="Status: Loaded, Unloaded, Not Found, Unreferenced, Orphaned (its parent is not shown), Needs Reloading (the file changed on disk: Reload reads it again)."
                />
                <TextBlock
                    TextWrapping="Wrap"
                    Text="Right-click a row: Open, Attach…, Unload, Reload, Detach, Bind…. Bind… binds the drawings selected (Ctrl or Shift for several) into this one; greyed for those unloaded or not found, and for images."
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
