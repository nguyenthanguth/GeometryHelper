<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.EditAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxf="clr-namespace:GeometryHelper.Dxf.Viewer;assembly=GeometryHelper.Dxf.Viewer"
        Title="Edit Attributes" Width="520" Height="460" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Edit Attributes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10">
                <TextBlock Text="Block name: " Foreground="{StaticResource GhTextMuted}" />
                <TextBlock Text="{Binding Block}" FontWeight="SemiBold" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button Style="{StaticResource GhDialogButton}" Content="Previous" Padding="14,5" Margin="0,0,8,0" Click="OnPrevious" IsEnabled="{Binding CanPrevious}" />
                    <Button Style="{StaticResource GhDialogButton}" Content="Next" Padding="14,5" Click="OnNext" IsEnabled="{Binding CanNext}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="14,5" Click="OnOk" IsDefault="True" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Margin="16,0,16,10" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap">
                <Run Text="{Binding PageText, Mode=OneWay}" /><Run Text=" · 8 attributes a page, in definition order. Constant attributes are not listed; a Verify attribute asks once here, not twice." />
            </TextBlock>

            <ItemsControl Margin="16,0,16,12" ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dxf:CadAttributeValueRow}">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Prompt}" Foreground="#C9D1DB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="2" Style="{StaticResource BlockNumber}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Prompt}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
