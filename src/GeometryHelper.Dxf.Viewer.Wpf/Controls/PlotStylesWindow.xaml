<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PlotStylesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Plot Styles"
    Width="760"
    Height="480"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HeadText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- A file of the folder: its name, kind, description and when it was written. -->
            <DataTemplate x:Key="FileRow" DataType="{x:Type local:PlotStyleFileRow}">
                <Grid Background="Transparent" MouseLeftButtonDown="OnRowDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource GhTextMuted}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding Description}"
                        Foreground="{StaticResource GhTextMuted}"
                        TextTrimming="CharacterEllipsis"
                    />
                    <TextBlock
                        Grid.Column="3"
                        Text="{Binding ModifiedText}"
                        Foreground="{StaticResource GhTextMuted}"
                        FontFamily="{StaticResource GhMonoFont}"
                    />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Plot Styles" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the folder and how many tables it holds, what failed, then Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="14,5"
                        Click="OnClose"
                        IsDefault="True"
                        IsCancel="True"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                        Foreground="{StaticResource GhTextMuted}"
                        FontFamily="{StaticResource GhMonoFont}"
                        FontSize="11"
                        Text="{Binding Summary}"
                    />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Right" Width="120" Margin="0,12,16,12">
                <Button
                    Style="{StaticResource GhDialogButton}"
                    Content="Edit…"
                    Padding="12,5"
                    Margin="0,0,0,8"
                    Click="OnEdit"
                    IsEnabled="{Binding CanEdit}"
                    AutomationProperties.Name="Edit plot style table"
                />
                <Button
                    Style="{StaticResource GhDialogButton}"
                    Content="New…"
                    Padding="12,5"
                    Margin="0,0,0,8"
                    Click="OnNew"
                    AutomationProperties.Name="New plot style table"
                />
                <Button
                    Style="{StaticResource GhDialogButton}"
                    Content="Delete"
                    Padding="12,5"
                    Margin="0,0,0,8"
                    Click="OnDelete"
                    IsEnabled="{Binding CanEdit}"
                    AutomationProperties.Name="Delete plot style table"
                />
                <Button
                    Style="{StaticResource GhDialogButton}"
                    Content="Open folder"
                    Padding="12,5"
                    Click="OnOpenFolder"
                    AutomationProperties.Name="Open folder"
                />
            </StackPanel>

            <DockPanel Margin="16,12,12,12">
                <TextBlock
                    DockPanel.Dock="Bottom"
                    Text="{Binding Message}"
                    Foreground="{StaticResource GhWarn}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                />
                <Grid DockPanel.Dock="Top" Margin="10,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource HeadText}" Text="Name" />
                    <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="Kind" />
                    <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="Description" />
                    <TextBlock Grid.Column="3" Style="{StaticResource HeadText}" Text="Modified" />
                </Grid>
                <ListBox
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    ItemTemplate="{StaticResource FileRow}"
                    ItemContainerStyle="{StaticResource StyleListItem}"
                    Background="{StaticResource GhCanvas}"
                    BorderBrush="{StaticResource GhBorder}"
                    AutomationProperties.Name="Plot style tables"
                />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
