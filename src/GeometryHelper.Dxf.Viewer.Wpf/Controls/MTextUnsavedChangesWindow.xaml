<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.MTextUnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multiline Text - Unsaved Changes" Width="480" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="6"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <StackPanel>
            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="6,6,0,0" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close, same as Cancel" />
                    <TextBlock Text="Multiline Text - Unsaved Changes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <DockPanel Margin="16,14">
                <Path DockPanel.Dock="Left" Data="M12 3 2 21h20zM12 10v5M12 18h.01" Stroke="{StaticResource GhWarn}" StrokeThickness="1.8" Width="28" Height="28"
                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0" />
                <TextBlock Text="Do you want to save your text changes?" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GhAccent}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <!-- As AutoCAD's: the checkbox on the left, Yes (taken by Enter), No and Cancel (taken by Esc) on the right. -->
            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="0,0,6,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="YesButton" Style="{StaticResource StylePrimaryButton}" Content="Yes" Padding="22,5" Margin="0,0,8,0" Click="OnYes" IsDefault="True" />
                        <Button Style="{StaticResource GhDialogButton}" Content="No" Padding="18,5" Margin="0,0,8,0" Click="OnNo" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="AlwaysBox" Style="{StaticResource GhCheckBox}" IsChecked="{Binding AlwaysPerform, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Always perform my current choice" VerticalAlignment="Center" MouseLeftButtonDown="OnAlwaysText" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
