<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.LoadLinetypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Load or Reload Linetypes" Width="560" Height="460" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Load or Reload Linetypes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="OK" Padding="18,5" Margin="0,0,6,0" Click="OnOk" IsDefault="True" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource GhWarn}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- The file: one of the support folders' .lin files or the presenter's own set, or another by File... -->
            <Border DockPanel.Dock="Top" Padding="16,12,16,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="File:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhDialogButton}" Content="File..." Margin="8,0,0,0" Click="OnBrowse" />
                    <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Files}" SelectedItem="{Binding File, Mode=TwoWay}"
                              FontFamily="{StaticResource GhMonoFont}" ToolTip="The .lin file the linetypes are read from: one found, or one chosen by File..." />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="16,0,16,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Content="Select all" Padding="8,2" Command="{Binding SelectAllCommand}" />
                    <TextBlock Text="Available Linetypes" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Margin="16,0,16,12" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Background="{StaticResource GhInput}">
                <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GhText}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LoadLinetypeRowViewModel}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource GhCheckBox}" IsChecked="{Binding IsChosen, Mode=TwoWay}" IsEnabled="{Binding CanLoad}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource GhMonoFont}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
