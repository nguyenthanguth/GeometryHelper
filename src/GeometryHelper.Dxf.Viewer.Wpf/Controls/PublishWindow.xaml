<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PublishWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Publish"
    Width="800"
    Height="640"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- Publish, which PUBLISH opens (AutoCAD 2021's Publish dialog): the sheet list (Sheet Name, Page Setup, Status) with Add Sheets, Remove, Remove All, Move Up, Move Down, Load List and Save List at its right; what is included when sheets are added; where the sheets go, one PDF or a PDF each, copies, folder and file name. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- A column heading of the sheet list. -->
            <Style x:Key="ColumnHead" TargetType="TextBlock">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: how many sheets are listed, or what is wrong; then Publish, Cancel and Help. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Publish"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnPublish"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button Style="{StaticResource GhDialogButton}" Content="Help" Padding="14,5" Click="OnHelp" />
                    </StackPanel>
                    <TextBlock
                        x:Name="Notice"
                        Text="{Binding Message}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,12,0"
                        ToolTip="{Binding Message}"
                    >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                        <Setter Property="Foreground" Value="#F26B3A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <Grid Height="270">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>

                    <!-- The sheet list: its name (edited in place), the page setup it is plotted with, and its status. -->
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Sheets to publish">
                        <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ColumnHead}" Text="Sheet Name" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHead}" Text="Page Setup" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHead}" Text="Status" />
                                </Grid>
                                <ListBox
                                    x:Name="Sheets"
                                    ItemsSource="{Binding Rows}"
                                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource SetupRow}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Sheets to publish"
                                >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PublishSheetRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="96" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Style="{StaticResource BlockBox}"
                                                    Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    Margin="4,2"
                                                    AutomationProperties.Name="Sheet name"
                                                    GotKeyboardFocus="OnRowFocus"
                                                />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Style="{StaticResource GhComboBox}"
                                                    Margin="4,2"
                                                    ItemsSource="{Binding PageSetupChoices}"
                                                    SelectedItem="{Binding PageSetupChoice, Mode=TwoWay}"
                                                    AutomationProperties.Name="Page setup"
                                                    GotKeyboardFocus="OnRowFocus"
                                                />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding Status}"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource GhTextMuted}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Status}"
                                                />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </HeaderedContentControl>

                    <StackPanel Grid.Column="2" Margin="0,20,0,0">
                        <Button Style="{StaticResource SideButton}" Content="Add Sheets…" Click="OnAddSheets" />
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Remove"
                            Click="OnRemove"
                            IsEnabled="{Binding CanRemove}"
                        />
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Remove All"
                            Click="OnRemoveAll"
                            IsEnabled="{Binding HasSheets}"
                        />
                        <Border Height="6" />
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Move Up"
                            Click="OnMoveUp"
                            IsEnabled="{Binding CanMoveUp}"
                        />
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Move Down"
                            Click="OnMoveDown"
                            IsEnabled="{Binding CanMoveDown}"
                        />
                        <Border Height="6" />
                        <Button Style="{StaticResource SideButton}" Content="Load List…" Click="OnLoadList" />
                        <Button
                            Style="{StaticResource SideButton}"
                            Content="Save List…"
                            Click="OnSaveList"
                            IsEnabled="{Binding HasSheets}"
                        />
                    </StackPanel>
                </Grid>

                <!-- What Add Sheets lists of a drawing. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Include when adding sheets:" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Model"
                        IsChecked="{Binding IncludeModel, Mode=TwoWay}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Layouts"
                        IsChecked="{Binding IncludeLayouts, Mode=TwoWay}"
                        VerticalAlignment="Center"
                    />
                </StackPanel>

                <!-- Where the sheets go. -->
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Publish to" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Publish to:" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource GhComboBox}"
                            Width="260"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding PublishToItems}"
                            SelectedItem="{Binding PublishTo, Mode=TwoWay}"
                            AutomationProperties.Name="Publish to"
                        />

                        <TextBlock Grid.Row="2" Text="Number of copies:" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource BlockNumber}"
                            Width="70"
                            HorizontalAlignment="Left"
                            Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsCopiesEnabled}"
                            ToolTip="1 to 99; only a sheet printed has copies"
                            AutomationProperties.Name="Number of copies"
                        />

                        <TextBlock Grid.Row="4" Text="PDF file:" VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            IsEnabled="{Binding IsMultiSheetEnabled}"
                        >
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                GroupName="Sheets"
                                Content="Multi-sheet file"
                                IsChecked="{Binding IsMultiSheet, Mode=TwoWay}"
                                Margin="0,0,20,0"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                GroupName="Sheets"
                                Content="Single-sheet files"
                                IsChecked="{Binding IsSingleSheet, Mode=TwoWay}"
                                Margin="0"
                            />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Text="Output folder:" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource BlockBox}"
                            Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Empty for the folder of the first drawing listed"
                            AutomationProperties.Name="Output folder"
                        />
                        <Button
                            Grid.Row="6"
                            Grid.Column="2"
                            Style="{StaticResource GhDialogButton}"
                            Content="Browse…"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Click="OnBrowseFolder"
                        />

                        <TextBlock Grid.Row="8" Text="File name:" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="8"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource BlockBox}"
                            Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsFileNameEnabled}"
                            ToolTip="{Binding FileNameHint}"
                            AutomationProperties.Name="File name"
                        />
                    </Grid>
                </HeaderedContentControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Publish in background"
                        IsChecked="{Binding PublishInBackground, Mode=TwoWay}"
                        Margin="0,0,24,0"
                        ToolTip="Kept as AutoCAD has it; a publish here runs at once"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Open in viewer when done"
                        IsChecked="{Binding OpenInViewer, Mode=TwoWay}"
                    />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
