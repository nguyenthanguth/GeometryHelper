<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PlotStyleEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="{Binding Title}"
    Width="1200"
    Height="680"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A box of the Table View: small, in the row. -->
            <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource StyleBox}">
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
            </Style>
            <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CellCheck" TargetType="CheckBox" BasedOn="{StaticResource StyleCheck}">
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HeadText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- A swatch of a colour of its own. -->
            <DataTemplate x:Key="Swatch">
                <Border
                    Width="14"
                    Height="14"
                    Margin="0,0,5,0"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    Background="{Binding SwatchRgb, Converter={StaticResource RgbBrush}}"
                    Visibility="{Binding HasColor, Converter={StaticResource Shown}}"
                />
            </DataTemplate>

            <!-- A row of the Table View: every property of a style in a cell. -->
            <DataTemplate x:Key="TableRow" DataType="{x:Type local:PlotStyleRowViewModel}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBox
                        Style="{StaticResource CellBox}"
                        Width="92"
                        Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                        IsReadOnly="{Binding IsNameLocked}"
                        AutomationProperties.Name="Name"
                    />
                    <ContentControl ContentTemplate="{StaticResource Swatch}" Content="{Binding}" />
                    <TextBox
                        Style="{StaticResource CellBox}"
                        Width="112"
                        Text="{Binding Color, UpdateSourceTrigger=LostFocus}"
                        AutomationProperties.Name="Color"
                    />
                    <CheckBox
                        Style="{StaticResource CellCheck}"
                        Width="44"
                        IsChecked="{Binding Dither, Mode=TwoWay}"
                        AutomationProperties.Name="Enable dithering"
                    />
                    <CheckBox
                        Style="{StaticResource CellCheck}"
                        Width="52"
                        IsChecked="{Binding Grayscale, Mode=TwoWay}"
                        AutomationProperties.Name="Convert to grayscale"
                    />
                    <TextBox
                        Style="{StaticResource CellBox}"
                        Width="66"
                        Text="{Binding PhysicalPen, UpdateSourceTrigger=LostFocus}"
                        AutomationProperties.Name="Use assigned pen number"
                    />
                    <TextBox
                        Style="{StaticResource CellBox}"
                        Width="66"
                        Text="{Binding VirtualPen, UpdateSourceTrigger=LostFocus}"
                        AutomationProperties.Name="Virtual pen number"
                    />
                    <TextBox
                        Style="{StaticResource CellBox}"
                        Width="52"
                        Text="{Binding Screening, UpdateSourceTrigger=LostFocus}"
                        AutomationProperties.Name="Screening"
                    />
                    <ComboBox
                        Style="{StaticResource CellCombo}"
                        Width="150"
                        ItemsSource="{x:Static local:PlotStyleChoices.Linetypes}"
                        SelectedItem="{Binding Linetype, Mode=TwoWay}"
                        AutomationProperties.Name="Linetype"
                    />
                    <CheckBox
                        Style="{StaticResource CellCheck}"
                        Width="52"
                        IsChecked="{Binding Adaptive, Mode=TwoWay}"
                        AutomationProperties.Name="Adaptive adjustment"
                    />
                    <ComboBox
                        Style="{StaticResource CellCombo}"
                        Width="128"
                        ItemsSource="{Binding DataContext.LineWeightOptions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        SelectedItem="{Binding LineWeight, Mode=TwoWay}"
                        AutomationProperties.Name="Lineweight"
                    />
                    <ComboBox
                        Style="{StaticResource CellCombo}"
                        Width="132"
                        ItemsSource="{x:Static local:PlotStyleChoices.LineEnds}"
                        SelectedItem="{Binding LineEnd, Mode=TwoWay}"
                        AutomationProperties.Name="Line end style"
                    />
                    <ComboBox
                        Style="{StaticResource CellCombo}"
                        Width="132"
                        ItemsSource="{x:Static local:PlotStyleChoices.LineJoins}"
                        SelectedItem="{Binding LineJoin, Mode=TwoWay}"
                        AutomationProperties.Name="Line join style"
                    />
                    <ComboBox
                        Style="{StaticResource CellCombo}"
                        Width="132"
                        ItemsSource="{x:Static local:PlotStyleChoices.Fills}"
                        SelectedItem="{Binding Fill, Mode=TwoWay}"
                        AutomationProperties.Name="Fill style"
                    />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: what went wrong, then Save As, Cancel and Save and Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Save As…"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnSaveAs"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Save &amp; Close"
                            Padding="14,5"
                            Click="OnSaveAndClose"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhWarn}"
                    />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,0">
                <RadioButton
                    Style="{StaticResource StyleTab}"
                    GroupName="EditorTabs"
                    Content="General"
                    IsChecked="{Binding IsGeneral, Mode=OneWay}"
                    Checked="OnTab"
                />
                <RadioButton
                    Style="{StaticResource StyleTab}"
                    GroupName="EditorTabs"
                    Content="Table View"
                    IsChecked="{Binding IsTableView, Mode=OneWay}"
                    Checked="OnTab"
                />
                <RadioButton
                    Style="{StaticResource StyleTab}"
                    GroupName="EditorTabs"
                    Content="Form View"
                    IsChecked="{Binding IsFormView, Mode=OneWay}"
                    Checked="OnTab"
                />
            </StackPanel>

            <Grid Margin="16,8,16,12">
                <!-- General: the file, its description and the global scale factor. -->
                <StackPanel Visibility="{Binding IsGeneral, Converter={StaticResource Shown}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="File name" Style="{StaticResource StyleLabel}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding FileName}"
                            FontFamily="{StaticResource GhMonoFont}"
                            Margin="0,0,0,6"
                        />
                        <TextBlock Grid.Row="1" Text="Kind" Style="{StaticResource StyleLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Kind}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="Number of styles" Style="{StaticResource StyleLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StyleCountText}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Text="Location" Style="{StaticResource StyleLabel}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding Location}"
                            FontFamily="{StaticResource GhMonoFont}"
                            TextTrimming="CharacterEllipsis"
                        />
                    </Grid>
                    <TextBlock Text="Description" Style="{StaticResource StyleLabel}" Margin="0,0,0,4" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Height="64"
                        TextWrapping="Wrap"
                        AcceptsReturn="False"
                        VerticalContentAlignment="Top"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Description"
                    />
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Non-ISO linetypes"
                        Margin="0,14,0,0"
                    >
                        <StackPanel>
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Apply global scale factor to non-ISO linetypes"
                                IsChecked="{Binding ApplyGlobalScaleFactor, Mode=TwoWay}"
                                Margin="0,0,0,8"
                            />
                            <DockPanel>
                                <TextBlock
                                    Text="Global scale factor"
                                    Style="{StaticResource StyleLabel}"
                                    Width="130"
                                    VerticalAlignment="Center"
                                />
                                <TextBox
                                    Style="{StaticResource StyleBox}"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    Text="{Binding ScaleFactor, UpdateSourceTrigger=LostFocus}"
                                    AutomationProperties.Name="Global scale factor"
                                />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock
                        Margin="0,14,0,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="Dithering, the pen numbers, adaptive adjustment, the fill style and the scale factor are kept in the file; a PDF or an image has no pens, and a filled area is plotted solid."
                    />
                </StackPanel>

                <!-- Table View: a row for each style, a column for each property. -->
                <DockPanel Visibility="{Binding IsTableView, Converter={StaticResource Shown}}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,4">
                        <TextBlock Style="{StaticResource HeadText}" Width="92" Text="Name" />
                        <Border Width="19" />
                        <TextBlock Style="{StaticResource HeadText}" Width="112" Text="Color" />
                        <TextBlock Style="{StaticResource HeadText}" Width="44" Text="Dither" />
                        <TextBlock Style="{StaticResource HeadText}" Width="52" Text="Gray" />
                        <TextBlock Style="{StaticResource HeadText}" Width="66" Text="Pen" />
                        <TextBlock Style="{StaticResource HeadText}" Width="66" Text="Virtual" />
                        <TextBlock Style="{StaticResource HeadText}" Width="52" Text="Screen" />
                        <TextBlock Style="{StaticResource HeadText}" Width="150" Text="Linetype" />
                        <TextBlock Style="{StaticResource HeadText}" Width="52" Text="Adaptive" />
                        <TextBlock Style="{StaticResource HeadText}" Width="128" Text="Lineweight" />
                        <TextBlock Style="{StaticResource HeadText}" Width="132" Text="Line end" />
                        <TextBlock Style="{StaticResource HeadText}" Width="132" Text="Line join" />
                        <TextBlock Style="{StaticResource HeadText}" Width="132" Text="Fill" />
                    </StackPanel>
                    <ListBox
                        ItemsSource="{Binding Rows}"
                        ItemTemplate="{StaticResource TableRow}"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        Background="{StaticResource GhCanvas}"
                        BorderBrush="{StaticResource GhBorder}"
                        Focusable="False"
                        AutomationProperties.Name="Plot styles"
                    />
                </DockPanel>

                <!-- Form View: the styles in a list, the properties of the one chosen. -->
                <Grid Visibility="{Binding IsFormView, Converter={StaticResource Shown}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel
                            DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsNamed, Converter={StaticResource Shown}}"
                        >
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Add Style"
                                Padding="12,4"
                                Margin="0,0,8,0"
                                Click="OnAddStyle"
                                IsEnabled="{Binding CanAddStyle}"
                            />
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Delete Style"
                                Padding="12,4"
                                Click="OnDeleteStyle"
                                IsEnabled="{Binding CanDeleteStyle}"
                            />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Plot styles" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox
                            ItemsSource="{Binding Rows}"
                            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            ItemContainerStyle="{StaticResource StyleListItem}"
                            Background="{StaticResource GhCanvas}"
                            BorderBrush="{StaticResource GhBorder}"
                            AutomationProperties.Name="Plot styles"
                        />
                    </DockPanel>

                    <HeaderedContentControl
                        Grid.Column="2"
                        Style="{StaticResource BlockGroup}"
                        Header="Properties"
                        DataContext="{Binding SelectedRow}"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource StyleLabel}" VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource CellBox}"
                                Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                IsReadOnly="{Binding IsNameLocked}"
                                AutomationProperties.Name="Name"
                            />
                            <TextBlock
                                Grid.Row="1"
                                Text="Description"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource CellBox}"
                                Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                AutomationProperties.Name="Description"
                            />
                            <TextBlock
                                Grid.Row="2"
                                Text="Color"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource Swatch}" Content="{Binding}" />
                                <TextBox
                                    Style="{StaticResource CellBox}"
                                    Width="240"
                                    Text="{Binding Color, UpdateSourceTrigger=LostFocus}"
                                    AutomationProperties.Name="Color"
                                />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Text="Enable dithering"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <CheckBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource CellCheck}"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding Dither, Mode=TwoWay}"
                                AutomationProperties.Name="Enable dithering"
                            />
                            <TextBlock
                                Grid.Row="4"
                                Text="Convert to grayscale"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <CheckBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource CellCheck}"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding Grayscale, Mode=TwoWay}"
                                AutomationProperties.Name="Convert to grayscale"
                            />
                            <TextBlock
                                Grid.Row="5"
                                Text="Use assigned pen number"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource CellBox}"
                                Width="100"
                                HorizontalAlignment="Left"
                                Text="{Binding PhysicalPen, UpdateSourceTrigger=LostFocus}"
                                AutomationProperties.Name="Use assigned pen number"
                            />
                            <TextBlock
                                Grid.Row="6"
                                Text="Virtual pen number"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource CellBox}"
                                Width="100"
                                HorizontalAlignment="Left"
                                Text="{Binding VirtualPen, UpdateSourceTrigger=LostFocus}"
                                AutomationProperties.Name="Virtual pen number"
                            />
                            <TextBlock
                                Grid.Row="7"
                                Text="Screening"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource CellBox}"
                                Width="100"
                                HorizontalAlignment="Left"
                                Text="{Binding Screening, UpdateSourceTrigger=LostFocus}"
                                AutomationProperties.Name="Screening"
                            />
                            <TextBlock
                                Grid.Row="8"
                                Text="Linetype"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource CellCombo}"
                                ItemsSource="{x:Static local:PlotStyleChoices.Linetypes}"
                                SelectedItem="{Binding Linetype, Mode=TwoWay}"
                                AutomationProperties.Name="Linetype"
                            />
                            <TextBlock
                                Grid.Row="9"
                                Text="Adaptive adjustment"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <CheckBox
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource CellCheck}"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding Adaptive, Mode=TwoWay}"
                                AutomationProperties.Name="Adaptive adjustment"
                            />
                            <TextBlock
                                Grid.Row="10"
                                Text="Lineweight"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Row="10"
                                Grid.Column="1"
                                Style="{StaticResource CellCombo}"
                                ItemsSource="{Binding DataContext.LineWeightOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                SelectedItem="{Binding LineWeight, Mode=TwoWay}"
                                AutomationProperties.Name="Lineweight"
                            />
                            <TextBlock
                                Grid.Row="11"
                                Text="Line End Style"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Row="11"
                                Grid.Column="1"
                                Style="{StaticResource CellCombo}"
                                ItemsSource="{x:Static local:PlotStyleChoices.LineEnds}"
                                SelectedItem="{Binding LineEnd, Mode=TwoWay}"
                                AutomationProperties.Name="Line end style"
                            />
                            <TextBlock
                                Grid.Row="12"
                                Text="Line Join Style"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Row="12"
                                Grid.Column="1"
                                Style="{StaticResource CellCombo}"
                                ItemsSource="{x:Static local:PlotStyleChoices.LineJoins}"
                                SelectedItem="{Binding LineJoin, Mode=TwoWay}"
                                AutomationProperties.Name="Line join style"
                            />
                            <TextBlock
                                Grid.Row="13"
                                Text="Fill Style"
                                Style="{StaticResource StyleLabel}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Row="13"
                                Grid.Column="1"
                                Style="{StaticResource CellCombo}"
                                ItemsSource="{x:Static local:PlotStyleChoices.Fills}"
                                SelectedItem="{Binding Fill, Mode=TwoWay}"
                                AutomationProperties.Name="Fill style"
                            />
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
