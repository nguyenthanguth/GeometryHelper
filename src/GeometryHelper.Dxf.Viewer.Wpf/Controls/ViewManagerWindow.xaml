<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.ViewManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="View Manager" Width="900" Height="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NodeRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="View Manager" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhDialogButton}" Content="Apply" Padding="14,5" Margin="0,0,8,0" Click="OnApply" />
                    <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                    <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="14,5" Click="OnOk" IsDefault="True" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Padding="10,8" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource GhAccent}" VerticalAlignment="Top" Margin="0,4,8,0" />
                    <TextBlock Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap"
                               Text="A drawing is 2D here: Preset Views list the six orthographic and four isometric names but stay greyed, and the Camera, Target, Perspective, Lens and Clipping rows are read-only. Update Layers stores the current layer states in the view. Edit Boundaries hides the dialog and asks for two corners. Model views are named views of model space; layout views belong to the layout they were made in." />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Views" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Background="{StaticResource GhInput}" Padding="0,4">
                        <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NodeRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Views">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ViewNodeViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding Indent}" />
                                        <TextBlock Width="14" Text="{Binding Twisty}" Foreground="{StaticResource GhTextMuted}" />
                                        <TextBlock Text="{Binding Name}" Padding="0,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PropertiesTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{StaticResource GhError}" TextWrapping="Wrap" Text="{Binding Message}" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0" IsEnabled="{Binding IsNamedChosen}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource BlockBox}" Text="{Binding ViewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="View name" />
                        <TextBlock Grid.Column="2" Text="Height:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <TextBox Grid.Column="3" Style="{StaticResource BlockNumber}" Text="{Binding ViewHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Height" />
                        <TextBlock Grid.Column="4" Text="Width:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <TextBox Grid.Column="5" Style="{StaticResource BlockNumber}" Text="{Binding ViewWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Width" />
                    </Grid>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewPropertyViewModel}">
                                        <Grid>
                                            <Border x:Name="Head" Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                                <TextBlock Text="{Binding Label}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GhTextMuted}" />
                                            </Border>
                                            <Border x:Name="Line" BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Padding="8,3" Foreground="{StaticResource GhTextMuted}" />
                                                    <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" Padding="8,3" FontFamily="{StaticResource GhMonoFont}" Foreground="{StaticResource GhText}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                <Setter TargetName="Head" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="4" Margin="0,22,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource GhTextMuted}" FontSize="11" TextWrapping="Wrap" Text="On Current or a preset view only New… stays open; the rest grey out." />
                    <StackPanel>
                        <Button Style="{StaticResource StylePrimaryButton}" Content="Set Current" Padding="8,5" Margin="0,0,0,6" Click="OnSetCurrent" IsEnabled="{Binding IsNamedChosen}" />
                        <Button Style="{StaticResource SideButton}" Content="New…" Click="OnNew" />
                        <Button Style="{StaticResource SideButton}" Content="Update Layers" Click="OnUpdateLayers" IsEnabled="{Binding IsNamedChosen}" />
                        <Button Style="{StaticResource SideButton}" Content="Edit Boundaries…" Click="OnEditBoundaries" IsEnabled="{Binding IsNamedChosen}" />
                        <Button Style="{StaticResource SideButton}" Content="Delete" Click="OnDelete" IsEnabled="{Binding IsNamedChosen}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
