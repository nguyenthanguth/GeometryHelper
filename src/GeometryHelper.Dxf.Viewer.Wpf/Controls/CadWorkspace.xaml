<UserControl x:Class="GeometryHelper.Dxf.Viewer.Wpf.CadWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{DynamicResource GhFont}" FontSize="12" Foreground="{DynamicResource GhText}"
             Background="{DynamicResource GhBg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <local:RgbBrushConverter x:Key="RgbBrush" />

            <!-- A big button of the ribbon: its Tag is the icon, its Content the label. -->
            <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button of the ribbon: a 16 pixel icon and its label in a row. -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="0,0,8,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Size="16" StrokeThickness="1.8"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <!-- In a medium panel the label goes, as AutoCAD's: the icon alone, the tooltip still naming the command. -->
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:IconView Size="16" StrokeThickness="1.8"
                                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A small toggle of the ribbon, as the drafting toggles of View: lit while on, as the status bar's are. -->
            <Style x:Key="SmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="0,0,8,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Size="16" StrokeThickness="1.8"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <!-- In a medium panel the icon alone, as View › Drafting's: a toggle on still lit, the tooltip naming it. -->
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:IconView Size="16" StrokeThickness="1.8"
                                                    Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A big toggle of the ribbon, as the panels of View › Interface. -->
            <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The arrow of a split button of the ribbon: a click drops its menu (OnRibbonMenu), as AutoCAD's does. -->
            <Style x:Key="SplitArrow" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,2" />
            </Style>

            <!-- A small button of the ribbon shown by its icon alone, its Content the name its tooltip and screen readers give. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView Size="16" StrokeThickness="1.8"
                                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button whose icon in a medium panel keeps no margin on its right, so that the icons of a column sit close, as Insert's and View's. -->
            <Style x:Key="NarrowSmallButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A button of the row under a group's columns: a 14 pixel icon and its label. -->
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                <Setter Property="Margin" Value="0,2,8,0" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Size="14" StrokeThickness="1.8"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The column of small buttons of a group, three to a column. -->
            <Style x:Key="SmallColumn" TargetType="WrapPanel">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Height" Value="66" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="GroupBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <!-- The big button of a collapsed panel: the panel's icon, its name and ▾, lit while its drop-down is open. -->
            <Style x:Key="CollapsedPanelButton" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="MinWidth" Value="46" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <!-- A title of two words wider than the button, as Block Definition, on two lines. -->
                                <TextBlock Text="{Binding}" Margin="0,2,0,0" HorizontalAlignment="Center" MaxWidth="68" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="▾" Foreground="{StaticResource GhTextMuted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The pin of a drop-down's title bar: pressed, the drop-down stays open. -->
            <Style x:Key="PinToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView Size="13" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconPin}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            A panel of the ribbon (RibbonPanel): its body over its title, a line on its right; collapsed, one big button; its
            drop-down under it with the title bar and the pin, as AutoCAD 2021's panels.
            -->
            <Style TargetType="local:RibbonPanel">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:RibbonPanel">
                            <Grid>
                                <Border x:Name="Host" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Bottom">
                                            <TextBlock x:Name="TitleText" Style="{StaticResource GroupTitle}" Text="{TemplateBinding Title}" Visibility="Collapsed" />
                                            <ContentPresenter x:Name="TitleHeader" Content="{TemplateBinding Header}" HorizontalAlignment="Center" />
                                        </Grid>
                                        <Decorator x:Name="PART_Inline" />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="CollapsedHost" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2,0"
                                        Visibility="Collapsed">
                                    <ToggleButton Style="{StaticResource CollapsedPanelButton}" Content="{TemplateBinding Title}" Tag="{TemplateBinding Icon}"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  AutomationProperties.Name="{TemplateBinding Title}" ToolTip="{TemplateBinding Title}" />
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" Focusable="False"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="0,0,4,4" Margin="0,0,8,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                                        </Border.Effect>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Padding="8,2,8,4">
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource PinToggle}" ToolTip="Pin the panel open"
                                                                  IsChecked="{Binding IsPinned, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                    <Border DockPanel.Dock="Right" Width="20" />
                                                    <TextBlock Style="{StaticResource GroupTitle}" Margin="0" VerticalAlignment="Center" Text="{TemplateBinding Title}" />
                                                </DockPanel>
                                            </Border>
                                            <Decorator x:Name="PART_Dropped" Margin="8,8,8,6" />
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Header" Value="{x:Null}">
                                    <Setter TargetName="TitleText" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TitleHeader" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Size" Value="Collapsed">
                                    <Setter TargetName="Host" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CollapsedHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The top of a big split button: the icon of the command picked last, which it runs. -->
            <Style x:Key="BigSplitTop" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="Padding" Value="6,4,6,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The bottom of a big split button: the name of the command picked last and ▾, which drops the others (OnRibbonMenu). -->
            <Style x:Key="BigSplitArrow" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="4,1,4,3" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <!-- A big split button: its top and its arrow in one frame. -->
            <Style x:Key="BigSplitFrame" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- A box of the ribbon that shows a value: ByLayer, with or without a swatch. -->
            <Style x:Key="ValueBox" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="ToolTip" Value="Not built yet: the lineweight of new objects; set an object's in Properties" />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Background" Value="{StaticResource GhAccent}" />
                <Setter Property="Foreground" Value="{StaticResource GhAccentInk}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
            </Style>

            <!-- The groups of the Plugins tab: a button per command of each plugin loaded, then Manage. -->
            <DataTemplate DataType="{x:Type local:PluginRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Command plugins" />
                            <Grid>
                                <TextBlock Text="No command plugin is loaded.&#x0a;Load .dll adds one." Foreground="{StaticResource GhTextMuted}" Margin="4,8,8,0"
                                           Visibility="{Binding HasCommands, Converter={StaticResource Hidden}}" />
                                <ItemsControl ItemsSource="{Binding Commands}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PluginCommandButton}">
                                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginCommand}" Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                                    IsEnabled="True" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <!-- A command's name is one long word: kept on one line, cut with an ellipsis past 96 pixels. -->
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Manage" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginLoad}" Content="Load .dll" IsEnabled="True" Command="{Binding LoadCommand}" ToolTip="Load a plugin (PLUGINLOAD, NETLOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconRefresh}" Content="Reload" IsEnabled="True" Command="{Binding ReloadCommand}" ToolTip="Load the plugin again from its file (PLUGINRELOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginUnload}" Content="Unload" IsEnabled="True" Command="{Binding UnloadCommand}" ToolTip="Unload the plugin (PLUGINUNLOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginManager}" Content="Plugin manager" IsEnabled="True" Command="{Binding ManagerCommand}" Margin="0" ToolTip="Load, install, unload and trust plugins" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The groups of the Settings tab: Global settings, opened on a category. -->
            <DataTemplate DataType="{x:Type local:SettingsRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Global settings" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconGear}" Content="Options" IsEnabled="True" Command="{Binding OpenCommand}" ToolTip="Global settings (OPTIONS)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPalette}" Content="Appearance" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Appearance" ToolTip="Global settings › Appearance" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Canvas" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Canvas and cursor" ToolTip="Global settings › Canvas and cursor" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconKeyboard}" Content="Shortcuts" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Shortcuts" ToolTip="Global settings › Shortcuts" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconSave}" Content="Save and export" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Save and export" Margin="0" ToolTip="Global settings › Save and export" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The contextual Table Cell tab while cells of a table are selected: its own control (TableCellRibbon). -->
            <DataTemplate DataType="{x:Type local:TableCellViewModel}">
                <local:TableCellRibbon />
            </DataTemplate>

            <!--
            A style box: the combo box's look, opened by a click on it (StyleBox), with no button of its own; its list on the
            header's colour, the current style ticked, a model drawing's marked "model", the dialog's item last under a line. In
            a medium panel the box narrows 118 to 84 and its caption goes, the tooltip still naming what it sets.
            -->
            <Style x:Key="StyleBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource GhBorder}" BorderThickness="0" Padding="10,4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDialog}" Value="True">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,4,0,0" />
                                    <Setter TargetName="Row" Property="Padding" Value="10,6,10,4" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="StyleBoxItemTemplate" DataType="{x:Type local:StyleBoxItemViewModel}">
                <DockPanel>
                    <TextBlock x:Name="Tick" DockPanel.Dock="Left" Width="14" Margin="0,0,6,0" Text="✓" Foreground="{StaticResource GhOk}" Visibility="Hidden" />
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Hint}" Foreground="{StaticResource GhTextMuted}" />
                    <TextBlock Text="{Binding Name}" />
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="StyleBoxChosenTemplate">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <Style x:Key="StyleBoxCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                <Setter Property="local:StyleBox.OpensOnClick" Value="True" />
                <Setter Property="Width" Value="118" />
                <Setter Property="SelectedValuePath" Value="Name" />
                <Setter Property="ItemTemplate" Value="{StaticResource StyleBoxItemTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource StyleBoxItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2" Padding="4,2">
                                    <DockPanel>
                                        <local:IconView DockPanel.Dock="Right" Size="10" StrokeThickness="3" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{StaticResource StyleBoxChosenTemplate}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </DockPanel>
                                </Border>
                                <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False">
                                    <Border Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4" Margin="0,0,8,8"
                                            MinWidth="190" MaxHeight="320">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="84" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StyleBoxLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="36" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- The frame of the text height box of Annotate › Text, as wide as a style box. -->
            <Style x:Key="StyleBoxFrame" TargetType="Border">
                <Setter Property="Width" Value="118" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="4,1" />
                <Style.Triggers>
                    <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                        <Setter Property="Width" Value="84" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
            The contextual Text Editor tab of the MTEXT editor, as the design draws it: Style, Formatting, Paragraph, Insert,
            Spell Check (off: no dictionary ships), Tools, Options and Close. What is not built is greyed with its reason. To fit
            1 600 pixels Spell Check and Tools collapse and Insert becomes a small column; narrower, Options goes small and
            Paragraph collapses. Style, Formatting and Close never shrink, and Close stays the last panel.
            -->
            <DataTemplate DataType="{x:Type local:TextEditorViewModel}">
                <local:RibbonStrip Steps="Spell Check:Collapsed; Tools:Collapsed; Insert:Medium; Options:Medium; Paragraph:Collapsed">
                    <local:RibbonStrip.Resources>
                        <Geometry x:Key="IconStyle">M5 20 12 4l7 16M8 14h8</Geometry>
                        <Geometry x:Key="IconHeight">M4 6V4h10v2M9 4v16M18 6v12M16 8l2-2 2 2M16 16l2 2 2-2</Geometry>
                        <Geometry x:Key="IconMatch">M5 3h10v6H5zM9 9v4M9 13h8v8H9z</Geometry>
                        <Geometry x:Key="IconJustify">M4 4h16v16H4zM7 7h2v2H7z</Geometry>
                        <Geometry x:Key="IconBullets">M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01</Geometry>
                        <Geometry x:Key="IconSpacing">M10 6h10M10 12h10M10 18h10M5 4v16M3 6l2-2 2 2M3 18l2 2 2-2</Geometry>
                        <Geometry x:Key="IconColumns">M4 4h7v16H4zM13 4h7v16h-7z</Geometry>
                        <Geometry x:Key="IconSymbol">M16 12a4 4 0 1 0-1.2 2.9M16 8v5a2 2 0 0 0 4 0v-1a8 8 0 1 0-3 6.2</Geometry>
                        <Geometry x:Key="IconField">M4 6h16v12H4zM8 10h3M8 14h8M14 10h2</Geometry>
                        <Geometry x:Key="IconSpell">M4 17l4-10 4 10M5.5 13h5M14 14l3 3 5-6</Geometry>
                        <Geometry x:Key="IconDictionary">M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11</Geometry>
                        <Geometry x:Key="IconFind">M10 10m-6 0a6 6 0 1 0 12 0a6 6 0 1 0-12 0M14.5 14.5 20 20M7 10h6</Geometry>
                        <Geometry x:Key="IconImport">M12 3v12M7 10l5 5 5-5M4 21h16</Geometry>
                        <Geometry x:Key="IconCaps">M4 18 8 6l4 12M5.5 14h5M14 18l3-12 3 12M15 14h4</Geometry>
                        <Geometry x:Key="IconMore">M5 12h.01M12 12h.01M19 12h.01</Geometry>
                        <Geometry x:Key="IconRuler">M3 8h18v8H3zM7 8v3M11 8v4M15 8v3M19 8v4</Geometry>
                        <Geometry x:Key="IconCloseEditor">M6 6l12 12M18 6 6 18</Geometry>
                        <Geometry x:Key="AlignLeft">M4 6h16M4 10h10M4 14h16M4 18h10</Geometry>
                        <Geometry x:Key="AlignCentre">M4 6h16M7 10h10M4 14h16M7 18h10</Geometry>
                        <Geometry x:Key="AlignRight">M4 6h16M10 10h10M4 14h16M10 18h10</Geometry>
                        <Geometry x:Key="AlignJustify">M4 6h16M4 10h16M4 14h16M4 18h16</Geometry>
                        <Geometry x:Key="AlignDistribute">M4 6h16M4 10h16M4 14h16M4 18h2M11 18h2M18 18h2</Geometry>
                        <!-- B, I, S, U, O: a small framed square, the accent when on. -->
                        <Style x:Key="FormatToggle" TargetType="ToggleButton">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhSelected}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- An alignment: its icon, on the selection's ground when it is the paragraph's. -->
                        <Style x:Key="AlignToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <local:IconView Size="14" StrokeThickness="1.8" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="EditorBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Margin" Value="3,0,6,0" />
                        </Style>
                        <!-- The tab is wide: its big buttons and groups are drawn a little closer than Home's, as the design draws them. -->
                        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="Padding" Value="3,4" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                        </Style>
                        <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource BigToggle}">
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="Padding" Value="3,4" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                        </Style>
                        <!-- A big button that a medium panel draws small, its label kept: Insert's and Options' as the design shrinks them. -->
                        <Style x:Key="AdaptiveButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,0,8,2" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:IconView Size="16" StrokeThickness="1.8" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="AdaptiveToggle" TargetType="ToggleButton" BasedOn="{StaticResource BigToggle}">
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,0,8,2" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:IconView Size="16" StrokeThickness="1.8" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                    <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="EditorMenuButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="{StaticResource GhInput}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </local:RibbonStrip.Resources>

                    <!-- Style: the style, Annotative (off), the height; Mask greyed. -->
                    <local:RibbonPanel Title="Style" MinFullWidth="200" Icon="{StaticResource IconStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconStyle}" Content="{Binding StyleName}" IsEnabled="True" Focusable="False"
                                    ToolTip="The text style of the MTEXT: STYLE changes it" />
                            <StackPanel>
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource IconStyle}" Content="Annotative" ToolTip="Annotative text is not built yet" />
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                    <local:IconView Size="14" StrokeThickness="1.8" Data="{StaticResource IconHeight}" />
                                    <TextBox Style="{StaticResource EditorBox}" Width="64" Text="{Binding HeightText, UpdateSourceTrigger=LostFocus}" ToolTip="Text height" KeyDown="OnEditorBoxKey" />
                                </StackPanel>
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource IconField}" Content="Mask" ToolTip="Background mask is not built yet" />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Formatting: B I S U O, Match (greyed), case, clear, oblique, tracking, width; the font and the colour. -->
                    <local:RibbonPanel Title="Formatting" MinFullWidth="440" Icon="{StaticResource IconMatch}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ToggleButton Style="{StaticResource FormatToggle}" Content="B" FontWeight="Bold" IsChecked="{Binding IsBold, Mode=OneWay}" IsEnabled="{Binding CanBold}"
                                                  Command="{Binding ToggleCommand}" CommandParameter="Bold" ToolTip="Bold  Ctrl+B" />
                                    <ToggleButton Style="{StaticResource FormatToggle}" Content="I" FontStyle="Italic" IsChecked="{Binding IsItalic, Mode=OneWay}" IsEnabled="{Binding CanBold}"
                                                  Command="{Binding ToggleCommand}" CommandParameter="Italic" ToolTip="Italic  Ctrl+I" />
                                    <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsStrikethrough, Mode=OneWay}" Command="{Binding ToggleCommand}" CommandParameter="Strikethrough" ToolTip="Strikethrough">
                                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsUnderline, Mode=OneWay}" Command="{Binding ToggleCommand}" CommandParameter="Underline" ToolTip="Underline  Ctrl+U">
                                        <TextBlock Text="U" TextDecorations="Underline" />
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsOverline, Mode=OneWay}" Command="{Binding ToggleCommand}" CommandParameter="Overline" ToolTip="Overline">
                                        <TextBlock Text="O" TextDecorations="OverLine" />
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource IconMatch}" Content="Match" Margin="0,0,6,0" ToolTip="Match Text Formatting is not built yet" />
                                    <Button Style="{StaticResource EditorMenuButton}" Content="aA ▾" FontWeight="SemiBold" Tag="Case" Click="OnEditorMenu" ToolTip="Change Case" />
                                    <Button Style="{StaticResource EditorMenuButton}" Content="Clear ▾" Foreground="{StaticResource GhTextMuted}" Tag="Clear" Click="OnEditorMenu" ToolTip="Remove Character Formatting" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Oblique" Foreground="{StaticResource GhTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource EditorBox}" Text="{Binding ObliqueText, UpdateSourceTrigger=LostFocus}" ToolTip="Oblique angle" KeyDown="OnEditorBoxKey" />
                                    <TextBlock Text="Tracking" Foreground="{StaticResource GhTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource EditorBox}" Text="{Binding TrackingText, UpdateSourceTrigger=LostFocus}" ToolTip="Tracking" KeyDown="OnEditorBoxKey" />
                                    <TextBlock Text="Width" Foreground="{StaticResource GhTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource EditorBox}" Text="{Binding WidthFactorText, UpdateSourceTrigger=LostFocus}" ToolTip="Width factor" KeyDown="OnEditorBoxKey" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Width="128" Margin="4,0,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Left" Background="#1F4E79" CornerRadius="3" Padding="4,0" Margin="0,0,4,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsShxFont, Converter={StaticResource Shown}}">
                                        <TextBlock Text="SHX" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font, Mode=TwoWay}" Focusable="False" ToolTip="Font"
                                              FontFamily="{StaticResource GhMonoFont}" FontSize="11" />
                                </DockPanel>
                                <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor, Mode=TwoWay}" Focusable="False" ToolTip="Color"
                                          Margin="0,0,0,4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TextEditorChoice}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" BorderBrush="#5B6573" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Style="{StaticResource ValueBox}" ToolTip="Background mask is not built yet">
                                    <TextBlock Text="Background mask…" Foreground="{StaticResource GhTextMuted}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Paragraph: justification and line spacing menus, bullets greyed, the five alignments. -->
                    <local:RibbonPanel Title="Paragraph" MinFullWidth="250" MinCollapsedWidth="80" Icon="{StaticResource IconJustify}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconJustify}" Content="Justification ▾" IsEnabled="True" Focusable="False"
                                    Click="OnEditorMenu" CommandParameter="Justification" ToolTip="Justification of the MTEXT: TL to BR" />
                            <StackPanel>
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource IconBullets}" Content="Bullets and Numbering ▾" ToolTip="Bullets and numbering are not built yet" />
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource IconSpacing}" Content="Line Spacing ▾" IsEnabled="True" Focusable="False"
                                        Click="OnEditorMenu" CommandParameter="LineSpacing" ToolTip="Line spacing of the MTEXT" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource AlignToggle}" Tag="{StaticResource AlignLeft}" Command="{Binding AlignCommand}" CommandParameter="l" ToolTip="Left"
                                                  IsChecked="{Binding IsAlignedLeft, Mode=OneWay}" />
                                    <ToggleButton Style="{StaticResource AlignToggle}" Tag="{StaticResource AlignCentre}" Command="{Binding AlignCommand}" CommandParameter="c" ToolTip="Centre"
                                                  IsChecked="{Binding IsAlignedCentre, Mode=OneWay}" />
                                    <ToggleButton Style="{StaticResource AlignToggle}" Tag="{StaticResource AlignRight}" Command="{Binding AlignCommand}" CommandParameter="r" ToolTip="Right"
                                                  IsChecked="{Binding IsAlignedRight, Mode=OneWay}" />
                                    <ToggleButton Style="{StaticResource AlignToggle}" Tag="{StaticResource AlignJustify}" Command="{Binding AlignCommand}" CommandParameter="j" ToolTip="Justify"
                                                  IsChecked="{Binding IsJustified, Mode=OneWay}" />
                                    <ToggleButton Style="{StaticResource AlignToggle}" Tag="{StaticResource AlignDistribute}" Command="{Binding AlignCommand}" CommandParameter="d" ToolTip="Distribute"
                                                  IsChecked="{Binding IsDistributed, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Insert: Columns and Field greyed, the Symbol menu; medium, a column of small buttons. -->
                    <local:RibbonPanel Title="Insert" MinFullWidth="222" MinMediumWidth="104" Icon="{StaticResource IconSymbol}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource IconColumns}" Content="Columns ▾" ToolTip="Columns are not built yet" />
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource IconSymbol}" Content="Symbol ▾" IsEnabled="True" Focusable="False"
                                    Click="OnEditorMenu" CommandParameter="Symbol" ToolTip="Insert a symbol" />
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource IconField}" Content="Field" ToolTip="Fields are not built yet" />
                        </WrapPanel>
                    </local:RibbonPanel>

                    <!-- Spell Check: off, no dictionary ships with the app; it collapses first. -->
                    <local:RibbonPanel Title="Spell Check" MinFullWidth="132" MinCollapsedWidth="76" Icon="{StaticResource IconSpell}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconSpell}" Content="Spell Check off" ToolTip="No dictionary ships with the app" />
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconDictionary}" Content="Edit Dictionaries" Margin="0" ToolTip="No dictionary ships with the app" />
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Tools: Find and Replace in the words; Import Text and AutoCAPS greyed. -->
                    <local:RibbonPanel Title="Tools" MinFullWidth="216" MinCollapsedWidth="60" Icon="{StaticResource IconFind}">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ToggleButton Style="{StaticResource BigToggle}" Tag="{StaticResource IconFind}" Content="Find &amp; Replace" Focusable="False"
                                              IsChecked="{Binding IsFindShown, Mode=TwoWay}" ToolTip="Find and replace in the words" />
                                <Popup IsOpen="{Binding IsFindShown, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Width="280">
                                        <StackPanel>
                                            <TextBlock Text="Find what" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,2" />
                                            <TextBox Style="{StaticResource GhTextBox}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                            <TextBlock Text="Replace with" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,2" />
                                            <TextBox Style="{StaticResource GhTextBox}" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                            <CheckBox Style="{StaticResource GhCheckBox}" Content="Match case" IsChecked="{Binding MatchCase}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GhDialogButton}" Content="Find Next" Padding="10,3" Margin="0,0,6,0" Command="{Binding FindNextCommand}" />
                                                <Button Style="{StaticResource GhDialogButton}" Content="Replace All" Padding="10,3" Command="{Binding ReplaceAllCommand}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding FindMessage}" Foreground="{StaticResource GhTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconImport}" Content="Import Text" ToolTip="Importing text from a file is not built yet" />
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconCaps}" Content="AutoCAPS" Margin="0" ToolTip="AutoCAPS is not built yet" />
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Options: More greyed, the ruler, the editor's undo and redo; medium, small buttons. -->
                    <local:RibbonPanel Title="Options" MinFullWidth="250" MinMediumWidth="150" Icon="{StaticResource IconMore}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource IconMore}" Content="More ▾" ToolTip="Character set, editor settings: not built yet" />
                            <ToggleButton Style="{StaticResource AdaptiveToggle}" Tag="{StaticResource IconRuler}" Content="Ruler" IsChecked="{Binding IsRulerShown, Mode=TwoWay}" Focusable="False" ToolTip="Show or hide the ruler" />
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource GhIconUndo}" Content="Undo" IsEnabled="{Binding CanUndo}" Command="{Binding UndoCommand}" Focusable="False" ToolTip="Undo  Ctrl+Z" />
                            <Button Style="{StaticResource AdaptiveButton}" Tag="{StaticResource GhIconRedo}" Content="Redo" IsEnabled="{Binding CanRedo}" Command="{Binding RedoCommand}" Focusable="False" ToolTip="Redo  Ctrl+Y" />
                        </WrapPanel>
                    </local:RibbonPanel>

                    <!-- Close: the words kept; it never shrinks and stays the last panel. -->
                    <local:RibbonPanel Title="Close" MinFullWidth="84" Icon="{StaticResource IconCloseEditor}" BorderThickness="0">
                        <Button Style="{StaticResource BigButton}" Content="Close Text Editor" IsEnabled="True" Command="{Binding CloseCommand}" Focusable="False" Margin="0"
                                ToolTip="Close the editor, keeping the words  Ctrl+Enter">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center" Stroke="#F26B3A"
                                                        Data="{StaticResource IconCloseEditor}" />
                                        <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            Insert, as AutoCAD 2021's for what the presenter has built: Block (Insert with its gallery, Edit Attribute), Block
            Definition (Create Block, Define Attributes, Set Base Point) and Reference (Attach, Clip, External References, the
            image frame box, Transparency); what is not built greyed with its reason. All full down to a window 876 wide;
            narrower, Reference and Block Definition go medium, then collapse. Block never shrinks.
            -->
            <DataTemplate DataType="{x:Type local:InsertRibbonViewModel}">
                <local:RibbonStrip Steps="Reference:Medium; Block Definition:Medium; Reference:Collapsed; Block Definition:Collapsed">
                    <local:RibbonStrip.Resources>
                        <!-- The label of a split's arrow, in the 11 pixels of the design, two lines where it is long, as Edit Attribute ▾. -->
                        <Style x:Key="SplitLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="BigSplitArrow" TargetType="Button" BasedOn="{StaticResource BigSplitArrow}">
                            <Setter Property="Padding" Value="2,1,2,3" />
                        </Style>
                        <!-- The image frame box: a style box 128 wide, 88 in a medium panel, after its icon. -->
                        <Style x:Key="FrameBoxCombo" TargetType="ComboBox" BasedOn="{StaticResource StyleBoxCombo}">
                            <Setter Property="Width" Value="128" />
                            <Style.Triggers>
                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                    <Setter Property="Width" Value="88" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- A line of the gallery under its tiles: the name, the command it starts on the right. -->
                        <Style x:Key="GalleryLine" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource GhMonoFont}"
                                                       FontSize="10" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </local:RibbonStrip.Resources>

                    <!-- Block: Insert (the Blocks palette) with the gallery under its arrow, and Edit Attribute's split. It never shrinks. -->
                    <local:RibbonPanel Title="Block" MinFullWidth="136" Icon="{StaticResource GhIconInsertBlock}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="InsertSplit" Style="{StaticResource BigSplitFrame}" Width="56" Margin="0,0,3,0">
                                <StackPanel>
                                    <Button Style="{StaticResource BigSplitTop}" MinWidth="0" Tag="{StaticResource GhIconInsertBlock}" Content="Insert" IsEnabled="{Binding Model.HasDocument}"
                                            Command="{Binding Model.StartCommandCommand}" CommandParameter="INSERT" ToolTip="Insert: the Blocks palette (INSERT)" />
                                    <Button Style="{StaticResource BigSplitArrow}" IsEnabled="{Binding Model.HasDocument}" Command="{Binding OpenGalleryCommand}"
                                            AutomationProperties.Name="Insert gallery" ToolTip="The blocks of the drawing; Recent Blocks, Blocks from Other Drawings">
                                        <TextBlock Style="{StaticResource SplitLabel}" Text="Insert ▾" />
                                    </Button>
                                    <!-- The gallery: a tile per block of the drawing, a click inserting it; then the palette's other tabs. -->
                                    <Popup IsOpen="{Binding IsGalleryOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                           PlacementTarget="{Binding ElementName=InsertSplit}">
                                        <Border Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,6,0,4" Margin="0,0,8,8" Width="320">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="{Binding GalleryTitle}" Margin="10,0,10,6" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GhTextMuted}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="No blocks in this drawing" Margin="10,4,10,10" Foreground="{StaticResource GhTextMuted}"
                                                           Visibility="{Binding HasGallery, Converter={StaticResource Hidden}}" />
                                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="10,0,10,8" Visibility="{Binding HasGallery, Converter={StaticResource Shown}}">
                                                    <ItemsControl ItemsSource="{Binding Gallery}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="3" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:BlockTileViewModel}">
                                                                <Button Style="{StaticResource GhFlatButton}" Margin="0,0,6,6" Padding="2,4" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                                                        Background="{StaticResource GhInput}" Command="{Binding DataContext.InsertBlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding Name}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                                                                    <StackPanel>
                                                                        <Border Width="72" Height="48" Background="Black" CornerRadius="2" HorizontalAlignment="Center">
                                                                            <Image Source="{Binding Picture}" Stretch="Uniform" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding DisplayName}" Margin="0,3,0,0" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" MaxWidth="80"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Padding="0,3,0,0">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource GalleryLine}" Content="Recent Blocks…" Tag="INSERT" Command="{Binding OpenPaletteCommand}" CommandParameter="Recent"
                                                                ToolTip="The Blocks palette on its Recent tab (INSERT)" />
                                                        <Button Style="{StaticResource GalleryLine}" Content="Favorite Blocks…" Tag="not offered" IsEnabled="False"
                                                                ToolTip="Favorite Blocks: not offered, the palette has no Favorites tab" />
                                                        <Button Style="{StaticResource GalleryLine}" Content="Blocks from Other Drawings…" Tag="INSERT" Command="{Binding OpenPaletteCommand}" CommandParameter="Other drawing"
                                                                ToolTip="The Blocks palette on its Other drawing tab (INSERT)" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BigSplitFrame}" Width="64" Margin="0">
                                <StackPanel>
                                    <Button Style="{StaticResource BigSplitTop}" MinWidth="0" Tag="{StaticResource GhIconEditAttribute}" Content="Single" IsEnabled="{Binding Model.HasDocument}"
                                            Command="{Binding Model.StartCommandCommand}" CommandParameter="EATTEDIT" ToolTip="Edit Attribute: Single (EATTEDIT)" />
                                    <Button Style="{StaticResource BigSplitArrow}" IsEnabled="{Binding Model.HasDocument}" Click="OnRibbonMenu" AutomationProperties.Name="Edit Attribute"
                                            ToolTip="Single, Edit Attributes">
                                        <TextBlock Style="{StaticResource SplitLabel}" Text="Edit Attribute ▾" />
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Single" Tag="{StaticResource GhIconEditAttribute}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="EATTEDIT" ToolTip="Edit Attribute: Single (EATTEDIT)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Edit Attributes…" Tag="{StaticResource GhIconEditAttribute}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="ATTEDIT" ToolTip="Edit Attributes (ATTEDIT)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Multiple" IsEnabled="False" ToolTip="Multiple (-ATTEDIT, the global edit): not offered" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!-- Block Definition: Create Block's split (BLOCK, WBLOCK), Define Attributes, and Set Base Point; Manage Attributes and Block Editor greyed. -->
                    <local:RibbonPanel Title="Block Definition" MinFullWidth="284" MinMediumWidth="170" MinCollapsedWidth="76" Icon="{StaticResource GhIconCreateBlock}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}" Width="60">
                                <StackPanel>
                                    <Button Style="{StaticResource BigSplitTop}" MinWidth="0" Tag="{StaticResource GhIconCreateBlock}" Content="Create Block" IsEnabled="{Binding Model.HasDocument}"
                                            Command="{Binding Model.StartCommandCommand}" CommandParameter="BLOCK" ToolTip="Create Block (BLOCK)" />
                                    <Button Style="{StaticResource BigSplitArrow}" IsEnabled="{Binding Model.HasDocument}" Click="OnRibbonMenu" AutomationProperties.Name="Create Block or Write Block"
                                            ToolTip="Create Block, Write Block">
                                        <TextBlock Style="{StaticResource SplitLabel}" Text="Create Block ▾" />
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Create Block" Tag="{StaticResource GhIconCreateBlock}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="BLOCK" ToolTip="Create Block (BLOCK)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Write Block" Tag="{StaticResource GhIconWriteBlock}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="WBLOCK" ToolTip="Write Block (WBLOCK)" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource BigButton}" Width="64" MinWidth="0" Padding="2,4" Tag="{StaticResource GhIconDefineAttributes}" Content="Define Attributes"
                                    IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="ATTDEF" ToolTip="Define Attributes (ATTDEF)" />
                            <StackPanel Margin="0,2,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconManageAttributes}" Content="Manage Attributes" Opacity="0.5" ToolTip="Manage Attributes (BATTMAN): not offered" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconBlockEditor}" Content="Block Editor" Opacity="0.5" ToolTip="Block Editor (BEDIT): not offered" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconBasePoint}" Content="Set Base Point" IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}" CommandParameter="BASE" ToolTip="Set Base Point (BASE)" />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>

                    <!--
                    Reference: Attach's split (XATTACH, IMAGEATTACH; the formats not built greyed), Clip (IMAGECLIP), External
                    References (the palette), the image frame box (IMAGEFRAME) and Transparency; Adjust, Underlay Layers and Snap to
                    Underlays greyed: no underlays are built.
                    -->
                    <local:RibbonPanel Title="Reference" MinFullWidth="432" MinMediumWidth="276" MinCollapsedWidth="64" Icon="{StaticResource GhIconAttach}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}" Width="56">
                                <StackPanel>
                                    <Button Style="{StaticResource BigSplitTop}" MinWidth="0" Tag="{StaticResource GhIconAttach}" Content="Attach DXF…" IsEnabled="{Binding Model.HasDocument}"
                                            Command="{Binding Model.StartCommandCommand}" CommandParameter="XATTACH" ToolTip="Attach DXF (XATTACH)" />
                                    <Button Style="{StaticResource BigSplitArrow}" IsEnabled="{Binding Model.HasDocument}" Click="OnRibbonMenu" AutomationProperties.Name="Attach"
                                            ToolTip="Attach DXF, Attach Image">
                                        <TextBlock Style="{StaticResource SplitLabel}" Text="Attach ▾" />
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach DXF…" Tag="{StaticResource GhIconAttach}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="XATTACH" ToolTip="Attach DXF (XATTACH)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach Image…" Tag="{StaticResource GhIconAttach}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="IMAGEATTACH" ToolTip="Attach Image (IMAGEATTACH)" />
                                                <Separator Style="{StaticResource GhMenuSeparator}" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach DWG…" IsEnabled="False" ToolTip="Attach DWG: not offered" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach DWF…" IsEnabled="False" ToolTip="Attach DWF: not offered" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach DGN…" IsEnabled="False" ToolTip="Attach DGN: not offered" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach PDF…" IsEnabled="False" ToolTip="Attach PDF: not offered" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach Point Cloud…" IsEnabled="False" ToolTip="Attach Point Cloud: not offered" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Attach Coordination Model…" IsEnabled="False" ToolTip="Attach Coordination Model: not offered" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconClip}" Content="Clip" IsEnabled="{Binding Model.HasDocument}"
                                    Command="{Binding Model.StartCommandCommand}" CommandParameter="IMAGECLIP" ToolTip="Clip an image (IMAGECLIP); a DXF reference cannot be clipped yet" />
                            <StackPanel Margin="0,2,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconExternalReferences}" Content="External References" IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}" CommandParameter="EXTERNALREFERENCES" ToolTip="External References palette (ER)" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconAdjust}" Content="Adjust" Opacity="0.5" ToolTip="Adjust (ADJUST): not offered" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconUnderlayLayers}" Content="Underlay Layers" Opacity="0.5" ToolTip="Underlay Layers (ULAYERS): not offered" />
                            </StackPanel>
                            <StackPanel Margin="6,2,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,2" IsEnabled="{Binding Model.HasDocument}">
                                    <local:IconView Size="14" StrokeThickness="1.8" Data="{StaticResource GhIconImageFrame}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <ComboBox Style="{StaticResource FrameBoxCombo}" ItemsSource="{Binding Model.ImageFrameItems}" SelectedValue="{Binding Model.CurrentImageFrame, Mode=TwoWay}"
                                              AutomationProperties.Name="Image frames" ToolTip="Image frames (IMAGEFRAME)" />
                                </StackPanel>
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconTransparency}" Content="Transparency" IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandCommand}" CommandParameter="TRANSPARENCY" ToolTip="Background transparency of an image (TRANSPARENCY)" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconSnapUnderlay}" Content="Snap to Underlays" Opacity="0.5" ToolTip="Snap to Underlays: not offered" />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            The panels of the Annotate tab: Text, Dimensions, Leaders, each button starting its command as Home's do. All full
            down to a window 1 016 wide; narrower, Leaders, Text and Dimensions go medium (captions gone, style boxes 84 wide,
            the small buttons of Dimensions by their icons), then Leaders and Text collapse. Dimensions never collapses.
            -->
            <DataTemplate DataType="{x:Type local:AnnotateRibbonViewModel}">
                <local:RibbonStrip Steps="Leaders:Medium; Text:Medium; Dimensions:Medium; Leaders:Collapsed; Text:Collapsed">
                    <local:RibbonPanel Title="Text" MinFullWidth="300" MinMediumWidth="220" MinCollapsedWidth="56" Icon="{StaticResource GhIconMText}">
                        <StackPanel Orientation="Horizontal">
                            <!-- The big buttons 56 wide, their labels on two lines, as the design draws them. -->
                            <Button Style="{StaticResource BigButton}" Width="56" Padding="3,4" Tag="{StaticResource GhIconMText}" Content="Multiline Text" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="MTEXT" ToolTip="MTEXT" />
                            <Button Style="{StaticResource BigButton}" Width="56" Padding="3,4" Tag="{StaticResource GhIconText}" Content="Single Line" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT" Margin="0" />
                            <!-- The current text style ($TEXTSTYLE), its last item the Text Style dialog, and the height TEXT offers. -->
                            <StackPanel Margin="2,2,0,0" IsEnabled="{Binding Model.HasDocument}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                    <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.TextStyleItems}" SelectedValue="{Binding Model.CurrentTextStyle, Mode=TwoWay}"
                                              ToolTip="Text style (STYLE)" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Height" />
                                    <Border Style="{StaticResource StyleBoxFrame}">
                                        <TextBox Style="{StaticResource GhTextBox}" FontFamily="{StaticResource GhMonoFont}" Text="{Binding Model.TextHeight, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Text height of the next Single Line text (TEXT, MTEXT)" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <!--
                    Dimensions as AutoCAD 2021's: the type split showing the type used last; Quick, the Continue and Baseline split,
                    Adjust Space and Break; the style; and the title's slide-out with Oblique and Text Angle (DIMEDIT).
                    -->
                    <local:RibbonPanel Title="Dimensions" MinFullWidth="452" MinMediumWidth="236" Icon="{StaticResource GhIconDimension}">
                        <local:RibbonPanel.Header>
                            <ToggleButton Style="{StaticResource GhStatusToggle}" Foreground="{StaticResource GhTextMuted}" Padding="4,0" Margin="0,4,0,0" Focusable="False"
                                          IsEnabled="{Binding Model.HasDocument}" Content="Dimensions ▾" FontSize="11" ToolTip="More of Dimensions: Oblique, Text Angle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=local:RibbonPanel}, Mode=TwoWay}" />
                        </local:RibbonPanel.Header>
                        <local:RibbonPanel.SlideOut>
                            <StackPanel Width="260">
                                <Button Style="{StaticResource GhFlatButton}" Padding="4,3" Margin="0,0,0,2" HorizontalContentAlignment="Stretch" IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandWithOptionCommand}" CommandParameter="DIMEDIT O" ToolTip="Oblique (DIMEDIT, Oblique)">
                                    <DockPanel>
                                        <local:IconView DockPanel.Dock="Left" Size="16" StrokeThickness="1.8" Data="{StaticResource GhIconDimOblique}" />
                                        <TextBlock DockPanel.Dock="Right" Text="DIMEDIT O" FontFamily="{StaticResource GhMonoFont}" FontWeight="Normal" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Oblique" Margin="8,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource GhFlatButton}" Padding="4,3" HorizontalContentAlignment="Stretch" IsEnabled="{Binding Model.HasDocument}"
                                        Command="{Binding Model.StartCommandWithOptionCommand}" CommandParameter="DIMEDIT R" ToolTip="Text Angle (DIMEDIT, Rotate)">
                                    <DockPanel>
                                        <local:IconView DockPanel.Dock="Left" Size="16" StrokeThickness="1.8" Data="{StaticResource GhIconDimTextAngle}" />
                                        <TextBlock DockPanel.Dock="Right" Text="DIMEDIT R" FontFamily="{StaticResource GhMonoFont}" FontWeight="Normal" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Text Angle" Margin="8,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </local:RibbonPanel.SlideOut>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BigSplitFrame}">
                                <StackPanel>
                                    <Button Style="{StaticResource BigSplitTop}" Tag="{StaticResource GhIconDimension}" Content="Linear" IsEnabled="{Binding Model.HasDocument}"
                                            Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="Linear (DIMLINEAR)" />
                                    <Button Style="{StaticResource BigSplitArrow}" Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}" ContentStringFormat="{}{0} ▾"
                                            IsEnabled="{Binding Model.HasDocument}" Click="OnRibbonMenu" ToolTip="Linear, Aligned, Angular, Radius, Diameter">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Linear" Tag="{StaticResource GhIconDimension}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="Linear (DIMLINEAR)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Aligned" Tag="{StaticResource GhIconAligned}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMALIGNED" ToolTip="Aligned (DIMALIGNED)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Angular" Tag="{StaticResource GhIconAngular}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMANGULAR" ToolTip="Angular (DIMANGULAR)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Radius" Tag="{StaticResource GhIconRadius}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMRADIUS" ToolTip="Radius (DIMRADIUS)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Diameter" Tag="{StaticResource GhIconDiameter}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMDIAMETER" ToolTip="Diameter (DIMDIAMETER)" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconQuickDim}" Content="Quick" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="QDIM" ToolTip="Quick dimension (QDIM)" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconDimContinue}" Content="Continue" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMCONTINUE" ToolTip="Continue (DIMCONTINUE)" />
                                    <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding Model.HasDocument}" Click="OnRibbonMenu" ToolTip="Continue, Baseline">
                                        <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Continue" Tag="{StaticResource GhIconDimContinue}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMCONTINUE" ToolTip="Continue (DIMCONTINUE)" />
                                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Baseline" Tag="{StaticResource GhIconDimBaseline}" Click="OnSplitChoice" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMBASELINE" ToolTip="Baseline (DIMBASELINE)" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconDimSpace}" Content="Adjust Space" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMSPACE" ToolTip="Adjust Space (DIMSPACE)" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconDimBreak}" Content="Break" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMBREAK" ToolTip="Dimension break (DIMBREAK)" />
                            </WrapPanel>
                            <!-- The current dimension style ($DIMSTYLE), its last item the Dimension Style Manager. -->
                            <StackPanel Orientation="Horizontal" Margin="6,2,0,0" VerticalAlignment="Top" IsEnabled="{Binding Model.HasDocument}">
                                <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.DimStyleItems}" SelectedValue="{Binding Model.CurrentDimStyle, Mode=TwoWay}"
                                          ToolTip="Dimension style (DIMSTYLE)" />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Leaders" MinFullWidth="240" MinMediumWidth="162" MinCollapsedWidth="64" Icon="{StaticResource GhIconLeader}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Width="62" Padding="1,4" Tag="{StaticResource GhIconLeader}" Content="Multileader" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="MLEADER" ToolTip="MLEADER" Margin="0" />
                            <!-- The current multileader style (CMLEADERSTYLE), opened where the drawing has multileader styles. -->
                            <StackPanel Orientation="Horizontal" Margin="2,2,0,0" VerticalAlignment="Top" IsEnabled="{Binding Model.HasMLeaderStyles}">
                                <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.MLeaderStyleItems}" SelectedValue="{Binding Model.CurrentMLeaderStyle, Mode=TwoWay}"
                                          ToolTip="Multileader style (CMLEADERSTYLE)" />
                            </StackPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <!--
            The panels of the View tab: Navigate, Views, Interface and the drafting toggles of the status bar. All full down to a
            window 694 wide; narrower, Drafting and Navigate draw their small buttons by their icons, then Interface and Views
            collapse. Navigate and Drafting never collapse.
            -->
            <DataTemplate DataType="{x:Type local:ViewRibbonViewModel}">
                <local:RibbonStrip Steps="Drafting:Medium; Navigate:Medium; Interface:Collapsed; Views:Collapsed">
                    <local:RibbonPanel Title="Navigate" MinFullWidth="250" MinMediumWidth="128" Icon="{StaticResource GhIconExtents}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Extents" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM E" ToolTip="ZOOM Extents" />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconZoomWindow}" Content="Window" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM W" ToolTip="ZOOM Window" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconZoomPrevious}" Content="Previous" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM P" ToolTip="ZOOM Previous" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconPan}" Content="Pan" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="PAN" ToolTip="PAN" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconZoomIn}" Content="Zoom In" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM 2X" ToolTip="ZOOM 2X" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconZoomOut}" Content="Zoom Out" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM 0.5X" ToolTip="ZOOM 0.5X" />
                                <Button Style="{StaticResource NarrowSmallButton}" Tag="{StaticResource GhIconRefresh}" Content="Regen" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="REGEN" ToolTip="REGEN" />
                            </WrapPanel>
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Views" MinFullWidth="130" MinCollapsedWidth="56" Icon="{StaticResource GhIconModel}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconModel}" Content="Model" IsEnabled="{Binding Model.HasDocument}" Command="{Binding ModelSpaceCommand}" ToolTip="Show model space" />
                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLayout}" Content="Layout" IsEnabled="{Binding Model.HasDocument}" Command="{Binding LayoutCommand}" ToolTip="Show the first layout" Margin="0" />
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Interface" MinFullWidth="130" MinCollapsedWidth="64" Icon="{StaticResource GhIconPanelLeft}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource BigToggle}" Padding="3,4" Tag="{StaticResource GhIconPanelLeft}" Content="Drawings" IsChecked="{Binding Model.IsFileListShown, Mode=TwoWay}" ToolTip="Show or hide the DRAWINGS list" />
                            <ToggleButton Style="{StaticResource BigToggle}" Padding="3,4" Tag="{StaticResource GhIconPanelRight}" Content="Properties" IsChecked="{Binding Model.IsPropertiesPanelShown, Mode=TwoWay}" ToolTip="Show or hide Properties (PROPERTIES, PROPERTIESCLOSE)" Margin="0" />
                        </StackPanel>
                    </local:RibbonPanel>
                    <local:RibbonPanel Title="Drafting" MinFullWidth="160" MinMediumWidth="64" Icon="{StaticResource GhIconGrid}">
                        <WrapPanel Style="{StaticResource SmallColumn}">
                            <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconGrid}" Content="Grid" IsChecked="{Binding Grid.IsOn, Mode=TwoWay}" ToolTip="GRID (F7)" />
                            <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconSnap}" Content="Snap" IsChecked="{Binding Snap.IsOn, Mode=TwoWay}" ToolTip="SNAP (F9)" />
                            <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconOrtho}" Content="Ortho" IsChecked="{Binding Ortho.IsOn, Mode=TwoWay}" ToolTip="ORTHO (F8)" />
                            <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconPolar}" Content="Polar" IsChecked="{Binding Polar.IsOn, Mode=TwoWay}" ToolTip="POLAR (F10)" />
                            <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconOsnap}" Content="Osnap" IsChecked="{Binding Osnap.IsOn, Mode=TwoWay}" ToolTip="OSNAP (F3)" />
                        </WrapPanel>
                    </local:RibbonPanel>
                </local:RibbonStrip>
            </DataTemplate>

            <DataTemplate x:Key="LayerItem">
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Margin="0,0,6,0"
                            Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar: the mark, quick access, the app and its file, the command search. -->
        <Grid Grid.Row="0" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource GhAccent}">
                    <TextBlock Text="G" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GhAccentInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Style="{StaticResource GhFlatButton}" Command="{Binding NewCommand}" ToolTip="New: an empty drawing (NEW)" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconNew}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconOpen}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconSave}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding SaveAsCommand}" ToolTip="Save As (SAVEAS, Ctrl+Shift+S)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconSaveAs}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconUndo}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconRedo}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding AppName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=local:CadWorkspace}}" Foreground="{StaticResource GhTextMuted}" /><Run Text="    " /><Run Text="{Binding Title, Mode=OneWay}" />
            </TextBlock>
            <Border Grid.Column="2" Width="220" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                    Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <DockPanel>
                    <local:IconView Size="13" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconSearch}"
                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource GhTextBox}" Tag="Type a keyword or phrase" ToolTip="Searching commands is not built yet: type a command in the command line" />
                </DockPanel>
            </Border>
            <ContentPresenter Grid.Column="3" Content="{Binding TitleBarContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>

        <!-- Ribbon: the tabs, then the panels of Home. -->
        <Border Grid.Row="1" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,4,12,0">
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Home" IsChecked="{Binding IsHomeTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" Margin="0,0,4,0" />
                    <!-- The tabs extensions add after Home, as the Drawing tab of a model drawing, in the light accent of a contextual tab. -->
                    <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CadWorkspaceExtension}">
                                <ToggleButton x:Name="Tab" Style="{StaticResource GhRibbonTab}" Content="{Binding TabHeader}" Foreground="#6CB6FF"
                                              IsChecked="{Binding IsTabSelected, Mode=OneWay}" Margin="0,0,4,0"
                                              Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" Visibility="{Binding IsTabVisible, Converter={StaticResource Shown}}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                        <Setter TargetName="Tab" Property="Foreground" Value="{StaticResource GhText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Insert" IsChecked="{Binding InsertTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding InsertTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Annotate" IsChecked="{Binding AnnotateTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding AnnotateTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="View" IsChecked="{Binding ViewTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding ViewTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Plugins" IsChecked="{Binding PluginsTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding PluginsTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Settings" IsChecked="{Binding SettingsTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding SettingsTab}" />
                    <!-- The contextual Text Editor tab, green, while an MTEXT is written or edited. -->
                    <ToggleButton Content="Text Editor" IsChecked="{Binding TextEditorTab.IsTabSelected, Mode=OneWay}" Margin="4,0,0,0"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding TextEditorTab}"
                                  Visibility="{Binding TextEditorTab.IsTabVisible, Converter={StaticResource Shown}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome" Background="#2F8F4E" CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter TextElement.Foreground="White" TextElement.FontWeight="SemiBold" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <!-- The contextual Table Cell tab, green as the Text Editor's, while cells of a table are selected. -->
                    <ToggleButton Content="Table Cell" IsChecked="{Binding TableCellTab.IsTabSelected, Mode=OneWay}" Margin="4,0,0,0"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding TableCellTab}"
                                  Visibility="{Binding TableCellTab.IsTabVisible, Converter={StaticResource Shown}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource GhRibbonTab}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#2F8F4E" CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter TextElement.Foreground="White" TextElement.FontWeight="SemiBold" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
                <Border Padding="12,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TextEditorTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TableCellTab.IsTabSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2F8F4E" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                    <ContentPresenter Content="{Binding SelectedTab.TabContent}" Visibility="{Binding IsHomeTabSelected, Converter={StaticResource Hidden}}" />
                    <!--
                    Home, as AutoCAD 2021's: Draw, Modify, Annotation, Layers, Properties, Groups, Utilities, Clipboard, View. As the
                    window narrows the panels shrink from the right in the order of the steps (RibbonStrip): View, Clipboard,
                    Utilities and Groups collapse, Properties, Layers and Draw go medium, then Annotation, Properties and Layers
                    collapse; Modify never shrinks and Draw never collapses.
                    -->
                    <local:RibbonStrip Steps="View:Collapsed; Clipboard:Collapsed; Utilities:Collapsed; Groups:Collapsed; Properties:Medium; Layers:Medium; Draw:Medium; Annotation:Collapsed; Properties:Collapsed; Layers:Collapsed">
                        <local:RibbonStrip.Style>
                            <Style TargetType="local:RibbonStrip">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeTabSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:RibbonStrip.Style>
                        <local:RibbonPanel Title="Draw" MinFullWidth="342" MinMediumWidth="278" Icon="{StaticResource GhIconLine}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLine}" Content="Line" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="LINE" ToolTip="LINE" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPolyline}" Content="Polyline" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="PLINE" ToolTip="PLINE" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconCircle}" Content="Circle" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="CIRCLE" ToolTip="CIRCLE" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconArc}" Content="Arc" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ARC" ToolTip="ARC" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRectangle}" Content="Rectangle" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="RECTANG" ToolTip="RECTANG" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconEllipse}" Content="Ellipse" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ELLIPSE" ToolTip="ELLIPSE" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconPoint}" Content="Point" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="POINT" ToolTip="POINT" />
                                </WrapPanel>
                            </StackPanel>
                        </local:RibbonPanel>
                        <local:RibbonPanel Title="Modify" MinFullWidth="330" Icon="{StaticResource GhIconMove}">
                            <!-- The title drops the rest of the group, as AutoCAD's slide-out of Modify. -->
                            <local:RibbonPanel.Header>
                                <Button Style="{StaticResource GhFlatButton}" Padding="4,0" HorizontalAlignment="Center" IsEnabled="{Binding HasDocument}"
                                        Click="OnRibbonMenu" ToolTip="More of Modify: Break at Point, Break, Join, Lengthen, Align">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource GroupTitle}" Text="Modify" />
                                        <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" Margin="4,4,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Break at Point" Command="{Binding StartCommandCommand}" CommandParameter="BREAKATPOINT" ToolTip="BREAKATPOINT" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Break" Command="{Binding StartCommandCommand}" CommandParameter="BREAK" ToolTip="BREAK" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Join" Command="{Binding StartCommandCommand}" CommandParameter="JOIN" ToolTip="JOIN" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Lengthen" Command="{Binding StartCommandCommand}" CommandParameter="LENGTHEN" ToolTip="LENGTHEN" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Align" Command="{Binding StartCommandCommand}" CommandParameter="ALIGN" ToolTip="ALIGN" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </local:RibbonPanel.Header>
                            <!--
                            As AutoCAD 2021's panel: Move, Copy, Stretch; Rotate, Mirror, Scale; Trim, Fillet and Array, each with its
                            arrow and showing the command last picked from it (OnSplitChoice); Erase, Explode and Offset by their icons;
                            Draw Order's split in a fifth column; and under them a row of Break, Join, Lengthen and Align.
                            -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMove}" Content="Move" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCopy}" Content="Copy" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="COPY" ToolTip="COPY" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconStretch}" Content="Stretch" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="STRETCH" ToolTip="STRETCH" />
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRotate}" Content="Rotate" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ROTATE" ToolTip="ROTATE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMirror}" Content="Mirror" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MIRROR" ToolTip="MIRROR" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconScale}" Content="Scale" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="SCALE" ToolTip="SCALE" />
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconTrim}" Content="Trim" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Trim, Extend">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Trim" Tag="{StaticResource GhIconTrim}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Extend" Tag="{StaticResource GhIconExtend}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="EXTEND" ToolTip="EXTEND" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconFillet}" Content="Fillet" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Fillet, Chamfer">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Fillet" Tag="{StaticResource GhIconFillet}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Chamfer" Tag="{StaticResource GhIconChamfer}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="CHAMFER" ToolTip="CHAMFER" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconArrayRect}" Content="Array" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYRECT" ToolTip="ARRAYRECT" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Rectangular Array, Polar Array">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Rectangular Array" AutomationProperties.Name="Array" Tag="{StaticResource GhIconArrayRect}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYRECT" ToolTip="ARRAYRECT" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Polar Array" Tag="{StaticResource GhIconArrayPolar}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYPOLAR" ToolTip="ARRAYPOLAR" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource GhIconErase}" Content="Erase" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ERASE" ToolTip="Erase (ERASE)" />
                                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource GhIconExplode}" Content="Explode" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="EXPLODE" ToolTip="Explode (EXPLODE)" />
                                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource GhIconOffset}" Content="Offset" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="OFFSET" ToolTip="Offset (OFFSET)" />
                                    </WrapPanel>
                                    <!-- Draw Order: the icon runs the choice picked last, Bring to Front at first; the order keyword is given once the objects are picked. -->
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconBringToFront}" Content="Bring to Front" IsEnabled="{Binding HasDocument}"
                                                    Command="{Binding StartCommandWithOptionCommand}" CommandParameter="DRAWORDER F" ToolTip="Bring to Front (DRAWORDER, Front)" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Draw Order: Bring to Front, Send to Back, Bring Above Objects, Send Under Objects, Bring Text to Front">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Bring to Front" Tag="{StaticResource GhIconBringToFront}" Click="OnSplitChoice" Command="{Binding StartCommandWithOptionCommand}" CommandParameter="DRAWORDER F" ToolTip="Bring to Front (DRAWORDER, Front)" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Send to Back" Tag="{StaticResource GhIconSendToBack}" Click="OnSplitChoice" Command="{Binding StartCommandWithOptionCommand}" CommandParameter="DRAWORDER B" ToolTip="Send to Back (DRAWORDER, Back)" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Bring Above Objects" Tag="{StaticResource GhIconBringAbove}" Click="OnSplitChoice" Command="{Binding StartCommandWithOptionCommand}" CommandParameter="DRAWORDER A" ToolTip="Bring Above Objects (DRAWORDER, Above objects)" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Send Under Objects" Tag="{StaticResource GhIconSendUnder}" Click="OnSplitChoice" Command="{Binding StartCommandWithOptionCommand}" CommandParameter="DRAWORDER U" ToolTip="Send Under Objects (DRAWORDER, Under objects)" />
                                                        <Separator Style="{StaticResource GhMenuSeparator}" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Bring Text to Front" Tag="{StaticResource GhIconTextToFront}" Click="OnSplitChoice" Command="{Binding StartCommandWithOptionCommand}" CommandParameter="TEXTTOFRONT T" ToolTip="Bring Text to Front (TEXTTOFRONT, Text)" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RowButton}" Tag="{StaticResource GhIconBreak}" Content="Break" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="BREAK" ToolTip="BREAK" />
                                        <Button Style="{StaticResource RowButton}" Tag="{StaticResource GhIconJoin}" Content="Join" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="JOIN" ToolTip="JOIN" />
                                        <Button Style="{StaticResource RowButton}" Tag="{StaticResource GhIconLengthen}" Content="Lengthen" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="LENGTHEN" ToolTip="LENGTHEN" />
                                        <Button Style="{StaticResource RowButton}" Tag="{StaticResource GhIconAlign}" Content="Align" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ALIGN" ToolTip="ALIGN" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </local:RibbonPanel>
                        <!-- Annotation as AutoCAD's Home: Text, the dimension split showing the type used last, Leader, Table (not built yet). -->
                        <local:RibbonPanel Title="Annotation" MinFullWidth="216" MinCollapsedWidth="76" Icon="{StaticResource GhIconText}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconText}" Content="Text" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT" />
                                <Border Style="{StaticResource BigSplitFrame}">
                                    <StackPanel>
                                        <Button Style="{StaticResource BigSplitTop}" Tag="{StaticResource GhIconDimension}" Content="Linear" IsEnabled="{Binding HasDocument}"
                                                Command="{Binding StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="Linear (DIMLINEAR)" />
                                        <Button Style="{StaticResource BigSplitArrow}" Content="{Binding Children[0].Content, RelativeSource={RelativeSource AncestorType=StackPanel}}" ContentStringFormat="{}{0} ▾"
                                                IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Linear, Aligned, Angular, Radius, Diameter">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Linear" Tag="{StaticResource GhIconDimension}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="Linear (DIMLINEAR)" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Aligned" Tag="{StaticResource GhIconAligned}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="DIMALIGNED" ToolTip="Aligned (DIMALIGNED)" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Angular" Tag="{StaticResource GhIconAngular}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="DIMANGULAR" ToolTip="Angular (DIMANGULAR)" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Radius" Tag="{StaticResource GhIconRadius}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="DIMRADIUS" ToolTip="Radius (DIMRADIUS)" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Diameter" Tag="{StaticResource GhIconDiameter}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="DIMDIAMETER" ToolTip="Diameter (DIMDIAMETER)" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconLeader}" Content="Leader" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MLEADER" ToolTip="MLEADER" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconTable}" Content="Table" Opacity="0.5" ToolTip="Table (TABLE): not built yet" />
                                </WrapPanel>
                            </StackPanel>
                        </local:RibbonPanel>
                        <local:RibbonPanel Title="Layers" MinFullWidth="354" MinMediumWidth="290" MinCollapsedWidth="60" Icon="{StaticResource GhIconLayers}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLayers}" Content="Layer Properties" IsEnabled="{Binding HasDocument}" Command="{Binding LayerManagerCommand}" ToolTip="Layer manager (LAYER)" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCurrent}" Content="Make Current" IsEnabled="{Binding HasDocument}" Command="{Binding MakeCurrentCommand}" ToolTip="The layer of a selected object becomes current (LAYMCUR)" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMatch}" Content="Match Layer" IsEnabled="{Binding HasDocument}" Command="{Binding MatchLayerCommand}" ToolTip="Objects go onto the layer of another (LAYMCH)" />
                                </WrapPanel>
                                <ComboBox x:Name="LayerBox" Style="{StaticResource GhComboBox}" Width="168" Margin="0,2,0,0" VerticalAlignment="Top"
                                          ItemsSource="{Binding Layers}" SelectedItem="{Binding CurrentLayer, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource LayerItem}" IsEnabled="{Binding HasDocument}"
                                          ToolTip="The current layer" />
                            </StackPanel>
                        </local:RibbonPanel>
                        <local:RibbonPanel Title="Properties" MinFullWidth="250" MinMediumWidth="204" MinCollapsedWidth="72" Icon="{StaticResource GhIconMatchProperties}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconMatchProperties}" Content="Match Properties" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MATCHPROP" ToolTip="MATCHPROP" />
                                <!-- The boxes, 168 wide, narrow to 120 in a medium panel. -->
                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Width" Value="168" />
                                            <Style.Triggers>
                                                <Trigger Property="local:RibbonPanel.IsMedium" Value="True">
                                                    <Setter Property="Width" Value="120" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- The colour of new objects (CECOLOR): its swatch shows Select Color, as does More colors... of the list. -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource GhFlatButton}" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                Command="{Binding SelectCurrentColorCommand}" IsEnabled="{Binding HasDocument}" ToolTip="Select Color for new objects">
                                            <Border Width="14" Height="14" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                                    Background="{Binding CurrentColorRgb, Converter={StaticResource RgbBrush}}" />
                                        </Button>
                                        <ComboBox x:Name="ColorBox" Style="{StaticResource GhComboBox}" ItemsSource="{Binding CurrentColorOptions}"
                                                  SelectedItem="{Binding CurrentColor, Mode=TwoWay}" IsEnabled="{Binding HasDocument}"
                                                  ToolTip="The colour of new objects (CECOLOR)" />
                                    </DockPanel>
                                    <!-- The linetype of new objects (CELTYPE): ByLayer, ByBlock, those loaded, and Other... for the Linetype Manager. -->
                                    <ComboBox x:Name="LinetypeBox" Style="{StaticResource GhComboBox}" Margin="0,0,0,4" ItemsSource="{Binding CurrentLinetypeOptions}"
                                              SelectedItem="{Binding CurrentLinetype, Mode=TwoWay}" IsEnabled="{Binding HasDocument}"
                                              ToolTip="The linetype of new objects (CELTYPE); Other... shows the Linetype Manager" />
                                    <Border Style="{StaticResource ValueBox}" Margin="0">
                                        <DockPanel>
                                            <local:IconView DockPanel.Dock="Right" Size="10" StrokeThickness="3" Stroke="{StaticResource GhTextMuted}"
                                                            Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                                            <TextBlock Text="ByLayer" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </local:RibbonPanel>
                        <!-- Groups: Group, Ungroup, Group Edit (not built yet), and Group Selection, pressed while PICKSTYLE picks groups whole. -->
                        <local:RibbonPanel Title="Groups" MinFullWidth="204" MinCollapsedWidth="56" Icon="{StaticResource GhIconGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconGroup}" Content="Group" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="GROUP" ToolTip="GROUP" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconUngroup}" Content="Ungroup" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="UNGROUP" ToolTip="UNGROUP" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconGroupEdit}" Content="Group Edit" Opacity="0.5" ToolTip="Group Edit (GROUPEDIT): not built yet" />
                                    <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconPickStyle}" Content="Group Selection On/Off" IsEnabled="{Binding HasDocument}"
                                                  IsChecked="{Binding IsGroupSelectionOn, Mode=TwoWay}" ToolTip="Group Selection On/Off (PICKSTYLE)  Ctrl+Shift+A" />
                                </WrapPanel>
                            </StackPanel>
                        </local:RibbonPanel>
                        <local:RibbonPanel Title="Utilities" MinFullWidth="162" MinCollapsedWidth="60" Icon="{StaticResource GhIconDistance}">
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconDistance}" Content="Distance" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIST" ToolTip="DIST" />
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconArea}" Content="Area" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="AREA" ToolTip="AREA" />
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconId}" Content="ID Point" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ID" ToolTip="ID" />
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconList}" Content="List" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="LIST" ToolTip="LIST" />
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconQuickSelect}" Content="Quick Select" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="QSELECT" ToolTip="QSELECT" />
                            </WrapPanel>
                        </local:RibbonPanel>
                        <!-- Clipboard: Paste runs the paste picked last (PASTECLIP at first), its arrow the others as AutoCAD's; Cut, Copy and Copy with Base Point. -->
                        <local:RibbonPanel Title="Clipboard" MinFullWidth="204" MinCollapsedWidth="64" Icon="{StaticResource GhIconPaste}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource BigSplitFrame}">
                                    <StackPanel>
                                        <Button Style="{StaticResource BigSplitTop}" Tag="{StaticResource GhIconPaste}" Content="Paste" IsEnabled="{Binding HasDocument}"
                                                Command="{Binding StartCommandCommand}" CommandParameter="PASTECLIP" ToolTip="Paste (PASTECLIP)  Ctrl+V" />
                                        <Button Style="{StaticResource BigSplitArrow}" Content="Paste ▾" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu"
                                                ToolTip="Paste, Paste as Block, Paste to Original Coordinates, Paste Special">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Paste" Tag="{StaticResource GhIconPaste}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="PASTECLIP" ToolTip="Paste (PASTECLIP)  Ctrl+V" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Paste as Block" Tag="{StaticResource GhIconPasteBlock}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="PASTEBLOCK" ToolTip="Paste as Block (PASTEBLOCK)  Ctrl+Shift+V" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Paste to Original Coordinates" Tag="{StaticResource GhIconPasteOriginal}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="PASTEORIG" ToolTip="Paste to Original Coordinates (PASTEORIG)" />
                                                    <Separator Style="{StaticResource GhMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Paste Special…" Tag="{StaticResource GhIconPasteSpecial}" Click="OnSplitChoice" Command="{Binding StartCommandCommand}" CommandParameter="PASTESPEC" ToolTip="Paste Special (PASTESPEC)" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCut}" Content="Cut" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="CUTCLIP" ToolTip="Cut (CUTCLIP)  Ctrl+X" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCopy}" Content="Copy" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="COPYCLIP" ToolTip="Copy (COPYCLIP)  Ctrl+C" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCopyBase}" Content="Copy with Base Point" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="COPYBASE" ToolTip="Copy with Base Point (COPYBASE)  Ctrl+Shift+C" />
                                </WrapPanel>
                            </StackPanel>
                        </local:RibbonPanel>
                        <local:RibbonPanel Title="View" MinFullWidth="130" MinCollapsedWidth="50" Icon="{StaticResource GhIconExtents}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Zoom Extents"
                                        Command="{Binding ZoomExtentsCommand}" IsEnabled="{Binding HasDocument}" ToolTip="ZOOM Extents" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPan}" Content="Pan" Margin="0"
                                        Command="{Binding PanCommand}" IsEnabled="{Binding HasDocument}" ToolTip="PAN" />
                            </StackPanel>
                        </local:RibbonPanel>
                    </local:RibbonStrip>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: DRAWINGS, the files only (A20); View › Interface hides it. -->
            <Border Grid.Column="0" Width="288" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsFileListShown, Converter={StaticResource Shown}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="20" Height="20" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}" ToolTip="Look for new files">
                                <local:IconView Size="16" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconRefresh}" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="20" Height="20" Margin="8,0,0,0"
                                    Command="{Binding OpenCommand}" ToolTip="Open a DXF (Ctrl+O)">
                                <local:IconView Size="16" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconOpen}" />
                            </Button>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="DRAWINGS" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Margin="12,8,12,4" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5">
                        <DockPanel>
                            <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconSearch}"
                                            Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource GhTextBox}" Tag="Search file, mark, name…"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Top" Margin="12,4,12,8" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding AllChipText}" IsChecked="{Binding FilterAll}" Margin="0,0,6,0" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding DxfChipText}" IsChecked="{Binding FilterDxf}" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding OwnChipText}" IsChecked="{Binding FilterOwn}" Margin="6,0,6,6"
                                     Visibility="{Binding HasOwnFiles, Converter={StaticResource Shown}}" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding OutOfDateChipText}" IsChecked="{Binding FilterOutOfDate}" Margin="0,0,6,6"
                                     Visibility="{Binding HasOwnFiles, Converter={StaticResource Shown}}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,16" Foreground="{StaticResource GhTextMuted}" TextAlignment="Center"
                               Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}"
                               Text="No drawing open.&#x0a;Pick a file here, or open one." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <!-- A click selects a row (Ctrl and Shift add), a double click or Enter opens it, a right click shows its menu (C5). -->
                        <ItemsControl x:Name="FileList" ItemsSource="{Binding FileRows}" Margin="0,0,0,6" Focusable="True" FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FileRowViewModel}">
                                    <Grid>
                                        <TextBlock x:Name="Header" Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" FontSize="11"
                                                   FontWeight="Medium" Margin="12,8,12,2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <Border x:Name="File" Background="Transparent" ToolTip="{Binding Path}"
                                                MouseLeftButtonDown="OnFileRowDown" MouseRightButtonUp="OnFileRowRightUp">
                                            <Border x:Name="Row" Padding="13,5,12,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                                <DockPanel>
                                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource GhAccent}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Visibility="Collapsed" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsOpen, Converter={StaticResource Shown}}" ToolTip="Close (CLOSE)"
                                                            Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <local:IconView x:Name="CloseCross" Size="10" StrokeThickness="2.4" Stroke="{StaticResource GhCloseCross}" Data="{StaticResource GhIconClose}" />
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" FontSize="11" FontWeight="Medium" Margin="8,0,0,0"
                                                               Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GhText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource GhTextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource Shown}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="File" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger SourceName="File" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                            <Setter TargetName="CloseCross" Property="Stroke" Value="{StaticResource GhCloseCrossOnSelected}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Edited">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="OutOfDate">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GhWarn}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="UpToDate">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GhOk}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Centre: the canvas, then the command line under it only. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="{StaticResource GhCanvas}" ClipToBounds="True">
                    <local:CadCanvas x:Name="CanvasView" Session="{Binding Session}" Snap="{Binding Snap}" ShowGrid="{Binding GridOn}" Document="{Binding Document}" Space="{Binding Space}" View="{Binding View}"
                                     DynamicInput="{Binding IsDynamicInputShown}"
                                     Revision="{Binding Revision}" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}" />
                    <TextBlock Text="{Binding ViewportLabel}" FontFamily="{StaticResource GhMonoFont}" FontSize="11" Foreground="{StaticResource GhTextMuted}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" IsHitTestVisible="False" />
                    <!-- Dynamic input (DYN, F12): the prompt, then the coordinates, the distance and angle, or what is typed, beside the cursor. -->
                    <Canvas IsHitTestVisible="False" Visibility="{Binding IsDynamicInputShown, Converter={StaticResource Shown}}">
                        <Canvas.Resources>
                            <!-- A field of a point prompt: the one typed into framed in the accent, a locked one darker with a lock. -->
                            <Style x:Key="DynamicField" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="{StaticResource GhInput}" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinWidth" Value="64" />
                            </Style>
                        </Canvas.Resources>
                        <Border x:Name="DynamicInputBox" Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                CornerRadius="2" Padding="6,3" TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DynamicInputPrompt}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <Border BorderBrush="{StaticResource GhAccent}" BorderThickness="1" Background="{StaticResource GhInput}" Margin="6,0,0,0"
                                        Padding="4,0" MinWidth="64">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DynamicInputValue}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDynamicInputFields}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DynamicInputValue}" Foreground="{StaticResource GhText}" />
                                </Border>
                                <!-- At a point prompt two fields, X and Y or distance < angle; Tab moves between them, a number typed locks one. -->
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding IsDynamicInputFields, Converter={StaticResource Shown}}">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DynamicField}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputFirstLocked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GhCommandInput}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDynamicInputFirstActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <local:IconView Size="10" StrokeThickness="2.5" Stroke="{StaticResource GhAccent}" Data="{StaticResource GhIconLock}" Margin="0,0,4,0"
                                                            VerticalAlignment="Center" Visibility="{Binding IsDynamicInputFirstLocked, Converter={StaticResource Shown}}" />
                                            <TextBlock Text="{Binding DynamicInputFirst}" Foreground="{StaticResource GhText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="4,0" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="," />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputPolar}" Value="True">
                                                        <Setter Property="Text" Value="&lt;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DynamicField}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputSecondLocked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GhCommandInput}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDynamicInputSecondActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <local:IconView Size="10" StrokeThickness="2.5" Stroke="{StaticResource GhAccent}" Data="{StaticResource GhIconLock}" Margin="0,0,4,0"
                                                            VerticalAlignment="Center" Visibility="{Binding IsDynamicInputSecondLocked, Converter={StaticResource Shown}}" />
                                            <TextBlock Text="{Binding DynamicInputSecond}" Foreground="{StaticResource GhText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="°" Foreground="{StaticResource GhTextMuted}" Margin="2,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsDynamicInputPolar, Converter={StaticResource Shown}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                    <!-- Text edited in place: TEXTEDIT's box over a single-line text, the MTEXT editor's frame over an MTEXT. -->
                    <Canvas x:Name="InPlaceLayer">
                        <TextBox x:Name="InPlaceTextBox" Visibility="Collapsed" Background="Black" BorderBrush="{StaticResource GhTextMuted}" BorderThickness="1"
                                 Padding="4,0" CaretBrush="White" SelectionBrush="{StaticResource GhAccent}" VerticalContentAlignment="Center"
                                 PreviewKeyDown="OnInPlaceKey" LostKeyboardFocus="OnInPlaceLostFocus" />
                        <local:CadMTextEditBox x:Name="MTextEditorBox" Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Width="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}">
                        <TextBlock Text="{Binding AppName, RelativeSource={RelativeSource AncestorType=local:CadWorkspace}}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Open and edit any 2D drawing, or make drawings from a model. No file is open."
                                   Foreground="{StaticResource GhTextMuted}" Margin="0,6,0,20" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Open DXF…  ·  Ctrl+O" Command="{Binding OpenCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="New drawing from a model…  ·  Ctrl+N" IsEnabled="True"
                                    Command="{Binding NewFromModelCommand}" ToolTip="Make a drawing from the objects of a model (DRAWINGNEW)" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Blank drawing" IsEnabled="True" Command="{Binding NewCommand}" ToolTip="A new empty drawing (NEW)" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0"
                        TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="12"
                        Visibility="{Binding IsCommandLineShown, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <DockPanel Margin="12,6,12,4">
                            <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconClose}"
                                            VerticalAlignment="Top" Margin="0,1,8,0" />
                            <ItemsControl ItemsSource="{Binding RecentHistory}" Foreground="{StaticResource GhTextMuted}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Border Margin="8,0,8,8" Padding="8,4" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2"
                                Background="{StaticResource GhCommandInput}">
                            <DockPanel>
                                <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconPrompt}"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Prompt}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="CommandBox" Style="{StaticResource GhTextBox}" Tag="Type a command"
                                         FontFamily="{StaticResource GhMonoFont}" FontSize="12"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnCommandKeyDown" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right panel: PROPERTIES of the selection; PROPERTIESCLOSE and View › Interface hide it, PROPERTIES shows it. -->
            <Border Grid.Column="2" Width="312" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPropertiesPanelShown, Converter={StaticResource Shown}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="12,8">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="PROPERTIES" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="12,24" Foreground="{StaticResource GhTextMuted}" TextAlignment="Center"
                               Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}"
                               Text="No selection.&#x0a;Open a file to see its properties." />
                    <Border DockPanel.Dock="Top" Margin="12,8" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5"
                            Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <DockPanel>
                            <local:IconView DockPanel.Dock="Right" Size="12" StrokeThickness="2.5" Stroke="{StaticResource GhTextMuted}"
                                            Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectionLabel}" />
                        </DockPanel>
                    </Border>
                    <!-- The owner banner: what an extension says of a selection it owns. -->
                    <Border DockPanel.Dock="Top" Margin="12,0,12,6" Padding="10,8" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhAccent}"
                            BorderThickness="3,0,0,0" CornerRadius="2" Visibility="{Binding HasPropertiesBanner, Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding PropertiesBanner}" Foreground="{StaticResource GhIcon}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <ItemsControl ItemsSource="{Binding PropertyGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ToggleButton x:Name="Expander" Style="{StaticResource GhFlatButton}" IsChecked="True" HorizontalContentAlignment="Left"
                                                      Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <local:IconView x:Name="Chevron" Size="12" StrokeThickness="2.5" Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"
                                                           Foreground="{StaticResource GhText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="12,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Label}" />
                                                        <Grid Grid.Column="1">
                                                            <Border x:Name="Cell" Background="{StaticResource GhInput}" CornerRadius="2" Padding="6,3">
                                                                <Grid>
                                                                    <TextBlock x:Name="Value" Text="{Binding Value}" Foreground="{StaticResource GhTextMuted}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                                    <TextBox x:Name="Editor" Style="{StaticResource GhTextBox}" Visibility="Collapsed" Padding="0"
                                                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}" KeyDown="OnValueKeyDown" />
                                                                </Grid>
                                                            </Border>
                                                            <ComboBox x:Name="Choice" Style="{StaticResource GhComboBox}" Visibility="Collapsed"
                                                                      ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsTyped}" Value="True">
                                                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                            <Setter TargetName="Cell" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Varies}" Value="True">
                                                            <Setter TargetName="Editor" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                                            <Setter TargetName="Editor" Property="FontStyle" Value="Italic" />
                                                            <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Expander" Property="IsChecked" Value="False">
                                            <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom bar: Model and layout tabs at the left; state, coordinates, space, toggles and scale at the right. -->
        <Border Grid.Row="3" Background="{StaticResource GhBg}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Padding="12,0"
                TextElement.FontSize="11" TextElement.FontWeight="Medium" TextElement.Foreground="{StaticResource GhTextMuted}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding SpaceTabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SpaceTabViewModel}">
                                <Button Style="{StaticResource GhFlatButton}" Margin="0,0,2,0" Height="22" VerticalAlignment="Bottom"
                                        Command="{Binding DataContext.SelectSpaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tab" Background="Transparent" CornerRadius="3,3,0,0" Padding="12,0" BorderThickness="0,2,0,0"
                                                    BorderBrush="Transparent">
                                                <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource GhTextMuted}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource GhPanel}" />
                                                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GhText}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhFlatButton}" Content="+" Width="24" Height="22" Foreground="{StaticResource GhTextMuted}"
                            Command="{Binding NewLayoutCommand}" ToolTip="New layout (LAYOUT New)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Visibility="{Binding HasDocument, Converter={StaticResource Shown}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GhOk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GhWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusNote}" Foreground="{StaticResource GhWarn}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CursorText}" Width="170" TextAlignment="Right" FontFamily="{StaticResource GhMonoFont}" FontSize="12"
                               FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SpaceLabel}" FontWeight="SemiBold" Foreground="{StaticResource GhText}" Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Toggles}" Focusable="False" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- OSNAP has AutoCAD's small arrow, and a right click, for the menu of the object snaps and Object Snap Settings (C6). -->
                            <DataTemplate DataType="{x:Type local:StatusToggleViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <ToggleButton Style="{StaticResource GhStatusToggle}" Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  FontSize="11" MouseRightButtonUp="OnStatusToggleRightUp" />
                                    <Button x:Name="OsnapArrow" Style="{StaticResource GhFlatButton}" Width="14" Height="18" Margin="1,0,0,0" Visibility="Collapsed"
                                            Click="OnOsnapArrow" ToolTip="Object snaps on, and Object Snap Settings...">
                                        <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="OSNAP">
                                        <Setter TargetName="OsnapArrow" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Style="{StaticResource GhStatusToggle}" Content="{Binding DynamicInput.Name}" IsChecked="{Binding DynamicInput.IsOn, Mode=TwoWay}"
                                  Margin="0,0,12,0" FontSize="11" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}"
                                  ToolTip="Dynamic input (DYN, F12): the prompt, the coordinates and what you type, beside the cursor. Ctrl+9 shows or hides the command line." />
                    <TextBlock Text="1:1" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
