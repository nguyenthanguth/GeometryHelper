<UserControl x:Class="GeometryHelper.Dxf.Viewer.Wpf.CadWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{DynamicResource GhFont}" FontSize="12" Foreground="{DynamicResource GhText}"
             Background="{DynamicResource GhBg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <local:RgbBrushConverter x:Key="RgbBrush" />

            <!-- A big button of the ribbon: its Tag is the icon, its Content the label. -->
            <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small button of the ribbon: a 16 pixel icon and its label in a row. -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="0,0,8,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Size="16" StrokeThickness="1.8"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A small toggle of the ribbon, as the drafting toggles of View: lit while on, as the status bar's are. -->
            <Style x:Key="SmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="0,0,8,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Size="16" StrokeThickness="1.8"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A big toggle of the ribbon, as the panels of View › Interface. -->
            <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource GhStatusToggle}">
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The arrow of a split button of the ribbon: a click drops its menu (OnRibbonMenu), as AutoCAD's does. -->
            <Style x:Key="SplitArrow" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,2" />
            </Style>

            <!-- The column of small buttons of a group, three to a column. -->
            <Style x:Key="SmallColumn" TargetType="WrapPanel">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Height" Value="66" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="GroupBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <!-- A box of the ribbon that shows a value: ByLayer, with or without a swatch. -->
            <Style x:Key="ValueBox" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="ToolTip" Value="Not built yet: the lineweight of new objects; set an object's in Properties" />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Background" Value="{StaticResource GhAccent}" />
                <Setter Property="Foreground" Value="{StaticResource GhAccentInk}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="ToolTip" Value="Not built yet" />
            </Style>

            <!-- The groups of the Plugins tab: a button per command of each plugin loaded, then Manage. -->
            <DataTemplate DataType="{x:Type local:PluginRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Command plugins" />
                            <Grid>
                                <TextBlock Text="No command plugin is loaded.&#x0a;Load .dll adds one." Foreground="{StaticResource GhTextMuted}" Margin="4,8,8,0"
                                           Visibility="{Binding HasCommands, Converter={StaticResource Hidden}}" />
                                <ItemsControl ItemsSource="{Binding Commands}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PluginCommandButton}">
                                            <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginCommand}" Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                                    IsEnabled="True" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <!-- A command's name is one long word: kept on one line, cut with an ellipsis past 96 pixels. -->
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <local:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                                                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Manage" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginLoad}" Content="Load .dll" IsEnabled="True" Command="{Binding LoadCommand}" ToolTip="Load a plugin (PLUGINLOAD, NETLOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconRefresh}" Content="Reload" IsEnabled="True" Command="{Binding ReloadCommand}" ToolTip="Load the plugin again from its file (PLUGINRELOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginUnload}" Content="Unload" IsEnabled="True" Command="{Binding UnloadCommand}" ToolTip="Unload the plugin (PLUGINUNLOAD)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPluginManager}" Content="Plugin manager" IsEnabled="True" Command="{Binding ManagerCommand}" Margin="0" ToolTip="Load, install, unload and trust plugins" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The groups of the Settings tab: Global settings, opened on a category. -->
            <DataTemplate DataType="{x:Type local:SettingsRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Global settings" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconGear}" Content="Options" IsEnabled="True" Command="{Binding OpenCommand}" ToolTip="Global settings (OPTIONS)" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPalette}" Content="Appearance" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Appearance" ToolTip="Global settings › Appearance" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Canvas" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Canvas and cursor" ToolTip="Global settings › Canvas and cursor" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconKeyboard}" Content="Shortcuts" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Shortcuts" ToolTip="Global settings › Shortcuts" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconSave}" Content="Save and export" IsEnabled="True" Command="{Binding OpenCommand}" CommandParameter="Save and export" Margin="0" ToolTip="Global settings › Save and export" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The groups of the Annotate tab: Text, Dimensions, Leaders, each button starting its command as Home's do. -->
            <DataTemplate DataType="{x:Type local:AnnotateRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <!--
                        A style box: the combo box's look, opened by a click on it (StyleBox), with no button of its own; its list
                        on the header's colour, the current style ticked, a model drawing's marked "model", the dialog's item last
                        under a line.
                        -->
                        <Style x:Key="StyleBoxItem" TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource GhBorder}" BorderThickness="0" Padding="10,4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDialog}" Value="True">
                                                <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0" />
                                                <Setter TargetName="Row" Property="Margin" Value="0,4,0,0" />
                                                <Setter TargetName="Row" Property="Padding" Value="10,6,10,4" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <DataTemplate x:Key="StyleBoxItemTemplate" DataType="{x:Type local:StyleBoxItemViewModel}">
                            <DockPanel>
                                <TextBlock x:Name="Tick" DockPanel.Dock="Left" Width="14" Margin="0,0,6,0" Text="✓" Foreground="{StaticResource GhOk}" Visibility="Hidden" />
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Hint}" Foreground="{StaticResource GhTextMuted}" />
                                <TextBlock Text="{Binding Name}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        <DataTemplate x:Key="StyleBoxChosenTemplate">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                        <Style x:Key="StyleBoxCombo" TargetType="ComboBox" BasedOn="{StaticResource GhComboBox}">
                            <Setter Property="local:StyleBox.OpensOnClick" Value="True" />
                            <Setter Property="Width" Value="118" />
                            <Setter Property="SelectedValuePath" Value="Name" />
                            <Setter Property="ItemTemplate" Value="{StaticResource StyleBoxItemTemplate}" />
                            <Setter Property="ItemContainerStyle" Value="{StaticResource StyleBoxItem}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <Border Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2" Padding="4,2">
                                                <DockPanel>
                                                    <local:IconView DockPanel.Dock="Right" Size="10" StrokeThickness="3" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{StaticResource StyleBoxChosenTemplate}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                </DockPanel>
                                            </Border>
                                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False">
                                                <Border Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4" Margin="0,0,8,8"
                                                        MinWidth="190" MaxHeight="320">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
                                                    </Border.Effect>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="StyleBoxLabel" TargetType="TextBlock">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                        </Style>
                    </StackPanel.Resources>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Text" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconMText}" Content="Multiline Text" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="MTEXT" ToolTip="MTEXT" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconText}" Content="Single Line" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT" Margin="0" />
                                <!-- The current text style ($TEXTSTYLE), its last item the Text Style dialog, and the height TEXT offers. -->
                                <StackPanel Margin="6,2,0,0" IsEnabled="{Binding Model.HasDocument}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                        <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.TextStyleItems}" SelectedValue="{Binding Model.CurrentTextStyle, Mode=TwoWay}"
                                                  ToolTip="Text style (STYLE)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Height" />
                                        <Border Width="118" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1">
                                            <TextBox Style="{StaticResource GhTextBox}" FontFamily="{StaticResource GhMonoFont}" Text="{Binding Model.TextHeight, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Text height of the next Single Line text (TEXT, MTEXT)" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Dimensions" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconDimension}" Content="Linear" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="DIMLINEAR" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconAligned}" Content="Aligned" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMALIGNED" ToolTip="DIMALIGNED" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconAngular}" Content="Angular" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMANGULAR" ToolTip="DIMANGULAR" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRadius}" Content="Radius" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMRADIUS" ToolTip="DIMRADIUS" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconDiameter}" Content="Diameter" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="DIMDIAMETER" ToolTip="DIMDIAMETER" />
                                </WrapPanel>
                                <!-- The current dimension style ($DIMSTYLE), its last item the Dimension Style Manager. -->
                                <StackPanel Orientation="Horizontal" Margin="6,2,0,0" VerticalAlignment="Top" IsEnabled="{Binding Model.HasDocument}">
                                    <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                    <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.DimStyleItems}" SelectedValue="{Binding Model.CurrentDimStyle, Mode=TwoWay}"
                                              ToolTip="Dimension style (DIMSTYLE)" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Leaders" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLeader}" Content="Multileader" IsEnabled="{Binding Model.HasDocument}" Command="{Binding Model.StartCommandCommand}" CommandParameter="MLEADER" ToolTip="MLEADER" Margin="0" />
                                <!-- The current multileader style (CMLEADERSTYLE), opened where the drawing has multileader styles. -->
                                <StackPanel Orientation="Horizontal" Margin="6,2,0,0" VerticalAlignment="Top" IsEnabled="{Binding Model.HasMLeaderStyles}">
                                    <TextBlock Style="{StaticResource StyleBoxLabel}" Text="Style" />
                                    <ComboBox Style="{StaticResource StyleBoxCombo}" ItemsSource="{Binding Model.MLeaderStyleItems}" SelectedValue="{Binding Model.CurrentMLeaderStyle, Mode=TwoWay}"
                                              ToolTip="Multileader style (CMLEADERSTYLE)" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- The groups of the View tab: Navigate, Views, Interface and the drafting toggles of the status bar. -->
            <DataTemplate DataType="{x:Type local:ViewRibbonViewModel}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Navigate" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Extents" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM E" ToolTip="ZOOM Extents" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconZoomWindow}" Content="Window" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM W" ToolTip="ZOOM Window" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconZoomPrevious}" Content="Previous" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM P" ToolTip="ZOOM Previous" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconPan}" Content="Pan" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="PAN" ToolTip="PAN" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconZoomIn}" Content="Zoom In" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM 2X" ToolTip="ZOOM 2X" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconZoomOut}" Content="Zoom Out" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="ZOOM 0.5X" ToolTip="ZOOM 0.5X" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRefresh}" Content="Regen" IsEnabled="{Binding Model.HasDocument}" Command="{Binding RunCommand}" CommandParameter="REGEN" ToolTip="REGEN" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Views" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconModel}" Content="Model" IsEnabled="{Binding Model.HasDocument}" Command="{Binding ModelSpaceCommand}" ToolTip="Show model space" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLayout}" Content="Layout" IsEnabled="{Binding Model.HasDocument}" Command="{Binding LayoutCommand}" ToolTip="Show the first layout" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Interface" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource BigToggle}" Tag="{StaticResource GhIconPanelLeft}" Content="Drawings" IsChecked="{Binding Model.IsFileListShown, Mode=TwoWay}" ToolTip="Show or hide the DRAWINGS list" />
                                <ToggleButton Style="{StaticResource BigToggle}" Tag="{StaticResource GhIconPanelRight}" Content="Properties" IsChecked="{Binding Model.IsPropertiesPanelShown, Mode=TwoWay}" ToolTip="Show or hide Properties (PROPERTIES, PROPERTIESCLOSE)" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Drafting" />
                            <WrapPanel Style="{StaticResource SmallColumn}">
                                <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconGrid}" Content="Grid" IsChecked="{Binding Grid.IsOn, Mode=TwoWay}" ToolTip="GRID (F7)" />
                                <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconSnap}" Content="Snap" IsChecked="{Binding Snap.IsOn, Mode=TwoWay}" ToolTip="SNAP (F9)" />
                                <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconOrtho}" Content="Ortho" IsChecked="{Binding Ortho.IsOn, Mode=TwoWay}" ToolTip="ORTHO (F8)" />
                                <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconPolar}" Content="Polar" IsChecked="{Binding Polar.IsOn, Mode=TwoWay}" ToolTip="POLAR (F10)" />
                                <ToggleButton Style="{StaticResource SmallToggle}" Tag="{StaticResource GhIconOsnap}" Content="Osnap" IsChecked="{Binding Osnap.IsOn, Mode=TwoWay}" ToolTip="OSNAP (F3)" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="LayerItem">
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Margin="0,0,6,0"
                            Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar: the mark, quick access, the app and its file, the command search. -->
        <Grid Grid.Row="0" Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource GhAccent}">
                    <TextBlock Text="G" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GhAccentInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Style="{StaticResource GhFlatButton}" Command="{Binding NewCommand}" ToolTip="New: an empty drawing (NEW)" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconNew}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconOpen}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconSave}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding SaveAsCommand}" ToolTip="Save As (SAVEAS, Ctrl+Shift+S)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconSaveAs}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                        <local:IconView Size="16" Data="{StaticResource GhIconUndo}" />
                    </Button>
                    <Button Style="{StaticResource GhFlatButton}" IsEnabled="{Binding HasDocument}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:IconView Size="16" Data="{StaticResource GhIconRedo}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis">
                <Run Text="GeometryHelper Drawing" Foreground="{StaticResource GhTextMuted}" /><Run Text="    " /><Run Text="{Binding Title, Mode=OneWay}" />
            </TextBlock>
            <Border Grid.Column="2" Width="220" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                    Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <DockPanel>
                    <local:IconView Size="13" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconSearch}"
                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource GhTextBox}" Tag="Type a keyword or phrase" ToolTip="Searching commands is not built yet: type a command in the command line" />
                </DockPanel>
            </Border>
            <ContentPresenter Grid.Column="3" Content="{Binding TitleBarContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>

        <!-- Ribbon: the tabs, then the groups of Home. -->
        <Border Grid.Row="1" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,4,12,0">
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Home" IsChecked="{Binding IsHomeTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" Margin="0,0,4,0" />
                    <!-- The tabs extensions add after Home, as the Drawing tab of a model drawing, in the light accent of a contextual tab. -->
                    <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CadWorkspaceExtension}">
                                <ToggleButton x:Name="Tab" Style="{StaticResource GhRibbonTab}" Content="{Binding TabHeader}" Foreground="#6CB6FF"
                                              IsChecked="{Binding IsTabSelected, Mode=OneWay}" Margin="0,0,4,0"
                                              Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" Visibility="{Binding IsTabVisible, Converter={StaticResource Shown}}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                        <Setter TargetName="Tab" Property="Foreground" Value="{StaticResource GhText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Annotate" IsChecked="{Binding AnnotateTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding AnnotateTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="View" IsChecked="{Binding ViewTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding ViewTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Plugins" IsChecked="{Binding PluginsTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding PluginsTab}" Margin="0,0,4,0" />
                    <ToggleButton Style="{StaticResource GhRibbonTab}" Content="Settings" IsChecked="{Binding SettingsTab.IsTabSelected, Mode=OneWay}"
                                  Command="{Binding SelectTabCommand}" CommandParameter="{Binding SettingsTab}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Padding="12,6">
                    <Grid>
                    <ContentPresenter Content="{Binding SelectedTab.TabContent}" Visibility="{Binding IsHomeTabSelected, Converter={StaticResource Hidden}}" />
                    <!-- Home is hidden, not collapsed, under another tab, so that the ribbon keeps its height and the canvas stays put. -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeTabSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Draw" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLine}" Content="Line" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="LINE" ToolTip="LINE" />
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPolyline}" Content="Polyline" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="PLINE" ToolTip="PLINE" />
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconCircle}" Content="Circle" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="CIRCLE" ToolTip="CIRCLE" />
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconArc}" Content="Arc" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ARC" ToolTip="ARC" />
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRectangle}" Content="Rectangle" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="RECTANG" ToolTip="RECTANG" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconEllipse}" Content="Ellipse" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ELLIPSE" ToolTip="ELLIPSE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconPoint}" Content="Point" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="POINT" ToolTip="POINT" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <!-- The title drops the rest of the group, as AutoCAD's slide-out of Modify. -->
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhFlatButton}" Padding="4,0" HorizontalAlignment="Center" IsEnabled="{Binding HasDocument}"
                                        Click="OnRibbonMenu" ToolTip="More of Modify: Break at Point, Break, Join, Lengthen, Align">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource GroupTitle}" Text="Modify" />
                                        <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" Margin="4,4,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Break at Point" Command="{Binding StartCommandCommand}" CommandParameter="BREAKATPOINT" ToolTip="BREAKATPOINT" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Break" Command="{Binding StartCommandCommand}" CommandParameter="BREAK" ToolTip="BREAK" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Join" Command="{Binding StartCommandCommand}" CommandParameter="JOIN" ToolTip="JOIN" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Lengthen" Command="{Binding StartCommandCommand}" CommandParameter="LENGTHEN" ToolTip="LENGTHEN" />
                                            <MenuItem Style="{StaticResource GhMenuItem}" Header="Align" Command="{Binding StartCommandCommand}" CommandParameter="ALIGN" ToolTip="ALIGN" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <!-- As AutoCAD 2021's panel: Move, Copy, Stretch; Rotate, Mirror, Scale; Trim, Fillet and Array, each with its arrow; Erase and Offset. -->
                                <StackPanel Orientation="Horizontal">
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMove}" Content="Move" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCopy}" Content="Copy" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="COPY" ToolTip="COPY" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconStretch}" Content="Stretch" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="STRETCH" ToolTip="STRETCH" />
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconRotate}" Content="Rotate" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ROTATE" ToolTip="ROTATE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMirror}" Content="Mirror" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MIRROR" ToolTip="MIRROR" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconScale}" Content="Scale" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="SCALE" ToolTip="SCALE" />
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconTrim}" Content="Trim" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Trim, Extend">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Trim" Command="{Binding StartCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Extend" Command="{Binding StartCommandCommand}" CommandParameter="EXTEND" ToolTip="EXTEND" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconFillet}" Content="Fillet" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Fillet, Chamfer">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Fillet" Command="{Binding StartCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Chamfer" Command="{Binding StartCommandCommand}" CommandParameter="CHAMFER" ToolTip="CHAMFER" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,0,2" Tag="{StaticResource GhIconArrayRect}" Content="Array" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYRECT" ToolTip="ARRAYRECT" />
                                            <Button Style="{StaticResource SplitArrow}" IsEnabled="{Binding HasDocument}" Click="OnRibbonMenu" ToolTip="Rectangular Array, Polar Array">
                                                <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource GhContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Rectangular Array" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYRECT" ToolTip="ARRAYRECT" />
                                                        <MenuItem Style="{StaticResource GhMenuItem}" Header="Polar Array" Command="{Binding StartCommandCommand}" CommandParameter="ARRAYPOLAR" ToolTip="ARRAYPOLAR" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconErase}" Content="Erase" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ERASE" ToolTip="ERASE" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconOffset}" Content="Offset" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="OFFSET" ToolTip="OFFSET" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Annotation" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconText}" Content="Text" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT" />
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconDimension}" Content="Dimension" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="DIMLINEAR" />
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconDimension}" Content="Linear" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIMLINEAR" ToolTip="DIMLINEAR" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconAligned}" Content="Aligned" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIMALIGNED" ToolTip="DIMALIGNED" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconAngular}" Content="Angular" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIMANGULAR" ToolTip="DIMANGULAR" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconLeader}" Content="Leader" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MLEADER" ToolTip="MLEADER" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Layers" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconLayers}" Content="Layer Properties" IsEnabled="{Binding HasDocument}" Command="{Binding LayerManagerCommand}" ToolTip="Layer manager (LAYER)" />
                                    <WrapPanel Style="{StaticResource SmallColumn}">
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconCurrent}" Content="Make Current" IsEnabled="{Binding HasDocument}" Command="{Binding MakeCurrentCommand}" ToolTip="The layer of a selected object becomes current (LAYMCUR)" />
                                        <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconMatch}" Content="Match Layer" IsEnabled="{Binding HasDocument}" Command="{Binding MatchLayerCommand}" ToolTip="Objects go onto the layer of another (LAYMCH)" />
                                    </WrapPanel>
                                    <ComboBox x:Name="LayerBox" Style="{StaticResource GhComboBox}" Width="168" Margin="0,2,0,0" VerticalAlignment="Top"
                                              ItemsSource="{Binding Layers}" SelectedItem="{Binding CurrentLayer, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource LayerItem}" IsEnabled="{Binding HasDocument}"
                                              ToolTip="The current layer" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Properties" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconMatchProperties}" Content="Match Properties" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="MATCHPROP" ToolTip="MATCHPROP" />
                                    <StackPanel Width="168" Margin="0,2,0,0">
                                        <!-- The colour of new objects (CECOLOR): its swatch shows Select Color, as does More colors... of the list. -->
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource GhFlatButton}" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center"
                                                    Command="{Binding SelectCurrentColorCommand}" IsEnabled="{Binding HasDocument}" ToolTip="Select Color for new objects">
                                                <Border Width="14" Height="14" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                                        Background="{Binding CurrentColorRgb, Converter={StaticResource RgbBrush}}" />
                                            </Button>
                                            <ComboBox x:Name="ColorBox" Style="{StaticResource GhComboBox}" ItemsSource="{Binding CurrentColorOptions}"
                                                      SelectedItem="{Binding CurrentColor, Mode=TwoWay}" IsEnabled="{Binding HasDocument}"
                                                      ToolTip="The colour of new objects (CECOLOR)" />
                                        </DockPanel>
                                        <!-- The linetype of new objects (CELTYPE): ByLayer, ByBlock, those loaded, and Other... for the Linetype Manager. -->
                                        <ComboBox x:Name="LinetypeBox" Style="{StaticResource GhComboBox}" Margin="0,0,0,4" ItemsSource="{Binding CurrentLinetypeOptions}"
                                                  SelectedItem="{Binding CurrentLinetype, Mode=TwoWay}" IsEnabled="{Binding HasDocument}"
                                                  ToolTip="The linetype of new objects (CELTYPE); Other... shows the Linetype Manager" />
                                        <Border Style="{StaticResource ValueBox}" Margin="0">
                                            <DockPanel>
                                                <local:IconView DockPanel.Dock="Right" Size="10" StrokeThickness="3" Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                                                <TextBlock Text="ByLayer" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Clipboard is hidden until COPYCLIP and PASTECLIP are built: a button for what does not exist is not shown. -->
                        <Border Style="{StaticResource GroupBorder}" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Clipboard" />
                                <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPaste}" Content="Paste" Margin="0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Utilities" />
                                <WrapPanel Style="{StaticResource SmallColumn}">
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconDistance}" Content="Distance" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="DIST" ToolTip="DIST" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconArea}" Content="Area" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="AREA" ToolTip="AREA" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconId}" Content="ID Point" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="ID" ToolTip="ID" />
                                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource GhIconList}" Content="List" IsEnabled="{Binding HasDocument}" Command="{Binding StartCommandCommand}" CommandParameter="LIST" ToolTip="LIST" />
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource GroupBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="View" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconExtents}" Content="Zoom Extents"
                                            Command="{Binding ZoomExtentsCommand}" IsEnabled="{Binding HasDocument}" ToolTip="ZOOM Extents" />
                                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconPan}" Content="Pan" Margin="0"
                                            Command="{Binding PanCommand}" IsEnabled="{Binding HasDocument}" ToolTip="PAN" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: DRAWINGS, the files only (A20); View › Interface hides it. -->
            <Border Grid.Column="0" Width="288" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsFileListShown, Converter={StaticResource Shown}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="20" Height="20" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}" ToolTip="Look for new files">
                                <local:IconView Size="16" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconRefresh}" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="20" Height="20" Margin="8,0,0,0"
                                    Command="{Binding OpenCommand}" ToolTip="Open a DXF (Ctrl+O)">
                                <local:IconView Size="16" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconOpen}" />
                            </Button>
                            <TextBlock Style="{StaticResource PanelTitle}" Text="DRAWINGS" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Margin="12,8,12,4" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5">
                        <DockPanel>
                            <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconSearch}"
                                            Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource GhTextBox}" Tag="Search file, mark, name…"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Top" Margin="12,4,12,8" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding AllChipText}" IsChecked="{Binding FilterAll}" Margin="0,0,6,0" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding DxfChipText}" IsChecked="{Binding FilterDxf}" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding OwnChipText}" IsChecked="{Binding FilterOwn}" Margin="6,0,6,6"
                                     Visibility="{Binding HasOwnFiles, Converter={StaticResource Shown}}" />
                        <RadioButton Style="{StaticResource GhChip}" Content="{Binding OutOfDateChipText}" IsChecked="{Binding FilterOutOfDate}" Margin="0,0,6,6"
                                     Visibility="{Binding HasOwnFiles, Converter={StaticResource Shown}}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,16" Foreground="{StaticResource GhTextMuted}" TextAlignment="Center"
                               Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}"
                               Text="No drawing open.&#x0a;Pick a file here, or open one." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <!-- A click selects a row (Ctrl and Shift add), a double click or Enter opens it, a right click shows its menu (C5). -->
                        <ItemsControl x:Name="FileList" ItemsSource="{Binding FileRows}" Margin="0,0,0,6" Focusable="True" FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FileRowViewModel}">
                                    <Grid>
                                        <TextBlock x:Name="Header" Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" FontSize="11"
                                                   FontWeight="Medium" Margin="12,8,12,2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <Border x:Name="File" Background="Transparent" ToolTip="{Binding Path}"
                                                MouseLeftButtonDown="OnFileRowDown" MouseRightButtonUp="OnFileRowRightUp">
                                            <Border x:Name="Row" Padding="13,5,12,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                                <DockPanel>
                                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource GhAccent}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Visibility="Collapsed" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsOpen, Converter={StaticResource Shown}}" ToolTip="Close (CLOSE, Ctrl+W)"
                                                            Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <local:IconView x:Name="CloseCross" Size="10" StrokeThickness="2.4" Stroke="{StaticResource GhCloseCross}" Data="{StaticResource GhIconClose}" />
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" FontSize="11" FontWeight="Medium" Margin="8,0,0,0"
                                                               Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource GhText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource GhTextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource Shown}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="File" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger SourceName="File" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                            <Setter TargetName="CloseCross" Property="Stroke" Value="{StaticResource GhCloseCrossOnSelected}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Edited">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="OutOfDate">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GhWarn}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="UpToDate">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GhOk}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Centre: the canvas, then the command line under it only. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="{StaticResource GhCanvas}" ClipToBounds="True">
                    <local:CadCanvas x:Name="CanvasView" Session="{Binding Session}" Snap="{Binding Snap}" ShowGrid="{Binding GridOn}" Document="{Binding Document}" Space="{Binding Space}" View="{Binding View}"
                                     DynamicInput="{Binding IsDynamicInputShown}"
                                     Revision="{Binding Revision}" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}" />
                    <TextBlock Text="{Binding ViewportLabel}" FontFamily="{StaticResource GhMonoFont}" FontSize="11" Foreground="{StaticResource GhTextMuted}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" IsHitTestVisible="False" />
                    <!-- Dynamic input (DYN, F12): the prompt, then the coordinates, the distance and angle, or what is typed, beside the cursor. -->
                    <Canvas IsHitTestVisible="False" Visibility="{Binding IsDynamicInputShown, Converter={StaticResource Shown}}">
                        <Canvas.Resources>
                            <!-- A field of a point prompt: the one typed into framed in the accent, a locked one darker with a lock. -->
                            <Style x:Key="DynamicField" TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="{StaticResource GhInput}" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinWidth" Value="64" />
                            </Style>
                        </Canvas.Resources>
                        <Border x:Name="DynamicInputBox" Background="{StaticResource GhHeader}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                CornerRadius="2" Padding="6,3" TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DynamicInputPrompt}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <Border BorderBrush="{StaticResource GhAccent}" BorderThickness="1" Background="{StaticResource GhInput}" Margin="6,0,0,0"
                                        Padding="4,0" MinWidth="64">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DynamicInputValue}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDynamicInputFields}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DynamicInputValue}" Foreground="{StaticResource GhText}" />
                                </Border>
                                <!-- At a point prompt two fields, X and Y or distance < angle; Tab moves between them, a number typed locks one. -->
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding IsDynamicInputFields, Converter={StaticResource Shown}}">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DynamicField}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputFirstLocked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GhCommandInput}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDynamicInputFirstActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <local:IconView Size="10" StrokeThickness="2.5" Stroke="{StaticResource GhAccent}" Data="{StaticResource GhIconLock}" Margin="0,0,4,0"
                                                            VerticalAlignment="Center" Visibility="{Binding IsDynamicInputFirstLocked, Converter={StaticResource Shown}}" />
                                            <TextBlock Text="{Binding DynamicInputFirst}" Foreground="{StaticResource GhText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="4,0" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="," />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputPolar}" Value="True">
                                                        <Setter Property="Text" Value="&lt;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DynamicField}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDynamicInputSecondLocked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GhCommandInput}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDynamicInputSecondActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <local:IconView Size="10" StrokeThickness="2.5" Stroke="{StaticResource GhAccent}" Data="{StaticResource GhIconLock}" Margin="0,0,4,0"
                                                            VerticalAlignment="Center" Visibility="{Binding IsDynamicInputSecondLocked, Converter={StaticResource Shown}}" />
                                            <TextBlock Text="{Binding DynamicInputSecond}" Foreground="{StaticResource GhText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="°" Foreground="{StaticResource GhTextMuted}" Margin="2,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsDynamicInputPolar, Converter={StaticResource Shown}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                    <StackPanel Width="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}">
                        <TextBlock Text="GeometryHelper Drawing" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="Open and edit any 2D drawing, or make drawings from a model. No file is open."
                                   Foreground="{StaticResource GhTextMuted}" Margin="0,6,0,20" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Open DXF…  ·  Ctrl+O" Command="{Binding OpenCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="New drawing from a model…  ·  Ctrl+N" IsEnabled="True"
                                    Command="{Binding NewFromModelCommand}" ToolTip="Make a drawing from the objects of a model (DRAWINGNEW)" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Blank drawing" IsEnabled="True" Command="{Binding NewCommand}" ToolTip="A new empty drawing (NEW)" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0"
                        TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="12"
                        Visibility="{Binding IsCommandLineShown, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <DockPanel Margin="12,6,12,4">
                            <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconClose}"
                                            VerticalAlignment="Top" Margin="0,1,8,0" />
                            <ItemsControl ItemsSource="{Binding RecentHistory}" Foreground="{StaticResource GhTextMuted}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <Border Margin="8,0,8,8" Padding="8,4" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2"
                                Background="{StaticResource GhCommandInput}">
                            <DockPanel>
                                <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconPrompt}"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Prompt}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="CommandBox" Style="{StaticResource GhTextBox}" Tag="Type a command"
                                         FontFamily="{StaticResource GhMonoFont}" FontSize="12"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnCommandKeyDown" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right panel: PROPERTIES of the selection; PROPERTIESCLOSE and View › Interface hide it, PROPERTIES shows it. -->
            <Border Grid.Column="2" Width="312" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPropertiesPanelShown, Converter={StaticResource Shown}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="12,8">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="PROPERTIES" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="12,24" Foreground="{StaticResource GhTextMuted}" TextAlignment="Center"
                               Visibility="{Binding HasDocument, Converter={StaticResource Hidden}}"
                               Text="No selection.&#x0a;Open a file to see its properties." />
                    <Border DockPanel.Dock="Top" Margin="12,8" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5"
                            Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <DockPanel>
                            <local:IconView DockPanel.Dock="Right" Size="12" StrokeThickness="2.5" Stroke="{StaticResource GhTextMuted}"
                                            Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectionLabel}" />
                        </DockPanel>
                    </Border>
                    <!-- The owner banner: what an extension says of a selection it owns. -->
                    <Border DockPanel.Dock="Top" Margin="12,0,12,6" Padding="10,8" Background="{StaticResource GhInput}" BorderBrush="{StaticResource GhAccent}"
                            BorderThickness="3,0,0,0" CornerRadius="2" Visibility="{Binding HasPropertiesBanner, Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding PropertiesBanner}" Foreground="{StaticResource GhIcon}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <ItemsControl ItemsSource="{Binding PropertyGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ToggleButton x:Name="Expander" Style="{StaticResource GhFlatButton}" IsChecked="True" HorizontalContentAlignment="Left"
                                                      Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <local:IconView x:Name="Chevron" Size="12" StrokeThickness="2.5" Stroke="{StaticResource GhTextMuted}"
                                                                Data="{StaticResource GhIconChevron}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"
                                                           Foreground="{StaticResource GhText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="12,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Label}" />
                                                        <Grid Grid.Column="1">
                                                            <Border x:Name="Cell" Background="{StaticResource GhInput}" CornerRadius="2" Padding="6,3">
                                                                <Grid>
                                                                    <TextBlock x:Name="Value" Text="{Binding Value}" Foreground="{StaticResource GhTextMuted}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                                    <TextBox x:Name="Editor" Style="{StaticResource GhTextBox}" Visibility="Collapsed" Padding="0"
                                                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}" KeyDown="OnValueKeyDown" />
                                                                </Grid>
                                                            </Border>
                                                            <ComboBox x:Name="Choice" Style="{StaticResource GhComboBox}" Visibility="Collapsed"
                                                                      ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsTyped}" Value="True">
                                                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                            <Setter TargetName="Cell" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Varies}" Value="True">
                                                            <Setter TargetName="Editor" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                                            <Setter TargetName="Editor" Property="FontStyle" Value="Italic" />
                                                            <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Expander" Property="IsChecked" Value="False">
                                            <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom bar: Model and layout tabs at the left; state, coordinates, space, toggles and scale at the right. -->
        <Border Grid.Row="3" Background="{StaticResource GhBg}" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,0,0" Padding="12,0"
                TextElement.FontSize="11" TextElement.FontWeight="Medium" TextElement.Foreground="{StaticResource GhTextMuted}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding SpaceTabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SpaceTabViewModel}">
                                <Button Style="{StaticResource GhFlatButton}" Margin="0,0,2,0" Height="22" VerticalAlignment="Bottom"
                                        Command="{Binding DataContext.SelectSpaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tab" Background="Transparent" CornerRadius="3,3,0,0" Padding="12,0" BorderThickness="0,2,0,0"
                                                    BorderBrush="Transparent">
                                                <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource GhTextMuted}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource GhPanel}" />
                                                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GhText}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhFlatButton}" Content="+" Width="24" Height="22" Foreground="{StaticResource GhTextMuted}"
                            Command="{Binding NewLayoutCommand}" ToolTip="New layout (LAYOUT New)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Visibility="{Binding HasDocument, Converter={StaticResource Shown}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GhOk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GhWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusNote}" Foreground="{StaticResource GhWarn}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CursorText}" Width="170" TextAlignment="Right" FontFamily="{StaticResource GhMonoFont}" FontSize="12"
                               FontWeight="Normal" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SpaceLabel}" FontWeight="SemiBold" Foreground="{StaticResource GhText}" Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Toggles}" Focusable="False" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- OSNAP has AutoCAD's small arrow, and a right click, for the menu of the object snaps and Object Snap Settings (C6). -->
                            <DataTemplate DataType="{x:Type local:StatusToggleViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <ToggleButton Style="{StaticResource GhStatusToggle}" Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  FontSize="11" MouseRightButtonUp="OnStatusToggleRightUp" />
                                    <Button x:Name="OsnapArrow" Style="{StaticResource GhFlatButton}" Width="14" Height="18" Margin="1,0,0,0" Visibility="Collapsed"
                                            Click="OnOsnapArrow" ToolTip="Object snaps on, and Object Snap Settings...">
                                        <Path Data="M1 1 4 4 7 1" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="OSNAP">
                                        <Setter TargetName="OsnapArrow" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Style="{StaticResource GhStatusToggle}" Content="{Binding DynamicInput.Name}" IsChecked="{Binding DynamicInput.IsOn, Mode=TwoWay}"
                                  Margin="0,0,12,0" FontSize="11" Visibility="{Binding HasDocument, Converter={StaticResource Shown}}"
                                  ToolTip="Dynamic input (DYN, F12): the prompt, the coordinates and what you type, beside the cursor. Ctrl+9 shows or hides the command line." />
                    <TextBlock Text="1:1" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
