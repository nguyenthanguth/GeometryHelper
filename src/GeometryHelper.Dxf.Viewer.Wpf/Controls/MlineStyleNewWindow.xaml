<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.MlineStyleNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create New Multiline Style"
    Width="380"
    Height="210"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design MlineStyleNew: the new style's name and the style it starts with. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Create New Multiline Style"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Continue"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnContinue"
                        IsDefault="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14">
                <DockPanel>
                    <TextBlock
                        Text="New style name:"
                        Width="110"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                    <TextBox
                        x:Name="NameBox"
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="New style name"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock
                        Text="Start With:"
                        Width="110"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Start with"
                        ItemsSource="{Binding Styles}"
                        SelectedItem="{Binding StartWith, Mode=TwoWay}"
                    />
                </DockPanel>
                <TextBlock
                    Margin="0,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhError}"
                    Text="{Binding Message}"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
