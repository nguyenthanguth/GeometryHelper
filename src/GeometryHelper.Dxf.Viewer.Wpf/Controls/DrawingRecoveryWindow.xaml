<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.DrawingRecoveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Drawing Recovery Manager"
    Width="360"
    Height="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design DrawingRecovery: the copies autosave keeps, with the drawing, the time and the size; Open opens the one picked. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Drawing Recovery Manager"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Open"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanOpen}"
                        Click="OnOpen"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="18,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Top" Text="Backup Files" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid DataContext="{Binding Selected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Folder" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding Folder}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Saved" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Saved}" />
                        <TextBlock Grid.Row="2" Text="Size" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Size}" />
                    </Grid>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                    />
                </StackPanel>
                <ListBox
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    Foreground="{StaticResource GhText}"
                    ItemContainerStyle="{StaticResource StyleListItem}"
                    AutomationProperties.Name="Backup Files"
                    ItemsSource="{Binding Copies}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    MouseDoubleClick="OnOpen"
                >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Text="{Binding Size}"
                                        Foreground="{StaticResource GhTextMuted}"
                                    />
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </DockPanel>
                                <TextBlock Foreground="{StaticResource GhTextMuted}">
                                    <Run Text="of " /><Run Text="{Binding Original, Mode=OneWay}" /><Run Text=", saved " /><Run Text="{Binding Saved, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
