<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.MlineStyleLoadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Load Multiline Styles"
    Width="420"
    Height="330"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Load Multiline Styles (MlineStyleManager's Load…): the file, acad.mln to start with, and its styles. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Load Multiline Styles"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,14">
                <DockPanel DockPanel.Dock="Top">
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="File…"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        Click="OnBrowse"
                    />
                    <TextBlock Text="{Binding File}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock
                    DockPanel.Dock="Bottom"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhError}"
                    Text="{Binding Message}"
                />
                <ListBox
                    Margin="0,10,0,0"
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    Foreground="{StaticResource GhText}"
                    ItemContainerStyle="{StaticResource StyleListItem}"
                    AutomationProperties.Name="Styles of the file"
                    ItemsSource="{Binding Names}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    MouseDoubleClick="OnOk"
                />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
