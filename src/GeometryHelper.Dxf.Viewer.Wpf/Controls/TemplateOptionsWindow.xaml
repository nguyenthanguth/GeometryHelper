<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.TemplateOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Template Options"
    Width="400"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design TemplateOptions: the description, the measurement, and New Layer Notification greyed. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Template Options" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnOk"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        IsCancel="True"
                        Click="OnCancel"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Top" Text="Description" FontWeight="SemiBold" Margin="0,0,0,6" />
                <HeaderedContentControl
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource BlockGroup}"
                    Header="New Layer Notification"
                    IsEnabled="False"
                    Margin="0,10,0,0"
                    ToolTip="The presenter keeps no reconciled layers"
                >
                    <StackPanel>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Margin="0,0,0,6"
                            Content="Save all layers as unreconciled"
                            IsChecked="True"
                        />
                        <RadioButton Style="{StaticResource BlockRadio}" Content="Save all layers as reconciled" />
                    </StackPanel>
                </HeaderedContentControl>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="Measurement" FontWeight="SemiBold" Width="110" VerticalAlignment="Center" />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Measurement"
                        ItemsSource="{Binding Measurements}"
                        SelectedItem="{Binding Measurement, Mode=TwoWay}"
                    />
                </DockPanel>
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    AcceptsReturn="False"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Description"
                />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
