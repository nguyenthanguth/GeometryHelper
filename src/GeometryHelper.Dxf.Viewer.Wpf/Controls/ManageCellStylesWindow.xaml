<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ManageCellStylesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Manage Cell Styles"
    Width="460"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title with the table style, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CloseCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Manage Cell Styles - " />
                        <Run Text="{Binding TableStyle, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Footer: Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <Button
                    Style="{StaticResource StylePrimaryButton}"
                    Content="Close"
                    Padding="14,5"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"
                    IsCancel="True"
                />
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="Cell styles" />
                    <ListBox
                        ItemsSource="{Binding Styles}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        Background="Transparent"
                        BorderBrush="{StaticResource GhBorder}"
                        Height="230"
                    />
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="#E5A04B"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                    />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="Style" />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="New..."
                        Padding="14,5"
                        Command="{Binding NewCommand}"
                        Margin="0,0,0,12"
                    />
                    <TextBlock Style="{StaticResource StyleLabel}" Text="New name:" Margin="0,0,0,4" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,6"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Rename"
                        Padding="14,5"
                        Command="{Binding RenameCommand}"
                        Margin="0,0,0,12"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Delete"
                        Padding="14,5"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,0,12"
                    />
                    <TextBlock
                        Text="Title, Header and Data stay in every table style."
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
