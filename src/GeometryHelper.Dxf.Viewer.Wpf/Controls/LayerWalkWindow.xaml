<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LayerWalkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="LayerWalk"
    Width="380"
    Height="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WalkRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                                Padding="8,4"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WalkName" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUsed}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="LayerWalk" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Content="Close"
                        Padding="14,5"
                        Background="{StaticResource GhClose}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="OnClose"
                        IsDefault="True"
                        IsCancel="True"
                    />
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Restore on exit"
                        IsChecked="{Binding RestoreOnExit, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        ToolTip="Put every layer back as it was when LayerWalk closes"
                    />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Text="Filter:"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Tag="*"
                        Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Wild cards: * any run, ? one character, # a digit, a comma between patterns"
                        AutomationProperties.Name="Layer filter"
                    />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Select Objects"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Click="OnSelectObjects"
                        ToolTip="Pick objects on the canvas: their layers are selected in the list"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Purge Layers"
                        Padding="10,4"
                        Click="OnPurge"
                        ToolTip="Delete the unused layers selected"
                    />
                </StackPanel>
            </StackPanel>

            <TextBlock
                DockPanel.Dock="Bottom"
                Margin="16,6,16,6"
                Foreground="{StaticResource GhTextMuted}"
                TextWrapping="Wrap"
            >
                <Run Text="{Binding Summary, Mode=OneWay}" />
                <Run Text="· Unused layers are in italics. Only the layers selected are shown; with none selected every layer is as it was." />
            </TextBlock>
            <TextBlock
                DockPanel.Dock="Bottom"
                Margin="16,0,16,0"
                Foreground="{StaticResource GhError}"
                TextWrapping="Wrap"
                Text="{Binding Message}"
            />

            <Border Margin="16,0,16,0" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Layers"
                        Padding="8,6"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{StaticResource GhTextMuted}"
                        Background="{StaticResource GhHeader}"
                    />
                    <ListBox
                        x:Name="Layers"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="Extended"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource WalkRow}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch"
                        SelectionChanged="OnSelectionChanged"
                        AutomationProperties.Name="Layers"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LayerWalkRowViewModel}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource WalkName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource GhContextMenu}">
                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Select All" Click="OnSelectAll" />
                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Clear All" Click="OnClearAll" />
                                <Separator Style="{StaticResource GhMenuSeparator}" />
                                <MenuItem Style="{StaticResource GhMenuItem}" Header="Purge Layers" Click="OnPurge" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
