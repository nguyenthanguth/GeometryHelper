<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.XbindWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xbind"
    Width="620"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="List" TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource StyleListItem}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design XbindDialog: the Xrefs tree on the left, Definitions to Bind on the right, Add and Remove between. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Xbind" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Xrefs"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,0,0,4"
                    />
                    <ListBox
                        Style="{StaticResource List}"
                        AutomationProperties.Name="Xrefs"
                        ItemsSource="{Binding Xrefs}"
                        SelectedItem="{Binding Picked, Mode=TwoWay}"
                        MouseDoubleClick="OnAdd"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Margin="{Binding Indent}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Add -&gt;"
                        Padding="8,5"
                        Margin="0,0,0,8"
                        Click="OnAdd"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="&lt;- Remove"
                        Padding="8,5"
                        Click="OnRemove"
                    />
                </StackPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Definitions to Bind"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,0,0,4"
                    />
                    <ListBox
                        Style="{StaticResource List}"
                        AutomationProperties.Name="Definitions to Bind"
                        ItemsSource="{Binding ToBind}"
                        SelectedItem="{Binding Chosen, Mode=TwoWay}"
                        DisplayMemberPath="Text"
                        MouseDoubleClick="OnRemove"
                    />
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
