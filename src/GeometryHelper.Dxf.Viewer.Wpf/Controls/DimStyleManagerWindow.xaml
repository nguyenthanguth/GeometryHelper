<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.DimStyleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Dimension Style Manager" Width="780" Height="540" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <!-- Header: the title with the drawing's name, dragged to move the dialog, and the close button (Close). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="24" Height="24" Command="{Binding CloseCommand}" ToolTip="Close">
                        <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconClose}" />
                    </Button>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: how many styles, then Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhDialogButton}" Content="Close" Padding="14,5" Command="{Binding CloseCommand}" IsCancel="True" />
                    <TextBlock Text="{Binding Footer}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <!-- The styles: the current one marked, MODEL beside a model drawing's; double-click modifies; the filter below. -->
                <DockPanel Grid.Column="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentStyleText}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource StyleGroup}" Text="Styles" Margin="0" />
                    </DockPanel>
                    <ComboBox DockPanel.Dock="Bottom" Style="{StaticResource GhComboBox}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='List: {0}'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4">
                        <ListBox x:Name="StyleList" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource GhText}" ItemContainerStyle="{StaticResource StyleListItem}" ItemTemplate="{StaticResource StyleRowTemplate}"
                                 MouseDoubleClick="OnStyleDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource GhContextMenu}">
                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Rename…" Command="{Binding RenameCommand}" />
                                    <MenuItem Style="{StaticResource GhMenuItem}" Header="Delete" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- The preview of the style selected, its description and the notice. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="{Binding PreviewTitle}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource StylePreview}" Height="250" Margin="0,0,0,8">
                        <Image Source="{Binding Preview}" Stretch="None" />
                    </Border>
                    <Border Style="{StaticResource StyleFrame}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Description" Foreground="{StaticResource GhTextMuted}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StyleFrame}" Visibility="{Binding HasNotice, Converter={StaticResource Shown}}">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top" Style="{StaticResource NoticeDot}" />
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Set current, New, Modify (the main one), Override, Compare; Rename and Delete are on the list's menu. -->
                <StackPanel Grid.Column="4">
                    <Button Style="{StaticResource StyleSideButton}" Content="Set current" Command="{Binding SetCurrentCommand}" />
                    <Button Style="{StaticResource StyleSideButton}" Content="New…" Command="{Binding NewCommand}" />
                    <Button Style="{StaticResource StylePrimaryButton}" Content="Modify…" Padding="8,5" Margin="0,0,0,6" Command="{Binding ModifyCommand}" />
                    <Button Style="{StaticResource StyleSideButton}" Content="Override…" Command="{Binding OverrideCommand}" />
                    <Button Style="{StaticResource StyleSideButton}" Content="Compare…" Command="{Binding CompareCommand}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
