<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LinetypeManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Linetype Manager"
    Width="620"
    Height="520"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="Width" Value="90" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Linetype Manager" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: why something was refused, then OK and Cancel. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,6,0"
                            Click="OnOk"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhWarn}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>

            <!-- Details: the global scale, the current object scale and the ISO pen width. -->
            <Border
                DockPanel.Dock="Bottom"
                Padding="16,0,16,12"
                Visibility="{Binding ShowDetails, Converter={StaticResource Shown}}"
            >
                <StackPanel>
                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="Name:" Width="150" />
                        <TextBlock
                            Text="{Binding SelectedRow.Name}"
                            FontFamily="{StaticResource GhMonoFont}"
                            VerticalAlignment="Center"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="Description:" Width="150" />
                        <TextBlock Text="{Binding SelectedRow.Description}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="Global scale factor:" Width="150" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding GlobalScale, UpdateSourceTrigger=LostFocus}"
                            ToolTip="LTSCALE"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="Current object scale:" Width="150" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding CurrentObjectScale, UpdateSourceTrigger=LostFocus}"
                            ToolTip="CELTSCALE"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="ISO pen width:" Width="150" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="90"
                            ItemsSource="{x:Static local:LinetypeManagerViewModel.IsoPenWidths}"
                            SelectedItem="{Binding IsoPenWidth, Mode=TwoWay}"
                            ToolTip="Sets the current object scale to the width, for ISO linetypes"
                        />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Load..., Delete, Current and Show details, as AutoCAD orders them; the current linetype under them. -->
            <Border DockPanel.Dock="Top" Padding="16,12,16,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Load..."
                            Margin="0,0,6,0"
                            Command="{Binding LoadCommand}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Delete"
                            Margin="0,0,6,0"
                            Command="{Binding DeleteCommand}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Current"
                            Margin="0,0,6,0"
                            Command="{Binding CurrentCommand}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="{Binding DetailsText}"
                            Command="{Binding DetailsCommand}"
                        />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- The linetypes: name, appearance and description; the current one marked, one waiting to be loaded in italics. -->
            <Border
                Margin="16,0,16,12"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="1"
                Background="{StaticResource GhInput}"
            >
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Linetype" Margin="8,5" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Appearance"
                            Margin="8,5"
                            Foreground="{StaticResource GhTextMuted}"
                        />
                        <TextBlock
                            Grid.Column="2"
                            Text="Description"
                            Margin="8,5"
                            Foreground="{StaticResource GhTextMuted}"
                        />
                    </Grid>
                    <ListBox
                        ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource GhText}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LinetypeRowViewModel}">
                                <Grid Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="Name"
                                        Text="{Binding Name}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        VerticalAlignment="Center"
                                        Margin="4,0"
                                    />
                                    <Path
                                        Grid.Column="1"
                                        Data="{Binding Appearance}"
                                        Stroke="{StaticResource GhText}"
                                        StrokeThickness="1.5"
                                        VerticalAlignment="Center"
                                        Margin="8,0"
                                    />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Description}"
                                        VerticalAlignment="Center"
                                        Margin="8,0"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GhOk}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <Setter TargetName="Name" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
