<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PageSetupOverrideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Page Setup Override"
    Width="440"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design PageSetupOverride: paper size, plot style table, orientation and plot scale. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Page Setup Override"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OnOk"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            IsCancel="True"
                            Click="OnCancel"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Paper size" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Paper size"
                        ItemsSource="{Binding Papers}"
                        SelectedItem="{Binding Paper, Mode=TwoWay}"
                    />
                    <TextBlock Grid.Row="2" Text="Plot style table" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Plot style table"
                        ItemsSource="{Binding StyleTables}"
                        SelectedItem="{Binding StyleTable, Mode=TwoWay}"
                    />
                </Grid>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Drawing orientation"
                    Margin="0,0,0,10"
                >
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Margin="0,0,16,0"
                            Content="Portrait"
                            GroupName="PsoTurn"
                            IsChecked="{Binding Portrait, Mode=TwoWay}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="Landscape"
                            GroupName="PsoTurn"
                            IsChecked="{Binding Landscape, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Plot scale" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Fit to paper"
                            IsChecked="{Binding FitToPaper, Mode=TwoWay}"
                        />
                        <Grid Margin="0,0,0,6" IsEnabled="{Binding IsScaleEditable}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Scale"
                                Foreground="{StaticResource GhTextMuted}"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource BlockBox}"
                                TextAlignment="Right"
                                AutomationProperties.Name="Millimetres of paper"
                                Text="{Binding PaperUnits, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <TextBlock Grid.Column="2" Text="mm" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource BlockBox}"
                                TextAlignment="Right"
                                AutomationProperties.Name="Drawing units"
                                Text="{Binding DrawingUnits, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Text="units"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Scale lineweights"
                            IsChecked="{Binding ScaleLineweights, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
