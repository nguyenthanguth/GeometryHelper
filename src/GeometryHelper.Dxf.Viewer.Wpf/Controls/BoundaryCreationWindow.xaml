<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.BoundaryCreationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Boundary Creation"
    Width="420"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design BoundaryCreation: Pick Points, Island detection, Boundary retention and the boundary set. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Boundary Creation"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="OK"
                        Padding="18,5"
                        IsEnabled="False"
                        ToolTip="Pick points first"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,12">
                <Button
                    Style="{StaticResource StylePrimaryButton}"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Click="OnPickPoints"
                    IsDefault="True"
                    AutomationProperties.Name="Pick Points"
                >
                    <StackPanel Orientation="Horizontal">
                        <local:IconView
                            Size="16"
                            StrokeThickness="2"
                            Margin="0,0,8,0"
                            Data="{StaticResource GhIconBoundary}"
                        />
                        <TextBlock Text="Pick Points" />
                    </StackPanel>
                </Button>
                <CheckBox
                    Style="{StaticResource BlockCheck}"
                    Content="Island detection"
                    Margin="0,12,0,0"
                    IsChecked="{Binding IslandDetection, Mode=TwoWay}"
                />
                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Boundary retention"
                    Margin="0,8,0,0"
                >
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Retain boundaries"
                            IsChecked="True"
                            IsEnabled="False"
                            Margin="0,0,0,8"
                        />
                        <DockPanel>
                            <TextBlock
                                Text="Object type:"
                                Width="90"
                                Foreground="{StaticResource GhTextMuted}"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                AutomationProperties.Name="Object type"
                                ItemsSource="{Binding ObjectTypes}"
                                SelectedItem="{Binding ObjectType, Mode=TwoWay}"
                            />
                        </DockPanel>
                    </StackPanel>
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Boundary set" Margin="0,8,0,0">
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Content="New"
                            Padding="10,3"
                            Margin="6,0,0,0"
                            Click="OnNewSet"
                            ToolTip="Select the objects the areas are found among"
                        />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            AutomationProperties.Name="Boundary set"
                            ItemsSource="{Binding BoundarySets}"
                            SelectedItem="{Binding BoundarySet, Mode=TwoWay}"
                        />
                    </DockPanel>
                </HeaderedContentControl>
                <TextBlock
                    Margin="0,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhTextMuted}"
                    Text="Pick Points closes the dialog and asks &quot;Pick internal point:&quot; until Enter. New asks &quot;Select objects:&quot; and comes back with Existing set: the areas are then found among those objects alone."
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
