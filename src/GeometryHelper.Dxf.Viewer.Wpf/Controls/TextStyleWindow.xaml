<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.TextStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Text Style" Width="780" Height="560" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <!-- Header: the title with the drawing's name, dragged to move the dialog, and the close button (Close). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Command="{Binding CloseCommand}" ToolTip="Close" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the current style and how many, then Cancel, Apply (enabled by a change) and Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="Apply" Padding="14,5" Margin="0,0,8,0" Click="OnApply" IsEnabled="{Binding IsDirty}" />
                        <Button Style="{StaticResource GhCloseButton}" Content="Close" Padding="14,5" Command="{Binding CloseCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Footer}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The styles: the filter, the list with each style's font, Set current, New, Rename and Delete. -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StyleGroup}" Text="Styles" />
                    <ComboBox DockPanel.Dock="Top" Style="{StaticResource GhComboBox}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Bottom" Text="Standard, the current style and a style in use cannot be deleted." Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Style="{StaticResource StyleSideButton}" Content="Set current" Command="{Binding SetCurrentCommand}" Margin="0,0,3,6" />
                        <Button Style="{StaticResource StyleSideButton}" Content="New…" Command="{Binding NewCommand}" Margin="3,0,0,6" />
                        <Button Style="{StaticResource StyleSideButton}" Content="Rename…" Command="{Binding RenameCommand}" Margin="0,0,3,0" />
                        <Button Style="{StaticResource StyleSideButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="3,0,0,0" />
                    </UniformGrid>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4">
                        <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource GhText}" ItemContainerStyle="{StaticResource StyleListItem}" ItemTemplate="{StaticResource StyleRowTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                </DockPanel>

                <!-- The preview, then Font beside Size and Effects, then the notice. -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StyleGroup}" Text="{Binding PreviewTitle}" Margin="0,0,0,8" />
                    <Border DockPanel.Dock="Top" Style="{StaticResource StylePreview}" Height="96" Margin="0,0,0,8">
                        <Image Source="{Binding Preview}" Stretch="None" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource StyleFrame}" Visibility="{Binding HasNotice, Converter={StaticResource Shown}}" VerticalAlignment="Bottom">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top" Fill="{StaticResource GhWarn}" />
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource StyleGroup}" Text="Font" />
                            <TextBlock Style="{StaticResource StyleLabel}" Text="Font name" Margin="0,0,0,3" />
                            <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding FontNames}" SelectedValuePath="Name" SelectedValue="{Binding FontName, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource FontItemTemplate}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource StyleLabel}" Text="Font style (TrueType)" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,6">
                                <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding FontStyles}" SelectedItem="{Binding FontStyle, Mode=TwoWay}"
                                          Visibility="{Binding IsTrueType, Converter={StaticResource Shown}}" />
                                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="2" Background="{StaticResource GhInput}" Padding="6,3"
                                        Visibility="{Binding IsVerticalEnabled, Converter={StaticResource Shown}}">
                                    <TextBlock Text="{Binding FontStyleUnused}" Foreground="{StaticResource GhTextMuted}" />
                                </Border>
                            </Grid>
                            <CheckBox Style="{StaticResource StyleCheck}" IsChecked="{Binding UseBigFont, Mode=TwoWay}" IsEnabled="{Binding IsVerticalEnabled}" Content="Use big font" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource StyleLabel}" Text="Big font" Margin="0,0,0,3" />
                            <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding BigFonts}" SelectedItem="{Binding BigFont, Mode=TwoWay}" IsEnabled="{Binding UseBigFont}"
                                      FontFamily="{StaticResource GhMonoFont}" Margin="0,0,0,6" />
                            <TextBlock Text="Fonts are found in the font search folders of Global settings › Fonts." Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource StyleGroup}" Text="Size" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource StyleBox}" Width="90" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource StyleLabel}" Text="Height" />
                            </DockPanel>
                            <TextBlock Text="0 asks for the height each time TEXT is used." Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource StyleGroup}" Text="Effects" Margin="0,12,0,6" />
                            <CheckBox Style="{StaticResource StyleCheck}" IsChecked="{Binding UpsideDown, Mode=TwoWay}" Content="Upside down" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource StyleCheck}" IsChecked="{Binding Backwards, Mode=TwoWay}" Content="Backwards" Margin="0,0,0,6" />
                            <CheckBox x:Name="VerticalBox" Style="{StaticResource StyleCheck}" IsChecked="{Binding Vertical, Mode=TwoWay}" IsEnabled="{Binding IsVerticalEnabled}"
                                      Content="{Binding VerticalText}" Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource StyleBox}" Width="90" Text="{Binding WidthFactor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource StyleLabel}" Text="Width factor" />
                            </DockPanel>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource StyleBox}" Width="90" Text="{Binding ObliqueAngle, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource StyleLabel}" Text="Oblique angle" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
