<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.MLeaderStyleEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Modify Multileader Style"
    Width="800"
    Height="640"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A button of a pair before a label: a ring, the accent's dot inside when chosen, greyed when off. -->
            <Style x:Key="LeadRadio" TargetType="RadioButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Width="13" Height="13" Background="Transparent">
                                <Ellipse
                                    x:Name="Ring"
                                    Fill="{StaticResource GhInput}"
                                    Stroke="{StaticResource GhTextMuted}"
                                    StrokeThickness="1"
                                />
                                <Ellipse
                                    x:Name="Dot"
                                    Width="7"
                                    Height="7"
                                    Fill="{StaticResource GhAccent}"
                                    Visibility="Collapsed"
                                />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Dot" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- An item of a list, greyed and not chosen where it cannot be. -->
            <Style x:Key="ChoiceItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="6,3">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
            A field of the dialog, as the design lays it: the box or the button before the label where it has one, the label,
            then a box 200 wide holding a number (80 wide), a text with its "…", or a list with the colour's swatch before it and
            the "…" of the Text Style dialog after it; a group's title instead for a header. Greyed where it means nothing.
            -->
            <DataTemplate x:Key="MLeaderFieldTemplate" DataType="{x:Type local:MLeaderFieldViewModel}">
                <Grid x:Name="Row" Margin="0,2" Visibility="{Binding IsShown, Converter={StaticResource Shown}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="Title"
                        Grid.ColumnSpan="2"
                        Text="{Binding Label}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,7,0,3"
                        Visibility="Collapsed"
                    />
                    <StackPanel x:Name="Caption" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <CheckBox
                            x:Name="LeadCheck"
                            Style="{StaticResource StyleCheck}"
                            IsChecked="{Binding LeadChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsLeadEnabled}"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                        />
                        <RadioButton
                            x:Name="LeadRadio"
                            Style="{StaticResource LeadRadio}"
                            GroupName="{Binding Lead}"
                            IsChecked="{Binding LeadChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsLeadEnabled}"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                        />
                        <TextBlock x:Name="CaptionText" Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DockPanel x:Name="Control" Grid.Column="1" IsEnabled="{Binding IsEnabled}">
                        <Border
                            x:Name="Swatch"
                            DockPanel.Dock="Left"
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            BorderBrush="#5B6573"
                            BorderThickness="1"
                            Background="{Binding SwatchRgb, Converter={StaticResource RgbBrush}}"
                            Visibility="Collapsed"
                        />
                        <Button
                            x:Name="TextStyles"
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Content="…"
                            Width="26"
                            Padding="0,3"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            Command="{Binding DataContext.TextStylesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ToolTip="Open the Text style dialog"
                        />
                        <Button
                            x:Name="EditText"
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Content="…"
                            Width="26"
                            Padding="0,3"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            IsEnabled="False"
                            ToolTip="Edit the default text in place (type it in the box)"
                        />
                        <Grid>
                            <TextBox
                                x:Name="Number"
                                Style="{StaticResource StyleBox}"
                                Width="80"
                                HorizontalAlignment="Left"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed"
                            />
                            <TextBox
                                x:Name="Typed"
                                Style="{StaticResource StyleBox}"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed"
                            />
                            <ComboBox
                                x:Name="Pick"
                                Style="{StaticResource GhComboBox}"
                                ItemsSource="{Binding Choices}"
                                SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                DisplayMemberPath="Label"
                                ItemContainerStyle="{StaticResource ChoiceItem}"
                                Visibility="Collapsed"
                            />
                        </Grid>
                    </DockPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasLeadCheck}" Value="True">
                        <Setter TargetName="LeadCheck" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasLeadRadio}" Value="True">
                        <Setter TargetName="LeadRadio" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding More}" Value="textstyle">
                        <Setter TargetName="TextStyles" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding More}" Value="text">
                        <Setter TargetName="EditText" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Header">
                        <Setter TargetName="Title" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Control" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Number">
                        <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                        <Setter TargetName="Typed" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Choice">
                        <Setter TargetName="Pick" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Swatch" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SwatchRgb}" Value="{x:Null}">
                        <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasLeadCheck}" Value="True">
                        <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource GhText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasLeadRadio}" Value="True">
                        <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource GhText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsLeadEnabled}" Value="False">
                        <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                        <Setter TargetName="Number" Property="Foreground" Value="{StaticResource GhError}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: where the values are kept, then Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="The values are kept in the MLEADERSTYLE object of the drawing."
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- The three tabs, in the design's order, over a line. -->
            <Border
                DockPanel.Dock="Top"
                Padding="16,8,16,0"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
            >
                <ItemsControl ItemsSource="{Binding TabChips}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Style="{StaticResource StyleTab}"
                                Content="{Binding Name}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>

                <!-- The fields of the tab shown, by groups. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Fields}"
                        ItemTemplate="{StaticResource MLeaderFieldTemplate}"
                        Focusable="False"
                    />
                </ScrollViewer>

                <!-- The preview, the description of the tab and what OK does. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,8" />
                    <Border Style="{StaticResource StylePreview}" Height="190" Margin="0,0,0,8">
                        <Image Source="{Binding Preview}" Stretch="None" />
                    </Border>
                    <Border Style="{StaticResource StyleFrame}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Description" Foreground="{StaticResource GhTextMuted}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StyleFrame}">
                        <DockPanel>
                            <Ellipse
                                DockPanel.Dock="Left"
                                Width="8"
                                Height="8"
                                Margin="0,4,8,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource NoticeDot}"
                            />
                            <TextBlock
                                Text="{Binding Notice}"
                                Foreground="{StaticResource GhTextMuted}"
                                TextWrapping="Wrap"
                            />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
