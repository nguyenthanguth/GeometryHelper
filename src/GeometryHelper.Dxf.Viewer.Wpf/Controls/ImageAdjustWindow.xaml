<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ImageAdjustWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Image Adjust"
    Width="500"
    Height="280"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="80" />
            </Style>
            <Style x:Key="Level" TargetType="Slider">
                <Setter Property="Width" Value="170" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
                <Setter Property="TickFrequency" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design ImageAdjust: Brightness, Contrast and Fade, the preview, Reset. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Image Adjust" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Reset"
                        Padding="14,5"
                        Click="OnReset"
                    />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            Click="OnOk"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Brightness" Style="{StaticResource Muted}" />
                        <Slider
                            Style="{StaticResource Level}"
                            AutomationProperties.Name="Brightness"
                            Value="{Binding Brightness, Mode=TwoWay}"
                        />
                        <TextBox
                            Width="44"
                            Style="{StaticResource StyleBox}"
                            AutomationProperties.Name="Brightness value"
                            Text="{Binding Brightness, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Contrast" Style="{StaticResource Muted}" />
                        <Slider
                            Style="{StaticResource Level}"
                            AutomationProperties.Name="Contrast"
                            Value="{Binding Contrast, Mode=TwoWay}"
                        />
                        <TextBox
                            Width="44"
                            Style="{StaticResource StyleBox}"
                            AutomationProperties.Name="Contrast value"
                            Text="{Binding Contrast, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Fade" Style="{StaticResource Muted}" />
                        <Slider
                            Style="{StaticResource Level}"
                            AutomationProperties.Name="Fade"
                            Value="{Binding Fade, Mode=TwoWay}"
                        />
                        <TextBox
                            Width="44"
                            Style="{StaticResource StyleBox}"
                            AutomationProperties.Name="Fade value"
                            Text="{Binding Fade, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <TextBlock
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="{Binding Caption}"
                    />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Preview" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,6" />
                    <Border
                        Width="160"
                        Height="120"
                        Background="Black"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                    >
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                            <TextBlock
                                Text="No picture found"
                                Foreground="{StaticResource GhTextMuted}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasPicture, Converter={StaticResource Hidden}}"
                            />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
