<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.DataLinkNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename Data Link"
    Width="380"
    Height="170"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design DataLinkName: the new name of a data link. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <TextBlock Text="Rename Data Link" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                        IsDefault="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>
            <StackPanel Margin="16,14">
                <TextBlock
                    Text="Enter the new name of the data link:"
                    Foreground="{StaticResource GhTextMuted}"
                    Margin="0,0,0,6"
                />
                <TextBox
                    x:Name="NameBox"
                    Style="{StaticResource StyleBox}"
                    AutomationProperties.Name="Data link name"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
