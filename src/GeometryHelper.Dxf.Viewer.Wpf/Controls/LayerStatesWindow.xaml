<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LayerStatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Layer States Manager"
    Width="820"
    Height="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StateRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Layer States Manager"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Padding="10,5"
                        Click="OnFold"
                        ToolTip="Fewer restore options"
                        AutomationProperties.Name="Fewer restore options"
                    >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                                <Setter Property="Content" Value="&lt;&lt;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProperties}" Value="False">
                                        <Setter Property="Content" Value="&gt;&gt;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Restore"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnRestore"
                            IsEnabled="{Binding HasSelected}"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Close"
                            Padding="14,5"
                            Background="{StaticResource GhClose}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="OnClose"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="The Layer properties panel folds away with &lt;&lt; and opens with &gt;&gt;."
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Layer states" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                    >
                        <Run Text="Current layer state:" />
                        <Run Text="{Binding Current, Mode=OneWay}" Foreground="{StaticResource GhText}" />
                        <Run Text="· &quot;Same as DWG&quot; is No when a layer differs from the state. Apply properties as viewport overrides is greyed in model space." />
                    </TextBlock>
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Margin="0,6,0,0"
                        Foreground="{StaticResource GhError}"
                        TextWrapping="Wrap"
                        Text="{Binding Message}"
                    >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <HeaderedContentControl
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource BlockGroup}"
                        Header="Restore options"
                        Margin="0,8,0,0"
                    >
                        <StackPanel>
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Turn off layers not found in layer state"
                                IsChecked="{Binding TurnOffMissing, Mode=TwoWay}"
                                Margin="0,0,0,6"
                            />
                            <CheckBox
                                Style="{StaticResource StyleCheck}"
                                Content="Apply properties as viewport overrides"
                                IsChecked="{Binding AsViewportOverrides, Mode=TwoWay}"
                                IsEnabled="{Binding CanOverride}"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                    <CheckBox
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource StyleCheck}"
                        Content="Don't list layer states in Xrefs"
                        IsChecked="{Binding HideXrefStates, Mode=TwoWay}"
                        Margin="0,8,0,0"
                    />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Name"
                                    Padding="8,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="Space"
                                    Padding="8,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="Same as DWG"
                                    Padding="8,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="Description"
                                    Padding="8,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                            </Grid>
                            <ListBox
                                ItemsSource="{Binding States}"
                                SelectedItem="{Binding Selected, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource StateRow}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch"
                            >
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LayerStateRowViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                Padding="8,5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource GhText}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Space}"
                                                Padding="8,5"
                                                Foreground="{StaticResource GhText}"
                                            />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding Same}"
                                                Padding="8,5"
                                                Foreground="{StaticResource GhText}"
                                            />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding Description}"
                                                Padding="8,5"
                                                Foreground="{StaticResource GhTextMuted}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="2" Margin="0,24,0,0">
                    <Button Style="{StaticResource SideButton}" Content="New…" Click="OnNew" />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Update"
                        Click="OnUpdate"
                        IsEnabled="{Binding HasSelected}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Edit…"
                        Click="OnEdit"
                        IsEnabled="{Binding HasSelected}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Rename"
                        Click="OnRename"
                        IsEnabled="{Binding HasSelected}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Delete"
                        Click="OnDelete"
                        IsEnabled="{Binding HasSelected}"
                    />
                    <Border Height="6" />
                    <Button Style="{StaticResource SideButton}" Content="Import…" Click="OnImport" />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Export…"
                        Click="OnExport"
                        IsEnabled="{Binding HasSelected}"
                    />
                </StackPanel>

                <HeaderedContentControl
                    Grid.Column="4"
                    Style="{StaticResource BlockGroup}"
                    Header="Layer properties to restore"
                    Margin="0"
                    Visibility="{Binding ShowProperties, Converter={StaticResource Shown}}"
                >
                    <DockPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Select All"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="OnSelectAll"
                                IsEnabled="{Binding HasSelected}"
                            />
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Clear All"
                                Padding="6,4"
                                Margin="3,0,0,0"
                                Click="OnClearAll"
                                IsEnabled="{Binding HasSelected}"
                            />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LayerStatePropertyViewModel}">
                                    <CheckBox
                                        Style="{StaticResource StyleCheck}"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Margin="0,0,0,5"
                                        AutomationProperties.Name="{Binding Name}"
                                    />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </HeaderedContentControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
