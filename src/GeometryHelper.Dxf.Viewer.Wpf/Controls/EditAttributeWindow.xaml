<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.EditAttributeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Attribute" Width="600" Height="560" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Edit Attribute" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10">
                <TextBlock Text="Active Block: " Foreground="{StaticResource GhTextMuted}" />
                <TextBlock Text="{Binding Block}" FontWeight="SemiBold" />
            </StackPanel>

            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,0,1" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource StyleTab}" GroupName="Tabs" Content="Attribute" IsChecked="True" Checked="OnTab" />
                    <RadioButton Style="{StaticResource StyleTab}" GroupName="Tabs" Content="Text Options" Checked="OnTab" x:Name="TextTab" />
                    <RadioButton Style="{StaticResource StyleTab}" GroupName="Tabs" Content="Properties" Checked="OnTab" x:Name="PropertiesTab" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="14,5" Click="OnOk" IsDefault="True" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource StyleCheck}" Content="Auto preview changes" IsEnabled="False" VerticalAlignment="Center"
                              ToolTip="Not built: the INSERTs show a change once it is applied, or synchronized." />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <!-- Attribute: the modes and the data. -->
                <StackPanel Visibility="{Binding IsAttributeTab, Converter={StaticResource Shown}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Mode">
                            <StackPanel>
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Invisible" IsChecked="{Binding Invisible, Mode=TwoWay}" />
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Constant" IsChecked="{Binding Constant, Mode=OneWay}" IsEnabled="False" />
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Verify" IsChecked="{Binding Verify, Mode=TwoWay}" />
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Preset" IsChecked="{Binding Preset, Mode=TwoWay}" />
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Lock position" IsChecked="{Binding LockPosition, Mode=TwoWay}" />
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Multiple lines" IsChecked="{Binding MultipleLines, Mode=OneWay}" IsEnabled="False" Margin="0" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Grid.Column="2" Style="{StaticResource BlockGroup}" Header="Data">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tag:" />
                                <TextBox Grid.Column="1" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" AutomationProperties.Name="Tag" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Prompt:" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BlockBox}" BorderBrush="{StaticResource GhAccent}" Margin="0,0,0,8" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prompt" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Default:" Margin="0" />
                                <DockPanel Grid.Row="2" Grid.Column="1">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhDialogButton}" Content="%" Width="30" Padding="0" Margin="6,0,0,0" IsEnabled="False" ToolTip="Insert field (not built)" />
                                    <TextBox Style="{StaticResource BlockNumber}" Text="{Binding Default, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default" />
                                </DockPanel>
                            </Grid>
                        </HeaderedContentControl>
                    </Grid>
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap"
                               Text="Constant and Multiple lines are fixed when the attribute is defined (ATTDEF) and stay greyed here. A change of Tag or Default reaches existing references only after Sync, or at once when the Settings say Apply changes to existing references." />
                </StackPanel>

                <!-- Text Options. -->
                <StackPanel Visibility="{Binding IsTextTab, Converter={StaticResource Shown}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Text Style:" />
                        <ComboBox Grid.Column="1" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding Styles}" SelectedItem="{Binding TextStyle, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Justification:" />
                        <ComboBox Grid.Column="4" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding Justifications}" SelectedItem="{Binding Justification, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Height:" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Rotation:" />
                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Backwards:" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Style="{StaticResource BlockCheck}" Margin="0,0,0,8" IsChecked="{Binding Backwards, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Upside down:" />
                        <CheckBox Grid.Row="2" Grid.Column="4" Style="{StaticResource BlockCheck}" Margin="0,0,0,8" IsChecked="{Binding UpsideDown, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Width Factor:" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding WidthFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Oblique Angle:" />
                        <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding Oblique, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Annotative:" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Style="{StaticResource BlockCheck}" Margin="0,0,0,8" IsEnabled="False" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Boundary Width:" />
                        <TextBox Grid.Row="4" Grid.Column="4" Style="{StaticResource BlockNumber}" Margin="0,0,0,8" Text="{Binding BoundaryWidth, Mode=OneWay}" IsEnabled="False" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Text="Boundary Width is greyed for a single-line attribute; it opens for Multiple lines." />
                </StackPanel>

                <!-- Properties. -->
                <Grid Visibility="{Binding IsPropertiesTab, Converter={StaticResource Shown}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Layer:" />
                    <ComboBox Grid.Column="1" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Linetype:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding Linetypes}" SelectedItem="{Binding Linetype, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Color:" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding Colors}" SelectedItem="{Binding Color, Mode=TwoWay}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Lineweight:" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource GhComboBox}" Margin="0,0,0,8" ItemsSource="{Binding LineWeights}" SelectedItem="{Binding LineWeight, Mode=TwoWay}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Plot style:" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource BlockBox}" Margin="0,0,0,8" Text="ByColor (not available)" IsEnabled="False" />
                </Grid>

                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource GhError}" TextWrapping="Wrap" Text="{Binding Message}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
