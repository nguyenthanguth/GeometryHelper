<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.BlockAttributeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Block Attribute Manager" Width="820" Height="540" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A row of the grid of attributes; the one chosen on the selection colour. -->
            <Style x:Key="ManagerRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Block Attribute Manager" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="16,10">
                <Button Style="{StaticResource GhDialogButton}" Padding="10,4" Click="OnSelectBlock" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BlockSelectIcon}" Stroke="#C9D1DB" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Select block" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Block:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Style="{StaticResource GhComboBox}" Width="220" FontFamily="{StaticResource GhMonoFont}" ItemsSource="{Binding Blocks}" SelectedItem="{Binding Block, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Block" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Found in drawing: " Foreground="{StaticResource GhTextMuted}" />
                    <TextBlock Text="{Binding FoundInDrawing}" Margin="0,0,10,0" />
                    <TextBlock Text="Found in model space: " Foreground="{StaticResource GhTextMuted}" />
                    <TextBlock Text="{Binding FoundInModelSpace}" />
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button Style="{StaticResource GhDialogButton}" Content="Settings…" Padding="14,5" Click="OnSettings" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhDialogButton}" Content="Apply" Padding="14,5" Margin="0,0,8,0" Click="OnApply" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="14,5" Click="OnOk" IsDefault="True" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Padding="10,8" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource GhAccent}" VerticalAlignment="Top" Margin="0,4,8,0" />
                    <TextBlock Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap"
                               Text="Modes: I invisible · C constant · V verify · P preset · L lock position · M multiple lines. Apply and OK write the block; Sync rewrites every reference of the block to this order and these definitions, keeping the values typed in them." />
                </DockPanel>
            </Border>

            <Grid Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Columns}" Background="{StaticResource GhHeader}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AttributeColumnViewModel}">
                                    <TextBlock Text="{Binding Name}" Width="{Binding Width}" Padding="10,6" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GhTextMuted}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox x:Name="AttributeGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ManagerRow}" MouseDoubleClick="OnRowDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AttributeManagerRowViewModel}">
                                    <ItemsControl x:Name="Cells" ItemsSource="{Binding Cells}" Foreground="{StaticResource GhText}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:AttributeCellViewModel}">
                                                <TextBlock x:Name="Cell" Text="{Binding Text}" Width="{Binding Width}" Padding="10,5" TextTrimming="CharacterEllipsis" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                        <Setter TargetName="Cell" Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                            <Setter TargetName="Cells" Property="Foreground" Value="{StaticResource GhError}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Button Style="{StaticResource SideButton}" Content="Sync" Click="OnSync" />
                    <Button Style="{StaticResource SideButton}" Content="Move Up" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}" />
                    <Button Style="{StaticResource SideButton}" Content="Move Down" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}" />
                    <Button Style="{StaticResource StylePrimaryButton}" Content="Edit…" Padding="8,5" Margin="0,0,0,6" Click="OnEdit" IsEnabled="{Binding CanEdit}" />
                    <Button Style="{StaticResource SideButton}" Content="Remove" Click="OnRemove" IsEnabled="{Binding CanRemove}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
