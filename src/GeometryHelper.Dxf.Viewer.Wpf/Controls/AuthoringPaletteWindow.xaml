<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.AuthoringPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="220"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close, BAUTHORPALETTECLOSE"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Two tabs, as AutoCAD's palette names them; each a column of tools that start BPARAMETER or BACTION. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,0">
                <RadioButton
                    x:Name="ParametersTab"
                    Style="{StaticResource BlockRadio}"
                    Content="Parameters"
                    IsChecked="True"
                    Checked="OnTab"
                    Margin="0,0,12,0"
                    AutomationProperties.Name="Parameters tab"
                />
                <RadioButton
                    x:Name="ActionsTab"
                    Style="{StaticResource BlockRadio}"
                    Content="Actions"
                    Checked="OnTab"
                    AutomationProperties.Name="Actions tab"
                />
            </StackPanel>

            <Grid Margin="8">
                <ItemsControl x:Name="ParametersList" ItemsSource="{Binding Parameters}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="{Binding Name}"
                                Command="{Binding Command}"
                                ToolTip="{Binding ToolTip}"
                                HorizontalContentAlignment="Left"
                                Padding="10,4"
                                Margin="0,0,0,4"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl
                    x:Name="ActionsList"
                    ItemsSource="{Binding Actions}"
                    Focusable="False"
                    Visibility="Collapsed"
                >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="{Binding Name}"
                                Command="{Binding Command}"
                                ToolTip="{Binding ToolTip}"
                                HorizontalContentAlignment="Left"
                                Padding="10,4"
                                Margin="0,0,0,4"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
