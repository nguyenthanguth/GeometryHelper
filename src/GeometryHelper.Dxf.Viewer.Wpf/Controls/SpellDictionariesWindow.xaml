<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.SpellDictionariesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dictionaries"
    Width="440"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The Text Editor tab's Edit Dictionaries: the main dictionary, the custom dictionary file, and its words with Add and Delete. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Dictionaries" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="18,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="#FF8A7A"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                <TextBlock Style="{StaticResource StyleLabel}" Text="Main dictionary:" Margin="0,0,0,4" />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Padding="6,3"
                    IsReadOnly="True"
                    AutomationProperties.Name="Main dictionary"
                    Text="{Binding MainDictionary, Mode=OneWay}"
                />
                <TextBlock Style="{StaticResource StyleLabel}" Text="Custom dictionary file:" Margin="0,10,0,4" />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Padding="6,3"
                    IsReadOnly="True"
                    ToolTip="A text file of words, one to a line"
                    AutomationProperties.Name="Custom dictionary file"
                    Text="{Binding CustomFile, Mode=OneWay}"
                />
                <TextBlock
                    Style="{StaticResource StyleLabel}"
                    Text="Add a word to the custom dictionary:"
                    Margin="0,10,0,4"
                />
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Padding="14,5"
                        Margin="6,0,0,0"
                        Content="Add"
                        Command="{Binding AddCommand}"
                    />
                    <TextBox
                        x:Name="WordBox"
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        AutomationProperties.Name="Word to add"
                        Text="{Binding NewWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnWordKey"
                    />
                </DockPanel>
                <TextBlock
                    Style="{StaticResource StyleLabel}"
                    Text="Words in the custom dictionary:"
                    Margin="0,10,0,4"
                />
            </StackPanel>

            <Grid Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ListBox
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    Foreground="{StaticResource GhText}"
                    ItemContainerStyle="{StaticResource StyleListItem}"
                    AutomationProperties.Name="Custom words"
                    ItemsSource="{Binding Words}"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource GhDialogButton}"
                    Padding="8,5"
                    Margin="6,0,0,0"
                    VerticalAlignment="Top"
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                />
            </Grid>
        </DockPanel>
    </Border>
</Window>
