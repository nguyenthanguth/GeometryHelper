<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.CustomImageSizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Custom Image Size"
    Width="400"
    Height="320"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- Custom Image Size (design PlotRasterCustom), from Custom… of a raster device's Paper size list. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Custom Image Size"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Click="OnOk"
                        IsDefault="True"
                        IsEnabled="{Binding CanOk}"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,12">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Size in pixels">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Width:"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8"
                        />
                        <TextBox
                            x:Name="WidthBox"
                            Grid.Column="1"
                            Margin="0,0,8,8"
                            Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Width in pixels"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource BlockNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWidthValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#F26B3A" />
                                            <Setter Property="ToolTip" Value="{Binding RangeTip}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock
                            Grid.Column="2"
                            Text="pixels"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8"
                        />
                        <TextBlock
                            Grid.Row="1"
                            Text="Height:"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Height in pixels"
                        >
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource BlockNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeightValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#F26B3A" />
                                            <Setter Property="ToolTip" Value="{Binding RangeTip}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="pixels"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                    </Grid>
                </HeaderedContentControl>
                <DockPanel Margin="0,10,0,0">
                    <Grid DockPanel.Dock="Left" Width="70" Height="50" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Border
                            Width="{Binding PictureWidth}"
                            Height="{Binding PictureHeight}"
                            Background="White"
                            BorderBrush="{StaticResource GhTextMuted}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                        />
                    </Grid>
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
