<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.XrefBindWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bind Xrefs/DGN Underlays"
    Width="380"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <StackPanel>
            <Border
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close, same as Cancel"
                    />
                    <TextBlock
                        Text="Bind Xrefs/DGN Underlays"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Bind Type">
                    <StackPanel>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="Bind"
                            IsChecked="{Binding IsBind, Mode=TwoWay}"
                            Margin="0"
                        />
                        <TextBlock
                            Text="Names renamed after the reference: layer WALL of grid-base becomes grid-base$0$WALL."
                            Foreground="{StaticResource GhTextMuted}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="19,0,0,6"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="Insert"
                            IsChecked="{Binding IsInsert, Mode=TwoWay}"
                            Margin="0"
                        />
                        <TextBlock
                            Text="Merged by name, as if detached and inserted: WALL stays WALL, the drawing's own kept."
                            Foreground="{StaticResource GhTextMuted}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="19,0,0,0"
                        />
                    </StackPanel>
                </HeaderedContentControl>
                <TextBlock
                    Text="{Binding NamesText}"
                    Foreground="{StaticResource GhTextMuted}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                />
            </StackPanel>

            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Click="OnOk"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
