<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.UserDefinedFieldsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="User Defined Fields"
    Width="400"
    Height="360"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design PlotStampUserFields: the user's fields, Add, Edit and Delete, the words of the one picked edited below. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="User Defined Fields"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnOk"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        IsCancel="True"
                        Click="OnCancel"
                    />
                </StackPanel>
            </Border>

            <DockPanel Margin="16,12">
                <StackPanel DockPanel.Dock="Right" Width="86" Margin="12,0,0,0">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Add"
                        Padding="8,5"
                        Margin="0,0,0,6"
                        Click="OnAdd"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Edit"
                        Padding="8,5"
                        Margin="0,0,0,6"
                        IsEnabled="{Binding HasPicked}"
                        Click="OnEdit"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Delete"
                        Padding="8,5"
                        IsEnabled="{Binding HasPicked}"
                        Click="OnDelete"
                    />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsEnabled="{Binding HasPicked}">
                    <TextBlock Text="Field text" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,4" />
                    <TextBox
                        x:Name="FieldText"
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Field text"
                        Text="{Binding Picked.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </StackPanel>
                <ListBox
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    Foreground="{StaticResource GhText}"
                    ItemContainerStyle="{StaticResource StyleListItem}"
                    AutomationProperties.Name="User defined fields"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding Picked, Mode=TwoWay}"
                    MouseDoubleClick="OnEdit"
                >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
