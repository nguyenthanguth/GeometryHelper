<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.MissingShxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Missing SHX files" Width="640" Height="460" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />

            <!-- A choice of what to do: a card with its round button, outlined in the accent and lit when chosen. -->
            <Style x:Key="ChoiceCard" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" Background="{StaticResource GhBg}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="12,8">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="13" Height="13" Margin="0,2,10,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1" Fill="{StaticResource GhInput}" />
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource GhAccent}" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#1A2533" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- An item of a replacement list: a font with its tag, the heading in small muted type, the line, or Browse…. -->
            <Style x:Key="OptionItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="IsEnabled" Value="{Binding IsChoosable}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="10,4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Row" Property="Padding" Value="0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter TargetName="Row" Property="Padding" Value="10,3" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="OptionTemplate" DataType="{x:Type local:MissingShxOption}">
                <Grid>
                    <DockPanel x:Name="Font">
                        <!-- The tag in the open list alone: the closed box, no item of a list, shows the name. -->
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Foreground="{StaticResource GhIcon}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource Shown}, FallbackValue=Collapsed}" />
                        <TextBlock x:Name="Name" Text="{Binding Name}" FontFamily="{StaticResource GhMonoFont}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border x:Name="Line" Height="1" Background="{StaticResource GhBorder}" Visibility="Collapsed" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                        <Setter TargetName="Name" Property="FontFamily" Value="{StaticResource GhFont}" />
                        <Setter TargetName="Name" Property="FontSize" Value="11" />
                        <Setter TargetName="Name" Property="FontWeight" Value="Medium" />
                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                        <Setter TargetName="Font" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Browse">
                        <Setter TargetName="Name" Property="FontFamily" Value="{StaticResource GhFont}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10" Margin="0,4,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="22,5" Margin="0,0,8,0" Click="OnOk" IsDefault="True" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource GhCheckBox}" IsChecked="{Binding DoNotShowAgain, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Do not show again" VerticalAlignment="Center" MouseLeftButtonDown="OnDoNotShowAgainText" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The warning and what it means. -->
                <DockPanel Margin="0,0,0,10">
                    <local:IconView DockPanel.Dock="Left" Size="20" StrokeThickness="2" Stroke="#E3B341" Data="M12 3 2 20h20zM12 10v4M12 17v.5"
                                    VerticalAlignment="Top" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                </DockPanel>

                <!-- The table: the missing file, the styles that use it, what it is drawn in or the replacement chosen. -->
                <Border Grid.Row="1" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Background="{StaticResource GhBg}" Margin="0,0,0,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}" TextElement.Foreground="{StaticResource GhTextMuted}"
                              TextElement.FontSize="11" TextElement.FontWeight="Medium">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Missing file" Margin="10,5" />
                            <TextBlock Grid.Column="1" Text="Styles that use it" Margin="10,5" />
                            <TextBlock Grid.Column="2" Text="Drawn in" Margin="10,5" />
                        </Grid>
                        <ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MissingShxRowViewModel}">
                                        <Border BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0" MinHeight="32">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="210" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="10,4">
                                                    <TextBlock Text="{Binding File}" FontFamily="{StaticResource GhMonoFont}" VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource GhSelected}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsBigFont, Converter={StaticResource Shown}}">
                                                        <TextBlock Text="BIG FONT" FontSize="9" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Styles}" Foreground="{StaticResource GhIcon}" Margin="10,4" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <Grid Grid.Column="2" Margin="10,4" VerticalAlignment="Center">
                                                    <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Options}" SelectedItem="{Binding Replacement, Mode=TwoWay}"
                                                              ItemContainerStyle="{StaticResource OptionItem}" ItemTemplate="{StaticResource OptionTemplate}"
                                                              ToolTip="{Binding File, StringFormat='Replacement for {0}'}"
                                                              Visibility="{Binding DataContext.Replace, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Shown}}" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.Replace, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Hidden}}">
                                                        <TextBlock Text="{Binding DrawnInText}" FontFamily="{StaticResource GhMonoFont}" />
                                                        <TextBlock Text=" (FONTALT)" Foreground="{StaticResource GhTextMuted}"
                                                                   Visibility="{Binding IsDrawnByFontAlt, Converter={StaticResource Shown}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- What to do. -->
                <StackPanel Grid.Row="2">
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Shx" IsChecked="{Binding Replace, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Specify a replacement for each SHX file" FontWeight="SemiBold" />
                            <TextBlock Text="Pick a font for each row from the fonts found, or Browse… for a file. The choice holds while the drawing is open."
                                       Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Shx" IsChecked="{Binding Ignore, Mode=TwoWay}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Ignore the missing SHX files and continue" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IgnoreDetail}" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
