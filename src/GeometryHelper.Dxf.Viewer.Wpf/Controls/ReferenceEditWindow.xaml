<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ReferenceEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reference Edit"
    Width="460"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Reference Edit: no Design artifact yet (the maintainer's design-first rule is waived for this round); laid out in the
         look of the Bind Xrefs and Annotation Object Scale dialogs: header, one group for the references and how the objects
         are taken, one for the settings, OK and Cancel in the footer. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <StackPanel>
            <Border
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close, same as Cancel"
                    />
                    <TextBlock Text="Reference Edit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,10,16,14">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Identify Reference">
                    <StackPanel>
                        <TextBlock Text="Reference name" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,4" />
                        <ListBox
                            Height="110"
                            Background="{StaticResource GhInput}"
                            BorderBrush="{StaticResource GhBorder}"
                            Foreground="{StaticResource GhText}"
                            ItemContainerStyle="{StaticResource StyleListItem}"
                            AutomationProperties.Name="Reference name"
                            ItemsSource="{Binding References}"
                            SelectedItem="{Binding Picked, Mode=TwoWay}"
                        >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Text="{Binding Kind}"
                                            Foreground="{StaticResource GhTextMuted}"
                                        />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Margin="{Binding Indent}"
                                            FontFamily="{StaticResource GhMonoFont}"
                                        />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Path" Foreground="{StaticResource GhTextMuted}" Margin="0,8,0,2" />
                        <TextBlock
                            Text="{Binding PathText}"
                            FontFamily="{StaticResource GhMonoFont}"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding PathText}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="Automatically select all nested objects"
                            IsChecked="{Binding IsAutomatic, Mode=TwoWay}"
                            Margin="0,10,0,0"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="Prompt to select nested objects"
                            IsChecked="{Binding IsPrompt, Mode=TwoWay}"
                            Margin="0"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Settings" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Enable unique layer and symbol names"
                            IsEnabled="{Binding IsExternal}"
                            IsChecked="{Binding UniqueNames, Mode=TwoWay}"
                        />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Display attribute definitions for editing"
                            IsEnabled="{Binding HasAttributeDefinitions}"
                            IsChecked="{Binding DisplayAttributeDefinitions, Mode=TwoWay}"
                        />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Lock objects not in working set"
                            IsChecked="{Binding LockObjects, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>

            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Click="OnOk"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
