<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.DataExtractionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Data Extraction"
    Width="780"
    Height="640"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PageShownConverter x:Key="PageShown" />

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="ListRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListFrame" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
            </Style>

            <DataTemplate x:Key="CheckRow" DataType="{x:Type local:DataExtractionCheckRow}">
                <DockPanel Margin="8,3">
                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding Count}"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="8,0,4,0"
                    />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding Category}"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="8,0,4,0"
                    />
                    <CheckBox
                        Style="{StaticResource BlockCheck}"
                        Content="{Binding Name}"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    />
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design DataExtraction: the wizard, eight pages: Begin, Define Data Source, Select Objects, Select Properties, Refine Data, Choose Output, Table Style, Finish. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="{Binding PageTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="&lt; Back"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Command="{Binding BackCommand}"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Next &gt;"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Command="{Binding NextCommand}"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Finish"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Command="{Binding FinishCommand}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding PageHelp}"
                TextWrapping="Wrap"
                Margin="16,12,16,4"
                Foreground="{StaticResource GhTextMuted}"
            />

            <Grid Margin="16,8,16,12">
                <!-- Page 1: Begin -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=0}">
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Start"
                        Content="Create a new data extraction"
                        Margin="0,8,0,8"
                        IsChecked="{Binding IsCreateNew, Mode=TwoWay}"
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Start"
                        Content="Use previous extraction as a template (.dxe)"
                        Margin="0,0,0,8"
                        IsChecked="{Binding IsUseTemplate, Mode=TwoWay}"
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Start"
                        Content="Edit an existing data extraction"
                        Margin="0,0,0,8"
                        IsChecked="{Binding IsEditExisting, Mode=TwoWay}"
                    />
                    <DockPanel Margin="22,4,0,0" IsEnabled="{Binding NeedsFile}">
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource SideButton}"
                            Margin="8,0,0,0"
                            Content="Browse…"
                            Click="OnBrowseExisting"
                        />
                        <TextBox
                            Style="{StaticResource StyleBox}"
                            AutomationProperties.Name="Data extraction file"
                            Text="{Binding ExistingFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    </DockPanel>
                    <TextBlock
                        Margin="0,16,0,0"
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="Next asks the name of the .dxe file the settings are saved in. A .dxe written by AutoCAD is not read: its format is AutoCAD's own."
                    />
                </StackPanel>

                <!-- Page 2: Define Data Source -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=1}">
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Source"
                        Content="Drawing files and folders:"
                        Margin="0,0,0,6"
                        IsChecked="{Binding UseDrawingFiles, Mode=TwoWay}"
                    />
                    <Border Style="{StaticResource ListFrame}" Height="130" Margin="22,0,0,6">
                        <ListBox
                            AutomationProperties.Name="Sources"
                            ItemsSource="{Binding Sources}"
                            SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListRow}"
                        />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,10" IsEnabled="{Binding UseDrawingFiles}">
                        <Button Style="{StaticResource SideButton}" Content="Add Drawings…" Click="OnAddDrawings" />
                        <Button Style="{StaticResource SideButton}" Content="Add Folder…" Click="OnAddFolder" />
                        <Button Style="{StaticResource SideButton}" Content="Remove" Click="OnRemoveSource" />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Include subfolders"
                            Margin="8,0,16,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                        />
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Include current drawing"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IncludeCurrentDrawing, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            GroupName="Source"
                            Content="Select objects in the current drawing"
                            VerticalAlignment="Center"
                            IsChecked="{Binding UseSelectedObjects, Mode=TwoWay}"
                        />
                        <Button
                            Style="{StaticResource SideButton}"
                            Margin="12,0,8,0"
                            Content="Select objects &lt;"
                            Click="OnSelectObjects"
                        />
                        <TextBlock
                            Text="{Binding NumberSelected}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GhTextMuted}"
                        />
                    </StackPanel>
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Additional settings">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock
                                    Text="Extract from:"
                                    Foreground="{StaticResource GhTextMuted}"
                                    Margin="0,0,12,0"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    GroupName="Extent"
                                    Content="All objects in drawing"
                                    Margin="0,0,16,0"
                                    IsChecked="{Binding AllObjectsInDrawing, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    GroupName="Extent"
                                    Content="Objects in model space"
                                    IsChecked="{Binding ModelSpaceOnly, Mode=TwoWay}"
                                />
                            </StackPanel>
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Extract objects from blocks"
                                Margin="0,0,0,4"
                                IsChecked="{Binding ExtractFromBlocks, Mode=TwoWay}"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Extract objects from xrefs"
                                Margin="0,0,0,4"
                                IsChecked="{Binding ExtractFromXrefs, Mode=TwoWay}"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Include xrefs in block counts"
                                IsChecked="{Binding IncludeXrefsInCounts, Mode=TwoWay}"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- Page 3: Select Objects -->
                <DockPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=2}">
                    <StackPanel DockPanel.Dock="Right" Width="250" Margin="16,0,0,0">
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Display options">
                            <StackPanel>
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    GroupName="Display"
                                    Content="Display all object types"
                                    Margin="0,0,0,4"
                                    IsChecked="{Binding DisplayAll, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    GroupName="Display"
                                    Content="Display blocks only"
                                    Margin="0,0,0,4"
                                    IsChecked="{Binding DisplayBlocksOnly, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    GroupName="Display"
                                    Content="Display non-blocks only"
                                    Margin="0,0,0,8"
                                    IsChecked="{Binding DisplayNonBlocksOnly, Mode=TwoWay}"
                                />
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="Display blocks with attributes only"
                                    Margin="0,0,0,4"
                                    IsChecked="{Binding DisplayAttributesOnly, Mode=TwoWay}"
                                />
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="Display objects currently in-use only"
                                    IsChecked="{Binding DisplayUsedOnly, Mode=TwoWay}"
                                />
                            </StackPanel>
                        </HeaderedContentControl>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SideButton}" Content="Check All" Click="OnCheckAllTypes" />
                            <Button
                                Style="{StaticResource SideButton}"
                                Content="Uncheck All"
                                Click="OnUncheckAllTypes"
                            />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource ListFrame}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <TextBlock
                                    Text="Object"
                                    Padding="10,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock
                                    Text="Count"
                                    Padding="10,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                    HorizontalAlignment="Right"
                                />
                            </Grid>
                            <ListBox
                                AutomationProperties.Name="Object types"
                                ItemsSource="{Binding Types}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListRow}"
                                ItemTemplate="{StaticResource CheckRow}"
                            />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- Page 4: Select Properties -->
                <DockPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=3}">
                    <StackPanel DockPanel.Dock="Right" Width="230" Margin="16,0,0,0">
                        <TextBlock Text="Category filter" Style="{StaticResource StyleGroup}" />
                        <Border Style="{StaticResource ListFrame}" Margin="0,0,0,8">
                            <ListBox
                                AutomationProperties.Name="Categories"
                                ItemsSource="{Binding Categories}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListRow}"
                                ItemTemplate="{StaticResource CheckRow}"
                                PreviewMouseLeftButtonUp="OnCategoryClicked"
                            />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Style="{StaticResource SideButton}"
                                Content="Check All"
                                Click="OnCheckAllProperties"
                            />
                            <Button
                                Style="{StaticResource SideButton}"
                                Content="Uncheck All"
                                Click="OnUncheckAllProperties"
                            />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource ListFrame}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <TextBlock
                                    Text="Property"
                                    Padding="10,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock
                                    Text="Category"
                                    Padding="10,6"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource GhTextMuted}"
                                    HorizontalAlignment="Right"
                                />
                            </Grid>
                            <ListBox
                                AutomationProperties.Name="Properties"
                                ItemsSource="{Binding Properties}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListRow}"
                                ItemTemplate="{StaticResource CheckRow}"
                            />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- Page 5: Refine Data -->
                <Grid Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Width="250" Margin="16,0,0,0">
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Combine identical rows"
                                Margin="0,0,0,4"
                                IsChecked="{Binding CombineIdenticalRows, Mode=TwoWay}"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Show count column"
                                Margin="0,0,0,4"
                                IsChecked="{Binding ShowCount, Mode=TwoWay}"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Show name column"
                                Margin="0,0,0,4"
                                IsChecked="{Binding ShowName, Mode=TwoWay}"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Use property names as additional column headers"
                                Margin="0,0,0,10"
                                IsChecked="{Binding UsePropertyNamesAsHeaders, Mode=TwoWay}"
                            />
                            <TextBlock Text="Sort columns" Style="{StaticResource StyleGroup}" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Margin="0,0,0,4"
                                ItemsSource="{Binding ColumnKeys}"
                                SelectedItem="{Binding SortColumn, Mode=TwoWay}"
                                AutomationProperties.Name="Sort column"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Descending"
                                Margin="0,0,0,10"
                                IsChecked="{Binding SortDescending, Mode=TwoWay}"
                            />
                            <TextBlock Text="Filter" Style="{StaticResource StyleGroup}" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Margin="0,0,0,4"
                                ItemsSource="{Binding ColumnKeys}"
                                SelectedItem="{Binding FilterColumn, Mode=TwoWay}"
                                AutomationProperties.Name="Filter column"
                            />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Margin="0,0,0,4"
                                ItemsSource="{Binding FilterConditions}"
                                SelectedItem="{Binding FilterCondition, Mode=TwoWay}"
                                AutomationProperties.Name="Filter condition"
                            />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                Margin="0,0,0,4"
                                AutomationProperties.Name="Filter value"
                                Text="{Binding FilterValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                AutomationProperties.Name="Filter second value"
                                IsEnabled="{Binding FilterNeedsSecond}"
                                Text="{Binding FilterSecond, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button
                                Style="{StaticResource SideButton}"
                                Margin="0,0,0,6"
                                Content="Up"
                                Click="OnColumnUp"
                                ToolTip="Move the column chosen to the left"
                            />
                            <Button
                                Style="{StaticResource SideButton}"
                                Content="Down"
                                Click="OnColumnDown"
                                ToolTip="Move the column chosen to the right"
                            />
                        </StackPanel>
                        <Border Style="{StaticResource ListFrame}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                    <TextBlock
                                        Text="Column (double-click a name to rename it)"
                                        Padding="10,6"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource GhTextMuted}"
                                    />
                                </Grid>
                                <ListBox
                                    AutomationProperties.Name="Columns"
                                    ItemsSource="{Binding Columns}"
                                    SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListRow}"
                                >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:DataExtractionColumnRow}">
                                            <DockPanel Margin="8,2">
                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    Text="{Binding Original}"
                                                    Foreground="{StaticResource GhTextMuted}"
                                                    Margin="8,0,4,0"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBox
                                                    Style="{StaticResource StyleBox}"
                                                    Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    LostFocus="OnHeaderEdited"
                                                />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Preview" Style="{StaticResource StyleGroup}" Margin="0,8,0,4" />
                    <Border Grid.Row="2" Style="{StaticResource ListFrame}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Text="{Binding Preview}"
                                FontFamily="{StaticResource GhMonoFont}"
                                FontSize="11"
                                Padding="8,6"
                                AutomationProperties.Name="Preview"
                            />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Page 6: Choose Output -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=5}">
                    <CheckBox
                        Style="{StaticResource BlockCheck}"
                        Content="Insert data extraction table into drawing"
                        Margin="0,8,0,12"
                        IsChecked="{Binding InsertTable, Mode=TwoWay}"
                    />
                    <CheckBox
                        Style="{StaticResource BlockCheck}"
                        Content="Output data to external file (.xlsx .csv .txt)"
                        Margin="0,0,0,6"
                        IsChecked="{Binding OutputToFile, Mode=TwoWay}"
                    />
                    <DockPanel Margin="22,0,0,0" IsEnabled="{Binding OutputToFile}">
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource SideButton}"
                            Margin="8,0,0,0"
                            Content="Browse…"
                            Click="OnBrowseOutput"
                        />
                        <TextBox
                            Style="{StaticResource StyleBox}"
                            AutomationProperties.Name="Output file"
                            Text="{Binding OutputFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    </DockPanel>
                    <TextBlock
                        Margin="0,16,0,0"
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="If you chose to insert a table, you will be prompted for an insertion point after you click Finish. Any external files to create will be created when clicking Finish."
                    />
                </StackPanel>

                <!-- Page 7: Table Style -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=6}">
                    <TextBlock Text="Table style" Style="{StaticResource StyleGroup}" Margin="0,8,0,6" />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        Margin="0,0,0,16"
                        ItemsSource="{Binding TableStyles}"
                        SelectedItem="{Binding TableStyle, Mode=TwoWay}"
                        AutomationProperties.Name="Table style"
                    />
                    <TextBlock
                        Text="Enter a title for your table:"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,0,0,4"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Table title"
                        Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </StackPanel>

                <!-- Page 8: Finish -->
                <StackPanel Visibility="{Binding Page, Converter={StaticResource PageShown}, ConverterParameter=7}">
                    <TextBlock
                        Text="Click Finish to complete the extraction."
                        Margin="0,16,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                    />
                    <TextBlock
                        Text="The settings are saved in:"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,8,0,2"
                    />
                    <TextBlock Text="{Binding DxeFile}" TextWrapping="Wrap" FontFamily="{StaticResource GhMonoFont}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
