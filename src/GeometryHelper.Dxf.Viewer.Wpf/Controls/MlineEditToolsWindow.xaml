<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.MlineEditToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Multiline Edit Tools"
    Width="560"
    Height="510"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design MlineEditTools: the twelve tools as pictures, four to a row, as AutoCAD lays them out. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Multiline Edit Tools"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <Button
                    HorizontalAlignment="Right"
                    Style="{StaticResource GhDialogButton}"
                    Content="Close"
                    Padding="14,5"
                    Click="OnClose"
                    IsCancel="True"
                />
            </Border>

            <DockPanel Margin="16,12">
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    FontSize="11"
                    Foreground="{StaticResource GhTextMuted}"
                    Text="To use a tool, click the icon. You must select the mlines after you choose the tool."
                />
                <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="Tools">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Margin="4"
                                Padding="6"
                                Tag="{Binding Code}"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}"
                                Click="OnTool"
                            >
                                <StackPanel>
                                    <Border Background="Black" Width="80" Height="80">
                                        <Path
                                            Data="{Binding Picture}"
                                            Stroke="{StaticResource GhText}"
                                            StrokeThickness="2"
                                        />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
