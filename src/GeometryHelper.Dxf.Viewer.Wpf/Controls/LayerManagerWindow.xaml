<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.LayerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="{Binding Title}" Width="900" Height="560" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RgbBrushConverter x:Key="RgbBrush" />

            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource GhCheckBox}">
                <Setter Property="Margin" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="24" Height="24" Click="OnClose" ToolTip="Close">
                        <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconClose}" />
                    </Button>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the summary and Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhDialogButton}" Content="Close" Padding="14,5" Click="OnClose" IsCancel="True" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Toolbar: New layer, Delete, Set current, and the search. -->
            <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="220" Background="{StaticResource GhInput}" CornerRadius="4" Padding="8,5">
                        <DockPanel>
                            <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconSearch}"
                                            Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource GhTextBox}" Tag="Search layers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="New layer" Command="{Binding NewLayerCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,0"
                                ToolTip="Deletes the chosen layer; one in use, the current one, 0 and Defpoints are kept" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Set current" Command="{Binding SetCurrentCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The table of layers, then the note on owners. -->
            <DockPanel Margin="16,12">
                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap"
                           Text="Layers marked with an owner were written by a model drawing. You can switch them off or change their colour; their entities are edited through the drawing." />
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="106" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="Name" />
                            <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="On" />
                            <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Frz" />
                            <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="Lock" />
                            <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Colour" />
                            <TextBlock Grid.Column="6" Style="{StaticResource HeadCell}" Text="Linetype" />
                            <TextBlock Grid.Column="7" Style="{StaticResource HeadCell}" Text="Weight" />
                            <TextBlock Grid.Column="8" Style="{StaticResource HeadCell}" Text="Owner" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource GhText}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LayerRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="106" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding CurrentMark}" Foreground="{StaticResource GhOk}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="2" Style="{StaticResource Check}" IsChecked="{Binding IsOn}" ToolTip="On" />
                                        <CheckBox Grid.Column="3" Style="{StaticResource Check}" IsChecked="{Binding IsFrozen}" ToolTip="Frozen" />
                                        <CheckBox Grid.Column="4" Style="{StaticResource Check}" IsChecked="{Binding IsLocked}" ToolTip="Locked" />
                                        <!-- The colour cell, clicked: AutoCAD's Select Color dialog. -->
                                        <Button Grid.Column="5" Margin="8,2" Style="{StaticResource GhFlatButton}" HorizontalContentAlignment="Left" Padding="4,3"
                                                Command="{Binding ChooseColorCommand}" ToolTip="Colour: click to choose one of the index or a true colour">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="12" Height="12" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Margin="0,0,6,0"
                                                        Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ColorName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <!-- The linetype cell, clicked: AutoCAD's Select Linetype dialog. -->
                                        <Button Grid.Column="6" Margin="8,2" Style="{StaticResource GhFlatButton}" HorizontalContentAlignment="Left" Padding="4,3"
                                                Command="{Binding ChooseLinetypeCommand}" ToolTip="Linetype: click to choose one loaded, or load one">
                                            <TextBlock Text="{Binding Linetype}" FontFamily="{StaticResource GhMonoFont}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <ComboBox Grid.Column="7" Style="{StaticResource GhComboBox}" Margin="8,2" FontFamily="{StaticResource GhMonoFont}"
                                                  ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding Weight, Mode=TwoWay}" ToolTip="Lineweight" />
                                        <TextBlock Grid.Column="8" Style="{StaticResource Cell}" Text="{Binding Owner}" Foreground="{StaticResource GhTextMuted}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
