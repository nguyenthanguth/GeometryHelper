<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LayerManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="{Binding Title}"
    Width="900"
    Height="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RgbBrushConverter x:Key="RgbBrush" />
            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <SolidColorBrush x:Key="VpHead" Color="#1B3A55" />

            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <!-- The head of a VP column: on the blue of an override, as the design marks the columns of the viewport. -->
            <Style x:Key="VpHeadCell" TargetType="TextBlock" BasedOn="{StaticResource HeadCell}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="6,6" />
                <Setter Property="Background" Value="{StaticResource VpHead}" />
                <Setter Property="Foreground" Value="{StaticResource GhIcon}" />
            </Style>
            <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource GhCheckBox}">
                <Setter Property="Margin" Value="8,0" />
            </Style>
            <!-- A VP cell: marked as an override (blue, an accent line round it) where its Tag is true. -->
            <Style x:Key="VpCell" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource VpHead}" />
                        <Setter Property="BorderBrush" Value="{StaticResource GhAccent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the summary and Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhCloseButton}"
                        Content="Close"
                        Padding="14,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Summary}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Toolbar: New layer, New layer VP frozen in all viewports, Delete, Set current, and the search. -->
            <Border
                DockPanel.Dock="Top"
                Padding="16,10"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
            >
                <DockPanel>
                    <Border
                        DockPanel.Dock="Right"
                        Width="220"
                        Background="{StaticResource GhInput}"
                        CornerRadius="4"
                        Padding="8,5"
                    >
                        <DockPanel>
                            <local:IconView
                                Size="14"
                                StrokeThickness="2"
                                Stroke="{StaticResource GhTextMuted}"
                                Data="{StaticResource GhIconSearch}"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                            />
                            <TextBox
                                Style="{StaticResource GhTextBox}"
                                Tag="Search layers"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            />
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="New layer"
                            Command="{Binding NewLayerCommand}"
                            Margin="0,0,6,0"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="New layer VP frozen in all viewports"
                            Command="{Binding NewLayerVpFrozenCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Adds a layer frozen in every viewport of every layout"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Deletes the chosen layer; one in use, the current one, 0 and Defpoints are kept"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Set current"
                            Command="{Binding SetCurrentCommand}"
                        />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The table of layers, then the notes. -->
            <DockPanel Margin="16,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasViewportColumns, Converter={StaticResource Hidden}}"
                        Text="Layers marked with an owner were written by a model drawing. You can switch them off or change their colour; their entities are edited through the drawing."
                    />
                    <StackPanel
                        Orientation="Horizontal"
                        Visibility="{Binding HasViewportColumns, Converter={StaticResource Shown}}"
                    >
                        <Border
                            Width="12"
                            Height="12"
                            Background="{StaticResource VpHead}"
                            BorderBrush="{StaticResource GhAccent}"
                            BorderThickness="1"
                            Margin="0,0,8,0"
                        />
                        <TextBlock
                            Foreground="{StaticResource GhTextMuted}"
                            Text="A viewport override: the value differs from the layer's own in this viewport only. VP Plot Style is grey in a colour-dependent drawing (ByColor plot styles)."
                        />
                    </StackPanel>
                    <TextBlock
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasViewportColumns, Converter={StaticResource Shown}}"
                        Text="The VP columns show only while a layout is current; on the Model tab they are hidden. They act on the current viewport, or on the viewport selected in paper space."
                    />
                </StackPanel>
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="Name" />
                            <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="On" />
                            <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Frz" />
                            <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="Lock" />
                            <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Colour" />
                            <TextBlock Grid.Column="6" Style="{StaticResource HeadCell}" Text="Linetype" />
                            <TextBlock Grid.Column="7" Style="{StaticResource HeadCell}" Text="Weight" />
                            <TextBlock
                                Grid.Column="8"
                                Width="106"
                                Style="{StaticResource HeadCell}"
                                Text="Owner"
                                Visibility="{Binding HasViewportColumns, Converter={StaticResource Hidden}}"
                            />
                            <StackPanel
                                Grid.Column="8"
                                Orientation="Horizontal"
                                Visibility="{Binding HasViewportColumns, Converter={StaticResource Shown}}"
                            >
                                <TextBlock Width="74" Style="{StaticResource VpHeadCell}" Text="VP Freeze" />
                                <TextBlock Width="104" Style="{StaticResource VpHeadCell}" Text="New VP Freeze" />
                                <TextBlock Width="110" Style="{StaticResource VpHeadCell}" Text="VP Color" />
                                <TextBlock Width="110" Style="{StaticResource VpHeadCell}" Text="VP Linetype" />
                                <TextBlock Width="104" Style="{StaticResource VpHeadCell}" Text="VP Lineweight" />
                                <TextBlock Width="116" Style="{StaticResource VpHeadCell}" Text="VP Transparency" />
                                <TextBlock Width="110" Style="{StaticResource VpHeadCell}" Text="VP Plot Style" />
                            </StackPanel>
                        </Grid>
                        <ListBox
                            x:Name="Table"
                            ItemsSource="{Binding Rows}"
                            SelectedItem="{Binding SelectedRow}"
                            SelectionMode="Extended"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Foreground="{StaticResource GhText}"
                        >
                            <!-- The right-click menu, as AutoCAD 2021's Layer manager gives it in a layout. -->
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource GhContextMenu}">
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Set current"
                                        Command="{Binding SetCurrentCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="New Layer"
                                        Command="{Binding NewLayerCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="New Layer VP Frozen in All Viewports"
                                        Command="{Binding NewLayerVpFrozenCommand}"
                                    />
                                    <Separator Style="{StaticResource GhMenuSeparator}" />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="VP Freeze Layer in All Viewports"
                                        Command="{Binding VpFreezeAllCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="VP Thaw Layer in All Viewports"
                                        Command="{Binding VpThawAllCommand}"
                                    />
                                    <Separator Style="{StaticResource GhMenuSeparator}" />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Isolate Selected Layers"
                                        Command="{Binding IsolateCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhSubmenuItem}"
                                        Header="Remove Viewport Overrides for"
                                    >
                                        <MenuItem Style="{StaticResource GhSubmenuItem}" Header="Selected Layers">
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Current Viewport Only"
                                                Command="{Binding RemoveOverridesCommand}"
                                                CommandParameter="Selected,Current"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="All Viewports"
                                                Command="{Binding RemoveOverridesCommand}"
                                                CommandParameter="Selected,All"
                                            />
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource GhSubmenuItem}" Header="All Layers">
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="Current Viewport Only"
                                                Command="{Binding RemoveOverridesCommand}"
                                                CommandParameter="All,Current"
                                            />
                                            <MenuItem
                                                Style="{StaticResource GhMenuItem}"
                                                Header="All Viewports"
                                                Command="{Binding RemoveOverridesCommand}"
                                                CommandParameter="All,All"
                                            />
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator Style="{StaticResource GhMenuSeparator}" />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Delete Layer"
                                        Command="{Binding DeleteCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Rename Layer"
                                        IsEnabled="False"
                                        ToolTip="Not built yet"
                                    />
                                    <Separator Style="{StaticResource GhMenuSeparator}" />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Select All"
                                        Command="{Binding SelectAllCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Clear All"
                                        Command="{Binding ClearAllCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Select All but Current"
                                        Command="{Binding SelectAllButCurrentCommand}"
                                    />
                                    <MenuItem
                                        Style="{StaticResource GhMenuItem}"
                                        Header="Invert Selection"
                                        Command="{Binding InvertSelectionCommand}"
                                    />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="IsSelected" Value="{Binding IsChosen, Mode=TwoWay}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="Row"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource GhHeader}"
                                                    BorderThickness="0,1,0,0"
                                                >
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter
                                                            TargetName="Row"
                                                            Property="Background"
                                                            Value="{StaticResource GhSelected}"
                                                        />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LayerRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource Cell}"
                                            Text="{Binding CurrentMark}"
                                            Foreground="{StaticResource GhOk}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                        />
                                        <CheckBox
                                            Grid.Column="2"
                                            Style="{StaticResource Check}"
                                            IsChecked="{Binding IsOn}"
                                            ToolTip="On"
                                        />
                                        <CheckBox
                                            Grid.Column="3"
                                            Style="{StaticResource Check}"
                                            IsChecked="{Binding IsFrozen}"
                                            ToolTip="Frozen"
                                        />
                                        <CheckBox
                                            Grid.Column="4"
                                            Style="{StaticResource Check}"
                                            IsChecked="{Binding IsLocked}"
                                            ToolTip="Locked"
                                        />
                                        <!-- The colour cell, clicked: AutoCAD's Select Color dialog. -->
                                        <Button
                                            Grid.Column="5"
                                            Margin="8,2"
                                            Style="{StaticResource GhFlatButton}"
                                            HorizontalContentAlignment="Left"
                                            Padding="4,3"
                                            Command="{Binding ChooseColorCommand}"
                                            ToolTip="Colour: click to choose one of the index or a true colour"
                                        >
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="12"
                                                    Height="12"
                                                    BorderBrush="{StaticResource GhBorder}"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0"
                                                    Background="{Binding Rgb, Converter={StaticResource RgbBrush}}"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBlock
                                                    Text="{Binding ColorName}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                />
                                            </StackPanel>
                                        </Button>
                                        <!-- The linetype cell, clicked: AutoCAD's Select Linetype dialog. -->
                                        <Button
                                            Grid.Column="6"
                                            Margin="8,2"
                                            Style="{StaticResource GhFlatButton}"
                                            HorizontalContentAlignment="Left"
                                            Padding="4,3"
                                            Command="{Binding ChooseLinetypeCommand}"
                                            ToolTip="Linetype: click to choose one loaded, or load one"
                                        >
                                            <TextBlock
                                                Text="{Binding Linetype}"
                                                FontFamily="{StaticResource GhMonoFont}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                        </Button>
                                        <ComboBox
                                            Grid.Column="7"
                                            Style="{StaticResource GhComboBox}"
                                            Margin="8,2"
                                            FontFamily="{StaticResource GhMonoFont}"
                                            ItemsSource="{Binding WeightOptions}"
                                            SelectedItem="{Binding Weight, Mode=TwoWay}"
                                            ToolTip="Lineweight"
                                        />
                                        <TextBlock
                                            Grid.Column="8"
                                            Width="106"
                                            Style="{StaticResource Cell}"
                                            Text="{Binding Owner}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            Visibility="{Binding DataContext.HasViewportColumns, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Hidden}}"
                                        />
                                        <!-- The VP cells, acting on the viewport worked through or selected; an override marked. -->
                                        <StackPanel
                                            Grid.Column="8"
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.HasViewportColumns, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Shown}}"
                                            IsEnabled="{Binding DataContext.HasTargetViewport, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        >
                                            <Border
                                                Width="74"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpFrozen}"
                                            >
                                                <CheckBox
                                                    Style="{StaticResource Check}"
                                                    Margin="6,0"
                                                    IsChecked="{Binding IsVpFrozen}"
                                                    ToolTip="Frozen in this viewport"
                                                />
                                            </Border>
                                            <Border Width="104" Style="{StaticResource VpCell}">
                                                <CheckBox
                                                    Style="{StaticResource Check}"
                                                    Margin="6,0"
                                                    IsChecked="{Binding IsNewVpFrozen}"
                                                    ToolTip="Frozen in new viewports"
                                                />
                                            </Border>
                                            <Border
                                                Width="110"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpColorOverridden}"
                                            >
                                                <Button
                                                    Style="{StaticResource GhFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,3"
                                                    Margin="2,1"
                                                    Command="{Binding ChooseVpColorCommand}"
                                                    ToolTip="Colour in this viewport: click to override it"
                                                >
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Width="12"
                                                            Height="12"
                                                            BorderBrush="{StaticResource GhBorder}"
                                                            BorderThickness="1"
                                                            Margin="0,0,6,0"
                                                            Background="{Binding VpRgb, Converter={StaticResource RgbBrush}}"
                                                            VerticalAlignment="Center"
                                                        />
                                                        <TextBlock
                                                            Text="{Binding VpColorName}"
                                                            FontFamily="{StaticResource GhMonoFont}"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                            <Border
                                                Width="110"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpLinetypeOverridden}"
                                            >
                                                <Button
                                                    Style="{StaticResource GhFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4,3"
                                                    Margin="2,1"
                                                    Command="{Binding ChooseVpLinetypeCommand}"
                                                    ToolTip="Linetype in this viewport: click to override it"
                                                >
                                                    <TextBlock
                                                        Text="{Binding VpLinetype}"
                                                        FontFamily="{StaticResource GhMonoFont}"
                                                        TextTrimming="CharacterEllipsis"
                                                    />
                                                </Button>
                                            </Border>
                                            <Border
                                                Width="104"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpWeightOverridden}"
                                            >
                                                <ComboBox
                                                    Style="{StaticResource GhComboBox}"
                                                    Margin="2,1"
                                                    FontFamily="{StaticResource GhMonoFont}"
                                                    ItemsSource="{Binding WeightOptions}"
                                                    SelectedItem="{Binding VpWeight, Mode=TwoWay}"
                                                    ToolTip="Lineweight in this viewport"
                                                />
                                            </Border>
                                            <Border
                                                Width="116"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpTransparencyOverridden}"
                                            >
                                                <ComboBox
                                                    Style="{StaticResource GhComboBox}"
                                                    Margin="2,1"
                                                    FontFamily="{StaticResource GhMonoFont}"
                                                    ItemsSource="{Binding TransparencyOptions}"
                                                    SelectedItem="{Binding VpTransparency, Mode=TwoWay}"
                                                    ToolTip="Transparency in this viewport, per cent"
                                                />
                                            </Border>
                                            <Border
                                                Width="110"
                                                Style="{StaticResource VpCell}"
                                                Tag="{Binding IsVpPlotStyleOverridden}"
                                            >
                                                <Grid>
                                                    <TextBlock
                                                        Style="{StaticResource Cell}"
                                                        Margin="6,5"
                                                        Text="{Binding VpPlotStyle, Mode=OneWay}"
                                                        FontFamily="{StaticResource GhMonoFont}"
                                                        Foreground="{StaticResource GhTextMuted}"
                                                        ToolTip="A drawing plotted by colour (CTB) has no plot style of a layer"
                                                        Visibility="{Binding DataContext.HasNamedPlotStyles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Hidden}}"
                                                    />
                                                    <ComboBox
                                                        Style="{StaticResource GhComboBox}"
                                                        Margin="2,1"
                                                        FontFamily="{StaticResource GhMonoFont}"
                                                        ItemsSource="{Binding PlotStyleOptions}"
                                                        SelectedItem="{Binding VpPlotStyle, Mode=TwoWay}"
                                                        ToolTip="Plot style in this viewport"
                                                        Visibility="{Binding DataContext.HasNamedPlotStyles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Shown}}"
                                                    />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
