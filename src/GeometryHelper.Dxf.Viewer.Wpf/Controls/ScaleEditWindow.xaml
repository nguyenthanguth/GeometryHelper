<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ScaleEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="420"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Click="OnOk"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>
            <StackPanel Margin="16,12">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Scale name" Margin="0">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource StyleLabel}"
                            Text="Name appearing in scale list:"
                            Margin="0,0,0,3"
                        />
                        <TextBox
                            x:Name="NameBox"
                            Style="{StaticResource StyleBox}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        />
                    </StackPanel>
                </HeaderedContentControl>
                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Scale properties"
                    Margin="0,10,0,0"
                    IsEnabled="{Binding CanChangeUnits}"
                >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource StyleLabel}" Text="Paper units:" Margin="0,0,0,3" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource StyleLabel}"
                            Text="Drawing units:"
                            Margin="0,0,0,3"
                        />
                        <TextBox
                            Grid.Row="1"
                            Style="{StaticResource StyleBox}"
                            FontFamily="{StaticResource GhMonoFont}"
                            Text="{Binding PaperUnits, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Paper units"
                        />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="="
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GhTextMuted}"
                        />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource StyleBox}"
                            FontFamily="{StaticResource GhMonoFont}"
                            Text="{Binding DrawingUnits, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Drawing units"
                        />
                    </Grid>
                </HeaderedContentControl>
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhWarn}"
                    Text="{Binding Message}"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
