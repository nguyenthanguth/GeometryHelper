<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.FieldWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Field"
    Width="680"
    Height="560"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Show" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close, same as Cancel"
                    />
                    <TextBlock Text="Field" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="OkButton"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnOk"
                        IsDefault="True"
                        IsEnabled="{Binding CanOk}"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <Grid Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left: the category, the names of the category and what the field chosen shows. -->
                <DockPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Field category:" Margin="0,0,0,4" />
                    <ComboBox
                        DockPanel.Dock="Top"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding Category, Mode=TwoWay}"
                        Margin="0,0,0,8"
                        AutomationProperties.Name="Field category"
                    />
                    <TextBlock DockPanel.Dock="Top" Text="Field names:" Margin="0,0,0,4" />
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Text="{Binding Description}"
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        MinHeight="32"
                    />
                    <ListBox
                        ItemsSource="{Binding Names}"
                        SelectedItem="{Binding SelectedName, Mode=TwoWay}"
                        Background="{StaticResource GhInput}"
                        Foreground="{StaticResource GhText}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        Padding="0,2"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        MouseDoubleClick="OnNameDoubleClick"
                        AutomationProperties.Name="Field names"
                    />
                </DockPanel>

                <!-- Right: the preview, then the options of the field chosen, each group shown for the fields that have it. -->
                <DockPanel Grid.Row="0" Grid.Column="2">
                    <HeaderedContentControl
                        DockPanel.Dock="Top"
                        Style="{StaticResource BlockGroup}"
                        Header="Preview"
                        Margin="0,0,0,8"
                    >
                        <TextBlock
                            Text="{Binding Preview}"
                            FontFamily="{StaticResource GhMonoFont}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            MinHeight="20"
                            AutomationProperties.Name="Preview"
                        />
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Field options">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <!-- A date: the formats as they write the date now, and a format typed. -->
                                <StackPanel Visibility="{Binding IsDate, Converter={StaticResource Show}}">
                                    <TextBlock Text="Examples:" Margin="0,0,0,4" />
                                    <ListBox
                                        ItemsSource="{Binding DateChoices}"
                                        SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                                        Height="150"
                                        Background="{StaticResource GhInput}"
                                        Foreground="{StaticResource GhText}"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        Padding="0,2"
                                        ItemContainerStyle="{StaticResource StyleListItem}"
                                        AutomationProperties.Name="Date formats"
                                    />
                                    <TextBlock Text="Date format:" Margin="0,8,0,4" />
                                    <TextBox
                                        Style="{StaticResource BlockNumber}"
                                        Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Date format"
                                    />
                                </StackPanel>

                                <!-- Words or a file name: the case, or the parts of the name. -->
                                <StackPanel Visibility="{Binding HasFormats, Converter={StaticResource Show}}">
                                    <TextBlock Text="Format:" Margin="0,0,0,4" />
                                    <ListBox
                                        ItemsSource="{Binding Formats}"
                                        SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                        Height="120"
                                        Background="{StaticResource GhInput}"
                                        Foreground="{StaticResource GhText}"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        Padding="0,2"
                                        ItemContainerStyle="{StaticResource StyleListItem}"
                                        AutomationProperties.Name="Format"
                                    />
                                </StackPanel>

                                <!-- An object: Select object, and the properties of the one picked. -->
                                <StackPanel
                                    Visibility="{Binding IsObject, Converter={StaticResource Show}}"
                                    Margin="0,0,0,8"
                                >
                                    <DockPanel Margin="0,0,0,8">
                                        <Button
                                            DockPanel.Dock="Left"
                                            Style="{StaticResource BlockPickButton}"
                                            Click="OnSelectObject"
                                            Margin="0,0,10,0"
                                            AutomationProperties.Name="Select object"
                                        >
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Data="{StaticResource BlockSelectIcon}"
                                                    Stroke="#C9D1DB"
                                                    StrokeThickness="1.8"
                                                    Width="14"
                                                    Height="14"
                                                    Stretch="Uniform"
                                                    Margin="0,0,6,0"
                                                />
                                                <TextBlock Text="Select object" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Text="{Binding ObjectText}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </DockPanel>
                                    <TextBlock Text="Property:" Margin="0,0,0,4" />
                                    <ListBox
                                        ItemsSource="{Binding PropertyChoices}"
                                        SelectedItem="{Binding SelectedProperty, Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        Height="120"
                                        Background="{StaticResource GhInput}"
                                        Foreground="{StaticResource GhText}"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        Padding="0,2"
                                        ItemContainerStyle="{StaticResource StyleListItem}"
                                        AutomationProperties.Name="Property"
                                    />
                                </StackPanel>

                                <!-- A number: units, precision, factor, prefix, suffix and thousands separator. -->
                                <Grid Visibility="{Binding IsNumber, Converter={StaticResource Show}}" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="Units:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                    />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource GhComboBox}"
                                        ItemsSource="{Binding Units}"
                                        SelectedItem="{Binding SelectedUnits, Mode=TwoWay}"
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="Units"
                                    />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="Precision:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                    />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource GhComboBox}"
                                        ItemsSource="{Binding Precisions}"
                                        SelectedItem="{Binding Precision, Mode=TwoWay}"
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="Precision"
                                    />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="Conversion factor:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                    />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource BlockNumber}"
                                        Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="Conversion factor"
                                    />
                                    <TextBlock
                                        Grid.Row="3"
                                        Text="Prefix:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                    />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource BlockBox}"
                                        Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="Prefix"
                                    />
                                    <TextBlock
                                        Grid.Row="4"
                                        Text="Suffix:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,6"
                                    />
                                    <TextBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource BlockBox}"
                                        Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="Suffix"
                                    />
                                    <TextBlock
                                        Grid.Row="5"
                                        Text="Thousands separator:"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                    />
                                    <ComboBox
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource GhComboBox}"
                                        ItemsSource="{Binding Separators}"
                                        SelectedItem="{Binding Separator, Mode=TwoWay}"
                                        AutomationProperties.Name="Thousands separator"
                                    />
                                </Grid>

                                <!-- A formula, a DIESEL expression or the name of a system variable. -->
                                <StackPanel Visibility="{Binding IsExpression, Converter={StaticResource Show}}">
                                    <TextBlock Text="{Binding ExpressionLabel}" Margin="0,0,0,4" />
                                    <TextBox
                                        Style="{StaticResource BlockNumber}"
                                        Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="False"
                                        AutomationProperties.Name="Expression"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </HeaderedContentControl>
                </DockPanel>

                <!-- Under both: the field expression, as the code AutoCAD keeps. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="Field expression:" Margin="0,0,0,4" />
                    <TextBox
                        Style="{StaticResource BlockNumber}"
                        Text="{Binding Code, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        MinHeight="44"
                        AutomationProperties.Name="Field expression"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
