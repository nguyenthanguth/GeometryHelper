<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.LineweightSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Lineweight Settings"
    Width="500"
    Height="400"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design LineweightSettings: the Lineweights list on the left, Units for Listing, Display, Default and the scale on the right. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Lineweight Settings"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="18,5"
                        Click="OnOk"
                        IsDefault="True"
                    />
                </StackPanel>
            </Border>

            <TextBlock
                DockPanel.Dock="Bottom"
                Margin="16,0,16,10"
                TextWrapping="Wrap"
                Foreground="{StaticResource GhTextMuted}"
                Text="The lineweight picked is the one new objects take (CELWEIGHT, one step of undo); Display Lineweight is LWDISPLAY; units, Default and the scale are the window's, kept between sessions."
            />

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Lineweights" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ListBox
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        Foreground="{StaticResource GhText}"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        AutomationProperties.Name="Lineweights"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LineweightItem}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle
                                        Width="48"
                                        Height="{Binding Pixels}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource GhText}"
                                    />
                                    <TextBlock Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel Grid.Column="2">
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Units for Listing">
                        <StackPanel>
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                GroupName="Units"
                                Content="Millimeters (mm)"
                                IsChecked="{Binding IsMillimetres, Mode=TwoWay}"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                GroupName="Units"
                                Content="Inches (in)"
                                Margin="0"
                                IsChecked="{Binding IsInches, Mode=TwoWay}"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                    <CheckBox
                        Style="{StaticResource BlockCheck}"
                        Content="Display Lineweight"
                        Margin="0,12,0,0"
                        IsChecked="{Binding DisplayLineweight, Mode=TwoWay}"
                    />
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock
                            Text="Default:"
                            Width="60"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            AutomationProperties.Name="Default"
                            ItemsSource="{Binding DefaultItems}"
                            SelectedItem="{Binding DefaultText, Mode=TwoWay}"
                        />
                    </DockPanel>
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="Adjust Display Scale"
                        Margin="0,8,0,0"
                    >
                        <StackPanel>
                            <Slider
                                Minimum="0"
                                Maximum="10"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Adjust Display Scale"
                                Value="{Binding ScalePosition, Mode=TwoWay}"
                            />
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Text="Max"
                                    Foreground="{StaticResource GhTextMuted}"
                                />
                                <TextBlock Text="Min" Foreground="{StaticResource GhTextMuted}" />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock
                        Text="{Binding CurrentText}"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
