<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PurgeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Purge"
    Width="640"
    Height="700"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One of the two modes: a button framed in the accent when chosen. -->
            <Style x:Key="ModeTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Frame"
                                Padding="10,8"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GhBorder}"
                                Background="{StaticResource GhInput}"
                            >
                                <ContentPresenter HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Frame"
                                        Property="BorderBrush"
                                        Value="{StaticResource GhAccent}"
                                    />
                                    <Setter
                                        TargetName="Frame"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of the tree; the one chosen on the selection colour. -->
            <Style x:Key="TreeRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="16,10">
                <RadioButton
                    Style="{StaticResource ModeTab}"
                    GroupName="Mode"
                    Content="Purgeable Items"
                    IsChecked="{Binding IsPurgeable, Mode=OneWay}"
                    Checked="OnMode"
                    Margin="0,0,3,0"
                />
                <RadioButton
                    Style="{StaticResource ModeTab}"
                    GroupName="Mode"
                    Content="Find Non-Purgeable Items"
                    IsChecked="{Binding IsNonPurgeable, Mode=OneWay}"
                    Checked="OnMode"
                    Margin="3,0,0,0"
                />
            </UniformGrid>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhCloseButton}"
                        Content="Close"
                        Padding="14,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                    <StackPanel
                        Orientation="Horizontal"
                        Visibility="{Binding IsPurgeable, Converter={StaticResource Shown}}"
                    >
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="Purge Checked Items"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnPurgeChecked"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Purge All"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnPurgeAll"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding FootNote}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TreeTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel
                        DockPanel.Dock="Bottom"
                        Visibility="{Binding IsPurgeable, Converter={StaticResource Shown}}"
                    >
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Options" Margin="0,4,0,0">
                            <StackPanel>
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="Confirm each item to be purged"
                                    IsChecked="{Binding ConfirmEach, Mode=TwoWay}"
                                />
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="Purge nested items"
                                    IsChecked="{Binding PurgeNested, Mode=TwoWay}"
                                    Margin="0"
                                />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl
                            Style="{StaticResource BlockGroup}"
                            Header="Unnamed Objects"
                            Margin="0,4,0,0"
                        >
                            <StackPanel>
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="{Binding ZeroLengthText}"
                                    IsChecked="{Binding PurgeZeroLength, Mode=TwoWay}"
                                />
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="{Binding EmptyTextText}"
                                    IsChecked="{Binding PurgeEmptyText, Mode=TwoWay}"
                                />
                                <CheckBox
                                    Style="{StaticResource BlockCheck}"
                                    Content="Clean up orphaned data"
                                    IsEnabled="False"
                                    Margin="0"
                                    ToolTip="Not built: the DXF reader keeps no orphaned data."
                                />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                    <Border
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{StaticResource GhInput}"
                        Padding="0,4"
                    >
                        <ListBox
                            ItemsSource="{Binding Nodes}"
                            SelectedItem="{Binding Selected, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource TreeRow}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        >
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PurgeNodeViewModel}">
                                    <DockPanel x:Name="Line" Margin="{Binding Indent}" Background="Transparent">
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Text="{Binding Count}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            FontFamily="{StaticResource GhMonoFont}"
                                            Margin="6,3,10,3"
                                        />
                                        <TextBlock
                                            Text="{Binding Twisty}"
                                            Width="12"
                                            Foreground="{StaticResource GhTextMuted}"
                                            Margin="0,3,6,3"
                                            MouseLeftButtonDown="OnTwisty"
                                            Cursor="Hand"
                                        />
                                        <CheckBox
                                            Style="{StaticResource StyleCheck}"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                            IsEnabled="{Binding IsEnabled}"
                                            Margin="0,3,6,3"
                                            Visibility="{Binding HasCheckBox, Converter={StaticResource Shown}}"
                                            AutomationProperties.Name="{Binding Name}"
                                        />
                                        <TextBlock
                                            x:Name="Name"
                                            Text="{Binding Name}"
                                            Margin="0,3"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter
                                                TargetName="Name"
                                                Property="Foreground"
                                                Value="{StaticResource GhTextMuted}"
                                            />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="2" Visibility="{Binding IsPurgeable, Converter={StaticResource Shown}}">
                    <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border
                        Height="180"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#000000"
                        Margin="0,0,0,6"
                    >
                        <Image Source="{Binding Preview}" Stretch="None" />
                    </Border>
                    <Border Padding="10,8" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBlock
                            Text="{Binding PreviewNote}"
                            Foreground="{StaticResource GhTextMuted}"
                            TextWrapping="Wrap"
                        />
                    </Border>
                </StackPanel>

                <DockPanel Grid.Column="2" Visibility="{Binding IsNonPurgeable, Converter={StaticResource Shown}}">
                    <TextBlock DockPanel.Dock="Top" Text="Possible reasons" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Padding="10,8" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock
                                Text="{Binding ReasonsTitle}"
                                FontFamily="{StaticResource GhMonoFont}"
                                Margin="0,0,0,8"
                            />
                            <ItemsControl ItemsSource="{Binding Reasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Click="OnSelectObjects"
                                IsEnabled="{Binding CanSelectObjects}"
                            >
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14M20 20l-4-4"
                                        Stroke="#C9D1DB"
                                        StrokeThickness="1.8"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        Margin="0,0,6,0"
                                    />
                                    <TextBlock Text="Select Objects" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
