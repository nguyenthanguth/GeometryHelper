<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.DataFormatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Table Cell Format"
    Width="580"
    Height="440"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Show" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title with the cells, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Table Cell Format - " />
                        <Run Text="{Binding CellName, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Footer: the sample, Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Command="{Binding OkCommand}"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StyleLabel}" Text="Sample:" Margin="0,0,8,0" />
                    <TextBlock
                        Text="{Binding Sample, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="Data type" />
                    <ListBox
                        ItemsSource="{Binding DataTypes}"
                        SelectedItem="{Binding DataType, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        Background="Transparent"
                        BorderBrush="{StaticResource GhBorder}"
                        Height="300"
                    />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="Format" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource StyleLabel}"
                            Text="Units:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasUnits, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding UnitChoices}"
                            SelectedItem="{Binding Unit, Mode=TwoWay}"
                            Visibility="{Binding HasUnits, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource StyleLabel}"
                            Text="Angle units:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasAngleUnits, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding AngleUnitChoices}"
                            SelectedItem="{Binding AngleUnit, Mode=TwoWay}"
                            Visibility="{Binding HasAngleUnits, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource StyleLabel}"
                            Text="Date format:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasDate, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding DateChoices}"
                            SelectedItem="{Binding DateFormat, Mode=TwoWay}"
                            Visibility="{Binding HasDate, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource StyleLabel}"
                            Text="Precision:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasPrecision, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding PrecisionChoices}"
                            SelectedItem="{Binding Precision, Mode=TwoWay}"
                            Visibility="{Binding HasPrecision, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource StyleLabel}"
                            Text="Decimal separator:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasDecimal, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding DecimalChoices}"
                            SelectedItem="{Binding Decimal, Mode=TwoWay}"
                            Visibility="{Binding HasDecimal, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="5"
                            Style="{StaticResource StyleLabel}"
                            Text="Thousands separator:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasThousands, Converter={StaticResource Show}}"
                        />
                        <ComboBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            Margin="0,0,0,8"
                            ItemsSource="{Binding ThousandChoices}"
                            SelectedItem="{Binding Thousand, Mode=TwoWay}"
                            Visibility="{Binding HasThousands, Converter={StaticResource Show}}"
                        />

                        <TextBlock
                            Grid.Row="6"
                            Style="{StaticResource StyleLabel}"
                            Text="Prefix / suffix:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasAffixes, Converter={StaticResource Show}}"
                        />
                        <StackPanel
                            Grid.Row="6"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasAffixes, Converter={StaticResource Show}}"
                        >
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                Width="90"
                                Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                            />
                            <TextBox
                                Style="{StaticResource StyleBox}"
                                Width="90"
                                Margin="8,0,0,0"
                                Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                            />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="7"
                            Style="{StaticResource StyleLabel}"
                            Text="Conversion factor:"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasFactor, Converter={StaticResource Show}}"
                        />
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource StyleBox}"
                            Width="90"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding HasFactor, Converter={StaticResource Show}}"
                        />
                    </Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Visibility="{Binding HasZeros, Converter={StaticResource Show}}"
                    >
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Suppress leading zeros"
                            IsChecked="{Binding SuppressLeading, Mode=TwoWay}"
                            Margin="0,0,16,0"
                        />
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="Suppress trailing zeros"
                            IsChecked="{Binding SuppressTrailing, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="General, Text and Whole Number take no more options; a date is shown as the cell's culture writes it."
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,12,0,0"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
