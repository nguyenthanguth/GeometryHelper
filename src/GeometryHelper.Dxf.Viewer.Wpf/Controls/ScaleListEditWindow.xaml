<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ScaleListEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Edit Drawing Scales"
    Width="560"
    Height="500"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ScaleRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="8,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Edit Drawing Scales"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource GhTextMuted}"
                        Text="{Binding Summary}"
                    />
                </DockPanel>
            </Border>

            <DockPanel Margin="16,12">
                <HeaderedContentControl
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource BlockGroup}"
                    Header="{Binding SelectedTitle}"
                    Margin="0,10,0,0"
                >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Paper units:" Foreground="{StaticResource GhTextMuted}" Margin="0,0,10,0" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding PaperUnits}"
                            FontFamily="{StaticResource GhMonoFont}"
                        />
                        <TextBlock
                            Grid.Column="2"
                            Text="Drawing units:"
                            Foreground="{StaticResource GhTextMuted}"
                            Margin="10,0"
                        />
                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding DrawingUnits}"
                            FontFamily="{StaticResource GhMonoFont}"
                        />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" Text="{Binding Sentence}" />
                    </Grid>
                </HeaderedContentControl>

                <StackPanel DockPanel.Dock="Right" Width="110" Margin="12,22,0,0">
                    <Button Style="{StaticResource SideButton}" Content="Add…" Click="OnAdd" />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Edit…"
                        Click="OnEdit"
                        IsEnabled="{Binding CanEdit}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Move Up"
                        Click="OnMoveUp"
                        IsEnabled="{Binding CanMoveUp}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Move Down"
                        Click="OnMoveDown"
                        IsEnabled="{Binding CanMoveDown}"
                    />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Delete"
                        Click="OnDelete"
                        IsEnabled="{Binding CanDelete}"
                    />
                    <Border Height="6" />
                    <Button Style="{StaticResource SideButton}" Content="Reset" Click="OnReset" />
                </StackPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Scale List" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{StaticResource GhInput}"
                    >
                        <ListBox
                            x:Name="List"
                            ItemsSource="{Binding Scales}"
                            SelectedItem="{Binding Selected, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ScaleRow}"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Scale list"
                        >
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ScaleRowViewModel}">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontFamily="{StaticResource GhMonoFont}"
                                        Foreground="{StaticResource GhText}"
                                    />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
