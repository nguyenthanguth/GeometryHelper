<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.DraftingSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Drafting Settings"
    Width="560"
    Height="580"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:SnapMarkerConverter x:Key="Marker" />

            <!-- A check box with its words beside it, greyed and saying why while it is off. -->
            <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource GhCheckBox}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="Width" Value="90" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A snap of the Object Snap tab: its box, its marker, its name; a snap not built greyed with "Not built yet.". -->
            <DataTemplate x:Key="SnapTemplate" DataType="{x:Type local:SnapModeRowViewModel}">
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,9"
                    ToolTip="{Binding ToolTip}"
                    ToolTipService.ShowOnDisabled="True"
                    IsEnabled="{Binding IsAvailable}"
                    Background="Transparent"
                >
                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    <Image
                        Source="{Binding Kind, Converter={StaticResource Marker}}"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                    />
                    <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Drafting Settings"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: why a value was refused, then OK, Cancel and Apply. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,6,0"
                            Click="OnOk"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,6,0"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Apply"
                            Padding="14,5"
                            Click="OnApply"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Notice}"
                        Foreground="{StaticResource GhWarn}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>

            <!-- The tabs, in AutoCAD's order. -->
            <Border DockPanel.Dock="Top" Padding="16,10,16,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Snap and Grid"
                        IsChecked="{Binding IsSnapAndGridTab, Mode=TwoWay}"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Polar Tracking"
                        IsChecked="{Binding IsPolarTrackingTab, Mode=TwoWay}"
                        Margin="0,0,6,0"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Object Snap"
                        IsChecked="{Binding IsObjectSnapTab, Mode=TwoWay}"
                    />
                </StackPanel>
            </Border>

            <Grid Margin="16,14">
                <!-- Snap and Grid, as AutoCAD 2021's tab: the snap on with its spacing, PolarSnap's distance and the snap type
                     on the left; the grid on, its dotted style, spacing and behavior on the right. A box refused is edged in
                     red. -->
                <Grid Visibility="{Binding IsSnapAndGridTab, Converter={StaticResource Shown}}">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
                            </ResourceDictionary.MergedDictionaries>

                            <!-- Words beside a box or a check box, muted while greyed. -->
                            <Style x:Key="Words" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="Row" TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>

                            <!-- The edge of a box: none, red while the box is the one refused. -->
                            <Style x:Key="Edge" TargetType="Border">
                                <Setter Property="Width" Value="100" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Style>

                            <Style x:Key="SnapNumber" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
                                <Setter Property="Width" Value="NaN" />
                                <Setter Property="Padding" Value="7,3" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#22262D" />
                                        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="262" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}" Margin="0,0,0,2">
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsGridSnapOn, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Words}" Text="Snap On (F9)" />
                        </StackPanel>
                        <HeaderedContentControl
                            Style="{StaticResource BlockGroup}"
                            Header="Snap spacing"
                            Margin="0,0,0,6"
                        >
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}" IsEnabled="{Binding CanEditSnapX}">
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Snap X spacing:"
                                        Width="104"
                                        Margin="0,0,8,0"
                                    />
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaultyBox}" Value="SnapX">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox
                                            x:Name="SnapXInput"
                                            Style="{StaticResource SnapNumber}"
                                            Text="{Binding SnapX}"
                                            KeyDown="OnBoxKeyDown"
                                            AutomationProperties.Name="Snap X spacing"
                                        />
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" IsEnabled="{Binding CanEditSnapY}">
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Snap Y spacing:"
                                        Width="104"
                                        Margin="0,0,8,0"
                                    />
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaultyBox}" Value="SnapY">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox
                                            x:Name="SnapYInput"
                                            Style="{StaticResource SnapNumber}"
                                            Text="{Binding SnapY}"
                                            KeyDown="OnBoxKeyDown"
                                            AutomationProperties.Name="Snap Y spacing"
                                        />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEqualSpacing}">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsEqualSpacing, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Equal X and Y spacing" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl
                            Style="{StaticResource BlockGroup}"
                            Header="Polar spacing"
                            Margin="0,0,0,6"
                        >
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditPolarDistance}">
                                <TextBlock
                                    Style="{StaticResource Words}"
                                    Text="Polar distance:"
                                    Width="104"
                                    Margin="0,0,8,0"
                                />
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FaultyBox}" Value="PolarDistance">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GhError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox
                                        x:Name="PolarDistanceInput"
                                        Style="{StaticResource SnapNumber}"
                                        Text="{Binding PolarDistance}"
                                        KeyDown="OnBoxKeyDown"
                                        AutomationProperties.Name="Polar distance"
                                    />
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Snap type">
                            <StackPanel>
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    Content="Grid snap"
                                    GroupName="SnapType"
                                    IsChecked="{Binding IsGridSnapType, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    Content="Rectangular snap"
                                    GroupName="SnapStyle"
                                    Margin="20,0,0,6"
                                    IsEnabled="{Binding CanChooseSnapStyle}"
                                    IsChecked="{Binding IsRectangularSnap, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    Content="Isometric snap"
                                    GroupName="SnapStyle"
                                    Margin="20,0,0,6"
                                    IsEnabled="{Binding CanChooseSnapStyle}"
                                    IsChecked="{Binding IsIsometricSnap, Mode=TwoWay}"
                                />
                                <RadioButton
                                    Style="{StaticResource BlockRadio}"
                                    Content="PolarSnap"
                                    GroupName="SnapType"
                                    Margin="0"
                                    IsChecked="{Binding IsPolarSnapType, Mode=TwoWay}"
                                />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Style="{StaticResource Row}" Margin="0,0,0,2">
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsGridOn, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Words}" Text="Grid On (F7)" />
                        </StackPanel>
                        <HeaderedContentControl
                            Style="{StaticResource BlockGroup}"
                            Header="Grid style"
                            Margin="0,0,0,6"
                        >
                            <StackPanel>
                                <TextBlock
                                    Text="Display dotted grid in:"
                                    Foreground="{StaticResource GhIcon}"
                                    Margin="0,0,0,6"
                                />
                                <StackPanel Style="{StaticResource Row}" Margin="12,0,0,6">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsDottedInModel, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="2D model space" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Margin="12,0,0,6">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsDottedInBlockEditor, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Block editor" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Margin="12,0,0,0">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsDottedInLayout, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Sheet/Layout" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl
                            Style="{StaticResource BlockGroup}"
                            Header="Grid spacing"
                            Margin="0,0,0,6"
                        >
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}" IsEnabled="{Binding CanEditGridX}">
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Grid X spacing:"
                                        Width="104"
                                        Margin="0,0,8,0"
                                    />
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaultyBox}" Value="GridX">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox
                                            x:Name="GridXInput"
                                            Style="{StaticResource SnapNumber}"
                                            Text="{Binding GridX}"
                                            KeyDown="OnBoxKeyDown"
                                            AutomationProperties.Name="Grid X spacing"
                                        />
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Grid Y spacing:"
                                        Width="104"
                                        Margin="0,0,8,0"
                                    />
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaultyBox}" Value="GridY">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox
                                            x:Name="GridYInput"
                                            Style="{StaticResource SnapNumber}"
                                            Text="{Binding GridY}"
                                            KeyDown="OnBoxKeyDown"
                                            AutomationProperties.Name="Grid Y spacing"
                                        />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Major line every:"
                                        Width="104"
                                        Margin="0,0,8,0"
                                    />
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Edge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FaultyBox}" Value="MajorLineEvery">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource GhError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox
                                            x:Name="MajorLineEveryInput"
                                            Style="{StaticResource SnapNumber}"
                                            Text="{Binding MajorLineEvery}"
                                            KeyDown="OnBoxKeyDown"
                                            AutomationProperties.Name="Major line every"
                                        />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Grid behavior">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}" Margin="0,0,0,6">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsAdaptiveGrid, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Adaptive grid" />
                                </StackPanel>
                                <!-- Its words wrap, as the column is narrower than they are. -->
                                <DockPanel Margin="20,0,0,6" IsEnabled="{Binding CanSubdivide}">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        VerticalAlignment="Top"
                                        Margin="0,1,8,0"
                                        IsChecked="{Binding IsSubdividing, Mode=TwoWay}"
                                    />
                                    <TextBlock
                                        Style="{StaticResource Words}"
                                        Text="Allow subdivision below grid spacing"
                                        TextWrapping="Wrap"
                                    />
                                </DockPanel>
                                <StackPanel Style="{StaticResource Row}" Margin="0,0,0,6">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsBeyondLimits, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Display grid beyond Limits" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Margin="0">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsFollowingUcs, Mode=TwoWay}"
                                    />
                                    <TextBlock Style="{StaticResource Words}" Text="Follow Dynamic UCS" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>

                <!-- Polar Tracking: on; the increment, the additional angles with New and Delete; how tracking runs and how
                     angles are measured (POLARANG, POLARADDANG, POLARMODE). -->
                <StackPanel Visibility="{Binding IsPolarTrackingTab, Converter={StaticResource Shown}}">
                    <StackPanel.Resources>
                        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsPolarOn, Mode=TwoWay}" />
                        <TextBlock Text="Polar Tracking On (F10)" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="262" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Polar Angle Settings">
                            <StackPanel>
                                <TextBlock
                                    Text="Increment angle:"
                                    Foreground="{StaticResource GhIcon}"
                                    Margin="0,0,0,4"
                                />
                                <ComboBox
                                    Style="{StaticResource GhComboBox}"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    IsEditable="True"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    ItemsSource="{Binding IncrementAngles}"
                                    Text="{Binding IncrementAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    AutomationProperties.Name="Increment angle"
                                />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <CheckBox
                                        Style="{StaticResource Check}"
                                        IsChecked="{Binding IsAdditionalAngles, Mode=TwoWay}"
                                    />
                                    <TextBlock Text="Additional angles" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="150"
                                        Height="132"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="{StaticResource GhInput}"
                                        IsEnabled="{Binding IsAdditionalAngles}"
                                    >
                                        <DockPanel>
                                            <TextBox
                                                x:Name="NewAngleBox"
                                                DockPanel.Dock="Bottom"
                                                Style="{StaticResource GhTextBox}"
                                                Height="20"
                                                Padding="5,1"
                                                BorderBrush="{StaticResource GhAccent}"
                                                BorderThickness="1"
                                                Background="{StaticResource GhInput}"
                                                FontFamily="{StaticResource GhMonoFont}"
                                                Text="{Binding NewAngle, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsTypingAngle, Converter={StaticResource Shown}}"
                                                IsVisibleChanged="OnNewAngleShown"
                                                KeyDown="OnNewAngleKeyDown"
                                                LostKeyboardFocus="OnNewAngleLeft"
                                                AutomationProperties.Name="New additional angle"
                                            />
                                            <ListBox
                                                ItemsSource="{Binding AdditionalAngles}"
                                                SelectedItem="{Binding SelectedAdditionalAngle, Mode=TwoWay}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource GhText}"
                                                FontFamily="{StaticResource GhMonoFont}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                AutomationProperties.Name="Additional angles"
                                            />
                                        </DockPanel>
                                    </Border>
                                    <StackPanel Margin="8,0,0,0">
                                        <Button
                                            Style="{StaticResource GhDialogButton}"
                                            Content="New"
                                            Width="74"
                                            Margin="0,0,0,8"
                                            Command="{Binding NewAngleCommand}"
                                            IsEnabled="{Binding CanAddAngle}"
                                        />
                                        <Button
                                            Style="{StaticResource GhDialogButton}"
                                            Content="Delete"
                                            Width="74"
                                            Command="{Binding DeleteAngleCommand}"
                                            IsEnabled="{Binding CanDeleteAngle}"
                                        />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Text="{Binding AngleError}"
                                    Foreground="{StaticResource GhWarn}"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0"
                                />
                            </StackPanel>
                        </HeaderedContentControl>
                        <StackPanel Grid.Column="2">
                            <HeaderedContentControl
                                Style="{StaticResource BlockGroup}"
                                Header="Object Snap Tracking Settings"
                                Margin="0,0,0,12"
                            >
                                <StackPanel>
                                    <RadioButton
                                        Style="{StaticResource BlockRadio}"
                                        Content="Track orthogonally only"
                                        GroupName="PolarTrack"
                                        IsChecked="{Binding IsTrackingOrthogonally, Mode=TwoWay}"
                                        Margin="0,0,0,8"
                                    />
                                    <RadioButton
                                        Style="{StaticResource BlockRadio}"
                                        Content="Track using all polar angle settings"
                                        GroupName="PolarTrack"
                                        IsChecked="{Binding IsTrackingAllPolar, Mode=TwoWay}"
                                    />
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl
                                Style="{StaticResource BlockGroup}"
                                Header="Polar Angle measurement"
                            >
                                <StackPanel>
                                    <RadioButton
                                        Style="{StaticResource BlockRadio}"
                                        Content="Absolute"
                                        GroupName="PolarMeasure"
                                        IsChecked="{Binding IsAbsolute, Mode=TwoWay}"
                                        Margin="0,0,0,8"
                                    />
                                    <RadioButton
                                        Style="{StaticResource BlockRadio}"
                                        Content="Relative to last segment"
                                        GroupName="PolarMeasure"
                                        IsChecked="{Binding IsRelativeToLastSegment, Mode=TwoWay}"
                                    />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Object Snap: on, tracking on, the fourteen snaps in two columns, Select All and Clear All. -->
                <DockPanel Visibility="{Binding IsObjectSnapTab, Converter={StaticResource Shown}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSnapOn, Mode=TwoWay}" />
                            <TextBlock Text="Object Snap On (F3)" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsTrackingOn, Mode=TwoWay}" />
                            <TextBlock Text="Object Snap Tracking On (F11)" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Select All"
                            Command="{Binding SelectAllCommand}"
                            Margin="0,0,0,6"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Clear All"
                            Command="{Binding ClearAllCommand}"
                        />
                    </StackPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Style="{StaticResource Label}"
                        Text="Object Snap modes"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"
                    />
                    <ItemsControl
                        ItemsSource="{Binding Modes}"
                        ItemTemplate="{StaticResource SnapTemplate}"
                        Focusable="False"
                    >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical" Height="232" ItemWidth="180" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
