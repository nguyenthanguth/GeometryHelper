<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.SelectColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Select Color" Width="600" Height="500" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RgbBrushConverter x:Key="RgbBrush" />
            <local:BoolToVisibilityConverter x:Key="Shown" />

            <!-- A swatch of the index: its colour, a white frame while chosen, the accent while hovered. -->
            <Style x:Key="Swatch" TargetType="Button">
                <Setter Property="Width" Value="21" />
                <Setter Property="Height" Value="19" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="Command" Value="{Binding DataContext.PickIndexCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="CommandParameter" Value="{Binding Index}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Margin="1" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                    Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="SwatchTemplate" DataType="{x:Type local:AciSwatchViewModel}">
                <Button Style="{StaticResource Swatch}" />
            </DataTemplate>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- A number box of the True Color tab. -->
            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhFlatButton}" Width="24" Height="24" Click="OnCancel" ToolTip="Close">
                        <local:IconView Size="14" StrokeThickness="2" Stroke="{StaticResource GhTextMuted}" Data="{StaticResource GhIconClose}" />
                    </Button>
                    <TextBlock Text="Select Color" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the old colour beside the new one, then OK and Cancel. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="OK" Padding="18,5" Margin="0,0,6,0" Click="OnOk" IsDefault="True" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="22" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" ToolTip="The colour it had"
                                Background="{Binding OriginalRgb, Converter={StaticResource RgbBrush}}" />
                        <Border Width="34" Height="22" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,1,1" Margin="0,0,10,0" ToolTip="The colour chosen"
                                Background="{Binding ColorRgb, Converter={StaticResource RgbBrush}}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource GhTextMuted}" FontSize="11">
                                <Run Text="Old:" /> <Run Text="{Binding OriginalText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11">
                                <Run Text="New:" Foreground="{StaticResource GhTextMuted}" /> <Run Text="{Binding ColorText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The tabs: Index Color and True Color. -->
            <Border DockPanel.Dock="Top" Padding="16,10,16,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource GhChip}" Content="Index Color" IsChecked="{Binding IsIndexColorTab, Mode=TwoWay}" Margin="0,0,6,0" />
                    <RadioButton Style="{StaticResource GhChip}" Content="True Color" IsChecked="{Binding IsTrueColorTab, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Grid Margin="16,12">
                <!-- Index Color: the grid of 10 to 249, the standard colours with ByLayer and ByBlock, the greys, the Color box. -->
                <StackPanel Visibility="{Binding IsIndexColorTab, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource Label}" Text="AutoCAD Color Index (ACI):" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding GridColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                    Visibility="{Binding OffersByLayerAndByBlock, Converter={StaticResource Shown}}">
                            <Button Style="{StaticResource GhDialogButton}" Content="ByLayer" Command="{Binding ByLayerCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhDialogButton}" Content="ByBlock" Command="{Binding ByBlockCommand}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding StandardColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="9" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding GreyColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Color:" />
                        <TextBox Style="{StaticResource NumberBox}" Width="160" Text="{Binding ColorBoxText}" KeyDown="OnBoxKeyDown"
                                 ToolTip="Red to White, an index 1 to 255, ByLayer, ByBlock, or red, green and blue as 10,20,30" />
                    </StackPanel>
                </StackPanel>

                <!-- True Color: red, green and blue, hue, saturation and luminance, and the hexadecimal. -->
                <Grid Visibility="{Binding IsTrueColorTab, Converter={StaticResource Shown}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Red:" />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Red, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Red}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Green:" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Green, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Green}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Blue:" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Blue, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Blue}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Hue:" />
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="360" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Hue, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Hue}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Saturation:" />
                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Saturation, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="5" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Saturation}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Luminance:" />
                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,12,0"
                            Value="{Binding Luminance, Mode=TwoWay}" Focusable="False" />
                    <TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource NumberBox}" Text="{Binding Luminance}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Hex:" />
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource NumberBox}" Width="90" HorizontalAlignment="Left" Text="{Binding Hex}" KeyDown="OnBoxKeyDown" />
                    <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" VerticalAlignment="Bottom"
                               Text="A true colour is written to the DXF as red, green and blue (group 420), with the nearest colour of the index beside it (group 62) for programs that read only the index." />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
