<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.SelectColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Select Color" Width="600" Height="500" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:RgbBrushConverter x:Key="RgbBrush" />
            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:FractionToOffsetConverter x:Key="Offset" />

            <!-- A swatch of the index: its colour, a white frame while chosen, the accent while hovered. -->
            <Style x:Key="Swatch" TargetType="Button">
                <Setter Property="Width" Value="21" />
                <Setter Property="Height" Value="19" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="Command" Value="{Binding DataContext.PickIndexCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="CommandParameter" Value="{Binding Index}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Margin="1" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
                                    Background="{Binding Rgb, Converter={StaticResource RgbBrush}}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="SwatchTemplate" DataType="{x:Type local:AciSwatchViewModel}">
                <Button Style="{StaticResource Swatch}" />
            </DataTemplate>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- A number box of the True Color tab. -->
            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Select Color" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: the old colour beside the new one, then OK and Cancel. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="OK" Padding="22,5" Margin="0,0,12,0" Click="OnOk" IsDefault="True"
                                Background="{StaticResource GhAccent}" Foreground="{StaticResource GhAccentInk}" BorderThickness="0" FontWeight="SemiBold" />
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="22" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" ToolTip="The colour it had"
                                Background="{Binding OriginalRgb, Converter={StaticResource RgbBrush}}" />
                        <Border Width="34" Height="22" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,1,1,1" Margin="0,0,10,0" ToolTip="The colour chosen"
                                Background="{Binding ColorRgb, Converter={StaticResource RgbBrush}}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource GhTextMuted}">
                                <Run Text="Old:" /> <Run Text="{Binding OriginalText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="New:" /> <Run Text="{Binding ColorText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The tabs: Index Color and True Color; on True Color, its colour model. -->
            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsTrueColorTab, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource Label}" Text="Color model:" Margin="0,0,6,0" />
                    <ComboBox Style="{StaticResource GhComboBox}" Width="80" ItemsSource="{Binding ColorModels}" SelectedItem="{Binding ColorModel, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource GhChip}" Content="Index Color" IsChecked="{Binding IsIndexColorTab, Mode=TwoWay}" Margin="0,0,6,0" />
                    <RadioButton Style="{StaticResource GhChip}" Content="True Color" IsChecked="{Binding IsTrueColorTab, Mode=TwoWay}" />
                </StackPanel>
            </DockPanel>

            <Grid Margin="16,12">
                <!-- Index Color: the grid of 10 to 249, the standard colours with ByLayer and ByBlock, the greys, the Color box. -->
                <StackPanel Visibility="{Binding IsIndexColorTab, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource Label}" Text="AutoCAD Color Index (ACI):" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding GridColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                    Visibility="{Binding OffersByLayerAndByBlock, Converter={StaticResource Shown}}">
                            <Button Style="{StaticResource GhDialogButton}" Content="ByLayer" Command="{Binding ByLayerCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhDialogButton}" Content="ByBlock" Command="{Binding ByBlockCommand}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding StandardColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="9" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding GreyColors}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Color:" />
                        <TextBox Style="{StaticResource NumberBox}" Width="160" Text="{Binding ColorBoxText}" KeyDown="OnBoxKeyDown"
                                 ToolTip="Red to White, an index 1 to 255, ByLayer, ByBlock, or red, green and blue as 10,20,30" />
                    </StackPanel>
                </StackPanel>

                <!--
                True Color: the colour model's pictures, then the Color box and what is written. HSL: the field of hue (left to
                right) and saturation (top to foot) with its crosshair, the luminance bar of the hue and saturation picked with
                its arrow, both clicked or dragged, and the three boxes. RGB: a bar for each of red, green and blue, from none to
                full with the other two as they are, its marker under it, and its box.
                -->
                <StackPanel Visibility="{Binding IsTrueColorTab, Converter={StaticResource Shown}}">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsHslModel, Converter={StaticResource Shown}}">
                        <Grid>
                            <Border Width="220" Height="200" BorderBrush="{StaticResource GhBorder}" BorderThickness="1">
                                <Grid x:Name="FieldArea" Width="218" Height="198" Background="Transparent" Cursor="Cross"
                                      MouseLeftButtonDown="OnPickDown" MouseMove="OnPickMove" MouseLeftButtonUp="OnPickUp"
                                      ToolTip="Hue from left to right, saturation from top to bottom: click or drag to pick">
                                    <Image Source="{Binding HueSaturationField}" Stretch="Fill" />
                                </Grid>
                            </Border>
                            <!-- The crosshair, over the field's frame so that it may stand past its edge, as the design draws it. -->
                            <Canvas Margin="1" IsHitTestVisible="False" RenderOptions.EdgeMode="Aliased">
                                <Path Data="M7 0V14M0 7H14" Stroke="Black" StrokeThickness="3"
                                      Canvas.Left="{Binding HueAcross, Converter={StaticResource Offset}, ConverterParameter='218 -7'}"
                                      Canvas.Top="{Binding SaturationDown, Converter={StaticResource Offset}, ConverterParameter='198 -7'}" />
                                <Path Data="M7 0V14M0 7H14" Stroke="White" StrokeThickness="1"
                                      Canvas.Left="{Binding HueAcross, Converter={StaticResource Offset}, ConverterParameter='218 -7'}"
                                      Canvas.Top="{Binding SaturationDown, Converter={StaticResource Offset}, ConverterParameter='198 -7'}" />
                            </Canvas>
                        </Grid>
                        <Grid Margin="14,0,0,0">
                            <Border Width="22" Height="200" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" HorizontalAlignment="Left">
                                <Grid x:Name="LuminanceArea" Width="20" Height="198" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="OnPickDown" MouseMove="OnPickMove" MouseLeftButtonUp="OnPickUp"
                                      ToolTip="Luminance of the hue and saturation picked: click or drag to pick">
                                    <Image Source="{Binding LuminanceBar}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>
                            <Canvas Width="10" Margin="24,1,0,0" HorizontalAlignment="Left">
                                <Path Data="M8 0V12L0 6z" Fill="{StaticResource GhText}" IsHitTestVisible="False"
                                      Canvas.Top="{Binding LuminanceDown, Converter={StaticResource Offset}, ConverterParameter='198 -6'}" />
                            </Canvas>
                        </Grid>
                        <StackPanel Margin="22,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Label}" Text="Hue:" Width="70" Foreground="{StaticResource GhIcon}" />
                                <TextBox Style="{StaticResource NumberBox}" Width="60" Text="{Binding Hue}" KeyDown="OnBoxKeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Label}" Text="Saturation:" Width="70" Foreground="{StaticResource GhIcon}" />
                                <TextBox Style="{StaticResource NumberBox}" Width="60" Text="{Binding Saturation}" KeyDown="OnBoxKeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Label}" Text="Luminance:" Width="70" Foreground="{StaticResource GhIcon}" />
                                <TextBox Style="{StaticResource NumberBox}" Width="60" Text="{Binding Luminance}" KeyDown="OnBoxKeyDown" />
                            </StackPanel>
                            <TextBlock Text="Hue 0 to 360, saturation and luminance 0 to 100." Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Width="200" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsRgbModel, Converter={StaticResource Shown}}">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Label}" Text="Red:" Width="50" Margin="0,2,12,0" VerticalAlignment="Top" Foreground="{StaticResource GhIcon}" />
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" VerticalAlignment="Top" Margin="0,-1,0,0" Text="{Binding Red}" KeyDown="OnBoxKeyDown" />
                            <Grid Height="28" Margin="0,0,12,0">
                                <Border Width="438" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource GhBorder}" BorderThickness="1">
                                    <Image x:Name="RedArea" Tag="0" Source="{Binding RedBar}" Stretch="Fill" Width="436" Height="18" Cursor="Hand"
                                           MouseLeftButtonDown="OnPickDown" MouseMove="OnPickMove" MouseLeftButtonUp="OnPickUp" ToolTip="Red: click or drag to pick" />
                                </Border>
                                <Canvas Margin="1,0,0,0">
                                    <Path Data="M6 0 12 8H0z" Fill="{StaticResource GhText}" IsHitTestVisible="False" Canvas.Top="20"
                                          Canvas.Left="{Binding RedAlong, Converter={StaticResource Offset}, ConverterParameter='436 -6'}" />
                                </Canvas>
                            </Grid>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Label}" Text="Green:" Width="50" Margin="0,2,12,0" VerticalAlignment="Top" Foreground="{StaticResource GhIcon}" />
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" VerticalAlignment="Top" Margin="0,-1,0,0" Text="{Binding Green}" KeyDown="OnBoxKeyDown" />
                            <Grid Height="28" Margin="0,0,12,0">
                                <Border Width="438" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource GhBorder}" BorderThickness="1">
                                    <Image x:Name="GreenArea" Tag="1" Source="{Binding GreenBar}" Stretch="Fill" Width="436" Height="18" Cursor="Hand"
                                           MouseLeftButtonDown="OnPickDown" MouseMove="OnPickMove" MouseLeftButtonUp="OnPickUp" ToolTip="Green: click or drag to pick" />
                                </Border>
                                <Canvas Margin="1,0,0,0">
                                    <Path Data="M6 0 12 8H0z" Fill="{StaticResource GhText}" IsHitTestVisible="False" Canvas.Top="20"
                                          Canvas.Left="{Binding GreenAlong, Converter={StaticResource Offset}, ConverterParameter='436 -6'}" />
                                </Canvas>
                            </Grid>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Blue:" Width="50" Margin="0,2,12,0" VerticalAlignment="Top" Foreground="{StaticResource GhIcon}" />
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" VerticalAlignment="Top" Margin="0,-1,0,0" Text="{Binding Blue}" KeyDown="OnBoxKeyDown" />
                            <Grid Height="28" Margin="0,0,12,0">
                                <Border Width="438" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource GhBorder}" BorderThickness="1">
                                    <Image x:Name="BlueArea" Tag="2" Source="{Binding BlueBar}" Stretch="Fill" Width="436" Height="18" Cursor="Hand"
                                           MouseLeftButtonDown="OnPickDown" MouseMove="OnPickMove" MouseLeftButtonUp="OnPickUp" ToolTip="Blue: click or drag to pick" />
                                </Border>
                                <Canvas Margin="1,0,0,0">
                                    <Path Data="M6 0 12 8H0z" Fill="{StaticResource GhText}" IsHitTestVisible="False" Canvas.Top="20"
                                          Canvas.Left="{Binding BlueAlong, Converter={StaticResource Offset}, ConverterParameter='436 -6'}" />
                                </Canvas>
                            </Grid>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                        <TextBlock Style="{StaticResource Label}" Text="Color:" Width="40" Margin="0,0,10,0" Foreground="{StaticResource GhIcon}" />
                        <TextBox Style="{StaticResource NumberBox}" Width="150" Text="{Binding TrueColorText}" KeyDown="OnBoxKeyDown"
                                 ToolTip="Red, green and blue, each 0 to 255, as 255,127,0" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap"
                               Text="A true colour is written to the DXF as red, green and blue (group 420), with the nearest colour of the index beside it (group 62)." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
