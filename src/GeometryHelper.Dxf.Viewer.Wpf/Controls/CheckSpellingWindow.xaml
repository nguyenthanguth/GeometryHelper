<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.CheckSpellingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Check Spelling"
    Width="560"
    Height="470"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Side" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design CheckSpelling: Where to check and Start, the word and its suggestions on the left, the answers on the right. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Check Spelling" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="18,5"
                        Click="OnClose"
                        IsCancel="True"
                    />
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Settings..."
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Click="OnSettings"
                    />
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Undo"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanUndo}"
                        Click="OnUndo"
                    />
                    <TextBlock
                        Text="Undo takes back the last answer. Close writes the changes as one step of undo."
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Where to check:" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Width="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            ToolTip="Select objects"
                            AutomationProperties.Name="Select objects"
                            IsEnabled="{Binding CanSelectObjects}"
                            Click="OnSelectObjects"
                        >
                            <local:IconView Size="14" StrokeThickness="2" Data="{StaticResource GhIconSelectObjects}" />
                        </Button>
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            AutomationProperties.Name="Where to check"
                            ItemsSource="{Binding Places}"
                            SelectedItem="{Binding Where, Mode=TwoWay}"
                        />
                    </DockPanel>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource Side}"
                    Margin="0"
                    VerticalAlignment="Bottom"
                    Content="Start"
                    Click="OnStart"
                />

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource Label}" Text="Not in dictionary:" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        IsReadOnly="True"
                        FontFamily="{StaticResource GhMonoFont}"
                        Foreground="{StaticResource GhWarn}"
                        AutomationProperties.Name="Not in dictionary"
                        Text="{Binding Word, Mode=OneWay}"
                    />
                </StackPanel>
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource Side}"
                    Margin="0"
                    VerticalAlignment="Bottom"
                    Content="Add to Dictionary"
                    IsEnabled="{Binding IsChecking}"
                    Click="OnAdd"
                />

                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="Suggestions:" />
                    <TextBox
                        DockPanel.Dock="Top"
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        Margin="0,0,0,4"
                        FontFamily="{StaticResource GhMonoFont}"
                        AutomationProperties.Name="Replacement"
                        Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource GhTextMuted}"
                        TextTrimming="CharacterEllipsis"
                    >
                        <Run Text="In: " />
                        <Run Text="{Binding Context, Mode=OneWay}" Foreground="{StaticResource GhText}" />
                    </TextBlock>
                    <ListBox
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        Foreground="{StaticResource GhText}"
                        FontFamily="{StaticResource GhMonoFont}"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        AutomationProperties.Name="Suggestions"
                        ItemsSource="{Binding Suggestions}"
                        SelectedItem="{Binding Suggestion, Mode=TwoWay}"
                    />
                </DockPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" IsEnabled="{Binding IsChecking}">
                    <Button Style="{StaticResource Side}" Content="Ignore" Click="OnIgnore" />
                    <Button Style="{StaticResource Side}" Content="Ignore All" Click="OnIgnoreAll" />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Padding="8,5"
                        Margin="0,10,0,6"
                        Content="Change"
                        Click="OnChange"
                    />
                    <Button Style="{StaticResource Side}" Content="Change All" Click="OnChangeAll" />
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Style="{StaticResource Label}" Text="Main dictionary:" />
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        AutomationProperties.Name="Main dictionary"
                        ItemsSource="{Binding MainDictionaries}"
                        SelectedIndex="0"
                    />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="Custom dictionary:" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        AutomationProperties.Name="Custom dictionary file"
                        ToolTip="A text file of words, one to a line"
                        Text="{Binding DictionaryFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    />
                </StackPanel>
                <TextBlock
                    Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Margin="0,10,0,0"
                    Foreground="{StaticResource GhTextMuted}"
                    TextWrapping="Wrap"
                    Text="{Binding Status}"
                />
            </Grid>
        </DockPanel>
    </Border>
</Window>
