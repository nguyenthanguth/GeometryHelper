<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.HatchSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Hatch"
    Width="900"
    Height="600"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:RgbBrushConverter x:Key="RgbBrush" />

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="94" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!-- The Pattern file box: read only, in mono type, muted while it names the built-in set. -->
            <Style x:Key="FileBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBuiltInFile}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Built-in: dimmer than a muted word while there is nothing to go back from. -->
            <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#6B7480" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
                <Setter Property="Width" Value="90" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,6,0"
                            Click="OnOk"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhWarn}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>

            <!-- The pattern file, for every type: the presenter's own set, or a .pat file chosen by Browse… whose patterns follow it. -->
            <Border
                DockPanel.Dock="Top"
                Padding="16,14,16,10"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
            >
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="Pattern file" />
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource ResetButton}"
                            Content="Built-in"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Command="{Binding BuiltInCommand}"
                            ToolTip="Go back to the built-in patterns"
                        />
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Content="Browse…"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}"
                        />
                        <Border
                            BorderBrush="{StaticResource GhBorder}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="{StaticResource GhInput}"
                            Padding="8,4"
                        >
                            <TextBox
                                Style="{StaticResource FileBox}"
                                Text="{Binding PatternFileText, Mode=OneWay}"
                                IsReadOnly="True"
                                ToolTip="{Binding PatternFileText}"
                            />
                        </Border>
                    </DockPanel>
                    <TextBlock
                        Text="{Binding PatternFileHint}"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="102,4,0,0"
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </Border>

            <!-- The preview, drawn by the presenter's own hatch display, and the type and pattern beside it. -->
            <DockPanel Margin="16,10,16,14">
                <!-- Design HatchMoreOptions: gradient colours, look, hatch origin and gap tolerance, right of the preview. -->
                <StackPanel DockPanel.Dock="Right" Width="270" Margin="20,0,0,0">
                    <StackPanel Visibility="{Binding IsGradient, Converter={StaticResource Shown}}">
                        <TextBlock Text="Gradient colours" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Style="{StaticResource Row}">
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="One color"
                                Margin="0,0,16,0"
                                IsChecked="{Binding IsOneColor, Mode=TwoWay}"
                            />
                            <RadioButton
                                Style="{StaticResource BlockRadio}"
                                Content="Two color"
                                IsChecked="{Binding IsTwoColor, Mode=TwoWay}"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding IsOneColor, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Text="Shade" Foreground="{StaticResource GhTextMuted}" Margin="0,0,8,0" />
                            <Slider
                                Width="150"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.01"
                                LargeChange="0.1"
                                AutomationProperties.Name="Shade to tint"
                                Value="{Binding Tint, Mode=TwoWay}"
                            />
                            <TextBlock Text="Tint" Foreground="{StaticResource GhTextMuted}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Look" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Hatch color" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="140"
                            ItemsSource="{Binding HatchColors}"
                            SelectedItem="{Binding HatchColor, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Background" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="140"
                            ItemsSource="{Binding BackgroundColors}"
                            SelectedItem="{Binding BackgroundColor, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Layer" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="140"
                            ItemsSource="{Binding Layers}"
                            SelectedItem="{Binding Layer, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Transparency" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="140"
                            ItemsSource="{Binding Transparencies}"
                            SelectedItem="{Binding Transparency, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding HasTransparencyValue, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            AutomationProperties.Name="Transparency value"
                            Text="{Binding TransparencyValue, UpdateSourceTrigger=LostFocus}"
                            KeyDown="OnBoxKeyDown"
                            Margin="0,0,6,0"
                        />
                        <TextBlock
                            Text="0 to 90"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                    </StackPanel>

                    <TextBlock Text="Hatch origin" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        Content="Use current origin"
                        Margin="0,0,0,6"
                        IsChecked="{Binding IsCurrentOrigin, Mode=TwoWay}"
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        Content="Specified origin (Origin X, Y)"
                        Margin="0,0,0,6"
                        IsChecked="{Binding IsSpecifiedOrigin, Mode=TwoWay}"
                    />
                    <StackPanel Style="{StaticResource Row}" Margin="18,0,0,6">
                        <CheckBox
                            Style="{StaticResource GhCheckBox}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            IsChecked="{Binding DefaultToExtents, Mode=TwoWay}"
                        />
                        <TextBlock Text="Default to boundary extents" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </StackPanel>
                    <ComboBox
                        Style="{StaticResource GhComboBox}"
                        Width="140"
                        HorizontalAlignment="Left"
                        Margin="42,0,0,6"
                        AutomationProperties.Name="Corner"
                        ItemsSource="{Binding Corners}"
                        SelectedItem="{Binding Corner, Mode=TwoWay}"
                        IsEnabled="{Binding DefaultToExtents}"
                    />
                    <StackPanel Style="{StaticResource Row}" Margin="18,0,0,6">
                        <CheckBox
                            Style="{StaticResource GhCheckBox}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsSpecifiedOrigin}"
                            IsChecked="{Binding StoreAsDefault, Mode=TwoWay}"
                        />
                        <TextBlock Text="Store as default origin" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Gap tolerance" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Tolerance" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            AutomationProperties.Name="Gap tolerance"
                            Text="{Binding GapTolerance, UpdateSourceTrigger=LostFocus}"
                            KeyDown="OnBoxKeyDown"
                            Margin="0,0,6,0"
                        />
                        <TextBlock Text="units" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                    <TextBlock Text="Preview" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Width="162" Height="162">
                        <Image Source="{Binding Preview}" Width="160" Height="160" />
                    </Border>
                    <TextBlock
                        Text="{Binding PatternCaption}"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="0,6,0,0"
                        Width="162"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsPattern, Converter={StaticResource Shown}}"
                    />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Pattern" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Hatch type" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="160"
                            ItemsSource="{Binding Types}"
                            SelectedItem="{Binding Type, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsPattern, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Pattern" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="160"
                            ItemsSource="{Binding Patterns}"
                            SelectedItem="{Binding Pattern, Mode=TwoWay}"
                            FontFamily="{StaticResource GhMonoFont}"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HatchPatternChoice}">
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Source}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsGradient, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Gradient" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="160"
                            ItemsSource="{Binding GradientNames}"
                            SelectedItem="{Binding GradientName, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsGradient, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Colours:" />
                        <Button
                            Style="{StaticResource GhFlatButton}"
                            Padding="2"
                            Margin="0,0,6,0"
                            Command="{Binding PickColor1Command}"
                            ToolTip="Gradient colour 1"
                        >
                            <Border
                                Width="36"
                                Height="16"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                Background="{Binding Color1Rgb, Converter={StaticResource RgbBrush}}"
                            />
                        </Button>
                        <Button
                            Style="{StaticResource GhFlatButton}"
                            Padding="2"
                            Margin="0,0,12,0"
                            Command="{Binding PickColor2Command}"
                            Visibility="{Binding IsTwoColor, Converter={StaticResource Shown}}"
                            ToolTip="Gradient colour 2"
                        >
                            <Border
                                Width="36"
                                Height="16"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                Background="{Binding Color2Rgb, Converter={StaticResource RgbBrush}}"
                            />
                        </Button>
                        <CheckBox
                            Style="{StaticResource GhCheckBox}"
                            IsChecked="{Binding Centered, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                        />
                        <TextBlock Text="Centered" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock
                        Text="Properties"
                        FontWeight="SemiBold"
                        Margin="0,8,0,8"
                        Visibility="{Binding HasAngle, Converter={StaticResource Shown}}"
                    />
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding HasAngle, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Angle" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding Angle, UpdateSourceTrigger=LostFocus}"
                            KeyDown="OnBoxKeyDown"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsPattern, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Scale" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding Scale, UpdateSourceTrigger=LostFocus}"
                            KeyDown="OnBoxKeyDown"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsIso, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="ISO pen width" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="90"
                            ItemsSource="{Binding IsoPenWidths}"
                            SelectedItem="{Binding IsoPenWidth, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsUserDefined, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Spacing" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding Spacing, UpdateSourceTrigger=LostFocus}"
                            KeyDown="OnBoxKeyDown"
                            Margin="0,0,12,0"
                        />
                        <CheckBox
                            Style="{StaticResource GhCheckBox}"
                            IsChecked="{Binding Double, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                        />
                        <TextBlock Text="Double" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        Style="{StaticResource Row}"
                        Visibility="{Binding IsPattern, Converter={StaticResource Shown}}"
                    >
                        <TextBlock Style="{StaticResource Label}" Text="Origin X, Y" />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding OriginX, UpdateSourceTrigger=LostFocus}"
                            IsEnabled="{Binding IsSpecifiedOrigin}"
                            KeyDown="OnBoxKeyDown"
                            Margin="0,0,6,0"
                        />
                        <TextBox
                            Style="{StaticResource NumberBox}"
                            Text="{Binding OriginY, UpdateSourceTrigger=LostFocus}"
                            IsEnabled="{Binding IsSpecifiedOrigin}"
                            KeyDown="OnBoxKeyDown"
                        />
                    </StackPanel>

                    <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Island detection" />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="160"
                            ItemsSource="{Binding IslandStyles}"
                            SelectedItem="{Binding IslandStyle, Mode=TwoWay}"
                        />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Associative" />
                        <CheckBox
                            Style="{StaticResource GhCheckBox}"
                            IsChecked="{Binding Associative, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip="The hatch keeps the handles of its boundary objects; it is not made anew when they move"
                        />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
