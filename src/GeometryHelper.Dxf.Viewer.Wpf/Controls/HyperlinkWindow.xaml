<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.HyperlinkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Hyperlink"
    Width="620"
    Height="420"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />

            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: Insert Hyperlink or Edit Hyperlink, dragged to move the dialog, and the close button. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="{Binding WindowTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- Footer: Remove Link (Edit Hyperlink only) and why OK was refused on the left, OK and Cancel on the right. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Click="OnOk"
                            IsDefault="True"
                        />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource GhDialogButton}"
                        Content="Remove Link"
                        Padding="14,5"
                        Margin="0,0,12,0"
                        Click="OnRemove"
                        Visibility="{Binding CanRemove, Converter={StaticResource Shown}}"
                    />
                    <TextBlock
                        Text="{Binding Notice}"
                        Foreground="{StaticResource GhWarn}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <!-- Link to: the three kinds of target, in AutoCAD's order, down the left. -->
            <Border
                DockPanel.Dock="Left"
                Width="200"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,1,0"
                Padding="16,14,12,14"
            >
                <StackPanel>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Link to:" />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="Existing File or Web Page"
                        IsChecked="{Binding IsFileKind, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="View of This Drawing"
                        IsChecked="{Binding IsViewKind, Mode=TwoWay}"
                        Margin="0,0,0,6"
                    />
                    <RadioButton
                        Style="{StaticResource GhChip}"
                        Content="E-mail Address"
                        IsChecked="{Binding IsEmailKind, Mode=TwoWay}"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource RowLabel}" Text="Text to display:" />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding TextToDisplay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Text to display"
                />

                <!-- Existing File or Web Page: the address with Browse…, and the named location in it. -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsFileKind, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Type the file or web page name:" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhDialogButton}"
                            Content="Browse…"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Click="OnBrowse"
                        />
                        <TextBox
                            Style="{StaticResource StyleBox}"
                            Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="File or web page"
                        />
                    </DockPanel>
                    <TextBlock
                        Style="{StaticResource RowLabel}"
                        Text="Named location in it (optional):"
                        Margin="0,12,0,4"
                    />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Named location"
                    />
                </StackPanel>

                <!-- View of This Drawing: the named views of the drawing. -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsViewKind, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Select a view of this drawing:" />
                    <ListBox
                        Style="{StaticResource GhListBox}"
                        Height="170"
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        ItemContainerStyle="{StaticResource StyleListItem}"
                        Foreground="{StaticResource GhText}"
                        ItemsSource="{Binding Views}"
                        SelectedItem="{Binding ViewName, Mode=TwoWay}"
                        AutomationProperties.Name="Views of this drawing"
                    />
                </StackPanel>

                <!-- E-mail Address: the address and the subject. -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsEmailKind, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="E-mail address:" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="E-mail address"
                    />
                    <TextBlock Style="{StaticResource RowLabel}" Text="Subject:" Margin="0,12,0,4" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Subject"
                    />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
