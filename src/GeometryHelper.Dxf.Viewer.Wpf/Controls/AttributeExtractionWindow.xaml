<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.AttributeExtractionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Attribute Extraction"
    Width="460"
    Height="380"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FileButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Width" Value="120" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design AttributeExtraction: File Format, Select Objects, the template and output files. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Attribute Extraction"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            Click="OnOk"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="File Format">
                    <StackPanel>
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Margin="0,0,0,6"
                            Content="Comma Delimited File (CDF)"
                            IsChecked="{Binding IsCdf, Mode=TwoWay}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Margin="0,0,0,6"
                            Content="Space Delimited File (SDF)"
                            IsChecked="{Binding IsSdf, Mode=TwoWay}"
                        />
                        <RadioButton
                            Style="{StaticResource BlockRadio}"
                            Content="DXF Format Extract File (DXX)"
                            IsChecked="{Binding IsDxf, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource FileButton}" Content="Select Objects &lt;" Click="OnSelect" />
                    <TextBlock
                        Text="{Binding NumberFound}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </StackPanel>
                <DockPanel Margin="0,10,0,0" IsEnabled="{Binding NeedsTemplate}">
                    <Button Style="{StaticResource FileButton}" Content="Template File…" Click="OnTemplate" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Template file"
                        Text="{Binding TemplateFile, Mode=TwoWay}"
                    />
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource FileButton}" Content="Output File…" Click="OnOutput" />
                    <TextBox
                        Style="{StaticResource StyleBox}"
                        AutomationProperties.Name="Output file"
                        Text="{Binding OutputFile, Mode=TwoWay}"
                    />
                </DockPanel>
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhTextMuted}"
                    Text="No objects selected: every block with attributes in the drawing. A DXX extract needs no template."
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
