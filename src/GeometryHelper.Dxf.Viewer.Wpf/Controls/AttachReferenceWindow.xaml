<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.AttachReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="{Binding Title}" Width="760" Height="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="14,5" Click="OnOk" IsDefault="True" IsEnabled="{Binding CanOk}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource GhError}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14,16,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Name:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhDialogButton}" Content="Browse…" Padding="10,3" Margin="8,0,0,0" Click="OnBrowse" />
                            <ComboBox Style="{StaticResource GhComboBox}" IsEditable="True" ItemsSource="{Binding Names}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                        </DockPanel>
                        <TextBlock Text="{Binding FilesNote}" Foreground="{StaticResource GhTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Reference Type" Visibility="{Binding IsXref, Converter={StaticResource Shown}}">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource BlockRadio}" GroupName="Type" Content="Attachment" IsChecked="{Binding IsAttachment, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource BlockRadio}" GroupName="Type" Content="Overlay" IsChecked="{Binding IsOverlay, Mode=TwoWay}" />
                                    <TextBlock Text="An overlay is not shown when this drawing is itself attached to another." Foreground="{StaticResource GhTextMuted}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="2" Style="{StaticResource BlockGroup}" Header="Path type">
                                <StackPanel>
                                    <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding PathTypes}" SelectedItem="{Binding PathType, Mode=TwoWay}" Margin="0,0,0,6" AutomationProperties.Name="Path type" />
                                    <TextBlock Text="{Binding PathNote}" Foreground="{StaticResource GhTextMuted}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </Grid>
                        <CheckBox Style="{StaticResource BlockCheck}" Content="Locate using Geographic Data" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preview" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,4" />
                        <Border Height="150" Background="Black" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4" />
                        </Border>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Insertion point" Margin="0,0,5,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource BlockCheck}" Content="Specify on-screen" IsChecked="{Binding SpecifyPointOnScreen, Mode=TwoWay}" />
                            <DockPanel Margin="0,0,0,4" IsEnabled="{Binding IsPointTyped}">
                                <TextBlock Text="X:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource BlockNumber}" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Insertion X" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4" IsEnabled="{Binding IsPointTyped}">
                                <TextBlock Text="Y:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource BlockNumber}" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Insertion Y" />
                            </DockPanel>
                            <DockPanel IsEnabled="{Binding IsPointTyped}">
                                <TextBlock Text="Z:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource BlockNumber}" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Insertion Z" />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Scale" Margin="5,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource BlockCheck}" Content="Specify on-screen" IsChecked="{Binding SpecifyScaleOnScreen, Mode=TwoWay}" />
                            <DockPanel Margin="0,0,0,4" IsEnabled="{Binding IsScaleTyped}">
                                <TextBlock Text="{Binding ScaleLabel}" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource BlockNumber}" Text="{Binding ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scale X" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsXref, Converter={StaticResource Shown}}">
                                <DockPanel Margin="0,0,0,4" IsEnabled="{Binding IsScaleYZTyped}">
                                    <TextBlock Text="Y:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource BlockNumber}" Text="{Binding ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scale Y" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4" IsEnabled="{Binding IsScaleYZTyped}">
                                    <TextBlock Text="Z:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource BlockNumber}" Text="{Binding ScaleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scale Z" />
                                </DockPanel>
                                <CheckBox Style="{StaticResource BlockCheck}" Content="Uniform Scale" IsChecked="{Binding UniformScale, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource BlockGroup}" Header="Rotation" Margin="5,0,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource BlockCheck}" Content="Specify on-screen" IsChecked="{Binding SpecifyRotationOnScreen, Mode=TwoWay}" />
                            <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsRotationTyped}">
                                <TextBlock Text="Angle:" Width="44" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource BlockNumber}" Text="{Binding Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rotation angle" />
                            </DockPanel>
                            <TextBlock Text="{Binding UnitTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Unit:" Width="44" Foreground="{StaticResource GhTextMuted}" />
                                <TextBlock Text="{Binding UnitText}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding UnitSecondLabel}" Width="44" Foreground="{StaticResource GhTextMuted}" />
                                <TextBlock Text="{Binding UnitSecond}" FontFamily="{StaticResource GhMonoFont}" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </UniformGrid>

                <Expander IsExpanded="True" Foreground="{StaticResource GhText}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" Padding="10,6">
                    <Expander.Header>
                        <TextBlock Text="Hide details" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Grid Margin="0,6,0,0" TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Found in:" FontFamily="{StaticResource GhFont}" Foreground="{StaticResource GhTextMuted}" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="1" Text="{Binding FoundIn}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="Saved path:" FontFamily="{StaticResource GhFont}" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavedPath}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Expander>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
