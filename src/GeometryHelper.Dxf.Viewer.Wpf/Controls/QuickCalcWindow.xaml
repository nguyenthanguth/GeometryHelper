<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.QuickCalcWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="QuickCalc"
    Width="300"
    Height="700"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="Margin" Value="1.5" />
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
            </Style>
            <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ToolIcon" TargetType="Path">
                <Setter Property="Stroke" Value="#C9D1DB" />
                <Setter Property="StrokeThickness" Value="1.8" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="Uniform" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design QuickCalc: the tools, the history, the input with its value, Number Pad and Scientific. A palette: it stays open. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="QuickCalc" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
            >
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Tool}" ToolTip="Clear" Click="OnClear">
                        <Path Style="{StaticResource ToolIcon}" Data="M5 19h14M8 15l8-8M8 7l8 8" />
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Clear History" Click="OnClearHistory">
                        <Path Style="{StaticResource ToolIcon}" Data="M4 6h10M4 11h10M4 16h6M15 14l5 5M20 14l-5 5" />
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Paste value to command line" Click="OnPaste">
                        <Path Style="{StaticResource ToolIcon}" Data="M4 18h16M7 14l3-3-3-3M12 14h5" />
                    </Button>
                    <Rectangle Width="1" Margin="4,3" Fill="{StaticResource GhBorder}" />
                    <Button Style="{StaticResource Tool}" ToolTip="Get Coordinates" Click="OnCoordinates">
                        <Path
                            Style="{StaticResource ToolIcon}"
                            Data="M12 3v18M3 12h18M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0"
                        />
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Distance Between Two Points" Click="OnDistance">
                        <Path
                            Style="{StaticResource ToolIcon}"
                            Data="M4 18L20 6M6 18a2 2 0 1 1-4 0a2 2 0 1 1 4 0M22 6a2 2 0 1 1-4 0a2 2 0 1 1 4 0"
                        />
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Angle of Line Defined by Two Points" Click="OnAngle">
                        <Path Style="{StaticResource ToolIcon}" Data="M4 19h16M4 19L18 6M11 19a7 7 0 0 0-2-5" />
                    </Button>
                    <Button
                        Style="{StaticResource Tool}"
                        ToolTip="Intersection of Two Lines Defined by Four Points"
                        Click="OnIntersection"
                    >
                        <Path
                            Style="{StaticResource ToolIcon}"
                            Data="M4 18L20 6M4 6l16 12M14 12a2 2 0 1 1-4 0a2 2 0 1 1 4 0"
                        />
                    </Button>
                </StackPanel>
            </Border>

            <ListBox
                DockPanel.Dock="Top"
                Height="150"
                Background="{StaticResource GhInput}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Foreground="{StaticResource GhText}"
                FontFamily="{StaticResource GhMonoFont}"
                ItemContainerStyle="{StaticResource StyleListItem}"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="History"
                ItemsSource="{Binding History}"
                MouseDoubleClick="OnRecall"
            >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Shown}" Margin="8,0,0,0" />
                            <TextBlock
                                Text="{Binding Expression}"
                                Foreground="{StaticResource GhTextMuted}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel DockPanel.Dock="Top" Margin="10,8">
                <TextBox
                    x:Name="InputBox"
                    Style="{StaticResource StyleBox}"
                    Padding="6,5"
                    FontFamily="{StaticResource GhMonoFont}"
                    AutomationProperties.Name="Expression"
                    Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="OnInputKey"
                />
                <TextBlock
                    Text="{Binding Result}"
                    HorizontalAlignment="Right"
                    FontFamily="{StaticResource GhMonoFont}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,4,0,0"
                />
                <TextBlock
                    Text="{Binding Message}"
                    Foreground="{StaticResource GhError}"
                    TextWrapping="Wrap"
                    FontSize="11"
                />
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="10,6">
                <TextBlock Text="Number Pad" FontWeight="SemiBold" />
            </Border>
            <ItemsControl DockPanel.Dock="Top" Margin="8,6" ItemsSource="{Binding PadKeys}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Key}" Content="{Binding}" Click="OnKey" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                DockPanel.Dock="Top"
                Style="{StaticResource StylePrimaryButton}"
                Content="="
                Margin="9.5,0,9.5,6"
                Padding="0,4"
                Click="OnEquals"
            />

            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="10,6">
                <TextBlock Text="Scientific" FontWeight="SemiBold" />
            </Border>
            <ItemsControl DockPanel.Dock="Top" Margin="8,6" ItemsSource="{Binding ScientificKeys}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Key}" Content="{Binding}" Click="OnKey" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,0"
                Padding="10,6"
                VerticalAlignment="Bottom"
            >
                <TextBlock
                    TextWrapping="Wrap"
                    FontSize="11"
                    Foreground="{StaticResource GhTextMuted}"
                    Text="The point buttons ask in the drawing (&gt;&gt; Enter a point:) and put the value into the input. Enter or = evaluates; a history line double-clicked comes back to the input."
                />
            </Border>
        </DockPanel>
    </Border>
</Window>
