<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.RenameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename"
    Width="520"
    Height="460"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="List" TargetType="ListBox" BasedOn="{StaticResource GhListBox}">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource StyleListItem}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design RenameDialog: Named Objects and Items side by side, Old Name, Rename To; OK makes every rename as one undo step. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Rename" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                        <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="18,5" Click="OnOk" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="{StaticResource GhError}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>

            <DockPanel Margin="16,12">
                <Border
                    DockPanel.Dock="Bottom"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,10,0,0"
                >
                    <DockPanel>
                        <Ellipse
                            DockPanel.Dock="Left"
                            Width="8"
                            Height="8"
                            Fill="{StaticResource GhAccent}"
                            VerticalAlignment="Top"
                            Margin="0,4,8,0"
                        />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{StaticResource GhTextMuted}"
                            Text="Rename To changes the name in the Items list at once; OK writes every rename as one step of undo, with each reference following, as -RENAME does. An Old Name with * or ? renames every item it matches: S-* to A-* renames S-BEAM to A-BEAM."
                        />
                    </DockPanel>
                </Border>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Old Name:" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="2"
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        AutomationProperties.Name="Old Name"
                        ToolTip="The item picked, or a name with * and ? to rename every item it matches"
                        Text="{Binding OldName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <Button
                        Grid.Row="2"
                        Style="{StaticResource GhDialogButton}"
                        Content="Rename To:"
                        Padding="8,4"
                        Click="OnRenameTo"
                    />
                    <TextBox
                        x:Name="NewNameBox"
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource StyleBox}"
                        Padding="6,3"
                        AutomationProperties.Name="New name"
                        Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Named Objects" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox
                            Style="{StaticResource List}"
                            AutomationProperties.Name="Named Objects"
                            ItemsSource="{Binding Kinds}"
                            SelectedItem="{Binding Kind, Mode=TwoWay}"
                        />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox
                            Style="{StaticResource List}"
                            AutomationProperties.Name="Items"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding Item, Mode=TwoWay}"
                        />
                    </DockPanel>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
