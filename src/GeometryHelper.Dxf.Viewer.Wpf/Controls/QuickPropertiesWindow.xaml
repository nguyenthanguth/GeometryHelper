<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.QuickPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Quick Properties"
    Width="240"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Shown" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design QuickProperties: the kind and count of the selection, then Color, Layer and Linetype, edited in place. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <StackPanel>
            <Border
                Background="{StaticResource GhHeader}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding SelectionLabel}" VerticalAlignment="Center" Margin="2,0,0,0" />
                </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding QuickPropertyRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Label}"
                                Foreground="{StaticResource GhTextMuted}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                            />
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource GhComboBox}"
                                Margin="0,1,1,1"
                                AutomationProperties.Name="{Binding Label}"
                                ItemsSource="{Binding Options}"
                                SelectedItem="{Binding Value, Mode=TwoWay}"
                                Visibility="{Binding HasOptions, Converter={StaticResource Shown}}"
                            />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Value}"
                                Padding="8,4"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Shown}}"
                            />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
