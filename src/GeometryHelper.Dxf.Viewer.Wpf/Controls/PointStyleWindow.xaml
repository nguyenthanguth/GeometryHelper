<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.PointStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Point Style" Width="460" Height="420" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A tile of PDMODE: its symbol on a dark ground, framed in the accent when chosen. -->
            <Style x:Key="PointTile" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="64" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Tile" Background="{StaticResource GhCommandInput}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource GhTextMuted}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource GhSelected}" />
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A round button with its words: a ring, the accent dot inside when chosen. -->
            <Style x:Key="PlainRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1" Fill="{StaticResource GhInput}" />
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource GhAccent}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhTitleCloseButton}" Click="OnCancel" ToolTip="Close" />
                    <TextBlock Text="Point Style" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource StylePrimaryButton}" Content="OK" Padding="22,5" Margin="0,0,8,0" Click="OnOk" IsDefault="True"
                            IsEnabled="{Binding IsSizeValid}" />
                    <Button Style="{StaticResource GhDialogButton}" Content="Cancel" Padding="14,5" Click="OnCancel" IsCancel="True" />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,10,16,0">
                <!-- The twenty modes, five to a row, each drawn as the canvas draws a point of it. -->
                <ItemsControl ItemsSource="{Binding Tiles}" HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PointStyleTileViewModel}">
                            <RadioButton Style="{StaticResource PointTile}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         ToolTip="{Binding Mode, StringFormat='PDMODE {0}'}" AutomationProperties.Name="{Binding Label}">
                                <Grid Width="32" Height="32">
                                    <Path Data="{Binding Symbol}" Stroke="{StaticResource GhText}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Ellipse Width="3.2" Height="3.2" Fill="{StaticResource GhText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding HasDot, Converter={StaticResource Shown}}" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The size and what it is measured in. -->
                <StackPanel Margin="22,8,22,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Point size" Width="70" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource StyleBox}" Width="90" Padding="8,4" BorderThickness="0" Margin="8,0,8,0"
                                 Text="{Binding PointSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding UnitText}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <RadioButton Style="{StaticResource PlainRadio}" GroupName="PointSize" Content="Set size relative to screen" IsChecked="{Binding IsRelative, Mode=TwoWay}" Margin="0,0,0,6" />
                    <RadioButton Style="{StaticResource PlainRadio}" GroupName="PointSize" Content="Set size in absolute units" IsChecked="{Binding IsAbsolute, Mode=TwoWay}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource GhTextMuted}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
