<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.PageSetupManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Page Setup Manager"
    Width="640"
    Height="440"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- Page Setup Manager, which PAGESETUP opens: the named page setups of the drawing, Set Current, New…, Modify… and Import…. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SetupRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Row"
                                BorderBrush="{StaticResource GhHeader}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                            >
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Close"
                        Padding="14,5"
                        Click="OnClose"
                        IsDefault="True"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Message}"
                        Foreground="#F26B3A"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,12,0"
                        ToolTip="{Binding Message}"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LayoutText}" Foreground="{StaticResource GhTextMuted}" />
                        <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Text="{Binding DetailsText}"
                        Foreground="{StaticResource GhTextMuted}"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        MinHeight="34"
                    />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Background="{StaticResource GhHeader}"
                                Text="Page setups"
                                Padding="8,6"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <ListBox
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding Selected, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource SetupRow}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Page setups"
                                MouseDoubleClick="OnModify"
                            >
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PageSetupRow}">
                                        <DockPanel>
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                Text="Current"
                                                Padding="8,5"
                                                Foreground="{StaticResource GhAccent}"
                                            >
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                Padding="8,5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource GhText}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="2" Margin="0,24,0,0">
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Set Current"
                        Click="OnSetCurrent"
                        IsEnabled="{Binding CanSetCurrent}"
                    />
                    <Button Style="{StaticResource SideButton}" Content="New…" Click="OnNew" />
                    <Button
                        Style="{StaticResource SideButton}"
                        Content="Modify…"
                        Click="OnModify"
                        IsEnabled="{Binding CanModify}"
                    />
                    <Border Height="6" />
                    <Button Style="{StaticResource SideButton}" Content="Import…" Click="OnImport" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
