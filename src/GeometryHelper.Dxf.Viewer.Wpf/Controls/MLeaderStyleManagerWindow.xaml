<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.MLeaderStyleManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
    Title="Multileader Style Manager"
    Width="780"
    Height="540"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A style of the list: the current mark, the annotative triangle where it is annotative, the name in semibold. -->
            <DataTemplate x:Key="MLeaderStyleRowTemplate" DataType="{x:Type local:MLeaderStyleRowViewModel}">
                <DockPanel>
                    <TextBlock
                        x:Name="Mark"
                        DockPanel.Dock="Left"
                        Text="✓"
                        Width="14"
                        Margin="0,0,6,0"
                        Foreground="{StaticResource GhOk}"
                        Visibility="Hidden"
                    />
                    <Path
                        x:Name="Annotative"
                        DockPanel.Dock="Left"
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        Stretch="None"
                        Visibility="Collapsed"
                        ToolTip="Annotative"
                        Data="M7 1.75 1.75 11.9H12.25ZM4.7 8.2H9.3"
                        Stroke="#E3B341"
                        StrokeThickness="1.1"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                    />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAnnotative}" Value="True">
                        <Setter TargetName="Annotative" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title with the drawing's name, dragged to move the dialog, and the close button (Close). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CloseCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: how many styles, then Close. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhCloseButton}"
                        Content="Close"
                        Padding="14,5"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                    />
                    <TextBlock
                        Text="{Binding Footer}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <!-- The styles: the current one ticked, the annotative ones marked; double-click modifies; the filter below. -->
                <DockPanel Grid.Column="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock
                            DockPanel.Dock="Right"
                            Text="{Binding CurrentStyleText}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Style="{StaticResource StyleGroup}" Text="Styles" Margin="0" />
                    </DockPanel>
                    <ComboBox
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding Filters}"
                        SelectedItem="{Binding Filter, Mode=TwoWay}"
                        Margin="0,6,0,0"
                    >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='List: {0}'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4">
                        <ListBox
                            x:Name="StyleList"
                            ItemsSource="{Binding Styles}"
                            SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource GhText}"
                            ItemContainerStyle="{StaticResource StyleListItem}"
                            ItemTemplate="{StaticResource MLeaderStyleRowTemplate}"
                            MouseDoubleClick="OnStyleDoubleClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        />
                    </Border>
                </DockPanel>

                <!-- The preview of the style selected, its description and why a button was refused. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StyleGroup}" Text="{Binding PreviewTitle}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource StylePreview}" Height="250" Margin="0,0,0,8">
                        <Image Source="{Binding Preview}" Stretch="None" />
                    </Border>
                    <Border Style="{StaticResource StyleFrame}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Description" Foreground="{StaticResource GhTextMuted}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Style="{StaticResource StyleFrame}"
                        Visibility="{Binding HasNotice, Converter={StaticResource Shown}}"
                    >
                        <DockPanel>
                            <Ellipse
                                DockPanel.Dock="Left"
                                Width="8"
                                Height="8"
                                Margin="0,4,8,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource NoticeDot}"
                            />
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Set Current, New, Modify (the main one), Delete, and what Delete leaves. -->
                <StackPanel Grid.Column="4">
                    <Button
                        Style="{StaticResource StyleSideButton}"
                        Content="Set Current"
                        Command="{Binding SetCurrentCommand}"
                    />
                    <Button Style="{StaticResource StyleSideButton}" Content="New…" Command="{Binding NewCommand}" />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Modify…"
                        Padding="8,5"
                        Margin="0,0,0,6"
                        Command="{Binding ModifyCommand}"
                    />
                    <Button
                        Style="{StaticResource StyleSideButton}"
                        Content="Delete"
                        Command="{Binding DeleteCommand}"
                    />
                    <TextBlock
                        Text="{Binding DeleteNote}"
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
