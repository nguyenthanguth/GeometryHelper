<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.ToolPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tool Properties"
    Width="500"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <!-- Tool Properties of the tool palettes: name and description; the block, hatch or command of the tool; its overrides. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Width" Value="110" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="OnOk"
                            IsDefault="True"
                            IsEnabled="{Binding CanOk}"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Click="OnCancel"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Error}"
                        Foreground="#F26B3A"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Name" />
                    <TextBox
                        Style="{StaticResource BlockBox}"
                        Width="340"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Name"
                    />
                </StackPanel>
                <StackPanel
                    Style="{StaticResource Row}"
                    Visibility="{Binding HasOverrides, Converter={StaticResource Shown}}"
                >
                    <TextBlock Style="{StaticResource Label}" Text="Description" />
                    <TextBox
                        Style="{StaticResource BlockBox}"
                        Width="340"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Description"
                    />
                </StackPanel>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Command"
                    Margin="0,4,0,10"
                    Visibility="{Binding IsCommand, Converter={StaticResource Shown}}"
                >
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Command line" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="330"
                                Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="A command's name, then the answers to its first prompts, as typed: CIRCLE 0,0 50"
                                AutomationProperties.Name="Command line"
                            />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Insert"
                    Margin="0,4,0,10"
                    Visibility="{Binding IsBlock, Converter={StaticResource Shown}}"
                >
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Source file" />
                            <TextBox
                                Style="{StaticResource BlockBox}"
                                Width="260"
                                Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="The drawing the block comes from; empty for a block of the drawing shown"
                                AutomationProperties.Name="Source file"
                            />
                            <Button
                                Style="{StaticResource GhDialogButton}"
                                Content="Browse…"
                                Padding="8,3"
                                Margin="6,0,0,0"
                                Click="OnBrowse"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Block" />
                            <TextBox
                                Style="{StaticResource BlockBox}"
                                Width="150"
                                Text="{Binding BlockName, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="The block's name in its drawing; empty with a source file, the whole drawing as one block"
                                AutomationProperties.Name="Block"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Scale" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="80"
                                Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Scale"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Prompt for scale"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PromptForScale, Mode=TwoWay}"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Rotation" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="80"
                                Text="{Binding Angle, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Rotation"
                            />
                            <CheckBox
                                Style="{StaticResource BlockCheck}"
                                Content="Prompt for rotation"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PromptForRotation, Mode=TwoWay}"
                            />
                        </StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Explode"
                            Margin="110,0,0,0"
                            IsChecked="{Binding Explode, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Hatch"
                    Margin="0,4,0,10"
                    Visibility="{Binding IsHatch, Converter={StaticResource Shown}}"
                >
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Type" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="150"
                                ItemsSource="{Binding HatchTypes}"
                                SelectedItem="{Binding HatchType, Mode=TwoWay}"
                                AutomationProperties.Name="Hatch type"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding ShowsPattern, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Style="{StaticResource Label}" Text="Pattern" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="150"
                                IsEditable="True"
                                ItemsSource="{Binding Patterns}"
                                Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Pattern"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding ShowsGradient, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Style="{StaticResource Label}" Text="Gradient" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="150"
                                ItemsSource="{Binding Gradients}"
                                SelectedItem="{Binding Gradient, Mode=TwoWay}"
                                AutomationProperties.Name="Gradient"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding ShowsAngle, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Style="{StaticResource Label}" Text="Angle" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="80"
                                Text="{Binding Angle, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Angle"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding ShowsPattern, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Style="{StaticResource Label}" Text="Scale" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="80"
                                Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Hatch scale"
                            />
                        </StackPanel>
                        <StackPanel
                            Style="{StaticResource Row}"
                            Visibility="{Binding ShowsSpacing, Converter={StaticResource Shown}}"
                        >
                            <TextBlock Style="{StaticResource Label}" Text="Spacing" />
                            <TextBox
                                Style="{StaticResource BlockNumber}"
                                Width="80"
                                Text="{Binding Spacing, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Spacing"
                            />
                        </StackPanel>
                        <CheckBox
                            Style="{StaticResource BlockCheck}"
                            Content="Associative"
                            Margin="110,0,0,0"
                            IsChecked="{Binding Associative, Mode=TwoWay}"
                        />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl
                    Style="{StaticResource BlockGroup}"
                    Header="Overrides"
                    Margin="0,4,0,0"
                    Visibility="{Binding HasOverrides, Converter={StaticResource Shown}}"
                >
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Layer" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="200"
                                IsEditable="True"
                                ItemsSource="{Binding Layers}"
                                Text="{Binding Layer, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="A layer the drawing lacks is made when the tool runs"
                                AutomationProperties.Name="Layer"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Color" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="200"
                                IsEditable="True"
                                ItemsSource="{Binding Colors}"
                                Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="ByLayer, ByBlock, a name or an index 1 to 255"
                                AutomationProperties.Name="Color"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Linetype" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="200"
                                ItemsSource="{Binding Linetypes}"
                                SelectedItem="{Binding Linetype, Mode=TwoWay}"
                                AutomationProperties.Name="Linetype"
                            />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource Label}" Text="Lineweight" />
                            <ComboBox
                                Style="{StaticResource GhComboBox}"
                                Width="200"
                                ItemsSource="{Binding LineWeights}"
                                SelectedItem="{Binding LineWeight, Mode=TwoWay}"
                                AutomationProperties.Name="Lineweight"
                            />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
