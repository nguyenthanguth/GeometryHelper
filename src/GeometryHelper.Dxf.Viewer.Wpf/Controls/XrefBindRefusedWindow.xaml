<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.XrefBindRefusedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bind Xrefs/DGN Underlays"
    Width="520"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <StackPanel>
            <Border
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnOk"
                        ToolTip="Close, same as OK"
                    />
                    <TextBlock
                        Text="Bind Xrefs/DGN Underlays"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <DockPanel>
                    <Path
                        DockPanel.Dock="Left"
                        Data="M12 3 2 21h20zM12 10v5M12 18h.01"
                        Stroke="{StaticResource GhWarn}"
                        StrokeThickness="1.8"
                        Width="28"
                        Height="28"
                        Stretch="Uniform"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Margin="0,0,10,0"
                    />
                    <TextBlock
                        Text="Nothing was bound"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GhAccent}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>

                <!-- The lines -XREF Bind wrote, as the command line shows them. -->
                <Border
                    Margin="0,8,0,0"
                    Padding="10,6"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{StaticResource GhInput}"
                >
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    FontFamily="{StaticResource GhMonoFont}"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Margin="0,1"
                                />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock
                    Text="{Binding Hint}"
                    Foreground="{StaticResource GhTextMuted}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                />
            </StackPanel>

            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="0,0,6,6">
                <Button
                    HorizontalAlignment="Right"
                    Style="{StaticResource StylePrimaryButton}"
                    Content="OK"
                    Padding="22,5"
                    Click="OnOk"
                    IsDefault="True"
                    IsCancel="True"
                />
            </Border>
        </StackPanel>
    </Border>
</Window>
