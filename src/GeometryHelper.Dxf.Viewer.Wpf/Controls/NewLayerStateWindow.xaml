<Window
    x:Class="GeometryHelper.Dxf.Viewer.Wpf.NewLayerStateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Layer State to Save"
    Width="440"
    Height="320"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/BlockDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="New Layer State to Save"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        Click="OnOk"
                        IsDefault="True"
                        IsEnabled="{Binding CanOk}"
                    />
                </StackPanel>
            </Border>
            <DockPanel Margin="16,12">
                <TextBlock
                    DockPanel.Dock="Top"
                    Style="{StaticResource StyleLabel}"
                    Text="New layer state name:"
                    Margin="0,0,0,3"
                />
                <ComboBox
                    x:Name="NameBox"
                    DockPanel.Dock="Top"
                    Style="{StaticResource GhComboBox}"
                    IsEditable="True"
                    ItemsSource="{Binding Names}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="New layer state name"
                />
                <TextBlock
                    DockPanel.Dock="Top"
                    Style="{StaticResource StyleLabel}"
                    Text="Description:"
                    Margin="0,10,0,3"
                />
                <TextBox
                    Style="{StaticResource StyleBox}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    AcceptsReturn="False"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Description"
                />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
