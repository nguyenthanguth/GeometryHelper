<Window x:Class="GeometryHelper.Dxf.Viewer.Wpf.CadQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf"
        Title="Question" Width="460" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource GhPanel}" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="6"
            TextElement.FontFamily="{StaticResource GhFont}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource GhText}"
            UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
        <StackPanel>
            <DockPanel Margin="16">
                <!-- A warning, as the Messages board draws one: an amber triangle. -->
                <Path x:Name="Glyph" DockPanel.Dock="Left" Data="M12 3 2 20h20zM12 10v5M12 17.5h.01" Stroke="{StaticResource GhWarn}" StrokeThickness="2" Width="22" Height="22"
                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,12,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock x:Name="HeadingText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="BodyText" Foreground="{StaticResource GhIcon}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource GhTextMuted}" FontFamily="{StaticResource GhMonoFont}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Background="{StaticResource GhHeader}" Padding="16,10" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" Style="{StaticResource GhDialogButton}" Margin="0,0,8,0" Click="OnNo" IsCancel="True" />
                    <Button x:Name="ThirdButton" Style="{StaticResource GhDialogButton}" Margin="0,0,8,0" Click="OnThird" Visibility="Collapsed" />
                    <Button x:Name="YesButton" Style="{StaticResource GhDialogButton}" Background="{StaticResource GhAccent}" Foreground="{StaticResource GhAccentInk}"
                            FontWeight="SemiBold" BorderThickness="0" Click="OnYes" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
