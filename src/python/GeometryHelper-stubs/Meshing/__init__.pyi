    def ToMesh(loop: GeoPolygonArc3, options: MeshOptions, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a loop with arcs into faces as the options say, its grid level, within a tolerance."""
    @overload
    @staticmethod
    def ToMesh(triangle: GeoTriangle3, options: MeshOptions, placement: MeshPlacement3) -> GeoMesh3:
        """Breaks a triangle into faces as the options say, its grid standing as the placement says, using the
        default tolerance."""
    @overload
    @staticmethod
    def ToMesh(triangle: GeoTriangle3, options: MeshOptions, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a triangle into faces as the options say, its grid level, within a tolerance."""
    @overload
    @staticmethod
    def ToMesh(circle: GeoCircle3, options: MeshOptions, placement: MeshPlacement3, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a disc into faces as the options say, its grid standing as the placement says, within a tolerance,
        its rim flattened by the options' chord tolerance first."""
    @overload
    @staticmethod
    def ToMesh(ellipse: GeoEllipse3, options: MeshOptions, placement: MeshPlacement3, tolerance: Tolerance) -> GeoMesh3:
        """Breaks an elliptical disc into faces as the options say, its grid standing as the placement says, within
        a tolerance, its rim flattened by the options' chord tolerance first."""
    @overload
    @staticmethod
    def ToMesh(face: GeoFace3, options: MeshOptions, placement: MeshPlacement3, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a face into faces with no hole as the options say, its grid standing as the placement says, within
        a tolerance."""
    @overload
    @staticmethod
    def ToMesh(polygon: GeoPolygon3, options: MeshOptions, placement: MeshPlacement3, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a polygon into faces as the options say, its grid standing as the placement says, within a
        tolerance."""
    @overload
    @staticmethod
    def ToMesh(loop: GeoPolygonArc3, options: MeshOptions, placement: MeshPlacement3, tolerance: Tolerance) -> GeoMesh3:
        """Breaks a loop with arcs into faces as the options say, its grid standing as the placement says, within a
        tolerance, each arc flattened by the options' chord tolerance first."""
    @overload
    @staticmethod
    def ToMesh(
        triangle: GeoTriangle3,
        options: MeshOptions,
        placement: MeshPlacement3,
        tolerance: Tolerance,
    ) -> GeoMesh3:
        """Breaks a triangle into faces as the options say, its grid standing as the placement says, within a
        tolerance."""

class MeshAxes(System.Enum):
    """Which way the axes of a grid, or of strips, run in space: over a flat shape, its first axis within the
    shape's plane; through a body, all three."""
    Along: ClassVar[MeshAxes]
    """The first axis along a direction. Over a flat shape the direction is laid onto the shape's plane; through a
    body X runs along it, Y level across it, and Z as near up as is square to both."""
    Frame: ClassVar[MeshAxes]
    """Along the axes of a coordinate system. Over a flat shape its X axis is laid onto the shape's plane, or its Y
    axis where X stands square to the plane; through a body its three axes are the grid's."""
    Own: ClassVar[MeshAxes]
    """Along the shape's own sides. Over a flat shape the first axis runs along the long side of the smallest
    rectangle round it, so a rectangle's grid runs along its sides. Through a box, along its own axes; through a
    body, along the smallest box round it, the axis nearest upright as Z and the longer of the other two as X."""
    Upright: ClassVar[MeshAxes]
    """Standing up. Through a body, Z runs up the world's Z axis and X along the long side of the smallest rectangle
    round the body's plan, so a wall's cells run along it and a column's stand on its section. Over a flat shape
    the same as MeshAxes.World."""
    World: ClassVar[MeshAxes]
    """Along the world's axes. Over a flat shape the first axis runs level and the second up the slope, as an
    elevation is drawn: along X and Y on a level shape, along the wall and up it on an upright one. Through a
    body, along X, Y and Z."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class MeshKind(System.Enum):
    """How a closed shape of the plane is broken into the faces of a GeoMesh2."""
    Convex: ClassVar[MeshKind]
    """Convex pieces, few of them: the triangles merged across every edge whose two sides stay convex together,
    which leaves no more than four times as many pieces as the fewest there could be."""
    Grid: ClassVar[MeshKind]
    """The cells of a regular grid, as panels of formwork or tiles are laid: whole where the material holds them,
    cut to the boundary and the holes where those cross them, and split through a hole one holds whole."""
    Strips: ClassVar[MeshKind]
    """Strips along one direction, cut at every corner: trapezoids whose parallel sides run that way, or triangles
    where a strip comes to a point."""
    Triangles: ClassVar[MeshKind]
    """Triangles on the shape's own corners, as TriangulateSurface gives them: as few as cover it, and no point
    added unless the shape's rings touch each other."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class MeshOptions(System.Object):
    """How a closed shape of the plane is meshed: the kind of faces, and for a grid the size of its cells, the
    joints between them and where the grid stands.

    The options are immutable, so one instance can be shared between threads and kept as a setting. The factories
    give the usual ones: MeshOptions.Triangles, MeshOptions.Grid, MeshOptions.Strips and MeshOptions.Convex; the
    constructor gives the rest, a turned grid among them."""
    def __init__(
        self,
        kind: MeshKind,
        cellWidth: float = ...,
        cellHeight: float = ...,
        joint: float = ...,
        angleRad: float | None = ...,
        alignU: GridAlignment = ...,
        alignV: GridAlignment = ...,
        origin: GeoPoint2 | None = ...,
        chordTolerance: float = ...,
    ) -> None:
        """Initializes mesh options."""
    @property
    def AlignU(self) -> GridAlignment:
        """Gets where a grid stands along its first axis, when no MeshOptions.Origin is given."""
    @property
    def AlignV(self) -> GridAlignment:
        """Gets where a grid stands along its second axis, when no MeshOptions.Origin is given."""
    @property
    def AngleRad(self) -> float | None:
        """Gets the direction of a grid's first axis, or that strips run along, counter-clockwise from the X axis;
        null when it runs along the X axis, and along a rectangle's own width."""
    @property
    def CellHeight(self) -> float:
        """Gets the size of a grid cell along the grid's second axis; nought for a kind that is not a grid."""
    @property
    def CellWidth(self) -> float:
        """Gets the size of a grid cell along the grid's first axis; nought for a kind that is not a grid."""
    @property
    def ChordTolerance(self) -> float:
        """Gets the largest gap allowed between a chord and the arc it stands for; nought for the automatic share of
        each radius. A tolerance that would cut one curve into more than 1 048 576 pieces is refused by the
        meshing with an ArgumentOutOfRangeException."""
    Convex: ClassVar[MeshOptions]
    """Convex pieces, few of them."""
    @property
    def Joint(self) -> float:
        """Gets the gap between two neighbouring cells of a grid, along both axes; nought for none."""
    @property
    def Kind(self) -> MeshKind:
        """Gets the kind of faces."""
    @property
    def Origin(self) -> GeoPoint2 | None:
        """Gets where a cell of a grid has its first corner, which takes the place of the alignments; null when the
        alignments place the grid."""
    Triangles: ClassVar[MeshOptions]
    """Triangles on the shape's own corners."""
    @overload
    def Equals(self, other: MeshOptions) -> bool:
        """Determines whether another set of options gives the same mesh."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Determines whether the specified object is an equal set of options."""
    def GetHashCode(self) -> int:
        """Returns the hash code for these options."""
    @overload
    @staticmethod
    def Grid(cellWidth: float, cellHeight: float, origin: GeoPoint2, joint: float = ...) -> MeshOptions:
        """A grid of cells along the X and Y axes, or along a rectangle's own sides, with a cell starting at a
        point."""
    @overload
    @staticmethod
    def Grid(
        cellWidth: float,
        cellHeight: float,
        joint: float = ...,
        alignU: GridAlignment = ...,
        alignV: GridAlignment = ...,
    ) -> MeshOptions:
        """A grid of cells along the X and Y axes, or along a rectangle's own sides, standing against the shape as
        the alignments say."""
    @staticmethod
    def Strips(angleRad: float) -> MeshOptions:
        """Strips along a direction."""
    def ToString(self) -> str:
        """Describes the options."""

class MeshPlacement3(System.Object):
    """Where a grid, or strips, stand in space: which way the axes run, as MeshAxes says, and, when given, the point
    a cell starts at.

    The same placement serves a flat shape, meshed into a GeoMesh3, and a body, cut into a GeoCellGrid3: over a
    flat shape the axes give the direction of the grid's first axis in the shape's plane, and through a body all
    three axes of the grid. The placement is immutable, so one instance can be shared between threads and kept as
    a setting."""
    @property
    def Axes(self) -> MeshAxes:
        """Gets which way the axes run."""
    @property
    def CoordinateSystem(self) -> GeoCoordinateSystem3 | None:
        """Gets the coordinate system whose axes the grid takes, for MeshAxes.Frame; null for the others."""
    @property
    def Direction(self) -> GeoVector3 | None:
        """Gets the direction of the first axis, of unit length, for MeshAxes.Along; null for the others."""
    @property
    def Origin(self) -> GeoPoint3 | None:
        """Gets where a cell has its first corner, which takes the place of the alignments; null when the alignments
        place the grid."""
    Own: ClassVar[MeshPlacement3]
    """Along the shape's own sides: the smallest rectangle round a flat shape, a box's own axes, the smallest box
    round a body."""
    Upright: ClassVar[MeshPlacement3]
    """Standing up: through a body, Z up and X along the long side of its plan; over a flat shape as
    MeshPlacement3.World."""
    World: ClassVar[MeshPlacement3]
    """Along the world's axes: over a flat shape the first axis level and the second up the slope, through a body X,
    Y and Z."""
    @staticmethod
    def Along(direction: GeoVector3) -> MeshPlacement3:
        """The first axis along a direction: laid onto the plane of a flat shape, the X axis of a body's grid."""
    def At(self, origin: GeoPoint3) -> MeshPlacement3:
        """Gets these axes with a cell starting at a point, which takes the place of the alignments."""
    @overload
    def Equals(self, other: MeshPlacement3) -> bool:
        """Determines whether another placement stands a grid the same way."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Determines whether the specified object is an equal placement."""
    @staticmethod
    def Frame(frame: GeoCoordinateSystem3) -> MeshPlacement3:
        """Along the axes of a coordinate system: its X axis laid onto the plane of a flat shape, its three axes a
        body's."""
    def GetHashCode(self) -> int:
        """Returns the hash code for this placement."""
    def ToString(self) -> str:
        """Describes the placement."""
