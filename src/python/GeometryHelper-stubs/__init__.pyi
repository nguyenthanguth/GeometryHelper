        follows equalPoint, since coplanarity is measured as a distance."""
    @overload
    def __init__(self, equalPoint: float, equalVector: float, equalAngleRad: float, equalPlanar: float) -> None:
        """Initializes a tolerance instance with thresholds for points, vectors, angles and coplanarity."""
    Default: ClassVar[Tolerance]
    """Gets the default tolerance: Tolerance.DefaultEqualPoint, Tolerance.DefaultEqualVector,
    Tolerance.DefaultEqualAngleRad and Tolerance.DefaultEqualPlanar together."""
    @property
    def EqualAngleRad(self) -> float:
        """Angular threshold to consider two directions / lines as parallel or perpendicular, in radians."""
    @property
    def EqualPlanar(self) -> float:
        """Distance threshold to consider a point as lying on a plane, in drawing units.

        This is separate from Tolerance.EqualPoint because coplanarity is checked far from the reference point: a
        polygon several metres across turns a hundredth of a degree of tilt into a deviation of nearly a
        millimetre, so the threshold that decides whether two points coincide is the wrong one to decide whether
        a face is flat."""
    @property
    def EqualPoint(self) -> float:
        """Distance threshold to consider two points as coincident, in drawing units."""
    @property
    def EqualVector(self) -> float:
        """Threshold to consider two vectors as equal."""
    Global: ClassVar[Tolerance]
    """Tolerance applied for overloads without explicit tolerance. It starts as Tolerance.Default."""
    @overload
    def Equals(self, other: Tolerance) -> bool:
        """Compares two tolerance instances exactly."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Compares with an arbitrary object."""
    def GetHashCode(self) -> int:
        """Hash code built from thresholds."""
    def ToString(self) -> str:
        """Represents the thresholds as a string."""
    @staticmethod
    def Use(tolerance: Tolerance) -> System.IDisposable:
        """Makes a tolerance the one every overload without a tolerance uses on this thread, until the returned
        scope is disposed."""
    def __eq__(self, other: object) -> bool:
        """Compares two Tolerance instances for equality."""
    def __hash__(self) -> int: ...
    def __ne__(self, other: object) -> bool:
        """Compares two Tolerance instances for inequality."""
