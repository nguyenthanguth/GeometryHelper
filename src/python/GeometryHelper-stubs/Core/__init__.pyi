    @overload
    @staticmethod
    def GetShortestLineTo(c1: GeoCircle2, c2: GeoCircle2) -> GeoLine2:
        """Finds the shortest line segment connecting a point on the circumference of c1 to a point on the
        circumference of c2 using default tolerance."""
