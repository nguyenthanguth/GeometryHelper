class PlanarMap(System.Object):
    """Carries geometry that curves between the plane and space.

    Carries flat geometry between the plane and space: a shape lying in a plane in space is laid out in two
    dimensions, worked on there, and put back.

    Everything goes through a GeoCoordinateSystem3, the frame the flattening is measured in. Hold on to it: the
    same frame has to be used to put the answer back, or it lands somewhere else. A frame built from a shape by
    PlanarMap.FrameOf turns with the shape, so the local coordinates of a plate are the same whichever way the
    plate is oriented in the model.

    Flattening drops the local Z, so a point off the plane is a question rather than an answer. The Try forms
    refuse one farther from the plane than Tolerance.EqualPlanar; the plain forms project it onto the plane and
    say so in their name.

    Carries splines between the plane and space."""
    @overload
    @staticmethod
    def FrameOf(face: GeoFace3) -> GeoCoordinateSystem3:
        """Gets the frame of a face: the frame of its boundary, so its holes are laid out with it."""
    @overload
    @staticmethod
    def FrameOf(plane: GeoPlane3) -> GeoCoordinateSystem3:
        """Gets a frame of a plane, with the origin at the plane origin and the axes the plane itself fixes."""
    @overload
    @staticmethod
    def FrameOf(polygon: GeoPolygon3) -> GeoCoordinateSystem3:
        """Gets the frame of a polygon: its plane, with the origin at the first vertex and the first axis along the
        first edge that has a direction, so the frame turns with the polygon."""
    @staticmethod
    def ProjectToArc2(frame: GeoCoordinateSystem3, arc: GeoArc3) -> GeoArc2:
        """Lays an arc out in a frame, by projecting it onto the plane of that frame."""
    @overload
    @staticmethod
    def ProjectToEllipse2(frame: GeoCoordinateSystem3, circle: GeoCircle3) -> GeoEllipse2:
        """Lays a circle in space out in a frame, projecting it square onto the plane of that frame: an ellipse, or
        a circle where it lies parallel to the plane."""
    @overload
    @staticmethod
    def ProjectToEllipse2(frame: GeoCoordinateSystem3, ellipse: GeoEllipse3) -> GeoEllipse2:
        """Lays an ellipse in space out in a frame, projecting it square onto the plane of that frame."""
    @staticmethod
    def ProjectToFace2(frame: GeoCoordinateSystem3, face: GeoFace3) -> GeoFace2:
        """Lays a face and its holes out in a frame, dropping each vertex's distance from the plane."""
    @staticmethod
    def ProjectToLine2(frame: GeoCoordinateSystem3, line: GeoLine3) -> GeoLine2:
        """Lays a segment out in a frame, dropping each end's distance from the plane."""
    @staticmethod
    def ProjectToPoint2(frame: GeoCoordinateSystem3, point: GeoPoint3) -> GeoPoint2:
        """Lays a point out in a frame, dropping its distance from the plane."""
    @staticmethod
    def ProjectToPolygon2(frame: GeoCoordinateSystem3, polygon: GeoPolygon3) -> GeoPolygon2:
        """Lays a polygon out in a frame, dropping each vertex's distance from the plane."""
    @staticmethod
    def ProjectToPolyline2(frame: GeoCoordinateSystem3, polyline: GeoPolyline3) -> GeoPolyline2:
        """Lays a chain out in a frame, dropping each vertex's distance from the plane."""
    @staticmethod
    def ProjectToRay2(frame: GeoCoordinateSystem3, ray: GeoRay3) -> GeoRay2:
        """Lays a ray out in a frame: its origin as a point, dropping its distance from the plane, and its direction
        as a vector, dropping the part square to the plane and normalized again."""
    @staticmethod
    def ProjectToSpline2(frame: GeoCoordinateSystem3, spline: GeoSpline3) -> GeoSpline2:
        """Lays a spline in space out in a frame, projecting it square onto the plane of that frame."""
    @staticmethod
    def ProjectToTriangle2(frame: GeoCoordinateSystem3, triangle: GeoTriangle3) -> GeoTriangle2:
        """Lays a triangle out in a frame, dropping each vertex's distance from the plane of that frame."""
    @staticmethod
    def ProjectToVector2(frame: GeoCoordinateSystem3, vector: GeoVector3) -> GeoVector2:
        """Lays a vector out in a frame, dropping the part square to the plane."""
    @staticmethod
    def ProjectToXLine2(frame: GeoCoordinateSystem3, xline: GeoXLine3) -> GeoXLine2:
        """Lays an infinite line out in a frame: its origin as a point, dropping its distance from the plane, and
        its direction as a vector, dropping the part square to the plane and normalized again."""
    @staticmethod
    def ToArc3(frame: GeoCoordinateSystem3, arc: GeoArc2) -> GeoArc3:
        """Lifts an arc out of a frame into the plane of that frame in space."""
    @staticmethod
    def ToEdge3(frame: GeoCoordinateSystem3, edge: GeoEdge2) -> GeoEdge3:
        """Lifts an edge out of a frame into the plane of that frame in space."""
    @staticmethod
    def ToEllipse3(frame: GeoCoordinateSystem3, ellipse: GeoEllipse2) -> GeoEllipse3:
        """Puts an ellipse of the plane back into space, exactly: its centre and its axis carried by the frame, its
        normal the frame's Z axis, its radii as they are."""
    @staticmethod
    def ToFace3(frame: GeoCoordinateSystem3, face: GeoFace2) -> GeoFace3:
        """Puts a face of the plane back into space, holes and all."""
    @staticmethod
    def ToLine3(frame: GeoCoordinateSystem3, line: GeoLine2) -> GeoLine3:
        """Puts a segment of the plane back into space."""
    @staticmethod
    def ToPoint3(frame: GeoCoordinateSystem3, point: GeoPoint2) -> GeoPoint3:
        """Puts a point of the plane back into space."""
    @staticmethod
    def ToPolygon3(frame: GeoCoordinateSystem3, polygon: GeoPolygon2) -> GeoPolygon3:
        """Puts a polygon of the plane back into space."""
    @staticmethod
