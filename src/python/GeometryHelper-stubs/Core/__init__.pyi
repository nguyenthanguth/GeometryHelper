class Parametrization2(System.Object):
    """Provides static methods for locating positions along a curve, either by a normalized parameter or by an arc
    length measured from the start of the curve.

    The parameter is normalized: 0 is the start of the curve and 1 is its end, whatever the curve actually
    measures. The distance is a true arc length from the start, running from 0 to the total length. The two are
    proportional, so distance = parameter * length.

    Each curve starts where its own geometry says it does: a line at its StartPoint, a polyline or polygon at its
    first vertex, a rectangle at its LowerLeft corner, and a circle at angle zero, that is the point directly
    right of its centre. All of them run in the direction their vertices are ordered, and a circle runs
    counter-clockwise.

    Values outside the natural range follow the shape of the curve. A closed curve — a polygon, a rectangle, a
    circle — wraps around, so a parameter of 1.25 is the same position as 0.25. A polyline clamps, because it is
    an open chain with no natural extension. A line segment extrapolates along the infinite line that carries it,
    which is the behaviour GeoLine2.GetPointAtParameter has always had."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(circle: GeoCircle2, parameter: float) -> float:
        """Gets the arc length from angle zero to a normalized parameter along a circle."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(line: GeoLine2, parameter: float) -> float:
        """Gets the arc length from the start of a line segment to a normalized parameter."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(poly: GeoPolygon2, parameter: float) -> float:
        """Gets the arc length from the first vertex to a normalized parameter along a polygon."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(loop: GeoPolygonArc2, parameter: float) -> float:
        """Gets the distance round a loop that may curve at a normalized parameter."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(polyline: GeoPolyline2, parameter: float) -> float:
        """Gets the arc length from the first vertex to a normalized parameter along a polyline."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(chain: GeoPolylineArc2, parameter: float) -> float:
        """Gets the distance along a chain that may curve at a normalized parameter."""
    @overload
    @staticmethod
    def GetDistanceAtParameter(rect: GeoRectangle2, parameter: float) -> float:
        """Gets the arc length from the LowerLeft corner to a normalized parameter along a rectangle."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(circle: GeoCircle2, point: GeoPoint2) -> float:
        """Gets the arc length from angle zero to the point on a circle closest to the supplied point."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(line: GeoLine2, point: GeoPoint2) -> float:
        """Gets the arc length from the start of a line segment to the point on it closest to the supplied point."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(poly: GeoPolygon2, point: GeoPoint2) -> float:
        """Gets the arc length from the first vertex to the point on the boundary of a polygon closest to the
        supplied point."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(loop: GeoPolygonArc2, point: GeoPoint2) -> float:
        """Gets how far round a loop that may curve the point nearest a point lies."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(polyline: GeoPolyline2, point: GeoPoint2) -> float:
        """Gets the arc length from the first vertex to the point on a polyline closest to the supplied point."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(chain: GeoPolylineArc2, point: GeoPoint2) -> float:
        """Gets how far along a chain that may curve the point nearest a point lies."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(rect: GeoRectangle2, point: GeoPoint2) -> float:
        """Gets the arc length from the LowerLeft corner to the point on the boundary of a rectangle closest to the
        supplied point."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(loop: GeoPolygonArc2, point: GeoPoint2, tolerance: Tolerance) -> float:
        """Gets how far round a loop that may curve the point nearest a point lies, within a tolerance."""
    @overload
    @staticmethod
    def GetDistanceAtPoint(chain: GeoPolylineArc2, point: GeoPoint2, tolerance: Tolerance) -> float:
        """Gets how far along a chain that may curve the point nearest a point lies, within a tolerance."""
    @overload
    @staticmethod
    def GetParameterAtDistance(circle: GeoCircle2, distance: float) -> float:
        """Gets the normalized parameter at an arc length measured along a circle. A circle of zero radius has no
        circumference to measure along, so the result is 0."""
    @overload
    @staticmethod
    def GetParameterAtDistance(line: GeoLine2, distance: float) -> float:
        """Gets the normalized parameter at an arc length measured from the start of a line segment. A degenerate
        segment has no direction to measure along, so the result is 0."""
    @overload
    @staticmethod
    def GetParameterAtDistance(poly: GeoPolygon2, distance: float) -> float:
        """Gets the normalized parameter at an arc length measured along the perimeter of a polygon."""
    @overload
    @staticmethod
    def GetParameterAtDistance(loop: GeoPolygonArc2, distance: float) -> float:
        """Gets the normalized parameter at a distance round a loop that may curve."""
    @overload
    @staticmethod
    def GetParameterAtDistance(polyline: GeoPolyline2, distance: float) -> float:
        """Gets the normalized parameter at an arc length measured along a polyline."""
    @overload
    @staticmethod
    def GetParameterAtDistance(chain: GeoPolylineArc2, distance: float) -> float:
        """Gets the normalized parameter at a distance along a chain that may curve."""
    @overload
    @staticmethod
    def GetParameterAtDistance(rect: GeoRectangle2, distance: float) -> float:
        """Gets the normalized parameter at an arc length measured along the perimeter of a rectangle. A rectangle
        with no perimeter gives 0."""
    @overload
    @staticmethod
    def GetParameterAtPoint(circle: GeoCircle2, point: GeoPoint2) -> float:
