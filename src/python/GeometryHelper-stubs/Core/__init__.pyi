        """Puts a ray of the plane back into space."""
    @staticmethod
    def ToSpline3(frame: GeoCoordinateSystem3, spline: GeoSpline2) -> GeoSpline3:
        """Puts a spline of the plane back into space, exactly: each control point carried by the frame, the degree,
        weights and knots as they were."""
    @staticmethod
    def ToTriangle3(frame: GeoCoordinateSystem3, triangle: GeoTriangle2) -> GeoTriangle3:
        """Puts a triangle of the plane back into space."""
    @staticmethod
    def ToVector3(frame: GeoCoordinateSystem3, vector: GeoVector2) -> GeoVector3:
        """Puts a vector of the plane back into space."""
    @staticmethod
    def ToXLine3(frame: GeoCoordinateSystem3, xline: GeoXLine2) -> GeoXLine3:
        """Puts an infinite line of the plane back into space."""
    @overload
    @staticmethod
    def TryToArc2(frame: GeoCoordinateSystem3, arc: GeoArc3) -> tuple[bool, GeoArc2]:
        """Lays an arc out in a frame when it lies in the plane of that frame."""
    @overload
    @staticmethod
    def TryToArc2(frame: GeoCoordinateSystem3, arc: GeoArc3, *, tolerance: Tolerance) -> tuple[bool, GeoArc2]:
        """Lays an arc out in a frame when it lies in the plane of that frame, within a tolerance."""
    @overload
    @staticmethod
    def TryToEdge2(frame: GeoCoordinateSystem3, edge: GeoEdge3) -> tuple[bool, GeoEdge2]:
        """Lays an edge out in a frame when it lies in the plane of that frame."""
    @overload
    @staticmethod
    def TryToEdge2(frame: GeoCoordinateSystem3, edge: GeoEdge3, *, tolerance: Tolerance) -> tuple[bool, GeoEdge2]:
        """Lays an edge out in a frame when it lies in the plane of that frame, within a tolerance."""
    @overload
    @staticmethod
    def TryToPoint2(frame: GeoCoordinateSystem3, point: GeoPoint3) -> tuple[bool, GeoPoint2]:
