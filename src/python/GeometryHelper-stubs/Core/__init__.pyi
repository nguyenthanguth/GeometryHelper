    @overload
    @staticmethod
    def GetParameterAtPoint(rect: GeoRectangle2, point: GeoPoint2) -> float:
        """Gets the normalized parameter of the point on the boundary of a rectangle closest to the supplied
        point."""
    @overload
    @staticmethod
    def GetParameterAtPoint(line: GeoLine2, point: GeoPoint2, tolerance: Tolerance) -> float:
        """Projects a point onto the infinite line containing the segment and gets the parameter value t within
        tolerance. t=0 corresponds to StartPoint, t=1 corresponds to EndPoint."""
    @overload
    @staticmethod
    def GetParameterAtPoint(loop: GeoPolygonArc2, point: GeoPoint2, tolerance: Tolerance) -> float:
        """Gets the normalized parameter of the point of a loop that may curve nearest a point, within a
        tolerance."""
    @overload
    @staticmethod
    def GetParameterAtPoint(chain: GeoPolylineArc2, point: GeoPoint2, tolerance: Tolerance) -> float:
        """Gets the normalized parameter of the point of a chain that may curve nearest a point, within a
        tolerance."""
    @overload
    @staticmethod
    def GetPointAtDistance(circle: GeoCircle2, distance: float) -> GeoPoint2:
