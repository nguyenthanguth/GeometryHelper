class DxfPdfDefinition(DxfDBObject):
    """A PDFDEFINITION of a DXF file, as AutoCAD's PdfDefinition: the page of a PDF file the PDFUNDERLAYs of a
    drawing show, under its name in the dictionary of PDF underlays (DxfPdfDefinition.GetPdfDictionary,
    ACAD_PDFUNDERLAYS)."""
    def __init__(self, sourceFileName: str, itemName: str) -> None:
        """Initializes a definition made in code of a page of a PDF file, as AutoCAD's new PdfDefinition() given its
