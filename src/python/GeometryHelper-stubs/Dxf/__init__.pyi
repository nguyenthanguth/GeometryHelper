    UnderlineOff: ClassVar[str]
    """Gets the code that ends a line under the letters, as AutoCAD's UnderlineOff: \\l."""
    UnderlineOn: ClassVar[str]
    """Gets the code that begins a line under the letters, as AutoCAD's UnderlineOn: \\L."""
    @property
    def UseBackgroundColor(self) -> bool:
        """Gets or sets whether the background takes the colour of the drawing's background (flag 2 of group 90), as
