class DxfSun(DxfDBObject):
    """A SUN of a DXF file, as AutoCAD's Sun: the light of the sun a viewport is lit by, owned by the viewport,
    which names it (group 361 of the VIEWPORT); whether it is on, its colour and intensity, the day and time it
    shines at and the shadows it casts, read and set as the groups of AcDbSun of the DXF reference."""
    def __init__(self) -> None:
        """Initializes a sun made in code, as AutoCAD's Sun(), with ezdxf's defaults (AutoCAD's own not confirmed):
        on, white, of intensity 1, casting shadows traced along the rays, on 21 September 2014 at noon; given to
        a viewport by DxfViewport.SetSun."""
    @property
    def DateTime(self) -> System.DateTime:
        """Gets or sets the day and the time of day the sun shines at (groups 91 and 92), as AutoCAD's DateTime: the
        Julian day and the seconds past midnight, the time at the drawing's place; 21 September 2014 at noon
        where the record gives neither."""
    @DateTime.setter
    def DateTime(self, value: System.DateTime) -> None: ...
    @property
    def Intensity(self) -> float:
        """Gets or sets how bright the sun is (group 40), as AutoCAD's Intensity: 1 for AutoCAD's sun, 0 for none at
        all; 1 where the record gives none."""
    @Intensity.setter
    def Intensity(self, value: float) -> None: ...
    @property
    def IsDaylightSavingsOn(self) -> bool:
        """Gets or sets whether the time is that of daylight saving (group 292), as AutoCAD's IsDaylightSavingsOn;
        false where the record gives none."""
    @IsDaylightSavingsOn.setter
    def IsDaylightSavingsOn(self, value: bool) -> None: ...
    @property
    def IsOn(self) -> bool:
        """Gets or sets whether the sun is on (group 290), as AutoCAD's IsOn; on where the record gives none."""
    @IsOn.setter
    def IsOn(self, value: bool) -> None: ...
    @property
    def ShadowMapSize(self) -> int:
        """Gets or sets the size of a map of shadows (group 71), as AutoCAD's ShadowMapSize of its shadow
        parameters: 64 to 4 096, a power of two; 256 where the record gives none."""
