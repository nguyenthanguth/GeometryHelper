    @property
    def LinetypeName(self) -> str:
        """Gets or sets the name of the layer's linetype (group 6), as the file spells it; Continuous where the
        record gives none."""
    @LinetypeName.setter
    def LinetypeName(self, value: str) -> None: ...
    @property
    def PlotStyleName(self) -> str:
        """Gets or sets the name of the plot style of the layer, as AutoCAD's PlotStyleName: the entry of the
