    DxfTable.SetTextString, and the header cell (1, 0) of flags 49 has
    DxfCell.AlignmentDxfCellAlignment.MiddleCenter and DxfCell.TextHeight 3.5."""
    @property
    def Alignment(self) -> DxfCellAlignment | None:
        """Gets or sets where the cell's content stands, as AutoCAD's Alignment: the cell's own, null where it has
        none; set, DxfTable.SetAlignment, or null to take it away."""
    @Alignment.setter
    def Alignment(self, value: DxfCellAlignment | None) -> None: ...
    @property
    def AttachmentPoint(self) -> GeoPoint3:
        """Gets the point the cell's content is placed at, as AutoCAD's AttachmentPoint:
        DxfTable.AttachmentPoint."""
    @property
    def BackgroundColor(self) -> DxfColor:
        """Gets or sets the colour of the cell's background, as AutoCAD's BackgroundColor: the cell's own, null
        where it has none; set, DxfTable.SetBackgroundColor, or null to take its background away, its colour and
        whether it is filled."""
    @BackgroundColor.setter
    def BackgroundColor(self, value: DxfColor | None) -> None: ...
    @property
    def CellType(self) -> DxfTableCellType:
        """Gets what the cell holds, as AutoCAD's CellType: DxfTable.CellType."""
    @property
    def Column(self) -> int:
        """Gets the column of the cell, from nought, as AutoCAD's Column."""
    @property
    def ContentColor(self) -> DxfColor:
        """Gets or sets the colour of the cell's content, as AutoCAD's ContentColor: the cell's own, null where it
        has none; set, DxfTable.SetContentColor, or null to take it away."""
    @ContentColor.setter
    def ContentColor(self, value: DxfColor | None) -> None: ...
    @property
    def DataFormat(self) -> str:
        """Gets or sets the format of the cell's value, as AutoCAD's DataFormat: DxfTable.Format and
        DxfTable.SetFormat."""
    @DataFormat.setter
    def DataFormat(self, value: str) -> None: ...
    @property
    def DataType(self) -> DxfDataTypeParameter:
        """Gets or sets the kind of the cell's value with what its number measures, as AutoCAD's DataType:
        DxfTable.GetDataType and DxfTable.SetDataType."""
    @DataType.setter
    def DataType(self, value: DxfDataTypeParameter) -> None: ...
    @property
    def IsBackgroundColorNone(self) -> bool | None:
        """Gets or sets whether the cell's background is left unfilled, as AutoCAD's IsBackgroundColorNone: the
        cell's own, null where it has none; set, DxfTable.SetBackgroundColorNone, or null to take its background
        away, its colour and whether it is filled."""
    @IsBackgroundColorNone.setter
    def IsBackgroundColorNone(self, value: bool | None) -> None: ...
    @property
    def Row(self) -> int:
        """Gets the row of the cell, from nought, as AutoCAD's Row."""
    @property
    def TextHeight(self) -> float | None:
        """Gets or sets the height of the cell's text, as AutoCAD's TextHeight: the cell's own, null where it has
        none; set, DxfTable.SetTextHeight, or null to take it away."""
    @TextHeight.setter
    def TextHeight(self, value: float | None) -> None: ...
    @property
    def TextString(self) -> str:
        """Gets or sets the text of the cell, as AutoCAD's TextString: DxfTable.TextString and
        DxfTable.SetTextString."""
    @TextString.setter
    def TextString(self, value: str) -> None: ...
    @property
    def TextStyle(self) -> DxfTextStyleTableRecord:
        """Gets or sets the text style of the cell's text, as AutoCAD's TextStyleId gives its id: the cell's own,
        null where it has none; set, DxfTable.SetTextStyle, or null to take it away."""
    @TextStyle.setter
    def TextStyle(self, value: DxfTextStyleTableRecord | None) -> None: ...
    @property
    def Value(self) -> Any:
        """Gets or sets the value of the cell, as AutoCAD's Value: DxfTable.Value and DxfTable.SetValue."""
    @Value.setter
    def Value(self, value: object) -> None: ...
    @overload
