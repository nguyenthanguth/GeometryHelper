        """Gets how many entries the dictionary has, as AutoCAD's Count; nought for one made in code."""
    @property
    def TreatElementsAsHard(self) -> bool:
        """Gets or sets whether the dictionary owns its entries hard (group 280 of 1), as AutoCAD's
        TreatElementsAsHard: an extension dictionary does; a hard owner names its entries by groups 360, a soft
        one by 350. False where the record gives none."""
    @TreatElementsAsHard.setter
    def TreatElementsAsHard(self, value: bool) -> None: ...
    def __getitem__(self, key: str) -> DxfDBObject:
        """Gets or sets the object of an entry, as AutoCAD's indexer: DxfDBDictionary.GetAt and
        DxfDBDictionary.SetAt."""
    def __setitem__(self, key: str, value: DxfDBObject) -> None:
        """Gets or sets the object of an entry, as AutoCAD's indexer: DxfDBDictionary.GetAt and
        DxfDBDictionary.SetAt."""
    @overload
    def Contains(self, value: DxfDBObject) -> bool:
        """Gets whether an entry of the dictionary names an object, as AutoCAD's Contains of an id: by its
        handle."""
    @overload
    def Contains(self, entryName: str) -> bool:
        """Gets whether the dictionary has an entry of a name, as AutoCAD's Contains, letters of either case the
        same."""
    def CopyTo(self, array: Sequence[DxfDBDictionaryEntry] | System.Array[DxfDBDictionaryEntry], index: int) -> None:
        """Copies the entries into an array from an index on, as AutoCAD's CopyTo, in the order of the record."""
    def GetAt(self, entryName: str) -> DxfDBObject:
        """Gets the object an entry names, as AutoCAD's GetAt gives its id."""
    def GetEnumerator(self) -> System.Collections.Generic.IEnumerator[DxfDBDictionaryEntry]:
        """Gets an enumerator over the entries, in the order of the record."""
    def NameAt(self, value: DxfDBObject) -> str:
        """Gets the name of the entry that names an object, as AutoCAD's NameAt."""
    @overload
    def Remove(self, value: DxfDBObject) -> None:
        """Takes out the entry that names an object, as AutoCAD's Remove of an id, and erases the object."""
    @overload
    def Remove(self, key: str) -> DxfDBObject:
        """Takes out the entry of a name, as AutoCAD's Remove, and erases the object it names with what that owns,
        as an object of a DXF file is owned by something."""
    def SetAt(self, searchKey: str, newValue: DxfDBObject) -> None:
        """Adds an object under a name, as AutoCAD's SetAt: an object made in code written into the file as the
        dictionary's own, last among its entries, as AutoCAD writes it; where the name has an entry already, the
        object it named is erased, with what it owns, and the entry names the new one, as AutoCAD replaces it."""
    def SetName(self, oldName: str, newName: str) -> None:
        """Renames an entry, as AutoCAD's SetName; nothing where the name is the one it has. An anonymous group
        given a name that does not begin with * is anonymous no longer (group 70 of 0), as DxfGroup.Name makes
        it."""
    def ToString(self) -> str:
        """Gives the dictionary as a line for debugging: its type, its handle and how many entries it has."""
    def __iter__(self) -> Iterator[DxfDBDictionaryEntry]: ...

class DxfDBDictionaryEntry(System.ValueType):
    """An entry of a DxfDBDictionary, as AutoCAD's DBDictionaryEntry: its name and the object it names."""
