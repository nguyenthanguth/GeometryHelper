        writing of the polyline, every handle kept."""
    @overload
    def Extend(self, extendStart: bool, toPoint: GeoPoint3) -> None:
        """Moves an end of the polyline to a point on its end segment run on, as AutoCAD's Extend, as a DxfPolyline
        moves its own: on the line through a line segment or the circle of an arc, in its plane, past the end it
        moves."""
    def GetClosestPointTo(self, givenPoint: GeoPoint3, extend: bool) -> GeoPoint3:
        """Gets the point of the polyline nearest a point, as AutoCAD's GetClosestPointTo: the first segment's where
        two are as near."""
    def GetDistAtPoint(self, point: GeoPoint3) -> float:
        """Gets the distance along the polyline from its start to a point of it, as AutoCAD's GetDistAtPoint."""
    def GetDistanceAtParameter(self, value: float) -> float:
        """Gets the distance along the polyline from its start to a parameter, as AutoCAD's
        GetDistanceAtParameter."""
    def GetEnumerator(self) -> System.Collections.Generic.IEnumerator[DxfVertex2d]:
        """Gets an enumerator over the vertices in their order, as AutoCAD's GetEnumerator walks them: each the same
        object while its record is there."""
    def GetFirstDerivative(self, value: float) -> GeoVector3:
        """Gets the derivative of the point by the parameter, as AutoCAD's GetFirstDerivative: on a line the vector
        from its start to its end, on an arc the tangent as long as the arc."""
    def GetOffsetCurves(self, offsetDist: float) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the polylines at a distance from this one in its plane, as AutoCAD's GetOffsetCurves, as a
        DxfPolyline offsets its own: to the right of its way seen from the tip of its DxfPolyline2d.Normal where
        the distance is above nought, arcs kept and corners run on until the segments meet. A fitted polyline is
        offset along the vertices it is drawn through, and gives straight polylines. A closed one that crosses
        itself has none, as a DxfPolyline has none."""
    def GetOffsetCurvesGivenPlaneNormal(
        self,
        planeNormal: GeoVector3,
        offsetDist: float,
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the polylines at a distance from this one in the plane of a normal, as AutoCAD's
        GetOffsetCurvesGivenPlaneNormal: as DxfPolyline2d.GetOffsetCurves, to the right seen from the tip of the
        normal given, which is the polyline's own either way."""
    def GetParameterAtDistance(self, dist: float) -> float:
        """Gets the parameter at a distance along the polyline from its start, as AutoCAD's
        GetParameterAtDistance."""
    def GetParameterAtPoint(self, point: GeoPoint3) -> float:
        """Gets the parameter at a point of the polyline, as AutoCAD's GetParameterAtPoint."""
    def GetPointAtDist(self, value: float) -> GeoPoint3:
        """Gets the point at a distance along the polyline from its start, as AutoCAD's GetPointAtDist."""
    def GetPointAtParameter(self, value: float) -> GeoPoint3:
        """Gets the point at a parameter, the index of a vertex plus how far along the segment it leaves, as
        AutoCAD's GetPointAtParameter."""
    def GetSecondDerivative(self, value: float) -> GeoVector3:
        """Gets the second derivative of the point by the parameter, as AutoCAD's GetSecondDerivative: nought on a
        line."""
    def GetSplitCurves(
        self,
        parameters: System.Collections.Generic.IReadOnlyList[float],
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the pieces the polyline is cut into at parameters, as AutoCAD's GetSplitCurves, as a DxfPolyline
        cuts its own: polylines of the plane of the same look in no file, each segment cut keeping the part of
        its arc and its widths read off along it. A fitted polyline is cut along the vertices it is drawn
        through, and its pieces are straight polylines of those."""
    def InsertVertexAt(self, indexVertex: DxfVertex2d, newVertex: DxfVertex2d) -> None:
        """Puts a vertex made in code after a vertex of the polyline, as AutoCAD's InsertVertexAt; before the first
        where the vertex given is null."""
    def NonDBAppendVertex(self, vertexToAppend: DxfVertex2d) -> None:
        """Appends a vertex made in code after the last, as AutoCAD's NonDBAppendVertex does for a polyline in no
        drawing; here the same as DxfPolyline2d.AppendVertex, for a polyline in a drawing or not."""
    def ReverseCurve(self) -> None:
        """Turns the polyline to run from its end to its start, as AutoCAD's ReverseCurve: the vertices in the other
        order, each segment's bulge turned over and its widths swapped; a closed polyline keeps its first vertex.
        Each vertex record takes the point and flags of its counterpart in one writing of the polyline, every
        handle kept."""
    def SetFromGeCurve(self, geCurve: object) -> None:
        """Gives the polyline the vertices and bulges of a chain or loop, as AutoCAD's SetFromGeCurve, written as
        DxfWriter writes one as a POLYLINE of the plane for a file older than R14, with its VERTEX records, its
        SEQEND kept: a GeoPolyline2, GeoPolylineArc2, GeoPolygon2 or GeoPolygonArc2 on the normal (0, 0, 1) at no
        elevation, closed for a loop, read back by the matching method of the plane to the bit; a GeoPolyline3,
        GeoPolylineArc3, GeoPolygon3 or GeoPolygonArc3 whose every vertex is within the default point tolerance
        of the plane through its first vertex square to the polyline's own DxfPolyline2d.Normal, no point of its
        arcs further off it than the planar tolerance, in the system of that normal, at the elevation of its
        first vertex, as DxfPolyline.SetFromGeCurve writes one; any other of those in the system of the plane it
        lies in within the default tolerance, its normal turned up in its largest component. Its handle, layer,
        look, thickness and extended data are kept. Where the shape is written anew, its widths, its linetype
        generation and its fitting are not kept, the polyline coming back straight (DxfPolyline2d.PolyType
        simple); a shape written as the shape it has now is written leaves it as it is, widths and fitting and
        all."""
    @overload
    def SplineFit(self) -> None:
        """Fits the polyline with a spline, as AutoCAD's SplineFit (PEDIT Spline): of the header's SPLINETYPE (5
