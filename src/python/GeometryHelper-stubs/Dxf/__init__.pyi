    @IsPlottable.setter
    def IsPlottable(self, value: bool) -> None: ...
    @property
    def IsUsed(self) -> bool:
        """Gets whether the layer is in use, as AutoCAD's IsUsed after DxfLayerTable.GenerateUsageData: layer 0,
        Defpoints and the current layer ($CLAYER) always; any other where an entity is on it, in model space,
        paper space or a block, a vertex or an attribute among them, those added since the drawing was opened
        too. The layers in use are worked out in one walk of the drawing and kept until it next changes, so that
        reading it for 400 layers walks it once; false for a layer made in code."""
    @property
    def LineWeight(self) -> DxfLineWeight:
        """Gets or sets the lineweight of the layer (group 370); DxfLineWeight.ByLineWeightDefault where the record
        gives none."""
    @LineWeight.setter
