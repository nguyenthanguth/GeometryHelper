    def __int__(self) -> int: ...

class DxfEllipse(DxfCurve):
    """An ELLIPSE of a DXF file, as AutoCAD's Ellipse: about DxfEllipse.Center, its DxfEllipse.MajorAxis from the
    centre to the end of its long axis, its DxfEllipse.MinorAxis the DxfEllipse.Normal crossed with that and
    DxfEllipse.RadiusRatio times as long, running counter-clockwise about the normal from its start to its end."""
    @overload
    def __init__(self) -> None:
        """Initializes the whole ellipse about the origin on the normal (0, 0, 1) with the major axis (1, 0, 0) and
        the ratio 1, as AutoCAD's new Ellipse(), on layer 0 in no file."""
    @overload
    def __init__(
        self,
        center: GeoPoint3,
        unitNormal: GeoVector3,
        majorAxis: GeoVector3,
        radiusRatio: float,
        startAngle: float,
        endAngle: float,
    ) -> None:
        """Initializes an ellipse, as AutoCAD's new Ellipse(center, unitNormal, majorAxis, radiusRatio, startAngle,
        endAngle), on layer 0 with no look of its own, in no file until it is added to one: nought and 2 pi make
        it whole."""
    @property
    def Area(self) -> float:
        """Gets the area the ellipse closes, as AutoCAD's Area: pi times its two radii for a whole one, and for a
        part the area between it and the chord from its start to its end."""
    @property
    def Center(self) -> GeoPoint3:
        """Gets or sets the centre of the ellipse (groups 10, 20, 30), in world coordinates, as AutoCAD's Center;
        the origin where the record gives none."""
    @Center.setter
    def Center(self, value: GeoPoint3) -> None: ...
    @property
    def Closed(self) -> bool:
        """Gets whether the ellipse is whole: its parameters a whole turn apart, or the same, as the reader takes
        them."""
    @property
    def EndAngle(self) -> float:
        """Gets or sets the angle of the end of the ellipse, as AutoCAD's EndAngle: of the line from the centre to
        it, in radians from the major axis; 2 pi for a whole ellipse that ends where the file's parameter is 2
        pi."""
    @EndAngle.setter
    def EndAngle(self, value: float) -> None: ...
    @property
    def EndParam(self) -> float:
        """Gets or sets the parameter at the end of the ellipse (group 42), as AutoCAD's EndParam: an eccentric
        angle in radians, 2 pi where the record gives none, and 2 pi more where the file's is not above the
        start, so that it runs from DxfEllipse.StartParam up."""
    @EndParam.setter
    def EndParam(self, value: float) -> None: ...
    @property
    def IsNull(self) -> bool:
        """Gets whether the ellipse is of nothing, as AutoCAD's IsNull: its major axis of no length, or its ratio
        nought."""
    @property
    def IsPeriodic(self) -> bool:
        """Gets whether the ellipse runs round on itself, as AutoCAD's IsPeriodic: true for a whole one."""
    @property
    def MajorAxis(self) -> GeoVector3:
        """Gets the vector from the centre to the end of the long axis (groups 11, 21, 31), in world coordinates, as
        AutoCAD's MajorAxis; (1, 0, 0) where the record gives none. It is set with the rest by DxfEllipse.Set."""
    @property
    def MajorRadius(self) -> float:
        """Gets the length of the major axis, as AutoCAD's MajorRadius."""
    @property
    def MinorAxis(self) -> GeoVector3:
        """Gets the vector from the centre to the end of the short axis, as AutoCAD's MinorAxis: the
        DxfEllipse.Normal crossed with the major axis, DxfEllipse.MinorRadius long."""
    @property
    def MinorRadius(self) -> float:
        """Gets the length of the minor axis, the major radius times the DxfEllipse.RadiusRatio, as AutoCAD's
        MinorRadius."""
    @property
    def Normal(self) -> GeoVector3:
        """Gets the normal of the ellipse (groups 210, 220, 230), of unit length, as AutoCAD's Normal; (0, 0, 1)
        where the record gives none. It is set with the rest by DxfEllipse.Set."""
    @property
    def RadiusRatio(self) -> float:
        """Gets or sets the minor radius over the major (group 40), as AutoCAD's RadiusRatio; 1 where the record
        gives none. Set, the parameters are kept, so the ends keep their eccentric angles."""
    @RadiusRatio.setter
    def RadiusRatio(self, value: float) -> None: ...
    @property
    def StartAngle(self) -> float:
        """Gets or sets the angle of the start of the ellipse, as AutoCAD's StartAngle: of the line from the centre
        to it, in radians from the major axis counter-clockwise about the normal, from nought up to 2 pi; not the
        parameter, which the file holds (group 41), but worked out from it and the DxfEllipse.RadiusRatio."""
    @StartAngle.setter
    def StartAngle(self, value: float) -> None: ...
    @property
    def StartParam(self) -> float:
        """Gets or sets the parameter at the start of the ellipse (group 41), as AutoCAD's StartParam: an eccentric
        angle in radians; nought where the record gives none."""
    @StartParam.setter
    def StartParam(self, value: float) -> None: ...
    @overload
    def Extend(self, newParameter: float) -> None:
        """Extends a part of an ellipse round the ellipse to a parameter past one of its ends, as AutoCAD's Extend:
        below DxfEllipse.StartParam moves its start back, above DxfEllipse.EndParam moves its end on."""
    @overload
    def Extend(self, extendStart: bool, toPoint: GeoPoint3) -> None:
        """Extends a part of an ellipse at one end round the ellipse to a point of it, as AutoCAD's Extend."""
    def GetAngleAtParameter(self, value: float) -> float:
        """Gets the angle from the major axis of the point at a parameter, as AutoCAD's GetAngleAtParameter, from
        nought up to 2 pi; 2 pi at the parameter 2 pi. On the ellipse of ratio 0.5 the parameter pi / 4 is at the
        angle 0.4636."""
    def GetClosestPointTo(self, givenPoint: GeoPoint3, extend: bool) -> GeoPoint3:
        """Gets the point of the ellipse nearest a point, as AutoCAD's GetClosestPointTo: on the whole ellipse where
        it is whole or extended, else on its part, an end where that is nearer."""
    def GetDistAtPoint(self, point: GeoPoint3) -> float:
        """Gets the distance along the ellipse from its start to a point of it."""
    def GetDistanceAtParameter(self, value: float) -> float:
        """Gets the distance along the ellipse from its start to a parameter, as AutoCAD's
        GetDistanceAtParameter."""
    def GetFirstDerivative(self, value: float) -> GeoVector3:
        """Gets the derivative of the ellipse at a parameter, as AutoCAD's GetFirstDerivative: the minor axis times
        the cosine less the major axis times the sine."""
    def GetOffsetCurves(self, offsetDist: float) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the curve at a distance from the ellipse, as AutoCAD's GetOffsetCurves: not an ellipse, so a
        DxfSpline, as AutoCAD gives one, of the ellipse's look in no file: its DxfCurve.Spline offset as
        DxfSpline.GetOffsetCurvesGivenPlaneNormal offsets one about the ellipse's normal, outwards where the
        distance is above nought, as a circle's radius grows. The curve 1 out from the ellipse of radii 10 and 5
        keeps 1 from it within the 1E-3 the spline is fitted to."""
    def GetOffsetCurvesGivenPlaneNormal(
        self,
        planeNormal: GeoVector3,
        offsetDist: float,
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the curve at a distance from the ellipse in the plane of a normal, as AutoCAD's
        GetOffsetCurvesGivenPlaneNormal: as DxfEllipse.GetOffsetCurves, the plane being the ellipse's own and the
        side outwards for a distance above nought whichever way the normal given points, as a circle's."""
    def GetParameterAtAngle(self, angle: float) -> float:
        """Gets the parameter of the point at an angle from the major axis, as AutoCAD's GetParameterAtAngle, from
        nought up to 2 pi; 2 pi at the angle 2 pi."""
    def GetParameterAtDistance(self, dist: float) -> float:
        """Gets the parameter at a distance along the ellipse from its start, as AutoCAD's
        GetParameterAtDistance."""
    def GetParameterAtPoint(self, point: GeoPoint3) -> float:
        """Gets the parameter at a point of the ellipse, as AutoCAD's GetParameterAtPoint: its eccentric angle, from
        DxfEllipse.StartParam to DxfEllipse.EndParam."""
    def GetPointAtDist(self, value: float) -> GeoPoint3:
        """Gets the point at a distance along the ellipse from its start."""
    def GetPointAtParameter(self, value: float) -> GeoPoint3:
        """Gets the point at a parameter, an eccentric angle, as AutoCAD's GetPointAtParameter: the centre, the
        major axis times its cosine and the minor axis times its sine."""
    def GetSecondDerivative(self, value: float) -> GeoVector3:
        """Gets the second derivative of the ellipse at a parameter: from the point to the centre."""
    def GetSplitCurves(
        self,
        parameters: System.Collections.Generic.IReadOnlyList[float],
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the pieces the ellipse is cut into at parameters, as AutoCAD's GetSplitCurves: parts of it of the
        same look in no file. A part is cut from its start to the first parameter, on to the next and to its end;
        a whole one from each parameter to the next round it and from the last round to the first, given whole
        where it is cut at fewer than two places. A parameter at an end or within the point tolerance along it of
        another cuts nothing."""
    def ReverseCurve(self) -> None:
        """Turns the ellipse to run from its end to its start, as AutoCAD's ReverseCurve: its normal turned over,
        which turns its minor axis over, its major axis kept, and its parameters those of its old end and start
        under that. The record is written once."""
    def Set(
        self,
        center: GeoPoint3,
        unitNormal: GeoVector3,
        majorAxis: GeoVector3,
        radiusRatio: float,
        startAngle: float,
        endAngle: float,
    ) -> None:
        """Gives the ellipse a new centre, normal, major axis, ratio and end angles at once, as AutoCAD's Set: the
        record is written once, every other group kept."""
    def SetFromGeCurve(self, geCurve: object) -> None:
        """Gives the ellipse the centre, normal, axes and radii of a whole GeoEllipse3, as AutoCAD's SetFromGeCurve,
        or of a GeoEllipse2 at z = 0 on the normal (0, 0, 1), each written as DxfWriter writes one."""
    @overload
    def ToGeoEllipse2(self) -> GeoEllipse2:
        """Gets the whole ellipse in the plane, as DxfReader reads it with DxfReadOptions.PlanAs2D within the
        default tolerance: the ellipse about (0, 0, 0) with the end of its major axis at (60, 0, 0) and a ratio
        of 0.5 is the GeoEllipse2 of radii 60 and 30 along x. One at a height, or on a normal other than (0, 0,
        1) and (0, 0, -1), does not lie on the floor, and is refused; so is a part of an ellipse, which
        DxfEllipse.ToGeoSpline2 gives."""
    @overload
    def ToGeoEllipse2(self, tolerance: Tolerance) -> GeoEllipse2:
        """Gets the whole ellipse in the plane, as DxfEllipse.ToGeoEllipse2 does, within a tolerance, which says
        whether its major axis has a length."""
    def ToGeoEllipse3(self) -> GeoEllipse3:
        """Gets the whole ellipse as the library's, as AutoCAD's GetGeCurve and the AutoCAD bridge's ToGeoEllipse3
        give it: the shape DxfEntity.GetGeometry gives, to the bit. The ellipse about (0, 0, 0) with the end of
        its major axis at (60, 0, 0) and a ratio of 0.5 is the GeoEllipse3 of radii 60 and 30. A part of an
        ellipse is refused: DxfEllipse.ToGeoSpline3 gives it, as the reader reads it, exactly."""
    @overload
    def ToGeoSpline2(self) -> GeoSpline2:
        """Gets a part of an ellipse in the plane as the spline that is exactly that part, as DxfReader reads it
        with DxfReadOptions.PlanAs2D within the default tolerance, in the direction of the file. One that does
        not lie on the floor is refused, and so is a whole ellipse, which DxfEllipse.ToGeoEllipse2 gives."""
    @overload
    def ToGeoSpline2(self, tolerance: Tolerance) -> GeoSpline2:
        """Gets a part of an ellipse in the plane as the spline that is exactly that part, as
        DxfEllipse.ToGeoSpline2 does, within a tolerance, which says whether its major axis has a length."""
    def ToGeoSpline3(self) -> GeoSpline3:
        """Gets a part of an ellipse as the spline that is exactly that part, as DxfEntity.GetGeometry gives it, to
        the bit: rational quadratic pieces of at most a quarter turn of its eccentric angle, so a quarter of the
        ellipse 60 by 30 is a GeoSpline3 of 3 control points. A whole ellipse is refused:
        DxfEllipse.ToGeoEllipse3 gives it, and DxfCurve.Spline the spline of a whole one."""

class DxfEndCap(System.Enum):
    """How the ends of a wide line are drawn, as AutoCAD's EndCap numbers them ($ENDCAPS, group 280)."""
    Angle: ClassVar[DxfEndCap]
    """Angled, 2."""
    Round: ClassVar[DxfEndCap]
    """Round, 1."""
    Square: ClassVar[DxfEndCap]
    """Square, 3: the end carried half the width past the end point."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class DxfEntity(DxfDBObject):
    """An entity of a DXF file, as AutoCAD's Entity is one of a drawing: what it is drawn on and with (its layer,
    colour, linetype, lineweight and whether it is shown), the block it is in, and its geometry as the library's
    shapes."""
    @property
    def BlockName(self) -> str:
        """Gets the name of the block the entity is in, as AutoCAD's BlockName: *Model_Space for an entity of model
        space and *Paper_Space for one of paper space, whatever the file calls them; that of the entity it
        follows for a VERTEX or an ATTRIB; null where DxfEntity.Owner is null."""
    @property
    def Color(self) -> DxfColor:
        """Gets or sets the colour of the entity, as AutoCAD's Color: its true colour (group 420, its book's name
        430) where it has one, else its colour index (62), BYLAYER where it gives none. It agrees with
        DxfEntity.ColorIndex and DxfEntity.TrueColor, which read the same groups; a true colour carries the index
        nearest it, as DxfColor.FromRgb gives it: orange, 0xFF8000, the index 30, whatever index the record
        writes beside it."""
    @Color.setter
    def Color(self, value: DxfColor) -> None: ...
    @property
    def ColorIndex(self) -> int:
        """Gets or sets the colour of the entity (group 62), as AutoCAD's ColorIndex: 1 to 255 for a colour of
        AutoCAD's index, 0 for BYBLOCK and 256 for BYLAYER, which an entity that gives none has."""
    @ColorIndex.setter
    def ColorIndex(self, value: int) -> None: ...
    @property
    def Ecs(self) -> GeoTransform3:
        """Gets the system of the entity's own coordinates, as AutoCAD's Ecs: the one the arbitrary axis algorithm
        of the DXF reference makes of its extrusion (group 210), taking a point of it to the world; the world's
        own where the extrusion is (0, 0, 1) or the record gives none."""
    @property
    def GeometricExtents(self) -> GeoAabb3:
        """Gets the box the entity's shapes fill, as AutoCAD's GeometricExtents: the least and greatest x, y and z
        the shapes of DxfEntity.GetGeometry reach as DxfWriter writes them, its thickness not counted. An
        INSERT's are those of what it places; one whose block would place more than
        DxfReadOptions.MaxPlacedEntities by its default, 2 000 000 entities, places nothing, as the reader leaves
        it, and so has no extents, as an INSERT of a block the drawing does not define has none. A class of a
        type the reader gives no shapes for gives its own, as a HATCH the box of its loops."""
    @property
    def Hyperlinks(self) -> DxfHyperLinkCollection:
        """Gets the hyperlinks of the entity, as AutoCAD's Hyperlinks: those of its extended data of the application
        PE_URL, read and written as DxfHyperLinkCollection says."""
    @property
    def IsPlanar(self) -> bool:
        """Gets whether the entity lies in one plane, as AutoCAD's IsPlanar: whether DxfEntity.GetPlane finds one,
        to Tolerance.Default. A line, and a polyline whose vertices run along one line, lie in one; a 3D polyline
        with a corner 0.002 off the plane of the others does not. A DxfSpline gives what its record says, the
        flag 8 of its group 70."""
    @property
    def Layer(self) -> str:
        """Gets or sets the layer the entity is on (group 8), as AutoCAD's Layer: the name as the layer table names
        it, the spaces around it taken off and its escapes (\\U+00E9) read as letters; 0 where the record gives
        none."""
    @Layer.setter
    def Layer(self, value: str) -> None: ...
    @property
    def LineWeight(self) -> DxfLineWeight:
        """Gets or sets the lineweight of the entity (group 370), as AutoCAD's LineWeight:
        DxfLineWeight.LineWeight025 is a line 0.25 mm wide; DxfLineWeight.ByLayer where the record gives none."""
    @LineWeight.setter
    def LineWeight(self, value: DxfLineWeight) -> None: ...
    @property
    def Linetype(self) -> str:
        """Gets or sets the name of the linetype of the entity (group 6), as AutoCAD's Linetype: DASHED, ByBlock;
        ByLayer where the record gives none. The name is as the record spells it, the spaces around it taken off."""
    @Linetype.setter
    def Linetype(self, value: str) -> None: ...
    @property
    def LinetypeScale(self) -> float:
        """Gets or sets the scale of the entity's linetype (group 48), as AutoCAD's LinetypeScale: 2 draws its
        dashes twice as long; 1 where the record gives none."""
    @LinetypeScale.setter
    def LinetypeScale(self, value: float) -> None: ...
    @property
    def Owner(self) -> DxfDBObject:
        """Gets what owns the entity, as AutoCAD's OwnerId names it: the block it is in, DxfDatabase.ModelSpace for
        an entity of model space; for a record that follows an entity, as a VERTEX of a POLYLINE or an ATTRIB of
        an INSERT, that entity. Null for one made in code and not yet added, or erased."""
    @property
    def Transparency(self) -> DxfTransparency:
        """Gets or sets how much the entity lets show through it (group 440), as AutoCAD's Transparency: BYLAYER
        where the record gives none, BYBLOCK, or an alpha from 0, clear, to 255, solid, as DxfTransparency says."""
    @Transparency.setter
    def Transparency(self, value: DxfTransparency) -> None: ...
    @property
    def TrueColor(self) -> int | None:
        """Gets or sets the colour of the entity as red, green and blue (group 420), 0xRRGGBB, which a CAD program
        draws in place of DxfEntity.ColorIndex: 0xFF8000 is orange; null where it has none."""
    @TrueColor.setter
    def TrueColor(self, value: int | None) -> None: ...
    @property
    def Visible(self) -> bool:
        """Gets or sets whether the entity is drawn (group 60), as AutoCAD's Visible: false where the record writes
        it invisible, 1; true where it gives none."""
    @Visible.setter
    def Visible(self, value: bool) -> None: ...
    def BoundingBoxIntersectWith(
        self,
        entityPointer: DxfEntity,
        intersectType: DxfIntersect,
    ) -> System.Collections.Generic.IReadOnlyList[GeoPoint3]:
        """Gets the points where the boxes of the entity and another meet, as AutoCAD's BoundingBoxIntersectWith:
        where an edge of the one box of DxfEntity.GeometricExtents enters or leaves the other box, each way, to
        Tolerance.Default. Two flat boxes in one plane meet where their outlines cross: the box of the line from
        (0, 0, 0) to (10, 10, 0) and that of the line from (5, 5, 0) to (15, 15, 0) meet at (10, 5, 0) and (5,
        10, 0). A box is never extended, whatever the type of intersection."""
    def Clone(self) -> DxfEntity:
        """Gets a copy of the entity as it is, as AutoCAD's Clone gives one of an object: an entity of the same
        class and look in no file, a DxfUnknownEntity among them, its records as the file has them but its
        handle, owner, space, reactors and extension dictionary; a VERTEX the vertex class it is, an ATTRIB an
        attribute. It is added to a drawing by DxfBlockTableRecord.AppendEntity, as a copy from another drawing
        is: see that method for the pointers it carries."""
    def Erase(self) -> None:
        """Erases the entity from its block, as AutoCAD's Erase does: every record of it goes, a POLYLINE's vertices
        and end and an INSERT's attributes with it, its handle is not given again, and what pointed at it is seen
        to when the file is saved: a GROUP no longer lists it, a list of reactors no longer holds it, and the
        objects it owned, such as its extension dictionary, go with it; any other pointer at it, as a table
        cell's at an attribute definition (331) or an XRECORD's data, stays where it stands, named in the log
        once. A record that follows an entity, a VERTEX of a POLYLINE or an ATTRIB of an INSERT, is taken out of
        it alone, every other record keeping its handle."""
    def Explode(self) -> System.Collections.Generic.IReadOnlyList[DxfEntity]:
        """Gets the entities the entity breaks into, as AutoCAD's Explode: new entities in no file. A
        DxfBlockReference gives the entities of its block placed where it puts them, a MINSERT those of every
        cell; a polyline its lines and arcs; a polyface and a polygon mesh a 3DFACE for each face; an MTEXT a
        TEXT for each line; a dimension and a table the entities of the block they are drawn with, placed; a
        LEADER its lines, or its spline, and its arrowhead; a MULTILEADER its words or block, its leader lines
        and arrows; an MLINE its lines and caps; a HATCH of a pattern the dashes of its pattern cut by its loops.
        Any other entity refuses, as AutoCAD answers eNotApplicable for one that does not break, a LINE or a
        CIRCLE; and so do a HATCH filled solid or with a gradient, a MESH, and a REGION, a 3DSOLID and a BODY,
        which AutoCAD breaks with its solid modeler, each saying why."""
    def GetGeometry(self) -> System.Collections.Generic.IReadOnlyList[Any]:
        """Gets the library's shapes for the entity, as DxfReader reads it with its default options: a GeoLine3 for
        a LINE, two GeoTriangle3 for a 3DFACE whose corners are not in one plane, the shapes of its block placed
        for an INSERT; none for a type the reader does not read, as a HATCH, or an entity with no shape to it, as
        a LINE of no length. A LEADER gives its curve, as the reader reads it and AutoCAD intersects a leader on
        it: a GeoPolyline3 through its vertices, a vertex on the one before it left out, so that the leader from
        (0, 0, 0) to (10, 5, 0) meets the line x = 5 at (5, 2.5, 0); splined, the GeoSpline3 of the spline
        DxfLeader.Explode fits through them; none where fewer than two of its vertices are apart. A MULTILEADER
        gives the lines of its leaders, as DxfMLeader says, and not its words or block. An IMAGE and a WIPEOUT,
        which the reader does not read, give the closed GeoPolyline3 of their DxfRasterImage.GetVertices, the
        frame of the image or its boundary where it is clipped; an OLE2FRAME the closed GeoPolyline3 of the four
        corners of its DxfOle2Frame.Position3d."""
    def GetPlane(self) -> GeoPlane3:
        """Gets the plane the entity lies in, as AutoCAD's GetPlane: that of its extrusion through its first point
        where all of it lies in that, as a circle, an arc, a polyline or a text does; else the plane its shapes
        span, as a 3DFACE's or a SPLINE's. An entity along one line, as a LINE, lies in the plane through it
        whose normal is nearest its extrusion, the extrusion itself where the line runs across it; a point, in
        the plane of its extrusion. Points and planes are compared to Tolerance.Default. A class of a type the
        reader gives no shapes for gives its own, as a HATCH the plane of its extrusion."""
    def GetTransformedCopy(self, transform: GeoTransform3) -> DxfEntity:
        """Gets a copy of the entity moved by a transformation, as AutoCAD's GetTransformedCopy does: an entity of
        the same class and look in no file, to be added to one by DxfBlockTableRecord.AppendEntity."""
    def IntersectWith(
        self,
        entityPointer: DxfEntity,
        intersectType: DxfIntersect,
    ) -> System.Collections.Generic.IReadOnlyList[GeoPoint3]:
        """Gets the points where the entity and another meet, as AutoCAD's IntersectWith: worked out by the
        library's shapes for both (DxfEntity.GetGeometry), each pair of a shape of this entity and one of the
        other, to Tolerance.Default. As AutoCAD's, it meets curves and edges, not areas: a closed polyline, a
        SOLID, a 3DFACE and a mesh by the segments and arcs of their edges, so that the square of side 4 about
        the origin meets the line from (-10, 0, 0) to (10, 0, 0) at (-2, 0, 0) and (2, 0, 0), and the line
        through its middle up the z axis nowhere. A chain the library has no intersection of with a shape is
        taken segment by segment and arc by arc, and a POINT meets a shape where it lies on it. An entity that is
        to run on past its ends, as the type of intersection says, is taken as its line or circle where it is a
        LINE or an ARC; any other is taken as it is."""
    def JoinEntities(
        self,
        otherEntities: System.Collections.Generic.IReadOnlyList[DxfEntity],
    ) -> System.Collections.Generic.IReadOnlyList[int]:
        """Joins other curves into the entity, as AutoCAD's JoinEntities does, by the rules DxfEntity.JoinEntity
        says: those that join, in one writing of the entity, and the others left out, each left as it is for the
        caller to erase. Pieces joined end to end are chained on from the entity's end, then back from its start,
        each time the one of lowest index of those that meet the end reached, so that the lines of a square given
        in any order close a polyline of one of them; 10 000 lines in any order are chained in time along their
        count. Lines join whatever their order. Arcs and elliptical arcs are taken in the order of their starts
        counter-clockwise from the entity's end, the lower index first at one angle, each run on from the entity
        as it stands then, so that their order does not change what they make: the quarter from 0 to pi / 2 given
        the arcs from 3 pi / 2 to 7 pi / 4 and from 7 pi / 4 round to pi / 8, in either order, runs to 7 pi / 4
        and leaves out the second, which would make it whole."""
    def JoinEntity(self, secondaryEntity: DxfEntity) -> None:
        """Joins another curve into the entity, as AutoCAD's JoinEntity does by the rules of its JOIN: the entity's
        record is written anew to run over both, its look and every group the joining is not about kept, and the
        other is left as it is, for the caller to erase. Ends meet within the point tolerance of
        Tolerance.Default, 0.001, measured in space."""
    @overload
    def SetDatabaseDefaults(self) -> None:
        """Gives the entity the look of the drawing it is in, as AutoCAD's SetDatabaseDefaults() gives one that of
        its database, as DxfEntity.SetDatabaseDefaults says. AutoCAD gives an entity in no database the look of
        the drawing open in its window; an entity made in code is in no drawing until it is appended, so it is
        refused."""
    @overload
    def SetDatabaseDefaults(self, database: DxfDatabase) -> None:
        """Gives the entity the look a drawing gives new entities, as AutoCAD's SetDatabaseDefaults: the layer
        ($CLAYER), colour ($CECOLOR), linetype ($CELTYPE) and, in a drawing of R2000 or later, linetype scale
        ($CELTSCALE) and lineweight ($CELWEIGHT) of its header."""
    def SetPropertiesFrom(self, entity: DxfEntity) -> None:
        """Gives the entity the look of another, as AutoCAD's SetPropertiesFrom does: its layer, colour, true colour
        and the name of its colour book, linetype, linetype scale, lineweight and whether it is drawn. Everything
        is checked before anything is written: a look this entity's file cannot hold changes nothing."""
    def ToString(self) -> str:
        """Gives the entity as a line for debugging: its type, its handle and its layer."""
    def TransformBy(self, transform: GeoTransform3) -> None:
        """Moves, turns, scales or mirrors the entity by a transformation, as AutoCAD's TransformBy does: its record
        is written anew with the new geometry, its look kept, and its extended data moved with it in the same
        writing, as DxfDBObject.XDataTransformBy moves it: a world position (1011) moved, a displacement (1012)
        and a direction (1013) turned, a distance (1041) and a scale factor (1042) scaled. An entity with none of
        those keeps its extended data's bytes. Each class moves its own geometry as its page says."""

class DxfEraseFlags(System.Enum):
    """The empty objects DxfDatabase.CountEmptyObjects counts and DxfDatabase.EraseEmptyObjects erases, as AutoCAD's
    EraseFlags names and numbers them, given as a whole number:
    db.EraseEmptyObjects((int)DxfEraseFlags.ZeroLengthCurve)."""
    AllEmptyObj: ClassVar[DxfEraseFlags]
    """Every kind of empty object, -1."""
    EmptyText: ClassVar[DxfEraseFlags]
    """A text of no words, 2: a TEXT or an MTEXT whose text is empty or spaces."""
    ZeroLengthCurve: ClassVar[DxfEraseFlags]
    """A curve of no length, 1: a line whose ends are one point, a circle or an arc of no radius, and the like."""
    def __init__(self, value: int) -> None: ...
    def __and__(self, other: DxfEraseFlags) -> DxfEraseFlags: ...
    def __int__(self) -> int: ...
    def __invert__(self) -> DxfEraseFlags: ...
    def __or__(self, other: DxfEraseFlags) -> DxfEraseFlags: ...
    def __xor__(self, other: DxfEraseFlags) -> DxfEraseFlags: ...

class DxfExtents2d(System.ValueType):
    """A box of the plane by its two corners, as AutoCAD's Extents2d: the limits of a layout, the margins of a
    sheet, the window of a plot. The corners are as the file gives them, not sorted: a box from (0, 0) to (420,
    297) is a sheet of A3 laid on its side."""
    def __init__(self, min: GeoPoint2, max: GeoPoint2) -> None:
        """Initializes a box of its two corners, as AutoCAD's Extents2d(min, max)."""
    @property
    def MaxPoint(self) -> GeoPoint2:
        """Gets the corner of the greatest x and y, as AutoCAD's MaxPoint."""
    @property
    def MinPoint(self) -> GeoPoint2:
        """Gets the corner of the least x and y, as AutoCAD's MinPoint."""
    @overload
    def Equals(self, other: DxfExtents2d) -> bool:
        """Gets whether two boxes have the same corners, to the bit."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Gets whether an object is a box of the same corners, to the bit."""
    def GetHashCode(self) -> int:
        """Gets a hash of the corners, the same for boxes of the same corners."""
    def ToString(self) -> str:
        """Gives the box as a line for debugging: its two corners."""

class DxfFace(DxfEntity):
    """A 3DFACE of a DXF file, as AutoCAD's Face: three or four corners in the world, each edge drawn or hidden."""
    @overload
    def __init__(self) -> None:
