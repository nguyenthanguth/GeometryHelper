    @UseBackgroundColor.setter
    def UseBackgroundColor(self, value: bool) -> None: ...
    @property
    def Width(self) -> float:
        """Gets or sets the width the lines wrap at (group 41), as AutoCAD's Width; nought, no wrapping, where the
        record gives none. An MTEXT in columns before R2018 (AC1032), whose 41 holds the width of a column, is as
