class DxfField(DxfDBObject):
    """A field of a DXF file, as AutoCAD's Field: a FIELD of the OBJECTS section, the code AutoCAD evaluates to the
    words a text shows, kept in the extension dictionary of the object it belongs to, in its dictionary
    ACAD_FIELD, and reached by DxfDBObject.GetField."""
    @overload
    def __init__(self, fieldCode: str) -> None:
        """Initializes a field made in code of the code of one field, as AutoCAD's Field(fieldCode): the code in its
        markers, %<\\AcVar Date \\f \"dd/MM/yyyy\">%, its evaluator the word after the backslash, AcVar, its code
        what the markers hold; to be given to an object by DxfDBObject.SetField."""
    @overload
    def __init__(self, fieldCode: str, textField: bool) -> None:
        """Initializes a field made in code, as AutoCAD's Field(fieldCode, textField): of one field as DxfField, or,
        as a text field, of a text with fields in it, each field in its markers, its evaluator _text: new
        DxfField(\"Drawn %<\\\\AcVar Date>% by %<\\\\AcVar Login>%\", true) is the text field of the code Drawn
        %<\\_FldIdx 0>% by %<\\_FldIdx 1>% with the two fields as its children. A marker inside a field, as the
        object of %<\\AcObjProp Object(%<\\_ObjId 2130>%).Area>%, is part of that field's code, kept as written:
        the library names no object for it (97 of 0 and no 331 written), so that AutoCAD cannot find the object
        such a field reads, and shows it as one it could not evaluate."""
    @property
    def EvaluatorId(self) -> str:
        """Gets the evaluator of the field (group 1), as AutoCAD's EvaluatorId: _text for a text with fields in it,
        AcVar for a variable of the drawing, AcObjProp for a property of an object, AcExpr for a formula; empty
        where the record gives none."""
    @property
    def IsTextField(self) -> bool:
        """Gets whether the field is a text with fields in it, as AutoCAD's IsTextField: its evaluator _text."""
    def GetChildren(self) -> System.Array[DxfField]:
        """Gets the fields of the field, as AutoCAD's GetChildren: those its groups 360 name, in their order, each
        the field %<\\_FldIdx>% of its index stands for; null in the place of a handle that names no FIELD of the
        file, so that each keeps the index its placeholder gives it."""
    def GetFieldCode(self) -> str:
        """Gets the code of the field (group 2, and the groups 3 that carry it on past 250 characters), as AutoCAD's
        GetFieldCode(): as the file holds it, a child standing as %<\\_FldIdx 0>%, the object of a property as
        %<\\_ObjIdx 0>%; \\AcVar Date \\f \"dd/MM/yyyy\" for a date, Drawn %<\\_FldIdx 0>% for a text with it in
        it. Empty where the record gives none."""
    def GetStringValue(self) -> str:
        """Gets the value AutoCAD kept for the field when it last evaluated it, as AutoCAD's GetStringValue: the
        text of its cache, the value after 7 ACFD_FIELD_VALUE, as it was shown (302), or, where it has none, its
        text (1); empty where the field has no value kept, as one made in code."""
    def ToString(self) -> str:
        """Gives the field as a line for debugging: its type, its handle, its evaluator and its code."""

