    def Color(self) -> DxfColor:
        """Gets the colour of the element (group 62), as AutoCAD's Color: BYBLOCK where the record gives none, as
        AutoCAD reads it."""
    @property
    def Linetype(self) -> str:
        """Gets the name of the element's linetype (group 6), as AutoCAD's LinetypeId names it: BYLAYER where the
        record gives none."""
    @property
    def Offset(self) -> float:
        """Gets the offset of the element from the line drawn (group 49), as AutoCAD's Offset: 0.5 to its left, -0.5
        to its right."""

class DxfMlineStyleSettings(System.Object):
    """What a style of multilines is made of, to give DxfDatabase.AddMlineStyle a new style or DxfMlineStyle.Apply
    an edit of one, as AutoCAD's MlineStyle is set before it is added to the dictionary: its description, fill,
    caps, the angles of its ends, whether a line is drawn across each joint, and its elements."""
    def __init__(self) -> None:
        """Initializes the settings of AutoCAD's new style, as the remarks say."""
    @property
    def Description(self) -> str:
        """Gets or sets the description (group 3), as AutoCAD's Description; empty for none."""
    @Description.setter
    def Description(self, value: str) -> None: ...
    @property
    def Elements(self) -> System.Collections.Generic.IList[DxfMlineStyleElement]:
        """Gets the elements, from one to sixteen, each its offset from the line drawn, its colour and its linetype;
        written from the greatest offset to the least, as AutoCAD sorts them, two of one offset in the order
        given."""
