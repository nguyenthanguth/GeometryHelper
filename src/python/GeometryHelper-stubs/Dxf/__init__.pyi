        value1: bool,
        value2: bool,
        value3: bool,
        value4: bool,
    ) -> None:
        """Initializes a face of four corners, as AutoCAD's new Face(pointer1, pointer2, pointer3, pointer4, value1,
        value2, value3, value4), on layer 0 in no file until it is added to one."""
    def GetVertexAt(self, index: int) -> GeoPoint3:
        """Gets a corner of the face in the world (groups 10 + index, 20 + index, 30 + index), as AutoCAD's
        GetVertexAt: the third where the record gives no fourth."""
    def IsEdgeVisibleAt(self, index: int) -> bool:
        """Gets whether an edge of the face is drawn, as AutoCAD's IsEdgeVisibleAt: not hidden by its flag of group
        70."""
    def MakeEdgeInvisibleAt(self, index: int) -> None:
        """Hides an edge of the face, as AutoCAD's MakeEdgeInvisibleAt: its flag of group 70 set."""
    def MakeEdgeVisibleAt(self, index: int) -> None:
        """Draws an edge of the face, as AutoCAD's MakeEdgeVisibleAt: its flag of group 70 taken off."""
    def SetVertexAt(self, index: int, point: GeoPoint3) -> None:
        """Moves a corner of the face, given in the world, as AutoCAD's SetVertexAt."""
    @overload
    def ToGeoPolygon2(self) -> GeoPolygon2:
        """Gets the face as a polygon of the plane: the polygon of DxfFace.ToGeoPolygon3 where every corner of it is
        at a height of nought, as DxfReader takes a shape in world coordinates to lie on the floor, and refused
        otherwise, the reader reading a 3DFACE in space whatever DxfReadOptions.PlanAs2D says. The face above is
        the GeoPolygon2 (0, 0), (10, 0), (10, 8), (0, 8)."""
    @overload
    def ToGeoPolygon2(self, tolerance: Tolerance) -> GeoPolygon2:
        """Gets the face as a polygon of the plane, as DxfFace.ToGeoPolygon2 does, its corners read within a
        tolerance, whose planar part says whether four corners are in one plane."""
    def ToGeoPolygon3(self) -> GeoPolygon3:
        """Gets the face as the library's polygon, of the corners DxfEntity.GetGeometry reads: the boundary of its
        GeoFace3 where it has four corners in one plane within the planar tolerance, and the polygon of its
        GeoTriangle3 where it has three, a corner the same as the one before it to the bit left out. The face (0,
        0, 0), (10, 0, 0), (10, 8, 0), (0, 8, 0) is that GeoPolygon3; with a corner raised by 1 its corners are
        not in one plane, the reader cuts it into two triangles, and it is refused, as the bow tie (0, 0, 0),
        (10, 10, 0), (10, 0, 0), (0, 10, 0) is, whose edges cross."""

