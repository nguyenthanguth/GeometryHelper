    def IsFrozen(self) -> bool:
        """Gets or sets whether the layer is frozen (flag 1 of group 70): its entities are not drawn."""
    @IsFrozen.setter
    def IsFrozen(self, value: bool) -> None: ...
    @property
    def IsLocked(self) -> bool:
        """Gets or sets whether the layer is locked (flag 4 of group 70): its entities are drawn and cannot be
        changed in AutoCAD."""
