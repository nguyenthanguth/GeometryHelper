    OverlineOff: ClassVar[str]
    """Gets the code that ends a line over the letters, as AutoCAD's OverlineOff: \\o."""
    OverlineOn: ClassVar[str]
    """Gets the code that begins a line over the letters, as AutoCAD's OverlineOn: \\O."""
    ParagraphBreak: ClassVar[str]
    """Gets the code that ends a paragraph, as AutoCAD's ParagraphBreak: \\P, B-12\\PM16 two lines."""
