    def ToPolyline(self) -> DxfCurve:
        """Gets the polyline that runs along the spline, as AutoCAD's ToPolyline: as
        DxfSpline.ToPolylineWithPrecision of precision 10, of arcs, a DxfPolyline where the spline is flat."""
    @overload
    def ToPolyline(self, numOfVertices: int) -> DxfCurve:
        """Gets the polyline of a count of vertices that runs along the spline, the library's own reading of
        AutoCAD's ToPolyline, as DxfSpline.ToPolyline says: of arcs, a DxfPolyline where the spline is flat."""
    @overload
    def ToPolyline(self, bConvertAsArcs: bool, bToLWPolyline: bool) -> DxfCurve:
        """Gets the polyline that runs along the spline, as AutoCAD's ToPolyline, as
        DxfSpline.ToPolylineWithPrecision of precision 10."""
    @overload
    def ToPolyline(self, numOfVertices: int, bConvertAsArcs: bool, bToLWPolyline: bool) -> DxfCurve:
        """Gets the polyline of a count of vertices that runs along the spline, the library's own reading of
        AutoCAD's ToPolyline: the vertices set evenly along the spline's length, a closed spline's last on its
        first, which the closed polyline joins back to; each segment a line, or the arc through its ends and the
        spline's point halfway between them. A quarter of a circle of radius 100 made a spline, given 3 vertices
        and arcs, is two arcs of radius 100 to within the rounding. AutoCAD 2021 keeps a different promise: it
        was seen to give the cubic of one span 33 vertices for every count from 2 to 50 and 65 for 99, the cubic
        of two spans 50 for every count from 3 to 99, and to refuse the smallest counts (2 for two spans, 2 and 3
        for three); the count it is given is not the count it makes."""
