class DxfTolerance(DxfEntity):
    """A TOLERANCE of a DXF file, as AutoCAD's FeatureControlFrame: a feature control frame of geometric
    dimensioning and tolerancing, its words in group 1 as AutoCAD's TOLERANCE command writes them, put at its
    insertion point along its direction in the plane of its normal and drawn by its dimension style."""
    def __init__(self) -> None:
        """Initializes a TOLERANCE of no words at the origin, along the world's x in the plane of its z, in the
        dimension style Standard, as AutoCAD's new FeatureControlFrame(), on layer 0 in no file; give it its
        words, point and direction before it is drawn."""
    @property
    def DimensionStyleName(self) -> str:
        """Gets or sets the name of the dimension style the frame is drawn by (group 3), as AutoCAD's
        DimensionStyleName; Standard where the record gives none."""
    @DimensionStyleName.setter
    def DimensionStyleName(self, value: str) -> None: ...
    @property
    def Direction(self) -> GeoVector3:
        """Gets or sets the direction the rows run in (groups 11, 21, 31), as AutoCAD's Direction: of unit length,
        the world's x where the record gives none."""
    @Direction.setter
    def Direction(self, value: GeoVector3) -> None: ...
    @property
    def GeometricExtents(self) -> GeoAabb3:
        """Gets the box the frame fills, as AutoCAD's GeometricExtents: that of its rows as AutoCAD 2021 lays them
        out (probes GHTQ1 and GHTQ2), each twice the text height high (Dimtxt times Dimscale of
        DxfTolerance.GetDimstyleData), the first about its DxfTolerance.Location, each next under the one before
        on the same left side, each as wide as its cells, a cell its ink and the text height, along its
        DxfTolerance.Direction in the plane of its DxfTolerance.Normal. {\\Fgdt;j}%%v0.1 at (0, 0, 0) in a style
        of Arial 0.18 high is from (0, -0.18, 0) to (0.92296, 0.18, 0), and a frame of no words from (0, -0.18,
        0) to (0, 0.18, 0). The words are measured in the drawing's fonts (DxfDatabase.FontSearchPath), in the
        text style of Dimtxsty, the symbols of the gdt font by the widths AutoCAD gives them. Elsewhere, where a
        cell holds words the fonts do not measure, as DxfEntity.GeometricExtents gives it."""
    @property
    def Location(self) -> GeoPoint3:
        """Gets or sets the insertion point (groups 10, 20, 30), as AutoCAD's Location: in the world, the middle of
        the left side of the first row, where a leader meets the frame; the origin where the record gives none."""
    @Location.setter
    def Location(self, value: GeoPoint3) -> None: ...
    @property
    def Normal(self) -> GeoVector3:
        """Gets or sets the normal of the plane the frame lies in (groups 210, 220, 230), as AutoCAD's Normal: of
        unit length, the world's z where the record gives none."""
    @Normal.setter
    def Normal(self, value: GeoVector3) -> None: ...
    @property
    def Text(self) -> str:
        """Gets or sets the words of the frame (group 1), as AutoCAD's Text: a line feed between rows and %%v
        between cells, the symbols in the gdt font, as the class's remarks set them out; empty where the record
        gives none."""
    @Text.setter
    def Text(self, value: str) -> None: ...
    def GetDimstyleData(self) -> DxfDimStyleTableRecord:
        """Gets the variables the frame is drawn with, as AutoCAD's GetDimstyleData: a new DxfDimStyleTableRecord in
        no table, named as its DxfTolerance.DimensionStyleName, each variable as the frame reads it, its override
        (the list DSTYLE of its extended data of ACAD) where it has one, else its style's, else AutoCAD's own. A
        frame of the style ISO-25 given a text height of 5 gives Dimtxt 5 and Dimgap 0.625, the style's. The
        frame's rows are twice Dimtxt times Dimscale high, in Dimtxsty, its lines in Dimclrd and its words in
        Dimclrt."""

class DxfTransparency(System.ValueType):
    """How much an entity or a layer lets show through it, as AutoCAD's Autodesk.AutoCAD.Colors.Transparency: by
    layer, by block, or an alpha from 0, clear, to 255, solid. An entity writes it as its group 440, a layer in
    its extended data of the application AcCmTransparency, both as AutoCAD writes them, from R2004 (AC1018) on."""
    @overload
    def __init__(self, method: DxfTransparencyMethod) -> None:
        """Initializes a transparency by its method, as AutoCAD's Transparency(TransparencyMethod): BYLAYER or
        BYBLOCK, whose alpha is nought; by alpha, solid, 255."""
    @overload
    def __init__(self, alpha: int) -> None:
        """Initializes a transparency of its own, by alpha, as AutoCAD's Transparency(byte): 0 clear, 255 solid, 127
        the 50 per cent AutoCAD's dialog shows."""
    @property
    def Alpha(self) -> int:
        """Gets the alpha, as AutoCAD's Alpha: 0 clear to 255 solid by alpha; nought by layer or by block."""
    ByBlock: ClassVar[DxfTransparency]
    """Gets the transparency BYBLOCK."""
    ByLayer: ClassVar[DxfTransparency]
    """Gets the transparency BYLAYER."""
    @property
    def IsByAlpha(self) -> bool:
        """Gets whether the transparency is by alpha, as AutoCAD's IsByAlpha."""
    @property
    def IsByBlock(self) -> bool:
        """Gets whether the transparency is BYBLOCK, as AutoCAD's IsByBlock."""
    @property
    def IsByLayer(self) -> bool:
        """Gets whether the transparency is BYLAYER, as AutoCAD's IsByLayer."""
    @property
    def IsClear(self) -> bool:
        """Gets whether the transparency is by alpha and wholly clear, the alpha nought, as AutoCAD's IsClear."""
    @property
    def IsInvalid(self) -> bool:
        """Gets whether the transparency is none AutoCAD writes, as AutoCAD's IsInvalid: one read of a value that is
        no method."""
    @property
    def IsSolid(self) -> bool:
        """Gets whether the transparency is by alpha and solid, the alpha 255, as AutoCAD's IsSolid."""
    @property
    def Method(self) -> DxfTransparencyMethod:
        """Gets how the transparency is given, as AutoCAD's Method does."""
    @overload
    def Equals(self, other: DxfTransparency) -> bool:
        """Gets whether the transparency equals another."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Gets whether the transparency equals an object."""
    def GetHashCode(self) -> int:
        """Gets a hash code of the transparency, the same for two equal ones."""
    def ToString(self) -> str:
        """Gives the transparency as a line: ByLayer, ByBlock, ByAlpha 127 or ErrorValue."""
    def __eq__(self, other: object) -> bool:
        """Gets whether two transparencies are equal."""
    def __hash__(self) -> int: ...
    def __ne__(self, other: object) -> bool:
        """Gets whether two transparencies differ."""

