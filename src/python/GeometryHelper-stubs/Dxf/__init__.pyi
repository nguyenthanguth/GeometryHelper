    def SetAttachmentMovingLocation(self, value: DxfAttachmentPoint) -> None:
        """Holds the MTEXT by another of its points where it stands, as AutoCAD's SetAttachmentMovingLocation: its
        DxfMText.Attachment set and its DxfMText.Location moved to that point of its box, so that the words stay
        where they are. The box is as wide as the group 41 (DxfMText.Width, but a column's before R2018 for an
        MTEXT in columns), the DxfMText.ActualWidth where the MTEXT does not wrap, and DxfMText.ActualHeight
        high, as the file writes them, along its DxfMText.Direction and up from it in its plane: the MTEXT 40
        wide held at its top left at (20, 40, 0), held at its top centre, stands at (40, 40, 0). An annotative
        MTEXT's box is as wide as the context it is read at says (DxfMText.Width), and its location and
        attachment are written as DxfMText.Location and DxfMText.Attachment write them, as AutoCAD 2021 writes
        them: the MTEXT read at (14, 44) at 1:1, 30 wide and held by its middle, held by its middle left, stands
        at (1.01, 36.5), its context of 1:2 left as it was (check D35c)."""
    def SetColumnHeight(self, index: int, height: float) -> None:
        """Sets the height of a column of dynamic columns of their own heights, as AutoCAD's SetColumnHeight: the 46
        of its place in the embedded object from R2018, the 1040 of its place after the 50 of the extended data
        of ACAD before. Columns of one height take the MTEXT's DxfMText.Height instead."""
    def SetContentsRtf(self, value: str) -> int:
        """Sets the words of the MTEXT from a document of RTF, as AutoCAD's SetContentsRtf: its words, with the
        codes of an MTEXT for what it sets that an MTEXT has, each written where the words take it on or off."""
    def SetDynamicColumns(self, width: float, gutter: float, autoHeight: bool) -> None:
        """Sets the MTEXT in dynamic columns, as AutoCAD's SetDynamicColumns: columns as wide as given, a gutter
        between them, which AutoCAD fills with the words as they flow; all as high as the MTEXT's DxfMText.Height
        where their height is automatic, else each of its own, given the MTEXT's DxfMText.Height to start with
        and set by DxfMText.SetColumnHeight. The count of columns is kept, 1 where the MTEXT had none; written as
        DxfMText.ColumnType says, the MTEXT's DxfMText.Width made to agree, as DxfMText.SetStaticColumns makes
        it: that of the columns the MTEXT counts, as AutoCAD counts those the words fill only as it lays them
        out."""
    def SetStaticColumns(self, width: float, gutter: float, count: int) -> None:
        """Sets the MTEXT in static columns, as AutoCAD's SetStaticColumns: as many columns as given, each as wide
        as given and as high as the MTEXT's DxfMText.Height, a gutter between them; written as
        DxfMText.ColumnType says, the MTEXT's group 41 (and 40 of its embedded object) made the width of all the
        columns with their gutters from R2018, and a column's before it, as AutoCAD 2021 writes it: two columns
        50 wide with a gutter of 10 give an MTEXT of R2018 41 110, and one of R2007 or R2000 41 50, each read as
        110 wide (DxfMText.Width). Three columns 12.5 wide with gutters of 2.5 take 42.5 across."""

