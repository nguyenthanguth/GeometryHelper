class DxfTextStyleTableRecord(DxfSymbolTableRecord):
    """A text style of a DXF file, as AutoCAD's TextStyleTableRecord, read from its STYLE record: its name, its
    font, its height, width and slant."""
    def __init__(self) -> None:
        """Initializes a style made in code, to be added to a DxfTextStyleTable with its DxfSymbolTableRecord.Name
        given."""
    @property
    def BigFontFileName(self) -> str:
        """Gets or sets the file of the style's big font (group 4), as AutoCAD's BigFontFileName; empty where the
        record gives none. Where the drawing's DxfDatabase.FontSearchPath finds it, the letters of the style's
        texts are measured in it beside the style's font, as that says: gbcbig.shx's 中 4 high 2.912 wide."""
    @BigFontFileName.setter
    def BigFontFileName(self, value: str) -> None: ...
    @property
    def FileName(self) -> str:
        """Gets or sets the file of the style's font (group 3), as AutoCAD's FileName: romans.shx, arial.ttf; empty
        where the record gives none."""
    @FileName.setter
    def FileName(self, value: str) -> None: ...
    @property
    def FlagBits(self) -> int:
        """Gets or sets the flags of the style's text generation (group 71), as AutoCAD's FlagBits: 2 backwards, 4
        upside down."""
    @FlagBits.setter
    def FlagBits(self, value: int) -> None: ...
    @property
    def Font(self) -> DxfFontDescriptor:
        """Gets or sets the TrueType font of the style, as AutoCAD's Font: from the style's extended data of the
        application ACAD, its typeface (1000) and its flags (1071), as DxfFontDescriptor says; a font of no
        typeface where it has none, as a style of an SHX font."""
    @Font.setter
    def Font(self, value: DxfFontDescriptor) -> None: ...
    @property
    def IsShapeFile(self) -> bool:
        """Gets whether the style is of shapes, not letters (flag 1 of group 70), as AutoCAD's IsShapeFile."""
    @property
    def IsVertical(self) -> bool:
        """Gets or sets whether the style's texts run down (flag 4 of group 70), as AutoCAD's IsVertical."""
    @IsVertical.setter
    def IsVertical(self, value: bool) -> None: ...
    @property
    def ObliquingAngle(self) -> float:
        """Gets or sets the slant of the style's letters (group 50) in radians, as AutoCAD's ObliquingAngle: the
        record writes degrees, so 0.2618 radians is written as 15."""
    @ObliquingAngle.setter
    def ObliquingAngle(self, value: float) -> None: ...
    @property
    def PriorSize(self) -> float:
        """Gets the height last used with the style (group 42), as AutoCAD's PriorSize: 2.5 for a style made in
        code."""
    @property
    def TextSize(self) -> float:
        """Gets or sets the fixed height of the style's texts (group 40), as AutoCAD's TextSize: nought where each
        text gives its own."""
    @TextSize.setter
    def TextSize(self, value: float) -> None: ...
    @property
    def XScale(self) -> float:
        """Gets or sets how wide the style's letters are for their height (group 41), as AutoCAD's XScale: 1 where
        the record gives none."""
    @XScale.setter
    def XScale(self, value: float) -> None: ...
    def Erase(self) -> None:
        """Erases the style from its table, as AutoCAD's Erase of a text style nothing is written in: its STYLE
        record taken out, the table's count lowered by one, its handle not given again."""

class DxfTextSymbols(System.Object):
    """The symbols AutoCAD 2021's text editor enters from its Symbol menu, each the letter it stands for, and the
    three control codes of that menu, to be put into the words of a TEXT, an MTEXT, an attribute or a dimension
    without remembering a code: new DxfMText { Contents = DxfTextSymbols.Diameter + \"20\" } reads ∅20. The
    letters are those of AutoCAD's help, \"Text Symbols and Special Characters Reference\", and of its menu, and
    nothing else. Each is written as AutoCAD writes it: as it is in a drawing of R2007 or later, and before,
    where the code page has not the letter, as its escape, so that ∅20 in an MTEXT of R2004 is \\U+220520.
    Written by the library into an MTEXT, a TEXT, an attribute and a dimension of R2004 and of R2018, each of the
    21 was read back by AutoCAD 2021 as the same letter, in its Contents, Text, TextString and DimensionText
    alike, and AutoCAD wrote its own texts of them in the same bytes. A letter shows only in a font that has it:
    AutoCAD's help names simplex, romans, gdt, amgdt, isocp and isoct among the SHX fonts, and isocpeur and
    isocteur among the TrueType."""
    AlmostEqual: ClassVar[str]
    """The sign almost equal to, ≈, U+2248: AlmostEqual + \"3.14\" is ≈3.14."""
    Angle: ClassVar[str]
    """The angle sign, ∠, U+2220: Angle + \"45\" + Degree is ∠45°."""
    BoundaryLine: ClassVar[str]
    """The boundary line of a survey, U+E100, a letter of AutoCAD's own fonts in the private range, which no other
    font is sure to have."""
    CenterLine: ClassVar[str]
    """The centre line sign, ℄, U+2104: CenterLine + \"A\" marks the centre line A."""
    Cubed: ClassVar[str]
    """The superscript three, ³, U+00B3: \"5 m\" + Cubed is 5 m³. A letter of ANSI_1252, so a new drawing of any
    version holds it as it is."""
    Degree: ClassVar[str]
    """The degree sign, °, U+00B0: \"45\" + Degree is 45°. A letter of the code page ANSI_1252, so a new drawing of
    any version holds it as it is."""
    DegreeCode: ClassVar[str]
    """The control code of the degree sign, %%d, which AutoCAD draws as DxfTextSymbols.Degree in a TEXT, an
    attribute, a dimension and an MTEXT. The words keep it as written: a TEXT's TextString and an MTEXT's
    Contents of 45%%d are 45%%d, and the MTEXT's Text is 45°, in AutoCAD 2021 and in DxfMText.Text alike, as
    DxfReader reads either."""
    Delta: ClassVar[str]
    """The capital delta, Δ, U+0394: Delta + \"L\" is ΔL."""
    Diameter: ClassVar[str]
    """The diameter sign, ∅, U+2205, the letter AutoCAD's Symbol menu enters for a diameter and its help lists for
    %%c; not Ø, U+00D8, a Latin letter, nor ⌀, U+2300. Diameter + \"20\" is written into an MTEXT or a TEXT of
    R2004 as \\U+220520 and of R2018 as the bytes E2 88 85 and 20, and reads back as ∅20 from both, in AutoCAD
    2021 and in the library."""
    DiameterCode: ClassVar[str]
    """The control code of the diameter sign, %%c, which AutoCAD draws as the diameter sign where
    DxfTextSymbols.DegreeCode draws a degree, kept in the words as written in the same way: a TEXT's TextString
    of %%c20 is %%c20. AutoCAD 2021 gives the Text of an MTEXT of %%c20 as ∅20, the letter
    DxfTextSymbols.Diameter, and DxfMText.Text and DxfReader read it so too, in an MTEXT and a TEXT."""
    ElectricalPhase: ClassVar[str]
    """The electrical phase sign, ɸ, U+0278."""
    FlowLine: ClassVar[str]
    """The flow line, U+E101, a letter of AutoCAD's own fonts in the private range, which no other font is sure to
    have."""
    Identity: ClassVar[str]
    """The sign identical to, ≡, U+2261."""
    InitialLength: ClassVar[str]
    """The initial length sign, the arc over the length of an arc's dimension, U+E200, a letter of AutoCAD's own
    fonts in the private range: AutoCAD's help names simplex, romans, gdt, amgdt and isocpeur as the fonts that
    have it."""
    MonumentLine: ClassVar[str]
    """The monument line of a survey, U+E102, a letter of AutoCAD's own fonts in the private range, which no other
    font is sure to have."""
    NonBreakingSpace: ClassVar[str]
    """The space a line is not broken at, U+00A0, which AutoCAD's menu enters with Ctrl+Shift+Space: \"M16\" +
    NonBreakingSpace + \"x 40\" keeps M16 with its length. A letter of ANSI_1252, so a new drawing of any version
    holds it as it is, in a TEXT as in an MTEXT. In an MTEXT the code DxfMText.NonBreakSpace, \\~, is one too,
    which AutoCAD 2021 gives as this letter in an MTEXT's Text, and DxfMText.Text and DxfReader read it so too."""
    NotEqual: ClassVar[str]
    """The sign not equal to, ≠, U+2260: \"a\" + NotEqual + \"b\" is a≠b."""
    Ohm: ClassVar[str]
    """The ohm sign, Ω, U+2126, the unit: \"50\" + Ohm is 50Ω. Not DxfTextSymbols.Omega, the Greek letter."""
    Omega: ClassVar[str]
    """The capital omega, Ω, U+03A9, the Greek letter. Not DxfTextSymbols.Ohm, the unit."""
    PlusMinus: ClassVar[str]
    """The plus-minus sign, ±, U+00B1: PlusMinus + \"0.5\" is ±0.5. A letter of ANSI_1252, so a new drawing of any
