    @ViewTarget.setter
    def ViewTarget(self, value: GeoPoint3) -> None: ...
    @property
    def Width(self) -> float:
        """Gets or sets the width of the viewport on its sheet (group 40), as AutoCAD's Width."""
    @Width.setter
    def Width(self, value: float) -> None: ...
    def ClipTo(self, boundary: DxfEntity) -> None:
        """Clips the viewport to a closed entity of its layout, as the VPCLIP command does with an object: the
        viewport shows model space only inside the boundary, and its frame becomes the box of the boundary, its
        view kept in place. A viewport 100 by 80 about (100, 100) at 1:2 clipped to a circle of radius 30 about
        (110, 105) is 60 by 60 about (110, 105), the model point at its centre now the one that lay 10 right and
        5 above, 20 and 10 in model units. The boundary stays the entity it is, with the viewport among its
        reactors (102 {ACAD_REACTORS), as AutoCAD writes it; the boundary the viewport had before stays an entity
        of the layout, let go. A region is a boundary as it is: one of a ring (a circle of radius 40 less one of
        15) makes the frame 80 by 80, the box of its outer loop, and shows nothing in the hole, and one of two
        squares apart has a frame round both."""
    def Erase(self) -> None:
        """Erases the viewport, as DxfEntity.Erase erases an entity, and takes the overrides the layers keep for it
        out of their extension dictionaries, as AutoCAD does: an XRECORD of overrides left with none goes with
        its entry. A layout whose last active viewport it was (group 331 of its LAYOUT) names its viewport 1
        instead, as AutoCAD 2021 does, or none where it has no other. The viewport of id 1 (group 69) of a layout
        of paper space, which shows the sheet itself, is refused, as AutoCAD keeps it."""
    def FitToClip(self) -> bool:
        """Fits the frame of the viewport to the box of its clip boundary again, as AutoCAD does when the boundary
        is moved, scaled, stretched or turned: the frame is the box of the boundary, and the view keeps its scale
        and its place, so that a boundary moved 10 to the right takes the viewport 10 to the right showing what
        it showed. Nothing for a viewport that is not clipped, and nothing where the frame is already the box."""
    def FreezeLayersInViewport(self, layers: System.Collections.Generic.IEnumerable[DxfLayerTableRecord]) -> None:
        """Freezes layers in the viewport, as AutoCAD's FreezeLayersInViewport: each not frozen in it yet named
        after those that are, by its handle (331), or by its name in the extended data of a file older than
        R2000; nothing where all are."""
    def GetFrozenLayers(self) -> System.Collections.Generic.IReadOnlyList[DxfLayerTableRecord]:
        """Gets the layers frozen in the viewport, as AutoCAD's GetFrozenLayers gives their ids: those its groups
        331 name by handle (341 in a DXF of R2000, the names of its extended data in a file older than R2000)
        that the layer table has, in their order."""
    def GetUcs(self) -> tuple[GeoPoint3, GeoVector3, GeoVector3]:
        """Gives the user coordinate system of the viewport as the record holds it, as AutoCAD's GetUcs: its origin
        and its axes x and y, not made of unit length; the world's where the record gives none, or its axes are
        of no length or along one line."""
    def IsLayerFrozenInViewport(self, layer: DxfLayerTableRecord) -> bool:
        """Gets whether a layer is frozen in the viewport, as AutoCAD's IsLayerFrozenInViewport."""
    def RemoveClip(self) -> None:
        """Takes the clip off the viewport, as the Delete of VPCLIP does: the boundary is erased, the link and the
        flag go, and the frame stays the box the boundary had. Nothing for a viewport that is not clipped."""
    def SetShadePlot(self, type: DxfShadePlotType, shadePlot: DxfDBObject) -> None:
        """Sets how the viewport is shaded when plotted, as AutoCAD's SetShadePlot: the type (group 170) and the
        visual style or preset of rendering it names (333), taken out for a type that names none."""
    def SetSun(self, sun: DxfSun) -> DxfSun:
        """Lights the viewport by a sun, as AutoCAD's SetSun: the sun made in code written at the end of the OBJECTS
        section, owned by the viewport, which names it (group 361), and the class SUN listed in the CLASSES
        section where it is not; the sun it had erased where the viewport owned it, as AutoCAD erases the old
        sun, and kept where another owns it. viewport.SetSun(new DxfSun { Intensity = 1.5 }) gives a viewport
        AutoCAD's sun half as bright again."""
    @overload
    def SetUcs(self, view: DxfOrthographicView) -> None:
        """Gives the viewport the user coordinate system of a view along an axis, as AutoCAD's SetUcs of an
        OrthographicView: about the world's origin, its plane that of the view, top (x along x, y along y),
        bottom (x, -y), front (x, z), back (-x, z), left (-y, z) or right (y, z); its view written (79), its base
        the world (346 taken out)."""
    @overload
    def SetUcs(self, origin: GeoPoint3, x: GeoVector3, y: GeoVector3) -> None:
        """Gives the viewport a user coordinate system of its own, as AutoCAD's SetUcs of an origin and two axes:
        they are written as given, the system named by none (345 and 346 taken out) and along no axis (79 of 0)."""
    def SetUcsToWorld(self) -> None:
        """Gives the viewport the world's coordinate system, as AutoCAD's SetUcsToWorld: as DxfViewport.SetUcs of
        the origin and the axes x and y."""
    def SetViewDirection(self, view: DxfOrthographicView) -> None:
        """Points the view along an axis, as AutoCAD's SetViewDirection: from above (0, 0, 1), below (0, 0, -1), the
        front (0, -1, 0), the back (0, 1, 0), the left (-1, 0, 0) or the right (1, 0, 0)."""
    def ThawAllLayersInViewport(self) -> None:
        """Thaws every layer in the viewport, as AutoCAD's ThawAllLayersInViewport; nothing where none is frozen in
        it."""
    def ThawLayersInViewport(self, layers: System.Collections.Generic.IEnumerable[DxfLayerTableRecord]) -> None:
        """Thaws layers in the viewport, as AutoCAD's ThawLayersInViewport; nothing for one not frozen in it."""
    def ToString(self) -> str:
        """Gives the viewport as a line for debugging: its type, handle, id and size."""

class DxfViewportTable(DxfSymbolTable):
    """The VPORT table of a DXF file, as AutoCAD's ViewportTable: the tiled viewports of model space, each a
    DxfViewportTableRecord, in the order of the file, found by name. The viewport model space is shown through is
    the first named *Active, db.ViewportTable[\"*Active\"]; a configuration saved by VPORTS Save is named as it
    was saved."""
    def __getitem__(self, key: str) -> DxfViewportTableRecord:
        """Gets the viewport of a name, letters of either case the same: the first of them where several share it,
        as the *Active viewports of a model space split in tiles do."""
    def GetEnumerator(self) -> System.Collections.Generic.IEnumerator[DxfViewportTableRecord]:
        """Gets an enumerator over the viewports, in the order of the file."""
    def __iter__(self) -> Iterator[DxfViewportTableRecord]: ...

class DxfViewportTableRecord(DxfSymbolTableRecord):
    """A tiled viewport of model space, as AutoCAD's ViewportTableRecord, read from its VPORT record: the snap and
    the grid AutoCAD keeps there for the drawing, SNAPMODE, GRIDMODE, SNAPUNIT, GRIDUNIT, SNAPBASE, SNAPANG,
    SNAPSTYL, SNAPISOPAIR, GRIDDISPLAY and GRIDMAJOR of the *Active viewport."""
    @property
    def GridDisplay(self) -> int:
        """Gets or sets how the grid is shown (group 60), as AutoCAD's GRIDDISPLAY: 1 beyond the limits, 2 adaptive,
        4 subdivided below its spacing when zoomed in, 8 following the dynamic UCS; 3 where the record gives
        none, as AutoCAD 2021 reads such a drawing. The group came with R2007 (AC1021)."""
    @GridDisplay.setter
    def GridDisplay(self, value: int) -> None: ...
    @property
    def GridEnabled(self) -> bool:
        """Gets or sets whether the grid is shown (group 76 of 1), as AutoCAD's GridEnabled and GRIDMODE; off where
        the record gives none."""
    @GridEnabled.setter
    def GridEnabled(self, value: bool) -> None: ...
    @property
    def GridIncrements(self) -> GeoVector2:
        """Gets or sets the spacing of the grid across and up (groups 15 and 25), as AutoCAD's GridIncrements and
        GRIDUNIT; 10 by 10 where the record gives none. Nought along an axis takes the snap's spacing there, as
        GRIDUNIT of nought does."""
    @GridIncrements.setter
    def GridIncrements(self, value: GeoVector2) -> None: ...
    @property
    def GridMajor(self) -> int:
        """Gets or sets how many minor lines of the grid go to a major one (group 61), as AutoCAD's GridMajor and
        GRIDMAJOR; 5 where the record gives none, as AutoCAD 2021 reads such a drawing. The group came with R2007
        (AC1021)."""
    @GridMajor.setter
    def GridMajor(self, value: int) -> None: ...
    @property
    def IsometricSnapEnabled(self) -> bool:
        """Gets or sets whether the snap is isometric (group 77 of 1), as AutoCAD's IsometricSnapEnabled and
        SNAPSTYL of 1; rectangular where the record gives none."""
    @IsometricSnapEnabled.setter
    def IsometricSnapEnabled(self, value: bool) -> None: ...
    @property
    def SnapAngle(self) -> float:
        """Gets or sets the angle the snap and the grid are turned by (group 50, written in degrees), as AutoCAD's
        SnapAngle and SNAPANG, in radians; nought where the record gives none."""
    @SnapAngle.setter
    def SnapAngle(self, value: float) -> None: ...
    @property
    def SnapBase(self) -> GeoPoint2:
        """Gets or sets the point the snap and the grid are laid from (groups 13 and 23), as AutoCAD's SnapBase and
        SNAPBASE; the origin where the record gives none."""
    @SnapBase.setter
    def SnapBase(self, value: GeoPoint2) -> None: ...
    @property
    def SnapEnabled(self) -> bool:
        """Gets or sets whether the snap is on (group 75 of 1), as AutoCAD's SnapEnabled and SNAPMODE; off where the
        record gives none."""
    @SnapEnabled.setter
    def SnapEnabled(self, value: bool) -> None: ...
    @property
    def SnapIncrements(self) -> GeoVector2:
        """Gets or sets the spacing of the snap across and up (groups 14 and 24), as AutoCAD's SnapIncrements and
        SNAPUNIT; 10 by 10 where the record gives none."""
    @SnapIncrements.setter
    def SnapIncrements(self, value: GeoVector2) -> None: ...
    @property
    def SnapPair(self) -> int:
        """Gets or sets the isometric plane the snap works in (group 78), as AutoCAD's SnapPair and SNAPISOPAIR: 0
        left, 1 top, 2 right; 0 where the record gives none."""
    @SnapPair.setter
    def SnapPair(self, value: int) -> None: ...

class DxfWipeout(DxfRasterImage):
    """A WIPEOUT of a DXF file, as AutoCAD's Wipeout: a mask that hides what is drawn under it in the colour of the
    background, an image of one pixel with no picture, clipped by the polygon it hides. Under the words of a tag
    of a Tekla or AutoCAD drawing it is moved, copied and mirrored with them."""
    def __init__(self) -> None:
        """Initializes a wipeout made in code, as AutoCAD's new Wipeout(): of no polygon yet, to be given one by
        DxfWipeout.SetFrom before it is appended, as AutoCAD 2021 writes a wipeout never set as one of no
        boundary and then cannot open the drawing. Its groups are those AutoCAD 2021 writes: a frame of one
        pixel, shown and clipped (70 of 7, 280 of 1), no IMAGEDEF (340 of 0). Appended, it lists the variables of
        wipeouts (ACAD_WIPEOUT_VARS) in a drawing that has none."""
    def SetFrom(self, points: System.Collections.Generic.IReadOnlyList[GeoPoint2], normal: GeoVector3) -> None:
        """Hides a polygon anew, as AutoCAD 2021's SetFrom: its corners in the plane of a normal, in the system of
        that normal (the arbitrary axis algorithm, the world's xy for (0, 0, 1)), the first again at the end. As
        AutoCAD 2021 writes it, the frame is the square on the box of the corners and the origin of the plane,
        its side the box's longer: the rectangle (-30, -10) to (10, 20) has the frame of side 40 at (-30, -10,
        0), the rectangle (200, 100) to (230, 110) the frame of side 230 at the origin. The corners are written
        in the frame as a polygon, the record said to be clipped (280 of 1)."""

class DxfWipeoutVariables(DxfDBObject):
    """The WIPEOUTVARIABLES of a DXF file, as AutoCAD keeps what WIPEOUTFRAME sets: whether the frames of the
    wipeouts are shown, the entry ACAD_WIPEOUT_VARS of the named object dictionary, which AutoCAD 2021 writes
    once a drawing holds a wipeout or WIPEOUT Frames is first used (DxfWipeoutVariables.GetWipeoutVariables):
    db.NamedObjectsDictionary.GetAt(\"ACAD_WIPEOUT_VARS\")."""
    @property
    def ShowFrames(self) -> bool:
        """Gets or sets whether the frames of the wipeouts are shown (group 70): true for any number but 0, and
        where the record gives none, as AutoCAD 2021 reads it."""
    @ShowFrames.setter
    def ShowFrames(self, value: bool) -> None: ...
    @staticmethod
    def GetWipeoutVariables(database: DxfDatabase) -> DxfWipeoutVariables:
        """Gets the variables of wipeouts of a drawing: its entry ACAD_WIPEOUT_VARS, made where it has none, as
        AutoCAD 2021 makes it when a wipeout is first made or WIPEOUT Frames first used: frames shown (70 of 1),
        the class WIPEOUTVARIABLES listed and counted."""
    def ToString(self) -> str:
        """Gives the variables as a line for debugging: their type, their handle and whether the frames show."""

class DxfWriter(System.Object):
    """Writes shapes as a DXF file of version R2000 (AC1015), which AutoCAD, Tekla Structures and every CAD viewer
    open."""
    def __init__(self) -> None: ...
    @overload
    def Add(self, entity: DxfShape) -> DxfWriter:
        """Adds an entity DxfReader read: its shape, written by the overload of Add for it, on its layer, and in its
        colour, true colour, linetype and lineweight and with its thickness, each written only where the entity
        has one."""
    @overload
    def Add(self, text: DxfText, layer: str = ...) -> DxfWriter:
        """Adds a text: a TEXT of one line, or an MTEXT where it is multiline, in the plane of its normal."""
    @overload
    def Add(self, box: GeoAabb3, layer: str = ...) -> DxfWriter:
        """Adds a box as six 3DFACEs of four corners, written from its corners with no tolerance, so a box as flat
        as 100 by 100 by 0.002, or by nothing, is written and not refused."""
    @overload
    def Add(self, arc: GeoArc2, layer: str = ...) -> DxfWriter:
        """Adds an arc, written counter-clockwise from its start angle to its end angle; a clockwise one from its
        end to its start, so that it covers the same points."""
    @overload
    def Add(self, arc: GeoArc3, layer: str = ...) -> DxfWriter:
        """Adds an arc in space as the ARC it is, in the coordinate system of its own plane, with no chords."""
    @overload
    def Add(self, circle: GeoCircle2, layer: str = ...) -> DxfWriter:
        """Adds a circle."""
    @overload
    def Add(self, circle: GeoCircle3, layer: str = ...) -> DxfWriter:
        """Adds a circle in space as the CIRCLE it is, in the coordinate system of its own plane, with no chords."""
    @overload
    def Add(self, ellipse: GeoEllipse2, layer: str = ...) -> DxfWriter:
        """Adds an ellipse, whole, as an ELLIPSE with its centre, the end of its major axis, and the ratio of its
        minor radius to its major."""
    @overload
    def Add(self, ellipse: GeoEllipse3, layer: str = ...) -> DxfWriter:
        """Adds an ellipse in space, whole, as an ELLIPSE with its normal as the extrusion and its major axis in
        world coordinates."""
    @overload
    def Add(self, face: GeoFace2, layer: str = ...) -> DxfWriter:
        """Adds a face as a closed lightweight polyline for its boundary and one for each hole, all on the layer
        given and none filled."""
    @overload
    def Add(self, face: GeoFace3, layer: str = ...) -> DxfWriter:
        """Adds a face as a 3DFACE for each triangle of its surface, holes left open and the edges between its
        triangles invisible."""
    @overload
    def Add(self, line: GeoLine2, layer: str = ...) -> DxfWriter:
        """Adds a segment."""
    @overload
    def Add(self, line: GeoLine3, layer: str = ...) -> DxfWriter:
        """Adds a segment in space."""
    @overload
    def Add(self, box: GeoObb3, layer: str = ...) -> DxfWriter:
        """Adds an oriented box as six 3DFACEs of four corners, written from its corners with no tolerance, so a box
        as flat as 100 by 100 by 0.002, or by nothing, is written and not refused."""
    @overload
    def Add(self, point: GeoPoint2, layer: str = ...) -> DxfWriter:
        """Adds a point."""
    @overload
    def Add(self, point: GeoPoint3, layer: str = ...) -> DxfWriter:
        """Adds a point in space."""
    @overload
    def Add(self, polygon: GeoPolygon2, layer: str = ...) -> DxfWriter:
        """Adds a polygon as a closed lightweight polyline."""
    @overload
    def Add(self, polygon: GeoPolygon3, layer: str = ...) -> DxfWriter:
        """Adds a polygon in space as a closed 3D polyline."""
    @overload
    def Add(self, loop: GeoPolygonArc2, layer: str = ...) -> DxfWriter:
        """Adds a loop with arcs as a closed lightweight polyline, each arc edge carrying its bulge."""
    @overload
    def Add(self, loop: GeoPolygonArc3, layer: str = ...) -> DxfWriter:
        """Adds a loop with arcs in space as one closed lightweight polyline in its plane, each arc edge carrying
        its bulge."""
    @overload
    def Add(self, polyline: GeoPolyline2, layer: str = ...) -> DxfWriter:
        """Adds a chain as an open lightweight polyline."""
    @overload
    def Add(self, polyline: GeoPolyline3, layer: str = ...) -> DxfWriter:
        """Adds a chain in space as an open 3D polyline."""
    @overload
    def Add(self, chain: GeoPolylineArc2, layer: str = ...) -> DxfWriter:
        """Adds a chain with arcs as an open lightweight polyline, each arc edge carrying its bulge."""
    @overload
    def Add(self, chain: GeoPolylineArc3, layer: str = ...) -> DxfWriter:
        """Adds a chain with arcs in space as it is: one lightweight polyline in its plane where it lies in one, and
        a LINE or an ARC for each edge where it does not. The plane is judged at the global tolerance;
        DxfWriter.Add states it."""
    @overload
    def Add(self, ray: GeoRay2, layer: str = ...) -> DxfWriter:
        """Adds a ray, which AutoCAD draws without end from its origin."""
    @overload
    def Add(self, ray: GeoRay3, layer: str = ...) -> DxfWriter:
        """Adds a ray in space, which AutoCAD draws without end from its origin."""
    @overload
    def Add(self, rectangle: GeoRectangle2, layer: str = ...) -> DxfWriter:
        """Adds a rectangle as a closed lightweight polyline of its four corners."""
    @overload
    def Add(self, solid: GeoSolid3, layer: str = ...) -> DxfWriter:
        """Adds a body as a 3DFACE for each triangle of the surface where its material ends, openings cut in and the
        edges between the triangles of one side invisible. A box 100 by 100 by 20 with a hole 20 by 20 through it
        is 64 triangles."""
    @overload
    def Add(self, spline: GeoSpline2, layer: str = ...) -> DxfWriter:
        """Adds a spline as the SPLINE it is, at height nought: its degree, its knots, its weights where it is
        rational and its control points, as the spline holds them."""
    @overload
    def Add(self, spline: GeoSpline3, layer: str = ...) -> DxfWriter:
        """Adds a spline in space as the SPLINE it is: its degree, its knots, its weights where it is rational and
        its control points in world coordinates, as the spline holds them."""
    @overload
    def Add(self, triangle: GeoTriangle2, layer: str = ...) -> DxfWriter:
        """Adds a triangle as a closed lightweight polyline of its three corners."""
    @overload
    def Add(self, triangle: GeoTriangle3, layer: str = ...) -> DxfWriter:
        """Adds a triangle as a 3DFACE, every edge visible."""
    @overload
    def Add(self, xline: GeoXLine2, layer: str = ...) -> DxfWriter:
        """Adds a line without ends in the plane, which AutoCAD draws as an XLINE running both ways from its
        origin."""
    @overload
    def Add(self, xline: GeoXLine3, layer: str = ...) -> DxfWriter:
        """Adds a line without ends in space, which AutoCAD draws as an XLINE running both ways from its origin."""
    @overload
    def Add(self, mesh: GeoMesh3, layer: str = ...) -> DxfWriter:
        """Adds a mesh of a flat shape: a face of three or four corners that turns right at none of them as one
        3DFACE, so that the cells of a grid stay cells, and any other face as its triangles with the edges
        between them invisible."""
    @overload
    def Add(self, triangles: System.Collections.Generic.IEnumerable[GeoTriangle3], layer: str = ...) -> DxfWriter:
        """Adds triangles, each as a 3DFACE with every edge visible."""
    @overload
    def Add(self, arc: GeoArc3, chordTolerance: float, layer: str = ...) -> DxfWriter:
        """Adds an arc in space as an open 3D polyline of chords no further from the arc than a tolerance."""
    @overload
    def Add(self, circle: GeoCircle3, chordTolerance: float, layer: str = ...) -> DxfWriter:
        """Adds a circle in space as a closed 3D polyline of chords no further from the circle than a tolerance."""
    @overload
    def Add(self, face: GeoFace3, tolerance: Tolerance, layer: str = ...) -> DxfWriter:
        """Adds a face as a 3DFACE for each triangle of its surface, cut within a tolerance, the edges between its
        triangles invisible."""
    @overload
    def Add(self, loop: GeoPolygonArc3, chordTolerance: float, layer: str = ...) -> DxfWriter:
        """Adds a loop with arcs in space as a closed 3D polyline, its straight edges kept and each arc cut into
        chords no further from it than a tolerance."""
    @overload
    def Add(self, chain: GeoPolylineArc3, tolerance: Tolerance, layer: str = ...) -> DxfWriter:
        """Adds a chain with arcs in space as it is: one lightweight polyline in its plane where it lies in one, and
        a LINE or an ARC for each edge where it does not."""
    @overload
    def Add(self, chain: GeoPolylineArc3, chordTolerance: float, layer: str = ...) -> DxfWriter:
        """Adds a chain with arcs in space as an open 3D polyline, its straight edges kept and each arc cut into
        chords no further from it than a tolerance."""
    @overload
    def Add(self, solid: GeoSolid3, tolerance: Tolerance, layer: str = ...) -> DxfWriter:
        """Adds a body as a 3DFACE for each triangle of its surface, cut within a tolerance, the edges between the
        triangles of one side invisible."""
    @overload
    def Add(self, sphere: GeoSphere3, chordTolerance: float, layer: str = ...) -> DxfWriter:
        """Adds a ball as a 3DFACE for each triangle of its surface, cut no further than a tolerance from the
        sphere, every edge visible."""
    def Save(self, path: str) -> None:
        """Writes the file to a path, replacing whatever is there."""
    def ToString(self) -> str:
        """Gets the file as text."""
    def WriteTo(self, writer: System.IO.TextWriter) -> None:
        """Writes the file to a writer."""

class DxfXline(DxfCurve):
    """An XLINE of a DXF file, as AutoCAD's Xline: the line without ends through DxfXline.BasePoint along
    DxfXline.UnitDir, both ways, in world coordinates."""
    def __init__(self) -> None:
        """Initializes an xline through the origin along the x axis, as AutoCAD's new Xline(), on layer 0 in no
        file; give it its base point and direction before it is drawn."""
    @property
    def Area(self) -> float:
        """Gets nought: an xline closes no area."""
    @property
    def BasePoint(self) -> GeoPoint3:
        """Gets or sets the point the xline is placed by (groups 10, 20, 30), in world coordinates, as AutoCAD's
        BasePoint; the origin where the record gives none."""
    @BasePoint.setter
    def BasePoint(self, value: GeoPoint3) -> None: ...
    @property
    def Closed(self) -> bool:
        """Gets false: an xline is not closed."""
    @property
    def EndParam(self) -> float:
        """Gets the parameter at the end of the xline: infinite, as it runs without end."""
    @property
    def EndPoint(self) -> GeoPoint3:
        """Refuses: an xline runs without end both ways, and has no end point, as AutoCAD's has none."""
    @EndPoint.setter
    def EndPoint(self, value: GeoPoint3) -> None: ...
    @property
    def SecondPoint(self) -> GeoPoint3:
        """Gets or sets a second point of the xline, as AutoCAD's SecondPoint: the base point and the direction;
        set, the direction is made the way from the base point to it."""
    @SecondPoint.setter
    def SecondPoint(self, value: GeoPoint3) -> None: ...
    @property
    def StartParam(self) -> float:
        """Gets the parameter at the start of the xline: minus infinity, as it runs without end behind its base
        point."""
    @property
    def StartPoint(self) -> GeoPoint3:
        """Refuses: an xline runs without end both ways, and has no start point, as AutoCAD's has none."""
    @StartPoint.setter
    def StartPoint(self, value: GeoPoint3) -> None: ...
    @property
    def UnitDir(self) -> GeoVector3:
        """Gets or sets the direction of the xline (groups 11, 21, 31), as AutoCAD's UnitDir: as the file holds it,
        of unit length in a file AutoCAD wrote; (0, 0, 1) where the record gives none."""
    @UnitDir.setter
    def UnitDir(self, value: GeoVector3) -> None: ...
    @overload
    def Extend(self, newParameter: float) -> None:
        """Refuses, as AutoCAD does: an xline runs without end both ways and has no end to be extended."""
    @overload
    def Extend(self, extendStart: bool, toPoint: GeoPoint3) -> None:
        """Refuses, as AutoCAD does: an xline runs without end both ways and has no end to be extended."""
    def GetClosestPointTo(self, givenPoint: GeoPoint3, extend: bool) -> GeoPoint3:
        """Gets the point of the xline nearest a point, as AutoCAD's GetClosestPointTo: the foot of the point on
        it."""
    def GetDistAtPoint(self, point: GeoPoint3) -> float:
        """Gets the distance from the base point to a point of the xline, below nought behind it."""
    def GetDistanceAtParameter(self, value: float) -> float:
        """Gets the distance from the base point at a parameter: the parameter itself, below nought behind the base
        point."""
    def GetFirstDerivative(self, value: float) -> GeoVector3:
        """Gets the derivative of the xline at a parameter, as AutoCAD's GetFirstDerivative: its direction made of
        unit length."""
    def GetOffsetCurves(self, offsetDist: float) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Refuses: an xline has no plane of its own to be offset in; DxfXline.GetOffsetCurvesGivenPlaneNormal takes
        one."""
    def GetOffsetCurvesGivenPlaneNormal(
        self,
        planeNormal: GeoVector3,
        offsetDist: float,
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the xline at a distance from this one in the plane of a normal, as AutoCAD's
        GetOffsetCurvesGivenPlaneNormal: to the left of its direction seen from the tip of the normal where the
        distance is above nought, as a DxfLine is offset, AutoCAD 2021's side for a line."""
    def GetParameterAtDistance(self, dist: float) -> float:
        """Gets the parameter at a distance from the base point: the distance itself."""
    def GetParameterAtPoint(self, point: GeoPoint3) -> float:
        """Gets the parameter at a point of the xline, the distance from the base point along the direction, as
        AutoCAD's GetParameterAtPoint."""
    def GetPointAtDist(self, value: float) -> GeoPoint3:
        """Gets the point at a distance from the base point, below nought behind it."""
    def GetPointAtParameter(self, value: float) -> GeoPoint3:
        """Gets the point at a parameter, the distance from the base point along the direction, as AutoCAD's
        GetPointAtParameter."""
    def GetSecondDerivative(self, value: float) -> GeoVector3:
        """Gets the second derivative of the xline: nought, as an xline does not bend."""
    def GetSplitCurves(
        self,
        parameters: System.Collections.Generic.IReadOnlyList[float],
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the pieces the xline is cut into at parameters, as AutoCAD's GetSplitCurves: a ray from the first
        parameter running back, lines from each parameter to the next, and a ray from the last running on, all of
        the same look in no file; the parameters taken in increasing order, one within the point tolerance of
        another cutting nothing, and an xline cut nowhere given whole, as a copy."""
    def ReverseCurve(self) -> None:
        """Turns the xline to run the other way, as AutoCAD's ReverseCurve: its direction turned over, its base
        point kept."""
    def SetFromGeCurve(self, geCurve: object) -> None:
        """Gives the xline the origin and direction of a GeoXLine3, as AutoCAD's SetFromGeCurve, or of a GeoXLine2
        at z = 0, each written as DxfWriter writes one."""
    @overload
    def ToGeoXLine2(self) -> GeoXLine2:
        """Gets the xline in the plane, as DxfReader reads it with DxfReadOptions.PlanAs2D within the default
        tolerance: the xline through (0, 0, 0) along (3, 4, 0) is the GeoXLine2 through (0, 0) along (0.6, 0.8).
        One whose origin is at a height, or whose direction rises, does not lie on the floor, and is refused."""
    @overload
    def ToGeoXLine2(self, tolerance: Tolerance) -> GeoXLine2:
        """Gets the xline in the plane, as DxfXline.ToGeoXLine2 does, within a tolerance, which says whether it has
        a direction."""
    def ToGeoXLine3(self) -> GeoXLine3:
        """Gets the xline as the library's, as AutoCAD's GetGeCurve and the AutoCAD bridge's ToGeoXLine3 give it:
        the shape DxfEntity.GetGeometry gives, to the bit. The xline through (0, 0, 0) along (3, 4, 0) is the
        GeoXLine3 through there along (0.6, 0.8, 0)."""

class DxfXrecord(DxfDBObject):
    """An XRECORD of a DXF file, as AutoCAD's Xrecord: a list of groups an application keeps under a name of a
    DxfDBDictionary, read and written as the file holds them."""
    def __init__(self) -> None:
        """Initializes an XRECORD made in code, with no data, to be added to a dictionary by DxfDBDictionary.SetAt,
        as AutoCAD's Xrecord() is."""
    @property
    def Data(self) -> System.Collections.Generic.IReadOnlyList[DxfTypedValue]:
        """Gets or sets the data of the XRECORD, as AutoCAD's Data: its groups after the subclass marker AcDbXrecord
        and, from R2000 on, the cloning flag (280), up to its extended data; each text (codes 1 to 9 and 300 to
        309) with its escapes (\\U+00E9) read as letters."""
    @Data.setter
    def Data(self, value: System.Collections.Generic.IReadOnlyList[DxfTypedValue]) -> None: ...
    def Append(self, data: System.Collections.Generic.IEnumerable[DxfTypedValue]) -> None:
        """Adds groups at the end of the data, as AutoCAD's Append adds those of a result buffer; none changes
        nothing."""
    def Erase(self) -> None:
        """Erases the XRECORD, as AutoCAD's Erase: it is taken out of the file, and the entry of the dictionary that
        names it with it."""
    def GetEnumerator(self) -> System.Collections.Generic.IEnumerator[DxfTypedValue]:
        """Gets an enumerator over the groups of the data, as AutoCAD's GetEnumerator."""
    def ToString(self) -> str:
        """Gives the XRECORD as a line for debugging: its type, its handle and how many groups its data has."""
    def __iter__(self) -> Iterator[DxfTypedValue]: ...

class DxfXrefStatus(System.Enum):
    """Where an external reference stands, as AutoCAD's XrefStatus names it and numbers it, for
    DxfBlockTableRecord.XrefStatus."""
    FileNotFound: ClassVar[DxfXrefStatus]
    """The drawing the external reference comes from is not found at its path."""
    NotAnXref: ClassVar[DxfXrefStatus]
    """The block is no external reference."""
    Resolved: ClassVar[DxfXrefStatus]
    """The external reference was resolved when AutoCAD saved the drawing (flag 32 of its BLOCK)."""
    Unloaded: ClassVar[DxfXrefStatus]
    """The external reference is unloaded; never given from a DXF file, which does not say so."""
    Unreferenced: ClassVar[DxfXrefStatus]
    """No INSERT places the external reference."""
    Unresolved: ClassVar[DxfXrefStatus]
    """The external reference is not resolved, as one attached and not yet opened by AutoCAD."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...
