        that reference), as AutoCAD 2021 writes a DIMALIGNED from the start of a line to the foot of its
        perpendicular on another: the start of the first line; its DxfOsnapPointRef.ObjectHandle null and its
        snap DxfOsnapType.None where that point was tied to nothing. Its DxfOsnapPointRef.PointIndex is not
        written. Null for a point of any other snap."""
    @property
    def NearParameter(self) -> float:
        """Gets the parameter of the point on the entity (group 40)."""
    @property
    def ObjectHandle(self) -> str:
        """Gets the handle of the entity snapped to (group 331); null for a DxfOsnapPointRef.LastPointReference of a
        point tied to nothing, which AutoCAD writes with no 331."""
    @property
    def OsnapType(self) -> DxfOsnapType:
        """Gets the object snap the point was taken by (group 72)."""
    @property
    def Point(self) -> GeoPoint3:
        """Gets the point snapped, in world coordinates (group 10)."""
    @property
    def PointIndex(self) -> int:
        """Gets which point of the dimension the reference ties, 0 to 3."""
    @property
    def SubentType(self) -> int:
        """Gets the kind of the part of the entity snapped to (group 73): 2, an edge, for a line, an arc or a
        circle."""
    def ToString(self) -> str: ...
    @overload
    def WithLastPoint(self, lastPoint: DxfOsnapPointRef) -> DxfOsnapPointRef:
        """Gives a copy of the reference that names the reference of the point its perpendicular or tangent was
        drawn from, as AutoCAD 2021 writes a PERpendicular or a TANgent snap: the second point of a DIMALIGNED
        snapped perpendicular to a line from the start of another is perpendicular.WithLastPoint(start)."""
    @overload
    def WithLastPoint(self, point: GeoPoint3) -> DxfOsnapPointRef:
        """Gives a copy of the reference whose perpendicular or tangent was drawn from a point tied to nothing, as
        AutoCAD 2021 writes one: a last point reference of no snap and no object, at the point."""

