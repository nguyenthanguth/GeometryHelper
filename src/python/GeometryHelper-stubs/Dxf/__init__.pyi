    def SetTextString(self, row: int, column: int, contentIndex: int, text: str) -> None:
        """Sets the text of a content of a cell, as AutoCAD's SetTextString(row, column, contentIndex, text): of its
        one content, nought, as DxfTable.SetTextString."""
    def SetTextStyle(self, row: int, col: int, style: DxfTextStyleTableRecord) -> None:
        """Sets the text style of a cell's text, as AutoCAD's SetTextStyle(row, col, id) takes its id: the cell's
        own (7, by name), its flag 0x10 set; table.SetTextStyle(1, 0, db.TextStyleTable[\"GH_TXT\"]) writes 7
        GH_TXT. A cell that has a 7 already has it written in its place, as each override of a cell is, before
        its 92 where AutoCAD 2021 writes one, so that the cell holds one 7: a second after its value AutoCAD
        read, and the library the first. The block AutoCAD drew the table with is not drawn anew."""
    @overload
    def SetValue(self, row: int, col: int, value: object) -> None:
        """Sets the value of a cell, as AutoCAD's SetValue(row, col, value): a String a text, an Int32, Int16, Byte
        or a Int64 within the 32 bits AutoCAD's whole number holds a DxfDataType.Long, a Double or Single a
        DxfDataType.Double. From R2007 on the value is written of its kind (90), in 91, 140 or 1, its text (302)
        the number as the invariant culture writes it, 7, its unit (94) kept and its format (300) taken away, as
        AutoCAD 2021 wrote 100.125 given to a cell of 1 in %lu4%pr3 (D33 u7), its flags (93) made 6 where they
        had the flag 1 of no value, as AutoCAD writes a value it is given, and the cell given the flag of its
        kind of value (0x40000) where it has it not, a cell reset or read of no value written 91 262144 as
        AutoCAD 2021 wrote it (D33e w01, w03 to w06); the text of a number of its kind DxfDataType.Double as
        AutoCAD 2021 wrote it and showed it, of six places of decimals, 12.500000 for 12.5 (D28e v09, w30 to
        w33), where the library wrote 12.5, which AutoCAD showed as it was. Before R2007 a cell holds a text
        alone, and the value is written as its text, as DxfTable.SetTextString writes one, a number as the
        invariant culture writes it, 12.5, which keeps it whole where AutoCAD 2021 wrote 12.500000 (w09): the
        text is all the cell holds. A pointer to a field (344) is taken out, its field erased where the table
        owns it and nothing else of the file points at it. The value the cell has, a text as the file writes it
        or as it reads, changes nothing. The block AutoCAD drew the table with is not drawn anew."""
    @overload
    def SetValue(self, row: int, column: int, contentIndex: int, value: object) -> None:
        """Sets the value of a content of a cell, as AutoCAD's SetValue(row, column, contentIndex, value): of its
        one content, nought, as DxfTable.SetValue."""
    def TableStyleOverrides(self) -> System.Array[DxfTableStyleOverride]:
        """Gets what the table holds of its own over its table style, as AutoCAD's TableStyleOverrides: by the flags
        of its head, 93 bit k the override numbered k + 1 (DxfTableStyleOverride.TitleSuppressed to
