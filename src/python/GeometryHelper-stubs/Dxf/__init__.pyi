    """The element of the least offset, the right one of STANDARD, stands on the points (2)."""
    Top: ClassVar[DxfMlineJustification]
    """The element of the greatest offset, the left one of STANDARD, stands on the points (0)."""
    Zero: ClassVar[DxfMlineJustification]
    """The line of offset nought, the middle of STANDARD, stands on the points (1)."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class DxfMlineStyle(DxfDBObject):
    """A style of multilines of a DXF file, as AutoCAD's MlineStyle: an MLINESTYLE of the dictionary of multiline
    styles (DxfDatabase.MLStyleDictionary), read from its record: its name, description, fill, caps, the angles
    of its ends and its elements, the lines it draws at their offsets."""
    @property
    def Description(self) -> str:
        """Gets the description of the style (group 3), as AutoCAD's Description; empty where it gives none."""
    @property
    def Elements(self) -> System.Collections.Generic.IReadOnlyList[DxfMlineStyleElement]:
        """Gets the elements of the style, as AutoCAD's Elements: each its offset from the line drawn (49), its
        colour (62) and its linetype (6), in the order of the record, a new list on each call."""
    @property
    def EndAngle(self) -> float:
        """Gets the angle of the multiline's end to its line (group 52, in degrees) in radians, as AutoCAD's
        EndAngle: pi / 2 square across."""
    @property
    def EndInnerArcs(self) -> bool:
        """Gets whether arcs join the inner elements at the end (flag 512), as AutoCAD's EndInnerArcs."""
    @property
    def EndRoundCap(self) -> bool:
        """Gets whether an arc joins the outer elements at the end (flag 1024), as AutoCAD's EndRoundCap."""
    @property
    def EndSquareCap(self) -> bool:
        """Gets whether a line closes the end (flag 256), as AutoCAD's EndSquareCap."""
    @property
    def FillColor(self) -> DxfColor:
        """Gets the colour of the fill (group 62), as AutoCAD's FillColor: BYLAYER where the record gives none."""
    @property
    def Filled(self) -> bool:
        """Gets whether the multiline is filled between its outer elements (flag 1 of group 70), as AutoCAD's
        Filled."""
    @property
    def Name(self) -> str:
        """Gets the name of the style (group 2), as AutoCAD's Name, such as STANDARD."""
    @property
    def ShowMiters(self) -> bool:
        """Gets whether a line is drawn across each joint (flag 2), as AutoCAD's ShowMiters."""
    @property
    def StartAngle(self) -> float:
        """Gets the angle of the multiline's start to its line (group 51, in degrees) in radians, as AutoCAD's
        StartAngle: pi / 2 square across."""
    @property
    def StartInnerArcs(self) -> bool:
        """Gets whether arcs join the inner elements at the start (flag 32), as AutoCAD's StartInnerArcs."""
    @property
    def StartRoundCap(self) -> bool:
        """Gets whether an arc joins the outer elements at the start (flag 64), as AutoCAD's StartRoundCap."""
    @property
    def StartSquareCap(self) -> bool:
        """Gets whether a line closes the start (flag 16), as AutoCAD's StartSquareCap."""
    def Apply(self, settings: DxfMlineStyleSettings) -> None:
        """Gives the style the settings, as AutoCAD sets the values of an MlineStyle before it is added: its record
        written anew from them, its name and handle kept, the elements from the greatest offset to the least. A
        multiline already drawn by the style takes the new elements when its record is built anew
        (DxfMlineBuilder); AutoCAD's MLSTYLE refuses to change the elements of a style a multiline is drawn by."""
    def GetSettings(self) -> DxfMlineStyleSettings:
        """Gets what the style is made of as a DxfMlineStyleSettings, to change some of it and give it back to
        DxfMlineStyle.Apply, or to make a style like it with DxfDatabase.AddMlineStyle; a new object on each
        call."""
    def ToString(self) -> str:
        """Gives the style as a line for debugging: its type, its handle and its name."""

