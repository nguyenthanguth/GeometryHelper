    @overload
    def GetSplitCurves(
        self,
        parameters: System.Collections.Generic.IReadOnlyList[float],
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the pieces the curve is cut into at parameters, as AutoCAD's GetSplitCurves: new entities in no
        file."""
    def ReverseCurve(self) -> None:
        """Turns the curve to run the other way, from its end to its start, as AutoCAD's ReverseCurve."""
    def SetFromGeCurve(self, geCurve: object) -> None:
        """Gives the curve the geometry of a shape of the library, as AutoCAD's SetFromGeCurve: a line a
        GeoLine3."""

