    def Width(self, value: float) -> None: ...
    WidthChange: ClassVar[str]
    """Gets the code that widens the letters, as AutoCAD's WidthChange: \\W, followed by a factor and a semicolon,
    \\W0.8;."""
    def ConvertFieldToText(self) -> None:
        """Makes the MTEXT's fields words, as AutoCAD's ConvertFieldToText: the field of its words taken out with
        its children, as DxfDBObject.RemoveField takes it out, and its DxfMText.Contents (3 and 1) kept as they
        are, the values AutoCAD last gave the fields among them. Nothing where it has no field."""
    def Erase(self) -> None:
        """Erases the MTEXT, as AutoCAD's Erase does, as DxfEntity.Erase says; an MTEXT whose later columns are
        MTEXTs of their own (ACAD_MTEXT_COLUMNS, before R2018) takes them with it, as AutoCAD erases one text."""
    def Explode(self) -> System.Collections.Generic.IReadOnlyList[DxfEntity]:
        """Gets the texts the MTEXT breaks into, as AutoCAD's Explode does: one TEXT for each paragraph (\\P, a
        column break \\N taken as one), its formatting and the heights of its codes left out as DxfMText.Text
        leaves them out, as an MTEXT is written into a drawing of R12 (see DxfBlockTableRecord.AppendEntity):
        each in its text style, its height, turn and plane, the lines spaced as DxfMText.LineSpaceDistance says.
        B-12 and M16 on two lines, 2.5 high, held at the top left at (10, 20), come out as two TEXTs on the
        baselines 17.5 and 13.33 high. Where the drawing's DxfDatabase.FontSearchPath measures its words
        (DxfMText.ActualWidth), as AutoCAD 2021 explodes it (check F4): a TEXT for each run of letters of one
        look of each line as the font lays them out, wrapped at its DxfMText.Width, held at its left where the
        pen stands at the run, the ink of the line at the left of its place in the box (or centred on, or ending
        at, the DxfMText.Location for an MTEXT held at its centre or right), each its height and width factor, a
        line under, over or through it written %%U, %%O or %%K: \"A\\H2x;B\\H0.5x;C\\PDEF\" of txt.shx 4 high
        held at the top left at (10, 20) comes out as A at (10, 12), B 8 high at (14, 12), C at (22, 12) and DEF
        at (10, 4). A colour within the words is not given to its TEXT. A stack (the words 1 over 2 in A\\S1/2;B)
        is the TEXT of its numerator, a LINE for its bar or slash, and the TEXT of its denominator, each as high
        as the letters of the stack, where the fonts measure the words (see DxfStackShape): txt.shx 0.18 high
        held at the top left at (10, 10) gives A at (10, 9.58), the 1 at (10.21, 9.82), the bar from (10.18,
        9.79) to (10.3, 9.79), the 2 at (10.18, 9.58) and B at (10.36, 9.58); a stack with a line under, over or
        through it, or in a TrueType font, is left as the TEXT of its words."""
    def GetColumnHeight(self, index: int) -> float:
        """Gets the height of a column (the groups 46 of its embedded object, the 1040 after a 50 of its extended
        data), as AutoCAD's GetColumnHeight: for columns of their own heights; nought for one the MTEXT gives no
        height."""
    def GetMTextWithFieldCodes(self) -> str:
        """Gets the words of the MTEXT with the codes of its fields in their places, as AutoCAD's
        getMTextWithFieldCodes: the code of its field (DxfDBObject.GetField), its formatting codes with it, each
        field it holds standing as its code in its markers, at every depth. The MTEXT {\\H1.5x;Length} 2400 mm,
        the length a field, gives {\\H1.5x;Length} %<\\AcObjProp Object(%<\\_ObjIdx 0>%).Length \\f \"%lu2\">%
        mm, the object named by its index among the field's objects (331) as the file holds it; one with no field
