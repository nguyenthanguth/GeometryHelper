    def TextHeight(self, value: float) -> None: ...
    @property
    def TextStyle(self) -> DxfTextStyleTableRecord:
        """Gets or sets the text style of the MTEXT, as AutoCAD's TextStyleId gives its id: the record of
        DxfMText.TextStyleName in the text style table of the MTEXT's drawing; null where it has none of that
