    def __int__(self) -> int: ...

class DxfDocument(System.Object):
    """What DxfReader read from a DXF file: the shapes of its entities in file order, its layers, its unit and
    version, and what it left out."""
    @property
    def Blocks(self) -> System.Collections.Generic.IReadOnlyList[DxfBlock]:
        """Gets the blocks the file defines, in the order of the file, each with its own entities in its own
        coordinates; the INSERTs of the drawing are read in DxfDocument.Shapes as the entities they place. The
        blocks of the layouts, *Model_Space and *Paper_Space, are not among them."""
    @property
    def LayerTable(self) -> System.Collections.Generic.IReadOnlyList[DxfLayer]:
        """Gets the layers of the layer table, in the order of the table, each with its colour, linetype and
        lineweight and whether it is off, frozen, locked and plotted. A record of a name that an earlier one
        differs from only in case is left out, the first kept, as DxfDocument.Layers keeps the first spelling; a
        layer an entity is on that the table does not list is in DxfDocument.Layers and not here."""
    @property
    def Layers(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the layers: those of the layer table in the order of the file, then any an entity is on
        that the table does not list, in the order they are first met. Two names that differ only in case are one
        layer, as in AutoCAD, named as first written."""
    @property
    def Shapes(self) -> System.Collections.Generic.IReadOnlyList[DxfShape]:
        """Gets the shapes read, each with its look, in the order of the file, an INSERT's where the INSERT stands:
        the entities of its block placed, in the order of the block. One entity of the file can give more than
        one: a 3DFACE whose four corners are not in one plane is two triangles, both with its handle, and a block
        of 50 entities placed by 10 000 INSERTs is 500 000."""
    @property
    def Skipped(self) -> System.Collections.Generic.IReadOnlyDictionary[str, int]:
        """Gets, for each type of entity some of which were not read, how many were not, in the order of the names
        of the types: the entities of the types that are not read at all (HATCH, DIMENSION, ATTRIB and the like)
        and those that have no shape to them, such as a LINE of no length, a CIRCLE of no radius or a TEXT of no
        height, each time a block places it; and the INSERTs that place nothing, of a block the file does not
        define or of one inside itself among them."""
    @property
    def Units(self) -> DxfUnits:
        """Gets the unit the file says its drawing is in ($INSUNITS): DxfUnits.Millimeters for a file DxfWriter
        wrote, DxfUnits.Undefined where the file says none."""
    @property
    def Version(self) -> str:
        """Gets the version of AutoCAD the file is written for ($ACADVER), such as AC1015 for R2000; null where the
        file does not say."""
    @property
    def Warnings(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets what the reader has to say about the file, each a sentence: a part of it that is not read, such as
        the entities of paper space or an INSERT of a block the file does not define, or one read otherwise than
        it might be, such as a spline given by its fit points alone."""
    def GetLayer(self, name: str) -> DxfLayer:
        """Gets a layer of the layer table by its name."""
    def OfType(self) -> System.Collections.Generic.IReadOnlyList[Any]:
        """Gets the shapes of a type, in the order of the file."""
    def OnLayer(self, layer: str) -> System.Collections.Generic.IReadOnlyList[DxfShape]:
        """Gets the shapes on a layer, in the order of the file."""

class DxfDrawOrderTable(DxfDBObject):
    """The draw order of a block, as AutoCAD's DrawOrderTable: the SORTENTSTABLE kept under ACAD_SORTENTS in the
    extension dictionary of the block's BLOCK_RECORD, which gives an entity a sort handle (5) after its own
    (331). The entities are drawn in the order of their sort handles, the lowest first and so at the back; an
    entity the table does not list sorts by its own handle."""
    @property
    def Block(self) -> DxfBlockTableRecord:
        """Gets the block whose entities the table orders; null for a table read on its own, outside its block."""
    def GetFullDrawOrder(self) -> System.Collections.Generic.IReadOnlyList[DxfEntity]:
        """Gets the entities of the block in the order they are drawn, as AutoCAD's GetFullDrawOrder: the back
        first. Two entities of one sort handle, which a damaged table may give, are drawn in the order of the
        block."""
    def MoveAbove(self, entities: System.Collections.Generic.IEnumerable[DxfEntity], target: DxfEntity) -> None:
        """Puts entities of the block just over another, as AutoCAD's MoveAbove, keeping their order among
        themselves."""
    def MoveBelow(self, entities: System.Collections.Generic.IEnumerable[DxfEntity], target: DxfEntity) -> None:
        """Puts entities of the block just under another, as AutoCAD's MoveBelow, keeping their order among
        themselves."""
    def MoveToBottom(self, entities: System.Collections.Generic.IEnumerable[DxfEntity]) -> None:
        """Sends entities of the block to the back, as AutoCAD's MoveToBottom, keeping their order among
        themselves."""
    def MoveToTop(self, entities: System.Collections.Generic.IEnumerable[DxfEntity]) -> None:
        """Brings entities of the block to the front, as AutoCAD's MoveToTop, keeping their order among
        themselves."""
    def ToString(self) -> str: ...

class DxfDynamicBlockGrip(System.Object):
    """One custom grip of an INSERT of a dynamic block, as AutoCAD shows it on the INSERT selected: what it drives,
    where it is and the point it is dragged from, in the coordinates of the file, as
    DxfBlockReference.GetDynamicGrips gives them."""
    @property
    def BasePoint(self) -> GeoPoint3:
        """Gets the point the parameter measures from, in the coordinates of the file: the base point of a linear, a
        polar, an XY (for each of its three grips) or a rotation parameter, the start of a flip parameter's
        reflection line, the grip's own position for a point, a visibility or a lookup parameter and a block
        properties table."""
    @property
    def Direction(self) -> GeoVector3:
        """Gets the way the grip points, a unit vector in the coordinates of the file: from the base point to the
        end of a linear parameter; across a flip parameter's reflection line, to its left looking along it and to
        its right while flipped; nought for the others."""
    @property
    def GripType(self) -> DxfDynamicBlockGripType:
        """Gets the kind of parameter the grip drives."""
    @property
    def Position(self) -> GeoPoint3:
        """Gets where the grip is, in the coordinates of the file: where the INSERT's values put it. The base grip
        of a linear or an XY parameter stands at its DxfDynamicBlockGrip.BasePoint."""
    @property
    def PropertyNames(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the properties the grip sets, as DxfDynamicBlockReferenceProperty.PropertyName gives
        them: one for a linear, a rotation, a flip, a visibility or a lookup parameter and a block properties
        table (Block Table1); the distance and then the angle of a polar one; the x and then the y of a point one
        and of each grip of an XY one."""
    def ToString(self) -> str:
        """Gives the grip as a line for debugging: its kind, its properties and its position."""

class DxfDynamicBlockGripType(System.Enum):
    """The kind of parameter a custom grip of a dynamic INSERT drives, as AutoCAD's Block Editor names the
    parameters."""
    BlockTable: ClassVar[DxfDynamicBlockGripType]
    """A block properties table, at its location: clicked, it lists the table's rows, and the one chosen sets the
    property Block Table1 to its index. AutoCAD 2021 gave the grip of a table at (0, -20) of a block inserted at
    (1 000, 500) at (1 000, 480), and moving it changed nothing (plugin GhDb1)."""
    Flip: ClassVar[DxfDynamicBlockGripType]
    """A flip parameter: clicked, it flips the state. AutoCAD draws a bent arrow across the reflection line."""
    Linear: ClassVar[DxfDynamicBlockGripType]
    """The end of a linear parameter: dragged along its line, it sets the distance. AutoCAD draws an arrow."""
    Lookup: ClassVar[DxfDynamicBlockGripType]
    """A lookup parameter: clicked, it lists the rows. AutoCAD draws a triangle pointing down."""
    Point: ClassVar[DxfDynamicBlockGripType]
    """A point parameter: dragged anywhere, it sets the position's x and y. AutoCAD draws a square."""
    Polar: ClassVar[DxfDynamicBlockGripType]
    """The end of a polar parameter: dragged anywhere, it sets the distance and the angle. AutoCAD draws a
    square."""
    Rotation: ClassVar[DxfDynamicBlockGripType]
    """The end of a rotation parameter: dragged round its base point, it sets the angle. AutoCAD draws a circle."""
    Visibility: ClassVar[DxfDynamicBlockGripType]
    """A visibility parameter: clicked, it lists the states. AutoCAD draws a triangle pointing down."""
    XY: ClassVar[DxfDynamicBlockGripType]
    """The end of an XY parameter, or one of its two corners that take x from one of its points and y from the
    other: dragged anywhere, it sets the distances along x and along y. AutoCAD draws a square."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class DxfDynamicBlockReferenceProperty(System.Object):
    """One dynamic property of an INSERT of a dynamic block, as AutoCAD's DynamicBlockReferenceProperty gives it:
    the name a parameter of the block shows it by, its value for this INSERT as AutoCAD saved it, and the values
    it may take. The value of a linear, XY, polar, point, rotation, flip, visibility or lookup parameter, in a
    block of the actions the library writes or of the stretches and moves AutoCAD's Block Editor writes besides,
    is set as AutoCAD sets it (DxfDynamicBlockReferenceProperty.Value); the others are read only."""
    @property
    def Description(self) -> str:
        """Gets the description the parameter gives the property, as AutoCAD's Description; empty where it gives
        none."""
    @property
    def PropertyName(self) -> str:
        """Gets the name the property is shown by, as AutoCAD's PropertyName: the label of its parameter, Width for
        a linear parameter labelled so; a point parameter's label with \" X\" and \" Y\" after it, Anchor X and
        Anchor Y."""
    @property
    def PropertyTypeCode(self) -> int:
        """Gets the kind of value, as AutoCAD's PropertyTypeCode numbers it by its DwgDataType: 1 for a Double, 3
        for a Int16, 5 for a String, 12 for the point of an Origin (a GeoPoint3)."""
    @property
    def ReadOnly(self) -> bool:
        """Gets whether AutoCAD lets the property be set, as its ReadOnly: true for a value looked up whose table
        does not allow looking back (its column's reverse lookup off); and for the distance of a horizontal, a
        vertical, an aligned or a radial constraint parameter a column of a block properties table holds whose
        properties must match a row, as AutoCAD 2021 read Width and Height of its Fluorescent sample (plugin
        D27b), whose value is set all the same, as AutoCAD set Width 1 200 there."""
    @property
    def Show(self) -> bool:
        """Gets whether AutoCAD's Properties palette lists the property, as AutoCAD's Show: its parameter's Show
        properties of the Block Editor, false for Stud Height and Stud Width of AutoCAD's Stud sample, whose
        values its lookups set; true for a property of no such setting."""
    @property
    def StateNames(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names a flip parameter gives its two states, for its values 0 and 1, as AutoCAD's Properties
        palette shows them: Not flipped and Flipped as the Block Editor names them, Left and Right for Hinge of
        AutoCAD's Door sample. Empty for a property of another kind, whose values name themselves."""
    @property
    def UnitsType(self) -> DxfDynamicBlockReferencePropertyUnitsType:
        """Gets what the value measures, as AutoCAD's UnitsType: a length, an angle, or nothing."""
    @property
    def Value(self) -> Any:
        """Gets or sets the property's value for this INSERT, as AutoCAD's Value: a Double for a length or an angle
        (in radians), a Int16 for the state of a flip (0 not flipped, 1 flipped), a String for a visibility state
        or a value looked up, a GeoPoint3 for the Origin of a parameter, its base point in the block's
        coordinates (set to a point of the file's coordinates, as AutoCAD sets it: see below)."""
    @Value.setter
    def Value(self, value: object) -> None: ...
    @property
    def VisibleInCurrentVisibilityState(self) -> bool:
        """Gets whether the property's parameter is shown in the visibility state the INSERT shows, as AutoCAD's
        VisibleInCurrentVisibilityState: true for a block of no visibility parameter and for that parameter's own
        property; else whether the state lists the parameter, as AutoCAD 2021 read Angle of its Toilet sample in
        the state Elongated (Front) as not visible, and showed no grip of it. AutoCAD's Properties palette lists
        a property only where it is visible so and DxfDynamicBlockReferenceProperty.Show is true. The library's
        own blocks of a visibility parameter list no other parameter in any state, and AutoCAD reads every other
        property of them as not visible (plugin GhDyn1)."""
    def GetAllowedValues(self) -> System.Array[Any]:
        """Gets the values the property may take, as AutoCAD's GetAllowedValues: the list of a parameter's value
        set, lengths scaled as DxfDynamicBlockReferenceProperty.Value is, with the block's own value where the
        list was written without it, after the last value below it, as AutoCAD 2021 gave Door Size of its Door
        sample, own 750, the values 600, 700, 750, 800, 900 and 1 000 (plugin D26b); every visibility state by
        name; 0 and 1 for a flip; the values a lookup table gives, and its label of no match last for a lookup
        that is read only, Custom of AutoCAD's Roller Bearing. Empty where the parameter keeps no list, as for a
        value set of an increment or of none."""
    def MoveBasePoint(self, by: GeoVector3) -> None:
        """Moves the base point of the linear, XY or polar parameter this property is a distance of, as a grip of
        AutoCAD's moves it: the end point stays, the INSERT keeps the base point where it was moved to, and the
        block is worked out from there, as with DxfDynamicBlockReferenceProperty.Value. A plate 100 by 50 of an
        XY parameter from (0, 0) to (100, 50), its right and top edges stretched by the end point, whose base
        point is moved by (20, 0) reads Width 80 and keeps its right edge at x 100, as AutoCAD 2021 read the
        plate whose corner of base x and end y was dragged by (20, 10), the top edge going up by 10 with the end
        point's y (plugin GhDy2a); a stretch or a move tied to the base point (BaseXDelta, BaseYDelta) moves its
        points by the move, and an array starts where the base point is, as AutoCAD drew the array of its XY
        sample's INSERT whose base point a grip took from (0, 5) to (0, 104.30). Moves add up: moving by (20, 0)
        and then by (5, 0) keeps the base point 25 along x. The distances the move leaves are taken to the
        parameter's value set and the base point stands where they put it, the end point staying, as AutoCAD 2021
        read Width 70 and the base point 30 where a panel of Width 50 to 300 by 10 had its base grip dragged by
        33, and Width 50 and 50 by 60 (plugin GhDy3a); an axis of an XY parameter the move leaves alone is not
        taken. The base point of a polar parameter is moved anywhere: a pointer from (0, 0) to (100, 0) whose
        base point is moved by (30, 10) reads Length 81.39 and Angle 354.3 degrees, its lines stay (the end point
        stays), and the INSERT's history gets the record GRIPLOC of the parameter's base grip, (30, 10, 0), as
        AutoCAD 2021 wrote it; a polar stretch worked out after it turns the lines about the new base point, and
        after an end grip dragged before it works the edits out one after the other, as AutoCAD did (the end grip
        to (0, 50), the base grip by 30 and the end grip to (35, 0) leave the first line from (45.43, 25.72) to
        (35, 0), plugin GhDb4a). The history keeps the move of the base grip of a linear or an XY parameter too,
        in a block that keeps one (a polar parameter, an array or a scale action), and a stretch or an array that
        follows the base point stays where it stands at the next value set. A move of no more than 1E-12, or one
        a second move brings back, leaves no record."""
    def MoveCornerPoint(self, to: GeoPoint3, takesXFromEnd: bool) -> None:
        """Drags a corner grip of the XY parameter this property is a distance of, other than its end corner, to a
        point, as AutoCAD's grip does: the corner takes the distance of one axis from the base point to the
        point, taken to its value set, and moves the base point along the other axis to the point, the end point
        staying. The corner of base x and end y (takesXFromEnd false) takes the distance along y; the corner of
        end x and base y takes the one along x. The INSERT's history gets the one record GRIPLOC of the corner's
        grip, how far the corner went, in the block's coordinates, in a block that keeps one, and none of the
        distance or of the base grip, as AutoCAD 2021 wrote it: a plate 100 by 50 of an XY parameter from (0, 0)
        to (100, 50) whose corner of base x and end y is dragged by (10, 5) reads Width 90 and Height 55, the
        right edge staying at x 100, and keeps GRIPLOC (10, 5, 0)."""
    def MoveEndPoint(self, to: GeoPoint3) -> None:
        """Drags the end grip of the linear, XY, polar, rotation or point parameter this property is a distance, an
        angle or a position of to a point, as AutoCAD's grip does: the distance and the angle of the point from
        the base point, taken to their value sets, are the parameter's values, the block is worked out from them
        (a polar stretch turning and moving what it holds), and the INSERT's history gets the record GRIPLOC of
        the parameter's end grip, how far the end point went in this drag, in the block's coordinates, as AutoCAD
        2021 wrote it. A pointer of two lines from (0, 0) to (100, 0), at (1 000, 500), whose end grip is dragged
        to (1 000, 550) reads Length 50 and Angle 90 degrees, runs its line to (0, 50) and keeps GRIPLOC (-100,
        50, 0); dragged to (1 010, 500) next it keeps the one record, (-90, 0, 0), the two moves added, unless
        another record came between (plugin GhDy3a). The end grip of a linear parameter takes the distance along
        its line from the base point, that of an XY parameter each distance along its axis, each taken to its
        value set, and the history keeps the same GRIPLOC of the grip in a block that keeps one (plugin GhDb4a).
        The grip of a point parameter takes the position to the point (by (20, 10) it keeps GRIPLOC (20, 10, 0)),
        and the end grip of a rotation parameter takes the angle of the point about the base point from its base
        angle, to its value set: a bar 60 long about (0, 300) whose end grip goes from (60, 300) to (0, 360)
        reads a quarter turn and keeps GRIPLOC (-60, 60, 0), as AutoCAD 2021 wrote them."""
    def ToString(self) -> str:
        """Gives the property as a line for debugging: its name and its value."""

class DxfDynamicBlockReferencePropertyUnitsType(System.Enum):
    """What a dynamic property of an INSERT measures, as AutoCAD's DynamicBlockReferencePropertyUnitsType numbers
