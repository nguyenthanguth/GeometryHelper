        """Gets the point the distances are measured from, in the block's coordinates."""
    @property
    def EndPoint(self) -> GeoPoint3:
        """Gets the point the distances are measured to, in the block's coordinates, which follows the
        properties."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the parameter's object, the BLOCKXYPARAMETER of the OBJECTS section."""
    @property
    def XDescription(self) -> str:
        """Gets the description of the distance along x (308); empty where none was given."""
    @property
    def XDistance(self) -> float:
        """Gets the distance along x from the base point to the end point, the value every INSERT shows until its
        property is set."""
    @property
    def XName(self) -> str:
        """Gets the label of the distance along x, the name of its property (306), as Width."""
    @property
    def XValueSet(self) -> DxfBlockParameterValueSet:
        """Gets the values the distance along x may take; null where it may take any."""
    @property
    def YDescription(self) -> str:
        """Gets the description of the distance along y (307); empty where none was given."""
    @property
    def YDistance(self) -> float:
        """Gets the distance along y from the base point to the end point, the value every INSERT shows until its
        property is set."""
    @property
    def YName(self) -> str:
        """Gets the label of the distance along y, the name of its property (305), as Depth."""
    @property
    def YValueSet(self) -> DxfBlockParameterValueSet:
        """Gets the values the distance along y may take; null where it may take any."""

class DxfCell(System.Object):
    """A cell of a table, as AutoCAD's Cell: table.Cells[1, 0], or one of the cells a table walks. It reads and sets
