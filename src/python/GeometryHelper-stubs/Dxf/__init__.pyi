        plane the same of its arcs and its lines, each segment over one step of its parameter, or of degree 1
        where it has no arc, but one fitted with a spline the B-spline it is fitted with, as AutoCAD 2021 gives
        it: on its frame (the vertices of flag 16) as control points, of degree 2 or 3 as its type says, its
        knots one step apart, clamped where it is open and periodic where it is closed, which runs through the
        vertices drawn but not along the lines between them; a 3D polyline of degree 1 over its parameter; a
        spline its own data."""
    @property
    def StartParam(self) -> float:
        """Gets or sets the parameter at the start of the curve, as AutoCAD's StartParam: nought unless the class
        says otherwise; set where the class can move it, as an ellipse's."""
    @StartParam.setter
    def StartParam(self, value: float) -> None: ...
    @property
    def StartPoint(self) -> GeoPoint3:
        """Gets or sets the point where the curve starts, as AutoCAD's StartPoint; set where the class can move
        it."""
    @StartPoint.setter
    def StartPoint(self, value: GeoPoint3) -> None: ...
    @staticmethod
    def CreateFromGeCurve(geCurve: object) -> DxfCurve:
        """Makes the curve of a shape of the library, as AutoCAD's CreateFromGeCurve: a DxfLine of a GeoLine3, in no
        file, on layer 0 with no look of its own."""
    @overload
    def Extend(self, newParameter: float) -> None:
        """Extends the curve to a parameter past one of its ends, as AutoCAD's Extend."""
    @overload
    def Extend(self, extendStart: bool, toPoint: GeoPoint3) -> None:
        """Extends the curve at one end to a point, as AutoCAD's Extend."""
    def GetClosestPointTo(self, givenPoint: GeoPoint3, extend: bool) -> GeoPoint3:
        """Gets the point of the curve nearest a point, as AutoCAD's GetClosestPointTo."""
    def GetDistAtPoint(self, point: GeoPoint3) -> float:
        """Gets the distance along the curve from its start to a point of it, as AutoCAD's GetDistAtPoint."""
    def GetDistanceAtParameter(self, value: float) -> float:
        """Gets the distance along the curve from its start to a parameter, as AutoCAD's GetDistanceAtParameter."""
    @overload
    def GetFirstDerivative(self, point: GeoPoint3) -> GeoVector3:
        """Gets the derivative of the curve at a point of it, as AutoCAD's GetFirstDerivative at a point."""
    @overload
    def GetFirstDerivative(self, value: float) -> GeoVector3:
        """Gets the derivative of the curve at a parameter, as AutoCAD's GetFirstDerivative: how the point moves as
        the parameter grows."""
    def GetGeCurve(self) -> Any:
        """Gets the library's shape for the curve, as AutoCAD's GetGeCurve gives its geometry's: the one shape of
        DxfEntity.GetGeometry, a GeoLine3 for a line; null where the reader reads none, as for a line of no
        length. Each class also gives its shape typed, with no cast, by the names of the AutoCAD bridge:
        DxfLine.ToGeoLine3, and DxfLine.ToGeoLine2 for the shape of the plane."""
    def GetOffsetCurves(self, offsetDist: float) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the curves at a distance from this one, as AutoCAD's GetOffsetCurves: new entities of the same look,
        in no file, to be added to one."""
    def GetOffsetCurvesGivenPlaneNormal(
        self,
        planeNormal: GeoVector3,
        offsetDist: float,
    ) -> System.Collections.Generic.IReadOnlyList[DxfCurve]:
        """Gets the curves at a distance from this one within the plane of a normal, as AutoCAD's
        GetOffsetCurvesGivenPlaneNormal."""
    def GetOrthoProjectedCurve(self, planeToProjectOn: GeoPlane3) -> DxfCurve:
        """Gets the curve projected square onto a plane, as AutoCAD's GetOrthoProjectedCurve: as
        DxfCurve.GetProjectedCurve along the plane's normal."""
    def GetParameterAtDistance(self, dist: float) -> float:
        """Gets the parameter at a distance along the curve from its start, as AutoCAD's GetParameterAtDistance."""
    def GetParameterAtPoint(self, point: GeoPoint3) -> float:
        """Gets the parameter at a point of the curve, as AutoCAD's GetParameterAtPoint."""
    def GetPointAtDist(self, value: float) -> GeoPoint3:
        """Gets the point at a distance along the curve from its start, as AutoCAD's GetPointAtDist."""
    def GetPointAtParameter(self, value: float) -> GeoPoint3:
        """Gets the point at a parameter, as AutoCAD's GetPointAtParameter."""
    def GetProjectedCurve(self, planeToProjectOn: GeoPlane3, projectionDirection: GeoVector3) -> DxfCurve:
        """Gets the curve projected onto a plane along a direction, as AutoCAD's GetProjectedCurve: a new curve of
        the same look in no file, each point of it moved along the direction until it meets the plane. A line,
        ray, xline, 3D polyline and spline stay of their kind, their points projected (a spline's fit data taken
        out, as the projected control points are its curve exactly); an arc, circle or ellipse in a plane
        parallel to the plane stays of its kind, moved, and otherwise becomes the part of the ellipse it projects
        to (a circle of radius 10 on the floor projected along (0, 0, 1) onto the plane y + z = 0 is an ellipse
        of radii 14.14 and 10); a polyline of the plane stays one where its plane is parallel or it has no arc,
        its vertices taken into the new plane, and otherwise becomes the DxfSpline of its projected
        DxfCurve.Spline, its arcs being parts of ellipses there. A curve that projects to a point, its length
        there within the point tolerance (a 3D polyline standing along the direction), is refused, and so is a
        conic seen edge on, or so nearly that its minor axis is within the point tolerance or 1E-6 of its major
        one, AutoCAD's least ratio of an ellipse's axes: it projects to a line."""
    @overload
    def GetSecondDerivative(self, point: GeoPoint3) -> GeoVector3:
        """Gets the second derivative of the curve at a point of it, as AutoCAD's GetSecondDerivative at a point."""
    @overload
    def GetSecondDerivative(self, value: float) -> GeoVector3:
        """Gets the second derivative of the curve at a parameter, as AutoCAD's GetSecondDerivative."""
    @overload
    def GetSplitCurves(
