    def GetStartWidthAt(self, index: int) -> float:
        """Gets the width of the polyline where the segment that leaves a vertex starts (group 40), as AutoCAD's
        GetStartWidthAt: the polyline's constant width (43) where the vertex gives none."""
    def OnSegmentAt(self, index: int, pt2d: GeoPoint2, value: float) -> bool:
        """Gets whether a point of the plane lies on the segment that leaves a vertex, within the point tolerance,
        as AutoCAD's OnSegmentAt."""
    def RemoveVertexAt(self, index: int) -> None:
        """Takes a vertex out, as AutoCAD's RemoveVertexAt. A polyline keeps two vertices at least, as AutoCAD keeps
        one on save and audit: the vertex is not taken out where fewer would be left."""
    def Reset(self, reuse: bool, vertices: int) -> None:
        """Keeps the first vertices and takes the others out, as AutoCAD's Reset: where the vertices are reused, as
        many as given are kept. A polyline keeps two vertices at least, so a reset that would leave fewer is
        refused."""
    def ReverseCurve(self) -> None:
        """Turns the polyline to run from its end to its start, as AutoCAD's ReverseCurve: the vertices in the other
        order, each segment's bulge turned over and its widths swapped; a closed polyline keeps its first vertex."""
    def SetBulgeAt(self, index: int, bulge: float) -> None:
        """Sets the bulge of the segment that leaves a vertex, as AutoCAD's SetBulgeAt: 1 is a half circle to the
        left."""
    def SetEndWidthAt(self, index: int, endWidth: float) -> None:
        """Sets the width where the segment that leaves a vertex ends, as AutoCAD's SetEndWidthAt."""
    def SetFromGeCurve(self, geCurve: object) -> None:
        """Gives the polyline the vertices and bulges of a chain or loop, as AutoCAD's SetFromGeCurve, written as
        DxfWriter writes one as a LWPOLYLINE: a GeoPolyline2, GeoPolylineArc2, GeoPolygon2 or GeoPolygonArc2 on
        the normal (0, 0, 1) at no elevation, closed for a loop, read back by the matching method of the plane to
        the bit; a GeoPolyline3, GeoPolylineArc3, GeoPolygon3 or GeoPolygonArc3 whose every vertex is within the
        default point tolerance of the plane through its first vertex square to the polyline's own
        DxfPolyline.Normal, and no point of its arcs further off it than the planar tolerance (a half circle of
        radius 100 turned 0.001 out of it stands 0.1 off, and is written in its own plane), in the system of that
        normal, at the elevation of its first vertex, so that a mirrored polyline stays mirrored and a chain on
        one line has a plane to be in: the polyline (0, 0), (10, 0) at the elevation 5 takes the chain from (0,
        0, 5) to (20, 0, 5) and gives it back from DxfPolyline.ToGeoPolyline3 to the bit. Any other of those is
        written in the system of the plane it lies in within the default tolerance, its normal turned up in its
        largest component; the chain from (0, 0, 0) to (10 000, 0, 0.1), on one line and off the polyline's plane
        by more than the tolerance, lies in none and is refused, not flattened. Its handle, layer, look,
        thickness and extended data are kept, as DxfEntity's setters keep them. Where the shape is written anew,
        its widths and its linetype generation (DxfPolyline.Plinegen) are not kept; a shape written as the shape
        it has now is written, as the one DxfEntity.GetGeometry gives, leaves it as it is, widths and fitting and
        all."""
    def SetPointAt(self, index: int, pt: GeoPoint2) -> None:
        """Moves a vertex, given in the system of the polyline's normal, as AutoCAD's SetPointAt."""
    def SetStartWidthAt(self, index: int, startWidth: float) -> None:
        """Sets the width where the segment that leaves a vertex starts, as AutoCAD's SetStartWidthAt. A constant
        width the polyline had is given to every vertex first, as the widths are no longer one."""
    @overload
    def ToGeoPolygon2(self) -> GeoPolygon2:
        """Gets the polyline as a loop of straight edges of the plane, as DxfPolyline.ToGeoPolygon3 reads it, where
        it lies on the floor as DxfPolyline.ToGeoPolyline2 says: the closed polyline (0, 0), (10, 0), (10, 10) at
        no elevation is the GeoPolygon2 of those corners."""
    @overload
    def ToGeoPolygon2(self, tolerance: Tolerance) -> GeoPolygon2:
        """Gets the polyline as a loop of straight edges of the plane, as DxfPolyline.ToGeoPolygon2 does, within a
        tolerance, which says which vertices are one and whether it encloses an area."""
    def ToGeoPolygon3(self) -> GeoPolygon3:
        """Gets the polyline as a loop of straight edges in the world: closed or not, its last vertex joined back to
        its first, as the AutoCAD bridge's ToGeoPolygonArc2 joins one, and a last vertex on the first left out.
        The closed polyline (0, 0), (10, 0), (10, 10) at the elevation 5 is the GeoPolygon3 of those three
        corners at z = 5, as DxfEntity.GetGeometry gives it. A polyline with an arc is refused
        (DxfPolyline.ToGeoPolygonArc3 gives it), and so is one that encloses no area, its vertices on one line."""
    @overload
    def ToGeoPolygonArc2(self) -> GeoPolygonArc2:
        """Gets the polyline as a loop with arcs of the plane, as DxfPolyline.ToGeoPolygonArc3 reads it, where it
        lies on the floor as DxfPolyline.ToGeoPolyline2 says: the closed polyline (0, 0), (10, 0), (10, 10), (0,
        10) with a bulge of -0.25 on its second vertex is the GeoPolygonArc2 of those corners and that bulge, as
        the AutoCAD bridge's ToGeoPolygonArc2 reads it from AutoCAD."""
    @overload
    def ToGeoPolygonArc2(self, tolerance: Tolerance) -> GeoPolygonArc2:
        """Gets the polyline as a loop with arcs of the plane, as DxfPolyline.ToGeoPolygonArc2 does, within a
        tolerance, which says which vertices are one and whether it encloses an area."""
    def ToGeoPolygonArc3(self) -> GeoPolygonArc3:
        """Gets the polyline as a loop with arcs in the world, bulge for bulge: closed or not, its last vertex
        joined back to its first, the bulge of the last vertex that of the closing edge, as the AutoCAD bridge's
        ToGeoPolygonArc2 reads one. A closed polyline of two vertices with an arc, a circle drawn as two half
        circles, has its first arc halved at its middle, as the reader reads it, so that it has the three
        vertices a loop has: two half circles of radius 10 are the GeoPolygonArc3 of area 314.159. One with no
        arc is the loop whose bulges are all nought. A loop of no area, read as an area at the vector tolerance,
        is refused."""
    @overload
    def ToGeoPolyline2(self) -> GeoPolyline2:
        """Gets the polyline as a chain of straight segments of the plane, as DxfPolyline.ToGeoPolyline3 reads it,
        where it lies on the floor as DxfReader reads one with DxfReadOptions.PlanAs2D: its normal (0, 0, 1) and
        its elevation nought, its vertices as they are; or its normal (0, 0, -1), as AutoCAD writes a mirrored
        polyline, its x turned over and its bulges negated, the vertices in their order. One at an elevation, or
        on a tilted normal, is refused rather than flattened; DxfPolyline.GetPoint2dAt gives its vertices in the
        system of its normal whatever that is, as the AutoCAD bridge reads them."""
    @overload
    def ToGeoPolyline2(self, tolerance: Tolerance) -> GeoPolyline2:
        """Gets the polyline as a chain of straight segments of the plane, as DxfPolyline.ToGeoPolyline2 does,
        within a tolerance, which says which vertices are one."""
    def ToGeoPolyline3(self) -> GeoPolyline3:
        """Gets the polyline as a chain of straight segments in the world, of its vertices as DxfReader reads them:
        the polyline (0, 0), (10, 0), (10, 10) at the elevation 5 is the GeoPolyline3 through (0, 0, 5), (10, 0,
        5) and (10, 10, 5); closed, the chain runs on back to (0, 0, 5), as the AutoCAD bridge's
        ToGeoPolylineArc2 reads a closed one. A vertex within the point tolerance of the one before it is left
        out with the segment between them. A polyline with an arc is refused, its arcs not cut into chords here:
        DxfPolyline.ToGeoPolylineArc3 gives it exactly. Its widths are no part of the shape."""
    @overload
    def ToGeoPolylineArc2(self) -> GeoPolylineArc2:
        """Gets the polyline as a chain with arcs of the plane, as DxfPolyline.ToGeoPolylineArc3 reads it, where it
        lies on the floor as DxfPolyline.ToGeoPolyline2 says: the polyline above is the GeoPolylineArc2 of a line
        from (0, 0) to (10, 0) and a half circle to (10, 10)."""
    @overload
    def ToGeoPolylineArc2(self, tolerance: Tolerance) -> GeoPolylineArc2:
        """Gets the polyline as a chain with arcs of the plane, as DxfPolyline.ToGeoPolylineArc2 does, within a
        tolerance, which says which vertices are one."""
    def ToGeoPolylineArc3(self) -> GeoPolylineArc3:
        """Gets the polyline as a chain with arcs in the world, bulge for bulge, as DxfReader reads its vertices:
        the bulge on a vertex is that of the segment leaving it, and on the last vertex of an open polyline
        belongs to nothing; closed, the chain runs on back to its first vertex, the bulge of the last vertex that
        of the closing segment. The polyline (0, 0), (10, 0), (10, 10) with a bulge of 1 on its second vertex is
        the GeoPolylineArc3 of a line 10 long and a half circle of radius 5; one with no arc the chain whose
        bulges are all nought."""

class DxfPolyline2d(DxfCurve):
    """A POLYLINE of the plane of a DXF file, as AutoCAD's Polyline2d: the POLYLINE record with its DxfVertex2d
    records and its SEQEND, the vertices in the plane of its DxfPolyline2d.Normal at its DxfPolyline2d.Elevation,
    each segment a line or, where the vertex it leaves has a bulge, an arc."""
    @overload
    def __init__(self) -> None:
        """Initializes a polyline of no vertices, as AutoCAD's new Polyline2d(), on layer 0 in no file."""
    @overload
    def __init__(
        self,
        type: DxfPoly2dType,
        vertices: System.Collections.Generic.IEnumerable[GeoPoint3],
        elevation: float,
        closed: bool,
        startWidth: float,
        endWidth: float,
        bulges: System.Collections.Generic.IEnumerable[float],
    ) -> None:
        """Initializes a polyline of vertices, as AutoCAD's new Polyline2d(type, vertices, elevation, closed,
        startWidth, endWidth, bulges), on layer 0 in no file until it is added to one."""
    @property
    def Area(self) -> float:
        """Gets the area the polyline closes, as AutoCAD's Area: that of the polygon of its vertices with what each
        arc adds or takes off; an open polyline taken as closed by a line from its last vertex to its first."""
    @property
    def Closed(self) -> bool:
        """Gets or sets whether a segment runs from the last vertex back to the first (flag 1 of group 70), as
        AutoCAD's Closed."""
    @Closed.setter
    def Closed(self, value: bool) -> None: ...
    @property
    def ConstantWidth(self) -> float:
        """Gets or sets the width of the whole polyline, as AutoCAD's ConstantWidth: the width every vertex has at
        both ends of the segment it starts; nought where the widths differ."""
    @ConstantWidth.setter
    def ConstantWidth(self, value: float) -> None: ...
    @property
    def DefaultEndWidth(self) -> float:
        """Gets or sets the width a vertex added ends with (group 41), as AutoCAD's DefaultEndWidth; nought where
        the record gives none."""
    @DefaultEndWidth.setter
    def DefaultEndWidth(self, value: float) -> None: ...
    @property
    def DefaultStartWidth(self) -> float:
        """Gets or sets the width a vertex added starts with (group 40), as AutoCAD's DefaultStartWidth; nought
        where the record gives none."""
    @DefaultStartWidth.setter
    def DefaultStartWidth(self, value: float) -> None: ...
    @property
    def Elevation(self) -> float:
        """Gets or sets how far the plane of the polyline stands from the origin along its normal (group 30 of its
        point), as AutoCAD's Elevation: the height of the first vertex where the record gives none, as the reader
        reads it."""
    @Elevation.setter
    def Elevation(self, value: float) -> None: ...
    @property
    def EndParam(self) -> float:
        """Gets the parameter at the end of the polyline: the count of its segments, as AutoCAD's."""
    @property
    def Length(self) -> float:
        """Gets the length of the polyline, the sum of those of its segments, as AutoCAD's Length."""
    @property
    def LinetypeGenerationOn(self) -> bool:
        """Gets or sets whether the linetype runs on round the vertices rather than starting again at each (flag 128
        of group 70), as AutoCAD's LinetypeGenerationOn."""
    @LinetypeGenerationOn.setter
    def LinetypeGenerationOn(self, value: bool) -> None: ...
    @property
    def Normal(self) -> GeoVector3:
        """Gets or sets the normal of the plane of the polyline (groups 210, 220, 230), of unit length; (0, 0, 1)
        where the record gives none."""
    @Normal.setter
    def Normal(self, value: GeoVector3) -> None: ...
    @property
    def PolyType(self) -> DxfPoly2dType:
        """Gets or sets how the polyline is drawn through its vertices, as AutoCAD's PolyType: fitted with a curve
        (flag 2 of group 70), with a spline (flag 4, quadratic where group 75 is 5, cubic otherwise), or
        straight."""
    @PolyType.setter
    def PolyType(self, value: DxfPoly2dType) -> None: ...
    @property
    def Thickness(self) -> float:
        """Gets or sets how far the polyline stands up along its DxfPolyline2d.Normal (group 39); nought where the
        record gives none."""
    @Thickness.setter
    def Thickness(self, value: float) -> None: ...
    def AppendVertex(self, vertexToAppend: DxfVertex2d) -> None:
        """Appends a vertex made in code after the last, as AutoCAD's AppendVertex: the vertex is that of the
        polyline from then on, its height the polyline's elevation."""
    def ConvertToPolyType(self, newVal: DxfPoly2dType) -> None:
        """Converts the polyline to a type, as AutoCAD's ConvertToPolyType: straightened for
        DxfPoly2dType.SimplePoly, fitted with a curve for DxfPoly2dType.FitCurvePoly as DxfPolyline2d.CurveFit
        fits it, and with a quadratic or cubic B-spline of the header's SPLINESEGS segments to a span (8 where
        the file gives none) as DxfPolyline2d.SplineFit fits it."""
    def CurveFit(self) -> None:
        """Fits the polyline with a curve, as AutoCAD's CurveFit (PEDIT Fit): a pair of arcs on each segment,
        meeting at a vertex the fitting adds (flag 1 of its group 70) after the vertex the segment leaves, so
        that the curve passes through every vertex in the direction its tangent gives there; flag 2 of the
        polyline's group 70. The tangent is the one the vertex is given (DxfVertex2d.TangentUsed, which the added
        vertex's DxfVertex2d.Tangent copies); at an end of an open polyline that of the circle through the first
        or last three vertices; and between, AutoCAD's blend of the segments either side, each weighted by the
        turn at the far end of the other, so that a vertex after two on a line is fitted along that line: on (0,
