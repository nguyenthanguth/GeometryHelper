class DxfDBObject(System.Object):
    """An object of a DXF file, as AutoCAD's DBObject is one of a drawing: an entity, a table, a record of a table.
    It has its handle, its owner's handle, its extended data and the handle of its extension dictionary, read
    from its record as the file writes it."""
    @property
    def Annotative(self) -> DxfAnnotativeStates:
        """Gets or sets whether the object is annotative, as AutoCAD's Annotative: drawn at the size its scale gives
        it on the sheet, each scale it is shown at a context of its own (DxfDBObject.HasContext)."""
    @Annotative.setter
    def Annotative(self, value: DxfAnnotativeStates) -> None: ...
    @property
    def ExtensionDictionary(self) -> DxfDBDictionary:
        """Gets the object's extension dictionary, as AutoCAD's ExtensionDictionary gives its id: the DICTIONARY of
        the OBJECTS section its group {ACAD_XDICTIONARY names (360), which holds what applications keep with it;
        null where it has none, or names one the file has not."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the object (group 5, 105 for a DIMSTYLE) as the file writes it in hexadecimal, the
        spaces around it taken off, such as 2F; null for an object in no file, and in a file that writes none, as
        many of R12 do."""
    @property
    def IsErased(self) -> bool:
        """Gets whether the object has been erased from its file: it is read still, as it was, but is no longer
        saved and is not changed."""
    @property
    def OwnerHandle(self) -> str:
        """Gets the handle of the object's owner (its first group 330, outside the groups of the applications): the
        BLOCK_RECORD of model space for an entity of model space, the table for a record of a table. Null for an
        object in no file, and in a file of R12, which writes no owners."""
    @property
    def PaperOrientation(self) -> DxfPaperOrientationStates:
        """Gets whether the object keeps the way up of the sheet, as AutoCAD's PaperOrientation, its \"match
        orientation to layout\": for an annotative TEXT, MTEXT, attribute, text style or block, the first 1070 of
        its extended data AcadAnnoPO, DxfPaperOrientationStates.False where it has none or is not annotative; for
        an INSERT, that of its block; DxfPaperOrientationStates.NotApplicable for every other object, as a line
        or a dimension."""
    @property
    def XData(self) -> System.Collections.Generic.IReadOnlyList[DxfTypedValue]:
        """Gets or sets the extended data of the object, as AutoCAD's XData does: each application's data opened by
        its name in a group 1001, then its groups 1000 to 1071, as the file writes them."""
    @XData.setter
    def XData(self, value: System.Collections.Generic.IReadOnlyList[DxfTypedValue]) -> None: ...
    def AddContext(self, context: DxfObjectContext) -> None:
        """Makes the object shown at another scale, as AutoCAD's ObjectContexts.AddContext (the command OBJECTSCALE,
        Add): a context of the scale is written next to the others under ACDB_ANNOTATIONSCALES of its extension
        dictionary, named *A and one more than the highest number the object holds, not the default (290 of 0),
        and made from the default context as AutoCAD 2021 makes it (checked on a TEXT, an MTEXT, an ATTDEF, a
        HATCH and an INSERT of an annotative block drawn at 1:1 and 1:50): a TEXT and an attribute definition
        keep their point, angle and mode; an MTEXT keeps its place and direction and has its width, the height of
        its box and the width and height of its words (40, 41, 42, 43) multiplied by the default's scale over the
        new one's (an MTEXT 40 wide at 1:1 is 2000 wide at 1:50); a HATCH has the lines of its pattern (43, 44,
        45, 46, 49) multiplied so, and 1 over the scale in its group 40 (50 at 1:50), and has its view context
        written first from its default context as it stands, replaced where it has one (KeepHatchView: a hatch
        moved by (100, 50) and then given 1:2 holds 43 of 100, 44 of 50 in its view, as -OBJECTSCALE Add writes
        it); an INSERT has its three factors multiplied so (50 at 1:50 for a 1 at 1:1) and each attribute of it
        that holds contexts is given one as well, its point moved out from the INSERT's by the same factor: the
        attribute at (300, 1003) of an INSERT at (300, 1000) is at (300, 1150) at 1:50. An INSERT that holds no
        context gets the scale as its one context, the default, its record's factors and those of the context
        multiplied by 1 over the scale, as AutoCAD 2021 gave it. A MULTILEADER holding text is laid out again:
        its scale (40) is 1 over the new scale's, its sizes (the text height, the arrowhead, the landing gap, the
        dogleg) multiplied by the default's scale over the new one's, the landing and its lines kept, and the
        content moved out from the landing by the new dogleg: text 0.2 high at 1:50 is 0.4 at 1:100, a dogleg of
        0.36 is 0.72, and the words stand 9.72 right of the landing (check GHAN4). The record of the other kinds
        is kept: their size at the other scale is worked out from it."""
    def CreateExtensionDictionary(self) -> None:
        """Gives the object an extension dictionary, as AutoCAD's CreateExtensionDictionary: an empty DICTIONARY at
        the end of the OBJECTS section, owned hard by the object (280 of 1) and naming it as its owner (330) but
        not as its reactor, its handle written into the object's record as the group {ACAD_XDICTIONARY straight
        after its handle, before its reactors, as AutoCAD 2021 writes it for a LINE, a layer, a block, a table of
        the drawing and an object of the OBJECTS section alike. Nothing where it has one."""
    def Erase(self) -> None:
        """Erases the object from its file, as AutoCAD's Erase does: an entity is taken out of its block with every
        record of it, as DxfEntity.Erase says; a layer, a linetype, a text style or a block nothing uses out of
        its table, as their own Erase says; an XRECORD (DxfXrecord), a GROUP (DxfGroup) and a GEODATA
        (DxfGeoData) with the entry of the dictionary that names it."""
    def GetBinaryDataForKey(self, key: str) -> System.Array[int]:
        """Gets the bytes the object keeps under a key, as AutoCAD's GetBinaryDataForKey: those of the XRECORD of
        that name in its extension dictionary, its groups 310 one after another."""
    def GetContexts(self) -> System.Collections.Generic.IReadOnlyList[DxfObjectContext]:
        """Gets the scales the object is shown at, as AutoCAD's ObjectContexts.GetContexts: the scale each context
        under ACDB_ANNOTATIONSCALES points at, in the order of its dictionary (the default first, as AutoCAD
        writes it), each a DxfAnnotationScale of the drawing's list. An INSERT of an annotative block, or an
        attribute of one, that holds no context is shown at the scale named 1:1 (DxfDBObject.HasContext), which
        this gives where the drawing's list has it. A text of two scales, 1:1 and 1:50, gives those two; an
        object that is not annotative gives none."""
    @overload
    def GetField(self) -> DxfField:
        """Gets the field of the object's words, as AutoCAD's GetField(): that of the property TEXT, which a TEXT,
        an MTEXT, an attribute and a dimension keep their words' field under, as DxfDBObject.GetField gives it."""
    @overload
    def GetField(self, propertyName: str) -> DxfField:
        """Gets the field of a property of the object, as AutoCAD's GetField(propertyName): the FIELD its extension
        dictionary's dictionary ACAD_FIELD names by the property's name, as AutoCAD keeps it."""
    def GetPersistentReactorIds(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the handles of the object's reactors (the groups 330 of its {ACAD_REACTORS), in the order of its
        record, as AutoCAD's GetPersistentReactorIds gives their ids: the DIMASSOC of each associative dimension
        tied to a line, the GROUPs it is in. Empty for an object in no file or with none; a new list on each
        call, read as it was for one erased."""
    def GetXDataForApplication(self, applicationName: str) -> System.Collections.Generic.IReadOnlyList[DxfTypedValue]:
        """Gets the extended data of one application, as AutoCAD's GetXDataForApplication does: its 1001 and the
        groups after it up to the next application's."""
    def HandOverTo(self, newPointer: DxfDBObject, keepXData: bool, keepExtensionDictionary: bool) -> None:
        """Puts an object made in code in this one's place in the drawing, as AutoCAD's HandOverTo hands an object's
        id over: the new object's records written where this one's stand, in its block and at its place among the
        block's entities, with this one's handle, owner and reactors, so that what pointed at this one points at
        the new one; this one is in no file from then on, a copy of what it was with no handle and no owner, to
        be appended again or let go."""
    def HasContext(self, context: DxfObjectContext) -> bool:
        """Gets whether the object is shown at a scale, as AutoCAD's HasContext: whether a context under
        ACDB_ANNOTATIONSCALES of AcDbContextDataManager of its extension dictionary points at the scale's SCALE,
        by the first 340 of its subclass AcDbAnnotScaleObjectContextData, of any kind of context; never for an
        object that is never annotative (DxfDBObject.AnnotativeDxfAnnotativeStates.NotApplicable), as a LINE, a
        CIRCLE or a layer, whatever records it holds, as AutoCAD 2021 answered for eleven kinds of entity handed
        a TEXT's contexts by DxfDBObject.HandOverTo (check D37), which keeps them. Those two groups, with the
        default flag (290 of AcDbObjectContextData), are all the library reads of a context, but for the placing
        of the context of a TEXT, an attribute or a definition, an MTEXT and an INSERT, which DxfDBText.Position,
        DxfMText.Location and DxfBlockReference.Position read and write; the rest of AutoCAD's record of it is
        kept as it is. A copy in no file (DxfEntity.Clone) carries the contexts of its original, and is shown at
        the scales of its original's drawing."""
    def ReleaseExtensionDictionary(self) -> None:
        """Takes out the object's extension dictionary where it is empty, as AutoCAD's ReleaseExtensionDictionary:
        the DICTIONARY erased and the group {ACAD_XDICTIONARY taken out of the object's record. Nothing where it
        has none."""
    def RemoveContext(self, context: DxfObjectContext) -> None:
        """Stops showing an annotative object at a scale, as AutoCAD's RemoveContext and its OBJECTSCALE Delete do:
        its context of the scale erased with its entry of ACDB_ANNOTATIONSCALES, of any kind of object, every
        other context kept as it is; the picture block of a dimension's context goes with it, and an INSERT's
        attributes lose the scale too. Where the context is the default, the next in the order of the dictionary
        becomes it (its 290 of 1) and the record takes that context's data, as AutoCAD 2021 rewrites it: a TEXT
        of 125 at 1:50 with 1:100 beside it is 250 high once 1:50 is deleted, an MTEXT's width the context's, a
        HATCH's pattern lines, an INSERT's factors and place, a dimension's block and the middle of its words,
        and a multileader's context data those of the new default. The entry added after is named as AutoCAD
        names it within a session, one more than the highest number the dictionary has held: after *A2 was
        deleted, *A3. A scale the object is not shown at changes nothing."""
    @overload
    def RemoveField(self) -> DxfField:
        """Takes out the field of the object's words, as AutoCAD's RemoveField(): that of the property TEXT, as
        DxfDBObject.RemoveField takes one out."""
    @overload
    def RemoveField(self, field: DxfField) -> None:
        """Takes out a field of the object, as AutoCAD's RemoveField(fieldId): of the property it is the field of,
        as DxfDBObject.RemoveField takes one out."""
    @overload
    def RemoveField(self, propertyName: str) -> DxfField:
        """Takes out the field of a property of the object, as AutoCAD's RemoveField(propertyName): its entry of the
        dictionary ACAD_FIELD taken out, the field erased with its children, they and it taken out of the
        drawing's list of fields (ACAD_FIELDLIST) where it has one, and the dictionary ACAD_FIELD taken out of
        the extension dictionary once it is empty. The object's words are kept as they are, the field's last
        value among them."""
    def SetBinaryDataForKey(self, key: str, chunk: Sequence[int] | System.Array[int]) -> None:
        """Keeps bytes with the object under a key, as AutoCAD's SetBinaryDataForKey: an XRECORD of that name in its
        extension dictionary, made where it has none, its bytes written as groups 310 of 127 bytes each, as
        AutoCAD writes binary data; the bytes of an XRECORD of the name replaced. Bytes the same as those kept
        change nothing."""
    @overload
    def SetField(self, field: DxfField) -> DxfField:
        """Gives the object's words a field, as AutoCAD's SetField(field): under the property TEXT, as
        DxfDBObject.SetField gives it."""
    @overload
    def SetField(self, propertyName: str, field: DxfField) -> DxfField:
        """Gives a property of the object a field, as AutoCAD's SetField(propertyName, field): the field and its
        children written as FIELDs at the end of the OBJECTS section, named by the property's name in the
        dictionary ACAD_FIELD of the object's extension dictionary, both made where the object has none, each
        owned hard by what holds it, in the layout the DXF reference gives (not yet checked on a drawing AutoCAD
        saved, as DxfField says); the class FIELD listed in the CLASSES section where it is not. A field the
        property had is erased with its children. The object's words are not changed: AutoCAD writes the field's
        value in them when it evaluates it. text.SetField(new DxfField(\"Drawn %<\\\\AcVar Date>%\", true)) gives
        a TEXT the date as a field."""
    def SetFromStyle(self) -> bool:
        """Takes away what the object holds of its own over its style, as AutoCAD's SetFromStyle, so that it is
        drawn as its style draws it: a dimension and a leader lose their overrides of the dimension style (the
        list DSTYLE of their extended data of ACAD), a DxfDimension of Dimasz 4.5 of its own over a style of 3.5
        reading 3.5 again; a DxfMLeader takes the values of its multileader style, as its own
        DxfMLeader.SetFromStyle says; a DxfTable loses its own overrides and its cells', as its own
        DxfTable.SetFromStyle says. An object of no style changes nothing."""
    def XDataTransformBy(self, transform: GeoTransform3) -> None:
        """Moves, turns, scales or mirrors the object's extended data by a transformation, as AutoCAD's
        XDataTransformBy: a position of the world (1011, 1021, 1031) is moved, a displacement (1012) turned and
        scaled but not moved, a direction (1013) turned but kept its length, a distance (1041) and a scale factor
        (1042) scaled by the transformation's scale, the greatest stretch of its axes; a plain point (1010) and
        every other group kept, as AutoCAD keeps them. A value the transformation leaves as it was keeps its
        text, and an object whose data it leaves is not written."""

class DxfDBPoint(DxfEntity):
    """A POINT of a DXF file, as AutoCAD's DBPoint: a point at DxfDBPoint.Position, in world coordinates, with the
    DxfDBPoint.Normal its DxfDBPoint.Thickness stands up along."""
    @overload
    def __init__(self) -> None:
        """Initializes a point at the origin, as AutoCAD's new DBPoint(), on layer 0 in no file."""
    @overload
    def __init__(self, position: GeoPoint3) -> None:
        """Initializes a point, as AutoCAD's new DBPoint(position), on layer 0 with no look of its own, in no file
        until it is added to one."""
    @property
    def EcsRotation(self) -> float:
        """Gets or sets the turn of the point's symbol about its normal, as AutoCAD's EcsRotation: in radians, from
        the degrees of group 50; nought where the record gives none. A point with 90 in its group 50 is pi / 2."""
    @EcsRotation.setter
    def EcsRotation(self, value: float) -> None: ...
    @property
    def Normal(self) -> GeoVector3:
        """Gets or sets the normal of the point (groups 210, 220, 230), the direction its DxfDBPoint.Thickness
        stands up along, of unit length; (0, 0, 1) where the record gives none."""
    @Normal.setter
    def Normal(self, value: GeoVector3) -> None: ...
    @property
    def Position(self) -> GeoPoint3:
        """Gets or sets where the point is (groups 10, 20, 30), in world coordinates, as AutoCAD's Position; the
        origin where the record gives none."""
    @Position.setter
    def Position(self, value: GeoPoint3) -> None: ...
    @property
    def Thickness(self) -> float:
        """Gets or sets how far the point stands up along its DxfDBPoint.Normal (group 39); nought where the record
        gives none."""
    @Thickness.setter
    def Thickness(self, value: float) -> None: ...
    @overload
    def ToGeoPoint2(self) -> GeoPoint2:
        """Gets the point in the plane, as DxfReader reads it with DxfReadOptions.PlanAs2D: the point at (3, 4, 0)
        is the GeoPoint2 (3, 4). The point at (3, 4, 5) does not lie on the floor, and is refused rather than
        flattened, where the AutoCAD bridge's ToGeoPoint2 drops z."""
    @overload
    def ToGeoPoint2(self, tolerance: Tolerance) -> GeoPoint2:
        """Gets the point in the plane, as DxfDBPoint.ToGeoPoint2 does, as DxfReader reads it within a tolerance,
        which a point does not need: it gives the same at any."""
    def ToGeoPoint3(self) -> GeoPoint3:
        """Gets the point as the library's, as the AutoCAD bridge's ToGeoPoint3 gives a Point3d: the shape
        DxfEntity.GetGeometry gives, to the bit. The point at (3, 4, 5) is the GeoPoint3 (3, 4, 5)."""

class DxfDBText(DxfEntity):
    """A TEXT of a DXF file, as AutoCAD's DBText: one line of words at DxfDBText.Position, DxfDBText.Height high,
    turned by DxfDBText.Rotation in the plane of its DxfDBText.Normal, held by its point as
    DxfDBText.HorizontalMode and DxfDBText.VerticalMode say."""
    def __init__(self) -> None:
        """Initializes a text with no words at the origin, 2.5 high, as AutoCAD's new DBText(), on layer 0 in the
        text style Standard, in no file; give it its words and place before it is drawn."""
    @property
    def AlignmentPoint(self) -> GeoPoint3:
        """Gets or sets the second point of the text (groups 11, 21, 31), as AutoCAD's AlignmentPoint: in world
        coordinates, the point a text not aligned left on its baseline is held by; the origin where the record
        gives none, as for such a text. An annotative one's is that of the context it is read at, as
        DxfDBText.Position says, at the elevation of its record."""
    @AlignmentPoint.setter
    def AlignmentPoint(self, value: GeoPoint3) -> None: ...
    @property
    def GeometricExtents(self) -> GeoAabb3:
        """Gets the box the text's words fill, as AutoCAD's GeometricExtents: where the drawing's
        DxfDatabase.FontSearchPath finds the SHX font of its style, the box of the ink of the whole line of words
        upright, its four corners slanted by DxfDBText.Oblique, turned and placed as the text stands at its
        DxfDBText.Position, as AutoCAD 2021 boxes it (check F1a), the position itself not among them: \" A\" of
        txt.shx 4 high at the origin from (4, 0, 0) to (6.667, 4, 0), \"A\" from (0, 0, 0) to (2.667, 4, 0), and
        slanted 15 degrees to (3.738, 4, 0), its top corner moved by 4 times the tangent. A text of no ink is
        boxed at its position. Of a TrueType font, the box from the start of the baseline to the last pen, the
        ink past it counted, each letter boxed from the lower of its bottom and the baseline as high as it is
        (check F2): \"H\" of arial.ttf 4 high from (0, 0, 0) to (4.035, 4, 0), its advance, and the degree sign
        from (0, 0, 0) to (2.235, 1.514, 0), though inked from 2.554 up. Elsewhere as DxfEntity.GeometricExtents
        gives it, the position alone."""
    @property
    def Height(self) -> float:
        """Gets or sets how high the text is (group 40), as AutoCAD's Height; 2.5 where the record gives none. An
        annotative one's is as high as the scale it is read at makes it (DxfDBText.Position): its record holds
        the height at its default scale, so that one 3 high at the default 1:2 is 1.5 high at 1:1, as AutoCAD
        2021 reads it (check D35)."""
    @Height.setter
    def Height(self, value: float) -> None: ...
    @property
    def HorizontalMode(self) -> DxfTextHorizontalMode:
        """Gets or sets how the text stands across its point (group 72), as AutoCAD's HorizontalMode;
        DxfTextHorizontalMode.TextLeft where the record gives none. An annotative one's is that of the context it
        is read at (DxfDBText.Position), its 70, where it holds one: AutoCAD 2021 read an attribute whose record
        is aligned left, and whose context of 1:1 says 2, as aligned right (check D35b)."""
    @HorizontalMode.setter
    def HorizontalMode(self, value: DxfTextHorizontalMode) -> None: ...
    @property
    def IsDefaultAlignment(self) -> bool:
        """Gets whether the text is aligned left on its baseline, its modes both nought, as AutoCAD's
        IsDefaultAlignment."""
    @property
    def IsMirroredInX(self) -> bool:
        """Gets or sets whether the text is written backwards (flag 2 of group 71), as AutoCAD's IsMirroredInX."""
    @IsMirroredInX.setter
    def IsMirroredInX(self, value: bool) -> None: ...
    @property
    def IsMirroredInY(self) -> bool:
        """Gets or sets whether the text is written upside down (flag 4 of group 71), as AutoCAD's IsMirroredInY."""
    @IsMirroredInY.setter
    def IsMirroredInY(self, value: bool) -> None: ...
    @property
    def Justify(self) -> DxfAttachmentPoint:
        """Gets or sets the justification of the text, as AutoCAD's Justify: its DxfDBText.HorizontalMode and
        DxfDBText.VerticalMode taken together, a text centred on its middle DxfAttachmentPoint.MiddleCenter;
        DxfAttachmentPoint.BaseLeft where the record gives neither."""
    @Justify.setter
    def Justify(self, value: DxfAttachmentPoint) -> None: ...
    @property
    def Normal(self) -> GeoVector3:
        """Gets or sets the normal of the plane the text stands in (groups 210, 220, 230), as AutoCAD's Normal; of
        unit length, (0, 0, 1) where the record gives none."""
    @Normal.setter
    def Normal(self, value: GeoVector3) -> None: ...
    @property
    def Oblique(self) -> float:
        """Gets or sets how far the letters lean (group 51, in degrees), as AutoCAD's Oblique: in radians, clockwise
        from upright; nought where the record gives none."""
    @Oblique.setter
    def Oblique(self, value: float) -> None: ...
    @property
    def Position(self) -> GeoPoint3:
        """Gets or sets where the text stands (groups 10, 20, 30), as AutoCAD's Position: in world coordinates, the
        file's point taken from the system of the DxfDBText.Normal's plane; the origin where the record gives
        none. An annotative text, attribute or definition stands where its context of the scale 1:1 says, else
        its default context, as AutoCAD 2021 reads one whatever CANNOSCALE says: the attribute ATT_DVSUP of
        AutoCAD's sample Mechanical - Metric, whose record says (0.678, 265.33) and whose context of 1:1 says
        (-6.151, 265.33), stands at (-6.151, 265.33), its elevation the record's, which no context holds (check
        D35)."""
    @Position.setter
    def Position(self, value: GeoPoint3) -> None: ...
    @property
    def Rotation(self) -> float:
        """Gets or sets how far the text is turned (group 50, in degrees), as AutoCAD's Rotation: in radians,
        counter-clockwise from the x axis of the system of its normal's plane; nought where the record gives
        none. An annotative one's is that of the context it is read at, as DxfDBText.Position says."""
    @Rotation.setter
    def Rotation(self, value: float) -> None: ...
    @property
    def TextString(self) -> str:
        """Gets or sets the words of the text (group 1), as AutoCAD's TextString: as the file writes them, its
        special characters such as %%d kept, but a letter written as its escape, \\U+00E9, read as the letter,
        and a caret and the character after it as AutoCAD reads them, a^Ib a, a tab and b, a^ b a^b, a^@b ending
        at a; empty where the record gives none. Those of an ATTRIB or ATTDEF of several lines are the words of
        the lines of its MTEXT joined by spaces, as AutoCAD 2021 reads both whatever their group 1 holds: the
        definition whose MTEXT reads LINE ONE\\PLINE TWO\\PLINE THREE gives LINE ONE LINE TWO LINE THREE."""
    @TextString.setter
    def TextString(self, value: str) -> None: ...
    @property
    def TextStyle(self) -> DxfTextStyleTableRecord:
        """Gets or sets the text style of the text, as AutoCAD's TextStyleId gives its id: the record of
        DxfDBText.TextStyleName in the text style table of the text's drawing; null where it has none of that
        name, or the text is in no drawing and was made in code. text.TextStyle = db.TextStyleTable[\"GH_TXT\"]
        writes 7 GH_TXT."""
    @TextStyle.setter
    def TextStyle(self, value: DxfTextStyleTableRecord) -> None: ...
    @property
    def TextStyleName(self) -> str:
        """Gets or sets the name of the text style of the text (group 7), as AutoCAD's TextStyleName: as the style
        table names it, its escapes read as letters; Standard where the record gives none."""
    @TextStyleName.setter
    def TextStyleName(self, value: str) -> None: ...
    @property
    def Thickness(self) -> float:
        """Gets or sets how far the text stands up along its DxfDBText.Normal (group 39), as AutoCAD's Thickness;
        nought where the record gives none."""
    @Thickness.setter
    def Thickness(self, value: float) -> None: ...
    @property
    def VerticalMode(self) -> DxfTextVerticalMode:
        """Gets or sets how the text stands up and down from its point (group 73 of a TEXT, 74 of an ATTRIB or
        ATTDEF), as AutoCAD's VerticalMode; DxfTextVerticalMode.TextBase where the record gives none."""
    @VerticalMode.setter
    def VerticalMode(self, value: DxfTextVerticalMode) -> None: ...
    @property
    def WidthFactor(self) -> float:
        """Gets or sets how wide the letters are against their height (group 41), as AutoCAD's WidthFactor; 1 where
        the record gives none."""
    @WidthFactor.setter
    def WidthFactor(self, value: float) -> None: ...
    def ConvertFieldToText(self) -> None:
        """Makes the text's fields words, as AutoCAD's ConvertFieldToText: the field of its words taken out with its
        children, as DxfDBObject.RemoveField takes it out, and its words (1) kept as they are, the values AutoCAD
        last gave the fields among them. Nothing where it has no field."""
    def GetTextWithFieldCodes(self) -> str:
        """Gets the words of the text with the codes of its fields in their places, as AutoCAD's
        getTextWithFieldCodes: the code of its field (DxfDBObject.GetField), each field it holds standing as its
        code in its markers, at every depth. The TEXT that reads Drawn 27/10/2026, the date a field, gives Drawn
        %<\\AcVar Date \\f \"dd/MM/yyyy\">%; one with no field gives its DxfDBText.TextString."""

class DxfDataLink(DxfDBObject):
    """A DATALINK of a DXF file, as AutoCAD's DataLink: the link of a table's cells to the data of another file, a
    spreadsheet as a rule, kept under its name in the dictionary of data links (DxfDatabase.DataLinkDictionary,
    ACAD_DATALINK) and named by the cells of the tables it fills (DxfTable.GetDataLink)."""
    @property
    def ConnectionString(self) -> str:
        """Gets where the data is (group 302), as AutoCAD's ConnectionString: for a spreadsheet its file, its sheet
        and its cells, parts.xlsx!Sheet1!A1:B3; empty where the record gives none."""
    @property
    def DataAdapterId(self) -> str:
        """Gets the data adapter that reads the link's source (group 1), as AutoCAD's DataAdapterId: AcExcel for a
        spreadsheet; empty where the record gives none."""
    @property
    def DataLinkOption(self) -> DxfDataLinkOption:
        """Gets how the link is kept (group 90), as AutoCAD's DataLinkOption: 3 for DxfDataLinkOption.Anonymous and
        DxfDataLinkOption.PersistCache; DxfDataLinkOption.None where the record gives none."""
    @property
    def Description(self) -> str:
        """Gets the description of the link (group 300), as AutoCAD's Description; empty where the record gives
        none."""
    @property
    def IsValid(self) -> bool:
        """Gets whether the link can be updated, as AutoCAD's IsValid tells it: it names a data adapter
        (DxfDataLink.DataAdapterId) and where its data is (DxfDataLink.ConnectionString), and is not erased.
        Whether the source is there is not looked at."""
    @property
    def Name(self) -> str:
        """Gets or sets the name of the link, as AutoCAD's Name: the name of its entry in the dictionary that holds
        it, such as Parts; null for a link in no dictionary."""
    @Name.setter
    def Name(self, value: str) -> None: ...
    @property
    def ToolTip(self) -> str:
        """Gets the tooltip the linked cells show (group 301), as AutoCAD's ToolTip, such as Data source file:
        parts.xlsx; empty where the record gives none."""
    @property
    def UpdateOption(self) -> int:
        """Gets how the link is updated (group 91), as AutoCAD's UpdateOption, the flags as one number; nought where
        the record gives none. LibreDWG's example gives 1 179 649: AutoCAD's SkipFormat (0x20000) and
        AllowSourceUpdate (0x100000) make 1 179 648, and the 0x1 left over is no flag of AutoCAD's UpdateOption."""
    def GetTargets(self) -> System.Collections.Generic.IReadOnlyList[DxfTable]:
        """Gets the tables the link fills, as AutoCAD's GetTargets gives their ids: every table of the drawing, in
        model space, paper space or a block, a range of whose cells names the link, in the order of the blocks
        and of their entities; none for a link erased. The drawing is walked once."""
    def GetUpdateStatus(self) -> tuple[int, DxfUpdateDirection, System.DateTime, str]:
        """Gets how the link was last updated, as AutoCAD's GetUpdateStatus: which way (group 92), when (170 to
        176), how it went (93, nought for one that went well, as AutoCAD's ErrorStatus numbers it) and the
        message of that (the 304 before the count 94). LibreDWG names the 92 and the 93 no further, so which way
        and how it went are the library's reading of them. A link never updated, its year nought, gives
        DateTime.MinValue."""
    def ToString(self) -> str:
        """Gives the link as a line for debugging: its type, its handle and its name."""

class DxfDataLinkOption(System.Enum):
    """How a data link is kept, as AutoCAD's DataLinkOption flags it (group 90 of a DATALINK)."""
    Anonymous: ClassVar[DxfDataLinkOption]
    """The link has no name of its own to be shown by, 1."""
    PersistCache: ClassVar[DxfDataLinkOption]
    """The data last read from the source is kept with the drawing, 2."""
    def __init__(self, value: int) -> None: ...
    def __and__(self, other: DxfDataLinkOption) -> DxfDataLinkOption: ...
    def __int__(self) -> int: ...
    def __invert__(self) -> DxfDataLinkOption: ...
    def __or__(self, other: DxfDataLinkOption) -> DxfDataLinkOption: ...
    def __xor__(self, other: DxfDataLinkOption) -> DxfDataLinkOption: ...

class DxfDataType(System.Enum):
    """What kind of value a cell of a table holds, as AutoCAD's DataType numbers it: group 90 of the cell's value
    (301 CELL_VALUE), from R2007 on. A cell of 12.5 is DxfDataType.Double, one of Parts DxfDataType.String."""
    Buffer: ClassVar[DxfDataType]
    """Bytes, 128."""
    Date: ClassVar[DxfDataType]
    """A date, 8."""
    Double: ClassVar[DxfDataType]
    """A number, 2: in group 140."""
    General: ClassVar[DxfDataType]
    """Any of the others, 512."""
    Long: ClassVar[DxfDataType]
    """A whole number of 32 bits, 1: its number in group 91."""
    ObjectId: ClassVar[DxfDataType]
    """An object of the drawing, 64."""
    Point: ClassVar[DxfDataType]
    """A point of the plane, 16."""
    Point3d: ClassVar[DxfDataType]
    """A point in space, 32."""
    Resbuf: ClassVar[DxfDataType]
    """A list of groups, 256."""
    String: ClassVar[DxfDataType]
    """A text, 4: in group 1, in pieces of 2 where it is long."""
    Unknown: ClassVar[DxfDataType]
    """Unknown, 0."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class DxfDataTypeParameter(System.ValueType):
    """The kind of a cell's value and what its number measures, together, as AutoCAD's DataTypeParameter: a cell of
    12.5 mm has DxfDataType.Double and DxfUnitType.Distance."""
    def __init__(self, dataType: DxfDataType, unitType: DxfUnitType) -> None:
        """Initializes the pair, as AutoCAD's new DataTypeParameter(dataType, unitType)."""
    @property
    def DataType(self) -> DxfDataType:
        """Gets the kind of value, as AutoCAD's DataType."""
    @property
    def UnitType(self) -> DxfUnitType:
        """Gets what its number measures, as AutoCAD's UnitType."""
    @overload
    def Equals(self, other: DxfDataTypeParameter) -> bool:
        """Gets whether the pair is another, kind and unit alike."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Gets whether an object is a pair of the same kind and unit."""
    def GetHashCode(self) -> int:
        """Gets a hash of the kind and the unit."""
    def ToString(self) -> str:
        """Gives the pair as a line for debugging: Double, Distance."""

class DxfDatabase(System.Object):
    """Copying entities of the drawing together, as AutoCAD's Database.WblockCloneObjects copies the objects of ids.

    A DXF file opened to be edited and saved again, as AutoCAD's Database is a drawing: its model space, paper
    space and blocks, its layers and linetypes, and its header; every byte of what is not changed kept as it was
    read.

    The dimension variables AutoCAD's Database has as properties, those new dimensions take, each a variable of
    the HEADER section read and set as DxfDatabase.Ltscale is: DxfDatabase.Dimasz is $DIMASZ,
    DxfDatabase.Dimfxlen$DIMFXL. Where the header gives none, the value of AutoCAD's metric drawing
    (acadiso.dwt), which a new drawing of ezdxf 1.4.5 is given too: arrowheads and texts 2.5, extension lines
    1.25 past the dimension line and 0.625 off the points, a gap of 0.625, two decimal places, a comma, trailing
    zeros left out, the text above the line. A variable R2000 (AC1015), R2004 (AC1018), R2007 (AC1021) or R2010
    (AC1024) brought is refused in a file of an older version, as AutoCAD writes none there, and reads there as a
    dimension style of that file reads it, AutoCAD's own of acad.dwt (DIMDEC 4, DIMDSEP '.' and no text style in
    a file of R12), so that the header's data and a style's agree. Values are as AutoCAD's .NET gives them, as
    DxfDimStyleTableRecord's are: a colour as a DxfColor, an arrowhead as the block it is drawn with (the header
    naming it), a linetype or the text style as its record; DxfDatabase.Dimjogang in radians, as the header holds
    it. DxfDatabase.GetDimstyleData gives them as a style in no table, and DxfDatabase.SetDimstyleData takes
    those of a style.

    The settings of display and modelling in 3D AutoCAD's Database has as properties, each a variable of the
    HEADER section read and set as DxfDatabase.Ltscale is: shading, hidden lines and their colours, the frames of
    underlays and clipped references, cameras and walking, lofting, the place under the sun, shadows, materials
    and visual styles. Where the header gives none, the value a new drawing of ezdxf 1.4.5 is given, but for the
    size of a polysolid, which is that of AutoCAD's metric drawing, and the objects named, which are null. A
    variable R2004 (AC1018) or R2007 (AC1021) brought is refused in a file of an older version, as AutoCAD writes
    none there.

    What AutoCAD's Database keeps in the extension dictionaries of model space and of the layer table: the
    drawing's geographic location, its layer filters and its layer states.

    Linetypes and multiline styles loaded from AutoCAD's files of them, as AutoCAD's Database loads them.

    The fonts the drawing's words are measured in, as AutoCAD finds them on its support path.

    The variables of the header AutoCAD's Database has as properties, each read from its variable of the HEADER
    section and set in it, every other byte of the header kept; where the header gives none, the value a new
    drawing of ezdxf 1.4.5 is given. Set to the value it has, a variable changes nothing; one the header has not
    is added at its end.

    Keeping the drawing tidy, as AutoCAD's Database does: its empty objects counted and erased, the references to
    its objects counted, what nothing uses found for purging, and its extents worked out anew.

    Another drawing inserted into this one, as AutoCAD's Database.Insert inserts a database.

    Multiline styles made in code, as AutoCAD's MlineStyle is added to the dictionary of multiline styles.

    The objects of the OBJECTS section AutoCAD's Database reaches by their ids: the named object dictionary and
    the dictionaries named in it, the layouts, and the properties of the drawing (DWGPROPS).

    The hatch pattern files the drawing's hatches take their lines from, as AutoCAD finds them on its support
    path.

    Repairing a drawing, as AutoCAD's RECOVER opens a damaged file and its AUDIT checks an open drawing.

    The settings of drafting AutoCAD's Database has as properties, each a variable of the HEADER section read and
    set as DxfDatabase.Ltscale is: chamfers and fillets, elevation and thickness, multilines, the limits and
    extents of paper space, the user's own variables, the modes of the drawing and what it says of itself. Where
    the header gives none, the value a new drawing of ezdxf 1.4.5 is given, but for the extents of paper space,
    the origin as for model space, the maintenance release, nought, and the multiline style, null where the
    drawing has none of the name. A variable R2000 (AC1015) or R2004 (AC1018) brought is refused in a file of an
    older version, as AutoCAD writes none there; it reads as where the header gives none. A text is read as the
    header writes it, its spaces kept.

    The times the header keeps, as AutoCAD's Database gives them: when the drawing was made and last saved, how
    long it has been edited, and the time zone of its place. A date is written as AutoCAD writes it, a Julian day
    and the part of the day gone since midnight: 2451545.75 is 1 January 2000 at 18:00.

    The user coordinate systems of model space and paper space the header keeps, as AutoCAD's Database has them:
    the current one's origin and axes ($UCSORG, $UCSXDIR, $UCSYDIR, and $PUCS of paper space), its name, the UCS
    the orthographic ones are taken from, and the origins of those six. A UCS is given by the name of its record
    of the UCS table, DxfDatabase.UcsTable.

    The system variables AutoCAD's Database has as properties and keeps out of the HEADER section: each a
    DICTIONARYVAR of the dictionary AcDbVariableDictionary of the named object dictionary, its value the text of
    its group 1, as AutoCAD writes it; or the header's variable of the same name, where a file keeps one there.
    Where the drawing gives none, the value AutoCAD gives a new drawing.

    The external references of the drawing, as AutoCAD's Database attaches, overlays and detaches them."""
    def __init__(self, version: str) -> None:
        """Makes a new drawing with nothing in it, of a version, as AutoCAD's new Database(true, true) makes one of
        its own: the drawing DxfWriter writes with no shape, in millimetres, with model space and paper space,
        two layouts, the layer 0, the text style Standard, the dimension styles Standard and ISO-25 and the named
        object dictionary, its header naming the version given ($ACADVER) and its records giving what that
        version added to them, as AutoCAD writes them: from R2004 on how many objects of each class there are,
        without which AutoCAD opens no drawing of those versions, and the layouts' shade plot; from R2007 on the
        unit, explodability and scaling of model space and paper space. new DxfDatabase(\"AC1024\") is a drawing
        of R2010, the oldest a dynamic block is made in (DxfBlockTableRecord.AddLinearParameter); \"AC1015\"
        gives the very text new DxfWriter().ToString() gives, but for ISO-25 (below) and the code page its header
        names after the version ($DWGCODEPAGE ANSI_1252), as AutoCAD's own empty drawings of every version from
        R2000 name it: so that a reader that goes by it, as ezdxf does, takes the text of a drawing of R2007 or
        later, Korean text copied into it among it, for the UTF-8 it is written in, which it took for ANSI_1252
        without it.

        ISO-25 is current, as in AutoCAD 2021's metric template acadiso.dwt saved as each of these versions:
        $DIMSTYLE names it and the header and the style hold the same values, arrowheads and text 2.5, a gap of
        0.625, two decimal places and a decimal comma, each of the 20 that differ from AutoCAD's own written into
        both, as AutoCAD writes them; Standard holds AutoCAD's own (arrowheads 0.18), as acadiso.dwt's does. So
        DxfDatabase.GetDimstyleData gives ISO-25 in every variable, and AutoCAD, which reads a variable the
        header leaves out as its imperial drawing has it, reads the same."""
    @property
    def AllowExtendedNames(self) -> bool:
        """Gets or sets whether the names of layers, linetypes and the other records may be up to 255 letters long
        and hold spaces ($EXTNAMES of 1), as AutoCAD's AllowExtendedNames; true where the header gives none. Set
        to false, the names already given are kept."""
    @AllowExtendedNames.setter
    def AllowExtendedNames(self, value: bool) -> None: ...
    @property
    def Angbase(self) -> float:
        """Gets or sets the direction angles are measured from ($ANGBASE), in radians as AutoCAD's Angbase: the
        header writes degrees, 90 being pi / 2; nought where it gives none."""
    @Angbase.setter
    def Angbase(self, value: float) -> None: ...
    @property
    def Angdir(self) -> bool:
        """Gets or sets whether angles grow clockwise ($ANGDIR of 1); counter-clockwise where the header gives
        none."""
