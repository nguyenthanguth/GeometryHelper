class DxfMText(DxfEntity):
    """An MTEXT of a DXF file, as AutoCAD's MText: words of several lines with their formatting, held at
    DxfMText.Location by its DxfMText.Attachment, DxfMText.TextHeight high, wrapping at DxfMText.Width, reading
    along DxfMText.Direction in the plane of its DxfMText.Normal."""
    def __init__(self) -> None:
        """Initializes an MTEXT with no words at the origin, 2.5 high, held at its top left, as AutoCAD's new
        MText(), on layer 0 in the text style Standard, in no file; give it its words and place before it is
        drawn."""
    @property
    def ActualHeight(self) -> float:
        """Gets the height the MTEXT's words take, as AutoCAD's ActualHeight: where DxfMText.ActualWidth measures
        them, from the top of the first line to the foot of the last, as AutoCAD 2021 lays them out (checks F1a
        and F4): a line of one height from the lower of its baseline and the bottom of its ink up to the higher
        of the height of its letters and the top of its ink, a line drawn under them a fifth of their height
        below the baseline and over them a fifth above their height: \"ABC\" of txt.shx 4 high is 4 high, and
        \"g\" 5.333. With its line spacing at least (group 73 of 1), the top of each line is the factor (44)
        times the top of the line before, a third of that line's height and a third of the MTEXT's
        DxfMText.TextHeight below the top of the line before it, so that \"ABC\\PDE\" 4 high is 10.667 high and
        \"ABC\\P{\\H3x;ABC}\\PDEF\" 28; spaced exactly (2), the MTEXT is its height, the spacing of each line
        after the first and a third of its height high, whatever its letters: \"ABC\\PDE\" 12. An empty paragraph
        at the end is no line: \"ABC\\P\" is 4 high, \"ABC\\P\\P\" 10.667. Elsewhere, group 43 as the file writes
        it; nought where it gives none."""
    @property
    def ActualWidth(self) -> float:
        """Gets the width the MTEXT's words take, as AutoCAD's ActualWidth: where the drawing's
        DxfDatabase.FontSearchPath finds the SHX or TrueType font of its style, the width of its widest line,
        laid out as AutoCAD 2021 lays them out (checks F1a, F2 and F4): a line from its first ink, or its start
        where it starts with a space, to the ink of its last letter that is no space, the spaces after it left
        out, a line of spaces alone as wide as they move the pen: \"ABC\" of txt.shx 4 high is 10.667 wide, and
        \" ABC\" 22.667; of a TrueType font, ink left of the line's start not counted, \"A\" of arial.ttf 4 high
        3.735 wide, from 0. The lines are its paragraphs (\\P), wrapped at its DxfMText.Width where it has one:
        \"The quick brown fox jumps over the lazy dog and keeps on running\" of txt.shx 4 high, 41 wide, is seven
        lines, the widest 38. Elsewhere, group 42 as the file writes it; nought where it gives none."""
    AlignChange: ClassVar[str]
    """Gets the code that sets how the letters stand on the line, as AutoCAD's AlignChange: \\A, followed by 0, 1 or
    2 for the bottom, the middle and the top and a semicolon, \\A1;."""
    @property
    def Attachment(self) -> DxfAttachmentPoint:
        """Gets or sets the point the MTEXT is held by (group 71), as AutoCAD's Attachment;
        DxfAttachmentPoint.TopLeft where the record gives none. An annotative MTEXT's is that of the context it
        is read at (its 70), as DxfMText.Location says: AutoCAD 2021 read one whose record says 1 and whose
        context of 1:1 says 5 as held by its middle (check D35b)."""
    @Attachment.setter
    def Attachment(self, value: DxfAttachmentPoint) -> None: ...
    @property
    def BackgroundFill(self) -> bool:
        """Gets or sets whether a background is drawn behind the words (flag 1 of group 90), as AutoCAD's
        BackgroundFill."""
    @BackgroundFill.setter
    def BackgroundFill(self, value: bool) -> None: ...
    @property
    def BackgroundFillColor(self) -> DxfColor:
        """Gets or sets the colour of the background (group 63, and 421 for red, green and blue, 431 for its book's
        name), as AutoCAD's BackgroundFillColor; null where the record gives none."""
    @BackgroundFillColor.setter
    def BackgroundFillColor(self, value: DxfColor | None) -> None: ...
    @property
    def BackgroundScaleFactor(self) -> float:
        """Gets or sets how far the background reaches past the words, against their height (group 45), as AutoCAD's
        BackgroundScaleFactor; 1.5 where the record gives none, as AutoCAD gives it."""
    @BackgroundScaleFactor.setter
    def BackgroundScaleFactor(self, value: float) -> None: ...
    @property
    def BackgroundTransparency(self) -> DxfTransparency:
        """Gets or sets how see-through the background of the MTEXT is (group 441), as AutoCAD's
        BackgroundTransparency: written as group 440 of an entity is, 0x02000000 and the alpha for an alpha,
        0x01000000 for by block; by layer where the record gives none. AutoCAD and BricsCAD keep it but draw
        nothing by it, as ezdxf notes."""
    @BackgroundTransparency.setter
    def BackgroundTransparency(self, value: DxfTransparency) -> None: ...
    BlockBegin: ClassVar[str]
    """Gets the brace that opens a group of words whose formatting ends with it, as AutoCAD's BlockBegin: {, as in
    {\\H2x;Big} small."""
    BlockEnd: ClassVar[str]
    """Gets the brace that closes a group of words opened by DxfMText.BlockBegin, as AutoCAD's BlockEnd: }."""
    ColorChange: ClassVar[str]
    """Gets the code that sets the colour of the letters, as AutoCAD's ColorChange: \\C, followed by an AutoCAD
    colour index and a semicolon, \\C1; for red."""
    @property
    def ColumnAutoHeight(self) -> bool:
        """Gets or sets whether the columns are all of one height, the MTEXT's DxfMText.Height (group 73 of its
        embedded object, 79 of its extended data), as AutoCAD's ColumnAutoHeight; false where it gives none."""
    @ColumnAutoHeight.setter
    def ColumnAutoHeight(self, value: bool) -> None: ...
    @property
    def ColumnCount(self) -> int:
        """Gets or sets how many columns the MTEXT has (group 72 of its embedded object, 76 of its extended data),
        as AutoCAD's ColumnCount: where the embedded object gives none, as for dynamic columns of auto height,
        worked out from the width of all the columns (42) as ezdxf works it out; nought where the MTEXT has no
        columns."""
    @ColumnCount.setter
    def ColumnCount(self, value: int) -> None: ...
    @property
    def ColumnFlowReversed(self) -> bool:
        """Gets or sets whether the columns run from right to left (group 74 of its embedded object, 78 of its
        extended data), as AutoCAD's ColumnFlowReversed; false where it gives none."""
    @ColumnFlowReversed.setter
    def ColumnFlowReversed(self, value: bool) -> None: ...
    @property
    def ColumnGutterWidth(self) -> float:
        """Gets or sets the space between the columns (group 45 of its embedded object, 49 of its extended data), as
        AutoCAD's ColumnGutterWidth; nought where it gives none."""
    @ColumnGutterWidth.setter
    def ColumnGutterWidth(self, value: float) -> None: ...
    @property
    def ColumnType(self) -> DxfColumnType:
        """Gets or sets how the MTEXT is set in columns, as AutoCAD's ColumnType: from its embedded object from
        R2018 (group 71), else from its extended data of ACAD (75), as ezdxf reads them; DxfColumnType.NoColumns
        where it gives none. In a file older than R2007 (AC1021), which brought columns, the extended data are
        columns only with the MTEXTs of the later columns they link (ACAD_MTEXT_COLUMNS), as AutoCAD and ezdxf
        write them: AutoCAD 2021 read three MTEXTs of R2000 given the column data alone, two static columns 50
        wide among them, as of no columns, each 50 wide (DxfMText.Width), the one of a defined height of 15 that
        high (DxfMText.Height)."""
    @ColumnType.setter
    def ColumnType(self, value: DxfColumnType) -> None: ...
    @property
    def ColumnWidth(self) -> float:
        """Gets or sets how wide each column is (group 44 of its embedded object, 48 of its extended data), as
        AutoCAD's ColumnWidth; nought where it gives none."""
    @ColumnWidth.setter
    def ColumnWidth(self, value: float) -> None: ...
    @property
    def Contents(self) -> str:
        """Gets or sets the words of the MTEXT with their formatting (groups 3 and 1), as AutoCAD's Contents: as the
        file writes them, \\P a new paragraph, {\\H1.5x;Big} letters half as high again, but each escape of four
        digits read as the letter it stands for before the formatting, as AutoCAD 2021 reads it in a file of any
        version: a\\U+0110b gives aĐb, \\U+D83D\\U+DE00 the letter beyond U+FFFF of those two halves, \\U+0041 an
        A, \\\\U+0110 a backslash and Đ, and \\U+005CP the code of a new paragraph. \\U+0000 and an escape of
        fewer digits are kept as written. A caret and the character after it are read first, as AutoCAD reads
        them: a^Jb gives a, a line feed and b, a^ b gives a^b, and a^@b ends at a. Empty where the record gives
        none. Before R2018 an MTEXT whose later columns are MTEXTs of their own holds only the words of its
        first: those of the others are in their MTEXTs, as AutoCAD and ezdxf keep them."""
    @Contents.setter
    def Contents(self, value: str) -> None: ...
    @property
    def ContentsRTF(self) -> str:
        """Gets or sets the words of the MTEXT as RTF, as AutoCAD's ContentsRTF: its DxfMText.Contents written as a
        document of RTF and read back from one, as DxfMText.SetContentsRtf reads it."""
    @ContentsRTF.setter
    def ContentsRTF(self, value: str) -> None: ...
    @property
    def Direction(self) -> GeoVector3:
        """Gets or sets the direction the MTEXT reads along (groups 11, 21, 31), as AutoCAD's Direction: in world
        coordinates, of unit length; where the record gives none, the x axis of the system of its plane turned by
        its angle (50); where it gives no angle either, the world's x axis put into its plane, as AutoCAD 2021
        reads it (check mirror-3 GHM3A): (1, 0, 0) on the normal (0, 0, -1), whose x axis is the world's -x, and
        (0.8, 0, 0.6) on (0.6, 0, -0.8); the x axis of the system of its plane where the plane holds no part of
        the world's x axis, as on the normal (1, 0, 0). An annotative MTEXT's is that of the context it is read
        at (its 10, 20, 30), as DxfMText.Location says."""
    @Direction.setter
    def Direction(self, value: GeoVector3) -> None: ...
    @property
    def FlowDirection(self) -> DxfFlowDirection:
        """Gets or sets which way the lines follow one another (group 72), as AutoCAD's FlowDirection;
        DxfFlowDirection.LeftToRight where the record gives none."""
    @FlowDirection.setter
    def FlowDirection(self, value: DxfFlowDirection) -> None: ...
    FontChange: ClassVar[str]
    """Gets the code that sets the font, as AutoCAD's FontChange: \\F, followed by the font's file and a semicolon,
    \\Fromans.shx;; a TrueType font by its name is \\f, \\fArial|b1|i0;."""
    @property
    def GeometricExtents(self) -> GeoAabb3:
        """Gets the box the MTEXT fills, as AutoCAD's GeometricExtents: where DxfMText.ActualWidth measures its
        words, the box AutoCAD 2021 gives it (check F4), as wide as its DxfMText.Width, or its
        DxfMText.ActualWidth where it has none, and DxfMText.ActualHeight high, held at its DxfMText.Location by
        its DxfMText.Attachment, along its DxfMText.Direction in the plane of its DxfMText.Normal: \"ABC\\PDE\"
        of txt.shx 4 high, 41 wide, held at its top left at (10, 20, 0), from (10, 9.333, 0) to (51, 20, 0).
        Elsewhere as DxfEntity.GeometricExtents gives it."""
    @property
    def Height(self) -> float:
        """Gets or sets the height of the box the MTEXT is given (group 46), as AutoCAD's Height; where the record
        gives none, the height of its columns of one height, from its embedded object (41) or its extended data
        of ACAD (ACAD_MTEXT_DEFINED_HEIGHT), as ezdxf reads it; nought where it gives neither, and from R2007 for
        dynamic columns of their own heights, whose ACAD_MTEXT_DEFINED_HEIGHT is the first column's, as AutoCAD
        2021 writes and reads it. A file older than R2007 (AC1021) has no group 46, and its height is that of the
        extended data whatever the columns: the MTEXT of R2000 in three static columns 30 high has the height 30,
        and AutoCAD 2021 read its own R2000 MTEXT in dynamic columns 15, 25 and 0 high, of the defined height 15,
        as 15 high (its 09-a). An annotative MTEXT's is that of the context it is read at (its 41), as its
        DxfMText.Width is."""
    @Height.setter
    def Height(self, value: float) -> None: ...
    HeightChange: ClassVar[str]
    """Gets the code that sets the height of the letters, as AutoCAD's HeightChange: \\H, followed by a height and a
    semicolon, \\H3.5;, or a factor of the height with an x, \\H1.5x;."""
    LineBreak: ClassVar[str]
    """Gets the code that breaks the line, as AutoCAD's LineBreak: \\P, the one break an MTEXT has, the same as
    DxfMText.ParagraphBreak."""
    @property
    def LineSpaceDistance(self) -> float:
        """Gets or sets the distance from one line of the MTEXT to the next, as AutoCAD's LineSpaceDistance: the
        DxfMText.LineSpacingFactor times single spacing, which is 5/3 of the DxfMText.TextHeight, as AutoCAD
        spaces lines: 5 for letters 3 high at a factor of 1."""
    @LineSpaceDistance.setter
    def LineSpaceDistance(self, value: float) -> None: ...
    @property
    def LineSpacingFactor(self) -> float:
        """Gets or sets the spacing of the lines against that of the text style (group 44), as AutoCAD's
        LineSpacingFactor; 1 where the record gives none."""
    @LineSpacingFactor.setter
    def LineSpacingFactor(self, value: float) -> None: ...
    @property
    def LineSpacingStyle(self) -> DxfLineSpacingStyle:
        """Gets or sets how the spacing of the lines is taken (group 73), as AutoCAD's LineSpacingStyle;
        DxfLineSpacingStyle.AtLeast where the record gives none."""
    @LineSpacingStyle.setter
    def LineSpacingStyle(self, value: DxfLineSpacingStyle) -> None: ...
    @property
    def Location(self) -> GeoPoint3:
        """Gets or sets where the MTEXT is held (groups 10, 20, 30), as AutoCAD's Location: in world coordinates, as
        the file writes it; the origin where the record gives none. An annotative MTEXT is held where its context
        of the scale 1:1 says (its 11, 21, 31), else its default context, as AutoCAD 2021 reads one whatever
        CANNOSCALE says, and as DxfDBText.Position reads a text: one whose record says (10, 40) and whose context
        of 1:1 says (14, 44) is held at (14, 44) (check D35b). Its DxfMText.Direction, DxfMText.Rotation,
        DxfMText.Width, DxfMText.Height and DxfMText.Attachment are that context's too, and its
        DxfMText.TextHeight that of its scale."""
    @Location.setter
    def Location(self, value: GeoPoint3) -> None: ...
    NonBreakSpace: ClassVar[str]
    """Gets the code of a space the line is not broken at, as AutoCAD's NonBreakSpace: \\~."""
    @property
    def Normal(self) -> GeoVector3:
        """Gets or sets the normal of the plane the MTEXT stands in (groups 210, 220, 230), as AutoCAD's Normal; of
        unit length, (0, 0, 1) where the record gives none."""
    @Normal.setter
    def Normal(self, value: GeoVector3) -> None: ...
    ObliqueChange: ClassVar[str]
    """Gets the code that slants the letters, as AutoCAD's ObliqueChange: \\Q, followed by the angle in degrees and
