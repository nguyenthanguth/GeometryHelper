        """Gets whether the cell is another, of the same table, row and column."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Gets whether an object is a cell of the same table, row and column."""
    def GetExtents(self) -> System.Collections.Generic.IReadOnlyList[GeoPoint3]:
        """Gets the corners of the cell, as AutoCAD's GetExtents: DxfTable.GetCellExtents of the cell alone."""
    def GetHashCode(self) -> int:
        """Gets a hash of the row and the column."""
    def GetMergeRange(self) -> DxfCellRange:
        """Gets the block of merged cells the cell is in, as AutoCAD's GetMergeRange: DxfTable.GetMergeRange."""
    def ResetValue(self) -> None:
        """Empties the cell's value, as AutoCAD's ResetValue: DxfTable.ResetValue, a block cell made a text cell of
