    StrikethroughOff: ClassVar[str]
    """Gets the code that ends a line through the letters, as AutoCAD's StrikethroughOff: \\k."""
    StrikethroughOn: ClassVar[str]
    """Gets the code that begins a line through the letters, as AutoCAD's StrikethroughOn: \\K."""
