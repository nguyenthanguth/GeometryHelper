    def Description(self, value: str) -> None: ...
    @property
    def HasOverrides(self) -> bool:
        """Gets whether the layer looks otherwise in some viewport, as AutoCAD's HasOverrides: whether an XRECORD of
        its extension dictionary that AutoCAD keeps overrides in (ADSK_XREC_LAYER_COLOR_OVR,
        ADSK_XREC_LAYER_LINETYPE_OVR, ADSK_XREC_LAYER_LINEWT_OVR, ADSK_XREC_LAYER_ALPHA_OVR,
        ADSK_XREC_LAYER_PLOTSTYLE_OVR) names a viewport."""
