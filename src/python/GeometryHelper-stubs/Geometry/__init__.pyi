    def __init__(self, startPoint: GeoPoint2, endPoint: GeoPoint2) -> None:
        """Initializes a straight edge between two points."""
    @overload
    def __init__(self, startPoint: GeoPoint2, endPoint: GeoPoint2, bulge: float) -> None:
        """Initializes an edge between two points, straight or bulged into an arc."""
    @property
