class GeoTransform2(System.Object):
    """Represents a 2D transformation as a 3x3 homogeneous matrix, covering translation, rotation, scaling and
    mirroring.

    The matrix is stored row-major and applied on the left, so a.Multiply(b) means \"apply b, then a\", the usual
    convention for column vectors. Instances are immutable: every operation returns a new transformation rather
    than changing this one. It is the counterpart in the plane of GeoTransform3, and the two are built and read
    the same way."""
    @overload
    def __init__(self) -> None:
        """Initializes an identity transformation."""
