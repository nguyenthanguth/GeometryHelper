class GeoEdge3(System.ValueType):
    """Whether an edge touches another shape.

    One piece of a chain in space: a straight segment, or an arc bulging in a plane of its own.

    How far an edge is from another shape, and how deep inside one it sits.

    Where an edge crosses another shape.

    The point of an edge nearest another shape, the shortest segment joining the two, and which edge of it faces
    one.

    An edge asked about a ball: how far apart they are, whether they touch, where they cross, and where the
    shortest segment between them runs.

    An edge asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs.

    An edge asked whether it touches an infinite line and where they cross, as a segment or an arc by its kind."""
    @overload
    def __init__(self, arc: GeoArc3) -> None:
        """Initializes an edge from an arc in space."""
    @overload
    def __init__(self, startPoint: GeoPoint3, endPoint: GeoPoint3) -> None:
        """Initializes a straight edge between two points."""
    @overload
    def __init__(self, startPoint: GeoPoint3, endPoint: GeoPoint3, bulge: float, normal: GeoVector3) -> None:
        """Initializes an edge between two points, bulging by a given amount in a given plane."""
    @overload
    def __init__(
        self,
        startPoint: GeoPoint3,
        endPoint: GeoPoint3,
        bulge: float,
        normal: GeoVector3,
        tolerance: Tolerance,
    ) -> None:
        """Initializes an edge between two points, bulging by a given amount in a given plane, within a
        tolerance."""
    @property
    def Bulge(self) -> float:
        """Gets the bulge: the tangent of a quarter of the swept angle, nought for a straight segment."""
    @property
