class GeoTransform3(System.Object):
    """Represents a 3D transformation as a 4x4 homogeneous matrix, covering translation, rotation, scaling and
    mirroring.

    The matrix is stored row-major and applied on the left, so a.Multiply(b) means \"apply b, then a\", the usual
    convention for column vectors. Instances are immutable: every operation returns a new transformation rather
    than changing this one."""
    @overload
    def __init__(self) -> None:
        """Initializes an identity transformation."""
    @overload
    def __init__(self, matrix: Any) -> None:
        """Initializes a transformation from a 4x4 matrix."""
    Identity: ClassVar[GeoTransform3]
    """Gets the identity transformation, which leaves everything where it is."""
    def __getitem__(self, row: int, column: int) -> float:
        """Gets the matrix entry at a row and column, counted from zero."""
    def Clone(self) -> GeoTransform3:
        """Creates a copy of this transformation."""
    @overload
    def Equals(self, other: GeoTransform3) -> bool:
        """Determines whether another transformation has exactly the same matrix entries."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Determines whether the specified object is equal to the current transformation."""
    @staticmethod
    def FromCoordinateSystem(system: GeoCoordinateSystem3) -> GeoTransform3:
        """Creates the transformation that takes local coordinates of a coordinate system into world coordinates."""
    def GetDeterminant(self) -> float:
        """Gets the determinant of the matrix."""
    def GetHashCode(self) -> int:
        """Returns the hash code for this instance."""
    @overload
    def Inverse(self) -> GeoTransform3:
        """Gets the transformation that undoes this one, using the default tolerance."""
    @overload
    def Inverse(self, tolerance: Tolerance) -> GeoTransform3:
        """Gets the transformation that undoes this one, within a tolerance."""
    @overload
    def IsEqualTo(self, other: GeoTransform3) -> bool:
        """Compares whether this transformation equals another within a tolerance."""
    @overload
    def IsEqualTo(self, other: GeoTransform3, tolerance: Tolerance) -> bool:
        """Compares whether this transformation equals another within a tolerance."""
    @overload
    def IsIdentity(self) -> bool:
        """Checks whether this transformation leaves everything where it is, within a tolerance."""
    @overload
    def IsIdentity(self, tolerance: Tolerance) -> bool:
        """Checks whether this transformation leaves everything where it is, within a tolerance."""
    @staticmethod
    def Mirror(plane: GeoPlane3) -> GeoTransform3:
        """Creates a mirroring across a plane."""
    def Multiply(self, other: GeoTransform3) -> GeoTransform3:
        """Combines this transformation with another one."""
    @overload
    @staticmethod
    def RotationAxis(axis: GeoVector3, angleRad: float) -> GeoTransform3:
        """Creates a rotation around an arbitrary axis through the world origin."""
    @overload
    @staticmethod
    def RotationAxis(axisOrigin: GeoPoint3, axisDirection: GeoVector3, angleRad: float) -> GeoTransform3:
        """Creates a rotation around an arbitrary axis line, so the rotation is not restricted to axes passing
        through the world origin."""
    @staticmethod
    def RotationX(angleRad: float) -> GeoTransform3:
        """Creates a rotation around the world X axis."""
    @staticmethod
    def RotationY(angleRad: float) -> GeoTransform3:
        """Creates a rotation around the world Y axis."""
    @staticmethod
    def RotationZ(angleRad: float) -> GeoTransform3:
        """Creates a rotation around the world Z axis."""
    @overload
    @staticmethod
    def Scaling(factor: float) -> GeoTransform3:
        """Creates a uniform scaling about the world origin."""
    @overload
    @staticmethod
    def Scaling(center: GeoPoint3, factor: float) -> GeoTransform3:
        """Creates a uniform scaling about a given centre."""
    @overload
    @staticmethod
    def Scaling(factorX: float, factorY: float, factorZ: float) -> GeoTransform3:
        """Creates a scaling about the world origin with a separate factor per axis."""
    @staticmethod
    def ToCoordinateSystem(system: GeoCoordinateSystem3) -> GeoTransform3:
        """Creates the transformation that takes world coordinates into the local coordinates of a coordinate
        system, the reverse of GeoTransform3.FromCoordinateSystem."""
    def ToString(self) -> str:
        """Returns a string that represents the current transformation."""
    @overload
