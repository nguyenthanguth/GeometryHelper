class GeoEllipse2(System.ValueType):
    """Whether an ellipse touches another shape.

    Represents a 2D ellipse: a centre, the direction of its major axis, and its two radii.

    An ellipse is a region, as a circle is: it has an area, and a point inside it is in it. Its rim is walked by
    the eccentric angle t, the point Center + a cos t MajorAxis + b sin t MinorAxis, counter-clockwise from the
    end of the major axis. That is not the direction seen from the centre: on an ellipse 300 by 100, t = 45° is
    the point (212.1, 70.7), which lies 18.4° from the axis seen from the centre. An ellipse whose radii are
    equal is a circle and answers every question as GeoCircle2 does, but for where its angle starts, which
    follows its axis; the point of the rim nearest its centre, which is the end of the minor axis as for any
    other ellipse; and where it touches a circle or another ellipse from outside without crossing, which is
    midway between the two rims, where two circles of different radii touch at a point nearer the larger.

    The operations live in Ellipse2; the members here ask it.

    How far an ellipse is from another shape, and how deep inside it a point sits.

    Where the rim of an ellipse crosses another shape.

    The point of the rim of an ellipse nearest a point, the shortest segment joining its rim to another shape,
    and which edge of a shape lies nearest it.

    An ellipse asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs."""
    def __init__(self, center: GeoPoint2, majorAxis: GeoVector2, majorRadius: float, minorRadius: float) -> None:
        """Initializes an ellipse from its centre, the direction of its major axis and its two radii."""
    @property
    def Area(self) -> float:
        """Gets the area of the ellipse, π a b: an ellipse 300 by 100 encloses 94 247.8."""
    @property
    def Center(self) -> GeoPoint2:
        """Gets the centre of the ellipse."""
    @property
    def Eccentricity(self) -> float:
        """Gets the eccentricity of the ellipse, the root of 1 - b²/a²: nought for a circle, nearer one the thinner
        it is; an ellipse 300 by 100 has 0.943."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: the centre a valid point, both radii positive
        numbers with the major no less than the minor, and the axis a finite vector of unit length."""
    @property
    def Length(self) -> float:
        """Gets the length of the rim, the perimeter: an ellipse 300 by 100 measures 1 336.489 round. Named as it is
        on every other curve in the library, so that a length is asked for the same way whatever the shape."""
    @property
    def MajorAxis(self) -> GeoVector2:
        """Gets the direction of the major axis, of unit length. The eccentric angle starts at the end of the major
        axis this points to."""
    @property
    def MajorRadius(self) -> float:
        """Gets the major radius a: half the length of the major axis, never less than the minor radius."""
    @property
    def MinorAxis(self) -> GeoVector2:
        """Gets the direction of the minor axis: the major axis turned a quarter counter-clockwise."""
    @property
    def MinorRadius(self) -> float:
        """Gets the minor radius b: half the length of the minor axis, above nought."""
    def Clone(self) -> GeoEllipse2:
        """Creates a copy of this ellipse."""
    @overload
    def CollidesWith(self, arc: GeoArc2) -> bool:
        """Determines whether this ellipse touches an arc, using the default tolerance."""
    @overload
