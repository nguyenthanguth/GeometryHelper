class GeoEllipse3(System.ValueType):
    """Whether the rim of an ellipse in space touches another shape.

    Represents an elliptical disc in 3D space: a centre, the normal of its plane, the direction of its major
    axis, and its two radii.

    Like a circle in space, this is a flat region rather than a curve: it has an area, and a point counts as
    inside it only when the point lies on its plane as well as within its rim. The rim is walked by the eccentric
    angle t, the point Center + a cos t MajorAxis + b sin t MinorAxis, counter-clockwise seen from the tip of the
    normal, from the end of the major axis. That is not the direction seen from the centre: on an ellipse 300 by
    100, t = 45° is the point 212.1 along the major axis and 70.7 along the minor, which lies 18.4° from the axis
    seen from the centre.

    Everything within the plane is GeoEllipse2's arithmetic, read in the ellipse's own frame. An ellipse whose
    radii are equal is a circle and answers as GeoCircle3 does, but for where its angle starts, which follows its
    axis, and the point of the rim nearest its centre, which is the end of the minor axis as for any other
    ellipse. The operations live in Ellipse3; the members here ask it.

    How far an ellipse in space is from another shape.

    Where the rim of an ellipse in space crosses another shape.

    The point of an ellipse in space nearest another shape.

    An ellipse asked about a ball: how far apart they are, whether they touch, where they cross, and where the
    shortest segment between them runs.

    An ellipse asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs.

    An ellipse asked whether its rim touches an infinite line and where they cross."""
    def __init__(
        self,
        center: GeoPoint3,
        normal: GeoVector3,
        majorAxis: GeoVector3,
        majorRadius: float,
        minorRadius: float,
    ) -> None:
        """Initializes an ellipse in space from its centre, the normal of its plane, the direction of its major axis
        and its two radii."""
    @property
    def Area(self) -> float:
        """Gets the area of the disc, π a b: an ellipse 300 by 100 encloses 94 247.8."""
    @property
    def Center(self) -> GeoPoint3:
        """Gets the centre of the ellipse."""
    @property
    def Eccentricity(self) -> float:
        """Gets the eccentricity of the ellipse, the root of 1 - b²/a²: nought for a circle, nearer one the thinner
        it is; an ellipse 300 by 100 has 0.943."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: the centre a valid point, both radii positive
        numbers with the major no less than the minor, and the normal and the axis finite vectors of unit length,
        square to each other."""
    @property
    def Length(self) -> float:
        """Gets the length of the rim, the perimeter: an ellipse 300 by 100 measures 1 336.489 round."""
    @property
    def MajorAxis(self) -> GeoVector3:
        """Gets the direction of the major axis, of unit length and square to the normal. The eccentric angle starts
        at the end of the major axis this points to."""
    @property
    def MajorRadius(self) -> float:
        """Gets the major radius a: half the length of the major axis, never less than the minor radius."""
    @property
    def MinorAxis(self) -> GeoVector3:
        """Gets the direction of the minor axis: the normal crossed with the major axis, the major axis turned a
        quarter counter-clockwise about the normal."""
    @property
    def MinorRadius(self) -> float:
        """Gets the minor radius b: half the length of the minor axis, above nought."""
    @property
    def Normal(self) -> GeoVector3:
        """Gets the unit normal of the plane carrying the ellipse. The eccentric angle runs counter-clockwise seen
        from its tip."""
