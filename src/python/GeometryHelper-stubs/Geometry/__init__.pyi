class GeoTriangle3(System.ValueType):
    """Whether a triangle touches another shape.

    Represents a triangle in 3D space, defined by three vertices.

    The triangle is the unit every other surface in this library is measured through. A polygon answers
    containment, area and intersection by fanning into triangles, and a solid does the same through its faces, so
    the hard cases live here once instead of once per shape. Three points are always coplanar, which is why a
    triangle needs no flatness check while a polygon does.

    How far a triangle is from another shape, and how deep inside one it sits.

    Where a triangle crosses another shape.

    The point of a triangle nearest another shape, the shortest segment joining the two, and which edge of it
    faces one.

    A triangle asked about a ball: how far apart they are, whether they touch, where they cross, and where the
    shortest segment between them runs.

    A triangle asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs.

    A triangle asked about an infinite line: whether they touch, how far apart they are, where they cross and
    where the shortest segment between them runs."""
    def __init__(self, a: GeoPoint3, b: GeoPoint3, c: GeoPoint3) -> None:
        """Initializes a new triangle from three vertices."""
    @property
    def A(self) -> GeoPoint3:
        """Gets the first vertex."""
    @property
    def Area(self) -> float:
        """Gets the area of the triangle."""
    @property
    def B(self) -> GeoPoint3:
        """Gets the second vertex."""
    @property
    def C(self) -> GeoPoint3:
        """Gets the third vertex."""
    @property
    def Centroid(self) -> GeoPoint3:
        """Gets the centroid of the triangle."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: every corner is a valid point."""
    @property
    def Normal(self) -> GeoVector3:
        """Gets the unit normal of the triangle, following the right-hand rule around A, B, C."""
    @property
    def Perimeter(self) -> float:
        """Gets the perimeter of the triangle."""
    def __getitem__(self, index: int) -> GeoPoint3:
        """Gets the vertex at a given index, counted from zero."""
    def Clone(self) -> GeoTriangle3:
        """Creates a copy of this triangle."""
    @overload
