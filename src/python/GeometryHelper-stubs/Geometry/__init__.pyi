class GeoCoordinateSystem2(System.ValueType):
    """A local coordinate system in the plane: an origin and two orthonormal axes, the counterpart of
    GeoCoordinateSystem3 in space.

    It is the place a drawing sits rather than something done to a drawing. GeoTransform2 can say the same thing,
    and GeoCoordinateSystem2.ToTransform hands it over in that form, but a transformation may also scale, mirror
    or shear, and reading one backwards means inverting a matrix. A frame is rigid by construction, and reading
    it backwards is turning the axes round, which costs nothing and loses nothing."""
    @overload
    def __init__(self, origin: GeoPoint2, xAxis: GeoVector2) -> None:
        """Initializes a system at an origin, with its X axis along a direction."""
    @overload
    def __init__(self, origin: GeoPoint2, angleRad: float) -> None:
        """Initializes a system at an origin, turned by an angle."""
    @property
    def AngleRad(self) -> float:
        """Gets how far the X axis is turned from the drawing's own X axis, counter-clockwise."""
    Global: ClassVar[GeoCoordinateSystem2]
    """Gets the system the whole drawing is held in: the origin, with the axes along X and Y."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: the origin is a valid point and the axes of
        unit length and square to each other."""
    @property
    def Origin(self) -> GeoPoint2:
        """Gets where the origin of the system sits."""
    @property
    def XAxis(self) -> GeoVector2:
        """Gets the X axis of the system, of unit length."""
    @property
    def YAxis(self) -> GeoVector2:
        """Gets the Y axis of the system, of unit length and a quarter turn counter-clockwise from the X axis."""
    def Clone(self) -> GeoCoordinateSystem2:
        """Creates a copy of this system."""
    @overload
    def Equals(self, other: GeoCoordinateSystem2) -> bool:
        """Determines whether another system holds exactly the same origin and axes."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Determines whether the specified object is an equal system."""
    def GetHashCode(self) -> int:
        """Returns the hash code for this system."""
    @overload
    def IsEqualTo(self, other: GeoCoordinateSystem2) -> bool:
        """Determines whether another system sits in the same place, within the default tolerance."""
    @overload
    def IsEqualTo(self, other: GeoCoordinateSystem2, tolerance: Tolerance) -> bool:
        """Determines whether another system sits in the same place, within a tolerance."""
    @overload
    def ToGlobal(self, point: GeoPoint2) -> GeoPoint2:
        """Gets a point of this system put back into the drawing."""
    @overload
    def ToGlobal(self, vector: GeoVector2) -> GeoVector2:
        """Gets a vector of this system put back into the drawing."""
    @overload
    def ToLocal(self, point: GeoPoint2) -> GeoPoint2:
        """Gets a point of the drawing read in this system."""
    @overload
    def ToLocal(self, vector: GeoVector2) -> GeoVector2:
        """Gets a vector of the drawing read in this system."""
    def ToString(self) -> str:
        """Describes the system."""
    def ToTransform(self) -> GeoTransform2:
        """Gets the system as the transformation that places geometry built about the origin."""
    def TransformBy(self, transform: GeoTransform2) -> GeoCoordinateSystem2:
        """Gets this system under a transformation."""
    def __eq__(self, other: object) -> bool:
        """Determines whether two systems hold exactly the same values."""
    def __hash__(self) -> int: ...
    def __ne__(self, other: object) -> bool:
        """Determines whether two systems hold different values."""

class GeoCoordinateSystem3(System.ValueType):
    """Represents a 3D local coordinate system: an origin and three orthonormal axes.

    The axes are always orthonormal, whatever is passed in. The supplied X direction is kept, the Z axis is taken
    as X × Y, and the Y axis is then rebuilt as Z × X. That third step is what makes the system square: keeping
    the supplied Y unchanged would leave a skewed frame in which GeoCoordinateSystem3.ToLocal and
    GeoCoordinateSystem3.ToGlobal stop being inverses of each other, and every measurement taken through it would
    be quietly wrong."""
    @overload
    def __init__(self, plane: GeoPlane3) -> None:
        """Initializes a coordinate system whose XY plane is a given plane."""
    @overload
    def __init__(self, origin: GeoPoint3, xAxis: GeoVector3, yAxis: GeoVector3) -> None:
        """Initializes a new coordinate system from an origin and two directions."""
    Global: ClassVar[GeoCoordinateSystem3]
    """Gets the global coordinate system: origin at (0, 0, 0) with the world axes."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: the origin is a valid point and the axes of
        unit length, square to each other and right-handed."""
    @property
    def Origin(self) -> GeoPoint3:
        """Gets the origin point of the coordinate system."""
    @property
    def XAxis(self) -> GeoVector3:
        """Gets the local X axis, a unit vector."""
    @property
    def YAxis(self) -> GeoVector3:
        """Gets the local Y axis, a unit vector perpendicular to the other two."""
    @property
    def ZAxis(self) -> GeoVector3:
        """Gets the local Z axis, a unit vector perpendicular to the other two."""
    def Clone(self) -> GeoCoordinateSystem3:
        """Creates a copy of this coordinate system."""
    @overload
    def Equals(self, other: GeoCoordinateSystem3) -> bool:
        """Determines whether another coordinate system has exactly the same origin and axes."""
    @overload
    def Equals(self, obj: object) -> bool:
        """Determines whether the specified object is equal to the current coordinate system."""
    def GetHashCode(self) -> int:
        """Returns the hash code for this instance."""
    def GetPlane(self) -> GeoPlane3:
        """Gets the XY plane of this coordinate system, oriented along the local Z axis."""
    @overload
    def IsEqualTo(self, other: GeoCoordinateSystem3) -> bool:
        """Compares whether this coordinate system equals another using the default tolerance."""
    @overload
    def IsEqualTo(self, other: GeoCoordinateSystem3, tolerance: Tolerance) -> bool:
        """Compares whether this coordinate system equals another within a tolerance."""
    @overload
    def ToGlobal(self, point: GeoPoint3) -> GeoPoint3:
        """Converts a point given in this system's local coordinates into world coordinates."""
    @overload
    def ToGlobal(self, vector: GeoVector3) -> GeoVector3:
        """Converts a vector given in this system's local coordinates into world coordinates."""
    @overload
    def ToLocal(self, point: GeoPoint3) -> GeoPoint3:
        """Converts a point given in world coordinates into this system's local coordinates."""
    @overload
    def ToLocal(self, vector: GeoVector3) -> GeoVector3:
        """Converts a vector given in world coordinates into this system's local coordinates."""
    def ToString(self) -> str:
        """Returns a string that represents the current coordinate system."""
    def ToTransform(self) -> GeoTransform3:
        """Gets the transformation that takes local coordinates to world coordinates."""
    def TransformBy(self, transform: GeoTransform3) -> GeoCoordinateSystem3:
        """Applies a transformation to this coordinate system."""
    def __eq__(self, other: object) -> bool:
        """Checks if two coordinate systems have exactly the same origin and axes."""
    def __hash__(self) -> int: ...
    def __ne__(self, other: object) -> bool:
        """Checks if two coordinate systems differ in origin or any axis."""

class GeoEdge2(System.ValueType):
    """Whether an edge touches another shape.

    One piece of a chain: a straight segment, or an arc when it carries a bulge.

    The bulge is the tangent of a quarter of the angle the arc sweeps, the number AutoCAD stores against each
    vertex of a polyline: zero is a straight segment, one is a half turn counter-clockwise, and the sign says
    which way it goes. Storing it rather than a centre and two angles is what makes a round trip through a
    drawing exact, and it is why an edge needs no more than its two ends and one number.

    How far an edge is from another shape, and how deep inside one it sits.

    Where an edge crosses another shape.

    The point of an edge nearest another shape, the shortest segment joining the two, and which edge of it faces
    one.

    An edge asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs."""
    @overload
    def __init__(self, arc: GeoArc2) -> None:
        """Initializes the edge that draws an arc."""
