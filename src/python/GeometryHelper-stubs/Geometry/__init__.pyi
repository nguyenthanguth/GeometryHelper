        """Transforms a local coordinate system."""
    @overload
    def Transform(self, ellipse: GeoEllipse3) -> GeoEllipse3:
        """Transforms an ellipse in space. Every transformation that does not flatten its plane gives an ellipse, an
        uneven scaling and a shear among them: a circle of radius 100 in the plan made an ellipse and scaled by 3
        along X is the ellipse 300 by 100."""
