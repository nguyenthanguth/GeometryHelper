        """Gets the diameter of the circle."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: the centre is a valid point and the radius a
        number of nought or more."""
    @property
    def Length(self) -> float:
        """Gets the length of the circle: its circumference. Named as it is on every other curve in the library, so
        that a length is asked for the same way whatever the shape."""
    @property
    def Radius(self) -> float:
        """Gets the radius of the circle."""
