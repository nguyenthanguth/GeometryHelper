        self,
        points: System.Collections.Generic.IEnumerable[GeoPoint3],
    ) -> System.Collections.Generic.IEnumerable[GeoPoint3]:
        """Transforms a sequence of points."""
    @staticmethod
    def Translation(vector: GeoVector3) -> GeoTransform3:
        """Creates a translation."""
    @overload
    def TryGetInverse(self) -> tuple[bool, GeoTransform3]:
        """Tries to get the transformation that undoes this one, without throwing, using the default tolerance."""
    @overload
    def TryGetInverse(self, *, tolerance: Tolerance) -> tuple[bool, GeoTransform3]:
        """Tries to get the transformation that undoes this one, without throwing, within a tolerance."""
    def __mul__(self, other: GeoTransform3) -> GeoTransform3:
        """Multiplies two transformations, so the right one is applied first."""

class GeoTriangle2(System.ValueType):
    """Represents a triangle in the plane, defined by three vertices.

    A polygon or a face of the plane broken into triangles comes back as these, from GeoFace2.TriangulateSurface
    and its kin, and a triangle answers the questions every other shape of the plane does. It is GeoTriangle3
    laid flat: three points always make a triangle, even one of no area, so nothing is checked at construction.

    A triangle asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs."""
    def __init__(self, a: GeoPoint2, b: GeoPoint2, c: GeoPoint2) -> None:
        """Initializes a new triangle from three vertices."""
    @property
    def A(self) -> GeoPoint2:
        """Gets the first vertex."""
    @property
    def Area(self) -> float:
        """Gets the area of the triangle, whichever way it runs."""
    @property
    def B(self) -> GeoPoint2:
        """Gets the second vertex."""
    @property
    def C(self) -> GeoPoint2:
        """Gets the third vertex."""
    @property
    def Centroid(self) -> GeoPoint2:
        """Gets the centroid of the triangle, where its three medians meet."""
    @property
    def IsClockwise(self) -> bool:
        """Gets a value indicating whether the vertices run clockwise."""
    @property
    def IsValid(self) -> bool:
        """Gets whether this is a shape a constructor could have made: every corner is a valid point."""
    @property
    def Length(self) -> float:
        """Gets the perimeter of the triangle."""
    @property
    def MinAngle(self) -> float:
        """Gets the smallest of the three angles, in radians: the one that says how thin a triangle is."""
    @property
    def SignedArea(self) -> float:
        """Gets the signed area of the triangle: positive when A, B, C run counter-clockwise, negative when they run
        clockwise."""
    def __getitem__(self, index: int) -> GeoPoint2:
        """Gets the vertex at a given index, counted from zero."""
    def Clone(self) -> GeoTriangle2:
