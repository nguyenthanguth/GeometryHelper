class GeoCircle2(System.ValueType):
    """Whether a circle touches another shape.

    Represents a 2D circle with a center point and radius.

    How far a circle is from another shape, and how deep inside one it sits.

    Where a circle crosses another shape.

    The point of a circle nearest another shape, the shortest segment joining the two, and which edge of it faces
    one.

    A circle asked how far it is from a spline, whether they touch, where they cross and where the shortest
    segment between them runs."""
    @overload
    def __init__(self, center: GeoPoint2, radius: float) -> None:
        """Initializes a new GeoCircle2 instance from a center point and radius."""
