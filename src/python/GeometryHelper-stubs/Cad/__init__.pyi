    def Filter(self, value: str) -> None: ...
    @property
    def Listed(self) -> System.Collections.Generic.IReadOnlyList[CadLayerWalkRow]:
        """Gets the layers the filter lists, in the order of CadLayerWalkRequest.Rows."""
    @property
    def Message(self) -> str:
        """Gets what the last change said where it was refused; null where it was made."""
    @property
    def RestoreOnExit(self) -> bool:
        """Gets or sets whether closing the dialog puts the layers back as they were; true until set, as AutoCAD's
        Restore on exit."""
