    def First(entity: DxfEntity) -> DxfHyperLink:
        """Gets the first hyperlink of an object, as Ctrl+click follows it; null for an object with none, or none
        given."""
    @staticmethod
    def Make(address: str, place: str, text: str) -> DxfHyperLink:
        """Makes the hyperlink the dialogs and -HYPERLINK write from what they ask: the address, the named place in
        it and the text it is shown by. An empty address with a place is a link to a view of the drawing."""
    @staticmethod
    def Resolve(document: CadDocument, link: DxfHyperLink) -> CadHyperlinkTarget:
        """Says where a hyperlink leads. An address with a scheme (https:, ftp:) or starting www. is a web address,
        one starting mailto: a mail address; no address with a place named is a view of the drawing; any other
        address is a file, a relative path one made from the drawing's hyperlink base (DxfDatabase.HyperlinkBase)
        or, where the base is empty, the folder of the drawing's file."""
    @staticmethod
    def Tooltip(entity: DxfEntity) -> str:
