    tested here with no window."""
    def __init__(self, width: float, height: float) -> None:
        """Makes a view of a canvas of a size, showing the origin at 1 pixel to the unit."""
    @property
    def CenterX(self) -> float:
        """Gets the X of the point of the drawing at the centre of the canvas."""
    @property
    def CenterY(self) -> float:
        """Gets the Y of the point of the drawing at the centre of the canvas."""
    @property
    def DrawingToScreen(self) -> Affine2:
        """Gets the transformation from the drawing to the pixels of the canvas, Y up in the drawing becoming Y down
        on the screen."""
    @property
    def Height(self) -> float:
        """Gets the height of the canvas in pixels."""
    @property
    def PixelsPerUnit(self) -> float:
        """Gets the pixels one drawing unit takes."""
    @property
    def Twist(self) -> float:
        """Gets the angle the drawing is turned by on the canvas, in radians, counter-clockwise: nought but for
        model space seen through a viewport whose view is twisted, as a viewport twisted by 30 degrees shows the
