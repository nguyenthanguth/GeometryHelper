        them on. In an MTEXT 2.5 high, \\pxt4;A\\PB has a tab stop at 10 in both paragraphs."""
    def InsertColumnBreak(self) -> None:
        """Puts a column break at the caret (Alt+Enter), over the selection: the words after it start the next
        column."""
    def InsertContent(self, content: CadMTextContent) -> None:
        """Puts the words of a file at the caret, over the selection, in the looks they come with: Import Text. The
        paragraphs and runs are those CadMTextImport reads from a text or an RTF file; a run with no look of its
        own takes the look of the letters typed there. One undo step."""
    def InsertField(self, shown: str, code: str) -> None:
        """Inserts a field as AutoCAD's Insert Field does: one place, shown as the words the field came to and
        written as its code in markers (%<\\AcVar Date \\f \"dd/MM/yyyy\">%), in the look of the letters typed
        there."""
    def InsertSymbol(self, shown: str, code: str) -> None:
        """Inserts a symbol as AutoCAD's Symbol menu writes it: shown as its letter, written as its code (%%d,
        \\U+2248)."""
    def LookAt(self, index: int) -> CadMTextLook:
        """Gets the look of a place: of its letter, the look the letters typed there take for a break."""
    def MoveTo(self, place: int, extend: bool = ...) -> None:
        """Moves the caret, the selection grown from its other end where extend, as Shift does."""
    def NumberingOf(self, paragraph: int) -> CadMTextNumbering:
        """Gets the label a paragraph opens with, as CadMTextEditor.SetNumbering writes them: in
        1.\\tPlate\\Pb.\\tBeam\\PColumn the first is CadMTextNumbering.Number, the second
        CadMTextNumbering.LetterLower and the third CadMTextNumbering.Off."""
    def OwnAlignmentOf(self, paragraph: int) -> str:
        """Gets the alignment a paragraph carries of its own: l, c, r, j or d; nought where it follows the MTEXT's
        attachment."""
    def ParagraphOf(self, place: int) -> int:
        """The paragraph a place is in, counted from nought."""
    def Redo(self) -> bool:
        """Makes the last change taken back again."""
    def RenumberList(self, continuePrevious: bool) -> bool:
        """Starts or continues the numbering of the list the first selected paragraph is in, as the Start and
        Continue items of Bullets and Numbering do, one undo step: Start numbers that paragraph 1 (or a, A) and
        the paragraphs of the same list after it from there, so that with the caret in Beam,
        1.\\tPlate\\P2.\\tBeam\\P3.\\tColumn becomes 1.\\tPlate\\P1.\\tBeam\\P2.\\tColumn; Continue numbers it on
        from the paragraph before, which puts the second back. A list is the run of paragraphs with the same kind
        of label. Nothing is done, and false answered, for a paragraph with no number or letter label (none, or a
        bullet), or for Continue where the paragraph before has not the same kind of label."""
    def Replace(self, find: str, replace: str, options: CadMTextFindOptions) -> bool:
        """Find and Replace's Replace: where the selection is a match of the words it is replaced, in the look of
        its first letter and as one undo step, and the next match is selected; else the next match is selected,
        as Find Next does, and nothing is replaced."""
    @overload
    def ReplaceAll(self, find: str, replace: str, options: CadMTextFindOptions) -> int:
        """Replaces every match of words with others, each in the look of the letter it starts at, as one undo step:
        Find and Replace's Replace All. The text put in is not searched again, so that replacing \"a\" with
        \"aa\" ends."""
    @overload
    def ReplaceAll(self, find: str, replace: str, matchCase: bool) -> int:
        """Replaces every match of words with others, each in the look of the letter it starts at, as one change;
        Find and Replace's Replace All."""
    def ReplaceField(self, index: int, shown: str, code: str) -> None:
        """Gives the field a place holds another code and words, as Edit Field does; its look kept."""
    def ReplaceText(self, start: int, length: int, text: str) -> None:
        """Puts words in the place of some places, in the look of the first of them, as one undo step, the caret
        after the words: a suggestion of the spell check picked from the menu. AutoCAPS does not change them."""
    def Select(self, start: int, length: int) -> None:
        """Selects places."""
    def SelectAll(self) -> None:
        """Selects every place, as Ctrl+A."""
    def SetAlignment(self, alignment: str) -> None:
        """Aligns the paragraphs the selection or the caret is in: l, c, r, j or d."""
    def SetBold(self, on: bool) -> None:
        """Makes the letters bold or not (Ctrl+B); nothing on letters of an SHX font."""
    def SetColorIndex(self, index: int | None) -> None:
        """Gives the letters a colour of the index: 256 ByLayer, 0 ByBlock; null for the MTEXT's own."""
    def SetFont(self, font: str, shx: bool) -> None:
        """Gives the letters a font: a TrueType family keeping bold and italic, or an SHX file; null for the
        style's."""
    def SetFormat(self, change: System.Func[CadMTextParagraphFormat, CadMTextParagraphFormat]) -> None:
        """Changes how the selected paragraphs, or the caret's, are set: their indents, tab stops and spacing, one
        undo step. Each is written as AutoCAD writes it, what differs from the paragraph before, and the
        paragraph after them is written back to how it was: a tab stop at 10 set on the first of \"A\", \"B\" in
        an MTEXT 2.5 high writes \\pxt4;A\\P\\ptz;B."""
    def SetFrame(self, frame: CadMTextFrame) -> None:
        """Changes the MTEXT's box: its width, defined height or columns, one undo step."""
    def SetHeight(self, height: float) -> None:
        """Gives the letters a height in drawing units; the MTEXT's own height or less than nought is none of their
        own."""
    def SetItalic(self, on: bool) -> None:
        """Makes the letters italic or not (Ctrl+I); nothing on letters of an SHX font."""
    def SetNumbering(self, numbering: CadMTextNumbering) -> None:
        """Labels the selected paragraphs, or the caret's, as a list, as AutoCAD 2021's Bullets and Numbering does,
        one undo step: each opens with its label and a tab, the paragraphs hanging 3 heights in with a tab stop
        there, and a label one had is replaced. In an MTEXT 2.5 high, \"Plate\", \"Beam\" numbered is written
        \\pxi-3,l3,t3;1.\\tPlate\\P2.\\tBeam and bulleted
        \\pxi-3,l3,t3;{\\fSymbol|b0|i0|c2|p18;·\\t}Plate\\P{\\fSymbol|b0|i0|c2|p18;·\\t}Beam, as AutoCAD's
        TextEditor writes them (probed). CadMTextNumbering.Off takes the labels, the indent and the stop away."""
    def SetOblique(self, degrees: float) -> None:
        """Slants the letters by degrees; nought is none of their own."""
    def SetOverline(self, on: bool) -> None:
        """Overlines the letters or not."""
    def SetStrikethrough(self, on: bool) -> None:
        """Strikes the letters through or not."""
    def SetTracking(self, factor: float) -> None:
        """Spaces the letters by a factor of their usual spacing; 1 is none of their own."""
    def SetUnderline(self, on: bool) -> None:
        """Underlines the letters or not (Ctrl+U)."""
    def SetWidthFactor(self, factor: float) -> None:
        """Widens or narrows the letters by a factor; 1 is none of their own."""
    def TextAt(self, index: int) -> str:
        """Gets the letters a place shows: a line feed for a paragraph break."""
    def Type(self, text: str) -> None:
        """Types letters over the selection, each line feed a new paragraph, in the look of the letters typed
        there."""
    def Undo(self) -> bool:
        """Takes the last change back."""

class CadMTextEditorLayout(System.Object):
    """The words of an MTEXT being edited in place, laid out as the canvas will draw them: the one layout of the
    display, wrapped at the width, its lines spaced by the MTEXT's rule, its stacks, tabs, indents, paragraph
    spacing, columns, mask and frame, in the drawing's fonts; with where each place of the editor
    (CadMTextEditor) stands, for its caret and selection. Everything is in the MTEXT's own frame and drawing
    units: its location at nought, x along its direction, y up."""
    def __init__(self, document: CadDocument, edit: CadInPlaceEdit) -> None:
        """Makes the layout of an MTEXT edited in place: the MTEXT of the edit's handle, its spacing style, columns,
        mask and frame kept; for an MTEXT being made or a table cell, an MTEXT of the edit's height, width, style
        and attachment."""
    @property
    def Bounds(self) -> System.Array[float]:
        """Gets the box of everything drawn: the defined box, the ink of the letters and the mask and frame; left,
        bottom, right and top."""
    @property
    def Box(self) -> System.Array[float]:
        """Gets the box the MTEXT is defined by, as its grips stand: left, bottom, right and top."""
    @property
    def ColumnCount(self) -> int:
        """Gets how many columns the words stand in now: 1 with none, those the words fill with dynamic ones."""
    @property
    def Frame(self) -> CadMTextFrame:
        """Gets the MTEXT's box as last laid out: the editor's frame; null before the first
        CadMTextEditorLayout.Update with it."""
    @property
    def LineCount(self) -> int:
        """Gets how many lines the words make, an empty paragraph at the end one of them."""
    @property
    def Parts(self) -> System.Collections.Generic.IReadOnlyList[DisplayItem2]:
        """Gets the parts the words are drawn as, as the canvas draws an MTEXT (DisplayText2.Parts): the mask and
        the frame first, then the runs and their lines."""
    def BaselineOf(self, line: int) -> float:
        """Gets the baseline of a line."""
    def BottomOf(self, line: int) -> float:
        """Gets the foot of a line's cell: the ink below its baseline, or a third of the MTEXT's height."""
    def ColumnOf(self, line: int) -> int:
        """Gets the column a line stands in, from nought."""
    def LineEnd(self, line: int) -> int:
        """Gets the place at the end of a line, where End goes: before the space it breaks at or the paragraph break
        that ends it, or after the last place of the words."""
    def LineOfPlace(self, place: int) -> int:
        """Gets the line a place stands on."""
    def LineStart(self, line: int) -> int:
        """Gets the first place of a line, where Home goes."""
    def PlaceAt(self, x: float, y: float) -> int:
        """Gets the place nearest a point, for a click: on the line under it (of the column under it, or the
        nearest), before the first letter whose middle is right of it, else at the line's end."""
    def PlaceOnLine(self, line: int, x: float) -> int:
        """Gets the place of a line nearest an X, for the arrows up and down: before the first letter whose middle
        is right of it, else at the line's end."""
    def RightOf(self, place: int) -> float:
        """Gets where a place's letter ends along the line: the X of the caret after it on the same line."""
    def SetMask(self, mask: CadMTextMask) -> None:
        """Gives the words the background mask the editor shows them on, drawn by the next
        CadMTextEditorLayout.Update; the MTEXT's own where none is given. A file older than R2004 has no
        background, and keeps the words as they are."""
    def TopOf(self, line: int) -> float:
        """Gets the top of a line: of its tallest letters."""
    @overload
    def Update(self, editor: CadMTextEditor, attachment: int, lineSpacing: float, rgb: int, layerRgb: int) -> None:
        """Lays the words out again, as they are and in the box the editor has now (CadMTextEditor.Frame): its
        width, defined height and columns, as the ruler and Column Settings change them."""
    @overload
    def Update(
        self,
        editor: CadMTextEditor,
        width: float,
        attachment: int,
        lineSpacing: float,
        rgb: int,
        layerRgb: int,
    ) -> None:
        """Lays the words out again, as they are and with the box as the editor has it now. A width of nought wraps
        nothing; with columns, the width is the columns'."""
    def XOf(self, place: int) -> float:
        """Gets where the caret stands before a place, along the line: the left of its letter."""

class CadMTextFindOptions(System.Object):
    """How the MTEXT editor's Find and Replace dialog matches words, as AutoCAD 2021's has it: Match case, Whole
    words only, Use wildcards, Match diacritics and Match half/full width forms. With none set the search ignores
    capitals, finds words inside longer ones, takes every character as itself, treats a letter and the same
    letter with an accent as one, and a full-width letter and its ordinary form as one."""
    def __init__(self) -> None: ...
    @property
    def MatchCase(self) -> bool:
        """Gets or sets whether capitals must match: \"Plate\" is not found as \"plate\"."""
    @MatchCase.setter
    def MatchCase(self, value: bool) -> None: ...
    @property
    def MatchDiacritics(self) -> bool:
        """Gets or sets whether accents must match: \"cafe\" is not found as \"café\"."""
    @MatchDiacritics.setter
    def MatchDiacritics(self, value: bool) -> None: ...
    @property
    def MatchHalfFullWidth(self) -> bool:
        """Gets or sets whether half-width and full-width forms must match: \"ABC\" is not found as \"ＡＢＣ\"."""
    @MatchHalfFullWidth.setter
    def MatchHalfFullWidth(self, value: bool) -> None: ...
    @property
    def UseWildcards(self) -> bool:
        """Gets or sets whether the words searched for are a wildcard pattern (* any run, ? one character, # a
        digit, @ a letter, [AB] one of those, a back quote before a character that character itself), as FIND's:
        M2? finds M20 and M24."""
    @UseWildcards.setter
    def UseWildcards(self, value: bool) -> None: ...
    @property
    def WholeWords(self) -> bool:
        """Gets or sets whether a match must be whole words: \"bolt\" is found in \"a bolt.\" but not in
        \"bolted\"."""
    @WholeWords.setter
    def WholeWords(self, value: bool) -> None: ...
    def Clone(self) -> CadMTextFindOptions:
        """Makes a copy."""

class CadMTextFrame(System.Object):
    """The box of an MTEXT being edited, as the MTEXT editor's ruler and Column Settings change it: its width, its
    defined height and its columns. Each change is a new frame, so that the editor's undo keeps the one before."""
    @property
    def AutoHeight(self) -> bool:
        """Gets whether dynamic columns are all of one height, CadMTextFrame.Height."""
    @property
    def ColumnCount(self) -> int:
        """Gets how many static columns, or how many dynamic columns of their own heights have a height; 1 with no
        columns."""
    @property
    def ColumnHeights(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the heights of dynamic columns of their own heights, the first column's first; empty for any
        other."""
    @property
    def ColumnType(self) -> DxfColumnType:
        """Gets how the words are set in columns."""
    @property
    def ColumnWidth(self) -> float:
        """Gets the width of each column; nought with no columns."""
    @property
    def Gutter(self) -> float:
        """Gets the space between two columns; nought with no columns."""
    @property
    def HasColumns(self) -> bool:
        """Gets whether the words are in columns."""
    @property
    def Height(self) -> float:
        """Gets the defined height: the box's, or the columns' of one height; nought for none."""
    @property
    def Width(self) -> float:
        """Gets the width of the box: of the MTEXT with no columns, of all the columns with their gutters with
        static ones, of a column with dynamic ones; nought for none."""
    def ApplyTo(self, text: DxfMText) -> None:
        """Gives an MTEXT this frame's width, defined height and columns, as AutoCAD's own calls set them: no
        columns taken out, static ones by DxfMText.SetStaticColumns, dynamic ones by DxfMText.SetDynamicColumns
        and each column's height by DxfMText.SetColumnHeight."""
    @overload
    def Equals(self, other: CadMTextFrame) -> bool: ...
    @overload
    def Equals(self, obj: object) -> bool: ...
    def GetHashCode(self) -> int: ...
    @overload
    @staticmethod
    def Of(text: DxfMText) -> CadMTextFrame:
        """Makes the frame of an MTEXT as it is drawn: its width, defined height and columns."""
    @overload
    @staticmethod
    def Of(width: float, height: float = ...) -> CadMTextFrame:
        """Makes the frame of an MTEXT with no columns."""
    def WithColumnHeight(self, index: int, height: float) -> CadMTextFrame:
        """Gets the frame with one dynamic column of its own height made another height, as its grip drags it;
        columns up to it that have none are given the defined height."""
    def WithColumnWidth(self, width: float) -> CadMTextFrame:
        """Gets the frame with columns of another width, the gutter kept; the total of static ones follows."""
    def WithColumns(
        self,
        type: DxfColumnType,
        columnWidth: float,
        gutter: float,
        count: int,
        autoHeight: bool,
    ) -> CadMTextFrame:
        """Gets the frame in other columns, as Column Settings sets them: none (the width the total the columns
        took), static of a count, or dynamic of one height or of their own, each then given the defined height to
        start with."""
    def WithGutter(self, gutter: float) -> CadMTextFrame:
        """Gets the frame with another gutter; the total of static columns follows."""
    def WithHeight(self, height: float) -> CadMTextFrame:
        """Gets the frame with another defined height: the box's, or that of columns of one height; with dynamic
        columns of their own heights, every column's."""
    def WithWidth(self, width: float) -> CadMTextFrame:
        """Gets the frame with another width: the MTEXT's, the total of static columns (the gutters kept, the
        columns sharing the rest), or a dynamic column's."""

class CadMTextImport(System.Object):
    """What the MTEXT editor's Import Text reads from a file: a text file (.txt) as paragraphs of plain letters, or
    a rich text file (.rtf) as paragraphs of runs with the font, bold, italic, underline, strikethrough, colour
    and size they have there. A file over 32 KB is refused, as AutoCAD 2021 refuses it."""
