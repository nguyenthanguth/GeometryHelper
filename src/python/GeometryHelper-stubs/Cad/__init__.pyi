class CadXrefManager(System.Object):
    """The external references and images of a document as the presenter shows them: each file found where AutoCAD
    looks for it, an external reference read once and drawn as the content of its block, and what was unloaded.
    Nothing it reads is written into the drawing but by -XREF Bind (DxfDatabase.BindXref): an external reference
    is shown, and saving writes its block and INSERTs alone, as AutoCAD writes them."""
    @property
    def WatchFiles(self) -> bool:
        """Gets or sets whether the folders of the files read are watched, so that CadXrefManager.FilesChanged is
        raised; off until set, as in a test."""
