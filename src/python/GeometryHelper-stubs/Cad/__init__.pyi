    def IsCut(self) -> bool:
        """Gets whether the cells were cut: their contents taken out of the table when they were taken."""
    @property
    def Name(self) -> str:
        """Gets the name of the cells copied, as B2:C3, in the table they came from."""
    @property
    def Rows(self) -> int:
        """Gets how many rows the cells copied have."""

class CadTableCellMove(System.Enum):
