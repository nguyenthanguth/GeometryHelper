    @property
    def Scale(self) -> float:
        """Gets the paper length of one unit of model space."""
    @property
    def Twist(self) -> float:
        """Gets the angle the view is turned by, in radians."""
    @property
    def ViewCenterX(self) -> float:
        """Gets the X of the point of model space at the centre of the frame."""
    @property
    def ViewCenterY(self) -> float:
        """Gets the Y of the point of model space at the centre of the frame."""
    @property
    def Width(self) -> float:
        """Gets the width of the frame in paper units."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""

class GlobalAutoCorrection(System.Object):
    """A command name typed wrongly and the command typed next, with how many times that has happened: once it has
    happened GlobalSettings.AutoCorrectAfter times, the command line offers the command first when the
    misspelling is typed again, as AutoCAD's AutoCorrect does. LIEN typed three times, each followed by LINE, has
    LINE offered for LIEN."""
    def __init__(self, typed: str, command: str, count: int) -> None:
        """Makes a correction."""
    @property
    def Command(self) -> str:
        """Gets the command typed after it, in capitals."""
    @property
    def Count(self) -> int:
        """Gets how many times the misspelling was followed by the command."""
    @property
    def IsRemembered(self) -> bool:
        """Gets whether it has happened often enough to be offered at the default of GlobalSettings.AutoCorrectAfter
        times; the settings offer it after their own GlobalSettings.AutoCorrectMistypes."""
    @property
    def Typed(self) -> str:
        """Gets the misspelling, in capitals."""

