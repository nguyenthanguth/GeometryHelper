    def PlotTransparency(self) -> bool:
        """Gets or sets whether the transparency of objects is plotted. The presenter's display lists carry no
        transparency, so a plot is the same either way; it is kept for the dialog and is not written to the
        drawing, which AutoCAD keeps it in no group of the plot settings a DXF holds."""
    @PlotTransparency.setter
    def PlotTransparency(self, value: bool) -> None: ...
    @property
    def PlotWithPlotStyles(self) -> bool:
        """Gets or sets whether the plot style table is used; off, colours plot as with CadPlotStyleTable.None. On
        by default."""
    @PlotWithPlotStyles.setter
    def PlotWithPlotStyles(self, value: bool) -> None: ...
    @property
    def SavedPlotter(self) -> str:
        """Gets the plotter the layout or page setup named when these settings were read (group 2), such as
        Microsoft Print to PDF or AutoCAD's DWG To PDF.pc3; empty where it named none, or these settings were not
        read from a drawing, or a plotter has been chosen since (CadPlotSettings.UseDevice,
        CadPlotSettings.UsePrinter). The Plot dialog chooses it again when it is a printer this computer has."""
    @property
    def Scale(self) -> float:
        """Gets the scale as millimetres of paper per drawing unit, where the plot is not fitted: 0.05 for 1:20."""
    @property
    def ScaleLineweights(self) -> bool:
        """Gets or sets whether the lineweights are scaled with the plot: a line of 0.5 plotted at 1:2 is 0.25 wide,
        at 2:1 it is 1 wide."""
    @ScaleLineweights.setter
    def ScaleLineweights(self, value: bool) -> None: ...
    @property
    def StyleSheet(self) -> str:
        """Gets or sets the plot style table by the name of its file, as AutoCAD's CurrentStyleSheet (group 7 of the
        plot settings): monochrome.ctb by default, acad.ctb, mine.stb; empty for none. A plot reads the file from
        the document's CadDocument.PlotStyleFolder (CadPlotStyleResolver). The name is trimmed and kept as given,
        in the case the drawing spells it, whether or not a file of it exists."""
    @StyleSheet.setter
    def StyleSheet(self, value: str) -> None: ...
    @property
    def StyleTable(self) -> CadPlotStyleTable:
        """Gets or sets the plot style table as one of the three the presenter made before tables were files: a name
        with monochrome in it is CadPlotStyleTable.Monochrome, one with grayscale is CadPlotStyleTable.Grayscale,
        any other and none are CadPlotStyleTable.None. Setting it sets CadPlotSettings.StyleSheet to
        monochrome.ctb, grayscale.ctb or none. Monochrome by default."""
    @StyleTable.setter
    def StyleTable(self, value: CadPlotStyleTable) -> None: ...
    @property
    def UpsideDown(self) -> bool:
        """Gets or sets whether the plot is turned half round on the sheet."""
    @UpsideDown.setter
    def UpsideDown(self, value: bool) -> None: ...
    @property
    def ViewName(self) -> str:
        """Gets or sets the name of the named view plotted where CadPlotSettings.Area is CadPlotArea.View, as it is
        written in the page setup (group 6 of the plot settings); empty by default. The name is trimmed and kept
        as given; CadPlotSettings.ViewNames lists the views a drawing offers."""
    @ViewName.setter
    def ViewName(self, value: str) -> None: ...
    @property
    def Window(self) -> DisplayBox:
        """Gets or sets the window plotted where CadPlotSettings.Area is CadPlotArea.Window, in drawing units."""
    @Window.setter
    def Window(self, value: DisplayBox) -> None: ...
    def ApplyTo(self, document: CadDocument, space: CadSpace) -> CadEditResult:
        """Writes the settings into the plot settings of a space's LAYOUT, as Apply to Layout does, one undo step
        named PLOT: the plotter's name (group 2), the sheet's name, size and margins in millimetres (4, 40 to 45,
        72), its turn (73) as AutoCAD reckons it from the sheet as named, the offset (46, 47), what is plotted
        (74) and the window (48, 49, 140, 141), the scale (142, 143, and 75 with 147 and flag 16 where it is one
        of AutoCAD's standard scales, scaled to fit as 75 of 0), centring (flag 4), the table (7) by the name of
        its file (CadPlotSettings.StyleSheet), and the flags of plot styles (32), lineweights (128) and their
        scaling (64). Plot transparency is not written. A layout's limits follow its sheet, as DxfLayout makes
        them."""
    @staticmethod
    def CheckPageSetupName(name: str) -> str:
        """Says why a name cannot name a page setup, as AutoCAD refuses one: empty, longer than 255 letters, or with
        a < > / \\ \" : ; ? * | , = ` in it."""
    def Clone(self) -> CadPlotSettings:
        """Makes a copy that changes apart from this one."""
    @staticmethod
    def CurrentPageSetupName(document: CadDocument, space: CadSpace) -> str:
        """Gets the name of the page setup a space is set to, as the Page Setup Manager shows it as the current one:
        the name its LAYOUT keeps (group 1) where the drawing has a page setup of it, written by
        CadPlotSettings.SetCurrentPageSetup."""
    @staticmethod
    def DeletePageSetup(document: CadDocument, name: str) -> CadEditResult:
        """Takes a page setup out of the drawing, as Delete on the Page Setup Manager's list does, one undo step
        named PAGESETUP. A layout that was set to it keeps its settings and is set to no page setup."""
    @staticmethod
    def ImportPageSetups(
        document: CadDocument,
        source: DxfDatabase,
        names: System.Collections.Generic.IEnumerable[str],
    ) -> CadEditResult:
        """Copies page setups of another drawing into this one, as Import of the Page Setup Manager does, one undo
        step named PAGESETUP. A page setup whose name the drawing has already is added as Name (2), Name (3) and
        on, so that none is lost."""
    @staticmethod
    def IsRasterDevice(name: str) -> bool:
        """Gets whether a plotter's name is one of the raster devices, either case."""
    @staticmethod
    def PageSetupIsModel(database: DxfDatabase, name: str) -> bool:
        """Gets whether a page setup of a drawing was made for model space (flag 1024 of its group 70, AutoCAD's
        ModelType), the Model that Import Page Setups lists in its Location column; Layout otherwise."""
    @overload
    @staticmethod
    def PageSetupNames(document: CadDocument) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the page setups of a drawing by name, as the Name list of the Plot dialog's Page setup offers them:
        the PLOTSETTINGS of its dictionary ACAD_PLOTSETTINGS, in ordinal order of their names, letters of either
        case the same."""
    @overload
    @staticmethod
    def PageSetupNames(database: DxfDatabase) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the page setups of another drawing by name, as Import in the Page Setup Manager lists them: the
        PLOTSETTINGS of its dictionary ACAD_PLOTSETTINGS, in ordinal order of their names, letters of either case
        the same."""
    @staticmethod
    def Read(document: CadDocument, space: CadSpace) -> CadPlotSettings:
        """Reads how a space is plotted from the drawing, as AutoCAD's Plot dialog opens on a layout's page setup:
        the plot settings of the space's LAYOUT, model space's from the layout Model. The sheet is the standard
        one of the name the layout gives and its margins, else one made of the layout's size and margins, ISO A3
        where it gives none; a named view is kept by its name (CadPlotSettings.ViewName), a layout's sheet of
        model space as its extents; the plot style table is kept by the name of its file
        (CadPlotSettings.StyleSheet), monochrome.ctb reading as CadPlotStyleTable.Monochrome and grayscale.ctb as
        CadPlotStyleTable.Grayscale through CadPlotSettings.StyleTable. A space whose settings cannot be read is
        given the defaults, a layout plotting its sheet at 1:1."""
    @overload
    @staticmethod
    def ReadPageSetup(document: CadDocument, space: CadSpace, name: str) -> CadPlotSettings:
        """Reads a page setup of the drawing by name, as choosing it in the Page setup list of the Plot dialog
        applies it to the space plotted: the settings read as CadPlotSettings.Read reads a layout's."""
    @overload
    @staticmethod
    def ReadPageSetup(database: DxfDatabase, name: str, isModel: bool) -> CadPlotSettings:
        """Reads a page setup of a drawing opened without a document, as Import Page Setups shows the details of the
        one chosen: the settings read as CadPlotSettings.ReadPageSetup reads them."""
    @staticmethod
    def RenamePageSetup(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Gives a page setup of the drawing another name, as Rename on the Page Setup Manager's list does, one undo
        step named PAGESETUP. A layout set to the page setup is set to it under its new name. A change of letters
        alone (Small to SMALL) is a rename; another page setup's name, in either case, is not allowed."""
    def SaveAsPageSetup(self, document: CadDocument, name: str) -> CadEditResult:
        """Writes the settings as a named page setup of the drawing, one undo step named PAGESETUP, as the Plot
        dialog's Add… and the Page Setup Manager's New… and Modify… do: the PLOTSETTINGS of the name added to
        ACAD_PLOTSETTINGS (the dictionary made where the drawing has none), or replaced where the name, letters
        of either case the same, is taken. What is written is as CadPlotSettings.ApplyTo writes it into a layout."""
    @staticmethod
    def SetCurrentPageSetup(document: CadDocument, space: CadSpace, name: str) -> CadEditResult:
        """Sets a space to a page setup of the drawing, as Set Current of the Page Setup Manager does, one undo step
        named PAGESETUP: every setting of the page setup copied into the space's LAYOUT, its name with them, as
        AutoCAD's CopyFrom copies them."""
    def UseDevice(self, name: str) -> None:
        """Chooses the plotter, as the Name list of the Plot dialog does. A raster device moving from the PDF one
        starts on 1920 by 1080 pixels, fitted, centred, with no offset and no plot style table, colours as
        displayed on white, colour 7 black; the PDF one moving from a raster device goes back to ISO A3 and the
        monochrome table. Moving between PNG and JPG keeps everything."""
    def UsePrinter(self, name: str) -> None:
        """Chooses a printer of Windows as the plotter, as the Name list of the Plot dialog does. Moving to it from
        a raster device gives back ISO A3 and the monochrome table, as moving to the PDF plotter does; the sheet
        is then one the printer lists, which the caller sets."""
    @staticmethod
    def ViewNames(document: CadDocument, space: CadSpace) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the named views a space can plot, as the View list of the Plot dialog offers them: the views of
        model space for model space, those of paper space for a layout, in ordinal order of their names, letters
        of either case the same; empty where there are none, which is when the dialog greys View."""

class CadPlotStamp(System.Object):
    """The plot stamp of AutoCAD's PLOTSTAMP and -PLOTSTAMP: a few lines of text, the name of the drawing, the
    layout, the date and time, the login name, the plotter, the sheet and the scale, and two fields of the user's
    own, put in a corner of the sheet of a plot, and the same words kept in a log file. The commands keep one for
    a session (CadCommandSession.PlotStamp) and hand a copy to the settings of each plot while CadPlotStamp.On
    (CadPlotSettings.PlotStamp); the PDF writer puts it on the page.

    The plot stamp parameter file, AutoCAD's .pss, which the Plot Stamp dialog's Load and Save As read and write:
    a PIA file, its head \"PIAFILEVERSION_2.0,plotstampcompress\" and \"pmzlibcodec\", then the Adler-32 of a
    zlib stream, the length of the text and of the stream, and the stream of a text of nested blocks, as AutoCAD
    2021's mm.pss holds: pstamp{ fields{ drawing_name=1 … } ud_fields{ … } preview{ … } text_prop{ … }
    pstamp_units{ … } logfile{ … } }."""
    StartFont: ClassVar[str]
    """The font AutoCAD starts with: Segoe UI."""
    StartHeight: ClassVar[float]
    """The text height AutoCAD starts with, in CadPlotStamp.Units: 0.2."""
    StartLogFile: ClassVar[str]
    """The log file AutoCAD starts with: plot.log."""
    StartOffset: ClassVar[float]
    """The offset from the corner AutoCAD starts with, along each axis, in CadPlotStamp.Units: 0.1."""
    def __init__(self) -> None: ...
    @property
    def DateAndTime(self) -> bool:
        """Gets or sets whether the stamp holds the date and time of the plot; on to start with."""
    @DateAndTime.setter
    def DateAndTime(self, value: bool) -> None: ...
    @property
    def DeviceName(self) -> bool:
        """Gets or sets whether the stamp holds the name of the plotter; on to start with."""
    @DeviceName.setter
    def DeviceName(self, value: bool) -> None: ...
    @property
    def DrawingName(self) -> bool:
        """Gets or sets whether the stamp holds the name of the drawing, with its folder; on to start with."""
    @DrawingName.setter
    def DrawingName(self, value: bool) -> None: ...
    @property
    def FontName(self) -> str:
        """Gets or sets the font of the stamp: CadPlotStamp.StartFont to start with."""
    @FontName.setter
    def FontName(self, value: str) -> None: ...
    @property
    def LayoutName(self) -> bool:
        """Gets or sets whether the stamp holds the name of the layout plotted; off to start with."""
    @LayoutName.setter
    def LayoutName(self, value: bool) -> None: ...
    @property
    def Location(self) -> CadPlotStampCorner:
        """Gets or sets the corner of the sheet the stamp is put in; the lower left to start with."""
    @Location.setter
    def Location(self, value: CadPlotStampCorner) -> None: ...
    @property
    def LogFile(self) -> str:
        """Gets or sets the log file; a name with no folder is put beside the plot. CadPlotStamp.StartLogFile to
        start with."""
    @LogFile.setter
    def LogFile(self, value: str) -> None: ...
    @property
    def LoginName(self) -> bool:
        """Gets or sets whether the stamp holds the login name of the user; off to start with."""
    @LoginName.setter
    def LoginName(self, value: bool) -> None: ...
    @property
    def OffsetFromPaperBorder(self) -> bool:
        """Gets or sets whether the offset is measured from the edge of the sheet; off, it is from the printable
        area, as it starts."""
    @OffsetFromPaperBorder.setter
    def OffsetFromPaperBorder(self, value: bool) -> None: ...
    @property
    def OffsetX(self) -> float:
        """Gets or sets how far the stamp stands from the sides of the corner along X, in CadPlotStamp.Units:
        CadPlotStamp.StartOffset to start with."""
    @OffsetX.setter
    def OffsetX(self, value: float) -> None: ...
    @property
    def OffsetY(self) -> float:
        """Gets or sets how far the stamp stands from the sides of the corner along Y, in CadPlotStamp.Units."""
    @OffsetY.setter
    def OffsetY(self, value: float) -> None: ...
    @property
    def On(self) -> bool:
        """Gets or sets whether plots are stamped; off to start with."""
    @On.setter
    def On(self, value: bool) -> None: ...
    @property
    def PaperSize(self) -> bool:
        """Gets or sets whether the stamp holds the name of the sheet; off to start with."""
    @PaperSize.setter
    def PaperSize(self, value: bool) -> None: ...
    @property
    def PlotScale(self) -> bool:
        """Gets or sets whether the stamp holds the plot scale; off to start with."""
    @PlotScale.setter
    def PlotScale(self, value: bool) -> None: ...
    @property
    def SingleLine(self) -> bool:
        """Gets or sets whether the stamp is one line of fields set apart by two spaces; off, each field is a line,
        as it starts."""
    @SingleLine.setter
    def SingleLine(self, value: bool) -> None: ...
    @property
    def TextHeight(self) -> float:
        """Gets or sets the height of the letters, in CadPlotStamp.Units: CadPlotStamp.StartHeight to start with."""
    @TextHeight.setter
    def TextHeight(self, value: float) -> None: ...
    @property
    def Units(self) -> CadPlotStampUnits:
        """Gets or sets the units of the offset and the text height; inches to start with."""
    @Units.setter
    def Units(self, value: CadPlotStampUnits) -> None: ...
    @property
    def UpsideDown(self) -> bool:
        """Gets or sets whether the stamp is turned half round; off to start with."""
    @UpsideDown.setter
    def UpsideDown(self, value: bool) -> None: ...
    @property
    def UserField1(self) -> str:
        """Gets or sets the first field of the user's own; empty for none, as it starts."""
    @UserField1.setter
    def UserField1(self, value: str) -> None: ...
    @property
    def UserField2(self) -> str:
        """Gets or sets the second field of the user's own; empty for none, as it starts."""
    @UserField2.setter
    def UserField2(self, value: str) -> None: ...
    @property
    def UserFields(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets or sets the list of the user's own fields the Field 1 and Field 2 lists of Plot Stamp pick from, as
        its Add / Edit keeps them; empty to start. The list is copied, so that a stamp and its CadPlotStamp.Clone
        keep their own."""
    @UserFields.setter
    def UserFields(self, value: System.Collections.Generic.IReadOnlyList[str]) -> None: ...
    @property
    def Vertical(self) -> bool:
        """Gets or sets whether the stamp reads up the sheet, a quarter turned, instead of along it; off to start
        with."""
    @Vertical.setter
    def Vertical(self, value: bool) -> None: ...
    @property
    def WriteLog(self) -> bool:
        """Gets or sets whether each stamp is also written to the log file; on to start with."""
    @WriteLog.setter
    def WriteLog(self, value: bool) -> None: ...
    def Clone(self) -> CadPlotStamp:
        """Makes a copy that changes apart from this one."""
    def CopyFrom(self, other: CadPlotStamp) -> None:
        """Takes every setting of another stamp, as the Plot Stamp dialog's OK gives the session's stamp what it
        edited in a copy, so that every drawing sharing the stamp sees it."""
    @overload
    def Footprint(self, page: CadPlotPage, width: float, height: float) -> DisplayBox:
        """Where a block of the stamp's size stands on a sheet, as a box in the millimetres of the sheet, Y upward
        from its lower left corner: in CadPlotStamp.Location's corner of the printable area, or of the whole
        sheet where CadPlotStamp.OffsetFromPaperBorder, in by the offset on both sides. A CadPlotStamp.Vertical
        stamp has its width and height changed over, as it lies on the sheet."""
    @overload
    def Footprint(
        self,
        page: CadPlotPage,
        width: float,
        height: float,
        plotUpsideDown: bool,
        unitsPerMillimetre: float,
    ) -> DisplayBox:
        """Where a block of the stamp's size stands on a sheet, as CadPlotStamp.Footprint, the corner taken of the
        image as plotted, as AutoCAD's help puts it: a plot upside down turns the sheet half round, so that a
        stamp at the lower left stands at the upper right of the sheet; and the sheet's units given, a sheet of
        pixels at 96 to the inch (GeometryHelper PNG and JPG) taking 96 / 25.4 to the millimetre."""
    def Lines(
        self,
        document: CadDocument,
        space: CadSpace,
        settings: CadPlotSettings,
        page: CadPlotPage,
        when: System.DateTime,
        login: str,
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """The words of the stamp for a plot, in the order AutoCAD stamps them: the drawing, the layout, the date
        and time, the login name, the plotter, the sheet, the scale, then the two fields of the user's own that
        are not empty. One line where CadPlotStamp.SingleLine, the fields set apart by two spaces; else a line of
        each."""
    def LoadParameterFile(self, path: str) -> None:
        """Reads a plot stamp parameter file into the stamp, as Load of the Plot Stamp dialog: every setting the
        file holds replaces the stamp's; one it does not hold is kept."""
    @staticmethod
    def LogLine(lines: System.Collections.Generic.IReadOnlyList[str]) -> str:
        """The line the log file takes for a stamp: its fields set apart by two spaces, on a line of their own."""
    def LogPath(self, plotFile: str) -> str:
        """The path of the log file for a plot written to a file: CadPlotStamp.LogFile, beside the plot where it
        names no folder."""
    def SaveParameterFile(self, path: str) -> None:
        """Writes the stamp to a plot stamp parameter file, as Save As of the Plot Stamp dialog: the fields, the
        user's fields with the two picked, the corner, the orientation, the offset, the text height, the units
        and the log file. The corner and orientation codes are those of AutoCAD's mm.pss for its defaults
        (location 0 lower left, orientation 1 horizontal), the others in the order of the Location list."""
    @staticmethod
    def ScaleText(scale: float) -> str:
        """A scale of millimetres of sheet to drawing unit as a ratio: 0.05 is 1:20, 2 is 2:1, to four places."""
    def ToMillimetres(self, value: float) -> float:
        """A length in CadPlotStamp.Units in millimetres: 5.08 for 0.2 inch, 2.6458 for 10 pixels."""

class CadPlotStampCorner(System.Enum):
