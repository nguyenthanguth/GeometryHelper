    def __int__(self) -> int: ...

class CadPlotStyle(System.Object):
    """One plot style of a plot style table: what an object of one colour (a colour-dependent .ctb) or of one name
    (a named .stb) is plotted as in place of its own colour, lineweight, linetype and the shape of its line ends
    and corners, as AutoCAD 2021's Plot Style Table Editor lists its properties. A style that changes nothing is
    \"Use object ...\": its colour is the object's, its lineweight 0, its linetype CadPlotStyle.ObjectLinetype,
    its screening 100."""
    ObjectLinetype: ClassVar[int]
    """The linetype value that means the object's own (the editor's \"Use object linetype\"): 31."""
    def __init__(self, name: str) -> None:
        """Makes a style that changes nothing: every property is the object's own."""
    @property
    def Adaptive(self) -> bool:
        """Gets or sets whether the pattern of the linetype is adjusted to finish whole at the end of a line
        (Adaptive adjustment); on by default. Kept and not used by the presenter, which plots a pattern as it is."""
    @Adaptive.setter
    def Adaptive(self, value: bool) -> None: ...
    @property
    def ColorKind(self) -> int:
        """Gets or sets the kind byte of a colour of its own, as the file keeps it in the top byte of mode_color:
        0xC2 (an RGB colour, a colour-dependent table's), 0xC3 (a colour of AutoCAD's index, a named table's). A
        style made in the editor of a table takes the kind of the table."""
    @ColorKind.setter
    def ColorKind(self, value: int) -> None: ...
    @property
    def Description(self) -> str:
        """Gets or sets the description, one line; empty for none."""
    @Description.setter
    def Description(self, value: str) -> None: ...
    @property
    def Dither(self) -> bool:
        """Gets or sets whether the colours are dithered on a plotter that can (the editor's Enable dithering); on
        by default. A PDF or an image has no dots to dither with, so a plot is the same either way."""
    @Dither.setter
    def Dither(self, value: bool) -> None: ...
    @property
    def EffectiveScreening(self) -> int:
        """Gets the screening a plot applies: CadPlotStyle.Screening, 100 where it is above 100."""
    @property
    def Fill(self) -> CadPlotFill:
        """Gets or sets how a filled area is plotted; the object's own by default. Kept and shown, a filled area is
        plotted solid."""
    @Fill.setter
    def Fill(self, value: CadPlotFill) -> None: ...
    @property
    def Grayscale(self) -> bool:
        """Gets or sets whether the colour is plotted as the grey of its brightness (the editor's Convert to
        grayscale); off by default."""
    @Grayscale.setter
    def Grayscale(self, value: bool) -> None: ...
    @property
    def LineEnd(self) -> CadPlotLineEnd:
        """Gets or sets the shape of a line's end; the object's own by default."""
    @LineEnd.setter
    def LineEnd(self, value: CadPlotLineEnd) -> None: ...
    @property
    def LineJoin(self) -> CadPlotLineJoin:
        """Gets or sets the shape of a corner of a line; the object's own by default."""
    @LineJoin.setter
    def LineJoin(self, value: CadPlotLineJoin) -> None: ...
    @property
    def LinePatternSize(self) -> float:
        """Gets or sets the length the pattern of CadPlotStyle.Linetype is built from, in inches as the file keeps
        it; 0.5 by default. One unit of the presenter's patterns is a quarter of it, 3.175 mm at the default."""
    @LinePatternSize.setter
    def LinePatternSize(self, value: float) -> None: ...
    @property
    def LineWeightIndex(self) -> int:
        """Gets or sets which entry of the table's lineweight list the style plots at, as the file keeps it: 0 for
        \"Use object lineweight\" (the table's entry 0, which is 0). CadPlotStyleSheet.LineWeightOf gives its
        millimetres."""
    @LineWeightIndex.setter
    def LineWeightIndex(self, value: int) -> None: ...
    @property
    def Linetype(self) -> int:
        """Gets or sets the linetype the style plots in, 0 to 30 as CadPlotStyle.LinetypeNames lists them, or
        CadPlotStyle.ObjectLinetype (31) for the object's own; 31 by default."""
    @Linetype.setter
    def Linetype(self, value: int) -> None: ...
    LinetypeNames: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """The names of the 32 linetypes a style can plot in, by the value the file keeps: 0 is Solid, 1 to 30 the
    dashed and dotted ones the Linetype list shows, 31 \"Use object linetype\"."""
    @property
    def LocalizedName(self) -> str:
        """Gets or sets the name the editor shows: the same as CadPlotStyle.Name unless a file says another."""
    @LocalizedName.setter
    def LocalizedName(self, value: str) -> None: ...
    @property
    def Name(self) -> str:
        """Gets or sets the name: Color_1 for colour 1 of a colour-dependent table, the name a drawing gives its
        objects in a named one."""
    @Name.setter
    def Name(self, value: str) -> None: ...
    @property
    def PhysicalPen(self) -> int:
        """Gets or sets the number of the physical pen, 1 to 32; 0 for automatic. A PDF or an image has no pens, so
        the number is kept and not used."""
    @PhysicalPen.setter
    def PhysicalPen(self, value: int) -> None: ...
    @property
    def Rgb(self) -> int:
        """Gets or sets the colour the style plots in, 0xRRGGBB, where CadPlotStyle.UsesObjectColor is false; read
        as black for a style of the object's colour. Setting it chooses a colour of its own, of the kind the
        style had."""
    @Rgb.setter
    def Rgb(self, value: int) -> None: ...
    @property
    def Screening(self) -> int:
        """Gets or sets the screening, how much of the colour is plotted, 0 to 100 per cent; 100 by default. A
        colour at 50 is plotted half way to white on the white sheet: pure red #FF0000 at 50 is #FF8080. A table
        of AutoCAD's may keep 255, its \"no screening\", which is read as 100 where the plot is made
        (CadPlotStyle.EffectiveScreening)."""
    @Screening.setter
    def Screening(self, value: int) -> None: ...
    @property
    def UsesObjectColor(self) -> bool:
        """Gets whether the style plots in the object's own colour (the editor's \"Use object color\")."""
    @property
    def VirtualPen(self) -> int:
        """Gets or sets the number of the virtual pen, 1 to 255; 0 for automatic. A PDF or an image has no pens, so
        the number is kept and not used."""
    @VirtualPen.setter
    def VirtualPen(self, value: int) -> None: ...
    def Clone(self) -> CadPlotStyle:
        """Makes a copy that changes apart from this one."""
    def ToString(self) -> str: ...
    def UseObjectColor(self) -> None:
        """Sets the style to plot in the object's own colour."""

class CadPlotStyleFolder(System.Object):
    """The folder of plot style tables the Plot and Page Setup dialogs list and a plot reads, as AutoCAD's Plot
    Styles folder, and the tables the presenter makes itself: acad.ctb, monochrome.ctb, grayscale.ctb and the
    three screening tables, acad.stb, monochrome.stb and grayscale.stb. None is a file of AutoCAD's; they are
    made by CadPlotStyleFolder.BuiltIn and written to the folder by CadPlotStyleFolder.EnsureBuiltIns."""
    BuiltInNames: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """Gets the names of the tables the presenter makes, in the order the lists show them, with the extension:
    acad.ctb and on."""
    DefaultPath: ClassVar[str]
    """The name of the folder the presenter makes where Global settings give none: PlotStyles under
    %AppData%\\GeometryHelper\\Drawing."""
    @staticmethod
    def BuiltIn(fileName: str) -> CadPlotStyleSheet:
        """Makes one of the tables the presenter makes. acad changes nothing; monochrome plots every colour in
        black; grayscale plots every colour as the grey of its brightness (dithering and grayscale on, the
        object's colour kept); Screening 25%, 50 and 75 plot the object's colour screened to that per cent."""
    @staticmethod
    def CheckFileName(name: str) -> str:
        """Says why a name cannot name a plot style table file, as Windows refuses one: empty, longer than 120
        letters, or with a character a file name cannot hold. The extension is not part of the name."""
    @staticmethod
    def EnsureBuiltIns(folder: str) -> System.Collections.Generic.IReadOnlyList[str]:
        """Makes the folder where it is missing and writes the tables the presenter makes that it lacks, never one
        it has: a table the user edited is kept. The window calls it as it starts and after Global settings
        change the folder."""
    @staticmethod
    def Load(folder: str, fileName: str) -> CadPlotStyleSheet:
        """Reads a table of a folder by its name: the file, letters of either case the same; where the file is not
        there, or the folder is empty, the built-in table of that name. A file that does not read is said once in
        the log, as a warning, and the built-in table of its name stands in where there is one."""
    @staticmethod
    def Names(folder: str, named: bool) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the tables a folder holds, to list in the Plot dialog: its .ctb files (named false) or
        its .stb files, in ordinal order of their names with letters of either case the same, ties by case. Where
        folder is empty, the names of the tables the presenter makes of that kind."""
    @staticmethod
    def Resolve(setting: str, settingsFile: str = ...) -> str:
        """Gets the folder a setting stands for: the setting, trimmed, where it names one; where it is empty the
        folder PlotStyles beside the settings file, which is CadPlotStyleFolder.DefaultPath for the user's own
        settings file."""

class CadPlotStyleResolver(System.Object):
    """Looks up the plot style of the items of a plot, as AutoCAD plots with a plot style table: with a
    colour-dependent table (.ctb) the style of the item's colour of AutoCAD's index; with a named one (.stb) the
    style named by the item's entity or, ByLayer, by its layer, Normal where none is named. It is made once for a
    plot (CadPlotStyleResolver.Create) and read for each item (CadPlotStyleResolver.PenFor)."""
    @property
    def IsNamed(self) -> bool:
        """Gets whether the table is a named one: styles are found by the name an item's entity or layer gives."""
    @property
    def Sheet(self) -> CadPlotStyleSheet:
        """Gets the table the plot reads; null where there is none, or it was not found and the colours go through
        the three legacy tables' rules."""
    @overload
    @staticmethod
    def Create(document: CadDocument, settings: CadPlotSettings) -> CadPlotStyleResolver:
        """Makes the resolver of a plot: the table the settings name (CadPlotSettings.EffectiveStyleSheet), read
        from the document's CadDocument.PlotStyleFolder."""
    @overload
    @staticmethod
    def Create(document: CadDocument, styleSheet: str) -> CadPlotStyleResolver:
        """Makes the resolver of a table of a document's folder, by its file name."""
    @overload
    def PenFor(self, item: DisplayItem2) -> CadPlotPen:
        """Gets the pen of an item: its colour, and what its style sets."""
    @overload
    def PenFor(self, rgb: int, layer: str, handle: str) -> CadPlotPen:
        """Gets the pen of an object of a colour, a layer and an entity."""
    def PlottedColor(self, rgb: int) -> int:
        """Gets the colour an object of a colour plots in where it has no plot style of its own to name: through the
        style of the colour in a colour-dependent table, Normal's in a named one."""
    def StyleNameOf(self, layer: str, handle: str) -> str:
        """Gets the name of the plot style an entity on a layer has in a drawing of named plot styles: its own where
        it names one, else its layer's, else Normal."""

class CadPlotStyleSheet(System.Object):
    """A plot style table, the content of AutoCAD's .ctb (colour-dependent: 255 styles, one for each colour of
    AutoCAD's index) or .stb (named: styles a drawing's objects and layers are given by name, the first of them
    Normal) file, with the reader and writer of the file. A plot looks an object's style up in it
    (CadPlotStyleResolver)."""
    ColorCount: ClassVar[int]
    """The number of styles of a colour-dependent table: one for each colour of AutoCAD's index, 1 to 255."""
    ColorDependentExtension: ClassVar[str]
    """The extension of a colour-dependent plot style table file: .ctb."""
    NamedExtension: ClassVar[str]
    """The extension of a named plot style table file: .stb."""
    NormalName: ClassVar[str]
    """The name of the first style of a named table, which cannot be removed or renamed."""
    @property
    def ApplyGlobalScaleFactor(self) -> bool:
        """Gets or sets whether the global scale factor is applied to the linetypes that are not ISO's (the editor's
        Apply global scale factor to non-ISO linetypes); off by default. Kept and not used."""
    @ApplyGlobalScaleFactor.setter
    def ApplyGlobalScaleFactor(self, value: bool) -> None: ...
    @property
    def Description(self) -> str:
        """Gets or sets the description of the table, one line; empty for none."""
    @Description.setter
    def Description(self, value: str) -> None: ...
    @property
    def FileName(self) -> str:
        """Gets or sets the name of the file the table is kept in, as monochrome.ctb, which a drawing's plot
        settings name it by; empty for a table not yet saved. CadPlotStyleSheet.Load and the folder set it."""
    @FileName.setter
    def FileName(self, value: str) -> None: ...
    @property
    def IsNamed(self) -> bool:
        """Gets whether the table is a named one (.stb) rather than a colour-dependent one (.ctb)."""
    @property
    def LineWeights(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the lineweights the styles choose from, in millimetres: entry 0 is 0, \"Use object lineweight\"."""
    @property
    def LineWeightsInInches(self) -> bool:
        """Gets or sets whether the editor lists lineweights in inches (custom_lineweight_display_units 1) rather
        than millimetres (0): the table's lineweights are millimetres either way."""
    @LineWeightsInInches.setter
    def LineWeightsInInches(self, value: bool) -> None: ...
    @property
    def ScaleFactor(self) -> float:
        """Gets or sets the global scale factor of the table; 1 by default. Kept and not used."""
    @ScaleFactor.setter
    def ScaleFactor(self, value: float) -> None: ...
    @property
    def Styles(self) -> System.Collections.Generic.IReadOnlyList[CadPlotStyle]:
        """Gets the styles: for a colour-dependent table the 255 of colours 1 to 255 in that order, for a named one
        Normal and then the others in the order they were added."""
    def AddStyle(self, name: str) -> CadPlotStyle:
        """Adds a style to a named table, as Add Style of the editor does: one that changes nothing, its colour kind
        a named table's, last in the list."""
    @staticmethod
    def CheckStyleName(name: str) -> str:
        """Says why a name cannot name a plot style, as AutoCAD refuses one: empty, longer than 255 letters, or with
        a < > / \\ \" : ; ? * | , = ` in it."""
    def Clone(self) -> CadPlotStyleSheet:
        """Makes a copy that changes apart from this one."""
    @staticmethod
    def FromText(text: str, isNamed: bool) -> CadPlotStyleSheet:
        """Reads a table from its text, as CadPlotStyleSheet.ToText gives it and AutoCAD's files hold it."""
    def LineWeightIndexOf(self, millimetres: float) -> int:
        """Gets the entry of CadPlotStyleSheet.LineWeights that holds a lineweight, to the hundredth of a
        millimetre; the table gets a new entry at its end where it has none, as Edit Lineweights adds one."""
    def LineWeightOf(self, style: CadPlotStyle) -> float:
        """Gets the millimetres a style plots at: its entry of CadPlotStyleSheet.LineWeights; 0 for \"Use object
        lineweight\" or an entry the table lacks."""
    @staticmethod
    def Load(path: str) -> CadPlotStyleSheet:
        """Reads a .ctb or .stb file."""
    @staticmethod
    def NewColorDependent() -> CadPlotStyleSheet:
        """Makes a colour-dependent table of 255 styles that change nothing, Color_1 to Color_255: a plot with it is
        as with no table, as AutoCAD's acad.ctb."""
    @staticmethod
    def NewNamed() -> CadPlotStyleSheet:
        """Makes a named table of one style, Normal, which changes nothing; CadPlotStyleSheet.AddStyle adds the
        others."""
    @staticmethod
    def Read(bytes: Sequence[int] | System.Array[int]) -> CadPlotStyleSheet:
        """Reads a table from the bytes of a file. The head tells a colour-dependent table (CTBVER1) from a named
        one (STBVER1); the numbers after it are not checked, the stream is inflated to its end. A block or a line
        the reader does not know is passed over, a value that does not read keeps its default, a pen or a
        screening out of its range is brought to the range, and a colour-dependent table that lists fewer than
        255 styles keeps the default of the others."""
    def RemoveStyle(self, name: str) -> bool:
        """Takes a style out of a named table, as Delete Style of the editor does."""
    def RenameStyle(self, name: str, newName: str) -> None:
        """Gives a style of a named table another name, as editing its name in the editor does."""
    def Save(self, path: str) -> None:
        """Writes the table to a .ctb or .stb file (CadPlotStyleSheet.ToBytes), the folder made where it is missing,
        and sets CadPlotStyleSheet.FileName to the file's name."""
    def SetLineWeight(self, index: int, millimetres: float) -> None:
        """Changes an entry of CadPlotStyleSheet.LineWeights, as Edit Lineweights of the editor does; entry 0 stays
        \"Use object lineweight\"."""
    def StyleForColorIndex(self, colorIndex: int) -> CadPlotStyle:
        """Gets the style of a colour of AutoCAD's index in a colour-dependent table."""
    def StyleNamed(self, name: str) -> CadPlotStyle:
        """Gets the style of a name in a named table, letters of either case the same."""
    def ToBytes(self) -> System.Array[int]:
        """Gives the file: the head, the three numbers and the packed CadPlotStyleSheet.ToText, as
        CadPlotStyleSheet.Save writes it."""
    def ToString(self) -> str: ...
    def ToText(self) -> str:
        """Gives the text of the file, before it is packed: lines ended by a line feed, blocks indented by a space a
        level, numbers with six decimals, the text ended as the file ends it, by a nought byte. A
        colour-dependent table lists the colours (aci_table) and says aci_table_available=TRUE."""

class CadPlotStyleTable(System.Enum):
    """The three plot style tables the presenter first made in code, kept as a way in to CadPlotSettings.StyleTable:
    the files they stand for are monochrome.ctb, grayscale.ctb and none. A table of another name is
    CadPlotSettings.StyleSheet."""
    Grayscale: ClassVar[CadPlotStyleTable]
    """Every colour plots as the grey of its brightness, as AutoCAD's grayscale.ctb."""
    Monochrome: ClassVar[CadPlotStyleTable]
    """Every colour plots black, as AutoCAD's monochrome.ctb."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadPlotStyles(System.Object):
    """The plot style tables the presenter makes in code, as AutoCAD's monochrome.ctb and grayscale.ctb colour a
    plot: no table file is read. White, AutoCAD's colour 7 on a dark screen, plots black on the white sheet with
    every table."""
    @staticmethod
    def Map(table: CadPlotStyleTable, rgb: int) -> int:
        """Gets the colour an object of a colour plots in: black with CadPlotStyleTable.Monochrome; with
        CadPlotStyleTable.Grayscale the grey of its brightness, 0.299 red, 0.587 green and 0.114 blue, so pure
        red plots #4C4C4C, green #969696 and blue #1D1D1D; with CadPlotStyleTable.None its own. White, and
        colours within 2 per cent of it, plot black with each."""

class CadPreview(System.Object):
    """What a prompt draws under the cursor while it waits, as AutoCAD 2021 drags the object a command is about to
    make: the entities the command would make were a point picked at the cursor the answer, made by the same code
    that makes them when it is, and the copies of objects it would move, each under a transformation. RECTANG
    asking its other corner, the cursor at (30, 20) from a first corner at the origin, previews the closed
    polyline 30 by 20 it makes when (30, 20) is picked."""
    @property
    def Fades(self) -> bool:
        """Gets whether CadPreview.Items are pieces the answer takes out of the drawing rather than objects it
        makes, drawn faded as AutoCAD 2021's TRIM draws the piece under the cursor it would cut away: of a line
        150 long crossed at 50, the 50 on the cursor's side. With CadPreview.Shift held at TRIM or EXTEND it is
        the other command's: TRIM then previews the object extended, not faded, and EXTEND fades the piece a trim
        takes out."""
    @property
    def FadesOriginals(self) -> bool:
        """Gets whether the objects of CadPreview.Handles leave where they stand once the answer is given, so that
        they are drawn faded there while their copies follow the cursor, as AutoCAD 2021's SCALE and ROTATE draw
        them; false where they stay, as with the Copy option, or where the preview moves none."""
    @property
    def Handles(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the objects whose copies CadPreview.Moves places, in ordinal order; empty where the preview moves
        none."""
    @property
    def Shift(self) -> bool:
        """Gets or sets whether Shift is held, which a window sets before it asks for the preview: the answer
        previewed then carries it (CadInput.Shift), as a pick with Shift held does, so that TRIM previews what
        EXTEND would do to the object under the cursor and EXTEND what TRIM would."""
    @Shift.setter
    def Shift(self, value: bool) -> None: ...
    @property
    def ShowsBand(self) -> bool:
        """Gets whether the rubber band from the prompt's base point is drawn with the preview, as CIRCLE draws its
        radius to the cursor; false where AutoCAD draws the object alone, as RECTANG draws its rectangle."""
    @property
    def Typed(self) -> str:
        """Gets or sets the text typed so far at a prompt for a line of text, which a window sets before it asks for
        the preview: the answer previewed is then that text, so that TEXT at \"Enter text\" previews the words
        typed where the line will stand. Null or empty previews nothing there."""
    @Typed.setter
    def Typed(self, value: str | None) -> None: ...
    def Items(self, cursor: GeoPoint2) -> System.Collections.Generic.IReadOnlyList[DisplayItem2]:
        """Gets the display items of the entities the command would make were a point picked at the cursor, drawn as
        they will be once made: their layer, colour and linetype the current ones. Empty where the point makes
        nothing, as a second corner in line with the first makes no rectangle."""
    def Moves(self, cursor: GeoPoint2) -> System.Collections.Generic.IReadOnlyList[Affine2]:
        """Gets the transformations the copies of CadPreview.Handles are drawn under were a point picked at the
        cursor: one for ROTATE by a reference, one for each copy a rectangular array of 4 columns and 3 rows
        adds. Empty for none."""

class CadProgress(System.Object):
    """The progress meter of the status bar, as AutoCAD's: OPEN, SAVE and SAVEAS start one, and a command, a plugin
    or the host starts its own with CadProgress.Start for any long work. The meter last started and not yet
    stopped is the one shown: one started while another runs, as a plugin's inside SAVE, is shown in its place,
    and the one under it comes back when it stops."""
    def __init__(self) -> None: ...
    @property
    def Depth(self) -> int:
        """Gets how many meters are running, the one shown and those under it."""
    @property
    def IsBusy(self) -> bool:
        """Gets whether a meter is running."""
    @property
    def Shown(self) -> CadProgressMeter:
        """Gets the meter shown: the one last started and not yet stopped; null with none running."""
    @property
    def Changed(self) -> System.EventHandler[System.EventArgs]:
        """Raised, on the thread that made the change, when what the status bar shows of the meters changes."""
    @Changed.setter
    def Changed(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    def Start(self, label: str) -> CadProgressMeter:
        """Starts a meter, shown at once in the place of the one shown before: indeterminate until it is given a
        limit (CadProgressMeter.SetLimit) or a share (CadProgressMeter.Report). Stop it, or dispose of it, when
        the work ends; a using block stops it when the work throws."""

class CadProgressMeter(System.Object):
    """One meter of the status bar, started by CadProgress.Start, as AutoCAD's ProgressMeter: given a limit
    (CadProgressMeter.SetLimit) and moved a step at a time (CadProgressMeter.MeterProgress), or told a share of 0
    to 1 as an IProgress (CadProgressMeter.Report), as CadDocument.SaveAs tells it; indeterminate, a sweep with
    no percent, until either. Stopping it, or disposing of it, takes it off the status bar; a meter stopped is
    not moved again."""
    @property
    def IsIndeterminate(self) -> bool:
        """Gets whether it is indeterminate: given neither a limit nor a share yet."""
    @property
    def IsRunning(self) -> bool:
        """Gets whether it runs: started and not yet stopped."""
    @property
    def Label(self) -> str:
        """Gets what the status bar says of it, as \"Saving plan.dwg\"."""
    @property
    def Limit(self) -> int:
        """Gets the number of steps it was given by CadProgressMeter.SetLimit; 0 for none."""
    @property
    def Percent(self) -> int:
        """Gets the whole percent it shows, 0 to 100; -1 while it is indeterminate."""
    @property
    def Position(self) -> int:
        """Gets the steps made since the limit was set."""
    def Dispose(self) -> None:
        """Stops it, as CadProgressMeter.Stop."""
    def MeterProgress(self) -> None:
        """Moves it one step of its limit, as AutoCAD's MeterProgress; a step past the limit leaves it at 100 %, and
        one with no limit set does nothing."""
    def Report(self, value: float) -> None:
        """Shows a share of the work done, 0 to 1, as a whole percent rounded down: 0.405 shows 40 %. A share below
        0 is 0, one above 1 is 1, and one that is not a number is not shown."""
    def SetLimit(self, limit: int) -> None:
        """Sets the number of steps the work takes, the meter going back to 0 %, as AutoCAD's SetLimit; 0 makes it
        indeterminate again."""
    def Stop(self) -> None:
        """Stops it, taking it off the status bar and showing the meter under it, if any; stopping it again does
        nothing."""
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class CadPrompt(System.Object):
    """One question a command asks on the command line, as AutoCAD asks it: a message, the keywords offered in
    square brackets, each typed by its capital letters, and the default Enter takes in angle brackets, so that
    Specify base point or [Displacement] <Displacement>: is a point prompt with the keyword Displacement, which
    is also its default."""
    @property
    def AcceptsText(self) -> bool:
        """Gets whether text that is neither a point nor a keyword is taken as an answer of text, as ZOOM takes 2X;
        false for most prompts."""
    @property
    def AsksPlainAngle(self) -> bool:
        """Gets whether the angle asked is taken as typed, counter-clockwise, whatever ANGBASE and ANGDIR are, as
        the obliquing angle of a text style and the direction -UNITS asks for angle nought are. False for every
        other prompt."""
    @property
    def AsksTurn(self) -> bool:
        """Gets whether the angle asked is an amount turned, as ROTATE's rotation angle, the included angle of an
        arc and the rotation of INSERT are, and not a direction: an angle typed is then turned the way ANGDIR
        counts and ANGBASE is left out of it, and a point picked gives its direction counted from ANGBASE, as
        AutoCAD's own prompts do. With ANGBASE at north and ANGDIR clockwise, 30 typed at ROTATE turns the
        objects 30 degrees clockwise, where 30 typed for the rotation of a text sets it along the direction 60
        degrees counter-clockwise from east. False for a prompt that asks a direction, and for every prompt that
        asks no angle."""
    @property
    def Band(self) -> CadSelectionBand:
        """Gets the band an option of \"Select objects:\" draws while the prompt asks its next point: the box of
        Window, Crossing and BOX from its first corner, the line of Fence and the polygon of WPolygon and
        CPolygon through the points given, each to the cursor. Null for every other prompt."""
    @property
    def BasePoint(self) -> GeoPoint2 | None:
        """Gets the point a rubber band is drawn from and a typed relative point, distance or angle is measured
        from; null for none."""
    @property
    def Default(self) -> str:
        """Gets the default Enter takes, as shown in angle brackets; null for none. A default that is one of the
        keywords is that keyword."""
    @property
    def Drag(self) -> CadBlockDrag:
        """Gets the block dragged with the cursor while the prompt waits, as INSERT drags it while it asks the
        insertion point, the scale and the rotation: the canvas draws the block's outlines where the cursor would
        place it. Null for every other prompt."""
    @property
    def InPlace(self) -> CadInPlaceEdit:
        """Gets the text edited in place on the canvas where the prompt asks for one, as TEXTEDIT and MTEXT ask: the
        window shows its edit box or the MTEXT editor over the text and answers the prompt with the words when
        the edit ends, Enter with nothing where it is cancelled; a test answers it as any prompt for text. Null
        for every other prompt."""
    @property
    def Keywords(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the keywords offered, written as AutoCAD writes them, the capital letters being what is typed:
        \"Displacement\", \"mOde\"."""
    @property
    def Kind(self) -> CadPromptKind:
        """Gets what the prompt asks for."""
    @property
    def Mark(self) -> GeoPoint2 | None:
        """Gets the point the canvas marks with a cross while the prompt waits, as -ATTEDIT marks the attribute it
        is editing; null for none."""
    @property
    def Message(self) -> str:
        """Gets the message before the keywords: \"Specify base point\"."""
    @property
    def Preview(self) -> CadPreview:
        """Gets what the canvas draws under the cursor while the prompt waits, as AutoCAD 2021 drags the object
        about to be made: the rectangle RECTANG would make with the cursor as its other corner, the circle CIRCLE
        would make with the cursor on it, the copies ROTATE would turn by a reference. Null where the prompt
        draws no more than its rubber band."""
    @property
    def SnapFrom(self) -> GeoPoint2 | None:
        """Gets the point perpendicular and tangent snaps are drawn from where the prompt has no
        CadPrompt.BasePoint, as AutoCAD 2021's dimension commands draw them from the last point given (LASTPOINT)
        at their first extension line origin, the vertex of an angle and the feature of an ordinate; null for
        every other prompt. No rubber band is drawn from it, and ortho and polar do not work from it."""
    @property
    def TakesSpaces(self) -> bool:
        """Gets whether a space typed is part of the answer: true for a prompt for text (CadPromptKind.String) and
        false for every other kind, and for the text AutoLISP's getstring asks without its first argument, where
        a space ends the answer as Enter does and the rest of the line is the next input. The window types a
        space only where this is true and takes Space as Enter elsewhere."""
    @property
    def Text(self) -> str:
        """Gets the whole text the command line shows: Specify base point or [Displacement] <Displacement>:; after
        \">>\" for a command run inside another, as 'ZOOM's >>Specify first corner:."""
    @property
    def Tracks(self) -> bool:
        """Gets whether the prompt follows the cursor, as REVCLOUD's Freehand follows the crosshairs: the canvas
        answers it with each point the cursor moves to, and the history keeps none of those answers. False for
        every other prompt."""
    @staticmethod
    def ForAngle(
        message: str,
        basePoint: GeoPoint2 | None = ...,
        keywords: System.Collections.Generic.IReadOnlyList[str] = ...,
        defaultValue: str = ...,
    ) -> CadPrompt:
        """Asks for an angle."""
    @staticmethod
    def ForDistance(
        message: str,
        basePoint: GeoPoint2 | None = ...,
        keywords: System.Collections.Generic.IReadOnlyList[str] = ...,
        defaultValue: str = ...,
    ) -> CadPrompt:
        """Asks for a distance."""
    @staticmethod
    def ForEntity(
        message: str,
        keywords: System.Collections.Generic.IReadOnlyList[str] = ...,
        defaultValue: str = ...,
    ) -> CadPrompt:
        """Asks for one object: \"Select arc or circle:\"."""
    @staticmethod
    def ForInPlaceEdit(message: str, edit: CadInPlaceEdit) -> CadPrompt:
        """Asks for the words of a text edited in place (CadPrompt.InPlace): a prompt for text the window answers
        from its editor."""
    @staticmethod
    def ForInteger(
        message: str,
        keywords: System.Collections.Generic.IReadOnlyList[str] = ...,
        defaultValue: str = ...,
    ) -> CadPrompt:
        """Asks for a whole number."""
    @staticmethod
    def ForKeyword(
        message: str,
        keywords: System.Collections.Generic.IReadOnlyList[str],
        defaultValue: str = ...,
    ) -> CadPrompt:
        """Asks for one of a list of keywords: \"Erase source objects? [Yes/No] <No>:\"."""
    @staticmethod
    def ForPoint(
        message: str,
        basePoint: GeoPoint2 | None = ...,
        keywords: System.Collections.Generic.IReadOnlyList[str] = ...,
        defaultValue: str = ...,
        acceptsText: bool = ...,
    ) -> CadPrompt:
        """Asks for a point."""
    @staticmethod
    def ForSelection(message: str = ...) -> CadPrompt:
        """Asks for objects until Enter: \"Select objects:\"."""
    @staticmethod
    def ForString(message: str, defaultValue: str = ...) -> CadPrompt:
        """Asks for a text."""
    def MatchKeyword(self, typed: str) -> str:
        """Finds the keyword a typed answer names: the whole keyword or its capital letters, either case, or a
        longer start of it; \"D\", \"disp\" and \"Displacement\" all name Displacement, and \"CL\" names CLose
        where C names Close. An underscore in front is taken off, as AutoCAD takes \"_A\" for A."""
    @staticmethod
    def Shortcut(keyword: str) -> str:
        """The capital letters of a keyword, what AutoCAD types it by: D for Displacement, O for mOde, CL for
        CLose."""
    def ToString(self) -> str: ...

class CadPromptKind(System.Enum):
    """What a prompt asks for."""
    Angle: ClassVar[CadPromptKind]
    """An angle in degrees, typed or as the direction from the prompt's base point to a point picked; with no base
    point, as the direction from one point to a second, asked \"Specify second point:\"."""
    Distance: ClassVar[CadPromptKind]
    """A distance, typed or as the distance from the prompt's base point to a point picked; with no base point, as
    the distance between two points, the second asked \"Specify second point:\"."""
    Entity: ClassVar[CadPromptKind]
    """One object, picked."""
    Integer: ClassVar[CadPromptKind]
    """A whole number."""
    Keyword: ClassVar[CadPromptKind]
    """One of the prompt's keywords."""
    Point: ClassVar[CadPromptKind]
    """A point, picked or typed as x,y, @dx,dy or @distance<angle."""
    Selection: ClassVar[CadPromptKind]
    """Objects, picked one by one or by a window, until Enter ends the selection."""
    String: ClassVar[CadPromptKind]
    """A text."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadProperties(System.Object):
    """Describes a selection for the Properties panel, as AutoCAD's Properties palette does.

    The rows of a dimension, as AutoCAD's palette heads them: Misc, Lines & Arrows, Text, Fit and Primary Units."""
    CustomGroup: ClassVar[str]
    """The title of the group of a dynamic block's properties, as AutoCAD's palette names it: its rows are set
    through CadDynamicBlocks.SetProperty, by the name of the property, not through CadPropertyEditor."""
    @overload
    @staticmethod
    def Describe(
        document: CadDocument,
        space: CadSpace,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
    ) -> CadSelectionInfo:
        """Describes the selected entities as AutoCAD's Properties palette does. With none selected, the current
        settings the drawing's header holds (General: colour, layer, linetype, its scale, lineweight,
        transparency), the plot style, the view of the space (its centre, height and width, those of what the
        space draws, read-only) and Misc (the annotation scale, the UCS icon, the visual style \"2D Wireframe\").
        With one, the box reads \"Line (1)\" and the rows are its General ones (its colour as ByLayer, ByBlock,
        Red to White, an index such as 8, or red, green and blue such as 255,128,0) and those of its kind: a line
        from (0, 0) to (300, 400) has Length 500.0000 and, at an $AUPREC of 0, Angle 53. With several, the box
        reads \"Line (3)\" where they are all of one kind and \"All (3)\" where not, and the rows are those they
        share, a value that differs shown as CadPropertyRow.VariesText. Numbers are written in the invariant
        culture, lengths and coordinates to 4 places, angles in degrees to the places the header's $AUPREC gives."""
    @overload
    @staticmethod
    def Describe(
        document: CadDocument,
        space: CadSpace,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
        view: CadView,
    ) -> CadSelectionInfo:
        """Describes the selected entities as CadProperties.Describe does, the View group of no selection showing
        what the canvas shows: the centre, height and width of the view's visible box, in model space the model's
        view and in a layout the paper's, as AutoCAD's palette shows them. A canvas 1 000 by 500 pixels at 2
        pixels to the unit about (100, 50) shows Center X 100.0000, Height 250.0000 and Width 500.0000."""
    @staticmethod
    def Kinds(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
    ) -> System.Collections.Generic.IReadOnlyList[CadSelectionKind]:
        """The list the selection box of the Properties palette drops down, as AutoCAD's does: the whole selection
        first, then, where there are objects of several kinds, one row for each kind with its count, in the order
        of the kinds' names. Of seven objects, five MTEXTs and two OLE frames, the rows read \"All (7)\", \"MText
        (5)\" and \"OLE Object (2)\"; of three lines the one row reads \"Line (3)\", which is the whole
        selection. CadProperties.Describe of a row's handles shows its properties as though only those objects
        were selected."""

class CadPropertyEditor(System.Object):
    """Sets a property of the selected entities from the Properties panel, as AutoCAD's palette does: the row's
    label and the text typed into it, the text written as CadProperties.Describe shows it, so that what a row
    shows can be typed back. One call is one undo step.

    The rows of polylines, ellipses, hatches, dimensions, MTEXTs, block references, viewports and multileaders,
    set as AutoCAD 2021's palette sets them."""
    @staticmethod
    def Set(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
        label: str,
        value: str,
    ) -> CadEditResult:
        """Sets one property of entities."""

class CadPropertyGroup(System.Object):
    """A titled group of rows of the Properties panel, such as General or Geometry."""
    def __init__(self, title: str, rows: System.Collections.Generic.IReadOnlyList[CadPropertyRow]) -> None:
        """Makes a group."""
    @property
    def Rows(self) -> System.Collections.Generic.IReadOnlyList[CadPropertyRow]:
        """Gets the rows."""
    @property
    def Title(self) -> str:
        """Gets the title."""

class CadPropertyKind(System.Enum):
    """What kind of value a row of the Properties panel holds, which tells the window what to offer for it: a box
    typed into, a drop-down of the choices, a check box, or the list of the drawing's colours, layers, linetypes
    or lineweights."""
    Angle: ClassVar[CadPropertyKind]
    """An angle, in the drawing's angle units."""
    Check: ClassVar[CadPropertyKind]
    """A check box."""
    Choice: ClassVar[CadPropertyKind]
    """One of the row's own choices."""
    Color: ClassVar[CadPropertyKind]
    """A colour: the window offers its list, and Select Color."""
    Layer: ClassVar[CadPropertyKind]
    """A layer: the window offers the drawing's layers."""
    Length: ClassVar[CadPropertyKind]
    """A length, in the drawing's units."""
    Linetype: ClassVar[CadPropertyKind]
    """A linetype: the window offers the drawing's linetypes."""
    Lineweight: ClassVar[CadPropertyKind]
    """A lineweight: the window offers AutoCAD's widths."""
    Number: ClassVar[CadPropertyKind]
    """A number, typed as it is in the invariant culture."""
    Text: ClassVar[CadPropertyKind]
    """A text typed into."""
