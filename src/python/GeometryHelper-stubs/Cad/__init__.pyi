class CadRemoteServer(System.Object):
    """Writing objects: the queued inserts, modifies and deletes of a client, applied as one undo step.

    The side of the remote channel that lives in the app: it listens on a named pipe for the programs that drive
    the app (CadApplication of GeometryHelper.Cad.Remote), announces itself in a file so that they find it, and
    answers each request on the thread of the drawings through the dispatcher it is given. It has no UI and is
    started by the app's host; where nothing starts it, nothing listens.

    Reading objects: by handle, by filter, and the packing of them into the small drawing they travel in.

    Waiting for the user to pick a point or objects in a drawing, on the drawing's own command line.

    The requests the server answers.

    The layers and the layouts of a drawing, read and set from outside."""
    def __init__(self, host: ICadRemoteHost, dispatcher: ICadRemoteDispatcher) -> None:
        """Makes a server for an app; nothing listens until CadRemoteServer.Start."""
    @property
    def IsRunning(self) -> bool:
        """Gets whether the server is listening."""
    @property
    def PipeName(self) -> str:
        """Gets the name of the pipe the server listens on."""
    def Dispose(self) -> None:
        """Stops the server."""
    def NoteActivated(self) -> None:
        """Writes the instance file again with the window's title and the time now as the time the app was last
        activated. The host calls it when the user activates the window, on the thread of the drawings."""
    def Start(self) -> None:
        """Opens the pipe, writes the instance file and starts listening. Call it on the thread of the drawings: it
        reads the window's title."""
    def Stop(self) -> None:
        """Stops listening, closes the connections and deletes the instance file. Calling it again does nothing."""
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

