        current layer, 0 and Defpoints are kept. A layer deleted leaves the list."""
    def Restore(self) -> bool:
        """Puts every layer back as it was before the walk, as closing with Restore on exit does."""
    def Walk(self, names: System.Collections.Generic.IReadOnlyCollection[str]) -> bool:
        """Walks layers: every layer but those named is turned off, those named turned on and thawed. A name no
