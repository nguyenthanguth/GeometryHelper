        of the class)."""
    @staticmethod
    def PathFor(fullPath: str, type: CadPathType, drawingFolder: str) -> str:
        """Gets the path to write for a file, as AutoCAD's Path type writes it: Full the full path; None the file's
        name; Relative the way from the drawing's folder, .\\grid.dxf beside it and ..\\xref\\grid.dxf up one,
        the full path where the drawing has no folder yet (it is not saved) or the file is on another drive."""
    @staticmethod
    def PathTypeOf(savedPath: str) -> CadPathType:
        """Gets how a saved path is written: Full where it is rooted, None for a file's name alone, Relative
        otherwise."""
