class CadDimStyleEditor(System.Object):
    """The edits of the dimension style table, as AutoCAD's Dimension Style Manager (DIMSTYLE) makes them: each one
    undo step through CadDocument.ApplyEdit, refused where AutoCAD refuses it. A style's variables travel as
    values by their names (Dimasz, Dimtxt), the names of the library's DxfDimStyleTableRecord; an arrowhead as
    its name in CadArrowheads.Names (Closed filled for none), a text style or a linetype as its name, null for
    none."""
    AnnotativeKey: ClassVar[str]
    """The key of the style's Annotative flag among the values a dialog hands to CadDimStyleEditor.Apply and
    CadDimStyleEditor.Add: a bool, not a variable."""
    VariableNames: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """Gets the names of the variables a style has, as the library names them, in ordinal order: Dimadec to
    Dimzin."""
    @staticmethod
    def Add(
        document: CadDocument,
        name: str,
        from_: str,
        /,
        values: System.Collections.Generic.IDictionary[str, object],
    ) -> CadEditResult:
        """Adds a style, as the Manager's New: a copy of another's variables (Start With), under a name no style of
        the drawing has."""
    @staticmethod
    def Apply(
        document: CadDocument,
        name: str,
        values: System.Collections.Generic.IDictionary[str, object],
    ) -> CadEditResult:
        """Writes variables into a style, as OK of the Manager's Modify: each that differs, then the dimensions
        drawn in it drawn again (see the remarks), and the header given them where the style is current. Nothing
        is written where none differs."""
    @staticmethod
    def Compare(
        first: System.Collections.Generic.IDictionary[str, object],
        second: System.Collections.Generic.IDictionary[str, object],
    ) -> System.Collections.Generic.IReadOnlyList[System.Collections.Generic.KeyValuePair[str, System.Array[str]]]:
        """Gets the variables in which two sets of values differ, as the Manager's Compare lists them: each name
        with the two values as text, in ordinal order of the names."""
    @staticmethod
    def CountUses(document: CadDocument, name: str) -> int:
        """Gets how many dimensions are drawn in a style, or in a style AutoCAD keeps for one kind of them
        (ISO-25$0), in every space and block."""
    @staticmethod
    def Current(database: DxfDatabase) -> str:
        """Gets the name of the current dimension style ($DIMSTYLE), as the table spells it; the first style where
        the header names none the drawing has."""
    @staticmethod
    def Delete(document: CadDocument, name: str) -> CadEditResult:
        """Deletes a style, as the Manager's Delete: refused for Standard, the current style and a style dimensions
        are drawn in, saying how many."""
    @staticmethod
    def Override(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
        values: System.Collections.Generic.IDictionary[str, object],
    ) -> CadEditResult:
        """Writes variables as overrides of the dimensions given, as AutoCAD's DIMOVERRIDE writes them into a
        dimension's extended data (ACAD, DSTYLE), each dimension then drawn again; the style is left as it is. A
        dimension an owner keeps is refused through the document's edit gate."""
    @staticmethod
    def Read(style: DxfDimStyleTableRecord) -> System.Collections.Generic.SortedDictionary[str, Any]:
        """Reads the variables of a style, or of the dimension style data a dimension or the header gives, by their
        names."""
    @staticmethod
    def Rename(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Renames a style with the dimensions drawn in it, as the Manager's Rename; Standard keeps its name."""
    @staticmethod
    def Samples(source: DxfDatabase, values: System.Collections.Generic.IDictionary[str, object]) -> DxfDatabase:
        """Makes the sample dimensions of the Manager's preview: a drawing of its own holding the style's variables
        (the text style copied by its name and font, the arrowheads' blocks made), a part 32 by 20 with a linear
        dimension across its top, a circle of radius 12 with its radius and an angle of 60 degrees, drawn as the
        DIM commands draw them."""
    @staticmethod
    def SetCurrent(document: CadDocument, name: str) -> CadEditResult:
        """Makes a style current ($DIMSTYLE), as Set Current and the style box do, its variables given to the header
        as AutoCAD gives them, so that the header's dimension variables are the style's."""
    @staticmethod
    def Styles(database: DxfDatabase) -> System.Collections.Generic.IReadOnlyList[DxfDimStyleTableRecord]:
        """Gets the styles the Manager lists: those of the table but the ones AutoCAD keeps for one kind of
        dimension of another (ISO-25$0), in the order of the table."""
    @staticmethod
    def Text(value: object) -> str:
        """Gives a value of a variable as the Manager shows it: a number invariant to 15 figures, a colour as
        AutoCAD names it, none as an empty text."""

class CadDocument(System.Object):
    """A drawing open in the presenter: a DxfDatabase with its spaces, the display list of each, the index that
    picks in it and the selection. Opening and showing run with no window, so a test can drive them.

    The handles AutoCAD gives the entities of a drawing that writes none, on opening it.

    A viewport of a layout maximized into a temporary model view, as AutoCAD 2021's VPMAX does it and VPMIN takes
    it back.

    The tiled viewports model space is shown through.

    Model space worked in through a viewport of a layout, as AutoCAD's MSPACE: the layout is still the one shown,
    but picks, snaps and commands work in model space as the viewport shows it, and zooming changes the
    viewport's view.

    The authoring edits of the Block Editor, as AutoCAD 2021's: the visibility states of the block open (BVSTATE)
    and the objects they show (BVHIDE, BVSHOW), and the parameters and actions taken out of it. Each is an edit
    of the document, one undo step of its own or a part of the command's that makes it; the work on the
    evaluation graph is the library's (DxfBlockVisibility, DxfBlockAuthoring).

    The Block Editor, as AutoCAD 2021's BEDIT: a block of the drawing (or model space itself, as <Current
    Drawing>) shown alone in a space of its own, where every drawing and modify command works on the block's
    entities.

    The editing half of the document: every change goes through CadDocument.ApplyEdit, one undo step each (or one
    for a group of them, as a command makes), with undo, redo, saving and the CadDocument.Changed event.

    The layer filter the drawing looks through: the one chosen in the Layer manager's tree, whether it is
    inverted, and whether the layer box of the ribbon lists only the layers it lets through (AutoCAD's Apply
    layer filter to layer toolbar).

    The history LAYERP reads (Layer Previous): before each change or set of changes to the settings of layers,
    the settings the layers had are kept, so that LAYERP puts them back without touching any other edit. A set is
    what one command does (LAYISO turning off nine layers and moving the current one is one), what one Layer
    manager session does (CadDocument.BeginLayerSet), or one change made on its own, as the layer box makes one.
    Only the layers the set changed are kept, with the settings they had.

    The switch from one space to another, model space or a layout, and MSPACE and PSPACE, as undo steps.

    The object inside a block reference that a point reaches, which LAYOFF and LAYFRZ take the layer of by their
    Block selection setting.

    In-place editing of a block reference, as AutoCAD 2021's REFEDIT: the objects of the reference's block copied
    into the drawing where the reference draws them (the working set), edited there with every command, REFSET
    adding objects to the set and taking them out, REFCLOSE writing them back into the block or discarding them.
    The other objects of the drawing are locked while it lasts and faded.

    How objects are picked in the document: groups taken whole (PICKSTYLE), overlapping objects cycled through
    (SELECTIONCYCLING), and objects selected before a command taken by it (PICKFIRST).

    Settings kept in the drawing and changed in place, as the snap and grid of a viewport, as undo steps. A
    setting is a handful of values in the drawing, and putting it back by those values is what its step does: the
    step shares the drawing kept before it, so that no copy of the drawing is saved for it and an undo or a redo
    of it reads nothing again, in a drawing of a million entities too (see CadDocument.ApplySetting).

    The clocks of the drawing TIME shows (CadDocumentTimes).

    UNDO's own settings and its groups: Control (All, None, One), Auto, Combine and Layer, and BEgin and End,
    which make the commands between them one step of U and REDO under the name GROUP.

    The views of model space and of the paper of a layout as undo steps and as ZOOM Previous entries. A
    viewport's view is a property of the viewport in the drawing and is undone with the drawing; the view of a
    space is not in the drawing, so the step of a zoom or a pan of a space holds the part of the space shown
    before and after, and undoing it moves the view and reads nothing again.

    The fonts a document's text is drawn in.

    The hatch settings of a document: those HATCH makes the next hatch with, and those of the hatch HATCHEDIT
    changes.

    The folders a document's support files are looked for in.

    The folder a document's plot style tables are read from.

    The user coordinate systems of the drawing.

    The external references and images of a document."""
    @property
    def ActiveViewport(self) -> DxfViewport:
        """Gets the viewport of the layout shown whose model space is worked in (MSPACE), as AutoCAD's current
        viewport; null on the paper (PSPACE), in model space, and where that viewport has been erased or switched
        off since."""
    @property
    def AnnoAutoScale(self) -> int:
        """Gets or sets ANNOAUTOSCALE, as AutoCAD's: whether the annotative objects of model space are shown at the
        scale CANNOSCALE is changed to, which they are given as OBJECTSCALE gives it. Positive switches it on,
        negative off, and the size says which objects (probed on AutoCAD 2021, texts on layers that are on,
        locked and off): 1 those on layers that are on, thawed and not locked, 2 those on locked layers too, 4
        those on layers that are off or frozen too. -4, the default, adds nothing. Kept by the presenter, not in
        the drawing, as AutoCAD keeps it in the registry; the variable ANNOAUTOSCALE sets it."""
    @AnnoAutoScale.setter
    def AnnoAutoScale(self, value: int) -> None: ...
    @property
    def ApplyLayerFilterToToolbar(self) -> bool:
        """Gets or sets whether the layer box lists only the layers the filter lets through, the current layer
