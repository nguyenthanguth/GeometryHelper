    Drawing: ClassVar[str]
    """The one type of IMPORT's file: a DWG or a DXF drawing, brought in as a block."""
    Dwg: ClassVar[str]
    """The DWG type of Save As of AutoCAD 2018, the one a DWG is written as where no other is chosen, listed first
    as AutoCAD 2021 lists it."""
    Pdf: ClassVar[str]
    """The one type of -EXPORT's file of format Pdf."""
    Template: ClassVar[str]
    """The type of Save As that writes a drawing template, a DWG with the extension .dwt, as AutoCAD 2021 lists it
    after the DWG types."""
    def __init__(
        self,
        title: str,
        fileTypes: System.Collections.Generic.IReadOnlyList[str],
