class CadOwnerEditGate(ICadEditGate):
    """The gate a document asks before it changes an entity, made from the owners registered with it: an entity with
    no owner tag is edited freely, one of an owner is edited as that owner's CadEditRule says (a move only,
    nothing at all, or anything), and a refusal says why in the words the command line shows."""
    def __init__(self, registry: CadOwnerRegistry) -> None:
        """Makes a gate over a registry of owners."""
    def Allows(self, document: CadDocument, entity: DxfEntity, record: CadEditRecord) -> tuple[bool, str]:
        """Asks whether one planned change of an entity may be made."""
    @staticmethod
    def KindOf(record: CadEditRecord) -> CadEditKind:
        """Gets which kind of edit of the owner contract a planned change is: a transformation is the move,
        rotation, scale or mirror its property names, a grip drag that only translates (an insertion point, a
        centre, a middle grip) is a move, and reshaping is a grip edit."""

class CadOwnerRegistry(System.Object):
    """The owners a document knows, found by the name in an entity's CadOwnerTag, and asked before an owned entity
    changes."""
    def __init__(self) -> None: ...
    @property
    def Owners(self) -> System.Collections.Generic.IReadOnlyList[ICadEntityOwner]:
        """Gets the owners registered, in the order of their names, character by character."""
    @staticmethod
    def Allows(rule: CadEditRule, kind: CadEditKind) -> bool:
        """Says whether a rule lets an edit of a kind through: CadEditRule.Free and CadEditRule.Edit every kind,
        CadEditRule.MoveOnly a CadEditKind.Move only, CadEditRule.ReadOnly none."""
    def FindOwner(self, entity: DxfEntity) -> ICadEntityOwner:
        """Finds the registered owner an entity's tag names."""
    def GetEditRule(self, entity: DxfEntity) -> CadEditRule:
        """Says what the presenter may do to an entity: CadEditRule.Free for one with no tag, CadEditRule.ReadOnly
        for one whose owner is not registered, and otherwise what its owner answers."""
    def Register(self, owner: ICadEntityOwner) -> None:
        """Registers an owner under its name."""
    def TryApply(self, document: CadDocument, edit: CadEdit) -> bool:
        """Hands an edit of an owned entity to its owner, as the presenter does before it changes one: refused where
        the entity's rule does not allow the kind (CadOwnerRegistry.Allows), and otherwise the owner's answer. An
        entity whose rule is CadEditRule.Free is edited by the presenter itself and not handed over: the answer
        for it is false, and so is the answer for a handle the document has no entity of."""
    def Unregister(self, name: str) -> bool:
        """Takes an owner out; its entities are read-only from then on."""

