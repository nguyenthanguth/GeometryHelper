    @property
    def Header(self) -> CadTableCellStyleSettings:
        """Gets the header's cell style."""
    @property
    def HorizontalMargin(self) -> float:
        """Gets or sets the margin left and right of a cell's content."""
    @HorizontalMargin.setter
