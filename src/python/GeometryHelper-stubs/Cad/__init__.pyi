    The grips of a spline and the edits of their hover menu: stretch a point, add one, take one out.

    The grips of a whole table selected, as AutoCAD 2021 gives them."""
    @staticmethod
    def AddVertex(document: CadDocument, handle: str, gripIndex: int, point: GeoPoint2) -> CadEditResult:
        """Adds a vertex to a polyline at a point, as the Add Vertex item of a polyline's grip menu does, one undo
        step: the new vertex goes after the vertex of the grip, or after the vertex the segment of a segment
        middle grip leaves from, so that it lies between that vertex and the next (after the last vertex of an
        open polyline it extends the end). The new segment is straight; the segment split keeps its widths, the
        width at the point being the one where the point falls along it. A straight segment splits in two
        straight ones; an arc segment in two arcs of the one arc through its start, the point and its end: a half
        circle from (0, 0) to (20, 0) given the point (10, -10) is two quarter circles, a bulge of 0.4142 each. A
        spline's point (CadGripKind.Vertex) gets a fit point after it where the spline has fit data, else a
        control point, with the knot at the point of the curve nearest the point given."""
    @staticmethod
    def ChangeHatchAngle(document: CadDocument, handle: str, angle: float) -> CadEditResult:
        """Sets the angle of a hatch's pattern, as the Hatch Angle item of the menu of its grip does, one undo step:
        the pattern is laid from the same origin as before."""
    @staticmethod
    def ChangeHatchScale(document: CadDocument, handle: str, scale: float) -> CadEditResult:
        """Sets the scale of a hatch's pattern, as the Hatch Scale item of the menu of its grip does, one undo step:
        the pattern is laid from the same origin as before."""
    @staticmethod
    def ChangeRadius(document: CadDocument, handle: str, gripIndex: int, point: GeoPoint2) -> CadEditResult:
        """Changes the radius of an arc, as the Radius item of the menu of its middle grip does, one undo step: the
        radius is the distance of the point from the centre, the centre and the two angles kept, so that the ends
        move along their rays. An arc of radius 50 about (0, 0) given the point (0, 30) has radius 30."""
    @staticmethod
    def ClickClipFlip(document: CadDocument, handle: str, gripIndex: int) -> CadEditResult:
        """Clicks the arrow of a clipped reference, as AutoCAD 2021's clip frame does: the clip is turned inside
        out, so that what the boundary held is hidden and what lay outside it shown, or back; one undo step
        through CadDocument.ApplyEdit. A clip turned inside out is kept as a keyhole in the boundary, a rectangle
        kept as two corners again when it is turned back."""
    @staticmethod
    def ConvertToArc(document: CadDocument, handle: str, gripIndex: int, point: GeoPoint2) -> CadEditResult:
        """Makes a straight segment of a polyline an arc through a point, as the Convert to Arc item does, one undo
        step: the arc from the segment's start through the point to its end. A chord of 100 with the point 20 off
        its middle is a bulge of 0.4 (the sagitta over half the chord), above nought where the point is to the
        right of the way the segment runs."""
    @staticmethod
    def ConvertToLine(document: CadDocument, handle: str, gripIndex: int) -> CadEditResult:
        """Makes an arc segment of a polyline straight, as the Convert to Line item does once its pick is made, one
        undo step."""
    @staticmethod
    def Drag(document: CadDocument, handle: str, gripIndex: int, to: GeoPoint2) -> CadEditResult:
        """Drags a grip of an entity to a point, as AutoCAD's stretch mode does: one undo step through
        CadDocument.ApplyEdit. An arc dragged by an end or its middle is the arc through the three points then
        (the moved one and the two kept); a quadrant makes a circle's radius the distance to the point. A
        dimension's grip rewrites its points of definition and its picture is drawn anew: an extension line's
        origin moved keeps the dimension line where it is (an aligned one's at the same distance from what it
        measures); an end of the dimension line moves the line through the point, words the user placed going
        with it; the words go where DIMTEDIT puts them, the dimension line with them where DIMTMOVE is 0; a
        radius's or a diameter's chord point goes round its circle towards the point, words the user placed
        turning with it. A corner of an MTEXT's box takes its two edges to the point, as AutoCAD 2021's does: the
        width of the MTEXT is the box's then and its words wrap anew, its defined height the box's (at least its
        text height; left as it is in a file before R2007, which holds none), and its location stays at the point
        of the box its attachment names: the top right corner of a box 60 wide dragged 5 right and 3 down makes
        it 65 wide and moves a location at the top left 3 down. A grip of an MTEXT in columns changes the columns
        as AutoCAD 2021's MoveGripPointsAt does, the step taken the way the grip points, the location kept (see
        the kinds from CadGripKind.MTextColumnWidth on): two static columns 120 wide with a gutter of 20 have,
        dragged 50 out, columns 130 wide and no gutter by the first column's grip (the total kept), a gutter of
        70 by the last column's; widths and heights stop at the text height, a gutter at nought. A corner of a
        clip boundary (CadGripKind.ClipVertex) takes the two sides of a rectangle it is on, the opposite corner
        kept, or a polygon's vertex alone, the clip kept inside out where it is: the corner (1020, 520) of the
        rectangle (1020, 520) to (1080, 570) dragged to (1010, 510) leaves (1010, 510) to (1080, 570); a boundary
        of no area is refused. A corner of an OLE frame scales the frame about the corner across from it, as
        AutoCAD 2021 does: each side by the distance of the point from that corner over the distance of the grip,
        the frame staying on its side of the corner however far the point goes past it, so that no frame turns
        over; with Lock aspect on, both sides by the larger of the two factors. The corner (50, 40) of a frame 40
        by 20 from (10, 20) dragged to (60, 45) makes it 50 by 25, and dragged to (50, 50), 60 by 30; a frame of
        no width or height, or a point on the line of the corner across from it, is refused. A vertex of a
        multiline moves as AutoCAD 2021's MoveVertexAt moves it (DxfMlineBuilder.MoveVertexAt): a segment that
        keeps its way keeps its cuts, one that turns is whole again. A grip of a revision cloud with few grips
        (see CadGrips.Shown) changes the shape the cloud goes round and draws the cloud again along it, in place,
        as AutoCAD 2021's MoveGripPointsAt does: the arcs a tenth longer than the mean chord of the cloud was (a
        cloud of 20 arcs 10 long round a rectangle 60 by 40, its top middle grip dragged up by 5, is 19 vertices
        11 apart), a cloud too small for two arcs refused."""
    @staticmethod
    def Lengthen(document: CadDocument, handle: str, gripIndex: int, point: GeoPoint2) -> CadEditResult:
        """Lengthens or shortens a line or an arc at one end, as the Lengthen item of the menu of an end grip does,
        one undo step. A line's end goes to where the point falls along the line's own way, the other end and the
        way kept: a line from (0, 0) to (100, 0) lengthened at its end by (150, 40) runs to (150, 0). An arc's
        end goes round the arc to the angle the point has from the centre, the centre, the radius and the other
        end kept: an arc of radius 50 from 0 to 90 degrees lengthened at its end by (-10, 30) ends at the angle
        of that point, 108.4 degrees."""
    @staticmethod
    def Of(entity: DxfEntity) -> System.Collections.Generic.IReadOnlyList[CadGrip]:
        """Gets the grips of an entity. A dimension's, as AutoCAD 2021's: a linear or aligned one's two extension
        line origins, the two ends of its dimension line, then its words; a radius's chord point and its words, a
        diameter's two chord points and its words; a three-point angle's vertex, its two line points, its arc and
        its words, an angle between two lines the two ends of each line, its arc and its words; an ordinate's
        feature and its leader's end. A dimension drawn in no plan, or with no picture of its own, has none. An
        MTEXT's, as AutoCAD 2021's: the four corners of its box (its defined width by its defined height, or with
        none the height of its lines) from the top left, the top right, the bottom left to the bottom right, the
        corner its location is at the grip of its insertion; its location first, a fifth grip, where it is at no
        corner (held at a middle); the top right, bottom left and bottom right corners carry the way their
        triangles point (CadGrip.Direction). In columns, as AutoCAD 2021's: its location, the first column's
        width at its top right, then for columns of one height the corner of the last column and the height under
        the location, for dynamic columns of their own heights a height grip under the middle of each column, and
        last, in two columns or more, the gutter grip at the last column's top right; two static columns 120 wide
        with a gutter of 20 and a height of 100, held at the top left, have them at (0, 0), (120, 0), (260,
        -100), (0, -100) and (260, 0). Held at the right or the bottom they stand at the other side, pointing the
        other way. Its location alone for an MTEXT of no width or out of the plan. A TOLERANCE's, as AutoCAD 2021
        shows it: its insertion point alone. A table's, as AutoCAD 2021's: its move grip at the top left, a
        column grip at each line between columns on its top edge, its width, height and size stretch grips at the
        top right, bottom left and bottom right, and the table breaking grip under the middle of its bottom edge,
        which is not offered. A block reference's, after its insertion point and its dynamic block's grips, where
        it is clipped by XCLIP, as AutoCAD 2021's: an arrow at the middle of the boundary's first side
        (CadGripKind.ClipFlip, its CadGrip.Direction across the side to what the clip hides) and a grip at each
        corner of a rectangle, from its lower left counter-clockwise, or each vertex of a polygon
        (CadGripKind.ClipVertex); a block 100 by 100 clipped to the rectangle (20, 20) to (60, 70) has grips at
        (40, 20), the arrow, then (20, 20), (60, 20), (60, 70) and (20, 70). An OLE frame's, as AutoCAD 2021
        gives them: a grip at each corner, from the lower left, the upper left and the upper right to the lower
        right (CadGripKind.Corner); a frame 40 by 20 with its lower left corner at (10, 20) has them at (10, 20),
        (10, 40), (50, 40) and (50, 20). A frame of no size has none. A multiline's, as AutoCAD 2021's: one at
        each vertex of the line it is drawn on, (0, 0), (100, 0) and (100, 100) for one through those points. A
        2D POLYLINE of straight and arc segments has a light polyline's grips (a vertex grip on each vertex, then
        a segment middle grip on each segment); one fitted with a curve or a spline has a vertex grip on each
        vertex of its frame alone (four for a frame of four, whatever the curve has added), as AutoCAD 2021's
        GetGripPoints gives them, and dragging one fits the curve or the spline again. A spline's, as AutoCAD
        2021's: a vertex grip on each fit point, or on each control point where it has no fit data; a cubic
        through (0, 0), (30, 40), (60, 0) and (90, 40) has grips at those four points. A hatch's, one at the
        middle of the box its loops fill (CadGripKind.Center): a rectangle 100 by 60 has it at (50, 30); where
        the hatch follows no objects (is not associative) then those of its boundary, as AutoCAD 2021's
        GetGripPoints gives them: for each loop a vertex grip and one in the middle of the segment that leaves it
        (CadGripKind.Vertex and CadGripKind.Middle), or the east, west, north and south of a loop that is one
        circle (CadGripKind.Quadrant); a rectangle 100 by 60 has eight, from (0, 0), (50, 0), (100, 0), (100, 30)
        to (0, 30), after the one at (50, 30)."""
    @staticmethod
    def RemoveVertex(document: CadDocument, handle: str, gripIndex: int) -> CadEditResult:
        """Takes a vertex out of a polyline, as the Remove Vertex item does, one undo step: the segment that now
        joins its two neighbours is straight, even where the segments either side of the vertex were arcs. A
        polyline of two vertices keeps them, as AutoCAD keeps them; a closed one of three leaves two. A spline
        keeps two fit points, or as many control points as its degree and one."""
    @staticmethod
    def SetHatchOrigin(document: CadDocument, handle: str, origin: GeoPoint2) -> CadEditResult:
        """Lays a hatch's pattern from a point, as the Origin Point item of the menu of its grip does, one undo
        step: each line of the pattern moves by what the origin moves, as HATCHSETORIGIN moves them."""
    @staticmethod
    def Shown(document: CadDocument, entity: DxfEntity) -> System.Collections.Generic.IReadOnlyList[CadGrip]:
        """Gets the grips of an entity as a document shows them: those CadGrips.Of gives, but for a revision cloud
        while the document's CadDocument.RevCloudGrips is on, which has the few grips of the shape it goes round.
        A cloud (a closed polyline of six vertices or more with REVCLOUD's data) round a rectangle (0, 0) to (60,
        40) with arcs 10 long has eight: (0, 0), (0, 20), (0, 40), (30, 40), (60, 40), (60, 20), (60, 0) and (30,
        0), a vertex grip at each corner and a middle grip at each side in turn from the first vertex. A cloud
        round the polygon (100, 0), (160, 0), (160, 40), (130, 60), (100, 40) has ten, (130, 60) among them, a
        corner the arcs cut off. A cloud round a circle has five, its centre and its quadrants to the right,
        left, above and below. Dragging one draws the cloud again along the new shape (see CadGrips.Drag); the
        grips of its vertices come back with REVCLOUDGRIPS 0."""

class CadGroupManagerRequest(System.Object):
    """The Object Grouping dialog of CLASSICGROUP, as data its command and the window share: the groups of the
    drawing, the one chosen, the name and description typed, and the options of Create Group. A button ending in
    <, as New <, closes the dialog with CadDialogAction.SelectObjects and its words in
    CadGroupManagerRequest.Pick: the command asks on the command line, then shows the dialog again. Rename,
    Description, Explode, Selectable and Re-Order change the drawing while the dialog stays open; OK keeps every
    change, Cancel takes them all back, as one undo step."""
    @property
    def Action(self) -> CadDialogAction:
        """Gets or sets what the window's dialog was closed with: OK, Cancel or Select objects; Cancel until set."""
    @Action.setter
    def Action(self, value: CadDialogAction) -> None: ...
    @property
    def Description(self) -> str:
        """Gets or sets the Description typed: that of a new group, or the one Description gives the group
        chosen."""
    @Description.setter
    def Description(self, value: str) -> None: ...
    @property
    def Document(self) -> CadDocument:
        """Gets the document."""
    @property
    def GroupName(self) -> str:
        """Gets or sets the Group Name typed: the name of a new group, or the new name Rename gives the group
        chosen."""
    @GroupName.setter
    def GroupName(self, value: str) -> None: ...
    @property
    def Groups(self) -> System.Collections.Generic.IReadOnlyList[CadGroupRow]:
        """Gets the groups of the drawing, named and unnamed, in ordinal order of their names, letters of either
        case alike."""
    @property
    def HighlightCount(self) -> int:
        """Gets or sets how many objects Highlight shows; nought or less for every one from
        CadGroupManagerRequest.HighlightFrom on."""
    @HighlightCount.setter
    def HighlightCount(self, value: int) -> None: ...
    @property
    def HighlightFrom(self) -> int:
        """Gets or sets the first position Highlight shows; nought for the whole group."""
    @HighlightFrom.setter
    def HighlightFrom(self, value: int) -> None: ...
    @property
    def IncludeUnnamed(self) -> bool:
        """Gets or sets whether unnamed groups are listed (Include Unnamed)."""
    @IncludeUnnamed.setter
    def IncludeUnnamed(self, value: bool) -> None: ...
    @property
    def Message(self) -> str:
        """Gets what the last change or pick said where it was refused, as \"A group with this name already
        exists.\"; null where it was made."""
    @property
    def NewSelectable(self) -> bool:
        """Gets or sets whether a group New makes is selectable; true until set."""
    @NewSelectable.setter
    def NewSelectable(self, value: bool) -> None: ...
    @property
    def NewUnnamed(self) -> bool:
        """Gets or sets whether a group New makes is unnamed."""
    @NewUnnamed.setter
    def NewUnnamed(self, value: bool) -> None: ...
    @property
    def Pick(self) -> str:
        """Gets or sets the button ending in < the dialog was closed with: Find Name, Highlight, New, Remove or Add,
        or Order Highlight for Order Group's Highlight, which steps through the members of the group chosen on
        the canvas one at a time, \"Object 0 of 11 [Next/Previous/eXit]:\", until eXit or Enter."""
    @Pick.setter
    def Pick(self, value: str) -> None: ...
    @property
    def Selected(self) -> str:
        """Gets or sets the name of the group chosen in the list; null for none."""
    @Selected.setter
    def Selected(self, value: str | None) -> None: ...
    def ChangeDescription(self) -> bool:
        """Description: the group chosen given the Description typed."""
    def Explode(self) -> bool:
        """Explode: the group chosen taken apart, its objects kept."""
    def Rename(self) -> bool:
        """Rename: the group chosen given the Group Name typed."""
    def Reorder(self, from_: int, /, to: int, count: int) -> bool:
        """Re-Order: objects of the group chosen moved to another position, as Order Group's Re-Order moves them:
        the group A, B, C, D with 1 to 3, 1 object, reads A, C, D, B."""
    def Reverse(self) -> bool:
        """Reverse Order: the objects of the group chosen put in the opposite order."""
    def ToggleSelectable(self) -> bool:
        """Selectable: whether a pick takes the group chosen whole, switched."""

class CadGroupRow(System.Object):
    """A group of a drawing as the Object Grouping dialog lists it."""
    @property
    def Count(self) -> int:
        """Gets how many objects the group holds."""
    @property
    def Description(self) -> str:
        """Gets the description."""
    @property
    def IsUnnamed(self) -> bool:
        """Gets whether the group is unnamed, *A1, which the list shows only with Include Unnamed."""
    @property
    def Name(self) -> str:
        """Gets the name, STAIR_CORE, or *A1 for an unnamed group."""
    @property
    def Selectable(self) -> bool:
        """Gets whether a pick takes the group whole."""

class CadHatchOriginMode(System.Enum):
    """Where a hatch's pattern is laid from, as AutoCAD's HPORIGINMODE holds it."""
    BottomLeft: ClassVar[CadHatchOriginMode]
    """The bottom left corner of the box round the hatch's outer loops."""
    BottomRight: ClassVar[CadHatchOriginMode]
    """The bottom right corner of the box round the hatch's outer loops."""
    Center: ClassVar[CadHatchOriginMode]
    """The middle of the box round the hatch's outer loops."""
    Current: ClassVar[CadHatchOriginMode]
    """The origin given (CadHatchSettings.OriginX and CadHatchSettings.OriginY), nought nought as AutoCAD starts."""
    TopLeft: ClassVar[CadHatchOriginMode]
    """The top left corner of the box round the hatch's outer loops."""
    TopRight: ClassVar[CadHatchOriginMode]
    """The top right corner of the box round the hatch's outer loops."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadHatchPattern(System.Object):
    """A hatch pattern of a .pat file: its name, its description and its lines."""
    def __init__(
        self,
        name: str,
        description: str,
        lines: System.Collections.Generic.IEnumerable[CadHatchPatternLine],
    ) -> None:
        """Makes a pattern."""
    @property
    def Description(self) -> str:
        """Gets the description."""
    @property
    def Lines(self) -> System.Collections.Generic.IReadOnlyList[CadHatchPatternLine]:
        """Gets the lines."""
    @property
    def Name(self) -> str:
        """Gets the name."""
    def Place(
        self,
        angle: float,
        scale: float,
        originX: float,
        originY: float,
    ) -> System.Collections.Generic.IReadOnlyList[DxfPatternDefinition]:
        """Gets the lines placed as a HATCH holds them, as AutoCAD 2021 places those of its file: each line's angle
        turned by the angle, its base point scaled and turned about the origin and moved by the origin given, its
        step turned into the plane by its own angle and scaled, its dashes scaled. ANSI31 at angle nought and
        scale 1 is the line at 45 degrees through (0, 0), offset (-2.245, 2.245); at 30 degrees and scale 2, at
        75 degrees, offset (-6.134, 1.644)."""

class CadHatchPatternLine(System.Object):
    """A line of a hatch pattern as a .pat file writes it: its angle in degrees, the point it runs through, the step
    to the next copy along the line and across it, in the line's own frame, and its dashes. ANSI31 is the one
    line 45, 0,0, 0,3.175: at 45 degrees through the origin, each copy 3.175 across from the last, solid."""
    def __init__(
        self,
        angle: float,
        baseX: float,
        baseY: float,
        along: float,
        across: float,
        dashes: System.Collections.Generic.IEnumerable[float],
    ) -> None:
        """Makes a line of a pattern."""
    @property
    def Across(self) -> float:
        """Gets the step to the next copy across the line (delta-y)."""
    @property
    def Along(self) -> float:
        """Gets the step to the next copy along the line (delta-x)."""
    @property
    def Angle(self) -> float:
        """Gets the angle in degrees."""
    @property
    def BaseX(self) -> float:
        """Gets the x of the point the line runs through."""
    @property
    def BaseY(self) -> float:
        """Gets the y of that point."""
    @property
    def Dashes(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the dashes; none for a solid line."""

class CadHatchSettings(System.Object):
    """The settings HATCH makes a hatch with and HATCHEDIT changes, as the Hatch Creation tab holds them: what it is
    filled with, the pattern, its angle and scale or spacing, the origin, the island style, whether it follows
    its objects, and the one colour or two of a gradient; and the layer, colour, background colour and
    transparency a new hatch takes in place of the current ones, and the widest gap a boundary is taken as closed
    over. AutoCAD's own start: ANSI31 at angle nought and scale 1, associative, the Outer island style
    (HPISLANDDETECTION 1), a gradient GR_LINEAR from blue to a pale yellow, no gap tolerance, the current layer
    and colour."""
    def __init__(self) -> None: ...
    @property
    def Angle(self) -> float:
        """Gets or sets the angle of the pattern or the gradient, in degrees."""
    @Angle.setter
    def Angle(self, value: float) -> None: ...
    @property
    def Annotative(self) -> bool:
        """Gets or sets whether a new hatch is annotative, as -HATCH's ANnotative asks: made annotative at the
        annotation scale of its space, so that its pattern is drawn at the scale of the view; false as AutoCAD
        starts."""
    @Annotative.setter
    def Annotative(self, value: bool) -> None: ...
    @property
    def Associative(self) -> bool:
        """Gets or sets whether the hatch follows the objects its loops were made of (HPASSOC); true as AutoCAD
        starts."""
    @Associative.setter
    def Associative(self, value: bool) -> None: ...
    @property
    def BackgroundColor(self) -> DxfColor:
        """Gets or sets the colour behind the lines of a new hatch's pattern; null for none, as HPBACKGROUNDCOLOR's
        \".\" says."""
    @BackgroundColor.setter
    def BackgroundColor(self, value: DxfColor | None) -> None: ...
    @property
    def Color(self) -> DxfColor:
        """Gets or sets the colour a new hatch is drawn in; null for the current colour, as HPCOLOR's \".\" says."""
    @Color.setter
    def Color(self, value: DxfColor | None) -> None: ...
    @property
    def Double(self) -> bool:
        """Gets or sets whether the lines of a pattern made by the user are crossed by as many square to them."""
    @Double.setter
    def Double(self, value: bool) -> None: ...
    @property
    def GapTolerance(self) -> float:
        """Gets or sets the widest gap between two loose ends that a boundary is taken as closed over (HPGAPTOL), in
        drawing units; 0 for none, as AutoCAD starts."""
    @GapTolerance.setter
    def GapTolerance(self, value: float) -> None: ...
    @property
    def GradientCentered(self) -> bool:
        """Gets or sets whether a gradient is centred (its shift nought) rather than shifted a quarter towards its
        end."""
    @GradientCentered.setter
    def GradientCentered(self, value: bool) -> None: ...
    @property
    def GradientColor1(self) -> DxfColor:
        """Gets or sets the first colour of a gradient: blue, as GFCLR1 starts."""
    @GradientColor1.setter
    def GradientColor1(self, value: DxfColor) -> None: ...
    @property
    def GradientColor2(self) -> DxfColor:
        """Gets or sets the second colour of a gradient: a pale yellow (255, 255, 153), as GFCLR2 starts."""
    @GradientColor2.setter
    def GradientColor2(self, value: DxfColor) -> None: ...
    @property
    def GradientName(self) -> str:
        """Gets or sets the gradient, by the name AutoCAD's dialog gives it: GR_LINEAR."""
    @GradientName.setter
    def GradientName(self, value: str) -> None: ...
    GradientNames: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """Gets the names of AutoCAD's nine gradients as its dialog gives them: GR_LINEAR, GR_CYLIN, GR_INVCYL,
    GR_SPHER, GR_INVSPH, GR_HEMISP, GR_INVHEM, GR_CURVED, GR_INVCUR."""
    @property
    def GradientOneColor(self) -> bool:
        """Gets or sets whether a gradient runs from CadHatchSettings.GradientColor1 to its shade or tint
        (CadHatchSettings.GradientTint) rather than to CadHatchSettings.GradientColor2, as AutoCAD's Single color
        (GFCLRSTATE 1); false as it starts."""
    @GradientOneColor.setter
    def GradientOneColor(self, value: bool) -> None: ...
    @property
    def GradientTint(self) -> float:
        """Gets or sets how a gradient of one colour is shaded or tinted, from 0, black, through the colour's own
        hue at 0.5 to 1, white, as AutoCAD's GFCLRLUM; 1 as it starts. The second end of the gradient is the
        colour's hue and saturation at that lightness: red (255, 0, 0) at 0.25 ends in (128, 0, 0), at 0.75 in
        (255, 128, 128)."""
    @GradientTint.setter
    def GradientTint(self, value: float) -> None: ...
    @property
    def IslandStyle(self) -> DxfHatchStyle:
        """Gets or sets which areas of islands within islands are filled: Outer as AutoCAD starts (HPISLANDDETECTION
        1)."""
    @IslandStyle.setter
    def IslandStyle(self, value: DxfHatchStyle) -> None: ...
    @property
    def Layer(self) -> str:
        """Gets or sets the layer a new hatch is on; null for the current layer, as HPLAYER's \".\" says. A layer
        the drawing has not (any more) leaves the hatch on the current one."""
    @Layer.setter
    def Layer(self, value: str | None) -> None: ...
    @property
    def OriginMode(self) -> CadHatchOriginMode:
        """Gets or sets where the pattern is laid from: the origin given, or a corner or the middle of the box round
        the hatch (HPORIGINMODE)."""
    @OriginMode.setter
    def OriginMode(self, value: CadHatchOriginMode) -> None: ...
    @property
    def OriginX(self) -> float:
        """Gets or sets the x of the point the pattern is laid from."""
    @OriginX.setter
    def OriginX(self, value: float) -> None: ...
    @property
    def OriginY(self) -> float:
        """Gets or sets the y of the point the pattern is laid from."""
    @OriginY.setter
    def OriginY(self, value: float) -> None: ...
    @property
    def PatternFile(self) -> str:
