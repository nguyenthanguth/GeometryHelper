    where the reference stands in a clipped block. Every item the reference draws carries it as
    DisplayItem2.BlockClip; the canvas draws the item inside the region alone, a pick finds it there, and a
    window or a crossing meets only the part of it there. A clip turned inside out is a ring that goes round the
    block's extents and in to the boundary by a slit, as AutoCAD keeps one, so that it is no different here."""
    def __init__(self, outline: DisplayClip2, parent: DisplayClipRegion) -> None:
        """Makes a region."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds what is shown: the ring's box within its parent's; empty where the two do not
        meet."""
    @property
    def Outline(self) -> DisplayClip2:
        """Gets the ring of this reference's clip."""
    @property
    def Parent(self) -> DisplayClipRegion:
        """Gets the region of the clipped block this reference stands in; null for a reference of the space
        itself."""
    @property
    def Ring(self) -> System.Array[float]:
        """Gets the points of the ring as x, y pairs, the last not repeating the first."""
    def Contains(self, x: float, y: float) -> bool:
        """Gets whether a point is in the region, inside its ring and its parent's; a point on an edge may fall
        either side."""
    def Meets(self, box: DisplayBox) -> bool:
        """Gets whether the region meets a box: a vertex of the ring is in the box, a corner of the box is in the
        region, or an edge of the ring crosses the box; as a crossing selection, and the aperture of a snap, ask.
        Of nested rings the box is held to each in turn, which is a little more than is shown where the two cut
        one another."""
    def Moved(self, dx: float, dy: float) -> DisplayClipRegion:
        """Gets a region moved along X and Y, as the reference's items are moved by a paste's preview."""
    def Reaches(self, x: float, y: float, distance: float) -> bool:
        """Gets whether a point is in the region or within a distance of it, as a pick asks for what lies under the
        pickbox: the point is inside every ring, or no farther than the distance from the edge of each it is
        outside."""

class DisplayFill2(DisplayItem2):
    """A filled area: a hatch, a solid, a wipeout. Its rings are filled by the even-odd rule, so a ring inside
    another is a hole."""
    def __init__(
        self,
        rings: System.Collections.Generic.IEnumerable[Sequence[float] | System.Array[float]],
        isMask: bool,
        style: DisplayStyle,
        handle: str,
        layer: str,
    ) -> None:
        """Makes a fill."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def IsMask(self) -> bool:
        """Gets whether the fill is a mask drawn in the background colour."""
    @property
    def Rings(self) -> System.Collections.Generic.IReadOnlyList[System.Array[float]]:
        """Gets the rings, each as X and Y in turn."""
    def Contains(self, x: float, y: float) -> bool:
        """Gets whether a point is inside the fill by the even-odd rule."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""
    def Touches(self, box: DisplayBox) -> bool:
        """Gets whether any part of the item touches a box, as a crossing selection asks."""

class DisplayImage2(DisplayItem2):
    """The picture of an IMAGE: the file it shows laid on the parallelogram of its corner and its two sides, clipped
    by its boundary. A picture of 40 by 30 pixels placed at (10, 20) with a pixel 0.25 across is the
    parallelogram from (10, 20) along (10, 0) and (0, 7.5). It is never picked by a point: the frame drawn as its
    own item is, as AutoCAD picks an image by its frame; a window or a crossing takes it by its box."""
    def __init__(
        self,
        x: float,
        y: float,
        ux: float,
        uy: float,
        vx: float,
        vy: float,
        clip: System.Collections.Generic.IReadOnlyList[Sequence[float] | System.Array[float]],
        clipInverted: bool,
        filePath: str,
        fileName: str,
        style: DisplayStyle,
        handle: str,
        layer: str,
    ) -> None:
        """Makes the picture of an image."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def Brightness(self) -> int:
        """Gets the brightness of the picture, 0 to 100, 50 as it is."""
    @property
    def Clip(self) -> System.Collections.Generic.IReadOnlyList[System.Array[float]]:
        """Gets the rings the picture is clipped by, each as X and Y in turn; null where it shows the whole
        picture."""
    @property
    def Contrast(self) -> int:
        """Gets the contrast of the picture, 0 to 100, 50 as it is."""
    @property
    def Fade(self) -> int:
        """Gets how far the picture is faded into the background, 0 to 100, 0 not at all."""
    @property
    def FileName(self) -> str:
        """Gets the path the drawing names the picture by."""
    @property
    def FilePath(self) -> str:
        """Gets the full path of the picture file found; null where none was found or the picture is unloaded."""
    @property
    def FileStamp(self) -> int:
        """Gets the time the picture file was last written, in ticks, when the item was made, so that a picture
        changed on disk is read again; nought for none."""
    @property
    def IsBitonal(self) -> bool:
        """Gets whether the picture is bitonal, one bit a pixel as a scanned drawing is: its dark pixels are then
        drawn in the colour of the image object and its light ones are the background, which transparency lets
        what is under it show."""
    @property
    def IsClipInverted(self) -> bool:
        """Gets whether the picture shows what lies outside its rings rather than inside."""
    @property
    def IsDraft(self) -> bool:
        """Gets whether the picture is drawn with the quality Draft, each pixel a square, rather than High, the
        pixels blended where the picture is scaled (the drawing's IMAGEQUALITY)."""
    @property
    def IsMonochrome(self) -> bool:
        """Gets whether a plot draws the picture in black and white, as the plot quality Monochrome of an OLE frame
        says."""
    @property
    def IsPickedInside(self) -> bool:
        """Gets whether a point on the picture picks it, as it does for an OLE frame; an IMAGE is picked by its
        frame alone."""
    @property
    def IsTransparent(self) -> bool:
        """Gets whether the picture's transparent pixels let what is under it show (the IMAGE's transparency on)."""
    @property
    def Picture(self) -> System.Array[int]:
        """Gets the bytes of the bitmap file the picture of an OLE frame is, which the renderer decodes in place of
        a file; null for the picture of an IMAGE, which is read from DisplayImage2.FilePath."""
    @property
    def PictureKey(self) -> str:
        """Gets what tells the bytes of DisplayImage2.Picture from any others, so that a picture is decoded once
        however many drawings hold it."""
    @property
    def Ux(self) -> float:
        """Gets the X of the side along the picture's width."""
    @property
    def Uy(self) -> float:
        """Gets the Y of the side along the picture's width."""
    @property
    def Vx(self) -> float:
        """Gets the X of the side up the picture's height."""
    @property
    def Vy(self) -> float:
        """Gets the Y of the side up the picture's height."""
    @property
    def X(self) -> float:
        """Gets the X of the corner the picture's lower left pixel sits at."""
    @property
    def Y(self) -> float:
        """Gets the Y of that corner."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the picture: infinite for an IMAGE, which is picked by its frame, never
        by a point on it; for an OLE frame, nought on the picture and infinite off it."""

class DisplayItem2(System.Object):
    """One thing the canvas draws: a chain of segments, an arc, a fill, or a piece of text, in drawing coordinates,
    with the entity it came from."""
    @property
    def BlockClip(self) -> DisplayClipRegion:
        """Gets the part of the plane the item is shown in where the block reference it came from is clipped
        (XCLIP), or one it stands in is; null for an item that is shown whole. The canvas draws only what is
        inside it."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the entity the item came from; an entity inside a block gives the handle of the
        outermost INSERT."""
    @property
    def IsClipFrame(self) -> bool:
        """Gets whether the item is the frame of a clip boundary (XCLIP), which is drawn over what the reference
        shows and not clipped by it."""
    @property
    def IsNotPlotted(self) -> bool:
        """Gets whether the frame of a clip boundary is left out of a plot, as XCLIPFRAME 2 leaves it."""
    @property
    def Layer(self) -> str:
        """Gets the layer the item is drawn on."""
    @property
    def Style(self) -> DisplayStyle:
        """Gets how the item is drawn."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""
    def IsInside(self, box: DisplayBox) -> bool:
        """Gets whether the item lies wholly inside a box, as a window selection asks."""
    def Touches(self, box: DisplayBox) -> bool:
        """Gets whether any part of the item touches a box, as a crossing selection asks."""

class DisplayList2(System.Object):
    """What one space of a drawing, model space or a layout, is drawn as: its items in drawing order, the box that
    holds them, and the layers they sit on. It is made once from the entities and kept until one changes."""
    def __init__(self) -> None:
        """Makes an empty list."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds every item, of a DisplayRay2 its base point alone, as AutoCAD's ZOOM Extents
        takes an XLINE or a RAY: a line 100 by 50 from the origin and an XLINE through (200, 300) are held from
        (0, 0) to (200, 300)."""
    @property
    def Count(self) -> int:
        """Gets the number of items."""
    @property
    def Items(self) -> System.Collections.Generic.IReadOnlyList[DisplayItem2]:
        """Gets the items in the order they are drawn, the first at the back."""
    def Add(self, item: DisplayItem2) -> None:
        """Adds an item at the front."""

class DisplayPolyline2(DisplayItem2):
    """A chain of straight segments, open or closed: a LINE, a polyline, a flattened spline or ellipse."""
    def __init__(
        self,
        xy: Sequence[float] | System.Array[float],
        closed: bool,
        style: DisplayStyle,
        handle: str,
        layer: str,
    ) -> None:
        """Makes a chain."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def Closed(self) -> bool:
        """Gets whether the last vertex joins the first."""
    @property
    def Count(self) -> int:
        """Gets the number of vertices."""
    @property
    def IsSampled(self) -> bool:
        """Gets whether the vertices are samples along a curve (an ellipse, a spline, an arc drawn under a skew)
        rather than corners of the entity, so that object snaps take only the chain's two ends as endpoints and
        none of its midpoints."""
    @property
    def Xy(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the vertices as X and Y in turn. A chain of two keeps no list of them, so each ask makes one: ask
        once and read it."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""
    def Touches(self, box: DisplayBox) -> bool:
        """Gets whether any part of the item touches a box, as a crossing selection asks."""

class DisplayRay2(DisplayItem2):
    """A line without end: an XLINE, running both ways through its base point, or a RAY, running on from it. Its box
    reaches without end the ways it runs, so that every view it crosses draws it and a pick anywhere along it
    finds it; the box of its DisplayList2 holds its base point alone, as AutoCAD's ZOOM Extents does. The canvas
    draws the part the view shows (DisplayRay2.TryClip)."""
    def __init__(
        self,
        x: float,
        y: float,
        dx: float,
        dy: float,
        bothWays: bool,
        style: DisplayStyle,
        handle: str,
        layer: str,
    ) -> None:
        """Makes a line without end."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box the line reaches: without end along each axis it runs along, its base point's along one it
        runs across. An XLINE level through (200, 300) has the box from minus to plus infinity in X and from 300
        to 300 in Y."""
    @property
    def Dx(self) -> float:
        """Gets the X of the way it runs, of unit length."""
    @property
    def Dy(self) -> float:
        """Gets the Y of the way it runs, of unit length."""
    @property
    def IsBothWays(self) -> bool:
        """Gets whether it runs both ways, as an XLINE; false for a RAY."""
    @property
    def X(self) -> float:
        """Gets the X of the base point."""
    @property
    def Y(self) -> float:
        """Gets the Y of the base point."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""
    def Touches(self, box: DisplayBox) -> bool:
        """Gets whether any part of the item touches a box, as a crossing selection asks."""
    def TryClip(self, box: DisplayBox) -> tuple[bool, float, float, float, float]:
        """Gets the part of the line inside a box, as the canvas draws it in the view: an XLINE level through (200,
        300) in the box from (500, 290) to (510, 310) is the segment from (500, 300) to (510, 300). The ends run
        the way the line does."""

class DisplaySegments2(DisplayItem2):
    """Separate straight segments drawn alike, each from its own start to its own end: the lines of a hatch's
    pattern cut by its loops, kept as one item so that a hatch of 11 000 dashes is one thing to pick and to draw."""
    def __init__(self, xy: Sequence[float] | System.Array[float], style: DisplayStyle, handle: str, layer: str) -> None:
        """Makes a set of segments."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def Count(self) -> int:
        """Gets the number of segments."""
    @property
    def Rings(self) -> System.Collections.Generic.IReadOnlyList[System.Array[float]]:
        """Gets the loops of the hatch the segments are the pattern of, X and Y in turn, as the display list placed
        them: the canvas fills them with a tint where the lines come closer than 2 pixels, as a hatch of ANSI31
        at spacing 3 does on a sheet of 80 metres shown whole. Empty where the segments have no loops."""
    @property
    def Xy(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the segments, four numbers each: the start's X and Y, then the end's."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""
    def Touches(self, box: DisplayBox) -> bool:
        """Gets whether any part of the item touches a box, as a crossing selection asks."""

class DisplayStyle(System.Object):
    """How a display item is drawn: its colour, its line weight and its dashes, all resolved from the entity, its
    layer and its block."""
    def __init__(self, rgb: int, lineWeight: float, dashes: Sequence[float] | System.Array[float]) -> None:
        """Makes a style."""
    @property
    def Dashes(self) -> System.Array[float]:
        """Gets the dash pattern in drawing units, or null for a continuous line."""
    @property
    def LineWeight(self) -> float:
        """Gets the line weight in millimetres, nought for the thinnest line."""
    @property
    def Rgb(self) -> int:
        """Gets the colour as 0xRRGGBB."""

class DisplayText2(DisplayItem2):
    """A piece of text, placed by the point its alignment names; the canvas measures and draws it in a font."""
    @overload
    def __init__(
        self,
        text: str,
        x: float,
        y: float,
        height: float,
        rotation: float,
        widthFactor: float,
        horizontal: int,
        vertical: int,
        style: DisplayStyle,
        handle: str,
        layer: str,
        fontName: str,
        oblique: float,
    ) -> None:
        """Makes a piece of text."""
    @overload
    def __init__(
        self,
        text: str,
        x: float,
        y: float,
        height: float,
        rotation: float,
        widthFactor: float,
        horizontal: int,
        vertical: int,
        style: DisplayStyle,
        handle: str,
        layer: str,
        fontName: str,
        oblique: float,
        backward: bool,
    ) -> None:
        """Makes a piece of text that may be drawn backwards, as text in a mirrored block is."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def EstimatedWidth(self) -> float:
        """Gets the width the text is taken to have for picking and extents: of its widest line, by the advances of
        its letters where it is drawn in an SHX font (DisplayText2.Strokes); else from its height and the number
        of its letters, 0.6 of the height a letter, as a monospace font would, the canvas measuring the real
        width."""
    @property
    def FontName(self) -> str:
        """Gets the font of the text's style, a typeface or a font file; null for the canvas's own."""
    @property
    def Height(self) -> float:
        """Gets the height of a capital letter."""
    @property
    def Horizontal(self) -> int:
        """Gets where the point lies along the text: 0 left, 1 centre, 2 right."""
    @property
    def IsBackward(self) -> bool:
        """Gets whether the text is drawn backwards: laid out and drawn as always in its own frame (along
        DisplayText2.Rotation and up it), that frame then turned over along its baseline, so that the letters run
        against DisplayText2.Rotation and read as in a mirror. A text in a block inserted mirrored, written
        backwards or upside down is drawn so; a canvas draws it by scaling its frame by -1 along the baseline
        after turning it."""
    @property
    def IsBold(self) -> bool:
        """Gets whether the canvas draws the letters in the bold face of DisplayText2.FontName, as a run of an MTEXT
        coded |b1 is drawn."""
    @property
    def IsField(self) -> bool:
        """Gets whether the words are those of a field, which the canvas draws on a grey ground that is not plotted,
        as AutoCAD does where FIELDDISPLAY is 1; the ground covers the box of the text."""
    @property
    def IsItalic(self) -> bool:
        """Gets whether the canvas draws the letters in the italic face of DisplayText2.FontName, as a run of an
        MTEXT coded |i1 is drawn."""
    @property
    def IsQuick(self) -> bool:
        """Gets whether the text is shown as its box alone, as AutoCAD shows it where QTEXTMODE is 1: the canvas
        draws the rectangle that holds its lines, in the text's colour, and not its letters. The words stay for
        what reads them."""
    @property
    def LineCount(self) -> int:
        """Gets the number of lines of the text."""
    @property
    def Oblique(self) -> float:
        """Gets how far the letters lean, in radians clockwise from upright."""
    @property
    def Parts(self) -> System.Collections.Generic.IReadOnlyList[DisplayItem2]:
        """Gets what an MTEXT is drawn as, in place of DisplayText2.Text drawn whole: its mask (a DisplayFill2) and
        its frame first, then a text for each run of each line where AutoCAD sets it, in its own font, face,
        height, width, slant and colour, the parts of a stacked fraction among them, and a line under, over or
        through a run its codes line and for the bar of a fraction; null for a TEXT, drawn whole. The text keeps
        its words, height and attachment as one text has them, for what reads it; its box is that of the parts.
        \"AB{\\C1;CD}\" 2.5 high is drawn as AB in the MTEXT's colour and CD in red after it; \"II II II\" 20
        wide in letters 10 high as \"II II\" and, 16.67 below it, \"II\"."""
    @property
    def Rotation(self) -> float:
        """Gets the angle of the baseline in radians."""
    @property
    def Strokes(self) -> System.Collections.Generic.IReadOnlyList[System.Array[float]]:
        """Gets the strokes of the letters where the text is drawn in an SHX font, each a polyline of x, y pairs in
        the drawing's coordinates, the text's height, width factor, slant, alignment, angle and turning over
        already taken, then the lines a TEXT's %%U, %%K and %%O draw under, through and over its letters, one
        segment each; null where the canvas draws the text in DisplayText2.FontName."""
    @property
    def Text(self) -> str:
        """Gets the text."""
    @property
    def Vertical(self) -> int:
        """Gets where the point lies up the text: 0 baseline, 1 bottom, 2 middle, 3 top."""
    @property
    def WidthFactor(self) -> float:
        """Gets the width factor."""
    @property
    def X(self) -> float:
        """Gets the X of the alignment point."""
    @property
    def Y(self) -> float:
        """Gets the Y of the alignment point."""
    def DistanceTo(self, x: float, y: float) -> float:
        """Gets the distance from a point to the item, the shortest to any part that is drawn; the distance to the
        nearest edge for a fill, nought inside it."""

class DisplayViewport2(DisplayItem2):
    """A viewport of a layout: a window onto model space at a scale, which the canvas draws by clipping to its frame
    and drawing the model-space items under the viewport's transformation."""
    def __init__(
        self,
        centerX: float,
        centerY: float,
        width: float,
        height: float,
        viewCenterX: float,
        viewCenterY: float,
        scale: float,
        twist: float,
        model: DisplayList2,
        frozenLayers: System.Collections.Generic.ISet[str],
        style: DisplayStyle,
        handle: str,
        layer: str,
    ) -> None:
        """Makes a viewport."""
    @property
    def Bounds(self) -> DisplayBox:
        """Gets the box that holds the item."""
    @property
    def CenterX(self) -> float:
        """Gets the X of the centre of the frame, in paper units."""
    @property
    def CenterY(self) -> float:
        """Gets the Y of the centre of the frame, in paper units."""
    @property
    def Clip(self) -> DisplayClip2:
        """Gets the outline the viewport is clipped to (VPCLIP), in paper units: model space shows through it in
        place of the frame, and it is the border of the viewport; null for a viewport that is its frame."""
