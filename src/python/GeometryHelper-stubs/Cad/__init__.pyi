class CadLayerEditor(System.Object):
    """The edits of the layer table, as the layer box, the Layer manager and the LAYER command make them: each one
    undo step through CadDocument.ApplyEdit, refused as AutoCAD refuses it where AutoCAD would not do it."""
    @staticmethod
    def Add(document: CadDocument, name: str) -> CadEditResult:
        """Adds a layer of the colour White (7) and the linetype Continuous, as AutoCAD's New layer."""
    @staticmethod
    def Delete(document: CadDocument, name: str) -> CadEditResult:
        """Deletes a layer, as the Layer manager deletes one: only a layer nothing uses. Refused, with the reason,
        for layer 0, Defpoints, the current layer, a layer of an external reference (Base|Steel), a layer an
        entity is on, in any space or block, and a layer an object points at, as a viewport that freezes it."""
    @staticmethod
    def DeleteWithObjects(
        document: CadDocument,
        names: System.Collections.Generic.IReadOnlyCollection[str],
    ) -> CadEditResult:
        """Deletes layers with everything on them, as AutoCAD's LAYDEL does: every object on the layers, in model
        space, in the layouts and in every block (the blocks' definitions too), and the attributes of the block
        references, is erased, then the layers. A drawing with 12 lines on layer TMP and a block whose definition
        holds 4 more has none of the 16 after TMP is deleted. One undo step."""
    @staticmethod
    def IsLocked(database: DxfDatabase, name: str) -> bool:
        """Gets whether a layer of the drawing is locked; false for a layer it has not."""
    @staticmethod
    def Merge(
        document: CadDocument,
        names: System.Collections.Generic.IReadOnlyCollection[str],
        target: str,
    ) -> CadEditResult:
        """Merges layers into another, as AutoCAD's LAYMRG does: every object on the layers merged, in model space,
        in the layouts, in every block (those of the blocks' definitions too) and the attributes of the block
        references, is put on the target layer, and the layers merged are deleted. A drawing with a line on layer
        WALL and another on layer DOOR, DOOR merged into WALL, has both lines on WALL afterwards and no layer
        DOOR. One undo step."""
    @staticmethod
    def Rename(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Renames a layer with every object on it, as the Layer manager's name cell and AutoCAD 2021's -RENAME do:
        the new name with the spaces around it taken off, so that \" T2 \" names it T2, and letters of another
        case taken (TEXT to text). Refused in AutoCAD 2021's words: layer 0, Cannot rename layer \"0\".; a name
        already used, letters of either case the same, A layer named \"DIM\" already exists.; an empty name, one
        with a character a layer name cannot hold (< > / \\ \" : ; ? * | , = `) and a layer of an external
        reference, Invalid layer name. Defpoints is renamed, as AutoCAD renames it."""
    @overload
    @staticmethod
    def SetColor(document: CadDocument, name: str, color: DxfColor) -> CadEditResult:
        """Gives a layer a colour as AutoCAD's Select Color dialog does: one of the index, written to group 62
        (below nought while the layer is off), or a true colour, written to group 420 with the index nearest it
        in 62, so that red, green and blue 10, 20, 30 is written 420 = 660510 beside the nearest index. ByLayer
        and ByBlock are refused, as a layer cannot take them, and a true colour in a file older than AutoCAD 2004
        (AC1018), which has none."""
    @overload
    @staticmethod
    def SetColor(document: CadDocument, name: str, colorIndex: int) -> CadEditResult:
        """Gives a layer a colour of AutoCAD's index, 1 to 255; a true colour it had is taken out, as AutoCAD's
        index colour does."""
    @staticmethod
    def SetCurrent(document: CadDocument, name: str) -> CadEditResult:
        """Makes a layer current, as the layer box does; a frozen layer is refused, as AutoCAD refuses it, and a
        layer of an external reference (grid|WALL) in the words AutoCAD 2021 refuses CLAYER set to one."""
    @staticmethod
    def SetDescription(document: CadDocument, name: str, description: str) -> CadEditResult:
        """Gives a layer a description, as -LAYER Description does; one of an external reference marked 1024, as
        AutoCAD 2021 marks it."""
    @staticmethod
    def SetFrozen(document: CadDocument, name: str, frozen: bool) -> CadEditResult:
        """Freezes or thaws a layer; the current layer is not frozen, as AutoCAD refuses it."""
    @staticmethod
    def SetLineWeight(document: CadDocument, name: str, lineWeight: DxfLineWeight) -> CadEditResult:
        """Gives a layer a lineweight: Default, or one of AutoCAD's widths; ByLayer and ByBlock are refused, as a
        layer cannot take them."""
    @staticmethod
    def SetLinetype(document: CadDocument, name: str, linetype: str) -> CadEditResult:
        """Gives a layer a linetype the drawing has, as the Layer manager does; one it has not is refused, as the
        library keeps no standard linetypes of its own to load one from (AutoCAD's acad.lin is Autodesk's and is
        not shipped)."""
    @staticmethod
    def SetLocked(document: CadDocument, name: str, locked: bool) -> CadEditResult:
        """Locks or unlocks a layer: the objects on a locked layer are drawn but not changed."""
    @staticmethod
    def SetOn(document: CadDocument, name: str, on: bool) -> CadEditResult:
        """Switches a layer on or off; the current layer may be switched off, as in AutoCAD."""
    @staticmethod
    def SetPlotStyle(document: CadDocument, name: str, plotStyle: str) -> CadEditResult:
        """Gives a layer a plot style of the drawing's plot style names, as -LAYER PStyle and the Plot Style column
        do. Refused in a drawing plotted by colour, where AutoCAD names the plot style of a layer by its colour
        (Color_30) and takes no other, and for a name the drawing has not."""
    @staticmethod
    def SetPlottable(document: CadDocument, name: str, plotted: bool) -> CadEditResult:
        """Sets whether a layer is plotted, as -LAYER Plot does; one of an external reference marked 8, as AutoCAD
        2021 marks it."""
    @staticmethod
    def SetTransparency(document: CadDocument, name: str, percent: int) -> CadEditResult:
        """Gives a layer a transparency of 0 to 90 per cent, as -LAYER TRansparency does: 50 is written as the alpha
        127, as AutoCAD keeps it, and 0 as solid; one of an external reference marked 128, as AutoCAD 2021 marks
        it."""
    @staticmethod
    def Translate(
        document: CadDocument,
        mappings: System.Collections.Generic.IReadOnlyList[CadLayerMapping],
        settings: CadLayerTranslatorSettings,
        log: System.Collections.Generic.IList[str],
    ) -> CadEditResult:
        """Translates layers, as AutoCAD's Layer Translator does for the mappings made: the layers translated to are
        made where the drawing has none (with the linetype copied from the standards file where the drawing has
        none) and given the colour, linetype, lineweight, transparency and plot style of the mapping where it has
        them; every object of a layer translated, in model space, the layouts and the blocks (those of the blocks
        left out where the settings say so), the attributes of block references among them, is put on the layer
        it is translated to; the layers translated from are deleted but for layer 0, Defpoints and any layer
        another mapping translates to. A drawing with 40 lines on OLD-WALL and a mapping of OLD-WALL to WALL
        (colour 3) has the 40 lines on WALL, WALL green, and no layer OLD-WALL afterwards. One undo step."""

class CadLayerExpression(System.Object):
    """The expression of a property filter, as AutoCAD's FilterExpression keeps it (group 301 of the filter's
    XRECORD): rules of the form NAME==\"A*\" joined by AND and OR, AND binding tighter, with brackets; read as a
    list of alternatives (OR), each a list of rules all of which a layer has to pass (AND). NAME==\"1_Arch*\" AND
    OFF==\"False\" is one alternative of two rules; NAME==\"*dim\" OR NAME==\"*text\" is two of one."""
    def __init__(
        self,
        alternatives: System.Collections.Generic.IReadOnlyList[System.Collections.Generic.IReadOnlyList[CadLayerRule]],
    ) -> None:
        """Makes an expression of alternatives."""
    @property
    def Alternatives(
        self,
    ) -> System.Collections.Generic.IReadOnlyList[System.Collections.Generic.IReadOnlyList[CadLayerRule]]:
        """Gets the alternatives: a layer passes when it passes all the rules of one of them; none passes every
        layer."""
    Variables: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """Gets the properties a filter can test, in the order of AutoCAD's columns."""
    def Matches(self, layer: DxfLayerTableRecord, context: CadLayerFilterContext) -> bool:
        """Whether a layer passes: one alternative whose rules it passes all. Where the expression has no rule every
        layer passes; a rule of a property the library does not know passes none, as AutoCAD answers one."""
    def ToString(self) -> str:
        """Gives the expression as AutoCAD's filter dialog writes it: rules joined by AND, alternatives by OR, no
        brackets."""
    @staticmethod
    def TryParse(text: str) -> tuple[bool, CadLayerExpression]:
        """Reads an expression: NAME==\"A*\" AND COLOR==\"1\", OFF == \"FALSE\" and FROZEN == \"FALSE\", ( NAME==
        \"A*\" ), letters of either case, spaces round the signs or none."""

class CadLayerFilter(System.Object):
    """A layer filter the drawing keeps, as AutoCAD 2021 keeps it in ACLYDICTIONARY of the layer table's extension
    dictionary: an XRECORD of its name (group 300) and its expression (301) for a property filter, or its layers
    (a 330 each) for a group filter, the filter nested in it in an ACLYDICTIONARY of its own XRECORD's extension
    dictionary."""
    @property
    def Children(self) -> System.Collections.Generic.IReadOnlyList[CadLayerFilter]:
        """Gets the filters nested in it, by name."""
    @property
    def Expression(self) -> str:
        """Gets the expression of a property filter as the drawing keeps it; empty for a group filter."""
    @property
    def IsCurrent(self) -> bool:
        """Gets whether it is the filter AutoCAD marks as the current one (group 290), the one the layer list
        shows."""
    @property
    def IsLegacy(self) -> bool:
        """Gets whether only ACAD_LAYERFILTERS, the dictionary of AutoCAD 2004 and earlier, keeps it."""
    @property
    def Kind(self) -> CadLayerFilterKind:
        """Gets whether it is a property filter or a group filter."""
    @property
    def LayerNames(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the layers of a group filter, by name; empty for a property filter."""
    @property
    def Name(self) -> str:
        """Gets the name."""
    @property
    def Parent(self) -> CadLayerFilter:
        """Gets the filter it is nested in; null for one at the top, under All."""
    @property
    def Path(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names from the top to this filter, as Steel, Beams."""
    def ToString(self) -> str:
        """Gives the filter as a line for debugging: its path."""

class CadLayerFilterContext(System.Object):
    """What a layer filter is tested against: the viewport VP Freeze looks at, and the plot styles and the layers in
    use of the drawing. The layers in use are worked out by the first rule that asks for them, once, and kept
    until the drawing changes."""
    def __init__(self, database: DxfDatabase, viewport: DxfViewport = ...) -> None:
        """Makes a context."""
    @property
    def Viewport(self) -> DxfViewport:
        """Gets the viewport VPFROZEN is read in; null for none."""

class CadLayerFilterKind(System.Enum):
    """What kind of filter a layer filter of the drawing is."""
    Group: ClassVar[CadLayerFilterKind]
    """A group filter: the layers it names."""
    Property: ClassVar[CadLayerFilterKind]
    """A property filter: the layers whose properties pass its CadLayerFilter.Expression."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadLayerFilters(System.Object):
    """The layer filters of a drawing, read and edited as AutoCAD 2021 keeps them: property filters and group
    filters nested under All, the three AutoCAD makes (All Used Layers, Unreconciled New Layers, Viewport
    Overrides) not kept in the drawing. A filter is added, changed, renamed, deleted, made current and given
    layers, each one undo step; a name that is a sibling's already is refused."""
    Dynamic: ClassVar[System.Collections.Generic.IReadOnlyList[System.Collections.Generic.KeyValuePair[str, str]]]
    """The filters AutoCAD makes, listed after those the drawing keeps; each tests one property."""
    @staticmethod
    def AddGroup(
        document: CadDocument,
        parentPath: System.Collections.Generic.IReadOnlyList[str],
        name: str,
        layerNames: System.Collections.Generic.IEnumerable[str],
    ) -> CadEditResult:
        """Adds a group filter, nested in a filter or at the top, holding the layers named (those the drawing
        has)."""
    @staticmethod
    def AddProperty(
        document: CadDocument,
        parentPath: System.Collections.Generic.IReadOnlyList[str],
        name: str,
        expression: str,
    ) -> CadEditResult:
        """Adds a property filter, nested in a filter or at the top, with an expression of AutoCAD's form."""
    @staticmethod
    def All(
        filters: System.Collections.Generic.IEnumerable[CadLayerFilter],
    ) -> System.Collections.Generic.IEnumerable[CadLayerFilter]:
        """The filters and every filter nested in them, depth first, in the order they are listed."""
    @staticmethod
    def ConvertToGroup(document: CadDocument, path: System.Collections.Generic.IReadOnlyList[str]) -> CadEditResult:
        """Turns a property filter into a group filter of the layers it shows now, as AutoCAD's Convert to Group
        Filter does; the filters nested in it stay in it."""
    @staticmethod
    def Delete(document: CadDocument, path: System.Collections.Generic.IReadOnlyList[str]) -> CadEditResult:
        """Deletes a filter with the filters nested in it; the layers stay."""
    @staticmethod
    def Find(
        filters: System.Collections.Generic.IReadOnlyList[CadLayerFilter],
        path: System.Collections.Generic.IReadOnlyList[str],
    ) -> CadLayerFilter:
        """Finds a filter by its names from the top, letters of either case the same."""
    @staticmethod
    def Passes(filter: CadLayerFilter, layer: DxfLayerTableRecord, context: CadLayerFilterContext) -> bool:
        """Whether a layer passes a filter: the layer has to pass every filter above it and the filter itself, so
        that a filter nested in Steel by COLOR==\"1\" shows the red layers of the steel ones. A property filter
        reads its expression, a group filter its layers."""
    @staticmethod
    def PassesDynamic(name: str, layer: DxfLayerTableRecord, context: CadLayerFilterContext) -> bool:
        """Whether a layer passes one of the filters AutoCAD makes, by its name: All Used Layers, Unreconciled New
        Layers (none, as the library does not reconcile) and Viewport Overrides."""
    @staticmethod
    def Read(database: DxfDatabase) -> System.Collections.Generic.IReadOnlyList[CadLayerFilter]:
        """Reads the filters of the drawing: those of ACLYDICTIONARY with the filters nested in them, then those
        only ACAD_LAYERFILTERS keeps (marked CadLayerFilter.IsLegacy, their expression the one of the record's
        extended data), each level in the order of the names, letters of either case alike."""
    @staticmethod
    def Rename(
        document: CadDocument,
        path: System.Collections.Generic.IReadOnlyList[str],
        newName: str,
    ) -> CadEditResult:
        """Renames a filter; a name a sibling has already, letters of either case the same, is refused."""
    @staticmethod
    def SetCurrent(document: CadDocument, path: System.Collections.Generic.IReadOnlyList[str]) -> CadEditResult:
        """Marks the filter the layer list shows as the current one, as AutoCAD does when one is chosen in its tree
        (group 290 of its XRECORD); none marks All."""
    @staticmethod
    def SetExpression(
        document: CadDocument,
        path: System.Collections.Generic.IReadOnlyList[str],
        expression: str,
    ) -> CadEditResult:
        """Changes the expression of a property filter."""
    @staticmethod
    def SetLayers(
        document: CadDocument,
        path: System.Collections.Generic.IReadOnlyList[str],
        layerNames: System.Collections.Generic.IEnumerable[str],
        replace: bool,
    ) -> CadEditResult:
        """Gives a group filter layers, as dragging layers onto it or Select Layers does: added to those it has, or
        in place of them. A layer the drawing does not have is left out."""
    @staticmethod
    def Visible(
        database: DxfDatabase,
        path: System.Collections.Generic.IReadOnlyList[str],
        invert: bool,
        viewport: DxfViewport,
    ) -> System.Collections.Generic.HashSet[str]:
        """The names of the layers a filter lists: those that pass it (those that do not where invert), the filter
        found by its names from the top, or by the name of one AutoCAD makes. A path that names no filter, and an
        empty one, is All: every layer."""

