    def WatchFiles(self, value: bool) -> None: ...
    @property
    def FilesChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when a file an external reference was read from, or an image shows, changes on disk, while
        CadXrefManager.WatchFiles is on; raised on a thread of the watcher, not the window's."""
    @FilesChanged.setter
    def FilesChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    def Dispose(self) -> None:
        """Stops watching every folder."""
    def GetReferences(self) -> System.Collections.Generic.IReadOnlyList[CadExternalReference]:
        """Gets the external references of the drawing, then its images, each in ordinal order of its name, letters
        of either case alike first, with where it stands: an external reference no INSERT places is Unreferenced,
        one whose file is not found Not Found, and so on. An external reference not yet read is read here. Each
        one the drawing places is followed by the references its drawing attaches, nested, as the palette's tree
        shows them (CadExternalReference.Depth, CadExternalReference.ParentName), each in the order of its name;
        a nested overlay is not, as AutoCAD shows none. A nested reference whose parent is unloaded, not found or
