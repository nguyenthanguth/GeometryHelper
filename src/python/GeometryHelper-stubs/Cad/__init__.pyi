    def RestoreOnExit(self, value: bool) -> None: ...
    @property
    def Rows(self) -> System.Collections.Generic.IReadOnlyList[CadLayerWalkRow]:
        """Gets every layer of the drawing, in ordinal order of the names, letters of either case alike."""
    @property
    def Selected(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the layers walked now; empty where every layer is as it was."""
    def Purge(
        self,
        names: System.Collections.Generic.IEnumerable[str],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
