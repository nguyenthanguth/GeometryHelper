class CadMTextParagraph(System.Object):
    """A paragraph of an MTEXT: its runs, how it is aligned (\\pxqc;) and any other paragraph codes it carries, kept
    as written."""
    def __init__(
        self,
        runs: System.Collections.Generic.IReadOnlyList[CadMTextRun],
