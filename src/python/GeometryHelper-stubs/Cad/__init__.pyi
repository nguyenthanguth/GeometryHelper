    @property
    def Document(self) -> CadDocument:
        """Gets the document."""
    @property
    def Filter(self) -> str:
        """Gets or sets the words the list is narrowed by, a wild-card pattern as the AutoCAD filter box takes it
        (WALL*, *-EXT,DOOR?); empty or * lists every layer."""
