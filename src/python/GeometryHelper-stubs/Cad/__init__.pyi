    BottomRight: ClassVar[CadPlotStampCorner]
    """The lower right corner, BR."""
    TopLeft: ClassVar[CadPlotStampCorner]
    """The upper left corner, TL."""
    TopRight: ClassVar[CadPlotStampCorner]
    """The upper right corner, TR."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

