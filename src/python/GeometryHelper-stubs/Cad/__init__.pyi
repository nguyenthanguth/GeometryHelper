class CadHyperlinks(System.Object):
    """The hyperlinks of objects, as AutoCAD 2021 keeps and follows them: kept in the extended data of PE_URL
    (DxfEntity.Hyperlinks), the address, the text it is shown by and the named place in it; a link to a view of
    the drawing has no address and the view as its place; an e-mail address is written mailto: with its subject
    after ?subject=. These helpers say where a hyperlink leads, how its tooltip reads and which objects have one."""
    FollowHint: ClassVar[str]
    """The words under a hyperlink's text in the tooltip the cursor shows over its object, as AutoCAD writes
    them."""
