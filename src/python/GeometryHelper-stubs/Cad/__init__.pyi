    def FillColor(self) -> DxfColor:
        """Gets the colour of the mask; null where the MTEXT gives none (by layer)."""
    @property
    def OffsetFactor(self) -> float:
        """Gets how far the mask reaches past the words, a multiple of the text height."""
    @property
    def UseDrawingBackground(self) -> bool:
        """Gets whether the mask takes the drawing's background colour."""
    @property
    def UseMask(self) -> bool:
        """Gets whether the words stand on a mask."""
    def ApplyTo(self, text: DxfMText) -> None:
        """Gives an MTEXT this mask: the fill and the drawing's background colour switched as it says, the factor
        and, where the mask takes a colour of its own, the colour written; an MTEXT with the mask off is left
        with the record it has but for the two flags. What the MTEXT already has is not written again."""
    @overload
    def Equals(self, other: CadMTextMask) -> bool: ...
    @overload
    def Equals(self, obj: object) -> bool: ...
    def GetHashCode(self) -> int: ...
    @staticmethod
    def Of(text: DxfMText) -> CadMTextMask:
        """Reads the mask an MTEXT has: none for one with no background fill."""

