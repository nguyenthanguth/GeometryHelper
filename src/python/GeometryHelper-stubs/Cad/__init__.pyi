    @property
    def Prompt(self) -> CadPrompt:
        """Gets the prompt waiting for an answer, or null when no command runs."""
    @property
    def PromptText(self) -> str:
        """Gets the text the command line shows: the prompt's, or empty when no command runs; (_> while a line of
        AutoLISP waits for its closing parenthesis."""
    @property
    def RecentInput(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the answers typed at prompts of the kind the prompt waiting asks, the newest first and each once,
        ten at most: points typed at a prompt for a point (as 100,0, @0,50 or a distance along the rubber band),
        numbers at one for a distance, an angle or a whole number, written in the drawing's units
        (100.0000,0.0000 at LUNITS 2 and LUPREC 4), and at Select objects the sets of objects answered,
        \"Selection set (2 items)\". A point picked on the canvas and an option keyword are not kept. After
        LINE's 0,0 then 100,0, the next point offers 100.0000,0.0000 and 0.0000,0.0000; empty where the prompt
        asks for something else or no command runs."""
    @property
    def Registry(self) -> CadCommandRegistry:
        """Gets the commands it knows."""
    @property
    def Remembered(self) -> System.Collections.Generic.Dictionary[str, float]:
        """Gets the values the commands remember from one run to the next, by name, as TEXT the height last typed
        (\"text.height\"); a host sets a default here, as Global settings sets the text height of TEXT and MTEXT,
        their width factor (\"text.widthFactor\") and the height of the text of the dimensions DIM* makes
        (\"dim.text.height\")."""
    @property
    def SelectionFilter(self) -> CadSelectionFilter:
        """Gets the filter FILTER edits and applies: its current lines and the lists saved under a name."""
    @property
    def SnapAperture(self) -> float:
        """Gets or sets the aperture of the object snap in drawing units, 10 pixels over the zoom as the canvas sets
        it with the cursor: how near an object must lie to a point typed after an override
        (CadCommandSession.SnapOverride) to be snapped."""
    @SnapAperture.setter
    def SnapAperture(self, value: float) -> None: ...
    @property
    def SnapOverride(self) -> CadSnapModes | None:
        """Gets or sets the object snap taken for the next point alone (the window sets it with its own override): a
        point typed at a prompt for a point, at \"Select objects:\", at a prompt for one object, at a corner of a
        window and at a point of a fence or a polygon is snapped to the snap point of the object under it, within
        CadCommandSession.SnapAperture, as AutoCAD 2021 snaps it, the point of an object found however far from
        the typed point it lies: with END, an aperture of 1.3 and a line from (0, 0) to (100, 0), 30,1 gives (0,
        0) and 70,1 gives (100, 0), but 50,3 gives \"No Endpoint found for specified point.\" and then the words
        of the prompt it was typed at (\"Invalid point.\", \"*Invalid selection*\" at \"Select objects:\",
        \"Invalid window specification.\" at a corner, \"Invalid response.\" at a fence), and the prompt is asked
        again. The override is for one point: it is cleared once a point is typed. ENDpoint, MIDpoint, CENter,
        QUAdrant, NODe, INSert, NEArest, PERpendicular, TANgent and GCEnter are taken; INTersection and APPint
        take the crossing of two objects under the point, or where one lies there ask \" and\" for the second,
        answered by a point on it, and with the objects not crossing say \"No Intersection found for specified
        point.\"; EXTension and PARallel, which need the cursor to rest on an object, find nothing at a point
        typed. Where a snap has no name in AutoCAD's words (NEArest, TANgent, GCEnter, APPint, EXTension,
        PARallel) it says \"No found for specified point.\" NONe leaves the point as typed. Null for none."""
    @SnapOverride.setter
    def SnapOverride(self, value: CadSnapModes | None) -> None: ...
    @property
    def SpellDictionaryPath(self) -> str:
        """Gets or sets the custom dictionary file SPELL starts with, AutoCAD's sample.cus form of words one to a
        line: read where it exists, and the file Add to Dictionary appends to, made where it is not there; null,
        until set, for none, SPELL then asking for one as before. The window sets the file in its settings
        folder."""
    @SpellDictionaryPath.setter
    def SpellDictionaryPath(self, value: str | None) -> None: ...
    @property
    def TemporaryTrackPoints(self) -> System.Collections.Generic.IReadOnlyList[GeoPoint2]:
        """Gets the temporary track points (TT) given for the point asked now, the oldest first: the window acquires
        each for object snap tracking, as AutoCAD does, so that lines run from it level and upright, or on the
        polar angles, while OTRACK is on. They are let go once a point is given or the command ends."""
    @property
    def Tolerance(self) -> Tolerance:
        """Gets or sets the tolerance of the commands' checks, as whether two points given are one;
        Tolerance.Default until set."""
    @Tolerance.setter
    def Tolerance(self, value: Tolerance) -> None: ...
    @property
    def Ucs(self) -> CadUcs:
        """Gets the user coordinate system the prompts work in, the document's CadUcsManager.Working: a point typed
        as x,y, @dx,dy or @distance<angle is in it, one typed after a * in the world's, and an angle given is
        measured from its X axis. Points given to the commands are world points all the same: in a system turned
        a quarter turn, @100<0 from (0, 0) is the world point (0, 100)."""
    @property
    def View(self) -> CadView:
        """Gets or sets the view of the canvas, which ZOOM and PAN change; null where there is none, as in a
        test."""
    @View.setter
    def View(self, value: CadView | None) -> None: ...
    @property
    def PromptChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when the prompt changes: a command started, a prompt answered, a command ended."""
    @PromptChanged.setter
    def PromptChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    @property
    def UiRequested(self) -> System.EventHandler[CadUiRequestEventArgs]:
        """Raised when a command asks the window for something: PROPERTIES, LAYER, OPTIONS, QSAVE."""
    @UiRequested.setter
    def UiRequested(self, value: System.EventHandler[CadUiRequestEventArgs]) -> None: ...
    def CountAngle(self, direction: float) -> float:
        """Counts a direction as the drawing counts angles, for a readout or a default in angle brackets: from
        ANGBASE, clockwise with ANGDIR 1, from nought up to a whole turn, as AutoCAD's DIST writes 90 for a line
        drawn east in a drawing whose angles are counted from north, clockwise."""
    def EndWindow(self) -> bool:
        """Ends the implied window at its opposite corner without selecting, the prompt kept in the history as a
        click answers it: the canvas that picked the corner selects with the box it shows, Shift and a twisted
        viewport with it."""
    def Enter(self) -> None:
        """Enter or Space with nothing typed: the prompt's default, the end of a selection, the end of a command
        that draws on until Enter (LINE); with no command running, the command run last again."""
    def Escape(self) -> None:
        """Esc: ends the command running, keeping what it made, with \"*Cancel*\" in the history; while a line of
        AutoLISP waits for its closing parenthesis it drops that line alone and the command goes on asking, as
        AutoCAD does; at a question of an AutoLISP routine (getpoint, entsel) the routine gets Function
        cancelled, as it would in AutoCAD."""
    @overload
    def Feed(self, point: GeoPoint2) -> bool:
        """Answers the prompt with a point picked on the canvas (already snapped). At \"Select objects:\" it picks
        the object nearest the point within CadCommandSession.PickAperture."""
    @overload
    def Feed(self, text: str) -> bool:
        """Takes text typed on the command line and Enter: with no command running, the name of one to start (or
        Enter alone running the last again); else the answer to the prompt, a keyword by its capital letters, a
        number, a point as x,y, @dx,dy, @distance<angle or distance<angle, a number alone at a point prompt being
        a distance along the rubber band towards the cursor. At \"Select objects:\" the options of AutoCAD 2021:
        ALL every object of the space, Window, Crossing and BOX by two corners, Fence, WPolygon and CPolygon by
        points until Enter, Last the object made last, Previous the objects the command before took, Group by
        name, Remove and Add to take out and put in, Undo the last change, Multiple points until Enter, SIngle to
        end with the first objects taken, AUto; a point typed there picks as a click does, \"Select objects:
        50,0\" then \"1 found\", and where it hits nothing starts the window as AutoCAD 2021 does, \"Select
        objects: -50,-50\" then \"Specify opposite corner:\"; anything else is \"*Invalid selection*\" with the
        options listed. A point modifier, FROM, M2P, TT, TK or a point filter, starts at a prompt for a point or
        for objects (CadCommandSession.StartPointModifier). A point typed after an object snap override is
        snapped to the object under it, or refused where none is found (CadCommandSession.SnapOverride). 'PAN or
        'ZOOM typed at any prompt but one for text runs inside the command waiting
        (CadCommandSession.IsTransparent)."""
    @overload
    def Feed(self, snapped: CadSnapResult, control: bool) -> bool:
        """Answers the prompt with a point an object snap gave on the canvas, as CadCommandSession.Feed answers with
        its point, keeping which snap and which object gave it: a dimension made with DIMASSOC 2 ties the point
        to the object, as AutoCAD ties a point picked with ENDpoint, MIDpoint, CENter, QUAdrant, NODe or NEArest.
        The end of a line snapped with ENDpoint at the first prompt of DIMLINEAR ties the dimension's first point
        to that end."""
    @overload
    def Feed(self, point: GeoPoint2, shift: bool) -> bool:
        """Answers the prompt with a point picked on the canvas, as CadCommandSession.Feed does, saying whether
        Shift was held: at a prompt for one object the answer carries it (CadInput.Shift), as TRIM extends an
        object picked with Shift held, and EXTEND trims one; at \"Select objects:\" the object picked is taken
        out of the objects gathered, as AutoCAD takes it out. At any other prompt Shift changes nothing."""
    @overload
    def Feed(self, point: GeoPoint2, shift: bool, control: bool) -> bool:
        """Answers the prompt with a point picked on the canvas, as CadCommandSession.Feed does, saying whether Ctrl
        was held too: at a prompt for a point, a distance or an angle the answer carries it (CadInput.Control),
        as ARC draws an arc whose end is picked with Ctrl held clockwise rather than counter-clockwise, and a
        grip edit takes its first point picked with Ctrl held as Copy."""
    def FeedRecentInput(self, index: int) -> bool:
        """Answers the prompt waiting with an entry of CadCommandSession.RecentInput, as the Recent Input menu does:
        the text typed again, or at Select objects the set of objects again, those of it that are still in the
        drawing."""
    @overload
    def FeedSelection(self, handles: System.Collections.Generic.IEnumerable[str], remove: bool = ...) -> bool:
        """Answers \"Select objects:\" with objects picked by a click, a window or a crossing box, or with Shift
        held takes them out of those gathered: \"1 found, 1 removed, 2 total\". At \"Remove objects:\" they are
        taken out either way. At a prompt for one object, the first."""
    @overload
    def FeedSelection(
        self,
        handles: System.Collections.Generic.IEnumerable[str],
        window: DisplayBox,
        crossing: bool,
        remove: bool = ...,
    ) -> bool:
        """Answers \"Select objects:\" with the objects a window or crossing box dragged on the canvas took, as
        CadCommandSession.FeedSelection does, the box kept with them: -ATTEDIT then takes only the attributes of
        an INSERT that lie inside the window, or that the crossing box touches, as AutoCAD's does."""
    def IsLispInput(self, line: str) -> bool:
        """Gets whether text typed at the command line is AutoLISP: a line of it waits for more, or the text starts
        with (, a form, or !, the value of a variable. A bare word or number at the Command prompt is a command.
        While a routine waits for an answer, or for a command it started, nothing is AutoLISP: AutoCAD does not
        run LISP inside LISP, and the text goes to the prompt as typed."""
    def LoadLisp(self, path: str) -> bool:
        """Loads an AutoLISP file as APPLOAD does: the lines the file wrote, then name.lsp successfully loaded., or
        the ; error: line an error gave, which leaves what the file ran before it."""
    def OpenUndoStep(self) -> None:
        """Opens the undo step of the command running now, so that a setting changed through
        CadDocument.ApplySetting by the window while the command asks (GRID turning the grid on after its
        spacing) joins the command's step; does nothing where no command runs."""
    @overload
    def Start(self, command: CadCommand) -> bool:
        """Starts a command that is not in the registry, as a host does for the question of a script: its prompts,
        Esc, the rubber band and the object snaps are those of any command. Leaves
        CadCommandSession.LastCommandName as it was, so Enter repeats the last command the user ran. Refused
        while a command runs."""
    @overload
    def Start(self, typed: str) -> bool:
        """Starts a command by its name or alias, ending any command running first as Esc would."""
    def StartGripAction(self, handle: str, gripIndex: int, action: CadGripAction) -> bool:
        """Starts an item of a multi-functional grip's hover menu (CadGripMenus.Of), as a choice in AutoCAD 2021's
        menu starts it. Stretch and Stretch Vertex are the grip edit of CadCommandSession.StartGripEdit, asking
        \"** STRETCH **\" as AutoCAD's table of the polyline's grip modes does. Add Vertex asks \"** ADD VERTEX
        **\" and \"Specify new vertex point or [Base point/Copy/Undo/eXit]:\", the polyline drawn with the vertex
        at the cursor, and puts the vertex after the grip's vertex (with Copy on it asks again, each vertex after
        the last, until eXit or Enter; Undo takes the last one back). Convert to Arc asks \"** CONVERT TO ARC
        **\" and \"Specify midpoint of arc segment:\" and makes the segment the arc through the point; Convert to
        Line asks \"** CONVERT TO LINE **\" and \"Pick to convert to line segment:\" and makes the segment
        straight at a pick. Remove Vertex asks \"** REMOVE VERTEX **\" and \"Pick to remove vertex:\" (\"**
        REMOVE FIT POINT **\" and \"Pick to remove fit point:\" for a spline's fit point) and takes the vertex
        out at a pick. A line's or an arc's end offers Lengthen (\"** LENGTHEN **\", \"Specify end point:\"), the
        middle of an arc Radius (\"** RADIUS **\", \"Specify radius:\"), a hatch Hatch Scale, Hatch Angle and
        Origin Point, a spline's point its own Add Vertex (\"** ADD FIT POINT **\" or \"** ADD CONTROL VERTEX
        **\"). Lengthen and Radius also have Copy and Undo. A linear dimension's grips offer Continue Dimension
        and Baseline Dimension (the row DIMCONTINUE or DIMBASELINE makes), its arrowheads Flip Arrow (\"** FLIP
        ARROW**\", \"Pick to flip arrowhead:\"), the grip of its words Move Text Only, Move with Leader, Move
        with Dim Line, Above Dim Line, Center Vertically and Reset Text Position. Every item is one undo step,
        and Esc at a prompt changes nothing."""
    def StartGripEdit(
        self,
        hotGrips: System.Collections.Generic.IEnumerable[System.Collections.Generic.KeyValuePair[str, int]],
    ) -> bool:
        """Starts a grip edit, as a click on a grip starts AutoCAD's with no command running: the grips given are
        hot, the first the one clicked, and the command line asks \"** STRETCH **\" and \"Specify stretch point
        or [Base point/Copy/Undo/eXit]:\". Enter or Space goes on to MOVE, ROTATE, SCALE and MIRROR and back to
        STRETCH; STRETCH, MOVE, ROTATE, SCALE and MIRROR, or ST, MO, RO, SC and MI, typed go to that mode.
        STRETCH moves the hot grips together by the way from the base point, the first hot grip until Base point
        gives another; the other modes move, turn, scale or mirror the objects selected. Copy leaves the
        originals and asks again until eXit, Enter or Esc, as does a first point picked with Ctrl held
        (CadCommandSession.Feed). The whole grip edit is one undo step; the command run last stays the one Enter
        runs again."""
    def StartPointModifier(self, typed: str) -> bool:
        """Starts a point modifier at a prompt that takes a point, as AutoCAD's: FROM (or FRO) asks \"Base point:\"
        then \"<Offset>:\" and gives the offset point, an offset typed as @dx,dy or @distance<angle being
        measured from the base point; M2P or MTP asks \"First point of mid:\" and \"Second point of mid:\" and
        gives the point midway; TT asks \"Specify temporary OTRACK point:\" and asks the first prompt again with
        tracking lines from the point (CadCommandSession.TemporaryTrackPoints); TK (TRACK, TRACKING) asks \"First
        tracking point:\" then \"Next point (Press ENTER to end tracking):\" until Enter, each point taken square
        from the one before along the axis it lies farther along, upright where it lies as far along both (a
        distance typed going along the axis nearest the cursor), and gives the last; .X, .Y, .Z, .XY, .XZ or .YZ
        asks \"of\" a point whose coordinates named are kept, then \"(need YZ):\" for the rest, a point whose
        coordinates asked are taken, or where one is asked a number alone. Coordinates are those of the
        CadCommandSession.Ucs, and Z, which a plan has none of, is asked as AutoCAD asks it and left out. A
        modifier typed at a modifier's prompt nests in it, as FROM with M2P for its base point, and each point
        may be snapped; AutoCAD 2021 takes TT and TK only at the command's own prompt or inside M2P, inside TT
        and TK only M2P, and M2P not inside M2P; one it does not take is text that is no point, refused as that
        is, as the window's menu says it too. What is no point AutoCAD's way too: Enter or text at TT's or a
        filter's prompt, and Enter at FROM's, is answered by the prompt they were typed at, as text and never as
        a modifier; FROM and M2P ask again for text, M2P for Enter too; TK says \"Invalid 2D point.\", at its
        first prompt going back to the prompt it was typed at. A leading underscore is allowed, as the menu sends
        \"_from\". At \"Select objects:\", at a prompt for one object, and at the corner of a window or the point
        of a fence, AutoCAD 2021 takes them all the same: the point a modifier gives there picks as a click does,
        \"Select objects: _from\", \"Base point: 0,-10\", \"<Offset>: @50,10\" then \"1 found\", or, lying on no
        object, is the first corner of the window, \"Specify opposite corner:\"; TT gives nothing and \"Select
        objects:\" is asked again; text no modifier takes is refused as that prompt refuses it, \"*Invalid
        selection*\" and the options listed. A line of 100,50 FROM with the offset @30,20 starts at (130, 70);
        M2P between (0, 0) and (100, 40) gives (50, 20); TK from (100, 0) to (130, 50) gives (100, 50); .X of
        (30, 999) with (888, 40) at \"(need YZ):\" gives (30, 40), and with 40,3 gives (30, 3)."""
    def StartTool(self, tool: CadTool, at: GeoPoint2 | None = ...) -> bool:
        """Runs a tool of a tool palette, as clicking it does in AutoCAD. A command tool starts the command of its
        line, with the answers the line gives to its first prompts fed in; a hatch tool starts HATCH with the
        tool's pattern, angle and scale; a block tool starts INSERT with its block, scale and rotation, asking
        the insertion point on the command line (and the scale and rotation, where the tool prompts for them).
        The tool's layer, colour, linetype and lineweight are the current ones while the command runs, and the
        drawing's are put back when it ends or is cancelled. A command running is ended first, as Esc would."""
    def StartWindow(self, corner: GeoPoint2) -> bool:
        """Starts the implied window, as a click on nothing at the Command prompt starts AutoCAD's: the command line
        asks \"Specify opposite corner or [Fence/WPolygon/CPolygon]:\", a point given as a click or typed ends
        the box, left to right a window and right to left a crossing, and the objects it takes are selected. F,
        WP or CP turns the box into a fence or a polygon whose first point is the corner, asking \"Specify next
        fence point or [Undo]:\" or \"Specify endpoint of line or [Undo]:\" until Enter. A box from (0, 0) with
        the opposite corner typed 110,110 selects the lines wholly inside it. The history keeps the prompt after
        \"Command:\", as AutoCAD's does, and Esc ends it with \"*Cancel*\". The command run last stays the one
        Enter runs again.

        At a command's \"Select objects:\" (or \"Remove objects:\") the same window is asked inside the command,
        as AutoCAD asks it there: the history keeps \"Select objects: Specify opposite corner or
        [Fence/WPolygon/CPolygon]: 110,60\", what the box, fence or polygon takes is gathered for the command (or
        taken out), and \"Select objects:\" is asked again. ERASE with a box from (-10, -10) to (110, 60) over
        two lines of 100 and 50 gathers both, \"2 found\". Esc there cancels the command."""
    def TogglePickStyle(self) -> None:
        """Ctrl+Shift+A: switches the picking of groups whole (CadDocument.PickStyle) off where it is on and on
        where it is off, writing \"<Group off>\" or \"<Group on>\" as AutoCAD does; a command running goes on."""
    def ToggleSelectionCycling(self) -> None:
        """Switches selection cycling (CadDocument.SelectionCycling) off, or on again as 2, writing \"<Selection
        Cycling off>\" or \"<Selection Cycling on>\" as AutoCAD does."""
    def Write(self, line: str) -> None:
        """Writes a line into the history."""

class CadConstraintBar(System.Object):
    """The constraint bar of one object or polyline segment: the icons of the geometric constraints on it, and where
    the object's middle lies in the drawing, the bar standing near it."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the object."""
    @property
    def Icons(self) -> System.Collections.Generic.IReadOnlyList[CadConstraintIcon]:
        """Gets the icons, in the order the constraints were made."""
    @property
    def X(self) -> float:
        """Gets the x of the place the bar stands by, in the drawing."""
    @property
    def Y(self) -> float:
        """Gets the y of the place the bar stands by, in the drawing."""

class CadConstraintBars(System.Object):
    """The constraint bars of a document, as AutoCAD 2021 shows them: for each constrained object a bar of small
    icons, the bars of the objects selected and those of the objects a constraint was just made on shown
    (CONSTRAINTBARDISPLAY), any object's bar hidden or shown for good by CONSTRAINTBAR. What is hidden is kept
    with the document for the session, not in the file, as AutoCAD keeps it."""
    @property
    def Changed(self) -> System.EventHandler[System.EventArgs]:
        """Raised when what the bars show changes without the drawing changing: a bar shown or hidden, a constraint
        just made."""
    @Changed.setter
    def Changed(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    def BarsFor(
        self,
        space: CadSpace,
        selected: System.Collections.Generic.IReadOnlyCollection[str],
        settings: CadConstraintSettings,
    ) -> System.Collections.Generic.IReadOnlyList[CadConstraintBar]:
        """The bars of a space to draw now: those of every object whose bar is shown for good, of the objects
        selected where the settings show the bars of the selection, and of the objects a constraint was just made
        on where they show those; an object hidden has none. The icons are those of the types the settings show."""
    def Delete(self, space: CadSpace, index: int) -> CadEditResult:
        """Takes one constraint away, as an icon of a bar is deleted; one undo step."""
    def EndCommand(self) -> None:
        """Forgets the objects constraints were just made on: the bars of those not selected go."""
    def HideAll(self, space: CadSpace) -> None:
        """Hides the bars of every constrained object of a space for good (the ribbon's Hide All)."""
    def HideBars(self, handles: System.Collections.Generic.IEnumerable[str]) -> None:
        """Hides the bars of objects, selected or not, as CONSTRAINTBAR's Hide."""
    def IsHidden(self, handle: str) -> bool:
        """Whether the bar of an object is hidden for good."""
    def ResetBars(self, handles: System.Collections.Generic.IEnumerable[str]) -> None:
        """Puts the bars of objects back as they were before they were shown or hidden, as CONSTRAINTBAR's Reset."""
    def ShowAll(self, space: CadSpace) -> None:
        """Shows the bars of every constrained object of a space for good (the ribbon's Show All)."""
    def ShowBars(self, handles: System.Collections.Generic.IEnumerable[str]) -> None:
        """Shows the bars of objects, selected or not, as CONSTRAINTBAR's Show."""

class CadConstraintIcon(System.Object):
    """One icon of a constraint bar: a geometric constraint on the object, and where it stands in the space's
    constraints."""
    @property
    def Index(self) -> int:
        """Gets the place of the constraint in the space's geometric constraints, which CadConstraintBars.Delete
        takes."""
    @property
    def Label(self) -> str:
        """Gets the name AutoCAD gives the constraint: Horizontal, Parallel."""
    @property
    def Type(self) -> CadConstraintType:
        """Gets the type of the constraint, which picks its glyph."""

class CadConstraintSettings(System.Object):
    """The settings of AutoCAD 2021's Constraint Settings dialog and of the variables behind them
    (CONSTRAINTBARMODE, CONSTRAINTBARDISPLAY, CONSTRAINTINFER, CONSTRAINTNAMEFORMAT, CCONSTRAINTFORM,
    DYNCONSTRAINTMODE, CONSTRAINTSOLVEMODE, PARAMETERCOPYMODE), and the tolerances and the order AUTOCONSTRAIN
    works by. They stay with the session."""
    def __init__(self) -> None: ...
    @property
    def AutoAngle(self) -> float:
        """The angle within which AUTOCONSTRAIN takes two directions for one, in degrees."""
    @AutoAngle.setter
    def AutoAngle(self, value: float) -> None: ...
    @property
    def AutoDistance(self) -> float:
        """The distance within which AUTOCONSTRAIN takes two points for one, in drawing units."""
    @AutoDistance.setter
    def AutoDistance(self, value: float) -> None: ...
    @property
    def AutoRules(self) -> System.Collections.Generic.List[CadAutoConstrainRule]:
        """The types AUTOCONSTRAIN tries and the order it tries them in."""
    @AutoRules.setter
    def AutoRules(self, value: System.Collections.Generic.List[CadAutoConstrainRule]) -> None: ...
    @property
    def BarDisplay(self) -> int:
        """CONSTRAINTBARDISPLAY: 0 shows no constraint bar, 1 shows the bars of the objects that are selected, 2
        those of the objects a constraint was just applied to, 3 both. AutoCAD 2021 starts at 3."""
    @BarDisplay.setter
    def BarDisplay(self, value: int) -> None: ...
    @property
    def BarMode(self) -> int:
        """The constraint types a bar shows, as the bits of CONSTRAINTBARMODE (4095 for all twelve)."""
    @BarMode.setter
    def BarMode(self, value: int) -> None: ...
    @property
    def CopyMode(self) -> int:
        """PARAMETERCOPYMODE: what a copy of constrained objects keeps; kept as AutoCAD keeps it."""
    @CopyMode.setter
    def CopyMode(self, value: int) -> None: ...
    @property
    def DynamicMode(self) -> int:
        """DYNCONSTRAINTMODE: whether dynamic dimensional constraints are shown (1) or hidden (0)."""
    @DynamicMode.setter
    def DynamicMode(self, value: int) -> None: ...
    @property
    def Form(self) -> int:
        """CCONSTRAINTFORM: the form a new dimensional constraint is made in: 0 dynamic, 1 annotational."""
    @Form.setter
    def Form(self, value: int) -> None: ...
    @property
    def Infer(self) -> bool:
        """CONSTRAINTINFER: whether a coincident, horizontal or vertical constraint is inferred where a line or arc
        is drawn."""
    @Infer.setter
    def Infer(self, value: bool) -> None: ...
