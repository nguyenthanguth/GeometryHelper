class CadViewportClips(System.Object):
    """Viewports clipped by an entity (VPCLIP): the outline a clipped viewport shows through, the entity and the
    viewport taken together when either is picked, and the viewport's frame fitted again when its entity is
    edited, as AutoCAD 2021 keeps them."""
    @staticmethod
    def OutlineOf(viewport: DxfViewport) -> DisplayClip2:
        """Gets the outline a clipped viewport shows model space through: its clip boundary
        (DxfViewport.NonRectClipEntity) as a ring of paper units, a circle or the arcs of a polyline kept as
        arcs. Null for a viewport that is not clipped, and for one whose boundary has no outline the library
        reads, which is shown as the rectangle of its frame. A region gives a ring for each loop of each face, in
        the outline's DisplayClip2.Others."""
    @staticmethod
    def WhyNotClip(viewport: DxfViewport, candidate: DxfEntity) -> str:
        """Says why an entity cannot clip a viewport, in the words of AutoCAD 2021's VPCLIP: \"Clip object must be
        closed.\" for one that is not a closed circle, ellipse, polyline or spline or a region, \"Invalid: Clip
        entity not currently regen'ed.\" for a viewport or an entity of another layout; null where
        DxfViewport.ClipTo takes it."""
    @staticmethod
    def WhyNotMakeViewport(candidate: DxfEntity, space: CadSpace) -> tuple[str, GeoAabb3]:
        """Says why an entity cannot become a viewport by MVIEW's Object option, in the words of AutoCAD 2021:
        \"Clip object must be closed.\" for a polyline, spline, ellipse or region that is not closed or has no
        area, \"Invalid viewport clip object.\" for any other entity; null where it can, with the box of it, the
        frame the new viewport takes."""
    @staticmethod
    def WithPartners(
        document: CadDocument,
        handles: System.Collections.Generic.IEnumerable[str],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the handles given with, for each viewport clipped by an entity among them, that entity, and for each
        entity that clips a viewport among them, that viewport, as AutoCAD takes the two for one object when
        either is picked (\"2 found\"): those given, then the partners in ordinal order of their handles, each
        once."""
    @staticmethod
    def WithoutPartners(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyList[str],
