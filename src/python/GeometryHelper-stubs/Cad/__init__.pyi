    @property
    def SupportFolders(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets or sets the user's own folders the drawing's linetype files (.lin) and hatch pattern files (.pat)
        are looked for in, in order, before the Linetypes and Hatches folders beside the dll: none until set; the
        window sets Global settings' Support file search folders, empty by default. Blank entries are left out
        and a folder given twice is kept once."""
    @SupportFolders.setter
    def SupportFolders(self, value: System.Collections.Generic.IReadOnlyList[str]) -> None: ...
    @property
    def TemplateDescription(self) -> str:
        """Gets the description of the template the drawing was last saved as by CadDocument.SaveAsTemplate, written
        again when it is saved to a file ending in .dwt; empty where it was not."""
    @property
    def TiledViewports(self) -> CadTiledViewports:
        """Gets the tiled viewports of model space, read from the drawing's VPORT table when first asked for, as
        CadTiledViewports says: one, the whole drawing area, until VPORTS splits it."""
    @property
    def Title(self) -> str:
        """Gets the name of the file without its folder, or \"Drawing\" where it has none."""
    @property
    def Ucs(self) -> CadUcsManager:
        """Gets the user coordinate systems of the drawing, read from it when first asked for, as CadUcsManager
        says: the current one of each space, the earlier ones and the named ones. A change to them is not a step
        of undo, and is written into the drawing when it is saved."""
    @property
    def WorkingSpace(self) -> CadSpace:
        """Gets the space edits go into: model space while a viewport is worked through
        (CadDocument.ActiveViewport), else the space shown (CadDocument.CurrentSpace). A line drawn in a viewport
        of Layout1 goes into model space."""
    @property
    def XFadeControl(self) -> int:
        """Gets or sets XFADECTL, as AutoCAD's: how far the objects outside the working set are faded while a
        reference is edited in place, from 0 to 90 per cent, 70 as AutoCAD 2021 gives it. Kept by the presenter,
        not in the drawing, as AutoCAD keeps it in the registry."""
    @XFadeControl.setter
    def XFadeControl(self, value: int) -> None: ...
    @property
    def Xrefs(self) -> CadXrefManager:
        """Gets the external references and images of the drawing as the presenter shows them: the files found, the
        drawings read and what was unloaded (CadXrefManager). It outlives an undo, which reads the drawing anew,
        so a drawing referenced is read once."""
    @property
    def ActiveViewportChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when model space is entered through a viewport, another viewport is made the one worked through,
        or the paper is worked on again."""
    @ActiveViewportChanged.setter
    def ActiveViewportChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    @property
    def BlockEditorChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when the Block Editor opens, closes, or turns to another block (Save Block As)."""
    @BlockEditorChanged.setter
    def BlockEditorChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    @property
    def Changed(self) -> System.EventHandler[CadDocumentChangedEventArgs]:
        """Raised after the drawing changed: an edit applied, a step undone or redone, a regen, a save."""
    @Changed.setter
    def Changed(self, value: System.EventHandler[CadDocumentChangedEventArgs]) -> None: ...
    @property
    def FontMissing(self) -> System.EventHandler[CadFontMissingEventArgs]:
        """Raised the first time a font a text style names is not found and is replaced, as the spaces are drawn.
        The first time for the fonts set, it says in one line every SHX font and big font the drawing's text
        styles name that is not found, and what each is drawn in, as AutoCAD lists its missing SHX files on
        opening a drawing (CadDocument.FindMissingFonts); a font not in that line is said once on its own when it
        is met."""
    @FontMissing.setter
    def FontMissing(self, value: System.EventHandler[CadFontMissingEventArgs]) -> None: ...
    @property
    def LayerFilterChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when the chosen layer filter, its inversion or the use of it for the layer box changes."""
    @LayerFilterChanged.setter
    def LayerFilterChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    @property
    def RefEditChanged(self) -> System.EventHandler[System.EventArgs]:
        """Raised when an in-place edit opens or closes."""
    @RefEditChanged.setter
    def RefEditChanged(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    def AddToRefEdit(self, handles: System.Collections.Generic.IReadOnlyList[str]) -> CadEditResult:
        """Adds objects of the drawing to the working set, as REFSET Add: they are written into the block when the
        edit is saved, and the objects of the block that were taken out of the set
        (CadDocument.RemoveFromRefEdit) go back into it. Objects that are in the set already, are not in the
        space the reference stands in, or are the reference itself are left out. One undo step."""
    def ApplyEdit(
        self,
        name: str,
        planned: System.Collections.Generic.IReadOnlyList[CadEditRecord],
        apply: System.Action[CadEditScope],
    ) -> CadEditResult:
        """Applies one edit: the one way the presenter changes the drawing. The gate (CadDocument.EditGate) is asked
        about every planned change of an existing entity first, and one refusal refuses the whole edit with
        nothing written. Then apply writes the change; if it throws, the drawing is read back as it stood before
        and the edit fails with the exception's message. A made edit is one undo step, or part of the open
        group's (CadDocument.BeginGroup); the display lists and pick indexes of the spaces it touched are
        dropped, and CadDocument.Changed is raised."""
    def ApplySetting(
        self,
        name: str,
        property: str,
        read: System.Func[str],
        change: System.Action[()],
        replay: System.Action[CadDocument, bool],
        joinsPrevious: bool,
    ) -> CadEditResult:
        """Changes a setting kept in the drawing, one undo step, as AutoCAD 2021 records GRID, SNAP, SETVAR and a
        snap or grid variable typed alone: the step puts the setting back by what replay writes, keeps no copy of
        the drawing, and undoing or redoing it reads the drawing again no more than a zoom does. Inside a
        command's group (CadDocument.BeginGroup) the change joins the command's step instead. A change that
        leaves read giving the text it gave before makes no step."""
    def BeginGroup(self, name: str) -> None:
        """Opens a group of edits that becomes one undo step when it is closed, as a command that draws line after
        line is one step. Groups nest; the outermost names the step. An edit of the group that fails takes the
        whole group back."""
    def BeginLayerSet(self) -> None:
        """Opens a set of layer changes that LAYERP takes back together, as the Layer manager does for the length of
        its dialog: the changes made until CadDocument.EndLayerSet are one set, each still its own undo step.
        Sets nest; the outermost counts."""
    def CancelGroup(self) -> None:
        """Closes every open group and takes its edits back, the drawing read back as it stood before the group
        began, as a command that fails part way changes nothing."""
    def CloseBlockEditor(self, save: bool) -> CadEditResult:
        """Closes the Block Editor, as BCLOSE: the block saved first (CadDocument.SaveBlock) where asked, else read
        back as it was opened or last saved (a new block never saved not made at all); the space shown before
        BEDIT shown again."""
    def CloseRefEdit(self, save: bool) -> CadEditResult:
        """Closes the in-place edit, as REFCLOSE: saved, each object of the working set written into the block as a
        new object put through the reference's transformation the other way and the object it came from erased
        (an object erased in the drawing leaves the block, one taken out of the set leaves it too), every
        reference of the block drawn anew; or discarded, the copies erased and the block as it was. The objects
        drawn in the drawing that were never added stay in it. The session's steps become one, \"REFEDIT\", which
        one undo takes back."""
    def EndGroup(self) -> None:
        """Closes the group CadDocument.BeginGroup opened; the outermost makes its edits one undo step, if it made
        any."""
    def EndLayerSet(self) -> None:
        """Closes the set CadDocument.BeginLayerSet opened; the outermost keeps what it changed, if it changed any
        layer's settings."""
    def EnterViewport(self, handle: str) -> bool:
        """Works in model space through a viewport of the layout shown, as a double click inside it does in AutoCAD:
        the selection is let go, and CadDocument.ActiveViewportChanged raised where it was not already the one."""
    def FindEntity(self, handle: str) -> DxfEntity:
        """Gets the entity with a handle, or null."""
    def FindMissingFonts(self) -> System.Collections.Generic.IReadOnlyList[CadMissingFont]:
        """Gets the SHX fonts and big fonts the drawing's text styles name that CadDocument.Fonts does not find,
        each with what it is drawn in, in the order of their names: the list AutoCAD shows as Missing SHX files.
        A style of a TrueType font is left out, as AutoCAD leaves it out. Each can be given a font of its own by
        CadFonts.WithSubstitution, or left to the replacement font."""
    def FindMissingTrueTypeFonts(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the TrueType families and files the drawing names that CadDocument.Fonts does not find: those of its
        text styles and those its MTEXTs switch to with a font code (\\fGulim|b0|i0|c129|p50;), which
        CadDocument.FindMissingFonts leaves out. Each is drawn in the canvas's drawing font, the letters it lacks
        in another font the machine has. A name is listed once whatever its case, and the list is in the order of
        the names."""
    def FindRefEditLevels(
        self,
        handle: str,
        at: GeoPoint2 | None,
        aperture: float,
    ) -> System.Collections.Generic.IReadOnlyList[CadRefEditLevel]:
        """The references a point on a reference of the drawing can mean, the outermost first: the reference itself,
        then each reference nested in its block whose objects reach the point, and each nested in those, as the
        Reference Edit dialog lists them. A reference with nothing nested at the point gives its own level alone."""
    def FindRefEditObject(
        self,
        chain: System.Collections.Generic.IReadOnlyList[str],
        at: GeoPoint2,
        aperture: float,
    ) -> str:
        """The object of the block a reference chain edits that a point reaches: the one whose box, put where the
        reference draws it, holds the point within the aperture, the smallest where several do, the first of the
        block on a tie; null for none. This is how REFEDIT's \"Prompt to select nested objects\" takes an object,
        as the block's objects are not picked in the drawing."""
    def FindSpace(self, handle: str) -> CadSpace:
        """Gets the space an entity of a handle is in, or null where no space holds it."""
    @staticmethod
    def From(database: DxfDatabase, name: str = ...) -> CadDocument:
        """Shows a database already in memory. One that writes no handles, as a drawing of R12 written by hand, is
        shown as a copy read anew with a handle for each entity, as AutoCAD gives them on opening it;
        CadDocument.Database is then that copy."""
    def GetDisplay(self, space: CadSpace) -> DisplayList2:
        """Gets the display list of a space, made on the first call and kept. After an edit, an undo or a redo the
        list is made again from the one before: the entities the edit's records name, and those that read a layer
        it switched or recoloured, are drawn anew and every other entity keeps its items, so that moving one line
        of a drawing of a million entities draws one line, not a million. The list is the one a REGEN would make,
        item for item; an edit of a table, a block or a setting that redraws everything (LTSCALE, PDMODE) still
        draws every entity of the spaces it touched."""
    def GetPickIndex(self, space: CadSpace) -> PickIndex:
        """Gets the index that picks in a space, made on the first call and kept. Its picks put the entity drawn on
        top first among those at about the same distance while the drawing's SORTENTS holds its bit 1, read at
        each call (PickIndex.Pick)."""
    def GripDrag(self, handle: str, gripIndex: int, newPoint: GeoPoint2) -> CadEditResult:
        """Drags a grip of an entity to a point, one undo step, as CadGrips.Drag says."""
    def KeepLayerFilter(self) -> CadEditResult:
        """Writes the filter the Layer manager has chosen into the drawing as the current one (group 290), one undo
        step, unless the drawing marks it already. A filter AutoCAD makes is not written: All marks none."""
    def LeaveViewport(self) -> None:
        """Works on the paper of the layout shown again, as PSPACE: the selection let go; nothing where no viewport
        is worked through."""
    def NextViewport(self) -> bool:
        """Works through the next viewport of the layout shown, in the order of CadDocument.EnterableViewports, the
        first after the last, as Ctrl+R does in AutoCAD."""
    @overload
    @staticmethod
    def Open(path: str) -> CadDocument:
        """Opens a DWG or DXF file: a DWG of AutoCAD 2000 to 2018 read by DwgReader, as CadDrawingFile.Open reads
        it, so that CadDocument.Save writes it back as a DWG of AutoCAD 2018. A DXF whose header leaves out
        MEASUREMENT, the dimension variables, DIMSTYLE or CELTYPE reads them as AutoCAD does (MEASUREMENT 0, the
        dimension style Standard with DIMASZ 0.18, CELTYPE Continuous), and writes them into its header; a
        drawing made by CadDocument.From keeps the library's own."""
    @overload
    @staticmethod
    def Open(stream: System.IO.Stream, name: str = ...) -> CadDocument:
        """Opens a DXF from a stream, reading the header values it leaves out as CadDocument.Open does."""
    @overload
    @staticmethod
    def Open(path: str, progress: System.IProgress[float]) -> CadDocument:
        """Opens a DWG or DXF file as CadDocument.Open does, telling how far the reading has got as
        CadDrawingFile.Open tells it: a share from 0 to 1, never going back, 1 once read. A CadProgressMeter is
        such a progress."""
    @overload
    @staticmethod
    def Open(
        path: str,
        progress: System.IProgress[float],
        cancellationToken: System.Threading.CancellationToken,
    ) -> CadDocument:
        """Opens a DWG or DXF file as CadDocument.Open does, giving it up when a token says so: the window opens a
        drawing on a worker thread that Esc and Stop stop. A DXF is looked at every 4 096 records as its text is
        walked, its handles scanned and its entities of model space listed (the listing the first display would
        otherwise make, 0.3 s at 1 000 000 entities), so that a file of that size, 77 MB, is given up within a
        few milliseconds of the stop and not at the end of its reading, which took 0.5 s; a DWG is looked at
        before each page of it is unpacked, before each object is read and before each entity and object is
        written as DXF, and then every 4 096 records as that DXF is walked, so that one of 300 000 entities,
        whose reading takes 1.6 s, is given up within a few milliseconds as well."""
    def OpenBlockEditor(self, name: str) -> CadEditResult:
        """Opens the Block Editor on a block, as BEDIT: the block shown alone in a space of its own, made the
        current space; a name the drawing has no block of makes a new, empty block, its origin at (0, 0);
        <Current Drawing> opens model space itself. The selection is let go."""
    def OpenRefEdit(
        self,
        chain: System.Collections.Generic.IReadOnlyList[str],
        objects: System.Collections.Generic.IReadOnlyList[str],
    ) -> CadEditResult:
        """Opens the in-place edit of a reference, as REFEDIT: the objects of its block copied into the drawing
        where the reference draws them, the working set. One undo step while the session lasts. The objects the
        reference's placing cannot hold (a circle under a scale unlike along its axes) are left in the block."""
    def PrepareDisplay(
        self,
        space: CadSpace,
        progress: System.IProgress[float],
        cancellationToken: System.Threading.CancellationToken,
    ) -> None:
        """Makes the display list and the pick index of a space now, as the first CadDocument.GetDisplay and
        CadDocument.GetPickIndex make them, saying how far it has got and stopping when asked: the window does it
        on a worker thread for a drawing it opens, so that a drawing of 1 000 000 entities, 7 s to draw, does not
        hold the window. The list is the one CadDocument.GetDisplay makes, item for item. A document is not safe
        to use from two threads at once: nothing else may use it, nor another document's fonts be set, until this
        returns."""
    def RecordSpaceView(
        self,
        space: CadSpace,
        view: CadView,
        before: DisplayBox,
        name: str,
        realTime: bool,
    ) -> CadEditResult:
        """Records that the view of a space has been zoomed or panned: one undo step, which puts the view back as it
        was before (U) or as it is now (REDO) with the drawing left alone, and an entry of the space's ZOOM
        Previous list, 20 at most. The wheel and the middle button of the canvas call it once their gesture is
        done; ZOOM, PAN and PLAN call it too. A zoom or a pan of the wheel or the middle button made straight
        after another joins its step, as AutoCAD 2021 combines consecutive real-time zooms and pans; typed ones
        stay a step each. A step is named ZOOM or PAN."""
    def Redo(self) -> bool:
        """Redoes the step undone last."""
    def RefEditLockedHandles(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """The handles of the objects the canvas fades while an edit is open, in ordinal order: those the lock holds
        (the ones in the spaces that are not in the working set and were there before the session). Empty where
        no edit is open or the lock is off."""
    def Regen(self) -> None:
        """Drops every display list and pick index, so that each space is drawn again from the drawing, as REGEN
        does."""
    def RemoveFromRefEdit(self, handles: System.Collections.Generic.IReadOnlyList[str]) -> CadEditResult:
        """Takes objects out of the working set, as REFSET Remove: they stay in the drawing as its own objects, and
        the objects of the block they came from leave the block when the edit is saved, and come back to it if
        the edit is discarded; an object added to the set from the drawing is simply the drawing's again. Objects
        not in the set are left out. One undo step."""
    def Save(self) -> None:
        """Saves the drawing to the file it was opened from or last saved as."""
    @overload
    def SaveAs(self, path: str) -> None:
        """Saves the drawing to a file, which it is then known by: a DWG where its name ends in .dwg, of the version
        the drawing was last saved as (CadDocument.SaveVersion) where the DWG writer writes it, else of AutoCAD
        2018, what the DWG writer does not write yet left out and said in CadDocument.LeftOutOfDwg; else a DXF,
        in the version the drawing was last saved as, its own where it was not."""
    @overload
    def SaveAs(self, path: str, progress: System.IProgress[float]) -> None:
        """Saves the drawing to a file as CadDocument.SaveAs does, telling how far the writing has got as a share
        from 0 to 1: in thousandths, never going back, 0 first and 1 at the end. A DWG tells it some 1 000 times;
        a DXF, written at once from its bytes, 0 and 1. A CadProgressMeter is such a progress."""
    @overload
    def SaveAs(self, path: str, version: str, progress: System.IProgress[float]) -> None:
        """Saves the drawing to a file in a version of AutoCAD, as AutoCAD 2021's Save Drawing As does with the type
        chosen: a DWG of R2000 (AC1015), R2004 (AC1018), R2007 (AC1021), R2010 (AC1024), R2013 (AC1027) or R2018
        (AC1032) where the name ends in .dwg, as DwgWriter writes it; else a DXF of R12 (AC1009), R2000 (AC1015),
        R2004 (AC1018), R2007 (AC1021), R2010 (AC1024), R2013 (AC1027) or R2018 (AC1032), as DxfDatabase.Save
        writes it; the version is kept in CadDocument.SaveVersion, so that CadDocument.Save writes it again, as
        AutoCAD's QSAVE keeps the format of the last Save As. What a DXF of the version could not hold is said in
        CadDocument.LeftOutOfDxf, and what a DWG of it does not write yet in CadDocument.LeftOutOfDwg."""
    def SaveAsTemplate(self, path: str, description: str, metric: bool, progress: System.IProgress[float]) -> None:
        """Saves the drawing as a drawing template, as AutoCAD 2021's Save Drawing As does with the type AutoCAD
        Drawing Template (*.dwt) and its Template Options: a DWG of AutoCAD 2018 with the extension .dwt (given
        where the name ends otherwise), the description kept in the file's template section and MEASUREMENT set
        as chosen. The drawing is then known by the template's file, as AutoCAD's is, and CadDocument.Save writes
        it again with the same description."""
    def SaveBlock(self) -> CadEditResult:
        """Saves the block open in the Block Editor, as BSAVE: its edits made final, every INSERT of it drawn anew
        (their attributes are not synchronised, as AutoCAD's ATTSYNC is not run), the anonymous *U blocks the
        INSERTs of a dynamic block place worked out anew from it at their values, as AutoCAD's
        UpdateAnonymousBlocks works them, and the steps of the session so far one undo step, \"BEDIT\". Undo
        inside the editor then stops here. For <Current Drawing> model space keeps its edits."""
    def SaveBlockAs(self, name: str) -> CadEditResult:
        """Saves the content of the Block Editor as a new block, as BSAVEAS: the block opened is read back as it was
        opened or last saved, the new one holds the content as it is now with the base point, unit, description
        and flags of the block opened, and the editor goes on with the new block. The session stays one undo
        step."""
    def SaveCopy(self, path: str, version: str) -> System.Collections.Generic.IReadOnlyList[str]:
        """Writes a copy of the drawing as a DXF of a version, as AutoCAD's DXFOUT does: the drawing keeps its file,
        its CadDocument.SaveVersion and whether it has changes not saved, and the copy is not the file it is
        known by."""
    def SetBlockEditorVisibilityState(self, state: str) -> CadEditResult:
        """Shows another visibility state of the block open in the Block Editor, as AutoCAD's Visibility State box:
        the entities the state hides are no longer drawn or picked, those it shows and those no state lists are.
        A view of the block, not an edit of it: nothing is written and no undo step made."""
    @overload
    def SetViewportView(self, handle: str, viewCenter: GeoPoint2, viewHeight: float, name: str) -> CadEditResult:
        """Sets the view a viewport shows of model space, one undo step: the point at the middle of its frame and
        the height it shows, so its scale is its height over that one. A viewport 150 high given a view 3 000
        high shows model space at 1:20. The view it showed goes on the viewport's ZOOM Previous list, 20 at most."""
    @overload
    def SetViewportView(
        self,
        handle: str,
        viewCenter: GeoPoint2,
        viewHeight: float,
        name: str,
        realTime: bool,
    ) -> CadEditResult:
        """Sets the view a viewport shows of model space, as CadDocument.SetViewportView; a real-time zoom or pan,
        the wheel's or the middle button's, made straight after another joins its undo step, as AutoCAD 2021
        combines consecutive real-time zooms and pans (UNDO Control Combine, on by default: UNDOCTL 61 has its
        16; with UNDO Control Combine No each is a step of its own). ZOOM and PAN typed stay a step each, as
        AutoCAD's console undoes ZOOM 2X, ZOOM 2X and -PAN one U each."""
    def ShowSpace(self, space: CadSpace) -> CadEditResult:
        """Shows a space, model space or a layout, as a click on its tab does: one undo step named LAYOUT, which U
        takes back to the space shown before and REDO forward, as AutoCAD 2021's console undoes LAYOUT Set
        (probed: after switching from Model to Layout1 and to Layout2, two U took it back to Layout1 and to
        Model, each layout keeping the view it had). The step keeps no copy of the drawing, so an undo of it
        reads nothing again. The selection, which belongs to a space, is cleared by the switch and by its undo.
        Inside a command's group the switch joins the command's step."""
    def ToolbarLayers(self) -> System.Collections.Generic.IReadOnlyList[CadLayerInfo]:
        """Gets the layers the layer box lists: all of them, or where CadDocument.ApplyLayerFilterToToolbar is on
        those the chosen filter lets through (the others where CadDocument.InvertLayerFilter is on) and the
        current layer; in no order."""
    def Undo(self) -> bool:
        """Undoes the last step: the drawing is read back as it stood before it (see the remarks of the class)."""
    def WithGroups(
        self,
        handles: System.Collections.Generic.IEnumerable[str],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the objects a pick takes with PICKSTYLE on: those given, then the other members of each selectable
        group any of them is in, in ordinal order of their handles. A line and a circle of the group G1 and a
        text of none: picking the line gives the line and the circle. With PICKSTYLE off, those given. Either way
        a viewport clipped by an entity is taken with it, and the entity with its viewport
        (CadViewportClips.WithPartners)."""

class CadDocumentChangedEventArgs(System.EventArgs):
    """What changed in a document: the entities touched, the spaces whose display lists were dropped, and why."""
    @property
    def Handles(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the handles of the entities touched, in ordinal order, each once."""
    @property
    def Kind(self) -> CadChangeKind:
        """Gets what made the change."""
    @property
    def Spaces(self) -> System.Collections.Generic.IReadOnlyList[CadSpace]:
        """Gets the spaces whose display list and pick index were dropped, in the order of their tabs; the canvas
        draws them again."""
    @property
    def StepName(self) -> str:
        """Gets the name of the step applied, undone or redone; null for a regen or a save."""
    @property
    def TablesChanged(self) -> bool:
        """Gets whether a table of the drawing changed, so that the layer box and the Layer manager read it
        again."""

class CadDrawingFile(System.Object):
    """The drawing files the presenter opens, attaches and inserts: a DWG, read by DwgReader, of AutoCAD 2000 to
    2018, and a DXF. A file is read as a DWG where its first bytes say so (\"AC1032\" for AutoCAD 2018), whatever
    its name; a drawing saved to a name ending in .dwg is written by DwgWriter as a DWG of AutoCAD 2018, or of
    the older version asked for (2013, 2010, 2007, 2004 or 2000), any other name as a DXF."""
    OpenFilter: ClassVar[str]
    """The filter of the file dialogs that pick a drawing, DWG first as in AutoCAD 2021's Select File: Drawing
    (*.dwg), DXF (*.dxf), All files (*.*)."""
    @staticmethod
    def IsDrawingName(path: str) -> bool:
        """Gets whether a file's name ends in .dwg or .dxf, of either case: plan.dwg and PLAN.DXF, not plan.dwt."""
    @staticmethod
    def IsDwg(path: str) -> bool:
        """Gets whether a file is a DWG: its first six bytes AC1 and three more digits, as \"AC1015\" of AutoCAD
        2000 and \"AC1032\" of AutoCAD 2018 are. A DXF, of text or binary, never starts so."""
    @overload
    @staticmethod
    def Open(path: str) -> DxfDatabase:
        """Reads a drawing file as a database: a DWG by DwgReader.Open, any other file by DxfDatabase.Open."""
    @overload
    @staticmethod
    def Open(path: str, progress: System.IProgress[float]) -> DxfDatabase:
        """Reads a drawing file as a database, as CadDrawingFile.Open does, telling how far it has got as a share
        from 0 to 1: in thousandths, never going back, 0 first and 1 once read. A DWG of 100 000 lines tells it
        some 1 000 times as its objects are read and its DXF made; a DXF, read at once from its bytes, tells 0
        and 1."""

class CadDrawingPropertiesRequest(System.Object):
    """The Drawing Properties dialog of DWGPROPS, as data its command and the window share. The Summary tab's texts
    and the custom properties are the drawing's DxfDatabase.SummaryInfo as the dialog has them, written back on
    OK as one undo step; the General tab (the file) and the Statistics tab (made, saved, edited) are shown as
    text and never written. A drawing of R2004 or later keeps the properties in its header, an older one in its
    DWGPROPS record, as AutoCAD saves them, and a DWG written by the presenter keeps them too."""
    @property
    def Action(self) -> CadDialogAction:
        """Gets or sets what the dialog was closed with; Cancel until set."""
    @Action.setter
    def Action(self, value: CadDialogAction) -> None: ...
    @property
    def Author(self) -> str:
        """Gets or sets the author (Summary tab)."""
    @Author.setter
    def Author(self, value: str) -> None: ...
    @property
    def Comments(self) -> str:
        """Gets or sets the comments (Summary tab); one line, as a group of DXF holds one."""
    @Comments.setter
    def Comments(self, value: str) -> None: ...
    @property
    def CustomProperties(self) -> System.Collections.Generic.List[System.Collections.Generic.KeyValuePair[str, str]]:
        """Gets the custom properties (Custom tab), each a name and a value in the order the drawing keeps them.
        Rows with no name and no value are left out on OK; a name two rows share, letters of either case the
        same, is refused."""
    @property
    def FileName(self) -> str:
        """Gets the name of the file without its folder, or \"Drawing\" where the drawing has none."""
    @property
    def General(self) -> System.Collections.Generic.IReadOnlyList[System.Collections.Generic.KeyValuePair[str, str]]:
        """Gets the rows of the General tab: Type, Location, Size, Created, Modified and Accessed of the file, as
        the file system gives them; Type alone where the drawing has no file yet."""
    @property
    def HyperlinkBase(self) -> str:
        """Gets or sets the base of the drawing's relative hyperlinks (Summary tab)."""
    @HyperlinkBase.setter
    def HyperlinkBase(self, value: str) -> None: ...
    @property
    def IsHidden(self) -> bool:
        """Gets whether the file is hidden (the General tab's check box, greyed); false where there is no file."""
    @property
    def IsReadOnly(self) -> bool:
        """Gets whether the file is read-only (the General tab's check box, greyed); false where there is no
        file."""
    @property
    def Keywords(self) -> str:
        """Gets or sets the keywords (Summary tab)."""
    @Keywords.setter
    def Keywords(self, value: str) -> None: ...
    @property
    def Statistics(self) -> System.Collections.Generic.IReadOnlyList[System.Collections.Generic.KeyValuePair[str, str]]:
        """Gets the rows of the Statistics tab: Created, Modified, Last saved by, Revision number and Total editing
        time, from the header ($TDCREATE, $TDUPDATE, $TDINDWG) and the properties; a date the header lacks is
        empty."""
    @property
    def Subject(self) -> str:
        """Gets or sets the subject (Summary tab)."""
    @Subject.setter
    def Subject(self, value: str) -> None: ...
    @property
    def Title(self) -> str:
        """Gets or sets the title (Summary tab)."""
    @Title.setter
    def Title(self, value: str) -> None: ...
    @property
    def WindowTitle(self) -> str:
        """Gets the title of the window: the name of the file and \"Properties\", as AutoCAD writes Plan.dwg
        Properties."""
    def TryBuild(self) -> tuple[bool, DxfDatabaseSummaryInfo, str]:
        """Makes the properties the dialog stands for: the texts and custom properties as they are now, the
        drawing's last-saved-by and revision number kept as they were."""

class CadDsdFile(System.Object):
    """A sheet list file, the .dsd (Drawing Set Description) of AutoCAD's Publish: a text file of the INI kind that
    keeps the sheets of the Publish dialog and where they go. It is read and written as plain sections, so that
    what a list holds beyond what this program knows, such as AutoCAD's [PdfOptions], comes back out as it went
    in. CadPublishList.Load and CadPublishList.Save turn it into sheets and options."""
    def __init__(self) -> None: ...
    @property
    def Sections(self) -> System.Collections.Generic.IList[CadDsdSection]:
        """Gets the sections in the order of the file."""
    def Find(self, name: str) -> CadDsdSection:
        """Finds a section by its header, letters of either case the same."""
    @staticmethod
    def Parse(text: str) -> CadDsdFile:
        """Reads the text of a sheet list. A line before the first header, and a line that is no key=value, is
        passed over; a blank line and one that begins with a semicolon are too."""
    @staticmethod
    def Read(path: str) -> CadDsdFile:
        """Reads a sheet list file."""
    def ToText(self) -> str:
        """Gets the text of the list, CRLF lines, the sections in order and a line each."""
    def Write(self, path: str) -> None:
        """Writes the list to a file, replacing a file of the name."""

class CadDsdSection(System.Object):
    """One section of a sheet list file: its header, as Target or DWF6Sheet:plan-level2-Layout1, and its key=value
    lines in order."""
    def __init__(self, name: str) -> None:
        """Makes an empty section."""
    @property
    def Name(self) -> str:
        """Gets the header between the brackets."""
    @property
    def Pairs(self) -> System.Collections.Generic.IReadOnlyList[System.Collections.Generic.KeyValuePair[str, str]]:
        """Gets the lines in the order of the file."""
    def Get(self, key: str) -> str:
        """Gets the value of a key, letters of either case the same; the last line of the key counts."""
    def Set(self, key: str, value: str) -> None:
        """Sets the value of a key where the section has it, in place, else adds the line at the end."""

class CadDynamicBlocks(System.Object):
    """Dynamic blocks in use, as AutoCAD 2021 drives them: the custom grips of a dynamic INSERT, a grip dragged or
    clicked, a property of the Custom group of Properties typed or chosen, and RESETBLOCK. Each change is one
    undo step, and the block is worked out anew by the library (DxfDynamicBlockReferenceProperty.Value) into an
    anonymous block that keeps its tie to the dynamic block, so that Properties still names it by the dynamic
    block's name. Parameters and actions are read, not added: the app drives the dynamic data a drawing holds."""
    @staticmethod
    def Choose(document: CadDocument, handle: str, gripIndex: int, value: str) -> CadEditResult:
        """Chooses a value of the list of a visibility, a lookup or a block table grip, as AutoCAD's list at the
        grip: the state shown, the lookup's row, every value it looks up set with it, or the table's row, Block
        Table1 set to its index and every column with it. One undo step."""
    @staticmethod
    def Click(document: CadDocument, handle: str, gripIndex: int) -> CadEditResult:
        """Clicks a custom grip of a dynamic INSERT, as AutoCAD does: a flip grip flips the block (its state 0 to 1,
        1 to 0), one undo step. A grip of another kind is refused: a visibility, a lookup or a block table grip
        lists its values (CadDynamicBlocks.ValuesOf), the others are dragged."""
    @staticmethod
    def ResetBlock(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
    ) -> CadEditResult:
        """Puts every dynamic property of the dynamic INSERTs among entities back to the block's own, as AutoCAD's
        RESETBLOCK: each INSERT places its dynamic block again (DxfBlockReference.ResetBlock), keeping its place,
        scale and attributes. One undo step."""
    @staticmethod
    def SetProperty(
        document: CadDocument,
        handles: System.Collections.Generic.IReadOnlyCollection[str],
        name: str,
        text: str,
    ) -> CadEditResult:
        """Sets a property of the Custom group of the dynamic INSERTs among entities, as AutoCAD's palette sets it:
        a distance typed as a number, an angle in degrees, a flip's state by its name or as 0 or 1, a visibility
        state or a lookup's label by its name, a table's row by its index, a text as typed. The value is taken to
        the parameter's value set by the library, as AutoCAD takes it: a Width of a list of 800, 900 and 1 000
        typed 870 is 900. One undo step."""
    @staticmethod
    def ValuesOf(
        document: CadDocument,
        handle: str,
        gripIndex: int,
    ) -> tuple[System.Collections.Generic.IReadOnlyList[str], str]:
        """Gets what a visibility, a lookup or a block table grip lists when clicked, as AutoCAD's list at the grip:
        the values allowed, in the parameter's order, and the one the INSERT shows, ticked; of a block table its
        rows, each its cells parted by commas, a number to 4 places, as \"100.0000, 50.0000\", the row the INSERT
        shows ticked, none where it shows none."""

class CadEdit(System.Object):
    """One edit of one entity, as the presenter hands it to the entity's owner (ICadEntityOwner.TryApply) before it
    changes anything: which entity, what kind of edit, which property, and the values before and after."""
    def __init__(
        self,
        handle: str,
        kind: CadEditKind,
        property: str = ...,
        oldValue: str = ...,
        newValue: str = ...,
    ) -> None:
        """Makes an edit of one entity."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the entity edited."""
    @property
    def Kind(self) -> CadEditKind:
        """Gets what the edit does."""
    @property
    def NewValue(self) -> str:
        """Gets the value after the edit; null where the kind has none."""
    @property
    def OldValue(self) -> str:
        """Gets the value before the edit; null where the kind has none."""
    @property
    def Property(self) -> str:
        """Gets the property changed, or the index of the grip dragged; null where the kind has none."""
    def ToString(self) -> str:
        """Gives the edit as a line for debugging."""

class CadEditGate(System.Object):
    """The edit gates the presenter brings."""
    AllowAll: ClassVar[ICadEditGate]
    """Gets the gate that lets every edit through, which a document has until another is given."""

class CadEditKind(System.Enum):
    """What an edit does to an entity, as a CadEdit tells an owner. Numbers in the values of an edit are written in
    the invariant culture, as many digits as bring them back to the bit, and separated by commas."""
    Erase: ClassVar[CadEditKind]
    """The entity erased; the property and both values are null."""
    Grip: ClassVar[CadEditKind]
    """A grip dragged: CadEdit.Property is the grip's index among the entity's grips (\"0\", \"1\", ...), the old
    value where it was, \"x,y\", and the new value where it went."""
    Mirror: ClassVar[CadEditKind]
    """The entity mirrored, as MIRROR mirrors it: the new value is the two points of the mirror line,
    \"x0,y0,x1,y1\"; the old value is null."""
    Move: ClassVar[CadEditKind]
    """The entity moved, as MOVE moves it: the new value is the displacement \"dx,dy\", \"10,-2.5\" for 10 to the
    right and 2.5 down; the old value is null."""
    Property: ClassVar[CadEditKind]
    """A property changed in Properties: CadEdit.Property is the row's label (\"Layer\", \"Color\", \"Text
    override\") and the old and new values are the texts the row shows, \"0\" and \"Steel\" for a layer."""
    Rotate: ClassVar[CadEditKind]
    """The entity turned, as ROTATE turns it: the new value is the base point and the angle in radians,
    anticlockwise, \"x,y,angle\"; the old value is null."""
    Scale: ClassVar[CadEditKind]
    """The entity scaled, as SCALE scales it: the new value is the base point and the factor, \"x,y,factor\"; the
    old value is null."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadEditRecord(System.Object):
    """One small record of an edit: which entity, what was done to it and, for a property, its value before and
    after, as text. An undo step is a list of these. They say what changed, so that the canvas draws again only
    the spaces touched and an owner of an entity can recognise an edit of its own; what the drawing was before is
    kept by the document whole (see CadDocument.Undo), so the records never need to be enough to undo an edit by
    themselves."""
    def __init__(
        self,
        kind: CadEditRecordKind,
        handle: str,
        property: str = ...,
        oldValue: str = ...,
        newValue: str = ...,
    ) -> None:
        """Makes a record."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the entity, or null for an edit of a table or a setting."""
    @property
    def Kind(self) -> CadEditRecordKind:
        """Gets what the edit does."""
    @property
    def NewValue(self) -> str:
        """Gets the value after, as text, or null."""
    @property
    def OldValue(self) -> str:
        """Gets the value before, as text, or null."""
    @property
    def Property(self) -> str:
        """Gets the name of the property set, or null."""
    @property
    def Space(self) -> str:
        """Gets the name of the space the entity is in (\"Model\", or a layout's name), filled in by the document
        when the edit is applied; null for an edit of a table or a setting, and for an entity inside a block."""
    def ToString(self) -> str: ...

class CadEditRecordKind(System.Enum):
    """What an edit does to one entity, or to the drawing's tables and settings."""
    Added: ClassVar[CadEditRecordKind]
    """An entity is made and added to a space."""
    Erased: ClassVar[CadEditRecordKind]
    """An entity is erased."""
    PropertyChanged: ClassVar[CadEditRecordKind]
    """One property of an entity is set: its layer, colour, a point, a radius, its text."""
    Reshaped: ClassVar[CadEditRecordKind]
    """An entity's shape is changed some other way, as dragging one grip of it changes it."""
    SettingChanged: ClassVar[CadEditRecordKind]
    """A setting of the drawing's header is changed, as the current layer; nothing drawn changes."""
    TableChanged: ClassVar[CadEditRecordKind]
    """A table of the drawing is changed: a layer added, switched off, frozen, locked or given a colour."""
    Transformed: ClassVar[CadEditRecordKind]
    """An entity is moved, turned, scaled or mirrored as a whole."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadEditResult(System.Object):
    """What came of an edit: whether it was made and, where it was not, why."""
    @property
    def Message(self) -> str:
        """Gets why the edit was not made, as the command line shows it; null when it was made."""
    @property
    def Records(self) -> System.Collections.Generic.IReadOnlyList[CadEditRecord]:
        """Gets the records of the edit made; empty when it was not."""
    @property
    def Refused(self) -> bool:
        """Gets whether the edit was refused before anything was written, by the edit gate or by a check of the
        edit's own."""
    @property
    def Succeeded(self) -> bool:
        """Gets whether the edit was made."""
    @staticmethod
    def Refuse(message: str) -> CadEditResult:
        """Makes the result of an edit refused before anything was written, as a check of the window refuses one, so
        that it is reported as the document's own refusals are."""
    def ToString(self) -> str: ...

class CadEditRule(System.Enum):
    """What the presenter may do to an entity, as its owner answers through ICadEntityOwner.GetEditRule: a line of a
    model drawing's view is read-only, a mark may be moved, a dimension edited through its owner."""
    Edit: ClassVar[CadEditRule]
    """Every edit goes to the owner, which takes or refuses each one: a dimension moved, its text overridden, a grip
    dragged."""
    Free: ClassVar[CadEditRule]
    """The presenter edits the entity itself and asks nobody: a line drawn by hand, everything in a plain DXF."""
    MoveOnly: ClassVar[CadEditRule]
    """The entity may be moved (CadEditKind.Move) and nothing else; the move goes to its owner, which records it, as
    a mark dragged off its part is."""
    ReadOnly: ClassVar[CadEditRule]
    """Nothing may change the entity, erasing it included: a projected line of a view is the model, changed by
    changing the view, not the line."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadEditScope(System.Object):
    """What an edit's action is given to write with: the document and the drawing, and the way to add an entity so
    that it is recorded. An entity of the drawing is changed through its own members (TransformBy, its setters,
    Erase); the edit's planned records say which."""
    @property
    def Database(self) -> DxfDatabase:
        """Gets the drawing."""
    @property
    def Document(self) -> CadDocument:
        """Gets the document."""
    def Added(self, space: CadSpace, entity: DxfEntity) -> None:
        """Records an entity a call of the library added to a space by itself, as WblockCloneObjects adds its
        copies."""
    def Append(self, space: CadSpace, entity: Any) -> Any:
        """Adds an entity made in code to a space and records it as added."""
    def IsHandled(self, handle: str) -> bool:
        """Gets whether the owner of an entity took its planned edit and made the change itself (a mark moved by the
        drawing that owns it), so that the action leaves that entity alone; false for an entity the presenter
        edits itself."""
    def Record(self, record: CadEditRecord) -> None:
        """Records a change the planned records did not name, found while writing."""

class CadExportJob(System.Object):
    """The file EXPORT, -EXPORT, EXPORTPDF or IMPORT asks the window for (CadUiRequestEventArgs.Export), or SAVEAS
