class CadTextStyleSettings(System.Object):
    """What AutoCAD's Text Style dialog sets of a style: its font (an SHX file with its big font, or a TrueType
    typeface with its file), its fixed height, its width and slant, and backwards, upside down and vertical."""
    def __init__(self) -> None: ...
    @property
    def Annotative(self) -> bool:
        """Gets or sets whether the style is annotative (the style's extended data AcadAnnotative): TEXT and MTEXT
        made in it are annotative at the annotation scale and drawn at the height their paper gives them. Only a
        drawing of AutoCAD 2007 or later can hold it; in an older one the style stays as it is."""
    @Annotative.setter
    def Annotative(self, value: bool) -> None: ...
    @property
    def Backwards(self) -> bool:
        """Gets or sets whether the texts run backwards (flag 2 of group 71)."""
    @Backwards.setter
    def Backwards(self, value: bool) -> None: ...
    @property
    def BigFontFileName(self) -> str:
        """Gets or sets the big font (group 4); empty for none."""
    @BigFontFileName.setter
    def BigFontFileName(self, value: str) -> None: ...
    @property
    def FileName(self) -> str:
        """Gets or sets the file of the font (group 3): romans.shx, arial.ttf."""
    @FileName.setter
    def FileName(self, value: str) -> None: ...
    @property
    def Font(self) -> DxfFontDescriptor:
        """Gets or sets the TrueType font, written as the style's extended data of ACAD; of no typeface for an SHX
        font."""
    @Font.setter
    def Font(self, value: DxfFontDescriptor) -> None: ...
    @property
    def Height(self) -> float:
