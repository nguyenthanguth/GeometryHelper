class CadPropertyRow(System.Object):
    """One row of the Properties panel: a label and a value, which may be read-only."""
    NoText: ClassVar[str]
    """The value of a check box that is not ticked."""
    VariesText: ClassVar[str]
    """The text of a value that differs among the selected entities."""
    YesText: ClassVar[str]
    """The value of a check box that is ticked."""
    @overload
    def __init__(self, label: str, value: str, isReadOnly: bool) -> None:
        """Makes a row."""
    @overload
    def __init__(
        self,
        label: str,
        value: str,
        isReadOnly: bool,
        choices: System.Collections.Generic.IReadOnlyList[str],
    ) -> None:
        """Makes a row whose value is one of a list, as the Justify row of an MTEXT offers Top left to Bottom
        right."""
    @overload
    def __init__(
        self,
        label: str,
        value: str,
        setter: System.Func[str, str],
        choices: System.Collections.Generic.IReadOnlyList[str] = ...,
    ) -> None:
        """Makes a row that an extension gives the Properties panel and that can be changed: typed into, or one of a
        list where choices are given. The panel calls setter with the text typed or chosen, as it does for its
        own rows, when Enter is pressed, the box is left or a choice is made."""
    @property
    def Choices(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the values the row offers, as the Text pos vert row of a dimension offers Centered, Above, Outside,
        JIS and Below; null for a row typed into."""
    @property
    def IsCheck(self) -> bool:
        """Gets whether the value is a check box, which CadPropertyRow.Value says is CadPropertyRow.YesText or
        CadPropertyRow.NoText."""
    @property
    def IsReadOnly(self) -> bool:
        """Gets whether the value cannot be edited."""
    @property
    def Kind(self) -> CadPropertyKind:
        """Gets what kind of value the row holds, which tells the window what to offer: CadPropertyKind.Text for a
        row typed into, CadPropertyKind.Choice where choices are given, CadPropertyKind.Check for a check box
        made with CadPropertyRow.Check, and the others for the rows CadPropertyRow.Number, CadPropertyRow.Length,
        CadPropertyRow.Angle, CadPropertyRow.Point, CadPropertyRow.Color, CadPropertyRow.Layer,
        CadPropertyRow.Linetype and CadPropertyRow.Lineweight make. A read-only row from CadPropertyRow.Check is
        Text."""
    @property
    def Label(self) -> str:
        """Gets the label."""
    @property
    def Setter(self) -> System.Func[str, str]:
        """Gets what changes the value of a row an extension gave, given the text typed or chosen
        (CadPropertyRow.YesText or CadPropertyRow.NoText for a check box): it returns null where the change was
        made, else the words of the refusal. Null for the rows the presenter makes, which it commits itself."""
    @property
    def Value(self) -> str:
        """Gets the value as text."""
    @property
    def Varies(self) -> bool:
        """Gets whether the selected entities differ in this property."""
    @staticmethod
    def Angle(label: str, radians: float, document: CadDocument, setter: System.Func[float, str]) -> CadPropertyRow:
        """Makes a row for an angle, written and read in the drawing's angle units, AUNITS and AUPREC: 90 degrees is
        \"90\" in decimal degrees to no places, and \"90d0'0\\\"\" in degrees, minutes and seconds. The value is
        in radians from the X axis. Text that does not read is refused with \"<label> is a number.\" and the
        setter is not called."""
    @staticmethod
    def Check(label: str, isOn: bool, setter: System.Func[str, str]) -> CadPropertyRow:
        """Makes a row that is a check box, ticked or not, that an extension gives the Properties panel: ticking it
        calls setter with CadPropertyRow.YesText, and clearing it with CadPropertyRow.NoText. Where the setter is
        null the row only shows the answer, as text."""
    @staticmethod
    def Color(label: str, color: DxfColor, setter: System.Func[DxfColor, str]) -> CadPropertyRow:
        """Makes a row for a colour, written as the palette writes one (ByLayer, ByBlock, Red to White, an index 1
        to 255, or 255,128,0) and read the same way; the window offers its list of colours with Select Color.
        Text that does not read is refused with the palette's own words and the setter is not called."""
    @staticmethod
    def Layer(label: str, layer: str, setter: System.Func[str, str]) -> CadPropertyRow:
        """Makes a row for a layer's name; the window offers the layers of the drawing. The name typed or chosen
        goes to the setter as it is, which refuses one the drawing has not."""
    @staticmethod
    def Length(label: str, value: float, document: CadDocument, setter: System.Func[float, str]) -> CadPropertyRow:
        """Makes a row for a length, written and read in the drawing's units, LUNITS and LUPREC: 12.5 is \"12.5000\"
        in decimal units to four places, and 14 inches typed as 1'2\" is read in architectural units. Text that
        does not read is refused with \"<label> is a number.\" and the setter is not called."""
    @staticmethod
    def Linetype(label: str, linetype: str, setter: System.Func[str, str]) -> CadPropertyRow:
        """Makes a row for a linetype's name; the window offers the linetypes of the drawing. The name typed or
        chosen goes to the setter as it is, which refuses one the drawing has not."""
    @staticmethod
    def Lineweight(label: str, lineweight: DxfLineWeight, setter: System.Func[DxfLineWeight, str]) -> CadPropertyRow:
        """Makes a row for a lineweight, written as the palette writes one (ByLayer, ByBlock, Default, or 0.25 mm)
        and read the same way; the window offers AutoCAD's widths. Text that does not read is refused with the
        palette's own words and the setter is not called."""
    @staticmethod
    def Number(label: str, value: float, setter: System.Func[float, str]) -> CadPropertyRow:
        """Makes a row for a number typed as it is, in the invariant culture: 12.5, whatever the machine's
        separator. Typing \"abc\" is refused with \"<label> is a number.\" and the setter is not called."""
    @staticmethod
    def Point(
        label: str,
        value: GeoPoint3,
        document: CadDocument,
        setter: System.Func[GeoPoint3, str],
    ) -> System.Collections.Generic.IReadOnlyList[CadPropertyRow]:
        """Makes the three rows of a point, \"<label> X\", \"<label> Y\" and \"<label> Z\", each a
        CadPropertyRow.Length; typing one gives the setter the point with that coordinate changed and the others
        as they were."""

class CadPublishList(System.Object):
    """The sheet list of the Publish dialog and of -PUBLISH, with the options that go with it: the Model and the
    layouts of the drawing open and of drawings added from files, in the order they are to be published, each
    with the page setup it is plotted by. The list is read from and written to a sheet list file
    (CadPublishList.Load, CadPublishList.Save), and CadPublishList.Plan says what a publish does with each sheet.
    Nothing here draws or writes a plot: a window's writers carry the plan out, with the PDF writer and the
    printers it has."""
    def __init__(self, current: CadDocument) -> None:
        """Makes an empty list for the drawing open."""
    @property
    def Current(self) -> CadDocument:
        """Gets the drawing open, whose sheets are plotted with the edits not saved yet; null for none."""
    @property
    def Options(self) -> CadPublishOptions:
        """Gets or sets where the sheets go and how, the options that the list file keeps and the dialog sets."""
    @Options.setter
    def Options(self, value: CadPublishOptions) -> None: ...
    @property
    def PdfShx(self) -> bool:
        """Gets or sets whether the text of SHX fonts is written as words too, as PDFSHX 1 does."""
    @PdfShx.setter
    def PdfShx(self, value: bool) -> None: ...
    @property
    def PlotStamp(self) -> CadPlotStamp:
        """Gets or sets the plot stamp every sheet is given, as AutoCAD's Include plot stamp; null for none."""
    @PlotStamp.setter
    def PlotStamp(self, value: CadPlotStamp | None) -> None: ...
    @property
    def Sheets(self) -> System.Collections.Generic.IReadOnlyList[CadPublishSheet]:
        """Gets the sheets, in the order they are published."""
    def AddCurrentDrawing(self) -> System.Collections.Generic.IReadOnlyList[CadPublishSheet]:
        """Adds the Model and the layouts of the drawing open, as the Publish dialog lists them when it opens: Model
        first and the layouts in the order of their tabs, each as the drawing's name and the space's joined by a
        hyphen (plan-level2-Model, plan-level2-Layout1), by CadPublishOptions.IncludeModel and
        CadPublishOptions.IncludeLayouts. A sheet the list has already is not added again."""
    def AddDrawing(self, path: str) -> tuple[System.Collections.Generic.IReadOnlyList[CadPublishSheet], str]:
        """Adds the sheets of a drawing file, as Add Sheets does: the drawing read with the readers of the presenter
        (a DWG or a DXF), its Model and layouts listed by CadPublishOptions.IncludeModel and
        CadPublishOptions.IncludeLayouts. The drawing that is open is used as it stands, not read again."""
    def ImportablePageSetups(self, file: str) -> tuple[System.Collections.Generic.IReadOnlyList[str], str]:
        """Gets the page setups of another drawing, as Import Page Setups for Publishing lists them; the drawing is
        kept so that a sheet set to one of them (CadPublishList.SetPageSetup) plots by it."""
    def Load(self, path: str, append: bool) -> System.Collections.Generic.IReadOnlyList[str]:
        """Loads the sheets and the options of a sheet list file (.dsd), as Load List does. A sheet whose drawing is
        not there, or has no such layout or page setup, stays in the list with that as its status. Paths of a
        relative kind are taken from the folder of the list. A list that names DWF or DWFx is set to PDF, which
        says so in the notes."""
    def MoveDown(self, sheet: CadPublishSheet) -> bool:
        """Moves a sheet one place later."""
    def MoveUp(self, sheet: CadPublishSheet) -> bool:
        """Moves a sheet one place earlier, so that it is published sooner."""
    def MultiSheetFile(self) -> str:
        """Gets the multi-sheet PDF: CadPublishOptions.FileName in the output folder, .pdf added; with no name the
        name of the first drawing listed, so that sheets of plan-level2.dxf make plan-level2.pdf."""
    def OutputFolder(self) -> str:
        """Gets the folder the PDFs are written to: CadPublishOptions.OutputFolder, else the folder of the first
        sheet whose drawing has a file, else Documents."""
    def PageSetupNames(self, sheet: CadPublishSheet) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the page setups of the drawing a sheet is of, by name, for the sheet's Page Setup list."""
    def Plan(
        self,
        printers: System.Collections.Generic.IEnumerable[str],
    ) -> System.Collections.Generic.IReadOnlyList[CadPublishStep]:
        """Says what a publish does with each sheet, in the order of the list. A sheet not loaded, or whose plot
        area is empty, is passed over (CadPublishStep.Skipped). With CadPublishTo.Pdf every other sheet is
        plotted by its page setup to a PDF: one file for all (CadPublishList.MultiSheetFile), or a file each
        (CadPublishList.SheetFile). With CadPublishTo.PlotterNamedInPageSetup a sheet whose page setup names a
        printer in printers is printed there, and any other is written as a PDF of its own. The list's plot stamp
        and SHX text go on every sheet."""
    def Remove(self, sheet: CadPublishSheet) -> bool:
        """Removes a sheet from the list."""
    def RemoveAll(self) -> None:
        """Removes every sheet from the list."""
    def Rename(self, sheet: CadPublishSheet, name: str) -> str:
        """Renames a sheet, as AutoCAD's Rename Sheet: the name has none of < > / \\ \" : ? * | and no other sheet
        has it, letters of either case the same."""
    def Save(self, path: str) -> None:
        """Saves the sheets and the options to a sheet list file (.dsd), as Save List does, replacing a file of the
        name. Where the list was loaded from a file, what that file held besides is written back as it was."""
    def SetPageSetup(self, sheet: CadPublishSheet, name: str, file: str = ...) -> str:
        """Sets the page setup a sheet is plotted with, as the sheet's Page Setup list: none for the layout's own,
        the name of a page setup of the sheet's drawing, or a page setup of another drawing."""
    def SettingsOf(self, sheet: CadPublishSheet) -> CadPlotSettings:
        """Gets how a sheet is plotted by the page setup it is set to: the layout's own, a page setup of its
        drawing, or one imported from another drawing, read as the Plot dialog reads a page setup. The plotter is
        left as the setup names it."""
    def SheetFile(self, sheet: CadPublishSheet) -> str:
        """Gets the PDF of one sheet where each sheet has a file: its name in the output folder,
        plan-level2-Layout1.pdf."""

class CadPublishOptions(System.Object):
    """What the Publish dialog sets besides the list of sheets: where they go, one PDF or a PDF each, the number of
    copies, the folder and the name of the PDF, which sheets are listed when a drawing is added, and what is done
    once it is published. A sheet list file (.dsd) keeps the first five and Open in viewer (see CadDsdFile);
    Publish in background is a box that does nothing here, as every publish runs at once."""
    def __init__(self) -> None: ...
    @property
    def Copies(self) -> int:
        """Gets or sets the number of copies, 1 to 99, printed of each sheet that goes to a printer; a PDF has
        one."""
    @Copies.setter
    def Copies(self, value: int) -> None: ...
    @property
    def FileName(self) -> str:
        """Gets or sets the name of the multi-sheet PDF, with or without .pdf, and with a folder where it is not the
        output folder; empty for the name of the first drawing listed, as plan-level2.pdf for plan-level2.dxf."""
    @FileName.setter
    def FileName(self, value: str) -> None: ...
    @property
    def IncludeLayouts(self) -> bool:
        """Gets or sets AutoCAD's Include Layouts when adding sheets: true until set."""
    @IncludeLayouts.setter
    def IncludeLayouts(self, value: bool) -> None: ...
    @property
    def IncludeModel(self) -> bool:
        """Gets or sets AutoCAD's Include Model when adding sheets: true until set."""
    @IncludeModel.setter
    def IncludeModel(self, value: bool) -> None: ...
    @property
    def MultiSheet(self) -> bool:
        """Gets or sets whether a PDF is one file of a page for each sheet (the multi-sheet file of AutoCAD) rather
        than a file for each sheet; true until set. Sheets plotted as the plotter of their page setup is a
        printer are not in the file."""
    @MultiSheet.setter
    def MultiSheet(self, value: bool) -> None: ...
    @property
    def OpenInViewer(self) -> bool:
        """Gets or sets AutoCAD's Open in viewer when done: each PDF written is opened in the program Windows gives
        its type."""
    @OpenInViewer.setter
    def OpenInViewer(self, value: bool) -> None: ...
    @property
    def OutputFolder(self) -> str:
        """Gets or sets the folder the PDFs are written to, AutoCAD's Default output location; empty for the folder
        of the first drawing listed that has a file, else Documents."""
    @OutputFolder.setter
    def OutputFolder(self, value: str) -> None: ...
    @property
    def PublishInBackground(self) -> bool:
        """Gets or sets AutoCAD's Publish in background. The box is kept and does nothing: a publish here runs at
        once and ends with its report."""
    @PublishInBackground.setter
    def PublishInBackground(self, value: bool) -> None: ...
    @property
    def PublishTo(self) -> CadPublishTo:
        """Gets or sets where the sheets go; CadPublishTo.Pdf until set."""
    @PublishTo.setter
    def PublishTo(self, value: CadPublishTo) -> None: ...
    def Clone(self) -> CadPublishOptions:
        """Makes a copy that changes apart from this one."""

class CadPublishSheet(System.Object):
    """One row of the Publish dialog's sheet list: a space of a drawing, Model or a layout, with the name it goes by
    in the list, the page setup it is plotted with and how far it is ready to be. A drawing that is open is
    plotted as it stands, with its unsaved edits; any other is read from its file when the sheet is added."""
    DrawingFailedToLoad: ClassVar[str]
    """The status of a sheet whose drawing file could not be read."""
    DrawingNotFound: ClassVar[str]
    """The status of a sheet whose drawing file is not there."""
    LayoutNotFound: ClassVar[str]
    """The status of a sheet whose drawing has no Model or layout of the name the sheet gives."""
    Loaded: ClassVar[str]
    """The status of a sheet that is ready to publish."""
    ModelName: ClassVar[str]
    """The name of model space as a sheet names it."""
    PageSetupNotFound: ClassVar[str]
    """The status of a sheet whose page setup is not in the drawing it is taken from."""
    @property
    def Document(self) -> CadDocument:
        """Gets the drawing the sheet is of, null where it was not read."""
    @property
    def DrawingFile(self) -> str:
        """Gets the full path of the drawing's file; empty for a drawing that is open and has no file yet."""
    @property
    def IsLoaded(self) -> bool:
        """Gets whether the sheet can be published: its space was read and its page setup is there."""
    @property
    def IsModel(self) -> bool:
        """Gets whether the sheet is model space."""
    @property
    def LayoutName(self) -> str:
        """Gets the name of the space: Model, or the layout's name."""
    @property
    def Name(self) -> str:
        """Gets the name in the list, the drawing's name and the layout's joined by a hyphen:
        plan-level2-Layout1."""
    @property
    def PageSetup(self) -> str:
        """Gets the name of the page setup the sheet is plotted with; empty for its own, the page setup its layout
        is set to, which the list shows as <Default: …>."""
    @property
    def PageSetupFile(self) -> str:
