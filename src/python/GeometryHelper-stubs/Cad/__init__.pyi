class CadDataLinks(System.Object):
    """The data links of a drawing, as AutoCAD 2021's DATALINK and DATALINKUPDATE and the table's data link menus
    work them: a link to a spreadsheet (an .xlsx workbook or a .csv file) made, changed, renamed and deleted, a
    table's cells linked to it, filled from its source and written back to it. A link is a DATALINK object of the
    drawing's ACAD_DATALINK dictionary, written as AutoCAD 2021 writes the link of its own Excel adapter
    (AcExcel): its adapter, tooltip and connection string, its options and update options, when it was last
    updated, the tables it fills and its custom data (the update options, the connection string and the source
    file's date), so that AutoCAD opens the drawing and reads the link as its own. A drawing before AutoCAD 2007
    (AC1021) has no data links."""
    AllowSourceUpdate: ClassVar[int]
    """The flag of AutoCAD's UpdateOption that lets the link write the table back to its source."""
    ExtractionAdapter: ClassVar[str]
    """The data adapter of a data extraction's link, as AutoCAD names it."""
    SkipFormat: ClassVar[int]
    """The flag of AutoCAD's UpdateOption that leaves the workbook's formatting out of the table."""
    @staticmethod
    def CanHold(document: CadDocument) -> bool:
        """Whether the drawing can hold data links: a drawing of AutoCAD 2007 (AC1021) or later with a dictionary of
        objects."""
    @staticmethod
    def Create(document: CadDocument, settings: CadDataLinkSettings) -> CadEditResult:
        """Makes a data link, as the New Excel Data Link dialog does: one undo step. The name has to be new (\"Data
        link name in use.\"), the source has to read, and the drawing has to be of AutoCAD 2007 or later."""
    @staticmethod
    def Delete(document: CadDocument, name: str) -> CadEditResult:
        """Deletes a data link, one undo step. A link that fills a table is in use and is refused, \"The data link
        is being used and cannot be deleted.\"; detach it from the table first."""
    @staticmethod
    def Detach(document: CadDocument, tableHandle: str, row: int, column: int) -> CadEditResult:
        """Takes the data link off a table's cells, as Detach Data Link does: the cells keep what they hold and are
        no longer linked, one undo step. The link stays in the drawing, in the Data Link Manager."""
    @staticmethod
    def Edit(document: CadDocument, name: str, settings: CadDataLinkSettings) -> CadEditResult:
        """Changes a data link, as Modify Excel Link does: its file, cells and options written anew, one undo step.
        The tables it fills are not changed until the link is updated."""
    @staticmethod
    def Find(document: CadDocument, name: str) -> DxfDataLink:
        """Finds a link by its name, letters of either case alike."""
    @staticmethod
    def FolderOf(document: CadDocument) -> str:
        """The folder of the drawing's file; null for a drawing not saved."""
    @staticmethod
    def LinkCells(document: CadDocument, tableHandle: str, row: int, column: int, linkName: str) -> CadEditResult:
        """Links a table's cells to a data link, as Link Cell does and as a table made from a data link is: the data
        read from the source and put into the table from the cell given, rows and columns added where the table
        is too small to hold it, the cells linked, one undo step. A table of a drawing before AutoCAD 2007, or
        whose cells are linked already, is refused."""
    @staticmethod
    def List(document: CadDocument) -> System.Collections.Generic.IReadOnlyList[CadDataLinkInfo]:
        """The data links of the drawing, by name."""
    @staticmethod
    def Preview(document: CadDocument, settings: CadDataLinkSettings) -> CadSheet:
        """Reads what a data link's settings link, for the dialog's preview and for the checks of
        CadDataLinks.Create."""
    @staticmethod
    def RelativePath(folder: str, file: str) -> str:
        """The path from a folder to a file, ..\\data\\parts.xlsx; the file's full path where it is on another
        drive."""
    @staticmethod
    def Rename(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Renames a data link, one undo step."""
    @staticmethod
    def Update(document: CadDocument, links: System.Collections.Generic.IEnumerable[DxfDataLink]) -> CadDataLinkRun:
        """Updates data links from their sources, as DATALINKUPDATE's Update data link does: each link's source
        read, and the cells of each table it fills made what the source holds, rows and columns added or taken
        out to its size, the link's time and status written; one undo step. A link whose source cannot be read is
        counted as failed with its message and its tables left as they were."""
    @staticmethod
    def Write(document: CadDocument, links: System.Collections.Generic.IEnumerable[DxfDataLink]) -> CadDataLinkRun:
        """Writes data links to their sources, as DATALINKUPDATE's Write data link does: the cells of each table a
        link fills put back into the workbook or the CSV file, whose other cells stay as they are. A link that
        does not allow it (its update options lack CadDataLinks.AllowSourceUpdate) is counted apart; a source
        that cannot be written is failed. The status of each link is written, one undo step."""

class CadDataSource(System.Object):
    """Where the data of a data link is, as AutoCAD's Excel data adapter (AcExcel) words it in the connection string
    of a link: the file, then ! and the sheet, then ! and the range, parts.xlsx!Sheet1!A1:C5; the file and the
    sheet alone for the entire sheet, parts.xlsx!Sheet1; the file and a name for a named range,
    parts.xlsx!Prices. A file is an .xlsx workbook or a .csv file; a relative path is of the drawing's folder."""
    ExcelAdapter: ClassVar[str]
    """The data adapter of a link to a spreadsheet, as AutoCAD names it."""
    @staticmethod
    def Compose(file: str, sheet: str, range: str) -> str:
        """Puts a connection string together."""
    @staticmethod
    def Describe(connection: str) -> str:
        """What a connection string links, in the words of the Data Link Manager's details: Entire sheet: Sheet1,
        Named range: Prices or Range: A1:C5."""
    @staticmethod
    def Read(connection: str, drawingFolder: str) -> CadSheet:
        """Reads what a connection string links. A workbook's sheet by its name, else its named range, else (for a
        file of one sheet, a CSV file) the file's own sheet; the cells of a range cut from the sheet, whole
        columns to the sheet's last row."""
    @staticmethod
    def Resolve(file: str, drawingFolder: str) -> str:
        """Where a file of a connection string is: itself where it is a full path, else in the folder of the
        drawing; null where it is relative and the drawing has no folder yet."""
    @staticmethod
    def TryParse(connection: str) -> tuple[bool, str, str, str]:
        """Takes a connection string apart: the file and what follows its extension."""
    @staticmethod
    def Write(connection: str, drawingFolder: str, values: CadSheet) -> int:
        """Writes cells back to what a connection string links, from its first cell: a CSV file is written whole
        again (its other cells kept), a workbook has the cells put into its sheet and every other part left as it
        is."""

