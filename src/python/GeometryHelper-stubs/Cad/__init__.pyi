class CadLinetypeDefinition(System.Object):
    """A linetype of a .lin file: its name, its description and the elements of its pattern; or, where its pattern
    cannot be read, the fault. DASHED of the presenter's own set is *DASHED,Dashed __ __ __ and A,6,-1.5: a dash
    6 long and a gap of 1.5, 7.5 in all."""
    def __init__(
        self,
        name: str,
        description: str,
        elements: System.Collections.Generic.IEnumerable[CadLinetypeElement],
    ) -> None:
        """Makes a linetype."""
    @property
    def Description(self) -> str:
        """Gets the description: what follows the comma of the name's line."""
    @property
    def Elements(self) -> System.Collections.Generic.IReadOnlyList[CadLinetypeElement]:
        """Gets the elements of the pattern, in order; none where it could not be read."""
    @property
    def Fault(self) -> str:
        """Gets why the pattern could not be read; null where it was."""
    @property
    def IsComplex(self) -> bool:
        """Gets whether an element carries a text or a shape."""
    @property
    def Name(self) -> str:
        """Gets the name."""
    @property
    def PatternLength(self) -> float:
        """Gets the length of the pattern: its lengths together, whatever their sign; 7.5 for a dash of 6 and a gap
        of 1.5."""
    @property
    def PatternText(self) -> str:
        """Gets the pattern line as the file writes it: A,6,-1.5."""
    def ToString(self) -> str:
        """Gets the two lines the file writes the linetype in, parted by a line feed: *DASHED,Dashed __ __ __ and
        A,6,-1.5."""

class CadLinetypeElement(System.Object):
    """An element of a linetype's pattern as a .lin file writes it: a length (above nought a dash, below a gap,
    nought a dot), and the text or shape in brackets after it, if any.
    -2.4,[\"GAS\",STANDARD,S=1.2,R=0.0,X=-1.2,Y=-0.6] is a gap 2.4 long carrying the text GAS in the style
    STANDARD, 1.2 high, 1.2 back and 0.6 down from the gap's end."""
    @overload
    def __init__(self, length: float) -> None:
        """Makes an element of a length alone."""
    @overload
    def __init__(
        self,
        length: float,
        kind: CadLinetypeElementKind,
        value: str,
        style: str,
        scale: float,
        rotation: float,
        rotationKind: CadLinetypeRotation,
        x: float,
        y: float,
    ) -> None:
        """Makes an element carrying a text or a shape."""
    @property
    def Kind(self) -> CadLinetypeElementKind:
        """Gets what the element carries."""
    @property
    def Length(self) -> float:
        """Gets the length: above nought a dash, below a gap, nought a dot."""
    @property
    def Rotation(self) -> float:
        """Gets the rotation, in degrees."""
    @property
    def RotationKind(self) -> CadLinetypeRotation:
        """Gets what the rotation is measured from."""
    @property
    def Scale(self) -> float:
        """Gets the scale (S); 1 where the file gives none."""
    @property
    def Style(self) -> str:
        """Gets the text style of a text, or the file of shapes of a shape; null for a dash."""
    @property
    def Value(self) -> str:
        """Gets the text, or the shape's name or number; null for a dash."""
    @property
    def X(self) -> float:
        """Gets the offset along the line (X)."""
    @property
    def Y(self) -> float:
        """Gets the offset across the line (Y)."""
    def ToString(self) -> str:
        """Gets the element as the file writes it: -2.4,[\"GAS\",STANDARD,S=1.2,R=0,X=-1.2,Y=-0.6]."""

class CadLinetypeElementKind(System.Enum):
