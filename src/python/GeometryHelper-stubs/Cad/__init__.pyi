    """The largest file Import Text takes, in bytes: 32 KB."""
    @staticmethod
    def FromFile(path: str, height: float) -> CadMTextContent:
        """Reads a file: an RTF where it begins {\\rtf, else a text file."""
    @staticmethod
    def FromRtf(rtf: str, height: float) -> CadMTextContent:
        """Reads rich text as the class says."""
    @staticmethod
    def FromText(text: str) -> CadMTextContent:
        """Reads plain words: each line a paragraph, in no look of its own."""

class CadMTextLook(System.Object):
    """The look of a run of letters of an MTEXT, as its inline codes set it: the font and whether it is bold or
    italic, the lines under, over and through, the colour, the height, the slant, the spacing and the width of
    the letters, and how the run stands in its line. A value left null (or false) is the MTEXT's own, so that
    CadMTextLook.Plain is the look of words written with no code at all. A look is never changed: each With gives
    a new one."""
    @property
    def Align(self) -> int | None:
        """Gets how the run stands in a line of taller letters (\\A): 0 on the baseline, 1 at the middle, 2 at the
        top; null for the baseline."""
    @property
    def Bold(self) -> bool:
        """Gets whether the letters are bold (|b1 of a TrueType font code)."""
    @property
    def Charset(self) -> int | None:
        """Gets the character set of the font code (|c0); null where the code gave none."""
    @property
    def ColorIndex(self) -> int | None:
        """Gets the colour index of \\C: 0 ByBlock, 256 ByLayer, 1 to 255 a colour of the index; null for the
        MTEXT's own."""
    @property
    def Font(self) -> str:
        """Gets the font a code switches to: a TrueType family (Arial) or an SHX file (romans); null for the MTEXT
        style's."""
    @property
    def Height(self) -> float | None:
        """Gets the height of the letters in drawing units (\\H); null for the MTEXT's height."""
    @property
    def IsPlain(self) -> bool:
        """Gets whether this is CadMTextLook.Plain in all but the font: what the MTEXT's own codes before its words
        may set without a run of their own."""
    @property
    def IsShx(self) -> bool:
        """Gets whether CadMTextLook.Font is an SHX file (\\F) rather than a TrueType family (\\f)."""
    @property
    def Italic(self) -> bool:
        """Gets whether the letters are italic (|i1 of a TrueType font code)."""
    @property
    def Oblique(self) -> float | None:
        """Gets the slant of the letters in degrees (\\Q); null for the style's."""
    @property
    def Overline(self) -> bool:
        """Gets whether the letters are overlined (\\O to \\o)."""
    @property
    def Pitch(self) -> int | None:
        """Gets the pitch and family of the font code (|p34); null where the code gave none."""
    Plain: ClassVar[CadMTextLook]
    """Gets the look of words with no code: everything the MTEXT's own."""
    @property
    def Strikethrough(self) -> bool:
        """Gets whether the letters are struck through (\\K to \\k)."""
    @property
    def Tracking(self) -> float | None:
        """Gets the spacing of the letters as a factor of their usual spacing (\\T); null for 1."""
    @property
    def TrueColor(self) -> int | None:
        """Gets the true colour of \\c as 0xRRGGBB; null for none."""
    @property
    def Underline(self) -> bool:
        """Gets whether the letters are underlined (\\L to \\l)."""
    @property
    def WidthFactor(self) -> float | None:
        """Gets the width factor of the letters (\\W); null for the style's."""
    @overload
    def Equals(self, other: CadMTextLook) -> bool: ...
    @overload
    def Equals(self, obj: object) -> bool: ...
    def GetHashCode(self) -> int: ...
    def WithAlign(self, align: int | None) -> CadMTextLook:
        """Gives the look standing in its line as \\A says (0, 1, 2); null for the baseline."""
    def WithColorIndex(self, index: int | None) -> CadMTextLook:
        """Gives the look in a colour of the index (0 ByBlock, 256 ByLayer), any true colour dropped; null for the
        MTEXT's own."""
    def WithHeight(self, height: float | None) -> CadMTextLook:
        """Gives the look of a height in drawing units; null for the MTEXT's."""
    def WithOblique(self, degrees: float | None) -> CadMTextLook:
        """Gives the look of a slant in degrees; null for the style's."""
    def WithOverline(self, on: bool) -> CadMTextLook:
        """Gives the look overlined or not."""
    def WithShx(self, file: str) -> CadMTextLook:
        """Gives the look with an SHX font, which is neither bold nor italic."""
    def WithStrikethrough(self, on: bool) -> CadMTextLook:
        """Gives the look struck through or not."""
    def WithTracking(self, factor: float | None) -> CadMTextLook:
        """Gives the look of a spacing factor; null for 1."""
    def WithTrueColor(self, rgb: int | None) -> CadMTextLook:
        """Gives the look in a true colour, 0xRRGGBB, any colour index dropped; null for none."""
    def WithTrueType(self, family: str, bold: bool, italic: bool) -> CadMTextLook:
        """Gives the look with a TrueType font, bold and italic as given, the character set and pitch kept."""
    def WithUnderline(self, on: bool) -> CadMTextLook:
        """Gives the look underlined or not."""
    def WithWidthFactor(self, factor: float | None) -> CadMTextLook:
        """Gives the look of a width factor; null for the style's."""

class CadMTextMask(System.Object):
    """The background mask of an MTEXT, as AutoCAD 2021's Background Mask dialog sets it: whether the words stand on
