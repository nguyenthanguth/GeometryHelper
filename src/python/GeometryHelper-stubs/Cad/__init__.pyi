class CadTemplate(System.Object):
    """The drawing NEW starts from: the presenter's own metric template, made in code with the settings of AutoCAD's
    acadiso.dwt (not its file). A drawing of R2013 in millimetres, its linear units decimal to four places and
    its angles decimal degrees to none, its limits an A3 sheet of 420 by 297, its text 2.5 high, its points dots,
    and its dimensions drawn in ISO-25: arrowheads and text 2.5, the text above the line, two decimal places and
    a decimal comma."""
    DimensionStyle: ClassVar[str]
    """The name of the dimension style the template makes current."""
    Extensions: ClassVar[System.Collections.Generic.IReadOnlyList[str]]
    """The file types a template is chosen among, as the Select Template dialog lists them."""
    @staticmethod
    def AddLayers(database: DxfDatabase, layers: System.Collections.Generic.IEnumerable[GlobalLayer]) -> None:
        """Adds the layers of Global settings (Layers, colours and lines) to a new drawing, in the order they are
        listed: each with its colour as a true colour, its lineweight (the width of AutoCAD's nearest, 0.5 mm for
        0.50) and whether it is plotted. A linetype is taken from the presenter's own set
        (CadLinetypeFile.BuiltIn) and added to the drawing where it has not got it: HIDDEN for Hidden, CENTER for
        Centre. One that set has not is not made up; the layer is drawn Continuous. A layer named as one the
        drawing has already, 0 among them, is left as it is, and the current layer stays 0."""
    @staticmethod
    def CreateImperial() -> DxfDatabase:
        """Makes a new drawing of the presenter's own imperial template, as AutoCAD's \"Open with no Template -
        Imperial\" starts one (the settings of acad.dwt, not its file): R2013 in inches, MEASUREMENT 0, its
        limits a sheet of 12 by 9, its text 0.2 high, and its dimensions drawn in Standard, arrowheads and text
        0.18, four decimal places and a decimal point. The layer 0, the linetypes, the text styles Standard and
        Annotative are those of CadTemplate.CreateMetric."""
    @staticmethod
    def CreateMetric() -> DxfDatabase:
        """Makes a new drawing of the metric template: R2013 (AC1027), every setting of CadTemplate in its header
        and tables, nothing drawn."""
    @staticmethod
    def DescriptionOf(file: str) -> str:
        """Reads the description of a template, the text AutoCAD's Template Options writes into a DWG's template
        section. A file that is no DWG (a DXF), one with no description, and one that cannot be read have none."""
    @staticmethod
    def Find(typed: str, folder: str) -> str:
        """Finds the file of a template named as typed: as typed, else in the template folder; a name with no
        extension is given .dwt, as AutoCAD does."""
    @staticmethod
    def FindIn(folder: str) -> System.Collections.Generic.IReadOnlyList[str]:
        """Lists the templates of a folder: the .dwt, .dwg and .dxf files in it, not those of its subfolders, by
        name (letters of either case the same, then as written) and then by extension; empty where the folder is
        not there."""

class CadTemplateOptionsRequest(System.Object):
