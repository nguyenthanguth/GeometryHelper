class CadLinetypes(System.Object):
    """The linetypes of a document loaded, tested and drawn, as LINETYPE and its dialogs need them. A linetype of a
    file on disk is loaded by the library's own loader (DxfDatabase.LoadLineTypeFile), which reads it as AutoCAD
    does, text and shapes alike; one of the presenter's own set is written from its definition
    (CadLinetypes.Add)."""
    @staticmethod
    def Add(database: DxfDatabase, linetype: CadLinetypeDefinition) -> DxfLinetypeTableRecord:
        """Writes a linetype of the presenter's own as an LTYPE record of a drawing, as AutoCAD writes one: its
        name, its description, 72 the alignment A, the count of its elements and its length, then each element's
        49 and 74, and for a text its 75 of nought, the handle of its text style (340), its scale, rotation and
        offset (46, 50, 44, 45) and the text (9). GAS_LINE's gap of 2.4 carrying GAS in STANDARD is 49 -2.4, 74
        2, 75 0, 340 Standard's handle , 46 1.2, 50 0, 44 -1.2, 45 -0.6, 9 GAS."""
    @staticmethod
    def DashesOf(database: DxfDatabase, name: str) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets the lengths of a linetype of the drawing, as its LTYPE holds them; none for Continuous or one the
        drawing has not."""
    @staticmethod
    def IsInUse(database: DxfDatabase, name: str) -> bool:
        """Gets whether something of the drawing draws with a linetype, so that it may not be deleted: ByLayer,
        ByBlock and Continuous always, as AutoCAD keeps them, and any other an entity, a layer, a style or the
        header names, as the library's purge finds it."""
    @staticmethod
    def IsKept(name: str) -> bool:
        """Gets whether a linetype is one AutoCAD keeps in every drawing: ByLayer, ByBlock or Continuous."""
    @staticmethod
    def Load(
        document: CadDocument,
        linetypes: System.Collections.Generic.IEnumerable[CadLinetypeDefinition],
        path: str,
        stepName: str = ...,
    ) -> CadLinetypeLoad:
        """Loads linetypes into a document as one undo step, named as given: each of a file on disk through the
        library's loader, each of CadLinetypeFile.BuiltInName from its definition; one the drawing has already
        passed over, one the drawing cannot take (its text style or shape missing) refused alone, the others
        loaded. DASHED of the presenter's own set loaded into a new drawing is an LTYPE of a dash 6 and a gap
        1.5, 7.5 long. A linetype of CadLinetypeFile.BuiltIn itself is written from its definition whatever the
        path, so that the Load dialog's list, the presenter's own set followed by a file's, loads in one step."""
    @staticmethod
    def Names(database: DxfDatabase) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the drawing's linetypes, ByLayer and ByBlock left out, in the order of their names:
        Continuous, DASHED, HIDDEN."""
    @staticmethod
    def Rename(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Renames a linetype with everything drawn with it, as -RENAME LType does: the entities, the layers, the
        styles of multilines and the current linetype name it. Refused for ByLayer, ByBlock and Continuous, which
        AutoCAD keeps, and for a linetype of an external reference, Cannot rename linetype \"X\".; for a name
        AutoCAD does not take, Invalid linetype name.; and for the name of another linetype, letters of either
        case the same, Linetype \"X\" already exists."""

class CadLoadAnswer(System.Enum):
    """The answer to the warning of SECURELOAD 1, the one AutoCAD shows for a file of code outside the trusted
    folders (CadLoadSecurity.Ask)."""
    AlwaysLoad: ClassVar[CadLoadAnswer]
    """Always Load: the file is loaded, and not asked about again for as long as its bytes stay the same."""
    DoNotLoad: ClassVar[CadLoadAnswer]
    """Do Not Load: the file is not loaded. It is also the answer to Esc and to closing the warning."""
    LoadOnce: ClassVar[CadLoadAnswer]
    """Load Once: the file is loaded, and not asked about again while the app runs."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadLoadSecurity(System.Object):
    """The gate in front of every file of code the presenter loads, as AutoCAD 2021's: SECURELOAD says what happens
    to a file outside the trusted folders, TRUSTEDPATHS lists those folders and LEGACYCODESEARCH says whether a
    search for a code file looks in the current and the drawing folder. AutoLISP's load and everything built on
    it asks CadLoadSecurity.MayLoad before it reads a file, and the app's Python does the same for PYRUN and
    PYLOAD."""
    def __init__(self) -> None: ...
    @property
    def AlwaysLoaded(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets or sets the files answered Always Load, each as the SHA-256 of its bytes in lower-case hexadecimal,
        a bar and its full path: 9f86d0...0a08|C:\\work\\tools\\label.lsp. Such a file loads under SECURELOAD 1
        with no question for as long as its bytes are the same, so a file edited since is asked about again. An
        entry that is not of this form is left out, and a second entry for one path replaces the first. Null is
        taken as empty."""
    @AlwaysLoaded.setter
    def AlwaysLoaded(self, value: System.Collections.Generic.IReadOnlyList[str] | None) -> None: ...
    @property
    def Ask(self) -> System.Func[str, CadLoadAnswer]:
        """Gets or sets what asks about a file under SECURELOAD 1: it gets the full path and answers with one of
        CadLoadAnswer. The window shows AutoCAD's warning here. Null, as it is at the start, makes a library, a
        test or a console refuse the file, as AutoCAD's console does. An exception from it is a refusal and a
        line in the log."""
    @Ask.setter
    def Ask(self, value: System.Func[str, CadLoadAnswer] | None) -> None: ...
    @property
    def LegacyCodeSearch(self) -> bool:
        """Gets or sets whether a search for a file of code (findfile, load_dialog, load) looks in the current
        folder and the folder of the drawing before the support folders, as AutoCAD's LEGACYCODESEARCH 1. Off at
        the start: a .lsp file lying beside the drawing is not found by its bare name."""
    @LegacyCodeSearch.setter
    def LegacyCodeSearch(self, value: bool) -> None: ...
    ProgramFolder: ClassVar[str]
    """Gets the folder of the program, the one the presenter's own linetypes, hatches and Python package lie in,
    with no closing backslash. It is trusted with every folder under it, whatever CadLoadSecurity.TrustedPaths
    says."""
    @property
    def SecureLoad(self) -> int:
        """Gets or sets what happens to a file of code outside the trusted folders: 0 loads it, 1 asks
        (CadLoadSecurity.Ask), 2 refuses it. Starts at 1, as AutoCAD does."""
    @SecureLoad.setter
    def SecureLoad(self, value: int) -> None: ...
    @property
    def TrustedPaths(self) -> str:
        """Gets or sets the folders trusted besides the program's, as AutoCAD's TRUSTEDPATHS: entries parted by ;,
        an entry that ends in \\... trusting that folder and every folder under it and any other the folder
        alone, so D:\\tools;D:\\lisp\\... trusts D:\\tools, D:\\lisp and everything below D:\\lisp. Spaces around
        an entry are dropped and an empty entry is skipped; a %NAME% is replaced by the environment variable when
        the value is set; an entry in quotes, with a wildcard or not starting at a drive or a share trusts
        nothing. Empty at the start; null is taken as empty, and any text is kept."""
    @TrustedPaths.setter
    def TrustedPaths(self, value: str | None) -> None: ...
    @property
    def Changed(self) -> System.EventHandler[System.EventArgs]:
        """Occurs when SECURELOAD, TRUSTEDPATHS, LEGACYCODESEARCH or CadLoadSecurity.AlwaysLoaded changes, which
        includes a file answered Always Load. Raised on the thread that made the change, after it; setting a
        value to what it is raises nothing."""
    @Changed.setter
    def Changed(self, value: System.EventHandler[System.EventArgs]) -> None: ...
    def ForgetAlwaysLoaded(self) -> None:
        """Forgets every file answered Always Load, which AutoCAD gives no way to do: each is asked about again
        under SECURELOAD 1. A file answered Load Once in this run stays answered."""
    @staticmethod
    def IsCodeFile(path: str) -> bool:
        """Says whether a file is one of the kinds AutoCAD keeps out of the current and the drawing folder while
        LEGACYCODESEARCH is 0: .lsp .fas .vlx .mnl .scr .dcl .dll .arx .dvb .cuix, and .py for Python. Only the
        extension is read, without regard to case, so label.LSP is one and notes.txt and acad.lin are not."""
    def IsTrusted(self, path: str) -> bool:
        """Says whether a file lies in a trusted folder: the folder of the program and every folder under it, or a
        folder of CadLoadSecurity.TrustedPaths. Nothing is asked and the file need not exist."""
    def MayLoad(self, path: str) -> bool:
        """Decides whether a file of code may be loaded, in this order: SECURELOAD 0 loads it; a file in a trusted
        folder loads; SECURELOAD 2 refuses any other, an Always Load answer given before notwithstanding; under
        SECURELOAD 1 a file answered Load Once in this run, or Always Load with the same bytes, loads, and any
        other is asked about (CadLoadSecurity.Ask), and refused where nothing asks. Each refusal is one line of
        the log at the Debug level."""

class CadMLeaderStyleEditor(System.Object):
    """The edits of the multileader styles, as AutoCAD's Multileader Style Manager (MLEADERSTYLE) makes them: each
    one undo step through CadDocument.ApplyEdit, refused where AutoCAD refuses it. A style changed gives its
    values to every multileader of it, but those a multileader has of its own."""
    @staticmethod
    def Add(document: CadDocument, name: str, from_: str, /) -> CadEditResult:
        """Adds a style, as New of the Multileader Style Manager: a copy of the settings of another (Start with),
        under a name no style of the drawing has, letters of either case the same; the dictionary
        ACAD_MLEADERSTYLE made where the drawing has none, and the named object dictionary first where the
        drawing was written without it. A copy of an annotative style is annotative, as AutoCAD's New starts from
        the style's Annotative box."""
    @staticmethod
    def AddStandard(document: CadDocument) -> CadEditResult:
        """Adds the presenter's metric Standard where the drawing has no multileader style of that name, as
        AutoCAD's drawing always has it; one undo step, nothing where it has one."""
    @staticmethod
    def Apply(document: CadDocument, name: str, settings: CadMLeaderStyleSettings) -> CadEditResult:
        """Writes the settings into a style, as OK of the Modify Multileader Style dialog, and gives every
        multileader of the style its values, those it has of its own kept (a value that differed from the style's
        before). Nothing is written, and nothing refused, where they are the style's already."""
    @staticmethod
    def Current(database: DxfDatabase) -> str:
        """Gets the name of the current multileader style (CMLEADERSTYLE), as the dictionary spells it; Standard
        where the drawing names none it has."""
    @staticmethod
    def Delete(document: CadDocument, name: str) -> CadEditResult:
        """Deletes a style, as Delete of the Multileader Style Manager: refused for Standard, the current style and
        a style a multileader is drawn in, as AutoCAD greys Delete for them."""
    @staticmethod
    def Find(database: DxfDatabase, name: str) -> DxfMLeaderStyle:
        """Gets the style of a name; null where the drawing has none."""
    @staticmethod
    def Rename(document: CadDocument, name: str, newName: str) -> CadEditResult:
        """Renames a style with the multileaders drawn in it, as -RENAME multileadeRstyle does: the entry of the
        dictionary ACAD_MLEADERSTYLE takes the new name, which the multileaders follow since they point at the
        style by its handle, and the current style (CMLEADERSTYLE) names it where it was the one renamed.
        Standard keeps its name."""
    @staticmethod
    def Sample(source: DxfDatabase, settings: CadMLeaderStyleSettings) -> DxfDatabase:
        """Makes the sample multileader of the Manager's preview: a drawing of its own whose one style, Standard,
        has the settings (its text style Standard given the font of the one they name in the drawing edited, its
        leaders ByBlock), and a multileader of the words \"Default Text\" in it, its arrow at the origin and its
        landing 6 by 4 text heights up to the right, made as MLEADER makes one."""
    @staticmethod
    def SetCurrent(document: CadDocument, name: str) -> CadEditResult:
        """Makes a style current (CMLEADERSTYLE), as Set Current does, and gives MLEADERSCALE the style's scale,
        nought for an annotative style, as AutoCAD 2021 does each time the variable is set, to the style already
        current too: with MLEADERSCALE set to 2, a style of scale 5 made current gives 5 again. Refused where the
        drawing has no such style, or cannot hold the variables: a drawing with no CLASSES section to list
        DICTIONARYVAR in."""
    @staticmethod
    def Styles(database: DxfDatabase) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the multileader styles of a drawing, by name, letters of either case alike first: the entries of its
        dictionary ACAD_MLEADERSTYLE that are styles; none where it has none."""
    @staticmethod
    def Uses(database: DxfDatabase, name: str) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the handles of the multileaders drawn in a style: those of model space, the layouts and the blocks
        that name it, in the order of the blocks and their entities, as AutoCAD counts what keeps a style from
        being deleted."""
    @staticmethod
    def WhyNotDeleted(database: DxfDatabase, name: str) -> str:
        """Gets why a style may not be deleted, as Delete is greyed: Standard, the current style, a style a
        multileader uses; null where it may."""

