class ICadClipboard(System.Object):
    """The clipboard COPYCLIP puts objects on and PASTECLIP takes them from: the window's is the Windows clipboard,
    shared by the drawings of the app and by every app that runs; a test gives a CadMemoryClipboard, so that it
    never touches the real one."""
    def GetData(self) -> CadClipboardData:
        """Gets what the clipboard holds: objects of a drawing, plain text of another app, or null for neither."""
    def SetData(self, data: CadClipboardData) -> None:
        """Puts objects copied, or text, on the clipboard, in place of what it held."""

class ICadEditGate(System.Object):
    """The one place an edit is asked about before it is written. CadDocument.ApplyEdit asks the gate of the
    document once for every existing entity an edit plans to change or erase, before anything is written; an
    answer of false refuses the whole edit and the drawing stays as it was. The owner contract (an entity whose
    owner says it may only be moved, or not edited at all) is plugged in here: the default lets every edit
    through."""
    def Allows(self, document: CadDocument, entity: DxfEntity, record: CadEditRecord) -> tuple[bool, str]:
        """Asks whether one planned change of an entity may be made."""

class ICadEntityOwner(System.Object):
    """Something outside the presenter that owns some of a drawing's entities and is asked before they change: a
    model drawing owns the lines, dimensions and marks it wrote. An entity is owned when its extended data
    carries a CadOwnerTag naming the owner; owners are found through a CadOwnerRegistry."""
    @property
    def Name(self) -> str:
        """Gets the owner's name, as the CadOwnerTag.Owner of its entities gives it: \"ModelDrawing\" for a model
        drawing. Names are compared character by character, case and all."""
    def GetEditRule(self, entity: DxfEntity) -> CadEditRule:
        """Says what the presenter may do to one of the owner's entities."""
    def TryApply(self, document: CadDocument, edit: CadEdit) -> bool:
        """Takes an edit of one of the owner's entities: the owner records it and changes or writes its entities
        again in the document; or refuses it, and the document stays as it was."""

class ICadRemoteDispatcher(System.Object):
    """Runs work on the thread the app's drawings belong to. The server reads its pipe on threads of its own and
    hands every request to the dispatcher, so that a drawing is only touched by the thread that owns it."""
    def Invoke(self, action: System.Action[()]) -> None:
        """Runs the action on the thread of the drawings and returns when it has finished. An exception is the
        action's to catch: the server's actions do."""

class ICadRemoteHost(System.Object):
    """What a CadRemoteServer needs of the app it serves: the drawings open, the one the user works in, and the ways
    to open, make, show and save one and to type on a drawing's command line. The app's window implements it over
    its view model; a test implements it over a few documents and no window. Every member is called on the thread
    of the ICadRemoteDispatcher the server was given, never from the pipe's own thread."""
    @property
    def ActiveDocument(self) -> CadDocument:
        """Gets the drawing the user works in, or null when none is open."""
    @property
    def Documents(self) -> System.Collections.Generic.IReadOnlyList[CadDocument]:
        """Gets the drawings open now."""
    @property
    def Title(self) -> str:
        """Gets the title of the app's window, as A-101.dwg - GeometryHelper CAD."""
    def Activate(self, document: CadDocument) -> None:
        """Shows a drawing open in the app, as clicking its entry in the list does."""
    def New(self, template: str) -> CadDocument:
        """Starts a new drawing and shows it."""
    def Open(self, path: str) -> CadDocument:
        """Opens a drawing from a file and shows it, or shows it where it is open already."""
    def Save(self, document: CadDocument) -> None:
        """Saves a drawing to its file."""
    def SaveAs(self, document: CadDocument, path: str, version: str) -> None:
        """Saves a drawing to a file, which it is known by afterwards."""
    def SessionOf(self, document: CadDocument) -> CadCommandSession:
        """Gets the command session of a drawing: its command line, the commands running in it and what they
        wrote."""
    def Type(self, document: CadDocument, line: str) -> None:
        """Types a line on the command line of the drawing, as the user does: a command's name or the answer to its
        prompt, words parted by spaces going in one by one, an empty line being Enter."""

class ObjectSnap(System.Object):
    """Object snaps, ortho, polar and grid snap, as AutoCAD's: given the cursor, the size of the aperture and the
    point a rubber band is drawn from, the point a click takes. Snaps are worked out from the display items under
    the aperture, through a space's PickIndex, so an INSERT's lines and arcs are snapped to where it places them.

    The snaps that work from more than the cursor: Extension, Parallel and object snap tracking from points
    acquired by resting the cursor on them, and Apparent Intersection from two objects under the cursor or one
    clicked first."""
    def __init__(self, tolerance: Tolerance) -> None:
        """Makes the snaps of AutoCAD's default: endpoint, midpoint, centre, quadrant and intersection, on."""
    @property
    def Acquired(self) -> System.Collections.Generic.IReadOnlyList[CadAcquiredPoint]:
        """Gets the points acquired, the oldest first; seven at most."""
    @property
    def AcquiresWithShift(self) -> bool:
        """Gets or sets whether a point is acquired for tracking only while Shift is held as the cursor rests on it,
        as AutoCAD's POLARMODE 8; off until set, when resting on it is enough. The window's canvas honours it."""
    @AcquiresWithShift.setter
    def AcquiresWithShift(self, value: bool) -> None: ...
    @property
    def AdditionalPolarAngles(self) -> System.Collections.Generic.IReadOnlyList[float]:
        """Gets or sets the additional polar angles, in radians from the X axis of the UCS, as AutoCAD's POLARADDANG
        while POLARMODE 4 is set: each held as it is beside the multiples of ObjectSnap.PolarAngle, but not its
        own multiples, and counted from the last segment too while ObjectSnap.PolarFromLastSegment is on; none
        until set. With a polar angle of 90 and 33 added, the cursor is held at 33 degrees from the base point,
        but not at 66."""
    @AdditionalPolarAngles.setter
    def AdditionalPolarAngles(self, value: System.Collections.Generic.IReadOnlyList[float]) -> None: ...
    @property
    def AngleOverride(self) -> float | None:
        """Gets or sets the direction an angle override typed at the prompt holds the cursor to, in radians
        counter-clockwise from the world's X axis, as CadCommandSession.AngleOverride gives it; null, as until
        set, for none. The cursor is held on the line through the base point at that angle, either side of it,
        over the grid, ortho and polar, and an object snap still wins, as AutoCAD 2021's help has it. With 30
        degrees from the origin, the cursor at (100, 0) is held at (75, 43.3)."""
    @AngleOverride.setter
    def AngleOverride(self, value: float | None) -> None: ...
    @property
    def GridOrigin(self) -> GeoPoint2:
        """Gets or sets the point the snap grid runs through, in the coordinates of ObjectSnap.Ucs, as AutoCAD's
        SNAPBASE; the origin until set."""
    @GridOrigin.setter
    def GridOrigin(self, value: GeoPoint2) -> None: ...
    @property
    def GridSnap(self) -> bool:
        """Gets or sets whether the cursor is put on the snap grid (SNAP, F9), or, while ObjectSnap.PolarSnap is on,
        on steps along the polar angles."""
    @GridSnap.setter
    def GridSnap(self, value: bool) -> None: ...
    @property
    def GridX(self) -> float:
        """Gets or sets the spacing of the snap grid along X; 10 until set."""
    @GridX.setter
    def GridX(self, value: float) -> None: ...
    @property
    def GridY(self) -> float:
        """Gets or sets the spacing of the snap grid along Y; 10 until set."""
    @GridY.setter
    def GridY(self, value: float) -> None: ...
    @property
    def IsOn(self) -> bool:
        """Gets or sets whether object snaps are on (OSNAP, F3)."""
    @IsOn.setter
    def IsOn(self, value: bool) -> None: ...
    @property
    def Isoplane(self) -> CadIsoplane | None:
        """Gets or sets the plane of an isometric snap, as AutoCAD's SNAPSTYL 1 with SNAPISOPAIR; null, as until
        set, for the rectangular snap of SNAPSTYL 0. The snap points then lie where the 30, 90 and 150 degree
        lines cross, twice ObjectSnap.GridY apart along each, as AutoCAD keeps half the vertical spacing in the
        drawing: SNAP Style Isometric 5 keeps a spacing of 8.6603 by 2.5, and the points lie 5 apart. Ortho holds
        the cursor on the two axes of the plane, whether the snap grid is on or not."""
    @Isoplane.setter
    def Isoplane(self, value: CadIsoplane | None) -> None: ...
    @property
    def LastSegment(self) -> GeoVector2 | None:
        """Gets or sets the direction of the last segment drawn, the way a line or the end of an arc ran, which the
        polar angles are counted from while ObjectSnap.PolarFromLastSegment is on; null, as until set, for none."""
    @LastSegment.setter
    def LastSegment(self, value: GeoVector2 | None) -> None: ...
    @property
    def Magnet(self) -> bool:
        """Gets or sets whether the cursor is drawn locked on a snap's point, the rubber band running to it, as
        AutoCAD's AUTOSNAP 4 (the magnet); on until set. Off, the rubber band follows the cursor, and a click
        still takes the snap."""
    @Magnet.setter
    def Magnet(self, value: bool) -> None: ...
    @property
    def Modes(self) -> CadSnapModes:
        """Gets or sets the object snaps that may be taken."""
    @Modes.setter
    def Modes(self, value: CadSnapModes) -> None: ...
    @property
    def Ortho(self) -> bool:
        """Gets or sets whether the cursor is held level or upright from the base point (ORTHO, F8)."""
    @Ortho.setter
    def Ortho(self, value: bool) -> None: ...
    @property
    def Override(self) -> CadSnapModes | None:
        """Gets or sets the object snaps of the next point alone, as AutoCAD's override typed at a point prompt
        (END, MID) or chosen from the Shift+right-click menu: taken in place of ObjectSnap.Modes, whether
        ObjectSnap.IsOn is on or off; CadSnapModes.None takes no object snap for that point (NONe). Null, as it
        is until set, for no override. The window clears it once the point is taken."""
    @Override.setter
    def Override(self, value: CadSnapModes | None) -> None: ...
    @property
    def Polar(self) -> bool:
        """Gets or sets whether the cursor is held on a polar angle from the base point when it comes near one
        (POLAR, F10)."""
    @Polar.setter
    def Polar(self, value: bool) -> None: ...
    @property
    def PolarAngle(self) -> float:
        """Gets or sets the polar increment in radians; a quarter turn until set."""
    @PolarAngle.setter
    def PolarAngle(self, value: float) -> None: ...
    @property
    def PolarDistance(self) -> float:
        """Gets or sets the step of ObjectSnap.PolarSnap, as AutoCAD's POLARDIST: nought, as until set, or below
        steps by ObjectSnap.GridX, the snap X spacing. It steps along the lines of object snap tracking from the
        points acquired too."""
    @PolarDistance.setter
    def PolarDistance(self, value: float) -> None: ...
    @property
    def PolarFromLastSegment(self) -> bool:
        """Gets or sets whether the polar angles are counted from the last segment drawn (ObjectSnap.LastSegment),
        as AutoCAD's POLARMODE 1 (Relative to last segment): off until set, when they are counted from the X axis
        of the UCS turned by ObjectSnap.SnapAngle, as they are where no segment has been drawn. With a polar
        angle of 90 and the last line drawn at 30 degrees, the cursor is held at 30, 120, 210 and 300 degrees
        from the base point."""
    @PolarFromLastSegment.setter
    def PolarFromLastSegment(self, value: bool) -> None: ...
    @property
    def PolarSnap(self) -> bool:
        """Gets or sets whether SNAP steps along the polar angles in place of the grid, as AutoCAD's SNAPTYPE 1
        (PolarSnap): off until set, as SNAPTYPE 0. With SNAP and POLAR on, the cursor held on a polar angle from
        the base point is put at a whole number of ObjectSnap.PolarDistance from it, so that with a distance of
        25 a cursor 37 along the level line from (0, 0) is put at (25, 0); off a polar angle, or with POLAR off,
        the cursor goes free."""
    @PolarSnap.setter
    def PolarSnap(self, value: bool) -> None: ...
    @property
    def ShowsMarker(self) -> bool:
        """Gets or sets whether the marker of a snap is drawn at its point, as AutoCAD's AUTOSNAP 1; on until
        set."""
    @ShowsMarker.setter
    def ShowsMarker(self, value: bool) -> None: ...
    @property
    def ShowsSnapTip(self) -> bool:
        """Gets or sets whether the name of a snap is shown by the cursor, as AutoCAD's AUTOSNAP 2 (the AutoSnap
        tooltip); on until set."""
    @ShowsSnapTip.setter
    def ShowsSnapTip(self, value: bool) -> None: ...
    @property
    def ShowsTrackingTip(self) -> bool:
        """Gets or sets whether the tip by the cursor, \"Ortho\" with the distance and the angle from the base
        point, is shown while the cursor is held by ortho, polar or a tracking line, as AutoCAD's AUTOSNAP 32
        (the tooltips of polar tracking, object snap tracking and Ortho mode); on until set."""
    @ShowsTrackingTip.setter
    def ShowsTrackingTip(self, value: bool) -> None: ...
    @property
    def SnapAngle(self) -> float:
        """Gets or sets the angle the snap grid is turned by about ObjectSnap.GridOrigin, in radians from the X axis
        of ObjectSnap.Ucs, as AutoCAD's SNAPANG; nought until set. Ortho holds the cursor along the turned axes
        and the polar angles are counted from it, as AutoCAD's are. With a snap of 10 turned by 30 degrees, the
        cursor at (9, 4) is put on (8.6603, 5), the point 10 along the turned X axis."""
    @SnapAngle.setter
    def SnapAngle(self, value: float) -> None: ...
    @property
    def Tolerance(self) -> Tolerance:
        """Gets the tolerance of the comparisons."""
    @property
    def Tracking(self) -> bool:
        """Gets or sets whether object snap tracking is on (OTRACK, F11): from each point acquired, lines run level
        and upright, or on every polar angle while ObjectSnap.Polar and ObjectSnap.TracksPolarAngles are on, and
        the cursor is held on one near it or where two cross."""
    @Tracking.setter
    def Tracking(self, value: bool) -> None: ...
    @property
    def TracksPolarAngles(self) -> bool:
        """Gets or sets whether object snap tracking runs its lines from the points acquired on every polar angle
        while ObjectSnap.Polar is on, as AutoCAD's POLARMODE 2 (Track using all polar angle settings): off until
        set, when they run level and upright alone, as POLARMODE 0 (Track orthogonally only). With a polar angle
        of 45 and a point acquired at (100, 0), the cursor at (130, 30.4) is held on the line at 45 degrees only
        while it is on."""
    @TracksPolarAngles.setter
    def TracksPolarAngles(self, value: bool) -> None: ...
    @property
    def Ucs(self) -> CadUcs:
        """Gets or sets the user coordinate system the grid, ortho and polar tracking follow, as AutoCAD's do: the
        grid runs along its axes, ortho holds the cursor along them, and polar angles are measured from its X
        axis. Object snaps give world points whatever it is. The world until set; null sets the world."""
    @Ucs.setter
    def Ucs(self, value: CadUcs | None) -> None: ...
    def Acquire(self, index: PickIndex, cursor: GeoPoint2, aperture: float, basePoint: GeoPoint2 | None = ...) -> bool:
        """The cursor has rested, as AutoCAD acquires a point when the cursor pauses on it: a point acquired before
        and within the aperture is let go; else, with object snap tracking on, the snap point under the cursor is
        acquired, and with Extension the end of a line or an arc there; else, with Parallel and a base point, the
        line under the cursor. A point acquired past the seventh lets the oldest go. A line 0,0 to 100,0 rested
        on at its end (99.6, 0.3) with Extension gives the end (100, 0) running on along +X."""
    def AcquireTrackPoint(self, point: GeoPoint2) -> None:
        """Acquires a point given rather than rested on, as AutoCAD's temporary track point (TT): while OTRACK is
        on, tracking lines run from it as from any point acquired, so that TT at (2 000, 0) holds the cursor near
        (2 000.3, 700) at (2 000, 700). It is drawn as a small cross and counts among the seven, the oldest let
        go first."""
    def ClearAcquired(self) -> None:
        """Lets every acquired point go, and the object clicked first for an apparent intersection: the window calls
        it once a point is taken or the prompt goes."""
    def Snap(
        self,
        index: PickIndex,
        cursor: GeoPoint2,
        aperture: float,
        basePoint: GeoPoint2 | None = ...,
        drawnFrom: GeoPoint2 | None = ...,
    ) -> CadSnapResult:
        """Gets the point a click at the cursor takes."""
    def TakeFirstObject(self, result: CadSnapResult) -> bool:
        """Picks the object an CadSnapKind.ExtendedApparentIntersection offers as the first of two, as a click on it
        does in AutoCAD: the point is not taken, and the object under the cursor after gives where the two would
        cross, run on. Two lines 0,0 to 10,0 and 20,5 to 20,10, the first picked, give (20, 0) from anywhere on
        the second."""

class PickIndex(System.Object):
    """A grid over the items of one display list that answers, without looking at every item, which of them lie near
    a point or in a box. Picking and window selection never use the pixels: they ask this index in drawing
    coordinates.

    The selections by a polygon and by a fence: WPolygon, CPolygon, Fence and the lasso."""
    def __init__(self, list: DisplayList2) -> None:
        """Indexes a display list."""
    @property
    def List(self) -> DisplayList2:
        """Gets the display list this index was made from."""
    def Crossing(self, box: DisplayBox) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities that cross or lie in a box, as a crossing selection takes them."""
    def CrossingPolygon(
        self,
        ring: System.Collections.Generic.IReadOnlyList[GeoPoint2],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities a polygon touches, as AutoCAD's CPolygon takes them, and a lasso drawn
        counter-clockwise: those an item of which lies inside it or crosses its edges, and a fill it lies inside."""
    def Fence(
        self,
        fence: System.Collections.Generic.IReadOnlyList[GeoPoint2],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities a fence crosses, as AutoCAD's Fence takes them: those an item of which meets one of the
        fence's segments, touching it counted. A fence from (0, 5) to (30, 5) takes a line from (10, 0) to (10,
        10), not one from (10, 6) to (20, 6). A fence of fewer than two points takes nothing."""
    def IndicesIn(self, box: DisplayBox) -> System.Collections.Generic.IReadOnlyList[int]:
        """Gets the items whose box meets a box, by their place in PickIndex.List, in the order they are drawn,
        items with no handle among them: what the canvas draws of a view. A view of a tenth of a drawing of 100
        000 items looks at about a tenth of them."""
    def IndicesOf(self, handle: str) -> System.Collections.Generic.IReadOnlyList[int]:
        """Gets the items an entity is drawn as, by their place in PickIndex.List, in the order they are drawn: a
        block of 40 lines inserted once gives 40 places. The canvas draws a hovered or selected entity again over
        the drawing from them, without looking at the other items."""
    def ItemsNear(self, box: DisplayBox) -> System.Collections.Generic.IReadOnlyList[DisplayItem2]:
        """Gets the items whose box meets a box, in the order they are drawn, as object snaps ask for what lies
        under the cursor's aperture. Items with no handle are left out, and so is a line without end (XLINE, RAY)
        that passes the box by further than the box's own size, unless it is drawn for a block reference, whose
        insertion point a snap takes from any of its items: an XLINE level through (0, 300) comes for the box
        from (5000, 299) to (5002, 301), not for the one from (5000, 310) to (5002, 312)."""
    def Pick(self, x: float, y: float, tolerance: float) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities whose drawing lies within a distance of a point, in the order AutoCAD picks them. The
        distance is in drawing units, so a caller working in pixels divides by the zoom first. While the
        drawing's SORTENTS holds its bit 1 for object selection, as AutoCAD's default 127 does, the one drawn on
        top (last in the draw order) comes first, however much nearer the others lie; else the one drawn first.
        AutoCAD 2021's (ssget pt) on two level lines, the one drawn later 0.9 of the pickbox off the point and
        the other through it, picks the later one, and under SORTENTS 0 the one drawn first. A line through the
        point and one drawn on top of it 2.7 off, with a tolerance of 3, come back the one on top first."""
    def Window(self, box: DisplayBox) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities drawn wholly inside a box, as a window selection takes them."""
    def WindowPolygon(
        self,
        ring: System.Collections.Generic.IReadOnlyList[GeoPoint2],
    ) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the entities drawn wholly inside a polygon, as AutoCAD's WPolygon takes them, and a lasso drawn
        clockwise: every item of the entity inside it and none crossing its edges. A line from (10, 10) to (20,
        10) lies in the square from (0, 0) to (30, 30); a line without end never does."""

class ShxFont(System.Object):
    """A compiled SHX font read from the bytes of its file, of the three forms AutoCAD writes (ShxFontKind), its
    letters drawn by their pen codes into strokes as AutoCAD draws them: romans.shx's capitals reach
    ShxFont.Above 21 units above the baseline, so that a text 2.5 high draws them at 2.5 / 21 of a millimetre to
    the unit."""
    @property
    def Above(self) -> float:
        """Gets how far the capitals reach above the baseline in the font's units, the height of a text: 6 for
        txt.shx, 21 for romans.shx."""
    @property
    def Below(self) -> float:
        """Gets how far the letters reach below the baseline in the font's units: 2 for txt.shx, 7 for
        romans.shx."""
    @property
    def Count(self) -> int:
        """Gets the number of letters and shapes the font holds, shape 0 left out."""
    @property
    def Kind(self) -> ShxFontKind:
        """Gets the form of the file."""
    def GlyphOf(self, number: int) -> ShxGlyph:
        """Gets a letter of the font drawn into its strokes, drawn once and kept; null where the font has none of
        that number."""
    def Has(self, number: int) -> bool:
        """Gets whether the font has a letter or shape of a number: a byte in a font of shapes, a Unicode number in
        a unifont, two bytes in a big font."""
    def Opens(self, lead: int) -> bool:
        """Gets whether a byte opens a letter of two bytes in a big font, by its ranges: 0xD6 in gbcbig.shx; false
        in a font of another form."""
    @staticmethod
    def Read(bytes: Sequence[int] | System.Array[int]) -> ShxFont:
        """Reads a font from the bytes of a compiled SHX file; null where they are no font of the forms of
        ShxFontKind, are cut short, or give a font of letters no height above its baseline."""

class ShxFontKind(System.Enum):
    """The form of a compiled SHX file, as its first line names it."""
    BigFont: ClassVar[ShxFontKind]
    """AutoCAD-86 bigfont 1.0: letters of two bytes of a code page, drawn beside a style's font."""
    Shapes: ClassVar[ShxFontKind]
    """AutoCAD-86 shapes 1.0 or 1.1: letters by their byte, shape 0 the font's name and size."""
    Unifont: ClassVar[ShxFontKind]
    """AutoCAD-86 unifont 1.0: letters by their Unicode number."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class ShxGlyph(System.Object):
    """A letter of an SHX font drawn by its pen: the strokes it inks, each a polyline of x, y pairs in the font's
    units, its arcs cut into chords of at most 11.25 degrees, and how far it moves the pen along the baseline for
    the next letter."""
    @property
    def Advance(self) -> float:
        """Gets how far the letter moves the pen along the baseline, in the font's units: 6 for the A of txt.shx."""
    @property
    def Strokes(self) -> System.Collections.Generic.IReadOnlyList[System.Array[float]]:
        """Gets the strokes, each a polyline of x, y pairs in the font's units from the letter's start on the
        baseline; empty for a space."""
