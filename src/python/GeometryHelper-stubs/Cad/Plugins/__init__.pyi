    def AddTrustedFolder(self, folder: str) -> bool:
        """Adds a trusted folder, whose plugins load without asking, and writes the list."""
    def Attach(self, registry: CadCommandRegistry) -> System.Collections.Generic.IReadOnlyList[str]:
        """Adds the commands of the loaded plugins to a registry, and those of every plugin loaded later, with
        PLUGINLOAD (alias NETLOAD), PLUGINUNLOAD and PLUGINRELOAD, which ask on the command line for a path or a
        name. A command the registry has already is left, so that the window's own PLUGINLOAD, which shows a file
        dialog, can be added first."""
    def Detach(self, registry: CadCommandRegistry) -> bool:
        """Takes the plugins' commands and those CadPluginManager.Attach added out of a registry, as when its
        drawing is closed."""
    def Dispose(self) -> None:
        """Unloads every plugin and deletes the copies of their files that can be deleted; a copy the runtime still
        holds is deleted at a later start."""
    def Find(self, name: str) -> CadLoadedPlugin:
        """Finds a plugin known in this session by its name, either case the same."""
    def IsTrusted(self, path: str) -> bool:
        """Gets whether a file or folder lies in one of the trusted folders."""
    def Load(self, path: str) -> CadPluginResult:
        """Loads a plugin for this session, as PLUGINLOAD and NETLOAD do: from a .dll (with the plugin.json beside
        it, where there is one), or the folder of a plugin. Its commands are added to every registry attached.
        Refused, with the reason, where the path is outside the trusted folders and not confirmed, the plugin
        needs a newer API, a plugin of its name or path is loaded already, or it has no command."""
    def LoadAtStart(self) -> System.Collections.Generic.IReadOnlyList[CadPluginResult]:
        """Loads what is loaded at every start: each .dll directly in the plugin folder, in ordinal order of the
        names (either case the same), then each subfolder of it as one plugin (one with a plugin.json, or with a
        .dll directly in it), in the same order, then the startup list in its order. A subfolder with neither is
        passed over. The plugin folder is trusted, so nothing is asked. A plugin loaded already is left; each
        other is a line of the log, and a .dll that is no plugin, or cannot be loaded, is refused with its line
        and does not stop the others."""
    def Reload(self, name: str) -> CadPluginResult:
        """Loads a plugin again from its file, as PLUGINRELOAD does, unloading it first where it is loaded: a
        plugin's author changes its code, builds it and reloads it with the presenter running. On .NET Framework
        the build loaded first in the session stays, and the result says so."""
    def RemoveTrustedFolder(self, folder: str) -> bool:
        """Takes a trusted folder off the list and writes it; the plugin folder stays trusted."""
    def SetLoadAtStartup(self, name: str, loadAtStartup: bool) -> bool:
        """Puts a plugin on the startup list, or takes it off, and writes the list; a plugin of the plugin folder is
        loaded at every start anyway."""
    def Unload(self, name: str) -> CadPluginResult:
        """Unloads a plugin, as PLUGINUNLOAD does: its commands go from every registry, and a run of one going on
        fails at its next step. On .NET 8 its load context is freed; on .NET Framework its code stays loaded,
        switched off, until the presenter restarts. It stays in CadPluginManager.Plugins, so that it can be
        loaded again."""
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class CadPluginManifest(System.Object):
    """What a plugin says of itself in its plugin.json, read without loading its code (D18 of the plan): { \"id\":
    \"number-circles\", \"name\": \"Number circles\", \"version\": \"1.0.0\", \"author\": \"Nguyen Thang\",
    \"kind\": \"command\", \"minimumApiVersion\": \"1.0\", \"commands\": [ \"NUMCIRCLES\" ], \"icon\":
    \"icon.png\" } Only the name is needed; the id is the name where not given, the kind \"command\", the API
    version 1.0."""
    CommandKind: ClassVar[str]
    """The kind of a command plugin, the only kind this presenter loads: \"command\"."""
    DrawingKind: ClassVar[str]
    """The kind of a drawing plugin of a model drawing library: \"drawing\". The presenter alone refuses it; a
    manager given a CadPluginManager.DrawingPluginFinder loads it."""
    FileName: ClassVar[str]
    """The name of the manifest's file: plugin.json."""
    @property
    def Author(self) -> str:
        """Gets the author; empty where not given."""
    @property
    def Commands(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names of the commands, in capitals, in the order written."""
    @property
    def Icon(self) -> str:
        """Gets the path of the icon, relative to the manifest; null where not given."""
    @property
    def Id(self) -> str:
        """Gets the id, a short name for the plugin; the name where not given."""
    @property
    def Kind(self) -> str:
        """Gets the kind, in small letters: \"command\" for a command plugin."""
    @property
    def MinimumApiVersion(self) -> System.Version:
        """Gets the least version of the plugin API the plugin needs; 1.0 where not given."""
    @property
    def Name(self) -> str:
        """Gets the name, which the Plugin manager shows and PLUGINUNLOAD and PLUGINRELOAD are given."""
    @property
    def Version(self) -> str:
        """Gets the plugin's version, as written; empty where not given."""
    @staticmethod
    def Parse(json: str) -> CadPluginManifest:
        """Reads a manifest from its JSON text."""
    @staticmethod
    def Read(path: str) -> CadPluginManifest:
        """Reads a manifest from a plugin.json file, without loading any code."""
    def Refusal(self) -> str:
        """Says why the presenter does not load the plugin, or null where it may: a kind other than \"command\", or
        a newer version of the plugin API than CadPlugin.ApiVersion."""
    def ToString(self) -> str: ...

class CadPluginMenuItem(System.Object):
    """An item of a menu a plugin adds to, as the presenter's CadExtensionMenuItem is for an extension: a line that
    runs a callback, a submenu, or a separator, ticked or not, on or off."""
    @overload
    def __init__(
        self,
        text: str,
        run: System.Action[CadPluginContext],
        isEnabled: bool = ...,
        isChecked: bool | None = ...,
    ) -> None:
        """Makes an item that runs a callback."""
    @overload
    def __init__(
        self,
        text: str,
        items: System.Collections.Generic.IReadOnlyList[CadPluginMenuItem],
        isEnabled: bool = ...,
        isChecked: bool | None = ...,
    ) -> None:
        """Makes an item that opens a submenu."""
    @property
    def IsChecked(self) -> bool | None:
        """Gets the tick: null for none, true for a ticked item, false for a tick box not ticked."""
    @property
    def IsEnabled(self) -> bool:
        """Gets whether the item can be chosen."""
    @property
    def IsSeparator(self) -> bool:
        """Gets whether the item is a separator line."""
    @property
    def Items(self) -> System.Collections.Generic.IReadOnlyList[CadPluginMenuItem]:
        """Gets the items of a submenu; empty for the others."""
    @property
    def Run(self) -> System.Action[CadPluginContext]:
        """Gets the callback; null for a submenu and a separator."""
    @property
    def Text(self) -> str:
        """Gets the text; empty for a separator."""
    @staticmethod
    def Separator() -> CadPluginMenuItem:
        """Makes a separator line."""

class CadPluginResult(System.Object):
    """What came of a load, unload or reload: whether it was done, the sentence the command line writes, and what
    was left out."""
    @property
    def Message(self) -> str:
        """Gets what came of it, in a sentence, or why it was refused."""
    @property
    def Plugin(self) -> CadLoadedPlugin:
        """Gets the plugin; null where none was found."""
    @property
    def Succeeded(self) -> bool:
        """Gets whether it was done."""
    @property
    def Warnings(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets what was left out, a line each: a method that cannot be a command, a command or alias already
        taken."""
    def ToString(self) -> str: ...

class CadPluginSetting(System.Object):
    """One setting a plugin declares with CadSettingAttribute: its label, kind, default and range, as the presenter
    draws them, and its value, read from and written to the plugin's property. A text height declared with
    Minimum = 0.1 and set to 0.05 is refused, and the plugin keeps the height it had."""
    @property
    def Choices(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the names a choice offers, in the order the enumeration declares them; empty for any other kind."""
    @property
    def Default(self) -> Any:
        """Gets the value the property had when the plugin was loaded: a double, an int, a bool, a string or, for a
        choice, the name of the value."""
    @property
    def Description(self) -> str:
        """Gets what the setting does; null for nothing."""
    @property
    def Kind(self) -> CadSettingKind:
        """Gets the kind of value it holds."""
    @property
    def Label(self) -> str:
        """Gets the label the presenter shows: \"Text height\"."""
    @property
    def Maximum(self) -> float:
        """Gets the greatest value of a number, inclusive; infinity for none."""
    @property
    def Minimum(self) -> float:
        """Gets the least value of a number, inclusive; minus infinity for none."""
    @property
    def Name(self) -> str:
        """Gets the name of the property: TextHeight."""
    @property
    def Value(self) -> Any:
        """Gets or sets the value: a double, an int, a bool, a string or, for a choice, the name of the value. A
        value of another type is converted as the invariant culture reads it, so \"2.5\" sets a number."""
    @Value.setter
    def Value(self, value: object) -> None: ...
    def ToString(self) -> str: ...

class CadPropertyProvider(System.Object):
    """What a plugin gives the Properties panel, as the extension's DescribeSelection does: it gets the request and
    returns what the panel shows, typically the groups it was given and its own besides. Null shows the panel as
    it was. Providers run after the extensions, in the order the plugins were loaded; one that throws is passed
    over for that call, with a Warn. A row with a setter is committed by the window as an extension's row is."""
    def __init__(self, function: Callable[[CadPropertyRequest], CadSelectionInfo]) -> None: ...
    def __call__(self, request: CadPropertyRequest) -> CadSelectionInfo: ...

class CadPropertyRequest(System.Object):
    """What a Properties provider is given when the panel is read: the drawing, the objects shown and what the panel
    shows so far, the presenter's groups and those of the extensions."""
    @property
    def Banner(self) -> str:
        """Gets or sets the banner the panel shows over its groups, as an extension's DescribeSelection gives it:
        null, as it is until a provider sets it, for none."""
    @Banner.setter
    def Banner(self, value: str | None) -> None: ...
    @property
    def Document(self) -> CadDocument:
        """Gets the drawing."""
    @property
    def Handles(self) -> System.Collections.Generic.IReadOnlyList[str]:
        """Gets the handles of the objects shown, in ordinal order; empty for none."""
    @property
    def Shown(self) -> CadSelectionInfo:
        """Gets what the panel shows so far."""

class CadRibbonButton(CadRibbonItem):
    """A button that starts a command, as a button of the presenter's own ribbon does, or runs a callback of the
    plugin at once on the window's thread."""
    @overload
    def __init__(self, text: str, run: System.Action[CadPluginContext]) -> None:
        """Makes a button that runs a callback at once, on the window's thread."""
    @overload
    def __init__(self, text: str, command: str) -> None:
        """Makes a button that starts a command: a command running is cancelled first, as AutoCAD's ^C^C is."""
    @property
    def CanRun(self) -> System.Func[CadPluginContext, bool]:
        """Gets or sets whether the button is on, asked when the window asks its commands again (the selection, the
        drawing or a command changes). Null, until set: a button that starts a command is on while a drawing is
        open, one that runs a callback always. A predicate that throws gives false."""
    @CanRun.setter
    def CanRun(self, value: System.Func[CadPluginContext, bool] | None) -> None: ...
    @property
    def Command(self) -> str:
        """Gets the command the button starts; null for a button that runs a callback."""
    @property
    def Run(self) -> System.Action[CadPluginContext]:
        """Gets the callback the button runs; null for a button that starts a command."""

class CadRibbonItem(System.Object):
    """What a panel holds: a CadRibbonButton or a CadRibbonSplitButton."""
    @property
    def Description(self) -> str:
        """Gets or sets the body of the tooltip; null, until set, for none."""
    @Description.setter
    def Description(self, value: str | None) -> None: ...
    @property
    def Icon(self) -> CadPluginIcon:
        """Gets or sets the icon; null for the presenter's plugin icon."""
    @Icon.setter
    def Icon(self, value: CadPluginIcon | None) -> None: ...
    @property
    def ShowText(self) -> bool:
        """Gets or sets whether the text is drawn: true until set; a standard item with no text shows its icon
        alone."""
    @ShowText.setter
    def ShowText(self, value: bool) -> None: ...
    @property
    def Size(self) -> CadRibbonItemSize:
        """Gets or sets how big the item is drawn: CadRibbonItemSize.Standard until set."""
    @Size.setter
    def Size(self, value: CadRibbonItemSize) -> None: ...
    @property
    def Text(self) -> str:
        """Gets the text under or beside the icon."""
    @property
    def ToolTip(self) -> str:
        """Gets or sets the title line of the tooltip; null, until set, for CadRibbonItem.Text."""
    @ToolTip.setter
    def ToolTip(self, value: str | None) -> None: ...

class CadRibbonItemSize(System.Enum):
    """How big an item of a panel is drawn."""
    Large: ClassVar[CadRibbonItemSize]
    """The icon 32 pixels over the text, alone in its column."""
    Standard: ClassVar[CadRibbonItemSize]
    """The icon 16 pixels beside the text, or alone where CadRibbonItem.ShowText is false; three to a column."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadRibbonPanel(System.Object):
    """A panel of a ribbon tab: a titled row of items, as AutoCAD's RibbonPanel."""
    def __init__(self, title: str) -> None:
        """Makes a panel."""
    @property
    def Items(self) -> System.Collections.Generic.IList[CadRibbonItem]:
        """Gets the items, left to right: a large item stands alone in its column, and standard items that follow
        one another stack in columns of three, top down, as AutoCAD's row panels do."""
    @property
    def Title(self) -> str:
        """Gets the title under the panel."""

class CadRibbonSplitButton(CadRibbonItem):
    """A button with a drop-down of others, as AutoCAD's Circle button is: the part on top runs one button, the
    arrow lists them all. With CadRibbonSplitButton.RemembersLast the top shows and runs the one used last."""
    def __init__(self, text: str, buttons: System.Collections.Generic.IReadOnlyList[CadRibbonButton]) -> None:
        """Makes a split button."""
    @property
    def Buttons(self) -> System.Collections.Generic.IReadOnlyList[CadRibbonButton]:
        """Gets the buttons of the drop-down, in the order given."""
    @property
    def RemembersLast(self) -> bool:
        """Gets or sets whether the top shows and runs the button used last, as AutoCAD's Circle split does: true
        until set; false for always the first."""
    @RemembersLast.setter
    def RemembersLast(self, value: bool) -> None: ...

class CadRibbonTab(System.Object):
    """A tab of the ribbon a plugin adds, as AutoCAD's RibbonTab: panels of buttons. It comes after the Plugins tab
    and before Settings, in the order the plugins were loaded; with CadRibbonTab.ShowWhen set it is a contextual
    tab instead, green and shown only while the answer is true."""
    def __init__(self, id: str, title: str) -> None:
        """Makes a tab."""
    @property
    def Id(self) -> str:
        """Gets the tab's identity."""
    @property
    def Panels(self) -> System.Collections.Generic.IList[CadRibbonPanel]:
        """Gets the panels, left to right; read when ICadPluginApplication.Initialize returns."""
    @property
    def ShowWhen(self) -> System.Func[CadPluginContext, bool]:
        """Gets or sets what makes the tab contextual, as AutoCAD's Text Editor tab is: asked when the selection,
        the drawing or a command changes, the tab is shown, selected as it appears, while it answers true, and
        goes with Home selected again when it answers false. Null, until set, for a tab that is always shown. A
        callback that throws gives false."""
    @ShowWhen.setter
    def ShowWhen(self, value: System.Func[CadPluginContext, bool] | None) -> None: ...
    @property
    def Title(self) -> str:
        """Gets the title on the tab strip."""

class CadSettingAttribute(System.Attribute):
    """Marks a public property of a plugin's class as a setting the presenter shows and the user changes, as
    [CadSetting(\"Text height\", Minimum = 0.1)] public double TextHeight { get; set; } = 2.5;. The property is
    read for its default once the plugin is loaded, and its value is set through CadPluginSetting.Value; its type
    is double, int, bool, string or an enumeration, and the presenter draws a box for it of its own (D17 of the
    plan), so a plugin never touches the window."""
    def __init__(self, label: str) -> None:
        """Marks a property as a setting with the label the presenter shows."""
    @property
    def Description(self) -> str:
        """Gets or sets what the setting does, as the presenter shows it under the label; null for nothing."""
    @Description.setter
    def Description(self, value: str | None) -> None: ...
    @property
    def Label(self) -> str:
        """Gets the label the presenter shows."""
    @property
    def Maximum(self) -> float:
        """Gets or sets the greatest value of a number, inclusive; infinity, for none, until set."""
    @Maximum.setter
    def Maximum(self, value: float) -> None: ...
    @property
    def Minimum(self) -> float:
        """Gets or sets the least value of a number, inclusive; minus infinity, for none, until set."""
    @Minimum.setter
    def Minimum(self, value: float) -> None: ...

class CadSettingKind(System.Enum):
    """What kind of value a plugin's setting holds, and so which box the presenter draws for it."""
    Boolean: ClassVar[CadSettingKind]
    """Yes or no, a bool: a check box."""
    Choice: ClassVar[CadSettingKind]
    """One of a list, an enumeration: a drop-down of its names."""
    Integer: ClassVar[CadSettingKind]
    """A whole number, an int: a start number of 1."""
    Number: ClassVar[CadSettingKind]
    """A number with a fraction, a double: a text height of 2.5."""
    Text: ClassVar[CadSettingKind]
    """A text, a string: a layer name."""
    def __init__(self, value: int) -> None: ...
    def __int__(self) -> int: ...

class CadSnapFinder(System.Object):
    """Works out the points of a custom snap for the entity under the cursor, in the world coordinates of the space
    shown; those farther from the cursor than the aperture are dropped. It is called once per entity per mouse
    move, so it should be quick; one that throws is switched off for the session, with a Warn and a line on the
    command line."""
    def __init__(self, function: Callable[[CadSnapRequest], System.Collections.Generic.IEnumerable[GeoPoint2]]) -> None: ...
    def __call__(self, request: CadSnapRequest) -> System.Collections.Generic.IEnumerable[GeoPoint2]: ...

class CadSnapRequest(System.Object):
    """What a CadSnapFinder is given: the top-level entity under the aperture and where the cursor is."""
    @property
    def Aperture(self) -> float:
        """Gets how near a point must lie to the cursor to be taken, in drawing units: the aperture in pixels over
        the pixels a unit is drawn."""
    @property
    def BasePoint(self) -> GeoPoint2 | None:
        """Gets the point the rubber band is drawn from, as the built-in perpendicular works from it; null for
        none."""
    @property
    def Cursor(self) -> GeoPoint2:
        """Gets the cursor, in the world coordinates of the space shown."""
    @property
    def Document(self) -> CadDocument:
        """Gets the drawing; null where the snap was asked without one."""
    @property
    def Entity(self) -> DxfEntity:
        """Gets the entity, which the finder reads and must not change."""
    @property
    def Handle(self) -> str:
        """Gets the handle of the entity."""

class ICadPluginApplication(System.Object):
    """The entry point of a plugin that adds to the window, as AutoCAD's IExtensionApplication is: a public class
    with a public constructor that takes nothing, which the presenter makes once when the plugin is loaded and
    ICadPluginApplication.Initializes, so that the plugin adds its ribbon tabs and panels, Properties rows,
    DRAWINGS buttons and menu items, canvas menu items and object snaps to the CadPluginHost.
    ICadPluginApplication.Terminate runs when the plugin is unloaded or reloaded, or the presenter closes."""
    def Initialize(self, host: CadPluginHost) -> None:
        """Runs once, when the plugin is loaded, before any of its commands: the place to call the host's Add
        methods. What it adds is read when it returns. An exception it throws keeps the plugin's commands and
        drops everything it added, with a line in CadPlugin.Problems."""
    def Terminate(self) -> None:
        """Runs once when the plugin is unloaded or reloaded, or the presenter closes, before its commands go: the
        place to let go of what the plugin holds. An exception it throws is logged and the unload goes on."""
