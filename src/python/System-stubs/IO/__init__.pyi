# Hand-written stubs of System.IO (see System-stubs/__init__.pyi).
from System import IDisposable

class Stream(IDisposable):
    @property
    def CanRead(self) -> bool: ...
    @property
    def CanWrite(self) -> bool: ...
    @property
    def Length(self) -> int: ...
    @property
    def Position(self) -> int: ...
    @Position.setter
    def Position(self, value: int) -> None: ...
    def Close(self) -> None: ...
    def Flush(self) -> None: ...

class TextWriter(IDisposable):
    def Close(self) -> None: ...
    def Flush(self) -> None: ...
    def Write(self, value: str) -> None: ...
    def WriteLine(self, value: str) -> None: ...
