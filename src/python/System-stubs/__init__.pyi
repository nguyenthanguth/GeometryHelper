# Hand-written stubs of the .NET types that the stubs of GeometryHelper name (the table of GeometryHelper.PyStubs). They
# carry only what a script touches. pythonnet makes the module System at run time; these stubs are for the editor.
import builtins
from collections.abc import Iterable, Iterator
from typing import Any, Callable, ClassVar, Generic, TypeVar, TypeVarTuple, Unpack, overload

from System.Collections.Generic import IList, IReadOnlyList

_T = TypeVar("_T")
_A = TypeVar("_A")
_B = TypeVar("_B")
_R = TypeVar("_R")
_Ts = TypeVarTuple("_Ts")

# The scalar types as pythonnet spells them in Array[Double]: the Python type the stubs give them.
Boolean = bool
Byte = int
SByte = int
Int16 = int
UInt16 = int
Int32 = int
UInt32 = int
Int64 = int
UInt64 = int
Single = float
Double = float
Decimal = float
String = str
Char = str

class Object:
    def Equals(self, obj: object) -> bool: ...
    def GetHashCode(self) -> int: ...
    def GetType(self) -> Type: ...
    def ToString(self) -> str: ...

class ValueType(Object): ...
class Enum(ValueType): ...

class Array(IList[_T], IReadOnlyList[_T]):
    """A .NET array: Array[Double](3) makes three zeros, Array[GeoPoint3]([p, q]) copies a list."""

    @overload
    def __init__(self, length: int) -> None: ...
    @overload
    def __init__(self, values: Iterable[_T]) -> None: ...
    @property
    def Length(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> _T: ...
    def __setitem__(self, index: int, value: _T) -> None: ...
    def __iter__(self) -> Iterator[_T]: ...

class Type(Object):
    @property
    def FullName(self) -> str: ...
    @property
    def Name(self) -> str: ...
    @property
    def Namespace(self) -> str: ...

class Exception(builtins.Exception, Object):
    @property
    def InnerException(self) -> Exception | None: ...
    @property
    def Message(self) -> str: ...
    @property
    def StackTrace(self) -> str: ...

class EventArgs(Object):
    Empty: ClassVar[EventArgs]

class EventHandler(Object, Generic[_T]):
    """An event: the non-generic EventHandler of .NET is written EventHandler[EventArgs]. Assigning the result of += back
    is what Python does for doc.Changed += handler."""

    def __iadd__(self, handler: Callable[[Any, _T], object]) -> EventHandler[_T]: ...
    def __isub__(self, handler: Callable[[Any, _T], object]) -> EventHandler[_T]: ...

class Action(Object, Generic[Unpack[_Ts]]):
    """A .NET Action. pythonnet refuses a Python function where a delegate is wanted, so it is made from one first:
    Action[int](f). The plain Action is Action[()]."""

    def __init__(self, function: Callable[[Unpack[_Ts]], object]) -> None: ...
    def __call__(self, *args: Unpack[_Ts]) -> None: ...

class Func(Object, Generic[Unpack[_Ts], _R]):
    """A .NET Func: Func[str, float](f) is made from a function of a string that gives a float."""

    def __init__(self, function: Callable[[Unpack[_Ts]], _R]) -> None: ...
    def __call__(self, *args: Unpack[_Ts]) -> _R: ...

class Attribute(Object): ...

class IDisposable(Object):
    def Dispose(self) -> None: ...

class IProgress(Object, Generic[_T]):
    def Report(self, value: _T) -> None: ...

class IComparable(Object, Generic[_T]):
    def CompareTo(self, obj: _T) -> int: ...

class IEquatable(Object, Generic[_T]):
    def Equals(self, other: _T) -> bool: ...  # type: ignore[override]

class IFormattable(Object): ...
class IConvertible(Object): ...

class DateTime(ValueType):
    @property
    def Day(self) -> int: ...
    @property
    def Hour(self) -> int: ...
    @property
    def Minute(self) -> int: ...
    @property
    def Month(self) -> int: ...
    @property
    def Second(self) -> int: ...
    @property
    def Ticks(self) -> int: ...
    @property
    def Year(self) -> int: ...
    Now: ClassVar[DateTime]
    UtcNow: ClassVar[DateTime]

class TimeSpan(ValueType):
    @property
    def Ticks(self) -> int: ...
    @property
    def TotalMilliseconds(self) -> float: ...
    @property
    def TotalSeconds(self) -> float: ...

class Version(Object):
    @property
    def Build(self) -> int: ...
    @property
    def Major(self) -> int: ...
    @property
    def Minor(self) -> int: ...
    @property
    def Revision(self) -> int: ...

class ValueTuple(ValueType, Generic[_A, _B]):
    @property
    def Item1(self) -> _A: ...
    @property
    def Item2(self) -> _B: ...
