# Hand-written stubs of System.Collections.Generic (see System-stubs/__init__.pyi).
#
# pythonnet hands a collection over as the interface it is declared as, and only some Python protocols work on it: an
# IReadOnlyList can be iterated, indexed from 0 and asked for its Count, but len() and negative or sliced indexes
# raise. So __len__ is written only for List and Dictionary, where it works; everywhere else use Count.
from collections.abc import Iterator
from typing import Generic, TypeVar, overload

import System.Collections
from System import Object, ValueType

_T = TypeVar("_T")
_T_co = TypeVar("_T_co", covariant=True)
_K = TypeVar("_K")
_V = TypeVar("_V")

class IEnumerable(System.Collections.IEnumerable, Generic[_T_co]):
    def __iter__(self) -> Iterator[_T_co]: ...

class IEnumerator(System.Collections.IEnumerator, Generic[_T_co]):
    @property
    def Current(self) -> _T_co: ...

class ICollection(IEnumerable[_T]):
    @property
    def Count(self) -> int: ...
    def __contains__(self, item: object) -> bool: ...

class IList(ICollection[_T]):
    def __getitem__(self, index: int) -> _T: ...
    def __setitem__(self, index: int, value: _T) -> None: ...

class List(IList[_T]):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, capacity: int) -> None: ...
    def Add(self, item: _T) -> None: ...
    def __len__(self) -> int: ...

class IReadOnlyCollection(IEnumerable[_T_co]):
    @property
    def Count(self) -> int: ...
    def __contains__(self, item: object) -> bool: ...

class IReadOnlyList(IReadOnlyCollection[_T_co]):
    def __getitem__(self, index: int) -> _T_co: ...

class ISet(ICollection[_T]):
    def Add(self, item: _T) -> bool: ...

class HashSet(ISet[_T]): ...

class KeyValuePair(ValueType, Generic[_K, _V]):
    @property
    def Key(self) -> _K: ...
    @property
    def Value(self) -> _V: ...

class IReadOnlyDictionary(IReadOnlyCollection[KeyValuePair[_K, _V]], Generic[_K, _V]):
    def __getitem__(self, key: _K) -> _V: ...
    def ContainsKey(self, key: _K) -> bool: ...
    @property
    def Keys(self) -> IEnumerable[_K]: ...
    @property
    def Values(self) -> IEnumerable[_V]: ...

class IDictionary(ICollection[KeyValuePair[_K, _V]], Generic[_K, _V]):
    def __getitem__(self, key: _K) -> _V: ...
    def __setitem__(self, key: _K, value: _V) -> None: ...
    def Add(self, key: _K, value: _V) -> None: ...
    def ContainsKey(self, key: _K) -> bool: ...
    def Remove(self, key: _K) -> bool: ...
    @property
    def Keys(self) -> ICollection[_K]: ...
    @property
    def Values(self) -> ICollection[_V]: ...

class Dictionary(IDictionary[_K, _V], IReadOnlyDictionary[_K, _V]):
    def __len__(self) -> int: ...

class SortedDictionary(IDictionary[_K, _V], IReadOnlyDictionary[_K, _V]): ...

class IComparer(Object, Generic[_T]):
    def Compare(self, x: _T, y: _T) -> int: ...
