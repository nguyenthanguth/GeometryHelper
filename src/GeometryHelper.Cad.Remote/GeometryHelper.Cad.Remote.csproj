<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>GeometryHelper.Cad.Remote</RootNamespace>
        <AssemblyName>GeometryHelper.Cad.Remote</AssemblyName>
        <Description>Drives a running GeometryHelper CAD from another program: finds the app, lists its drawings, reads and edits their entities and sends commands, the way a Tekla Open API program drives a running Tekla Structures.</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeometryHelper\GeometryHelper.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GeometryHelper.Cad" />
        <InternalsVisibleTo Include="GeometryHelper.Cad.Remote.UnitTest" />
        <InternalsVisibleTo Include="GeometryHelper.Cad.Wpf.UnitTest" />
    </ItemGroup>
</Project>
