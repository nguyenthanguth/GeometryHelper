<UserControl x:Class="GeometryHelper.Drawing.Wpf.DrawingRibbonTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gh="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf;assembly=GeometryHelper.Dxf.Viewer.Wpf"
             FontFamily="{DynamicResource GhFont}" FontSize="12" Foreground="#E6E9ED">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Drawing.Wpf;component/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The icons of the Drawing tab, the paths of the design. -->
            <Geometry x:Key="IconNewDrawing">M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M12 11v6M9 14h6</Geometry>
            <Geometry x:Key="IconUpdate">M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6</Geometry>
            <Geometry x:Key="IconGear">M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM4 12h2M18 12h2M12 4v2M12 18v2</Geometry>
            <Geometry x:Key="IconAddView">M4 4h16v16H4zM12 8v8M8 12h8</Geometry>
            <Geometry x:Key="IconSection">M4 12h4M10 12h4M16 12h4M7 6v12M17 6v12</Geometry>
            <Geometry x:Key="IconDetail">M10 10m-6 0a6 6 0 1 0 12 0a6 6 0 1 0-12 0M14.5 14.5 20 20</Geometry>
            <Geometry x:Key="IconMark">M4 13V4h9l7 7-9 9zM8.5 8.5h.01</Geometry>
            <Geometry x:Key="IconCentre">M3 12h4M10 12h2M15 12h6M12 3v4M12 10v2M12 15v6</Geometry>
            <Geometry x:Key="IconDxf">M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M12 11v6M9 14l3 3 3-3</Geometry>
            <Geometry x:Key="IconPdf">M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h6</Geometry>
            <Geometry x:Key="IconPrint">M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z</Geometry>

            <!-- A big button of the ribbon, as Part A's: its Tag the icon, its Content the label; dimmed when disabled. -->
            <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel>
                                <gh:IconView Size="26" StrokeThickness="1.6" HorizontalAlignment="Center"
                                             Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding}" Margin="0,4,0,0" HorizontalAlignment="Center" MaxWidth="66" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GroupBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Border Style="{StaticResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Drawing" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconNewDrawing}" Content="New" Command="{Binding NewCommand}" ToolTip="New drawing from a model (DRAWINGNEW, Ctrl+N)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconUpdate}" Content="Update" Command="{Binding UpdateCommand}" ToolTip="Update from the model, hand edits kept (DRAWINGUPDATE)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconGear}" Content="Settings" Command="{Binding SettingsCommand}" ToolTip="Drawing settings (DRAWINGSETTINGS)" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Views" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddView" Style="{StaticResource BigButton}" Tag="{StaticResource IconAddView}" Content="Add view" Click="OnAddView"
                            IsEnabled="{Binding HasCurrent}" ToolTip="Add a view along an axis, or the isometric one; the drawing is made again, hand edits kept">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ViewMenu" ItemsSource="{Binding AddableViews}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}" />
                                        <Setter Property="Command" Value="{Binding DataContext.AddViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconSection}" Content="Section" Command="{Binding SectionCommand}" ToolTip="A section: pick the two points of its cut line in a view (VIEWSECTION, VS)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconDetail}" Content="Detail" Command="{Binding DetailCommand}" ToolTip="A detail: pick two corners of its rectangle in a view (VIEWDETAIL, VD)" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Annotate" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource GhIconDimension}" Content="Auto dimension" Command="{Binding AutoDimensionCommand}"
                            ToolTip="Dimension the selected view again and keep it dimensioned (AUTODIM, AD)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconMark}" Content="Auto marks" Command="{Binding AutoMarksCommand}"
                            ToolTip="Mark the selected view again and keep it marked (AUTOMARK, AM)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconCentre}" Content="Centre lines" Command="{Binding CentreLinesCommand}" Margin="0"
                            ToolTip="Draw the centre lines of the selected view again" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GroupTitle}" Text="Export" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconDxf}" Content="DXF" Command="{Binding ExportDxfCommand}" ToolTip="Export DXF (EXPORTDXF)" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconPdf}" Content="PDF" IsEnabled="False" ToolTip="PDF: not built yet" ToolTipService.ShowOnDisabled="True" />
                    <Button Style="{StaticResource BigButton}" Tag="{StaticResource IconPrint}" Content="Print" IsEnabled="False" ToolTip="Print: not built yet" ToolTipService.ShowOnDisabled="True" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
