<local:DrawingDialogWindow x:Class="GeometryHelper.Drawing.Wpf.NewDrawingDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="clr-namespace:GeometryHelper.Drawing.Wpf"
                           Title="New drawing" Width="720" Height="560" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Drawing.Wpf;component/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A source as a card: its name, what it gives, its state, a dot; outlined in the accent when chosen. -->
            <Style x:Key="SourceCard" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Background="Transparent">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring" Stroke="{StaticResource GhTextMuted}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="Pip" Width="7" Height="7" Fill="{StaticResource GhAccent}" Visibility="Collapsed" />
                                    </Grid>
                                    <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="8" Height="8" Margin="10,4,0,0" VerticalAlignment="Top" Fill="{StaticResource GhOk}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                                        <TextBlock x:Name="State" Text="{Binding Availability}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource GhInput}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Pip" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DotOff}" />
                                    <Setter Property="Opacity" Value="0.75" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Style="{StaticResource DialogRoot}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogBand}" CornerRadius="6,6,0,0" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                    <TextBlock Style="{StaticResource DialogTitle}" Text="New drawing" />
                </DockPanel>
            </Border>

            <!-- The steps: a badge each, its number or a tick, and a line to the next. -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,0,1" Padding="16,14">
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StepItem}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <Border x:Name="Badge" Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource GhBorder}">
                                    <TextBlock x:Name="Mark" Text="{Binding Mark}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GhTextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Label" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{StaticResource GhTextMuted}" />
                                <Rectangle Width="48" Height="1" Fill="{StaticResource GhBorder}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasLine, Converter={StaticResource Shown}}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource GhOk}" />
                                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource GhAccentInk}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GhText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource GhAccentInk}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GhText}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogBand}" CornerRadius="0,0,6,6">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="0" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsDefault="True" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Back" Command="{Binding BackCommand}"
                            Visibility="{Binding HasBack, Converter={StaticResource Shown}}" />
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource GhWarn}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource BusyBand}" Focusable="False" />

            <Grid Margin="16,14">
                <!-- Step 1: where the objects come from. -->
                <DockPanel Visibility="{Binding IsSourceStep, Converter={StaticResource Shown}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="Where do the objects of the drawing come from?" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SourceOption}">
                                <RadioButton Style="{StaticResource SourceCard}" GroupName="Source" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Step 2: the objects, ticked. -->
                <DockPanel Visibility="{Binding IsObjectsStep, Converter={StaticResource Shown}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding SourceLine}" Margin="0,0,0,10" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource GhTextMuted}">
                        <Run Text="{Binding PickedText, Mode=OneWay}" />
                    </TextBlock>
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource TableHead}" Text="Mark" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TableHead}" Text="Name" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TableHead}" Text="Profile" />
                                <TextBlock Grid.Column="4" Style="{StaticResource TableHead}" Text="Kind" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Objects}" SelectedItem="{Binding FocusedObject, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource GhText}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ObjectRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource GhCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Mark}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Profile}" FontFamily="{StaticResource GhMonoFont}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Kind}" Foreground="{StaticResource GhTextMuted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- Step 3: the preset, the sheet, the number and the name; the summary at the right. -->
                <Grid Visibility="{Binding IsSettingsStep, Converter={StaticResource Shown}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style x:Key="Label" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <StackPanel>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Preset" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Presets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:ChoiceChip Style="{StaticResource ChipToggle}" Content="{Binding}" Margin="0,0,6,0"
                                                          Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" Chosen="{Binding DataContext.Preset, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Sheet size" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GhComboBox}" ItemsSource="{Binding SheetSizes}" SelectedItem="{Binding SheetSize, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Scale" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBox}">
                                <TextBlock Text="{Binding ScaleText}" Foreground="{StaticResource GhTextMuted}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Drawing number" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBox}">
                                <TextBox Style="{StaticResource GhTextBox}" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Tag="B-101" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Name" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBox}">
                                <TextBox Style="{StaticResource GhTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Revision" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBox}">
                                <TextBox Style="{StaticResource GhTextBox}" Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <CheckBox Style="{StaticResource GhCheckBox}" IsChecked="{Binding OpenAfter, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Open the drawing after making it" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource GhInput}" CornerRadius="4" Padding="12" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogTitle}" Text="Summary" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="Source" Foreground="{StaticResource GhTextMuted}" /><Run Text=" · " /><Run Text="{Binding SummarySource, Mode=OneWay}" /></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="Objects" Foreground="{StaticResource GhTextMuted}" /><Run Text=" · " /><Run Text="{Binding SummaryObjects, Mode=OneWay}" /></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="Views" Foreground="{StaticResource GhTextMuted}" /><Run Text=" · " /><Run Text="{Binding SummaryViews, Mode=OneWay}" /></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="Sheet" Foreground="{StaticResource GhTextMuted}" /><Run Text=" · " /><Run Text="{Binding SummarySheet, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="The preset can be changed later in Drawing settings; hand edits are kept." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</local:DrawingDialogWindow>
