<local:DrawingDialogWindow
    x:Class="GeometryHelper.Drawing.Wpf.DrawingSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GeometryHelper.Drawing.Wpf"
    Title="Drawing settings"
    Width="840"
    Height="600"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Drawing.Wpf;component/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A tab of the dialog: the selected colour while shown. -->
            <Style x:Key="Tab" TargetType="local:ChoiceChip">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ChoiceChip">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4,4,0,0" Padding="14,6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Chrome"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of a tab: a switch, a number or text typed, a choice, chips or a value shown. -->
            <DataTemplate x:Key="Row" DataType="{x:Type local:SettingRow}">
                <Grid Margin="0,3">
                    <DockPanel Visibility="{Binding IsToggle, Converter={StaticResource Shown}}">
                        <ToggleButton
                            DockPanel.Dock="Left"
                            Style="{StaticResource Switch}"
                            IsChecked="{Binding IsOn, Mode=TwoWay}"
                            Margin="0,0,10,0"
                        />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock
                                Text="{Binding Hint}"
                                Foreground="{StaticResource GhTextMuted}"
                                Visibility="{Binding HasHint, Converter={StaticResource Shown}}"
                            />
                        </StackPanel>
                    </DockPanel>
                    <Grid Visibility="{Binding IsTyped, Converter={StaticResource Shown}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Label}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource ValueBox}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Text="{Binding Unit}"
                                        Foreground="{StaticResource GhTextMuted}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        Style="{StaticResource GhTextBox}"
                                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                    />
                                </DockPanel>
                            </Border>
                            <TextBlock
                                Text="{Binding Error}"
                                Foreground="{StaticResource GhError}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource Shown}}"
                            />
                        </StackPanel>
                    </Grid>
                    <Grid Visibility="{Binding IsChoice, Converter={StaticResource Shown}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Label}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource GhComboBox}"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding Value, Mode=TwoWay}"
                        />
                    </Grid>
                    <Grid Visibility="{Binding IsInfo, Converter={StaticResource Shown}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Label}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                        <Border Grid.Column="1" Style="{StaticResource ValueBox}">
                            <TextBlock
                                Text="{Binding Value}"
                                Foreground="{StaticResource GhTextMuted}"
                                TextWrapping="Wrap"
                            />
                        </Border>
                    </Grid>
                    <DockPanel Visibility="{Binding IsChips, Converter={StaticResource Shown}}">
                        <TextBlock
                            DockPanel.Dock="Left"
                            Width="120"
                            Text="{Binding Label}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Top"
                            Margin="0,3,0,0"
                        />
                        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SettingChip}">
                                    <ToggleButton
                                        Style="{StaticResource ChipToggle}"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsOn, Mode=TwoWay}"
                                    />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Style="{StaticResource DialogRoot}">
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Style="{StaticResource DialogBand}"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                    <TextBlock Style="{StaticResource DialogTitle}" Text="Drawing settings" />
                    <TextBlock
                        Text="{Binding Title}"
                        Foreground="{StaticResource GhTextMuted}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Top"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,0"
            >
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ChoiceChip
                                Style="{StaticResource Tab}"
                                Content="{Binding}"
                                Command="{Binding DataContext.TabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Chosen="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogBand}" CornerRadius="0,0,6,6">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Left"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0"
                        Content="Save as preset…"
                        IsEnabled="False"
                        ToolTip="Presets of one's own come in a later step"
                        ToolTipService.ShowOnDisabled="True"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButton}"
                        Content="OK"
                        Command="{Binding OkCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"
                    />
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButton}"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Margin="12,0,0,0"
                    >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Notice}" />
                                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="">
                                        <Setter
                                            Property="Text"
                                            Value="Apply makes the drawing again; hand edits are kept."
                                        />
                                        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <ContentControl
                DockPanel.Dock="Bottom"
                Content="{Binding}"
                ContentTemplate="{StaticResource BusyBand}"
                Focusable="False"
            />

            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SettingSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                                    <ItemsControl
                                        ItemsSource="{Binding Rows}"
                                        ItemTemplate="{StaticResource Row}"
                                        Focusable="False"
                                    />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Preview" />
                    <Border Background="{StaticResource GhSheet}" CornerRadius="4" Padding="14,12">
                        <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        Foreground="#1A1A1A"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,8"
                                    />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock
                        Style="{StaticResource Muted}"
                        Margin="0,8,0,0"
                        Text="Settings are kept in the drawing; changing a preset later changes nothing already made."
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</local:DrawingDialogWindow>
