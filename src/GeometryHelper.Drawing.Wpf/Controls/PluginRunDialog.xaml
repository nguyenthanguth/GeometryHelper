<local:DrawingDialogWindow x:Class="GeometryHelper.Drawing.Wpf.PluginRunDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="clr-namespace:GeometryHelper.Drawing.Wpf"
                           Title="{Binding Title}" Width="520" Height="520" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Drawing.Wpf;component/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Style="{StaticResource DialogRoot}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogBand}" CornerRadius="6,6,0,0" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                    <TextBlock Style="{StaticResource DialogTitle}" Text="{Binding Title}" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogBand}" CornerRadius="0,0,6,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Run" Command="{Binding RunCommand}" IsDefault="True" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource GhWarn}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,14">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Plugin" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Width="110" />
                        <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Plugins}" SelectedItem="{Binding Plugin, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding PluginText}" Margin="110,0,0,8" />

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="View" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Width="110" />
                        <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Views}" SelectedItem="{Binding View, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding Id, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{StaticResource GhTextMuted}" /></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ObjectsTitle}" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="0,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Objects}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PluginObjectRow}">
                                        <DockPanel Margin="10,4">
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource GhCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Id}" Foreground="{StaticResource GhTextMuted}" FontFamily="{StaticResource GhMonoFont}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ObjectsText}" Margin="0,6,0,0" />

                    <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource Shown}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Settings" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PluginValueRow}">
                                    <StackPanel Margin="0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding Name}" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Width="200" Text="{Binding RangeText}" Foreground="{StaticResource GhTextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource ValueBox}">
                                                <TextBox Style="{StaticResource GhTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource GhMonoFont}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource GhError}" TextWrapping="Wrap" Margin="110,2,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource Shown}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="The run is kept in the drawing and runs again on every update from the model; Undo takes it back with what it added." />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</local:DrawingDialogWindow>
