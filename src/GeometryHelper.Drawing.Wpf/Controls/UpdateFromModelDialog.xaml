<local:DrawingDialogWindow x:Class="GeometryHelper.Drawing.Wpf.UpdateFromModelDialog"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="clr-namespace:GeometryHelper.Drawing.Wpf"
                           Title="Update from model" Width="760" Height="560" Background="#262B33">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Drawing.Wpf;component/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" Style="{StaticResource DialogRoot}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogBand}" CornerRadius="6,6,0,0" MouseLeftButtonDown="OnHeaderDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnCloseClick" />
                    <TextBlock Style="{StaticResource DialogTitle}" Text="Update from model" />
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource GhTextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogBand}" CornerRadius="0,0,6,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Update" Command="{Binding UpdateCommand}" IsDefault="True" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Undo after the update restores the drawing as it is now." />
                </DockPanel>
            </Border>

            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource BusyBand}" Focusable="False" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,14">
                    <!-- The source to update from. -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Update from" Foreground="{StaticResource GhTextMuted}" VerticalAlignment="Center" Width="110" />
                        <ComboBox Style="{StaticResource GhComboBox}" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <Border Background="{StaticResource GhInput}" CornerRadius="4" Padding="12,10">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="M12 3 2 20h20zM12 10v4M12 17h.01" Stroke="{StaticResource GhWarn}" StrokeThickness="2" Width="18" Height="18"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Model changes" Margin="0,12,0,6" />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Grid Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableHead}" Text="Object" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableHead}" Text="Change" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TableHead}" Text="Detail" />
                            </Grid>
                            <TextBlock Style="{StaticResource Cell}" Foreground="{StaticResource GhTextMuted}" Text="Nothing changed in the model."
                                       Visibility="{Binding HasChanges, Converter={StaticResource Hidden}}" />
                            <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ModelChangeRow}">
                                        <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Cell}" Text="{Binding Object}" FontWeight="SemiBold" />
                                                <Border x:Name="Tag" Grid.Column="1" Margin="8,0" CornerRadius="2" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{StaticResource GhSelected}">
                                                    <TextBlock x:Name="TagText" Text="{Binding Change}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GhText}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Detail}" Foreground="{StaticResource GhIcon}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Change}" Value="Added">
                                                <Setter TargetName="Tag" Property="Background" Value="{StaticResource AddedBack}" />
                                                <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource AddedInk}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Change}" Value="Removed">
                                                <Setter TargetName="Tag" Property="Background" Value="{StaticResource RemovedBack}" />
                                                <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource RemovedInk}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Hand edits" Margin="0,12,0,6" />
                    <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Grid Background="{StaticResource GhHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableHead}" Text="Edit" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableHead}" Text="After the update" />
                            </Grid>
                            <TextBlock Style="{StaticResource Cell}" Foreground="{StaticResource GhTextMuted}" Text="The drawing has no hand edits."
                                       Visibility="{Binding HasEdits, Converter={StaticResource Hidden}}" />
                            <ItemsControl ItemsSource="{Binding Edits}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:HandEditRow}">
                                        <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Cell}" Text="{Binding Edit}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource GhWarn}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Status" Text="{Binding Status}" Foreground="{StaticResource GhWarn}" Margin="6,6,0,6" TextWrapping="Wrap" MaxWidth="230" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsKept}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GhOk}" />
                                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource GhOk}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding PluginText}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</local:DrawingDialogWindow>
