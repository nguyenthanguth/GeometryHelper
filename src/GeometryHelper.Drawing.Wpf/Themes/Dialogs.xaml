<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf;assembly=GeometryHelper.Dxf.Viewer.Wpf">

    <!-- The pieces the model drawing's dialogs share, on the design tokens of Dark.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
        <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <gh:BoolToVisibilityConverter x:Key="Shown" />
    <gh:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    <SolidColorBrush x:Key="DotOff" Color="#5B6573" />
    <SolidColorBrush x:Key="AddedBack" Color="#1C4A2A" />
    <SolidColorBrush x:Key="AddedInk" Color="#B6F0C4" />
    <SolidColorBrush x:Key="RemovedBack" Color="#5A1F1C" />
    <SolidColorBrush x:Key="RemovedInk" Color="#FFC9C4" />
    <SolidColorBrush x:Key="RowLine" Color="#2E343D" />

    <!-- The frame of a dialog: the panel colour, a border, rounded corners as the design's 6. -->
    <Style x:Key="DialogRoot" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GhPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource GhFont}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource GhText}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- The header and the footer bands: the header colour, 10 by 16 in. -->
    <Style x:Key="DialogBand" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GhHeader}" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The main button of a dialog: filled with the accent, dark ink. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
        <Setter Property="Background" Value="{StaticResource GhAccent}" />
        <Setter Property="Foreground" Value="{StaticResource GhAccentInk}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource GhBorder}" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button of a dialog other than the main one: outlined on the input colour. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- The close cross of a dialog's header: the orange-red cross of the theme. -->
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource GhTitleCloseButton}">
        <Setter Property="ToolTip" Value="Close" />
    </Style>

    <!-- A chip: outlined, filled with the selected colour when on. -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource GhBorder}" BorderThickness="1" CornerRadius="4" Padding="9,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhSelected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GhSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch: a track 32 by 18, the accent when on, the knob at its end. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Background="{StaticResource GhBorder}" CornerRadius="9" Padding="2">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A box a value is typed into: the input colour, 3 by 6 in. -->
    <Style x:Key="ValueBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GhInput}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- The header of a table: the header colour, muted small text. -->
    <Style x:Key="TableHead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="Cell" TargetType="TextBlock">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The busy band: what the heavy work does, and Stop. -->
    <DataTemplate x:Key="BusyBand">
        <Border Background="{StaticResource GhInput}" CornerRadius="4" Padding="12,8" Margin="16,0,16,10"
                Visibility="{Binding IsBusy, Converter={StaticResource Shown}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Stop" Command="{Binding StopCommand}" />
                <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,6,0,0" Foreground="{StaticResource GhAccent}"
                             Background="{StaticResource GhBorder}" BorderThickness="0" />
                <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
