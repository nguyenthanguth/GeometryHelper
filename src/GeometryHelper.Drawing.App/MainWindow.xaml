<Window x:Class="GeometryHelper.Drawing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gh="clr-namespace:GeometryHelper.Dxf.Viewer.Wpf;assembly=GeometryHelper.Dxf.Viewer.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title, StringFormat='GeometryHelper Drawing  {0}'}"
        Width="1600" Height="960" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#1E2228" ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GeometryHelper.Dxf.Viewer.Wpf;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhFlatButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The window's close: the orange-red cross of the dialogs, the size of the caption buttons beside it. -->
            <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource GhTitleCloseButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <gh:CadWorkspace x:Name="Workspace">
        <gh:CadWorkspace.TitleBarContent>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimise" ToolTip="Minimise">
                    <gh:IconView Size="16" StrokeThickness="1.6" Data="M5 12h14" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximise" ToolTip="Maximise">
                    <gh:IconView Size="16" StrokeThickness="1.6" Data="M6 6h12v12H6z" />
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="OnClose" ToolTip="Close" />
            </StackPanel>
        </gh:CadWorkspace.TitleBarContent>
    </gh:CadWorkspace>
</Window>
