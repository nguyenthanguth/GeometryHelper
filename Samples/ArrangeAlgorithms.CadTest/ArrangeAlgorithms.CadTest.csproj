<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>ArrangeAlgorithms.CadTest</RootNamespace>
    <AssemblyName>ArrangeAlgorithms.CadTest</AssemblyName>

    <!-- Change this line if AutoCAD is installed in another location or uses a different version. -->
    <AutoCadPath>D:\Autodesk\AutoCAD\AutoCAD 2021</AutoCadPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false is mandatory: these DLLs must NOT be copied to the output directory.
         AutoCAD already loads its own version; copying another version will cause the plugin to load
         two assemblies with the same name but different paths, throwing hard-to-debug type casting errors. -->
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCadPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\ArrangeAlgorithms\ArrangeAlgorithms.csproj" />
    <ProjectReference Include="..\..\Libraries\PlaneGeometry\PlaneGeometry.csproj" />
  </ItemGroup>

</Project>
