# ---------------------------------------------------------------------------
# Rider / ReSharper / JetBrains
# Riêng *.DotSettings (không có đuôi .user) là thiết lập dùng chung, vẫn nên đưa vào repo;
# bản cá nhân *.DotSettings.user đã bị chặn bởi luật *.user ở trên.
# ---------------------------------------------------------------------------
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.resharper

# ---------------------------------------------------------------------------
# Visual Studio Code
# Giữ lại các file cấu hình dùng chung của nhóm, chỉ bỏ phần thiết lập cá nhân.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

