{
  "version": 1,
  "bindings": [
    { "action": "ZoomAtCursor", "gestures": ["Wheel"] },
    { "action": "ZoomIn", "gestures": ["PageUp"] },
    { "action": "ZoomOut", "gestures": ["PageDown"] },
    { "action": "Pan", "gestures": ["MiddleDrag"] },
    { "action": "PanLeft", "gestures": ["Left"] },
    { "action": "PanRight", "gestures": ["Right"] },
    { "action": "PanUp", "gestures": ["Up"] },
    { "action": "PanDown", "gestures": ["Down"] },
    { "action": "Rotate", "gestures": ["Ctrl+MiddleDrag"] },
    { "action": "RotateLeft", "gestures": ["Ctrl+Left"] },
    { "action": "RotateRight", "gestures": ["Ctrl+Right"] },
    { "action": "RotateUp", "gestures": ["Ctrl+Up"] },
    { "action": "RotateDown", "gestures": ["Ctrl+Down"] },
    { "action": "SetRotationCentre", "gestures": ["V"] },
    { "action": "ClearRotationCentre", "gestures": ["Shift+V"] },
    { "action": "TogglePlan", "gestures": ["Ctrl+P"] },
    { "action": "FitAll", "gestures": ["F"] },
    { "action": "FitSelection", "gestures": ["Shift+F"] },
    { "action": "ViewIso", "gestures": ["Ctrl+0"] },
    { "action": "ViewTop", "gestures": ["Ctrl+5"] },
    { "action": "ViewFront", "gestures": ["Ctrl+6"] },
    { "action": "ViewRight", "gestures": ["Ctrl+7"] },
    { "action": "RenderWireframe", "gestures": ["Ctrl+1"] },
    { "action": "RenderShaded", "gestures": ["Ctrl+2"] },
    { "action": "RenderShadedEdges", "gestures": ["Ctrl+3"] },
    { "action": "RenderTransparent", "gestures": ["Ctrl+4"] },
    { "action": "Select", "gestures": ["Click"] },
    { "action": "SelectAdd", "gestures": ["Shift+Click"] },
    { "action": "SelectToggle", "gestures": ["Ctrl+Click"] },
    { "action": "BoxSelect", "gestures": ["LeftDrag"] },
    { "action": "Cancel", "gestures": ["Esc"] },
    { "action": "HideSelected", "gestures": ["Ctrl+H"] },
    { "action": "ShowAll", "gestures": ["Ctrl+Shift+H"] },
    { "action": "Properties", "gestures": ["DoubleClick", "Alt+Enter"] },
    { "action": "ToggleDiagnostics", "gestures": ["Ctrl+D"] },
    { "action": "MeasureDistance", "gestures": ["F2"] },
    { "action": "MeasureAngle", "gestures": ["F3"] },
    { "action": "MeasureRadius", "gestures": ["F4"] },
    { "action": "SnapEnd", "gestures": ["F8"] },
    { "action": "SnapMid", "gestures": ["F9"] },
    { "action": "SnapIntersection", "gestures": ["F10"] },
    { "action": "SnapCentre", "gestures": ["F11"] },
    { "action": "SnapNearest", "gestures": ["F12"] },
    { "action": "RunScript", "gestures": ["F5"] },
    { "action": "RerunScript", "gestures": ["Ctrl+R"] },
    { "action": "Screenshot", "gestures": ["Ctrl+Shift+S"] },
    { "action": "OpenFile", "gestures": ["Ctrl+O"] },
    { "action": "SaveSceneAs", "gestures": ["Ctrl+S"] },
    { "action": "Compare", "gestures": ["Ctrl+Shift+C"] },
    { "action": "CompareLeft", "gestures": ["1"] },
    { "action": "CompareRight", "gestures": ["2"] },
    { "action": "CompareBoth", "gestures": ["3"] },
    { "action": "ExportTest", "gestures": ["Ctrl+T"] }
  ]
}
