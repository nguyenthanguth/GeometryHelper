<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GeometryHelper.Viewer</RootNamespace>
    <AssemblyName>GeometryHelper.Viewer</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeometryHelper.Viewer.Core\GeometryHelper.Viewer.Core.csproj" />
    <PackageReference Include="HelixToolkit.SharpDX.Core.Wpf" Version="2.27.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <!-- The shipped keymap sits beside the executable, where the user can see what to copy to change it. -->
  <ItemGroup>
    <Content Include="..\GeometryHelper.Viewer.Core\Keymap\keymap.json" Link="keymap.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
