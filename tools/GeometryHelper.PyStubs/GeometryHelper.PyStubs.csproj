<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Writes the Python type stubs (.pyi) of the GeometryHelper assemblies, for pyright and Pylance:

      GeometryHelper.PyStubs, given the folder with the DLLs and XML docs (option lib) and the folder to write to (option out)

    It reads the assemblies with MetadataLoadContext over the netstandard 2.0 reference assemblies of NETStandard.Library,
    which are copied beside the program (netstandard\), so nothing of the assemblies is run and the answer does not depend
    on the .NET runtime that runs the tool.
  -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>GeometryHelper.PyStubs</RootNamespace>
        <AssemblyName>GeometryHelper.PyStubs</AssemblyName>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
        <PackageReference
            Include="NETStandard.Library"
            Version="2.0.3"
            GeneratePathProperty="true"
            ExcludeAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GeometryHelper.PyStubs.UnitTest" />
    </ItemGroup>

    <ItemGroup Condition="'$(PkgNETStandard_Library)' != ''">
        <None
            Include="$(PkgNETStandard_Library)\build\netstandard2.0\ref\*.dll"
            Link="netstandard\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>
</Project>
