<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The assembly attributes are generated from the package metadata below rather than written by
         hand, so the version lives in one place. The four geometry libraries still carry a hand-written
         Properties/AssemblyInfo.cs; this project has none, and generating is what keeps its identity
         from falling back to 0.0.0.0. -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- 1. Configure NuGet Package generation and XML Documentation -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>GeometryHelper.TeklaConvert</PackageId>
    <Version>3.0.0</Version>
    <Authors>Nguyen Thang</Authors>
    <Company>Nguyen Thang</Company>
    <Description>Converts geometry between Tekla Structures and GeometryHelper (GeometryHelper.CommonGeometry, GeometryHelper.PlaneGeometry, and GeometryHelper.SolidGeometry): points, vectors, segments, planes, coordinate systems, bounding boxes, transformation matrices, and the faces and loops of a Tekla solid.</Description>
    <PackageProjectUrl>https://github.com/nguyenthanguth/GeometryHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nguyenthanguth/GeometryHelper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 Nguyen Thang</Copyright>
    <PackageTags>tekla bim geometry 3d solid interop conversion</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
      Converts geometry between Tekla Structures and GeometryHelper, both ways: points, vectors, line
      segments, geometric planes, coordinate systems, bounding boxes, transformation matrices, and the
      faces and loops of a Tekla solid.

      REQUIRES TWO ASSEMBLIES YOU MUST SUPPLY
      - Tekla.Structures.dll and Tekla.Structures.Drawing.dll are not redistributed here, because they
        are Trimble's to ship rather than ours. Reference them yourself, either from the bin folder of
        your Tekla Structures installation or from Trimble's own Tekla.Structures and
        Tekla.Structures.Drawing packages on nuget.org. Without them the compiler reports CS0012.
      - This package is built against the 2020 API. The types it touches - Point, Vector, LineSegment,
        Matrix, GeometricPlane, CoordinateSystem, AABB, Solid, Face and Loop - are unchanged through
        2026, so a rebuild against a newer Tekla needs no source changes.

      READING A SOLID
      - Faces are turned to agree with the normal Tekla gives them, and the body is turned inside out
        if its signed volume says the whole surface arrived reversed. A coordinate system whose Y axis
        is not quite square to its X axis is squared up rather than trusted.
      - A face that cannot be made sense of is skipped rather than thrown on, which leaves the body no
        longer closed, so ask IsClosed() before trusting a volume.
      - Tekla models in millimetres with coordinates running to hundreds of thousands, where the
        default EqualPlanar is often too tight. Pass a Tolerance suited to the model.
    </PackageReleaseNotes>

    <!-- The Tekla assemblies are referenced but never packed: Private=False keeps them out of the
         build output, so nothing of Trimble's ends up inside the package. See README.md. -->
    <IsPackable>true</IsPackable>

    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeometryHelper.SolidGeometry\GeometryHelper.SolidGeometry.csproj" />
    <ProjectReference Include="..\GeometryHelper.PlaneGeometry\GeometryHelper.PlaneGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored rather than referenced from the Tekla test project, so this project stands on
         its own if it is ever lifted out of the repository. Private is false because Tekla supplies these
         at run time from its own installation; copying them next to the output would risk loading a build
         that does not match the running Tekla. -->
    <Reference Include="Tekla.Structures">
      <HintPath>Lib2020\Tekla.Structures.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Drawing">
      <HintPath>Lib2020\Tekla.Structures.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
