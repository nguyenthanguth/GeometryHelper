<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The assembly attributes are generated from the package metadata below rather than written by
         hand, so the version lives in one place. The four geometry libraries still carry a hand-written
         Properties/AssemblyInfo.cs; this project has none, and generating is what keeps its identity
         from falling back to 0.0.0.0. -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>GeometryHelper.TeklaConvert</PackageId>
    <Version>3.0.0</Version>
    <Authors>Nguyen Thang</Authors>
    <Company>Nguyen Thang</Company>
    <Description>Converts geometry between Tekla Structures and GeometryHelper (GeometryHelper.CommonGeometry, GeometryHelper.PlaneGeometry, and GeometryHelper.SolidGeometry): points, vectors, segments, planes, coordinate systems, bounding boxes, transformation matrices, and the faces and loops of a Tekla solid.</Description>
    <PackageProjectUrl>https://github.com/nguyenthanguth/GeometryHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nguyenthanguth/GeometryHelper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 Nguyen Thang</Copyright>
    <PackageTags>tekla bim geometry 3d solid interop conversion</PackageTags>

    <!-- The Tekla assemblies are not ours to redistribute, so this is not packed by default. -->
    <IsPackable>false</IsPackable>

    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeometryHelper.SolidGeometry\GeometryHelper.SolidGeometry.csproj" />
    <ProjectReference Include="..\GeometryHelper.PlaneGeometry\GeometryHelper.PlaneGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored rather than referenced from the Tekla test project, so this project stands on
         its own if it is ever lifted out of the repository. Private is false because Tekla supplies these
         at run time from its own installation; copying them next to the output would risk loading a build
         that does not match the running Tekla. -->
    <Reference Include="Tekla.Structures">
      <HintPath>Lib2020\Tekla.Structures.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Drawing">
      <HintPath>Lib2020\Tekla.Structures.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
