  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GeometryHelper.IfcConvert.UnitTest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The xBIM geometry engine (C++/CLI around native OpenCascade) cannot be embedded by Costura: xBIM loads it
       from the application folder. One item per file both copies it to the output (and on to projects that
       reference this one) and packs it where build\GeometryHelper.IfcConvert.targets copies it from.
       Do not declare these files a second time: a duplicate item with Pack=false keeps them out of the package. -->
  <ItemGroup>
    <Content Include="Lib\Xbim.Geometry.Engine64.dll">
      <Link>%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\native</PackagePath>
    </Content>
    <Content Include="Lib\Xbim.Geometry.Engine32.dll">
      <Link>%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x86\native</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\GeometryHelper.IfcConvert.targets" Pack="true" PackagePath="build\net48;buildTransitive\net48" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
